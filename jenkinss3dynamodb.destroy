pipeline {

    agent any

    // ================================================================
    // PIPELINE OPTIONS
    // ================================================================

    options {

        timestamps()

        ansiColor('xterm')

        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                daysToKeepStr: '30',
                numToKeepStr: '50'
            )
        )

        timeout(
            time: 60,
            unit: 'MINUTES'
        )

        skipDefaultCheckout(false)
    }


    // ================================================================
    // PARAMETERS
    // ================================================================

    parameters {

        string(
            name: 'AWS_REGION',
            defaultValue: 'us-east-1',
            description: 'AWS region containing the Terraform backend'
        )

        string(
            name: 'S3_BACKEND_BUCKET',
            defaultValue: 'terraform-state-faizan-001',
            description: 'Terraform S3 backend bucket to completely delete'
        )

        string(
            name: 'DYNAMODB_LOCK_TABLE',
            defaultValue: 'terraform-lock',
            description: 'Terraform DynamoDB lock table to delete'
        )

        booleanParam(
            name: 'CONFIRM_DELETE',
            defaultValue: true,
            description: 'CONFIRM: Delete every S3 object/version/delete-marker, delete the S3 bucket, and delete the DynamoDB table.'
        )
    }


    // ================================================================
    // ENVIRONMENT
    // ================================================================

    environment {

        AWS_DEFAULT_REGION = "${params.AWS_REGION}"

        AWS_REGION = "${params.AWS_REGION}"

        S3_BUCKET = "${params.S3_BACKEND_BUCKET}"

        DDB_TABLE = "${params.DYNAMODB_LOCK_TABLE}"
    }


    // ================================================================
    // STAGES
    // ================================================================

    stages {


        // ============================================================
        // 01 - START
        // ============================================================

        stage('01 - Start Backend Cleanup') {

            steps {

                echo ''

                echo '================================================'
                echo '       TERRAFORM BACKEND CLEANUP PIPELINE'
                echo '================================================'

                echo "AWS Region          : ${env.AWS_REGION}"
                echo "S3 Backend Bucket   : ${env.S3_BUCKET}"
                echo "DynamoDB Lock Table : ${env.DDB_TABLE}"
                echo "Delete Confirmation : ${params.CONFIRM_DELETE}"

                echo '================================================'
                echo ''
            }
        }


        // ============================================================
        // 02 - CONFIRM
        // ============================================================

        stage('02 - Confirm Destructive Operation') {

            steps {

                script {

                    if (!params.CONFIRM_DELETE) {

                        error(
                            'DELETION NOT CONFIRMED. Set CONFIRM_DELETE=true before running this pipeline.'
                        )

                    }

                    echo ''

                    echo '================================================'
                    echo '          DELETION CONFIRMED'
                    echo '================================================'

                    echo 'This pipeline will ONLY remove:'
                    echo ''
                    echo "1. All S3 object versions in ${env.S3_BUCKET}"
                    echo "2. All S3 delete markers in ${env.S3_BUCKET}"
                    echo "3. The complete S3 bucket ${env.S3_BUCKET}"
                    echo "4. DynamoDB table ${env.DDB_TABLE}"
                    echo ''
                    echo 'Terraform infrastructure will NOT be destroyed.'
                    echo 'EC2/application resources will NOT be touched.'
                    echo ''
                    echo '================================================'
                }
            }
        }


        // ============================================================
        // 03 - CHECK TOOLS
        // ============================================================

        stage('03 - Check Required Tools') {

            steps {

                sh '''
                    set -eu

                    echo "================================================"
                    echo "CHECKING REQUIRED TOOLS"
                    echo "================================================"

                    command -v aws
                    command -v jq

                    echo ""
                    echo "AWS CLI:"
                    aws --version

                    echo ""
                    echo "jq:"
                    jq --version

                    echo ""
                    echo "Required tools are available."

                    echo "================================================"
                '''
            }
        }


        // ============================================================
        // 04 - AWS AUTHENTICATION
        // ============================================================

        stage('04 - Verify AWS Authentication') {

            steps {

                withCredentials(
                    [
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: 'aws-creds',
                            accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                            secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                        ]
                    ]
                ) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "VERIFYING AWS AUTHENTICATION"
                        echo "================================================"

                        aws sts get-caller-identity

                        echo ""
                        echo "AWS authentication successful."

                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // 05 - CHECK S3 BUCKET
        // ============================================================

        stage('05 - Check S3 Backend Bucket') {

            steps {

                withCredentials(
                    [
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: 'aws-creds',
                            accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                            secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                        ]
                    ]
                ) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "CHECKING S3 BACKEND BUCKET"
                        echo "================================================"

                        if aws s3api head-bucket \
                            --bucket "$S3_BUCKET" \
                            --region "$AWS_REGION" \
                            >/dev/null 2>&1
                        then

                            echo "S3 bucket exists:"
                            echo "$S3_BUCKET"

                        else

                            echo "S3 bucket does not exist."
                            echo "Nothing to delete from S3."

                        fi

                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // 06 - CHECK DYNAMODB
        // ============================================================

        stage('06 - Check DynamoDB Lock Table') {

            steps {

                withCredentials(
                    [
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: 'aws-creds',
                            accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                            secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                        ]
                    ]
                ) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "CHECKING DYNAMODB LOCK TABLE"
                        echo "================================================"

                        if aws dynamodb describe-table \
                            --table-name "$DDB_TABLE" \
                            --region "$AWS_REGION" \
                            >/dev/null 2>&1
                        then

                            echo "DynamoDB table exists:"
                            echo "$DDB_TABLE"

                        else

                            echo "DynamoDB table does not exist."
                            echo "Nothing to delete from DynamoDB."

                        fi

                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // 07 - DELETE ALL S3 OBJECT VERSIONS
        // ============================================================

        stage('07 - Delete All S3 Object Versions') {

            steps {

                withCredentials(
                    [
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: 'aws-creds',
                            accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                            secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                        ]
                    ]
                ) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "DELETING ALL S3 OBJECT VERSIONS"
                        echo "================================================"

                        if ! aws s3api head-bucket \
                            --bucket "$S3_BUCKET" \
                            --region "$AWS_REGION" \
                            >/dev/null 2>&1
                        then

                            echo "S3 bucket does not exist."
                            echo "Skipping S3 version deletion."
                            exit 0

                        fi

                        WORK_DIR="$(mktemp -d)"

                        trap 'rm -rf "$WORK_DIR"' EXIT

                        VERSIONS_FILE="$WORK_DIR/versions.json"
                        DELETE_FILE="$WORK_DIR/delete.json"

                        echo ""
                        echo "Listing all object versions and delete markers..."

                        aws s3api list-object-versions \
                            --bucket "$S3_BUCKET" \
                            --region "$AWS_REGION" \
                            --output json \
                            > "$VERSIONS_FILE"

                        echo ""
                        echo "Preparing deletion list..."

                        jq -c '
                            [
                                (.Versions // [])[],
                                (.DeleteMarkers // [])[]
                            ]
                            |
                            map({
                                Key: .Key,
                                VersionId: .VersionId
                            })
                        ' "$VERSIONS_FILE" > "$DELETE_FILE"

                        TOTAL_COUNT="$(
                            jq 'length' "$DELETE_FILE"
                        )"

                        echo ""
                        echo "Total S3 versions/delete markers found: $TOTAL_COUNT"

                        if [ "$TOTAL_COUNT" -eq 0 ]; then

                            echo ""
                            echo "No S3 object versions or delete markers found."
                            echo "Bucket is already empty."

                            exit 0
                        fi


                        echo ""
                        echo "Deleting S3 versions/delete markers..."

                        BATCH_NUMBER=0

                        while true
                        do

                            BATCH_COUNT="$(
                                jq '.[0:1000] | length' "$DELETE_FILE"
                            )"

                            if [ "$BATCH_COUNT" -eq 0 ]; then
                                break
                            fi

                            BATCH_NUMBER=$((BATCH_NUMBER + 1))

                            echo ""
                            echo "Deleting batch $BATCH_NUMBER"
                            echo "Objects in batch: $BATCH_COUNT"

                            jq '.[0:1000]' "$DELETE_FILE" \
                                > "$WORK_DIR/batch.json"

                            aws s3api delete-objects \
                                --bucket "$S3_BUCKET" \
                                --region "$AWS_REGION" \
                                --delete "file://$WORK_DIR/batch.json"

                            jq '.[1000:]' "$DELETE_FILE" \
                                > "$WORK_DIR/remaining.json"

                            mv \
                                "$WORK_DIR/remaining.json" \
                                "$DELETE_FILE"

                        done

                        echo ""
                        echo "All S3 object versions/delete markers deleted."

                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // 08 - VERIFY S3 EMPTY
        // ============================================================

        stage('08 - Verify S3 Bucket Empty') {

            steps {

                withCredentials(
                    [
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: 'aws-creds',
                            accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                            secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                        ]
                    ]
                ) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "VERIFYING S3 BUCKET IS EMPTY"
                        echo "================================================"

                        if ! aws s3api head-bucket \
                            --bucket "$S3_BUCKET" \
                            --region "$AWS_REGION" \
                            >/dev/null 2>&1
                        then

                            echo "Bucket already does not exist."
                            exit 0

                        fi

                        WORK_DIR="$(mktemp -d)"

                        trap 'rm -rf "$WORK_DIR"' EXIT

                        aws s3api list-object-versions \
                            --bucket "$S3_BUCKET" \
                            --region "$AWS_REGION" \
                            --output json \
                            > "$WORK_DIR/check.json"

                        REMAINING="$(
                            jq '
                                ((.Versions // []) + (.DeleteMarkers // []))
                                | length
                            ' "$WORK_DIR/check.json"
                        )"

                        echo "Remaining versions/delete markers: $REMAINING"

                        if [ "$REMAINING" -ne 0 ]; then

                            echo ""
                            echo "ERROR: S3 bucket still contains objects."
                            echo ""

                            jq '
                                {
                                    Versions: (.Versions // []),
                                    DeleteMarkers: (.DeleteMarkers // [])
                                }
                            ' "$WORK_DIR/check.json"

                            exit 1
                        fi

                        echo ""
                        echo "S3 bucket is completely empty."

                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // 09 - DELETE S3 BUCKET
        // ============================================================

        stage('09 - Delete Complete S3 Backend Bucket') {

            steps {

                withCredentials(
                    [
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: 'aws-creds',
                            accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                            secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                        ]
                    ]
                ) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "DELETING COMPLETE S3 BACKEND BUCKET"
                        echo "================================================"

                        if ! aws s3api head-bucket \
                            --bucket "$S3_BUCKET" \
                            --region "$AWS_REGION" \
                            >/dev/null 2>&1
                        then

                            echo "S3 bucket already deleted."
                            exit 0

                        fi

                        aws s3api delete-bucket \
                            --bucket "$S3_BUCKET" \
                            --region "$AWS_REGION"

                        echo ""
                        echo "S3 bucket deletion requested:"
                        echo "$S3_BUCKET"

                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // 10 - VERIFY S3 DELETED
        // ============================================================

        stage('10 - Verify S3 Bucket Deleted') {

            steps {

                withCredentials(
                    [
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: 'aws-creds',
                            accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                            secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                        ]
                    ]
                ) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "VERIFYING S3 BUCKET DELETION"
                        echo "================================================"

                        ATTEMPTS=0
                        MAX_ATTEMPTS=30

                        while [ "$ATTEMPTS" -lt "$MAX_ATTEMPTS" ]
                        do

                            if aws s3api head-bucket \
                                --bucket "$S3_BUCKET" \
                                --region "$AWS_REGION" \
                                >/dev/null 2>&1
                            then

                                ATTEMPTS=$((ATTEMPTS + 1))

                                echo "S3 bucket still visible."
                                echo "Waiting 2 seconds... attempt $ATTEMPTS/$MAX_ATTEMPTS"

                                sleep 2

                            else

                                echo ""
                                echo "S3 bucket has been deleted."
                                echo "$S3_BUCKET"

                                exit 0

                            fi

                        done

                        echo ""
                        echo "ERROR: S3 bucket still appears to exist after waiting."

                        exit 1

                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // 11 - DELETE DYNAMODB
        // ============================================================

        stage('11 - Delete DynamoDB Lock Table') {

            steps {

                withCredentials(
                    [
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: 'aws-creds',
                            accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                            secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                        ]
                    ]
                ) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "DELETING DYNAMODB LOCK TABLE"
                        echo "================================================"

                        if ! aws dynamodb describe-table \
                            --table-name "$DDB_TABLE" \
                            --region "$AWS_REGION" \
                            >/dev/null 2>&1
                        then

                            echo "DynamoDB table already does not exist."
                            exit 0

                        fi

                        echo ""
                        echo "Deleting DynamoDB table:"
                        echo "$DDB_TABLE"

                        aws dynamodb delete-table \
                            --table-name "$DDB_TABLE" \
                            --region "$AWS_REGION"

                        echo ""
                        echo "DynamoDB deletion requested."

                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // 12 - WAIT DYNAMODB
        // ============================================================

        stage('12 - Wait For DynamoDB Deletion') {

            steps {

                withCredentials(
                    [
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: 'aws-creds',
                            accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                            secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                        ]
                    ]
                ) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "WAITING FOR DYNAMODB TABLE DELETION"
                        echo "================================================"

                        ATTEMPTS=0
                        MAX_ATTEMPTS=60

                        while [ "$ATTEMPTS" -lt "$MAX_ATTEMPTS" ]
                        do

                            if aws dynamodb describe-table \
                                --table-name "$DDB_TABLE" \
                                --region "$AWS_REGION" \
                                >/dev/null 2>&1
                            then

                                ATTEMPTS=$((ATTEMPTS + 1))

                                echo "DynamoDB table still exists."
                                echo "Waiting 2 seconds... attempt $ATTEMPTS/$MAX_ATTEMPTS"

                                sleep 2

                            else

                                echo ""
                                echo "DynamoDB table has been deleted."
                                echo "$DDB_TABLE"

                                exit 0

                            fi

                        done

                        echo ""
                        echo "ERROR: DynamoDB table still exists after waiting."

                        exit 1

                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // 13 - FINAL VERIFICATION
        // ============================================================

        stage('13 - Final Backend Verification') {

            steps {

                withCredentials(
                    [
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: 'aws-creds',
                            accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                            secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                        ]
                    ]
                ) {

                    sh '''
                        set -eu

                        echo ""
                        echo "================================================"
                        echo "       FINAL BACKEND VERIFICATION"
                        echo "================================================"

                        S3_STATUS="DELETED"

                        if aws s3api head-bucket \
                            --bucket "$S3_BUCKET" \
                            --region "$AWS_REGION" \
                            >/dev/null 2>&1
                        then

                            S3_STATUS="STILL EXISTS"

                        fi


                        DDB_STATUS="DELETED"

                        if aws dynamodb describe-table \
                            --table-name "$DDB_TABLE" \
                            --region "$AWS_REGION" \
                            >/dev/null 2>&1
                        then

                            DDB_STATUS="STILL EXISTS"

                        fi


                        echo ""
                        echo "S3 Bucket:"
                        echo "  $S3_BUCKET"
                        echo "  Status: $S3_STATUS"

                        echo ""
                        echo "DynamoDB Table:"
                        echo "  $DDB_TABLE"
                        echo "  Status: $DDB_STATUS"

                        echo ""

                        if [ "$S3_STATUS" != "DELETED" ]; then

                            echo "ERROR: S3 bucket was not completely deleted."

                            exit 1
                        fi


                        if [ "$DDB_STATUS" != "DELETED" ]; then

                            echo "ERROR: DynamoDB table was not completely deleted."

                            exit 1
                        fi


                        echo "================================================"
                        echo "ALL BACKEND RESOURCES DELETED SUCCESSFULLY"
                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // 14 - FINAL REPORT
        // ============================================================

        stage('14 - Final Destruction Report') {

            steps {

                echo ''

                echo '================================================'
                echo '       FINAL BACKEND CLEANUP REPORT'
                echo '================================================'

                echo ''
                echo 'AWS Region          : ' + env.AWS_REGION
                echo 'S3 Bucket           : ' + env.S3_BUCKET
                echo 'DynamoDB Table      : ' + env.DDB_TABLE

                echo ''
                echo 'S3 object versions  : DELETED'
                echo 'S3 delete markers   : DELETED'
                echo 'S3 backend bucket   : DELETED'
                echo 'DynamoDB lock table: DELETED'

                echo ''
                echo 'Terraform destroy   : NOT RUN'
                echo 'EC2 resources       : NOT TOUCHED'
                echo 'Application infra   : NOT TOUCHED'

                echo ''
                echo '================================================'
                echo '       BACKEND CLEANUP SUCCESSFUL'
                echo '================================================'
                echo ''
            }
        }
    }


    // ================================================================
    // POST ACTIONS
    // ================================================================

    post {

        always {

            echo ''

            echo '================================================'
            echo '       CLEANING JENKINS WORKSPACE'
            echo '================================================'

            cleanWs()

            echo 'Workspace cleanup completed.'
        }


        success {

            echo ''

            echo '================================================'
            echo '       CLEANUP PIPELINE SUCCESSFUL'
            echo '================================================'

            echo ''
            echo "S3 Bucket     : ${env.S3_BUCKET}"
            echo "DynamoDB Table: ${env.DDB_TABLE}"
            echo "AWS Region    : ${env.AWS_REGION}"

            echo ''
            echo 'Terraform infrastructure was NOT destroyed.'

            echo ''
            echo '================================================'
        }


        failure {

            echo ''

            echo '================================================'
            echo '       CLEANUP PIPELINE FAILED'
            echo '================================================'

            echo ''
            echo "S3 Bucket     : ${env.S3_BUCKET}"
            echo "DynamoDB Table: ${env.DDB_TABLE}"
            echo "AWS Region    : ${env.AWS_REGION}"

            echo ''
            echo 'Check the failed stage in the Jenkins console.'

            echo ''
            echo '================================================'
        }
    }
}
