pipeline {

    agent any

    // ================================================================
    // PIPELINE OPTIONS
    // ================================================================

    options {

        timestamps()

        ansiColor('xterm')

        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                daysToKeepStr: '30',
                numToKeepStr: '50'
            )
        )

        timeout(
            time: 120,
            unit: 'MINUTES'
        )

        skipDefaultCheckout(false)
    }


    // ================================================================
    // PARAMETERS
    // ================================================================

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: [
                'dev',
                'qa',
                'stage',
                'prod'
            ],
            description: 'Terraform environment to destroy.'
        )

        string(
            name: 'AWS_REGION',
            defaultValue: 'us-east-1',
            description: 'AWS region.'
        )

        string(
            name: 'TERRAFORM_BACKEND_BUCKET',
            defaultValue: 'terraform-state-faizan-001',
            description: 'Terraform S3 backend bucket.'
        )

        string(
            name: 'TERRAFORM_STATE_KEY',
            defaultValue: 'terraform.tfstate',
            description: 'Terraform state object key.'
        )

        string(
            name: 'DYNAMODB_LOCK_TABLE',
            defaultValue: 'terraform-lock',
            description: 'Terraform DynamoDB lock table.'
        )

        booleanParam(
            name: 'DELETE_TERRAFORM_BACKEND',
            defaultValue: true,
            description: 'Delete Terraform S3 backend bucket and DynamoDB lock table after infrastructure destruction.'
        )

        string(
            name: 'TERRAFORM_REPO',
            defaultValue: 'https://github.com/FAIZANSHEIKH223/terraform-aws-infra.git',
            description: 'Terraform infrastructure repository.'
        )

        string(
            name: 'TERRAFORM_BRANCH',
            defaultValue: 'main',
            description: 'Terraform repository branch.'
        )
    }


    // ================================================================
    // ENVIRONMENT
    // ================================================================

    environment {

        TF_IN_AUTOMATION = 'true'

        TF_INPUT = 'false'

        AWS_DEFAULT_REGION = "${params.AWS_REGION}"

        AWS_REGION = "${params.AWS_REGION}"

        TF_PLUGIN_CACHE_DIR = "${WORKSPACE}/.terraform.d/plugin-cache"
    }


    // ================================================================
    // STAGES
    // ================================================================

    stages {


        // ============================================================
        // 01
        // ============================================================

        stage('01 - Start Destroy Pipeline') {

            steps {

                echo ''
                echo '================================================'
                echo '       TERRAFORM DESTROY PIPELINE'
                echo '================================================'
                echo "Environment              : ${params.ENVIRONMENT}"
                echo "AWS Region               : ${params.AWS_REGION}"
                echo "Terraform Backend Bucket : ${params.TERRAFORM_BACKEND_BUCKET}"
                echo "Terraform State Key      : ${params.TERRAFORM_STATE_KEY}"
                echo "DynamoDB Lock Table      : ${params.DYNAMODB_LOCK_TABLE}"
                echo "Delete Backend           : ${params.DELETE_TERRAFORM_BACKEND}"
                echo '================================================'
                echo ''
            }
        }


        // ============================================================
        // 02
        // ============================================================

        stage('02 - Check Required Tools') {

            steps {

                sh '''
                    set -eu

                    echo "================================================"
                    echo "CHECKING REQUIRED TOOLS"
                    echo "================================================"

                    command -v terraform >/dev/null 2>&1
                    command -v aws >/dev/null 2>&1
                    command -v jq >/dev/null 2>&1
                    command -v git >/dev/null 2>&1

                    echo ""
                    echo "Terraform:"
                    terraform version

                    echo ""
                    echo "AWS CLI:"
                    aws --version

                    echo ""
                    echo "jq:"
                    jq --version

                    echo ""
                    echo "Git:"
                    git --version

                    echo ""
                    echo "Required tools are available."
                    echo "================================================"
                '''
            }
        }


        // ============================================================
        // 03
        // ============================================================

        stage('03 - Verify AWS Authentication') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds']
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "VERIFYING AWS AUTHENTICATION"
                        echo "================================================"

                        export AWS_SDK_LOAD_CONFIG=1

                        aws sts get-caller-identity

                        echo ""
                        echo "AWS Region:"
                        echo "${AWS_DEFAULT_REGION}"

                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // 04
        // ============================================================

        stage('04 - Check Terraform S3 Backend') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds']
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "CHECKING TERRAFORM S3 BACKEND"
                        echo "================================================"

                        BUCKET="${TERRAFORM_BACKEND_BUCKET}"

                        if aws s3api head-bucket \
                            --bucket "${BUCKET}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            >/dev/null 2>&1
                        then
                            echo "S3 backend bucket exists:"
                            echo "${BUCKET}"
                        else
                            echo "S3 backend bucket does not exist."
                            echo "Terraform backend deletion may already have occurred."
                        fi

                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // 05
        // ============================================================

        stage('05 - Check DynamoDB Lock Table') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds']
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "CHECKING DYNAMODB LOCK TABLE"
                        echo "================================================"

                        TABLE="${DYNAMODB_LOCK_TABLE}"

                        if aws dynamodb describe-table \
                            --table-name "${TABLE}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            >/dev/null 2>&1
                        then
                            echo "DynamoDB lock table exists:"
                            echo "${TABLE}"
                        else
                            echo "DynamoDB lock table does not exist."
                        fi

                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // 06
        // ============================================================

        stage('06 - Checkout Terraform Repository') {

            steps {

                dir('terraform-infra') {

                    deleteDir()

                    git(
                        branch: "${params.TERRAFORM_BRANCH}",
                        credentialsId: 'github-creds',
                        url: "${params.TERRAFORM_REPO}"
                    )

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "TERRAFORM REPOSITORY CHECKED OUT"
                        echo "================================================"

                        pwd

                        echo ""
                        echo "Repository files:"
                        find . -maxdepth 2 -type f | sort | head -200

                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // 07
        // ============================================================

        stage('07 - Prepare Terraform Plugin Cache') {

            steps {

                sh '''
                    set -eu

                    mkdir -p "${TF_PLUGIN_CACHE_DIR}"

                    echo "Terraform plugin cache:"
                    echo "${TF_PLUGIN_CACHE_DIR}"
                '''
            }
        }


        // ============================================================
        // 08
        // ============================================================

        stage('08 - Terraform Backend Configuration Check') {

            steps {

                dir('terraform-infra') {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "CHECKING TERRAFORM BACKEND CONFIGURATION"
                        echo "================================================"

                        echo ""
                        echo "Terraform files:"
                        find . -maxdepth 3 -type f \
                            \\( -name "*.tf" -o -name "*.tfvars" \\) \
                            | sort

                        echo ""
                        echo "Searching backend configuration:"

                        grep -Rni \
                            -E 'backend[[:space:]]+"s3"|bucket[[:space:]]*=|key[[:space:]]*=|region[[:space:]]*=|dynamodb_table|use_lockfile' \
                            --include='*.tf' \
                            . \
                            || true

                        echo ""
                        echo "Backend configuration check completed."
                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // 09
        // ============================================================

        stage('09 - Terraform Init') {

            steps {

                dir('terraform-infra') {

                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                         credentialsId: 'aws-creds']
                    ]) {

                        sh '''
                            set -eu

                            echo "================================================"
                            echo "TERRAFORM INIT"
                            echo "================================================"

                            export AWS_SDK_LOAD_CONFIG=1

                            echo ""
                            echo "AWS identity used by Terraform:"
                            aws sts get-caller-identity

                            echo ""
                            echo "Running Terraform init..."

                            terraform init \
                                -input=false \
                                -reconfigure

                            echo ""
                            echo "Terraform initialization PASSED."
                            echo "================================================"
                        '''
                    }
                }
            }
        }


        // ============================================================
        // 10
        // ============================================================

        stage('10 - Terraform Validate') {

            steps {

                dir('terraform-infra') {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "TERRAFORM VALIDATION"
                        echo "================================================"

                        terraform validate

                        echo ""
                        echo "Terraform validation PASSED."
                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // 11
        // ============================================================

        stage('11 - Terraform Destroy Plan') {

            steps {

                dir('terraform-infra') {

                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                         credentialsId: 'aws-creds']
                    ]) {

                        sh '''
                            set -eu

                            echo "================================================"
                            echo "TERRAFORM DESTROY PLAN"
                            echo "================================================"

                            export AWS_SDK_LOAD_CONFIG=1

                            TFVARS="environments/${ENVIRONMENT}/terraform.tfvars"

                            if [ ! -f "${TFVARS}" ]; then
                                echo "ERROR: Terraform variable file not found:"
                                echo "${TFVARS}"
                                exit 1
                            fi

                            echo ""
                            echo "AWS identity available to Terraform:"
                            aws sts get-caller-identity

                            echo ""
                            echo "Running destroy plan..."

                            terraform plan \
                                -destroy \
                                -input=false \
                                -var-file="${TFVARS}" \
                                -out=destroy.tfplan

                            echo ""
                            echo "Terraform destroy plan PASSED."
                            echo "================================================"
                        '''
                    }
                }
            }
        }


        // ============================================================
        // 12
        // ============================================================

        stage('12 - Terraform Destroy Infrastructure') {

            steps {

                dir('terraform-infra') {

                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                         credentialsId: 'aws-creds']
                    ]) {

                        sh '''
                            set -eu

                            echo "================================================"
                            echo "DESTROYING TERRAFORM INFRASTRUCTURE"
                            echo "================================================"

                            export AWS_SDK_LOAD_CONFIG=1

                            TFVARS="environments/${ENVIRONMENT}/terraform.tfvars"

                            if [ ! -f "${TFVARS}" ]; then
                                echo "ERROR: Terraform variable file not found:"
                                echo "${TFVARS}"
                                exit 1
                            fi

                            echo ""
                            echo "AWS identity:"
                            aws sts get-caller-identity

                            echo ""
                            echo "Starting Terraform destroy..."

                            terraform destroy \
                                -auto-approve \
                                -input=false \
                                -var-file="${TFVARS}"

                            echo ""
                            echo "Terraform infrastructure destruction PASSED."
                            echo "================================================"
                        '''
                    }
                }
            }
        }


        // ============================================================
        // 13
        // ============================================================

        stage('13 - Wait For Terraform Lock Release') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds']
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "WAITING FOR TERRAFORM LOCK RELEASE"
                        echo "================================================"

                        TABLE="${DYNAMODB_LOCK_TABLE}"

                        LOCK_KEY="${TERRAFORM_BACKEND_BUCKET}/${TERRAFORM_STATE_KEY}"

                        echo "LockID:"
                        echo "${LOCK_KEY}"

                        MAX_ATTEMPTS=30
                        ATTEMPT=1

                        while [ "${ATTEMPT}" -le "${MAX_ATTEMPTS}" ]
                        do

                            if ! aws dynamodb describe-table \
                                --table-name "${TABLE}" \
                                --region "${AWS_DEFAULT_REGION}" \
                                >/dev/null 2>&1
                            then
                                echo "DynamoDB lock table does not exist."
                                break
                            fi

                            KEY_JSON="$(jq -n \
                                --arg lockid "${LOCK_KEY}" \
                                '{LockID:{S:$lockid}}'
                            )"

                            ITEM="$(aws dynamodb get-item \
                                --table-name "${TABLE}" \
                                --key "${KEY_JSON}" \
                                --region "${AWS_DEFAULT_REGION}" \
                                --output json
                            )"

                            FOUND="$(echo "${ITEM}" | jq -r '.Item.LockID.S // empty')"

                            if [ -z "${FOUND}" ]
                            then
                                echo "Terraform lock is released."
                                break
                            fi

                            echo "Terraform lock still exists."
                            echo "Attempt ${ATTEMPT}/${MAX_ATTEMPTS}"

                            ATTEMPT=$((ATTEMPT + 1))

                            sleep 10

                        done

                        if [ "${ATTEMPT}" -gt "${MAX_ATTEMPTS}" ]
                        then
                            echo ""
                            echo "ERROR: Terraform lock was not released."
                            exit 1
                        fi

                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // 14
        // ============================================================

        stage('14 - Verify No Active Terraform Lock') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds']
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "VERIFYING NO ACTIVE TERRAFORM LOCK"
                        echo "================================================"

                        TABLE="${DYNAMODB_LOCK_TABLE}"

                        LOCK_KEY="${TERRAFORM_BACKEND_BUCKET}/${TERRAFORM_STATE_KEY}"

                        echo "LockID:"
                        echo "${LOCK_KEY}"

                        if ! aws dynamodb describe-table \
                            --table-name "${TABLE}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            >/dev/null 2>&1
                        then
                            echo "DynamoDB table does not exist."
                            echo "No Terraform lock can exist."
                            exit 0
                        fi

                        KEY_JSON="$(jq -n \
                            --arg lockid "${LOCK_KEY}" \
                            '{LockID:{S:$lockid}}'
                        )"

                        ITEM="$(aws dynamodb get-item \
                            --table-name "${TABLE}" \
                            --key "${KEY_JSON}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            --output json
                        )"

                        FOUND="$(echo "${ITEM}" | jq -r '.Item.LockID.S // empty')"

                        if [ -n "${FOUND}" ]
                        then
                            echo ""
                            echo "ERROR: ACTIVE TERRAFORM LOCK DETECTED."
                            echo "LockID: ${FOUND}"
                            echo ""
                            echo "Backend deletion has been stopped."
                            exit 1
                        fi

                        echo ""
                        echo "NO ACTIVE TERRAFORM LOCK FOUND."
                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // 15
        // ============================================================

        stage('15 - Check Terraform State Object') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds']
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "CHECKING TERRAFORM STATE OBJECT"
                        echo "================================================"

                        BUCKET="${TERRAFORM_BACKEND_BUCKET}"
                        KEY="${TERRAFORM_STATE_KEY}"

                        if aws s3api head-object \
                            --bucket "${BUCKET}" \
                            --key "${KEY}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            >/dev/null 2>&1
                        then
                            echo "Terraform state object exists:"
                            echo "s3://${BUCKET}/${KEY}"
                        else
                            echo "Terraform state object does not exist."
                        fi

                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // 16
        // ============================================================

        stage('16 - Delete Terraform State Object') {

            when {

                expression {
                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds']
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "DELETING TERRAFORM STATE OBJECT"
                        echo "================================================"

                        BUCKET="${TERRAFORM_BACKEND_BUCKET}"
                        KEY="${TERRAFORM_STATE_KEY}"

                        if aws s3api head-object \
                            --bucket "${BUCKET}" \
                            --key "${KEY}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            >/dev/null 2>&1
                        then

                            aws s3api delete-object \
                                --bucket "${BUCKET}" \
                                --key "${KEY}" \
                                --region "${AWS_DEFAULT_REGION}"

                            echo "Terraform state object deletion requested."

                        else

                            echo "Terraform state object already absent."

                        fi

                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // 17
        // ============================================================

        stage('17 - Delete All S3 Object Versions') {

            when {

                expression {
                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds']
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "DELETING ALL S3 OBJECT VERSIONS"
                        echo "================================================"

                        BUCKET="${TERRAFORM_BACKEND_BUCKET}"

                        if ! aws s3api head-bucket \
                            --bucket "${BUCKET}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            >/dev/null 2>&1
                        then
                            echo "Bucket does not exist."
                            exit 0
                        fi

                        echo ""
                        echo "Removing object versions and delete markers..."

                        while true
                        do

                            OBJECTS="$(aws s3api list-object-versions \
                                --bucket "${BUCKET}" \
                                --region "${AWS_DEFAULT_REGION}" \
                                --output json
                            )"

                            DELETE_JSON="$(echo "${OBJECTS}" | jq -c '
                                [
                                    (.Versions // [])[] |
                                    {
                                        Key: .Key,
                                        VersionId: .VersionId
                                    }
                                ] +
                                [
                                    (.DeleteMarkers // [])[] |
                                    {
                                        Key: .Key,
                                        VersionId: .VersionId
                                    }
                                ]
                            ')"

                            COUNT="$(echo "${DELETE_JSON}" | jq 'length')"

                            if [ "${COUNT}" -eq 0 ]
                            then
                                echo "No more object versions or delete markers."
                                break
                            fi

                            echo "Deleting ${COUNT} object versions/delete markers..."

                            aws s3api delete-objects \
                                --bucket "${BUCKET}" \
                                --delete "${DELETE_JSON}" \
                                --region "${AWS_DEFAULT_REGION}"

                        done

                        echo ""
                        echo "All S3 object versions removed."
                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // 18
        // ============================================================

        stage('18 - Verify S3 Bucket Empty') {

            when {

                expression {
                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds']
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "VERIFYING S3 BUCKET IS EMPTY"
                        echo "================================================"

                        BUCKET="${TERRAFORM_BACKEND_BUCKET}"

                        if ! aws s3api head-bucket \
                            --bucket "${BUCKET}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            >/dev/null 2>&1
                        then
                            echo "Bucket already deleted."
                            exit 0
                        fi

                        OBJECT_COUNT="$(aws s3api list-objects-v2 \
                            --bucket "${BUCKET}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            --query 'KeyCount' \
                            --output text
                        )"

                        VERSION_COUNT="$(aws s3api list-object-versions \
                            --bucket "${BUCKET}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            --query 'length(Versions || [])' \
                            --output text
                        )"

                        DELETE_MARKER_COUNT="$(aws s3api list-object-versions \
                            --bucket "${BUCKET}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            --query 'length(DeleteMarkers || [])' \
                            --output text
                        )"

                        echo "Current objects          : ${OBJECT_COUNT}"
                        echo "Object versions         : ${VERSION_COUNT}"
                        echo "Delete markers          : ${DELETE_MARKER_COUNT}"

                        if [ "${OBJECT_COUNT}" != "0" ] || \
                           [ "${VERSION_COUNT}" != "0" ] || \
                           [ "${DELETE_MARKER_COUNT}" != "0" ]
                        then
                            echo ""
                            echo "ERROR: S3 bucket is not completely empty."
                            exit 1
                        fi

                        echo ""
                        echo "S3 bucket is completely empty."
                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // 19
        // ============================================================

        stage('19 - Delete Terraform S3 Backend Bucket') {

            when {

                expression {
                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds']
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "DELETING TERRAFORM S3 BACKEND BUCKET"
                        echo "================================================"

                        BUCKET="${TERRAFORM_BACKEND_BUCKET}"

                        if aws s3api head-bucket \
                            --bucket "${BUCKET}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            >/dev/null 2>&1
                        then

                            aws s3api delete-bucket \
                                --bucket "${BUCKET}" \
                                --region "${AWS_DEFAULT_REGION}"

                            echo "S3 backend bucket deletion requested."

                        else

                            echo "S3 backend bucket already absent."

                        fi

                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // 20
        // ============================================================

        stage('20 - Verify S3 Bucket Deleted') {

            when {

                expression {
                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds']
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "VERIFYING S3 BACKEND BUCKET DELETION"
                        echo "================================================"

                        BUCKET="${TERRAFORM_BACKEND_BUCKET}"

                        ATTEMPT=1
                        MAX_ATTEMPTS=30

                        while [ "${ATTEMPT}" -le "${MAX_ATTEMPTS}" ]
                        do

                            if aws s3api head-bucket \
                                --bucket "${BUCKET}" \
                                --region "${AWS_DEFAULT_REGION}" \
                                >/dev/null 2>&1
                            then

                                echo "Bucket still exists."
                                echo "Attempt ${ATTEMPT}/${MAX_ATTEMPTS}"

                                ATTEMPT=$((ATTEMPT + 1))

                                sleep 5

                            else

                                echo ""
                                echo "S3 backend bucket has been deleted."
                                break

                            fi

                        done

                        if [ "${ATTEMPT}" -gt "${MAX_ATTEMPTS}" ]
                        then
                            echo ""
                            echo "ERROR: S3 bucket deletion could not be verified."
                            exit 1
                        fi

                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // 21
        // ============================================================

        stage('21 - Delete DynamoDB Lock Table') {

            when {

                expression {
                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds']
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "DELETING DYNAMODB LOCK TABLE"
                        echo "================================================"

                        TABLE="${DYNAMODB_LOCK_TABLE}"

                        if aws dynamodb describe-table \
                            --table-name "${TABLE}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            >/dev/null 2>&1
                        then

                            aws dynamodb delete-table \
                                --table-name "${TABLE}" \
                                --region "${AWS_DEFAULT_REGION}"

                            echo "DynamoDB table deletion requested."

                        else

                            echo "DynamoDB table already absent."

                        fi

                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // 22
        // ============================================================

        stage('22 - Wait For DynamoDB Table Deletion') {

            when {

                expression {
                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds']
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "WAITING FOR DYNAMODB TABLE DELETION"
                        echo "================================================"

                        TABLE="${DYNAMODB_LOCK_TABLE}"

                        ATTEMPT=1
                        MAX_ATTEMPTS=30

                        while [ "${ATTEMPT}" -le "${MAX_ATTEMPTS}" ]
                        do

                            if aws dynamodb describe-table \
                                --table-name "${TABLE}" \
                                --region "${AWS_DEFAULT_REGION}" \
                                >/dev/null 2>&1
                            then

                                echo "DynamoDB table still exists."
                                echo "Attempt ${ATTEMPT}/${MAX_ATTEMPTS}"

                                ATTEMPT=$((ATTEMPT + 1))

                                sleep 5

                            else

                                echo ""
                                echo "DynamoDB table no longer exists."
                                break

                            fi

                        done

                        if [ "${ATTEMPT}" -gt "${MAX_ATTEMPTS}" ]
                        then
                            echo ""
                            echo "ERROR: DynamoDB table deletion could not be verified."
                            exit 1
                        fi

                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // 23
        // ============================================================

        stage('23 - Final Destruction Verification') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds']
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "FINAL DESTRUCTION VERIFICATION"
                        echo "================================================"

                        BUCKET="${TERRAFORM_BACKEND_BUCKET}"
                        TABLE="${DYNAMODB_LOCK_TABLE}"

                        echo ""
                        echo "Checking S3 bucket..."

                        if aws s3api head-bucket \
                            --bucket "${BUCKET}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            >/dev/null 2>&1
                        then
                            echo "S3 bucket STILL EXISTS."
                            exit 1
                        else
                            echo "S3 bucket: DELETED"
                        fi

                        echo ""
                        echo "Checking DynamoDB table..."

                        if aws dynamodb describe-table \
                            --table-name "${TABLE}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            >/dev/null 2>&1
                        then
                            echo "DynamoDB table STILL EXISTS."
                            exit 1
                        else
                            echo "DynamoDB table: DELETED"
                        fi

                        echo ""
                        echo "================================================"
                        echo "FINAL VERIFICATION PASSED"
                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // 24
        // ============================================================

        stage('24 - Final Destruction Report') {

            steps {

                echo ''
                echo '================================================'
                echo '       TERRAFORM DESTRUCTION COMPLETE'
                echo '================================================'
                echo ''
                echo "Environment              : ${params.ENVIRONMENT}"
                echo "AWS Region               : ${params.AWS_REGION}"
                echo "Terraform Infrastructure : DESTROYED"
                echo "Terraform State          : REMOVED"
                echo "S3 Backend Bucket        : REMOVED"
                echo "DynamoDB Lock Table      : REMOVED"
                echo ''
                echo 'Backend cleanup          : COMPLETE'
                echo 'Final verification       : PASSED'
                echo ''
                echo '================================================'
            }
        }
    }


    // ================================================================
    // POST ACTIONS
    // ================================================================

    post {

        always {

            echo ''
            echo '================================================'
            echo '       CLEANING JENKINS WORKSPACE'
            echo '================================================'

            cleanWs(
                deleteDirs: true,
                disableDeferredWipeout: true,
                notFailBuild: true
            )
        }


        success {

            echo ''
            echo '================================================'
            echo '       DESTROY PIPELINE SUCCESSFUL'
            echo '================================================'
            echo ''
            echo "Environment : ${params.ENVIRONMENT}"
            echo "Build       : ${BUILD_NUMBER}"
            echo "Region      : ${params.AWS_REGION}"
            echo ''
            echo 'Terraform infrastructure was destroyed.'
            echo 'Terraform backend cleanup was completed.'
            echo 'S3 bucket and DynamoDB lock table were deleted.'
            echo ''
            echo '================================================'
        }


        failure {

            echo ''
            echo '================================================'
            echo '       DESTROY PIPELINE FAILED'
            echo '================================================'
            echo ''
            echo "Environment : ${params.ENVIRONMENT}"
            echo "Build       : ${BUILD_NUMBER}"
            echo "Region      : ${params.AWS_REGION}"
            echo ''
            echo 'The pipeline stopped at the failed stage.'
            echo ''
            echo 'IMPORTANT:'
            echo 'The Terraform backend is protected unless'
            echo 'Terraform destruction and lock verification'
            echo 'successfully complete.'
            echo ''
            echo 'Check the failed stage above.'
            echo ''
            echo '================================================'
        }
    }
}
