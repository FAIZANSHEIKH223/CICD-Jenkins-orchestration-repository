pipeline {

    agent any

    // ================================================================
    // PIPELINE OPTIONS
    // ================================================================

    options {
        timestamps()
        ansiColor('xterm')
        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                daysToKeepStr: '30',
                numToKeepStr: '50'
            )
        )

        timeout(
            time: 120,
            unit: 'MINUTES'
        )
    }

    // ================================================================
    // PARAMETERS
    // ================================================================

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: [
                'dev',
                'qa',
                'stage',
                'prod'
            ],
            description: 'Terraform environment to destroy'
        )

        booleanParam(
            name: 'DELETE_TERRAFORM_BACKEND',
            defaultValue: true,
            description: 'Delete Terraform S3 state bucket and DynamoDB lock table after Terraform destroy'
        )
    }

    // ================================================================
    // ENVIRONMENT
    // ================================================================

    environment {

        TERRAFORM_REPO = 'https://github.com/FAIZANSHEIKH223/terraform-aws-infra.git'
        TERRAFORM_BRANCH = 'main'

        GITHUB_CREDENTIALS = 'github-creds'
        AWS_CREDENTIALS = 'aws-creds'

        TERRAFORM_DIR = 'terraform-infra'

        AWS_DEFAULT_REGION = 'us-east-1'

        TF_STATE_BUCKET = 'terraform-state-faizan-001'
        TF_LOCK_TABLE = 'terraform-locks'
        TF_STATE_KEY = 'terraform.tfstate'

        TF_IN_AUTOMATION = 'true'
        TF_INPUT = 'false'
    }

    // ================================================================
    // STAGES
    // ================================================================

    stages {

        // ============================================================
        // 1 - CHECKOUT TERRAFORM
        // ============================================================

        stage('1 - Checkout Terraform Repository') {
            steps {

                echo '================================================'
                echo 'CHECKOUT TERRAFORM REPOSITORY'
                echo '================================================'

                dir("${TERRAFORM_DIR}") {

                    deleteDir()

                    git(
                        branch: "${TERRAFORM_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${TERRAFORM_REPO}"
                    )
                }
            }
        }

        // ============================================================
        // 2 - VERIFY TERRAFORM
        // ============================================================

        stage('2 - Verify Terraform') {
            steps {

                dir("${TERRAFORM_DIR}") {

                    sh(
                        label: 'Verify Terraform',
                        script: '''#!/usr/bin/env bash

set -euo pipefail

echo "================================================"
echo "VERIFYING TERRAFORM"
echo "================================================"

command -v terraform

terraform version

echo ""
echo "Terraform files:"

find . \
    -maxdepth 5 \
    -type f \
    -name "*.tf" \
    -print
'''
                    )
                }
            }
        }

        // ============================================================
        // 3 - VERIFY ENVIRONMENT
        // ============================================================

        stage('3 - Verify Terraform Environment') {
            steps {

                dir("${TERRAFORM_DIR}") {

                    sh(
                        label: 'Verify Terraform environment',
                        script: '''#!/usr/bin/env bash

set -euo pipefail

ENV_DIR="environments/${ENVIRONMENT}"

echo "================================================"
echo "VERIFYING TERRAFORM ENVIRONMENT"
echo "================================================"

echo "Environment : ${ENVIRONMENT}"
echo "Directory   : ${ENV_DIR}"

if [ ! -d "${ENV_DIR}" ]; then
    echo "ERROR: Terraform environment directory does not exist:"
    echo "${ENV_DIR}"
    exit 1
fi

if [ ! -f "${ENV_DIR}/terraform.tfvars" ]; then
    echo "ERROR: terraform.tfvars does not exist:"
    echo "${ENV_DIR}/terraform.tfvars"
    exit 1
fi

echo ""
echo "Terraform environment verified successfully."
'''
                    )
                }
            }
        }

        // ============================================================
        // 4 - VERIFY AWS CLI
        // ============================================================

        stage('4 - Verify AWS CLI') {
            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh(
                        label: 'Verify AWS CLI',
                        script: '''#!/usr/bin/env bash

set -euo pipefail

echo "================================================"
echo "VERIFYING AWS CLI"
echo "================================================"

command -v aws

aws --version

echo ""
echo "AWS Identity:"

aws sts get-caller-identity \
    --region "${AWS_DEFAULT_REGION}"
'''
                    )
                }
            }
        }

        // ============================================================
        // 5 - VERIFY BACKEND
        // ============================================================

        stage('5 - Verify Terraform Backend') {
            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh(
                        label: 'Verify Terraform backend',
                        script: '''#!/usr/bin/env bash

set -euo pipefail

echo "================================================"
echo "VERIFYING TERRAFORM BACKEND"
echo "================================================"

echo "S3 Bucket      : ${TF_STATE_BUCKET}"
echo "State Key      : ${TF_STATE_KEY}"
echo "DynamoDB Table : ${TF_LOCK_TABLE}"
echo "Region         : ${AWS_DEFAULT_REGION}"

echo ""
echo "Checking S3 bucket..."

if aws s3api head-bucket \
    --bucket "${TF_STATE_BUCKET}" \
    --region "${AWS_DEFAULT_REGION}" \
    > /dev/null 2>&1
then
    echo "S3 bucket exists."
else
    echo "WARNING: S3 bucket does not exist."
fi

echo ""
echo "Checking DynamoDB table..."

if aws dynamodb describe-table \
    --table-name "${TF_LOCK_TABLE}" \
    --region "${AWS_DEFAULT_REGION}" \
    > /dev/null 2>&1
then
    echo "DynamoDB table exists."
else
    echo "WARNING: DynamoDB table does not exist."
fi
'''
                    )
                }
            }
        }

        // ============================================================
        // 6 - VERIFY TERRAFORM LOCK
        //
        // IMPORTANT:
        // The previous pipeline generated invalid JSON:
        //
        // {LockID:{S\:bucket/key}}
        //
        // This version generates:
        //
        // {"LockID":{"S":"bucket/key"}}
        //
        // It also checks specifically for the Terraform Info
        // attribute instead of treating Digest as an active lock.
        // ============================================================

        stage('6 - Verify No Active Terraform Lock') {
            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh(
                        label: 'Verify Terraform lock',
                        script: '''#!/usr/bin/env bash

set -euo pipefail

echo "================================================"
echo "CHECKING TERRAFORM LOCK"
echo "================================================"

LOCK_ID="${TF_STATE_BUCKET}/${TF_STATE_KEY}"

echo "LockID:"
echo "${LOCK_ID}"

echo ""
echo "Creating valid DynamoDB key JSON..."

LOCK_KEY_JSON="$(printf '{"LockID":{"S":"%s"}}' "${LOCK_ID}")"

echo "DynamoDB key JSON:"
echo "${LOCK_KEY_JSON}"

echo ""
echo "Checking DynamoDB lock item..."

LOCK_ITEM="$(
    aws dynamodb get-item \
        --table-name "${TF_LOCK_TABLE}" \
        --key "${LOCK_KEY_JSON}" \
        --consistent-read \
        --region "${AWS_DEFAULT_REGION}" \
        --output json
)"

echo ""
echo "DynamoDB response:"
echo "${LOCK_ITEM}"

ACTIVE_LOCK="$(
    printf '%s' "${LOCK_ITEM}" |
    python3 -c '
import json
import sys

data = json.load(sys.stdin)
item = data.get("Item", {})

if item.get("Info"):
    print("true")
else:
    print("false")
'
)"

echo ""
echo "Active Terraform lock: ${ACTIVE_LOCK}"

if [ "${ACTIVE_LOCK}" = "true" ]; then

    echo ""
    echo "================================================"
    echo "ERROR: ACTIVE TERRAFORM LOCK DETECTED"
    echo "================================================"

    echo ""
    echo "Terraform lock information:"

    printf '%s' "${LOCK_ITEM}" |
    python3 -m json.tool || true

    echo ""
    echo "Terraform destruction will NOT continue."
    echo "Do not manually delete the lock while another"
    echo "Terraform operation may still be running."

    exit 1
fi

echo ""
echo "No active Terraform lock detected."
echo "It is safe to continue."
'''
                    )
                }
            }
        }

        // ============================================================
        // 7 - CHECK STATE OBJECT
        // ============================================================

        stage('7 - Check Terraform State Object') {
            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    script {

                        def stateExists = sh(
                            label: 'Check Terraform state object',
                            script: '''#!/usr/bin/env bash

set +e

aws s3api head-object \
    --bucket "${TF_STATE_BUCKET}" \
    --key "${TF_STATE_KEY}" \
    --region "${AWS_DEFAULT_REGION}" \
    > /dev/null 2>&1

RESULT=$?

set -e

if [ "${RESULT}" -eq 0 ]; then
    echo "true"
else
    echo "false"
fi
''',
                            returnStdout: true
                        ).trim()

                        env.TF_STATE_EXISTS = stateExists

                        echo "Terraform state exists: ${env.TF_STATE_EXISTS}"
                    }
                }
            }
        }

        // ============================================================
        // 8 - TERRAFORM INIT
        // ============================================================

        stage('8 - Terraform Init') {
            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh(
                            label: 'Terraform init',
                            script: '''#!/usr/bin/env bash

set -euo pipefail

echo "================================================"
echo "TERRAFORM INIT"
echo "================================================"

terraform init \
    -input=false \
    -reconfigure \
    -backend-config="bucket=${TF_STATE_BUCKET}" \
    -backend-config="key=${TF_STATE_KEY}" \
    -backend-config="region=${AWS_DEFAULT_REGION}" \
    -backend-config="dynamodb_table=${TF_LOCK_TABLE}" \
    -backend-config="encrypt=true"

echo ""
echo "Terraform init completed."
'''
                        )
                    }
                }
            }
        }

        // ============================================================
        // 9 - TERRAFORM VALIDATE
        // ============================================================

        stage('9 - Terraform Validate') {
            steps {

                dir("${TERRAFORM_DIR}") {

                    sh(
                        label: 'Terraform validate',
                        script: '''#!/usr/bin/env bash

set -euo pipefail

echo "================================================"
echo "TERRAFORM VALIDATE"
echo "================================================"

terraform validate

echo ""
echo "Terraform validation passed."
'''
                    )
                }
            }
        }

        // ============================================================
        // 10 - TERRAFORM PLAN DESTROY
        // ============================================================

        stage('10 - Terraform Destroy Plan') {
            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh(
                            label: 'Terraform destroy plan',
                            script: '''#!/usr/bin/env bash

set -euo pipefail

echo "================================================"
echo "TERRAFORM DESTROY PLAN"
echo "================================================"

rm -f tf-destroy-plan

terraform plan \
    -destroy \
    -input=false \
    -var-file="environments/${ENVIRONMENT}/terraform.tfvars" \
    -out="tf-destroy-plan"

if [ ! -f tf-destroy-plan ]; then
    echo "ERROR: Terraform destroy plan was not created."
    exit 1
fi

echo ""
echo "Terraform destroy plan created successfully."
'''
                        )
                    }
                }
            }
        }

        // ============================================================
        // 11 - TERRAFORM DESTROY
        // ============================================================

        stage('11 - Terraform Destroy') {
            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh(
                            label: 'Terraform destroy',
                            script: '''#!/usr/bin/env bash

set -euo pipefail

echo "================================================"
echo "TERRAFORM DESTROY"
echo "================================================"

if [ ! -f tf-destroy-plan ]; then
    echo "ERROR: tf-destroy-plan was not found."
    exit 1
fi

terraform apply \
    -input=false \
    -auto-approve \
    tf-destroy-plan

echo ""
echo "Terraform infrastructure destruction completed."
'''
                        )
                    }
                }
            }
        }

        // ============================================================
        // 12 - VERIFY TERRAFORM RESOURCES DESTROYED
        // ============================================================

        stage('12 - Verify Terraform Resources Destroyed') {
            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh(
                            label: 'Verify Terraform destruction',
                            script: '''#!/usr/bin/env bash

set -euo pipefail

echo "================================================"
echo "VERIFYING TERRAFORM DESTRUCTION"
echo "================================================"

echo ""
echo "Terraform state list:"

terraform state list || true

echo ""
echo "Terraform outputs:"

terraform output || true

echo ""
echo "Terraform destruction verification completed."
'''
                        )
                    }
                }
            }
        }

        // ============================================================
        // 13 - DELETE TERRAFORM STATE OBJECT
        // ============================================================

        stage('13 - Delete Terraform State Object') {
            when {
                expression {
                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh(
                        label: 'Delete Terraform state object',
                        script: '''#!/usr/bin/env bash

set -euo pipefail

echo "================================================"
echo "DELETING TERRAFORM STATE OBJECT"
echo "================================================"

if aws s3api head-object \
    --bucket "${TF_STATE_BUCKET}" \
    --key "${TF_STATE_KEY}" \
    --region "${AWS_DEFAULT_REGION}" \
    > /dev/null 2>&1
then

    echo "Terraform state object exists."
    echo "Deleting state object."

    aws s3api delete-object \
        --bucket "${TF_STATE_BUCKET}" \
        --key "${TF_STATE_KEY}" \
        --region "${AWS_DEFAULT_REGION}"

    echo "Terraform state object deleted."

else

    echo "Terraform state object does not exist."
    echo "Nothing to delete."

fi
'''
                    )
                }
            }
        }

        // ============================================================
        // 14 - DELETE ALL S3 OBJECT VERSIONS
        // ============================================================

        stage('14 - Delete All S3 Object Versions') {
            when {
                expression {
                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh(
                        label: 'Delete all S3 object versions',
                        script: '''#!/usr/bin/env bash

set -euo pipefail

echo "================================================"
echo "DELETING ALL S3 OBJECT VERSIONS"
echo "================================================"

if ! aws s3api head-bucket \
    --bucket "${TF_STATE_BUCKET}" \
    --region "${AWS_DEFAULT_REGION}" \
    > /dev/null 2>&1
then

    echo "S3 bucket does not exist."
    echo "Nothing to clean."

    exit 0
fi

echo "Deleting all object versions and delete markers."

while true; do

    VERSION_DATA="$(
        aws s3api list-object-versions \
            --bucket "${TF_STATE_BUCKET}" \
            --region "${AWS_DEFAULT_REGION}" \
            --output json
    )"

    VERSION_COUNT="$(
        printf '%s' "${VERSION_DATA}" |
        python3 -c '
import json
import sys

data = json.load(sys.stdin)

versions = data.get("Versions", [])
markers = data.get("DeleteMarkers", [])

print(len(versions) + len(markers))
'
    )"

    echo "Objects remaining in current batch: ${VERSION_COUNT}"

    if [ "${VERSION_COUNT}" -eq 0 ]; then
        break
    fi

    DELETE_JSON="$(
        printf '%s' "${VERSION_DATA}" |
        python3 -c '
import json
import sys

data = json.load(sys.stdin)

objects = []

for item in data.get("Versions", []):
    objects.append({
        "Key": item["Key"],
        "VersionId": item["VersionId"]
    })

for item in data.get("DeleteMarkers", []):
    objects.append({
        "Key": item["Key"],
        "VersionId": item["VersionId"]
    })

print(json.dumps({"Objects": objects, "Quiet": True}))
'
    )"

    aws s3api delete-objects \
        --bucket "${TF_STATE_BUCKET}" \
        --delete "${DELETE_JSON}" \
        --region "${AWS_DEFAULT_REGION}"

done

echo ""
echo "All S3 object versions and delete markers removed."
'''
                    )
                }
            }
        }

        // ============================================================
        // 15 - VERIFY S3 EMPTY
        // ============================================================

        stage('15 - Verify S3 Bucket Empty') {
            when {
                expression {
                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh(
                        label: 'Verify S3 bucket empty',
                        script: '''#!/usr/bin/env bash

set -euo pipefail

echo "================================================"
echo "VERIFYING S3 BUCKET EMPTY"
echo "================================================"

if ! aws s3api head-bucket \
    --bucket "${TF_STATE_BUCKET}" \
    --region "${AWS_DEFAULT_REGION}" \
    > /dev/null 2>&1
then

    echo "Bucket does not exist."
    exit 0
fi

OBJECT_COUNT="$(
    aws s3api list-objects-v2 \
        --bucket "${TF_STATE_BUCKET}" \
        --region "${AWS_DEFAULT_REGION}" \
        --query 'KeyCount' \
        --output text
)"

VERSION_COUNT="$(
    aws s3api list-object-versions \
        --bucket "${TF_STATE_BUCKET}" \
        --region "${AWS_DEFAULT_REGION}" \
        --query 'length(Versions || `[]`) + length(DeleteMarkers || `[]`)' \
        --output text
)"

echo "Current objects       : ${OBJECT_COUNT}"
echo "Versions/delete marks : ${VERSION_COUNT}"

if [ "${OBJECT_COUNT}" != "0" ]; then
    echo "ERROR: S3 bucket still contains objects."
    exit 1
fi

if [ "${VERSION_COUNT}" != "0" ]; then
    echo "ERROR: S3 bucket still contains object versions or delete markers."
    exit 1
fi

echo ""
echo "S3 bucket is completely empty."
'''
                    )
                }
            }
        }

        // ============================================================
        // 16 - DELETE S3 BACKEND BUCKET
        // ============================================================

        stage('16 - Delete Terraform S3 Backend Bucket') {
            when {
                expression {
                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh(
                        label: 'Delete Terraform S3 backend bucket',
                        script: '''#!/usr/bin/env bash

set -euo pipefail

echo "================================================"
echo "DELETING TERRAFORM S3 BACKEND BUCKET"
echo "================================================"

if aws s3api head-bucket \
    --bucket "${TF_STATE_BUCKET}" \
    --region "${AWS_DEFAULT_REGION}" \
    > /dev/null 2>&1
then

    echo "Bucket exists."
    echo "Deleting bucket."

    aws s3api delete-bucket \
        --bucket "${TF_STATE_BUCKET}" \
        --region "${AWS_DEFAULT_REGION}"

    echo ""
    echo "S3 bucket deletion request completed."

else

    echo "S3 bucket does not exist."
    echo "Nothing to delete."

fi
'''
                    )
                }
            }
        }

        // ============================================================
        // 17 - VERIFY S3 DELETED
        // ============================================================

        stage('17 - Verify S3 Bucket Deleted') {
            when {
                expression {
                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh(
                        label: 'Verify S3 bucket deleted',
                        script: '''#!/usr/bin/env bash

set -euo pipefail

echo "================================================"
echo "VERIFYING S3 BUCKET DELETION"
echo "================================================"

if aws s3api head-bucket \
    --bucket "${TF_STATE_BUCKET}" \
    --region "${AWS_DEFAULT_REGION}" \
    > /dev/null 2>&1
then

    echo "ERROR: S3 bucket still exists."
    exit 1

else

    echo "S3 bucket has been deleted successfully."

fi
'''
                    )
                }
            }
        }

        // ============================================================
        // 18 - DELETE DYNAMODB TABLE
        // ============================================================

        stage('18 - Delete DynamoDB Lock Table') {
            when {
                expression {
                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh(
                        label: 'Delete DynamoDB lock table',
                        script: '''#!/usr/bin/env bash

set -euo pipefail

echo "================================================"
echo "DELETING DYNAMODB LOCK TABLE"
echo "================================================"

if aws dynamodb describe-table \
    --table-name "${TF_LOCK_TABLE}" \
    --region "${AWS_DEFAULT_REGION}" \
    > /dev/null 2>&1
then

    echo "DynamoDB table exists."
    echo "Deleting table."

    aws dynamodb delete-table \
        --table-name "${TF_LOCK_TABLE}" \
        --region "${AWS_DEFAULT_REGION}"

    echo ""
    echo "Waiting for DynamoDB table deletion."

    aws dynamodb wait table-not-exists \
        --table-name "${TF_LOCK_TABLE}" \
        --region "${AWS_DEFAULT_REGION}"

    echo ""
    echo "DynamoDB table deleted successfully."

else

    echo "DynamoDB table does not exist."
    echo "Nothing to delete."

fi
'''
                    )
                }
            }
        }

        // ============================================================
        // 19 - VERIFY DYNAMODB DELETED
        // ============================================================

        stage('19 - Verify DynamoDB Table Deleted') {
            when {
                expression {
                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh(
                        label: 'Verify DynamoDB table deleted',
                        script: '''#!/usr/bin/env bash

set -euo pipefail

echo "================================================"
echo "VERIFYING DYNAMODB TABLE DELETION"
echo "================================================"

if aws dynamodb describe-table \
    --table-name "${TF_LOCK_TABLE}" \
    --region "${AWS_DEFAULT_REGION}" \
    > /dev/null 2>&1
then

    echo "ERROR: DynamoDB table still exists."
    exit 1

else

    echo "DynamoDB lock table has been deleted successfully."

fi
'''
                    )
                }
            }
        }

        // ============================================================
        // 20 - FINAL VERIFICATION
        // ============================================================

        stage('20 - Final Destruction Verification') {
            when {
                expression {
                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh(
                        label: 'Final destruction verification',
                        script: '''#!/usr/bin/env bash

set -euo pipefail

echo "================================================"
echo "FINAL DESTRUCTION VERIFICATION"
echo "================================================"

S3_DELETED=false
DDB_DELETED=false

if aws s3api head-bucket \
    --bucket "${TF_STATE_BUCKET}" \
    --region "${AWS_DEFAULT_REGION}" \
    > /dev/null 2>&1
then
    echo "S3 Bucket: STILL EXISTS"
else
    echo "S3 Bucket: DELETED"
    S3_DELETED=true
fi

if aws dynamodb describe-table \
    --table-name "${TF_LOCK_TABLE}" \
    --region "${AWS_DEFAULT_REGION}" \
    > /dev/null 2>&1
then
    echo "DynamoDB Table: STILL EXISTS"
else
    echo "DynamoDB Table: DELETED"
    DDB_DELETED=true
fi

if [ "${S3_DELETED}" != "true" ]; then
    echo "ERROR: S3 backend bucket was not deleted."
    exit 1
fi

if [ "${DDB_DELETED}" != "true" ]; then
    echo "ERROR: DynamoDB lock table was not deleted."
    exit 1
fi

echo ""
echo "================================================"
echo "BACKEND COMPLETELY REMOVED"
echo "================================================"
'''
                    )
                }
            }
        }

        // ============================================================
        // 21 - FINAL REPORT
        // ============================================================

        stage('21 - Final Destruction Report') {
            steps {

                echo ''
                echo '================================================'
                echo '       FINAL TERRAFORM DESTRUCTION REPORT'
                echo '================================================'
                echo ''

                echo "Environment       : ${env.ENVIRONMENT}"
                echo "AWS Region        : ${env.AWS_DEFAULT_REGION}"
                echo "Terraform Repo    : ${env.TERRAFORM_REPO}"
                echo "Terraform Dir     : ${env.TERRAFORM_DIR}"

                echo ''
                echo 'Terraform Infrastructure : DESTROYED'

                if (params.DELETE_TERRAFORM_BACKEND) {

                    echo ''
                    echo 'Terraform State Bucket   : DELETED'
                    echo 'Terraform State Object   : DELETED'
                    echo 'S3 Object Versions       : DELETED'
                    echo 'S3 Delete Markers        : DELETED'
                    echo 'DynamoDB Lock Table      : DELETED'
                }

                echo ''
                echo '================================================'
                echo '       COMPLETE DESTRUCTION SUCCESS'
                echo '================================================'
            }
        }
    }

    // ================================================================
    // POST ACTIONS
    // ================================================================

    post {

        success {

            echo ''
            echo '================================================'
            echo '       DESTROY PIPELINE SUCCESS'
            echo '================================================'
            echo ''

            echo "Environment : ${env.ENVIRONMENT}"
            echo "Region      : ${env.AWS_DEFAULT_REGION}"

            echo ''
            echo 'Terraform infrastructure : DESTROYED'

            if (params.DELETE_TERRAFORM_BACKEND) {

                echo 'S3 state bucket           : DELETED'
                echo 'S3 state object           : DELETED'
                echo 'S3 object versions        : DELETED'
                echo 'S3 delete markers         : DELETED'
                echo 'DynamoDB lock table       : DELETED'
            }

            echo ''
            echo '================================================'
            echo '       EVERYTHING REQUESTED WAS REMOVED'
            echo '================================================'
        }

        failure {

            echo ''
            echo '================================================'
            echo '       DESTROY PIPELINE FAILED'
            echo '================================================'
            echo ''

            echo "Environment : ${env.ENVIRONMENT}"
            echo "Build       : ${env.BUILD_NUMBER}"
            echo "Region      : ${env.AWS_DEFAULT_REGION}"

            echo ''
            echo 'The pipeline stopped because a destruction or'
            echo 'verification step failed.'

            echo ''
            echo 'Check the failed stage above for the exact error.'

            echo ''
            echo '================================================'
        }

        aborted {

            echo ''
            echo '================================================'
            echo '       DESTROY PIPELINE ABORTED'
            echo '================================================'
            echo ''

            echo "Environment : ${env.ENVIRONMENT}"
            echo "Build       : ${env.BUILD_NUMBER}"

            echo ''
            echo 'The Jenkins build was aborted.'
        }

        always {

            echo ''
            echo '================================================'
            echo '       DESTROY PIPELINE FINISHED'
            echo '================================================'
        }
    }
}
