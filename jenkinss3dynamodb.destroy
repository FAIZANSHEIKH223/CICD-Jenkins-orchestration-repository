pipeline {

    agent any

    // ================================================================
    // PIPELINE OPTIONS
    // ================================================================

    options {

        timestamps()

        ansiColor('xterm')

        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                daysToKeepStr: '30',
                numToKeepStr: '50'
            )
        )

        timeout(
            time: 120,
            unit: 'MINUTES'
        )
    }


    // ================================================================
    // PARAMETERS
    // ================================================================

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: [
                'dev',
                'qa',
                'stage',
                'prod'
            ],
            description: 'Terraform environment to destroy'
        )

        string(
            name: 'AWS_REGION',
            defaultValue: 'us-east-1',
            description: 'AWS region'
        )

        string(
            name: 'TERRAFORM_BACKEND_BUCKET',
            defaultValue: 'terraform-state-faizan-001',
            description: 'Terraform S3 backend bucket'
        )

        string(
            name: 'TERRAFORM_STATE_KEY',
            defaultValue: 'terraform.tfstate',
            description: 'Terraform state object key'
        )

        string(
            name: 'DYNAMODB_LOCK_TABLE',
            defaultValue: 'terraform-lock',
            description: 'Terraform DynamoDB lock table'
        )

        booleanParam(
            name: 'DELETE_TERRAFORM_BACKEND',
            defaultValue: true,
            description: 'Delete Terraform S3 backend bucket and DynamoDB lock table after infrastructure destruction'
        )

        booleanParam(
            name: 'AUTO_APPROVE_DESTROY',
            defaultValue: true,
            description: 'Automatically approve terraform destroy'
        )
    }


    // ================================================================
    // ENVIRONMENT
    // ================================================================

    environment {

        AWS_DEFAULT_REGION = "${params.AWS_REGION}"

        AWS_REGION = "${params.AWS_REGION}"

        TERRAFORM_BACKEND_BUCKET = "${params.TERRAFORM_BACKEND_BUCKET}"

        TERRAFORM_STATE_KEY = "${params.TERRAFORM_STATE_KEY}"

        DYNAMODB_LOCK_TABLE = "${params.DYNAMODB_LOCK_TABLE}"

        TERRAFORM_WORKSPACE = "${params.ENVIRONMENT}"

        TF_IN_AUTOMATION = "true"

        TF_INPUT = "false"
    }


    // ================================================================
    // STAGES
    // ================================================================

    stages {


        // ============================================================
        // 01 - START
        // ============================================================

        stage('01 - Start Destroy Pipeline') {

            steps {

                echo ''
                echo '================================================'
                echo '       TERRAFORM DESTROY PIPELINE'
                echo '================================================'

                echo "Environment              : ${params.ENVIRONMENT}"
                echo "AWS Region               : ${params.AWS_REGION}"
                echo "Terraform Backend Bucket : ${params.TERRAFORM_BACKEND_BUCKET}"
                echo "Terraform State Key      : ${params.TERRAFORM_STATE_KEY}"
                echo "DynamoDB Lock Table      : ${params.DYNAMODB_LOCK_TABLE}"
                echo "Delete Backend           : ${params.DELETE_TERRAFORM_BACKEND}"
                echo "Auto Approve Destroy     : ${params.AUTO_APPROVE_DESTROY}"

                echo '================================================'
                echo ''
            }
        }


        // ============================================================
        // 02 - CHECK TOOLS
        // ============================================================

        stage('02 - Check Required Tools') {

            steps {

                sh '''
                    set -eu

                    echo "==============================================="
                    echo "CHECKING REQUIRED TOOLS"
                    echo "==============================================="

                    command -v terraform
                    echo "Terraform:"
                    terraform version

                    command -v aws
                    echo ""
                    echo "AWS CLI:"
                    aws --version

                    command -v jq
                    echo ""
                    echo "jq:"
                    jq --version

                    command -v git
                    echo ""
                    echo "Git:"
                    git --version

                    echo ""
                    echo "Required tools are available."
                    echo "==============================================="
                '''
            }
        }


        // ============================================================
        // 03 - AWS AUTHENTICATION
        // ============================================================

        stage('03 - Verify AWS Authentication') {

            steps {

                withCredentials(
                    [
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: 'aws-creds',
                            accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                            secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                        ]
                    ]
                ) {

                    sh '''
                        set -eu

                        echo "==============================================="
                        echo "VERIFYING AWS AUTHENTICATION"
                        echo "==============================================="

                        aws sts get-caller-identity

                        echo ""
                        echo "AWS Region:"
                        echo "${AWS_DEFAULT_REGION}"

                        echo "==============================================="
                    '''
                }
            }
        }


        // ============================================================
        // 04 - CHECK S3 BACKEND
        // ============================================================

        stage('04 - Check Terraform S3 Backend') {

            steps {

                withCredentials(
                    [
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: 'aws-creds',
                            accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                            secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                        ]
                    ]
                ) {

                    sh '''
                        set -eu

                        echo "==============================================="
                        echo "CHECKING TERRAFORM S3 BACKEND"
                        echo "==============================================="

                        echo "Bucket:"
                        echo "${TERRAFORM_BACKEND_BUCKET}"

                        echo ""
                        echo "Region:"
                        echo "${AWS_DEFAULT_REGION}"

                        if aws s3api head-bucket \
                            --bucket "${TERRAFORM_BACKEND_BUCKET}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            >/dev/null 2>&1
                        then
                            echo ""
                            echo "S3 backend bucket EXISTS."

                            echo ""
                            echo "Bucket location:"
                            aws s3api get-bucket-location \
                                --bucket "${TERRAFORM_BACKEND_BUCKET}" \
                                --region "${AWS_DEFAULT_REGION}" || true

                            echo ""
                            echo "Objects currently in bucket:"
                            aws s3api list-objects-v2 \
                                --bucket "${TERRAFORM_BACKEND_BUCKET}" \
                                --region "${AWS_DEFAULT_REGION}" \
                                --query 'Contents[].Key' \
                                --output table || true

                        else
                            echo ""
                            echo "S3 backend bucket does NOT exist."

                            if [ "${DELETE_TERRAFORM_BACKEND}" = "true" ]; then
                                echo "Backend deletion was requested."
                                echo "Continuing because bucket is already absent."
                            fi
                        fi

                        echo "==============================================="
                    '''
                }
            }
        }


        // ============================================================
        // 05 - CHECK DYNAMODB
        // ============================================================

        stage('05 - Check DynamoDB Lock Table') {

            steps {

                withCredentials(
                    [
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: 'aws-creds',
                            accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                            secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                        ]
                    ]
                ) {

                    sh '''
                        set -eu

                        echo "==============================================="
                        echo "CHECKING DYNAMODB LOCK TABLE"
                        echo "==============================================="

                        echo "Table:"
                        echo "${DYNAMODB_LOCK_TABLE}"

                        if aws dynamodb describe-table \
                            --table-name "${DYNAMODB_LOCK_TABLE}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            >/dev/null 2>&1
                        then

                            echo ""
                            echo "DynamoDB lock table EXISTS."

                            aws dynamodb describe-table \
                                --table-name "${DYNAMODB_LOCK_TABLE}" \
                                --region "${AWS_DEFAULT_REGION}" \
                                --query 'Table.[TableName,TableStatus,ItemCount]' \
                                --output table

                        else

                            echo ""
                            echo "DynamoDB lock table does NOT exist."

                        fi

                        echo "==============================================="
                    '''
                }
            }
        }


        // ============================================================
        // 06 - TERRAFORM INIT
        // ============================================================

        stage('06 - Terraform Init') {

            steps {

                sh '''
                    set -eu

                    echo "==============================================="
                    echo "TERRAFORM INIT"
                    echo "==============================================="

                    echo "Environment:"
                    echo "${TERRAFORM_WORKSPACE}"

                    echo ""
                    echo "Backend bucket:"
                    echo "${TERRAFORM_BACKEND_BUCKET}"

                    echo ""
                    echo "State key:"
                    echo "${TERRAFORM_STATE_KEY}"

                    echo ""
                    echo "Running Terraform init..."

                    terraform init \
                        -reconfigure \
                        -input=false

                    echo ""
                    echo "Terraform init completed."

                    echo "==============================================="
                '''
            }
        }


        // ============================================================
        // 07 - TERRAFORM VALIDATE
        // ============================================================

        stage('07 - Terraform Validate') {

            steps {

                sh '''
                    set -eu

                    echo "==============================================="
                    echo "TERRAFORM VALIDATE"
                    echo "==============================================="

                    terraform validate

                    echo ""
                    echo "Terraform validation successful."

                    echo "==============================================="
                '''
            }
        }


        // ============================================================
        // 08 - TERRAFORM DESTROY
        // ============================================================

        stage('08 - Terraform Destroy Infrastructure') {

            steps {

                withCredentials(
                    [
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: 'aws-creds',
                            accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                            secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                        ]
                    ]
                ) {

                    sh '''
                        set -eu

                        echo "==============================================="
                        echo "TERRAFORM DESTROY"
                        echo "==============================================="

                        echo "Environment:"
                        echo "${TERRAFORM_WORKSPACE}"

                        echo ""
                        echo "AWS Region:"
                        echo "${AWS_DEFAULT_REGION}"

                        echo ""
                        echo "Starting infrastructure destruction..."

                        cd "${WORKSPACE}"

                        if [ -f "environments/${TERRAFORM_WORKSPACE}/terraform.tfvars" ]; then

                            echo ""
                            echo "Using variable file:"
                            echo "environments/${TERRAFORM_WORKSPACE}/terraform.tfvars"

                            if [ "${AUTO_APPROVE_DESTROY}" = "true" ]; then

                                terraform destroy \
                                    -var-file="environments/${TERRAFORM_WORKSPACE}/terraform.tfvars" \
                                    -auto-approve \
                                    -input=false

                            else

                                terraform destroy \
                                    -var-file="environments/${TERRAFORM_WORKSPACE}/terraform.tfvars" \
                                    -input=false

                            fi

                        else

                            echo ""
                            echo "Variable file not found:"
                            echo "environments/${TERRAFORM_WORKSPACE}/terraform.tfvars"

                            echo ""
                            echo "Attempting destroy without environment variable file..."

                            if [ "${AUTO_APPROVE_DESTROY}" = "true" ]; then

                                terraform destroy \
                                    -auto-approve \
                                    -input=false

                            else

                                terraform destroy \
                                    -input=false

                            fi

                        fi

                        echo ""
                        echo "Terraform infrastructure destruction completed."

                        echo "==============================================="
                    '''
                }
            }
        }


        // ============================================================
        // 09 - WAIT FOR TERRAFORM LOCK RELEASE
        // ============================================================

        stage('09 - Wait For Terraform Lock Release') {

            steps {

                withCredentials(
                    [
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: 'aws-creds',
                            accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                            secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                        ]
                    ]
                ) {

                    sh '''
                        set -eu

                        echo "==============================================="
                        echo "WAITING FOR TERRAFORM LOCK RELEASE"
                        echo "==============================================="

                        LOCK_ID="${TERRAFORM_BACKEND_BUCKET}/${TERRAFORM_STATE_KEY}"

                        echo "LockID:"
                        echo "${LOCK_ID}"

                        MAX_ATTEMPTS=30
                        ATTEMPT=1

                        while [ "${ATTEMPT}" -le "${MAX_ATTEMPTS}" ]; do

                            echo ""
                            echo "Lock check ${ATTEMPT}/${MAX_ATTEMPTS}"

                            LOCK_KEY=$(jq -nc \
                                --arg lockid "${LOCK_ID}" \
                                '{LockID:{S:$lockid}}')

                            LOCK_RESULT=$(aws dynamodb get-item \
                                --table-name "${DYNAMODB_LOCK_TABLE}" \
                                --key "${LOCK_KEY}" \
                                --region "${AWS_DEFAULT_REGION}" \
                                --output json)

                            ITEM_COUNT=$(echo "${LOCK_RESULT}" | jq '.Item | length')

                            if [ "${ITEM_COUNT}" -eq 0 ]; then

                                echo "No Terraform lock found."
                                break

                            fi

                            echo "Terraform lock still exists."
                            echo "Waiting 10 seconds..."

                            sleep 10

                            ATTEMPT=$((ATTEMPT + 1))

                        done

                        if [ "${ATTEMPT}" -gt "${MAX_ATTEMPTS}" ]; then

                            echo ""
                            echo "ERROR: Terraform lock did not disappear."
                            echo "The backend will NOT be deleted."

                            exit 1

                        fi

                        echo ""
                        echo "Terraform lock released."

                        echo "==============================================="
                    '''
                }
            }
        }


        // ============================================================
        // 10 - VERIFY NO ACTIVE TERRAFORM LOCK
        // ============================================================

        stage('10 - Verify No Active Terraform Lock') {

            steps {

                withCredentials(
                    [
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: 'aws-creds',
                            accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                            secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                        ]
                    ]
                ) {

                    sh '''
                        set -eu

                        echo "==============================================="
                        echo "VERIFYING TERRAFORM LOCK"
                        echo "==============================================="

                        LOCK_ID="${TERRAFORM_BACKEND_BUCKET}/${TERRAFORM_STATE_KEY}"

                        echo "LockID:"
                        echo "${LOCK_ID}"

                        if aws dynamodb describe-table \
                            --table-name "${DYNAMODB_LOCK_TABLE}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            >/dev/null 2>&1
                        then

                            LOCK_KEY=$(jq -nc \
                                --arg lockid "${LOCK_ID}" \
                                '{LockID:{S:$lockid}}')

                            LOCK_RESULT=$(aws dynamodb get-item \
                                --table-name "${DYNAMODB_LOCK_TABLE}" \
                                --key "${LOCK_KEY}" \
                                --region "${AWS_DEFAULT_REGION}" \
                                --output json)

                            ITEM_COUNT=$(echo "${LOCK_RESULT}" | jq '.Item | length')

                            if [ "${ITEM_COUNT}" -gt 0 ]; then

                                echo ""
                                echo "ERROR: ACTIVE TERRAFORM LOCK STILL EXISTS."
                                echo ""
                                echo "${LOCK_RESULT}" | jq .

                                echo ""
                                echo "Backend deletion has been stopped."

                                exit 1

                            fi

                            echo ""
                            echo "No active Terraform lock exists."

                        else

                            echo ""
                            echo "DynamoDB table does not exist."
                            echo "Therefore no lock can exist."

                        fi

                        echo "==============================================="
                    '''
                }
            }
        }


        // ============================================================
        // 11 - CHECK STATE OBJECT
        // ============================================================

        stage('11 - Check Terraform State Object') {

            when {

                expression {

                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials(
                    [
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: 'aws-creds',
                            accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                            secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                        ]
                    ]
                ) {

                    sh '''
                        set -eu

                        echo "==============================================="
                        echo "CHECKING TERRAFORM STATE OBJECT"
                        echo "==============================================="

                        if aws s3api head-object \
                            --bucket "${TERRAFORM_BACKEND_BUCKET}" \
                            --key "${TERRAFORM_STATE_KEY}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            >/dev/null 2>&1
                        then

                            echo ""
                            echo "Terraform state object EXISTS."

                            aws s3api head-object \
                                --bucket "${TERRAFORM_BACKEND_BUCKET}" \
                                --key "${TERRAFORM_STATE_KEY}" \
                                --region "${AWS_DEFAULT_REGION}"

                        else

                            echo ""
                            echo "Terraform state object does not exist."

                        fi

                        echo "==============================================="
                    '''
                }
            }
        }


        // ============================================================
        // 12 - DELETE STATE OBJECT
        // ============================================================

        stage('12 - Delete Terraform State Object') {

            when {

                expression {

                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials(
                    [
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: 'aws-creds',
                            accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                            secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                        ]
                    ]
                ) {

                    sh '''
                        set -eu

                        echo "==============================================="
                        echo "DELETING TERRAFORM STATE OBJECT"
                        echo "==============================================="

                        if aws s3api head-object \
                            --bucket "${TERRAFORM_BACKEND_BUCKET}" \
                            --key "${TERRAFORM_STATE_KEY}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            >/dev/null 2>&1
                        then

                            aws s3api delete-object \
                                --bucket "${TERRAFORM_BACKEND_BUCKET}" \
                                --key "${TERRAFORM_STATE_KEY}" \
                                --region "${AWS_DEFAULT_REGION}"

                            echo ""
                            echo "Terraform state object deletion requested."

                        else

                            echo ""
                            echo "Terraform state object already absent."

                        fi

                        echo "==============================================="
                    '''
                }
            }
        }


        // ============================================================
        // 13 - DELETE ALL S3 VERSIONS
        // ============================================================

        stage('13 - Delete All S3 Object Versions') {

            when {

                expression {

                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials(
                    [
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: 'aws-creds',
                            accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                            secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                        ]
                    ]
                ) {

                    sh '''
                        set -eu

                        echo "==============================================="
                        echo "DELETING ALL S3 OBJECT VERSIONS"
                        echo "==============================================="

                        if aws s3api head-bucket \
                            --bucket "${TERRAFORM_BACKEND_BUCKET}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            >/dev/null 2>&1
                        then

                            echo ""
                            echo "Checking object versions and delete markers..."

                            while true; do

                                VERSION_DATA=$(aws s3api list-object-versions \
                                    --bucket "${TERRAFORM_BACKEND_BUCKET}" \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --output json)

                                OBJECT_COUNT=$(echo "${VERSION_DATA}" | jq '
                                    (
                                        (.Versions // []) +
                                        (.DeleteMarkers // [])
                                    ) | length
                                ')

                                if [ "${OBJECT_COUNT}" -eq 0 ]; then

                                    echo ""
                                    echo "No remaining object versions or delete markers."
                                    break

                                fi

                                echo ""
                                echo "Found ${OBJECT_COUNT} versions/delete markers."
                                echo "Deleting them..."

                                echo "${VERSION_DATA}" | jq -c '
                                    [
                                        (.Versions // [])[] |
                                        {
                                            Key: .Key,
                                            VersionId: .VersionId
                                        }
                                    ] +
                                    [
                                        (.DeleteMarkers // [])[] |
                                        {
                                            Key: .Key,
                                            VersionId: .VersionId
                                        }
                                    ]
                                ' > /tmp/s3-delete-batch.json

                                jq -c '
                                    {
                                        Objects: .,
                                        Quiet: true
                                    }
                                ' /tmp/s3-delete-batch.json > /tmp/s3-delete-request.json

                                aws s3api delete-objects \
                                    --bucket "${TERRAFORM_BACKEND_BUCKET}" \
                                    --delete file:///tmp/s3-delete-request.json \
                                    --region "${AWS_DEFAULT_REGION}"

                                echo ""
                                echo "Batch deletion completed."

                            done

                        else

                            echo ""
                            echo "S3 bucket already does not exist."

                        fi

                        rm -f /tmp/s3-delete-batch.json
                        rm -f /tmp/s3-delete-request.json

                        echo ""
                        echo "All S3 object versions have been processed."

                        echo "==============================================="
                    '''
                }
            }
        }


        // ============================================================
        // 14 - VERIFY S3 EMPTY
        // ============================================================

        stage('14 - Verify S3 Bucket Empty') {

            when {

                expression {

                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials(
                    [
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: 'aws-creds',
                            accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                            secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                        ]
                    ]
                ) {

                    sh '''
                        set -eu

                        echo "==============================================="
                        echo "VERIFYING S3 BUCKET EMPTY"
                        echo "==============================================="

                        if aws s3api head-bucket \
                            --bucket "${TERRAFORM_BACKEND_BUCKET}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            >/dev/null 2>&1
                        then

                            VERSION_DATA=$(aws s3api list-object-versions \
                                --bucket "${TERRAFORM_BACKEND_BUCKET}" \
                                --region "${AWS_DEFAULT_REGION}" \
                                --output json)

                            REMAINING=$(echo "${VERSION_DATA}" | jq '
                                (
                                    (.Versions // []) +
                                    (.DeleteMarkers // [])
                                ) | length
                            ')

                            echo "Remaining objects/versions:"
                            echo "${REMAINING}"

                            if [ "${REMAINING}" -ne 0 ]; then

                                echo ""
                                echo "ERROR: S3 bucket is not empty."
                                echo "${VERSION_DATA}" | jq .

                                exit 1

                            fi

                            echo ""
                            echo "S3 bucket is empty."

                        else

                            echo ""
                            echo "S3 bucket is already deleted."

                        fi

                        echo "==============================================="
                    '''
                }
            }
        }


        // ============================================================
        // 15 - DELETE S3 BACKEND BUCKET
        // ============================================================

        stage('15 - Delete Terraform S3 Backend Bucket') {

            when {

                expression {

                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials(
                    [
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: 'aws-creds',
                            accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                            secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                        ]
                    ]
                ) {

                    sh '''
                        set -eu

                        echo "==============================================="
                        echo "DELETING TERRAFORM S3 BACKEND BUCKET"
                        echo "==============================================="

                        if aws s3api head-bucket \
                            --bucket "${TERRAFORM_BACKEND_BUCKET}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            >/dev/null 2>&1
                        then

                            echo ""
                            echo "Deleting bucket:"
                            echo "${TERRAFORM_BACKEND_BUCKET}"

                            aws s3api delete-bucket \
                                --bucket "${TERRAFORM_BACKEND_BUCKET}" \
                                --region "${AWS_DEFAULT_REGION}"

                            echo ""
                            echo "S3 bucket deletion requested."

                        else

                            echo ""
                            echo "S3 bucket already does not exist."

                        fi

                        echo "==============================================="
                    '''
                }
            }
        }


        // ============================================================
        // 16 - VERIFY S3 DELETED
        // ============================================================

        stage('16 - Verify S3 Bucket Deleted') {

            when {

                expression {

                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials(
                    [
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: 'aws-creds',
                            accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                            secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                        ]
                    ]
                ) {

                    sh '''
                        set -eu

                        echo "==============================================="
                        echo "VERIFYING S3 BUCKET DELETION"
                        echo "==============================================="

                        ATTEMPT=1
                        MAX_ATTEMPTS=30

                        while [ "${ATTEMPT}" -le "${MAX_ATTEMPTS}" ]; do

                            if aws s3api head-bucket \
                                --bucket "${TERRAFORM_BACKEND_BUCKET}" \
                                --region "${AWS_DEFAULT_REGION}" \
                                >/dev/null 2>&1
                            then

                                echo "Bucket still exists."
                                echo "Waiting 5 seconds..."

                                sleep 5

                                ATTEMPT=$((ATTEMPT + 1))

                            else

                                echo ""
                                echo "S3 backend bucket has been deleted."
                                break

                            fi

                        done

                        if [ "${ATTEMPT}" -gt "${MAX_ATTEMPTS}" ]; then

                            echo ""
                            echo "ERROR: S3 bucket still appears to exist."

                            exit 1

                        fi

                        echo "==============================================="
                    '''
                }
            }
        }


        // ============================================================
        // 17 - DELETE DYNAMODB
        // ============================================================

        stage('17 - Delete DynamoDB Lock Table') {

            when {

                expression {

                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials(
                    [
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: 'aws-creds',
                            accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                            secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                        ]
                    ]
                ) {

                    sh '''
                        set -eu

                        echo "==============================================="
                        echo "DELETING DYNAMODB LOCK TABLE"
                        echo "==============================================="

                        if aws dynamodb describe-table \
                            --table-name "${DYNAMODB_LOCK_TABLE}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            >/dev/null 2>&1
                        then

                            echo ""
                            echo "Deleting DynamoDB table:"
                            echo "${DYNAMODB_LOCK_TABLE}"

                            aws dynamodb delete-table \
                                --table-name "${DYNAMODB_LOCK_TABLE}" \
                                --region "${AWS_DEFAULT_REGION}"

                            echo ""
                            echo "DynamoDB table deletion requested."

                        else

                            echo ""
                            echo "DynamoDB table already does not exist."

                        fi

                        echo "==============================================="
                    '''
                }
            }
        }


        // ============================================================
        // 18 - WAIT DYNAMODB DELETE
        // ============================================================

        stage('18 - Wait For DynamoDB Table Deletion') {

            when {

                expression {

                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials(
                    [
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: 'aws-creds',
                            accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                            secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                        ]
                    ]
                ) {

                    sh '''
                        set -eu

                        echo "==============================================="
                        echo "WAITING FOR DYNAMODB DELETION"
                        echo "==============================================="

                        ATTEMPT=1
                        MAX_ATTEMPTS=30

                        while [ "${ATTEMPT}" -le "${MAX_ATTEMPTS}" ]; do

                            if aws dynamodb describe-table \
                                --table-name "${DYNAMODB_LOCK_TABLE}" \
                                --region "${AWS_DEFAULT_REGION}" \
                                >/dev/null 2>&1
                            then

                                STATUS=$(aws dynamodb describe-table \
                                    --table-name "${DYNAMODB_LOCK_TABLE}" \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --query 'Table.TableStatus' \
                                    --output text 2>/dev/null || echo "UNKNOWN")

                                echo "DynamoDB status: ${STATUS}"
                                echo "Waiting 5 seconds..."

                                sleep 5

                                ATTEMPT=$((ATTEMPT + 1))

                            else

                                echo ""
                                echo "DynamoDB table no longer exists."
                                break

                            fi

                        done

                        if [ "${ATTEMPT}" -gt "${MAX_ATTEMPTS}" ]; then

                            echo ""
                            echo "ERROR: DynamoDB table still exists."

                            exit 1

                        fi

                        echo "==============================================="
                    '''
                }
            }
        }


        // ============================================================
        // 19 - VERIFY DYNAMODB DELETED
        // ============================================================

        stage('19 - Verify DynamoDB Table Deleted') {

            when {

                expression {

                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials(
                    [
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: 'aws-creds',
                            accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                            secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                        ]
                    ]
                ) {

                    sh '''
                        set -eu

                        echo "==============================================="
                        echo "VERIFYING DYNAMODB TABLE DELETION"
                        echo "==============================================="

                        if aws dynamodb describe-table \
                            --table-name "${DYNAMODB_LOCK_TABLE}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            >/dev/null 2>&1
                        then

                            echo ""
                            echo "ERROR: DynamoDB table still exists."

                            exit 1

                        else

                            echo ""
                            echo "DynamoDB lock table has been deleted."

                        fi

                        echo "==============================================="
                    '''
                }
            }
        }


        // ============================================================
        // 20 - FINAL VERIFICATION
        // ============================================================

        stage('20 - Final Destruction Verification') {

            steps {

                withCredentials(
                    [
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: 'aws-creds',
                            accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                            secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                        ]
                    ]
                ) {

                    sh '''
                        set -eu

                        echo ""
                        echo "================================================"
                        echo "       FINAL DESTRUCTION VERIFICATION"
                        echo "================================================"

                        echo ""
                        echo "Infrastructure:"
                        echo "Terraform destroy completed."

                        if [ "${DELETE_TERRAFORM_BACKEND}" = "true" ]; then

                            echo ""
                            echo "S3 Backend:"
                            if aws s3api head-bucket \
                                --bucket "${TERRAFORM_BACKEND_BUCKET}" \
                                --region "${AWS_DEFAULT_REGION}" \
                                >/dev/null 2>&1
                            then
                                echo "STILL EXISTS"
                                exit 1
                            else
                                echo "DELETED"
                            fi

                            echo ""
                            echo "DynamoDB Lock Table:"
                            if aws dynamodb describe-table \
                                --table-name "${DYNAMODB_LOCK_TABLE}" \
                                --region "${AWS_DEFAULT_REGION}" \
                                >/dev/null 2>&1
                            then
                                echo "STILL EXISTS"
                                exit 1
                            else
                                echo "DELETED"
                            fi

                        else

                            echo ""
                            echo "Backend deletion was disabled."

                        fi

                        echo ""
                        echo "FINAL VERIFICATION PASSED."

                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // 21 - FINAL REPORT
        // ============================================================

        stage('21 - Final Destruction Report') {

            steps {

                echo ''
                echo '================================================'
                echo '       FINAL DESTRUCTION REPORT'
                echo '================================================'

                echo "Environment              : ${params.ENVIRONMENT}"
                echo "AWS Region               : ${params.AWS_REGION}"
                echo "Terraform Backend Bucket : ${params.TERRAFORM_BACKEND_BUCKET}"
                echo "Terraform State Key      : ${params.TERRAFORM_STATE_KEY}"
                echo "DynamoDB Lock Table      : ${params.DYNAMODB_LOCK_TABLE}"
                echo "Backend Deleted          : ${params.DELETE_TERRAFORM_BACKEND}"

                echo ''
                echo 'Terraform Infrastructure : DESTROYED'

                if (params.DELETE_TERRAFORM_BACKEND) {

                    echo 'Terraform State Object   : REMOVED'
                    echo 'S3 Object Versions       : REMOVED'
                    echo 'S3 Backend Bucket        : DELETED'
                    echo 'DynamoDB Lock Table      : DELETED'

                } else {

                    echo 'Terraform Backend        : PRESERVED'
                }

                echo ''
                echo '================================================'
                echo '       DESTROY COMPLETED SUCCESSFULLY'
                echo '================================================'
                echo ''
            }
        }
    }


    // ================================================================
    // POST ACTIONS
    // ================================================================

    post {

        always {

            echo ''
            echo '================================================'
            echo '       DESTROY PIPELINE FINISHED'
            echo '================================================'
            echo ''
        }

        success {

            echo ''
            echo '================================================'
            echo '       DESTROY PIPELINE SUCCESS'
            echo '================================================'
            echo ''
            echo "Environment : ${params.ENVIRONMENT}"
            echo "Build       : ${env.BUILD_NUMBER}"
            echo "Region      : ${params.AWS_REGION}"
            echo ''
            echo 'Terraform infrastructure was destroyed.'
            echo ''
            echo '================================================'
        }

        failure {

            echo ''
            echo '================================================'
            echo '       DESTROY PIPELINE FAILED'
            echo '================================================'
            echo ''
            echo "Environment : ${params.ENVIRONMENT}"
            echo "Build       : ${env.BUILD_NUMBER}"
            echo "Region      : ${params.AWS_REGION}"
            echo ''
            echo 'The pipeline stopped at the failed stage.'
            echo ''
            echo 'The Terraform backend is protected if:'
            echo '  - Terraform destroy fails'
            echo '  - Terraform lock remains active'
            echo '  - S3 cleanup fails'
            echo '  - S3 bucket cannot be verified as empty'
            echo ''
            echo 'Check the failed stage above.'
            echo ''
            echo '================================================'
        }

        aborted {

            echo ''
            echo '================================================'
            echo '       DESTROY PIPELINE ABORTED'
            echo '================================================'
            echo ''
            echo "Environment : ${params.ENVIRONMENT}"
            echo "Build       : ${env.BUILD_NUMBER}"
            echo ''
            echo 'The pipeline was manually aborted.'
            echo 'Terraform backend deletion was not intentionally'
            echo 'continued after an aborted stage.'
            echo ''
            echo '================================================'
        }
    }
}
