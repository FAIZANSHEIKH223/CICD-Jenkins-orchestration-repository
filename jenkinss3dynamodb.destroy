pipeline {

    agent any

    // ================================================================
    // PIPELINE OPTIONS
    // ================================================================

    options {

        timestamps()

        ansiColor('xterm')

        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                daysToKeepStr: '30',
                numToKeepStr: '50'
            )
        )

        timeout(
            time: 60,
            unit: 'MINUTES'
        )
    }

    // ================================================================
    // PARAMETERS
    // ================================================================

    parameters {

        booleanParam(
            name: 'CONFIRM_DELETE',
            defaultValue: false,
            description: 'MUST be true. This permanently deletes the Terraform S3 backend bucket and DynamoDB lock table.'
        )

        string(
            name: 'AWS_REGION',
            defaultValue: 'us-east-1',
            description: 'AWS region containing the Terraform backend.'
        )

        string(
            name: 'S3_BACKEND_BUCKET',
            defaultValue: 'terraform-state-faizan-001',
            description: 'Terraform S3 backend bucket to delete.'
        )

        string(
            name: 'DYNAMODB_LOCK_TABLE',
            defaultValue: 'terraform-lock',
            description: 'Terraform DynamoDB lock table to delete.'
        )
    }

    // ================================================================
    // ENVIRONMENT
    // ================================================================

    environment {

        AWS_DEFAULT_REGION = "${params.AWS_REGION}"

        AWS_PAGER = ""

        S3_BUCKET = "${params.S3_BACKEND_BUCKET}"

        DDB_TABLE = "${params.DYNAMODB_LOCK_TABLE}"
    }

    // ================================================================
    // STAGES
    // ================================================================

    stages {

        // ============================================================
        // 01 - START
        // ============================================================

        stage('01 - Start Backend Cleanup') {

            steps {

                echo ''
                echo '================================================'
                echo '       TERRAFORM BACKEND CLEANUP PIPELINE'
                echo '================================================'
                echo "AWS Region               : ${params.AWS_REGION}"
                echo "S3 Backend Bucket        : ${params.S3_BACKEND_BUCKET}"
                echo "DynamoDB Lock Table      : ${params.DYNAMODB_LOCK_TABLE}"
                echo "Delete Confirmation      : ${params.CONFIRM_DELETE}"
                echo ''
                echo 'THIS PIPELINE ONLY DELETES:'
                echo ''
                echo '1. S3 object versions'
                echo '2. S3 delete markers'
                echo '3. Complete Terraform S3 backend bucket'
                echo '4. Terraform DynamoDB lock table'
                echo ''
                echo 'Terraform infrastructure WILL NOT be destroyed.'
                echo 'EC2/application resources WILL NOT be touched.'
                echo '================================================'
                echo ''
            }
        }

        // ============================================================
        // 02 - CONFIRM
        // ============================================================

        stage('02 - Confirm Destructive Operation') {

            steps {

                script {

                    if (!params.CONFIRM_DELETE) {

                        error(
                            'DELETION NOT CONFIRMED. Set CONFIRM_DELETE=true before running this pipeline.'
                        )
                    }

                    echo ''
                    echo '================================================'
                    echo '           DELETION CONFIRMED'
                    echo '================================================'
                    echo ''
                    echo 'This pipeline will ONLY remove:'
                    echo ''
                    echo "1. All S3 object versions in ${params.S3_BACKEND_BUCKET}"
                    echo "2. All S3 delete markers in ${params.S3_BACKEND_BUCKET}"
                    echo "3. The complete S3 bucket ${params.S3_BACKEND_BUCKET}"
                    echo "4. DynamoDB table ${params.DYNAMODB_LOCK_TABLE}"
                    echo ''
                    echo 'Terraform infrastructure will NOT be destroyed.'
                    echo 'EC2/application resources will NOT be touched.'
                    echo ''
                    echo '================================================'
                    echo ''
                }
            }
        }

        // ============================================================
        // 03 - CHECK TOOLS
        // ============================================================

        stage('03 - Check Required Tools') {

            steps {

                sh '''
                    set -eu

                    echo "================================================"
                    echo "CHECKING REQUIRED TOOLS"
                    echo "================================================"

                    command -v aws
                    command -v jq

                    echo ""
                    echo "AWS CLI:"
                    aws --version

                    echo ""
                    echo "jq:"
                    jq --version

                    echo ""
                    echo "Required tools are available."
                    echo "================================================"
                '''
            }
        }

        // ============================================================
        // 04 - AWS AUTHENTICATION
        // ============================================================

        stage('04 - Verify AWS Authentication') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds']
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "VERIFYING AWS AUTHENTICATION"
                        echo "================================================"

                        aws sts get-caller-identity

                        echo ""
                        echo "AWS authentication successful."
                        echo "================================================"
                    '''
                }
            }
        }

        // ============================================================
        // 05 - CHECK S3
        // ============================================================

        stage('05 - Check S3 Backend Bucket') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds']
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "CHECKING S3 BACKEND BUCKET"
                        echo "================================================"

                        if aws s3api head-bucket \
                            --bucket "$S3_BUCKET" \
                            --region "$AWS_DEFAULT_REGION" \
                            >/dev/null 2>&1
                        then

                            echo "S3 bucket exists:"
                            echo "$S3_BUCKET"

                        else

                            echo "S3 bucket does not exist."
                            echo "Nothing to delete from S3."

                        fi

                        echo "================================================"
                    '''
                }
            }
        }

        // ============================================================
        // 06 - CHECK DYNAMODB
        // ============================================================

        stage('06 - Check DynamoDB Lock Table') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds']
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "CHECKING DYNAMODB LOCK TABLE"
                        echo "================================================"

                        if aws dynamodb describe-table \
                            --table-name "$DDB_TABLE" \
                            --region "$AWS_DEFAULT_REGION" \
                            >/dev/null 2>&1
                        then

                            echo "DynamoDB table exists:"
                            echo "$DDB_TABLE"

                        else

                            echo "DynamoDB table does not exist."
                            echo "Nothing to delete from DynamoDB."

                        fi

                        echo "================================================"
                    '''
                }
            }
        }

        // ============================================================
        // 07 - DELETE ALL S3 VERSIONS
        // ============================================================

        stage('07 - Delete All S3 Object Versions') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds']
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "DELETING ALL S3 OBJECT VERSIONS"
                        echo "================================================"

                        if ! aws s3api head-bucket \
                            --bucket "$S3_BUCKET" \
                            --region "$AWS_DEFAULT_REGION" \
                            >/dev/null 2>&1
                        then

                            echo "Bucket does not exist."
                            echo "Skipping S3 object deletion."
                            exit 0

                        fi

                        WORK_DIR="$(mktemp -d)"

                        cleanup() {
                            rm -rf "$WORK_DIR"
                        }

                        trap cleanup EXIT

                        VERSIONS_FILE="$WORK_DIR/versions.json"
                        DELETE_FILE="$WORK_DIR/delete.json"
                        BATCH_FILE="$WORK_DIR/batch.json"

                        echo ""
                        echo "Listing all S3 object versions and delete markers..."

                        aws s3api list-object-versions \
                            --bucket "$S3_BUCKET" \
                            --region "$AWS_DEFAULT_REGION" \
                            --output json \
                            > "$VERSIONS_FILE"

                        echo ""
                        echo "Preparing deletion list..."

                        jq -c '
                            [
                                (.Versions // [])[],
                                (.DeleteMarkers // [])[]
                            ]
                            |
                            map({
                                Key: .Key,
                                VersionId: .VersionId
                            })
                        ' "$VERSIONS_FILE" > "$DELETE_FILE"

                        TOTAL_COUNT="$(
                            jq 'length' "$DELETE_FILE"
                        )"

                        echo ""
                        echo "Total S3 versions/delete markers found: $TOTAL_COUNT"

                        if [ "$TOTAL_COUNT" -eq 0 ]; then

                            echo ""
                            echo "No S3 object versions or delete markers found."
                            echo "S3 bucket is already empty."

                            exit 0
                        fi

                        echo ""
                        echo "Deleting S3 versions/delete markers in batches..."

                        OFFSET=0
                        BATCH_NUMBER=0

                        while [ "$OFFSET" -lt "$TOTAL_COUNT" ]; do

                            BATCH_NUMBER=$((BATCH_NUMBER + 1))

                            jq \
                                --argjson offset "$OFFSET" \
                                '
                                .[$offset:($offset + 1000)]
                                |
                                {
                                    Objects: .,
                                    Quiet: true
                                }
                                ' \
                                "$DELETE_FILE" \
                                > "$BATCH_FILE"

                            BATCH_COUNT="$(
                                jq '.Objects | length' "$BATCH_FILE"
                            )"

                            echo ""
                            echo "Deleting S3 batch: $BATCH_NUMBER"
                            echo "Objects in batch: $BATCH_COUNT"

                            # IMPORTANT:
                            # AWS CLI requires the --delete parameter to be:
                            #
                            # {
                            #   "Objects": [...],
                            #   "Quiet": true
                            # }
                            #
                            # We pass the JSON using file:// so shell quoting
                            # cannot corrupt the JSON.

                            aws s3api delete-objects \
                                --bucket "$S3_BUCKET" \
                                --region "$AWS_DEFAULT_REGION" \
                                --delete "file://$BATCH_FILE"

                            OFFSET=$((OFFSET + 1000))

                        done

                        echo ""
                        echo "All S3 object versions/delete markers were deleted."
                        echo "================================================"
                    '''
                }
            }
        }

        // ============================================================
        // 08 - VERIFY S3 EMPTY
        // ============================================================

        stage('08 - Verify S3 Bucket Empty') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds']
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "VERIFYING S3 BUCKET IS EMPTY"
                        echo "================================================"

                        if ! aws s3api head-bucket \
                            --bucket "$S3_BUCKET" \
                            --region "$AWS_DEFAULT_REGION" \
                            >/dev/null 2>&1
                        then

                            echo "Bucket already does not exist."
                            exit 0

                        fi

                        WORK_DIR="$(mktemp -d)"

                        cleanup() {
                            rm -rf "$WORK_DIR"
                        }

                        trap cleanup EXIT

                        CHECK_FILE="$WORK_DIR/check.json"

                        aws s3api list-object-versions \
                            --bucket "$S3_BUCKET" \
                            --region "$AWS_DEFAULT_REGION" \
                            --output json \
                            > "$CHECK_FILE"

                        REMAINING="$(
                            jq '
                                ((.Versions // []) | length)
                                +
                                ((.DeleteMarkers // []) | length)
                            ' "$CHECK_FILE"
                        )"

                        echo "Remaining S3 versions/delete markers: $REMAINING"

                        if [ "$REMAINING" -ne 0 ]; then

                            echo ""
                            echo "ERROR: S3 bucket is not empty."
                            echo ""
                            echo "Remaining objects:"
                            jq '
                                {
                                    Versions: (.Versions // []),
                                    DeleteMarkers: (.DeleteMarkers // [])
                                }
                            ' "$CHECK_FILE"

                            exit 1
                        fi

                        echo ""
                        echo "S3 bucket is completely empty."
                        echo "================================================"
                    '''
                }
            }
        }

        // ============================================================
        // 09 - DELETE S3 BUCKET
        // ============================================================

        stage('09 - Delete Complete S3 Backend Bucket') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds']
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "DELETING COMPLETE S3 BACKEND BUCKET"
                        echo "================================================"

                        if ! aws s3api head-bucket \
                            --bucket "$S3_BUCKET" \
                            --region "$AWS_DEFAULT_REGION" \
                            >/dev/null 2>&1
                        then

                            echo "S3 bucket does not exist."
                            echo "Nothing to delete."

                            exit 0
                        fi

                        echo "Deleting bucket:"
                        echo "$S3_BUCKET"

                        aws s3api delete-bucket \
                            --bucket "$S3_BUCKET" \
                            --region "$AWS_DEFAULT_REGION"

                        echo ""
                        echo "S3 bucket deletion request completed."
                        echo "================================================"
                    '''
                }
            }
        }

        // ============================================================
        // 10 - VERIFY S3 DELETED
        // ============================================================

        stage('10 - Verify S3 Bucket Deleted') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds']
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "VERIFYING S3 BUCKET DELETION"
                        echo "================================================"

                        ATTEMPTS=0
                        MAX_ATTEMPTS=30

                        while [ "$ATTEMPTS" -lt "$MAX_ATTEMPTS" ]; do

                            ATTEMPTS=$((ATTEMPTS + 1))

                            if aws s3api head-bucket \
                                --bucket "$S3_BUCKET" \
                                --region "$AWS_DEFAULT_REGION" \
                                >/dev/null 2>&1
                            then

                                echo "S3 bucket still exists."
                                echo "Waiting... attempt $ATTEMPTS/$MAX_ATTEMPTS"

                                sleep 2

                            else

                                echo ""
                                echo "S3 bucket deletion verified."
                                echo "Bucket: $S3_BUCKET"
                                echo "================================================"

                                exit 0
                            fi

                        done

                        echo ""
                        echo "ERROR: Could not verify S3 bucket deletion."
                        exit 1
                    '''
                }
            }
        }

        // ============================================================
        // 11 - DELETE DYNAMODB
        // ============================================================

        stage('11 - Delete DynamoDB Lock Table') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds']
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "DELETING DYNAMODB LOCK TABLE"
                        echo "================================================"

                        if ! aws dynamodb describe-table \
                            --table-name "$DDB_TABLE" \
                            --region "$AWS_DEFAULT_REGION" \
                            >/dev/null 2>&1
                        then

                            echo "DynamoDB table does not exist."
                            echo "Nothing to delete."

                            exit 0
                        fi

                        echo "Deleting DynamoDB table:"
                        echo "$DDB_TABLE"

                        aws dynamodb delete-table \
                            --table-name "$DDB_TABLE" \
                            --region "$AWS_DEFAULT_REGION"

                        echo ""
                        echo "DynamoDB deletion request submitted."
                        echo "================================================"
                    '''
                }
            }
        }

        // ============================================================
        // 12 - WAIT DYNAMODB
        // ============================================================

        stage('12 - Wait For DynamoDB Deletion') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds']
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "WAITING FOR DYNAMODB TABLE DELETION"
                        echo "================================================"

                        ATTEMPTS=0
                        MAX_ATTEMPTS=60

                        while [ "$ATTEMPTS" -lt "$MAX_ATTEMPTS" ]; do

                            ATTEMPTS=$((ATTEMPTS + 1))

                            if aws dynamodb describe-table \
                                --table-name "$DDB_TABLE" \
                                --region "$AWS_DEFAULT_REGION" \
                                >/dev/null 2>&1
                            then

                                echo "DynamoDB table still exists."
                                echo "Waiting... attempt $ATTEMPTS/$MAX_ATTEMPTS"

                                sleep 5

                            else

                                echo ""
                                echo "DynamoDB table is no longer available."
                                echo "================================================"

                                exit 0
                            fi

                        done

                        echo ""
                        echo "ERROR: DynamoDB table deletion could not be verified."
                        exit 1
                    '''
                }
            }
        }

        // ============================================================
        // 13 - FINAL VERIFICATION
        // ============================================================

        stage('13 - Final Backend Verification') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds']
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "FINAL BACKEND VERIFICATION"
                        echo "================================================"

                        S3_STATUS="DELETED"
                        DDB_STATUS="DELETED"

                        if aws s3api head-bucket \
                            --bucket "$S3_BUCKET" \
                            --region "$AWS_DEFAULT_REGION" \
                            >/dev/null 2>&1
                        then

                            S3_STATUS="STILL EXISTS"

                        fi

                        if aws dynamodb describe-table \
                            --table-name "$DDB_TABLE" \
                            --region "$AWS_DEFAULT_REGION" \
                            >/dev/null 2>&1
                        then

                            DDB_STATUS="STILL EXISTS"

                        fi

                        echo ""
                        echo "S3 Backend Bucket : $S3_STATUS"
                        echo "DynamoDB Lock     : $DDB_STATUS"
                        echo ""

                        if [ "$S3_STATUS" != "DELETED" ]; then

                            echo "ERROR: S3 bucket still exists."
                            exit 1
                        fi

                        if [ "$DDB_STATUS" != "DELETED" ]; then

                            echo "ERROR: DynamoDB table still exists."
                            exit 1
                        fi

                        echo "================================================"
                        echo "FINAL VERIFICATION SUCCESSFUL"
                        echo "================================================"
                    '''
                }
            }
        }

        // ============================================================
        // 14 - FINAL REPORT
        // ============================================================

        stage('14 - Final Destruction Report') {

            steps {

                echo ''
                echo '================================================'
                echo '       BACKEND CLEANUP COMPLETED'
                echo '================================================'
                echo ''
                echo 'S3 Terraform Backend: DELETED'
                echo "Bucket: ${params.S3_BACKEND_BUCKET}"
                echo ''
                echo 'S3 Object Versions: DELETED'
                echo 'S3 Delete Markers: DELETED'
                echo ''
                echo 'DynamoDB Lock Table: DELETED'
                echo "Table: ${params.DYNAMODB_LOCK_TABLE}"
                echo ''
                echo 'Terraform Infrastructure: NOT TOUCHED'
                echo 'EC2 Resources: NOT TOUCHED'
                echo 'ECS Resources: NOT TOUCHED'
                echo 'ALB Resources: NOT TOUCHED'
                echo 'VPC Resources: NOT TOUCHED'
                echo 'Application Resources: NOT TOUCHED'
                echo ''
                echo '================================================'
                echo '       CLEANUP SUCCESSFUL'
                echo '================================================'
                echo ''
            }
        }
    }

    // ================================================================
    // POST ACTIONS
    // ================================================================

    post {

        always {

            echo ''
            echo '================================================'
            echo '       CLEANING JENKINS WORKSPACE'
            echo '================================================'

            cleanWs()

            echo ''
            echo 'Workspace cleanup completed.'
            echo ''
        }

        success {

            echo ''
            echo '================================================'
            echo '       CLEANUP PIPELINE SUCCESSFUL'
            echo '================================================'
            echo ''
            echo "S3 Bucket     : ${params.S3_BACKEND_BUCKET}"
            echo "DynamoDB Table: ${params.DYNAMODB_LOCK_TABLE}"
            echo "AWS Region    : ${params.AWS_REGION}"
            echo ''
            echo 'Only the Terraform backend resources were removed.'
            echo 'Application infrastructure was NOT destroyed.'
            echo ''
            echo '================================================'
        }

        failure {

            echo ''
            echo '================================================'
            echo '       CLEANUP PIPELINE FAILED'
            echo '================================================'
            echo ''
            echo "S3 Bucket     : ${params.S3_BACKEND_BUCKET}"
            echo "DynamoDB Table: ${params.DYNAMODB_LOCK_TABLE}"
            echo "AWS Region    : ${params.AWS_REGION}"
            echo ''
            echo 'Check the failed stage in the Jenkins console.'
            echo ''
            echo '================================================'
        }
    }
}
