pipeline {

    agent any

    // ================================================================
    // PIPELINE OPTIONS
    // ================================================================

    options {

        timestamps()

        ansiColor('xterm')

        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                daysToKeepStr: '30',
                numToKeepStr: '50'
            )
        )

        timeout(
            time: 60,
            unit: 'MINUTES'
        )
    }


    // ================================================================
    // PARAMETERS
    // ================================================================

    parameters {

        choice(
            name: 'AWS_REGION',
            choices: [
                'us-east-1'
            ],
            description: 'AWS region containing the Terraform backend.'
        )

        string(
            name: 'TERRAFORM_BACKEND_BUCKET',
            defaultValue: 'terraform-state-faizan-001',
            description: 'S3 bucket containing Terraform state files.'
        )

        string(
            name: 'DYNAMODB_LOCK_TABLE',
            defaultValue: 'terraform-lock',
            description: 'DynamoDB Terraform lock table.'
        )

        booleanParam(
            name: 'CONFIRM_DELETE',
            defaultValue: false,
            description: 'Set TRUE to permanently delete the Terraform S3 backend and DynamoDB lock table.'
        )
    }


    // ================================================================
    // ENVIRONMENT
    // ================================================================

    environment {

        AWS_DEFAULT_REGION = "${params.AWS_REGION}"

        AWS_REGION = "${params.AWS_REGION}"

        AWS_PAGER = ""

        AWS_CLI_AUTO_PROMPT = "off"
    }


    // ================================================================
    // STAGES
    // ================================================================

    stages {


        // ============================================================
        // 01 - START
        // ============================================================

        stage('01 - Start Backend Cleanup') {

            steps {

                echo ''
                echo '================================================'
                echo '       TERRAFORM BACKEND CLEANUP PIPELINE'
                echo '================================================'
                echo "AWS Region               : ${params.AWS_REGION}"
                echo "S3 Backend Bucket        : ${params.TERRAFORM_BACKEND_BUCKET}"
                echo "DynamoDB Lock Table      : ${params.DYNAMODB_LOCK_TABLE}"
                echo "Delete Confirmation      : ${params.CONFIRM_DELETE}"
                echo '================================================'
                echo ''

            }
        }


        // ============================================================
        // 02 - CONFIRM DELETE
        // ============================================================

        stage('02 - Confirm Destructive Operation') {

            steps {

                script {

                    if (!params.CONFIRM_DELETE) {

                        error(
                            'DELETION NOT CONFIRMED. Set CONFIRM_DELETE=true before running this pipeline.'
                        )

                    }

                    echo ''
                    echo '================================================'
                    echo '          DELETION CONFIRMED'
                    echo '================================================'
                    echo 'This pipeline will ONLY delete:'
                    echo ''
                    echo "1. All objects from S3 bucket"
                    echo "2. All S3 object versions"
                    echo "3. All S3 delete markers"
                    echo "4. The complete S3 bucket"
                    echo "5. DynamoDB Terraform lock table"
                    echo ''
                    echo 'It will NOT execute terraform destroy.'
                    echo 'It will NOT delete EC2/VPC/ALB/security groups.'
                    echo '================================================'
                    echo ''

                }

            }
        }


        // ============================================================
        // 03 - CHECK TOOLS
        // ============================================================

        stage('03 - Check Required Tools') {

            steps {

                sh '''
                    set -eu

                    echo "================================================"
                    echo "CHECKING REQUIRED TOOLS"
                    echo "================================================"

                    if ! command -v aws >/dev/null 2>&1
                    then
                        echo "ERROR: AWS CLI is not installed."
                        exit 1
                    fi

                    if ! command -v jq >/dev/null 2>&1
                    then
                        echo "ERROR: jq is not installed."
                        exit 1
                    fi

                    echo "AWS CLI:"
                    aws --version

                    echo ""
                    echo "jq:"
                    jq --version

                    echo ""
                    echo "Required tools are available."

                    echo "================================================"
                '''
            }
        }


        // ============================================================
        // 04 - AWS AUTHENTICATION
        // ============================================================

        stage('04 - Verify AWS Authentication') {

            steps {

                withCredentials(
                    [
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: 'aws-creds',
                            accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                            secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                        ]
                    ]
                ) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "VERIFYING AWS AUTHENTICATION"
                        echo "================================================"

                        aws sts get-caller-identity

                        echo ""
                        echo "AWS Region:"
                        echo "${AWS_REGION}"

                        echo ""
                        echo "AWS authentication successful."

                        echo "================================================"
                    '''
                }

            }
        }


        // ============================================================
        // 05 - CHECK S3 BUCKET
        // ============================================================

        stage('05 - Check S3 Backend Bucket') {

            steps {

                withCredentials(
                    [
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: 'aws-creds',
                            accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                            secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                        ]
                    ]
                ) {

                    sh '''
                        set -eu

                        BUCKET="${TERRAFORM_BACKEND_BUCKET}"

                        echo "================================================"
                        echo "CHECKING S3 BACKEND BUCKET"
                        echo "================================================"

                        echo "Bucket: ${BUCKET}"
                        echo "Region: ${AWS_REGION}"

                        if aws s3api head-bucket \
                            --bucket "${BUCKET}" \
                            --region "${AWS_REGION}" \
                            >/dev/null 2>&1
                        then

                            echo ""
                            echo "S3 bucket EXISTS."

                            echo ""
                            echo "Bucket location:"
                            aws s3api get-bucket-location \
                                --bucket "${BUCKET}" \
                                --region "${AWS_REGION}" \
                                --output json

                        else

                            echo ""
                            echo "S3 bucket does NOT exist."
                            echo "S3 cleanup will be skipped."

                        fi

                        echo ""
                        echo "================================================"
                    '''
                }

            }
        }


        // ============================================================
        // 06 - CHECK DYNAMODB
        // ============================================================

        stage('06 - Check DynamoDB Lock Table') {

            steps {

                withCredentials(
                    [
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: 'aws-creds',
                            accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                            secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                        ]
                    ]
                ) {

                    sh '''
                        set -eu

                        TABLE="${DYNAMODB_LOCK_TABLE}"

                        echo "================================================"
                        echo "CHECKING DYNAMODB LOCK TABLE"
                        echo "================================================"

                        echo "Table: ${TABLE}"
                        echo "Region: ${AWS_REGION}"

                        if aws dynamodb describe-table \
                            --table-name "${TABLE}" \
                            --region "${AWS_REGION}" \
                            >/dev/null 2>&1
                        then

                            echo ""
                            echo "DynamoDB table EXISTS."

                            aws dynamodb describe-table \
                                --table-name "${TABLE}" \
                                --region "${AWS_REGION}" \
                                --query 'Table.[TableName,TableStatus,ItemCount]' \
                                --output table

                        else

                            echo ""
                            echo "DynamoDB table does NOT exist."

                        fi

                        echo ""
                        echo "================================================"
                    '''
                }

            }
        }


        // ============================================================
        // 07 - DELETE S3 OBJECT VERSIONS
        // ============================================================

        stage('07 - Delete All S3 State Versions') {

            steps {

                withCredentials(
                    [
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: 'aws-creds',
                            accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                            secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                        ]
                    ]
                ) {

                    sh '''
                        set -eu

                        BUCKET="${TERRAFORM_BACKEND_BUCKET}"

                        echo "================================================"
                        echo "DELETING ALL S3 OBJECT VERSIONS"
                        echo "================================================"

                        if ! aws s3api head-bucket \
                            --bucket "${BUCKET}" \
                            --region "${AWS_REGION}" \
                            >/dev/null 2>&1
                        then

                            echo "Bucket does not exist."
                            echo "Nothing to delete."

                            exit 0

                        fi

                        TEMP_DIR="$(mktemp -d)"

                        trap 'rm -rf "${TEMP_DIR}"' EXIT

                        echo ""
                        echo "Removing all object versions and delete markers..."

                        TOTAL_DELETED=0

                        while true
                        do

                            echo ""
                            echo "Reading S3 object versions..."

                            aws s3api list-object-versions \
                                --bucket "${BUCKET}" \
                                --region "${AWS_REGION}" \
                                --output json \
                                > "${TEMP_DIR}/versions.json"

                            jq -c '
                                [
                                    (.Versions // [])[] |
                                    {
                                        Key: .Key,
                                        VersionId: .VersionId
                                    }
                                ]
                                +
                                [
                                    (.DeleteMarkers // [])[] |
                                    {
                                        Key: .Key,
                                        VersionId: .VersionId
                                    }
                                ]
                            ' "${TEMP_DIR}/versions.json" \
                            > "${TEMP_DIR}/objects-array.json"

                            COUNT="$(jq 'length' "${TEMP_DIR}/objects-array.json")"

                            echo "Objects/versions found: ${COUNT}"

                            if [ "${COUNT}" -eq 0 ]
                            then

                                echo ""
                                echo "No remaining object versions or delete markers."
                                break

                            fi

                            echo "Preparing AWS delete request..."

                            jq '{
                                Objects: .,
                                Quiet: true
                            }' "${TEMP_DIR}/objects-array.json" \
                            > "${TEMP_DIR}/delete.json"

                            echo "Deleting ${COUNT} S3 object versions/delete markers..."

                            aws s3api delete-objects \
                                --bucket "${BUCKET}" \
                                --delete "file://${TEMP_DIR}/delete.json" \
                                --region "${AWS_REGION}"

                            TOTAL_DELETED=$((TOTAL_DELETED + COUNT))

                            echo ""
                            echo "Deleted in this batch: ${COUNT}"
                            echo "Total deleted so far: ${TOTAL_DELETED}"

                            sleep 3

                        done

                        echo ""
                        echo "================================================"
                        echo "S3 VERSION CLEANUP COMPLETE"
                        echo "Total deleted: ${TOTAL_DELETED}"
                        echo "================================================"
                    '''
                }

            }
        }


        // ============================================================
        // 08 - VERIFY S3 EMPTY
        // ============================================================

        stage('08 - Verify S3 Bucket Empty') {

            steps {

                withCredentials(
                    [
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: 'aws-creds',
                            accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                            secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                        ]
                    ]
                ) {

                    sh '''
                        set -eu

                        BUCKET="${TERRAFORM_BACKEND_BUCKET}"

                        echo "================================================"
                        echo "VERIFYING S3 BUCKET IS EMPTY"
                        echo "================================================"

                        if ! aws s3api head-bucket \
                            --bucket "${BUCKET}" \
                            --region "${AWS_REGION}" \
                            >/dev/null 2>&1
                        then

                            echo "Bucket does not exist."
                            exit 0

                        fi

                        aws s3api list-object-versions \
                            --bucket "${BUCKET}" \
                            --region "${AWS_REGION}" \
                            --output json \
                            > s3-verification.json

                        REMAINING_VERSIONS="$(jq '(.Versions // []) | length' s3-verification.json)"

                        REMAINING_MARKERS="$(jq '(.DeleteMarkers // []) | length' s3-verification.json)"

                        echo ""
                        echo "Remaining object versions : ${REMAINING_VERSIONS}"
                        echo "Remaining delete markers  : ${REMAINING_MARKERS}"

                        if [ "${REMAINING_VERSIONS}" -ne 0 ]
                        then

                            echo ""
                            echo "ERROR: S3 still contains object versions."

                            cat s3-verification.json

                            exit 1

                        fi

                        if [ "${REMAINING_MARKERS}" -ne 0 ]
                        then

                            echo ""
                            echo "ERROR: S3 still contains delete markers."

                            cat s3-verification.json

                            exit 1

                        fi

                        echo ""
                        echo "S3 bucket is completely empty."

                        echo "================================================"
                    '''
                }

            }
        }


        // ============================================================
        // 09 - DELETE S3 BUCKET
        // ============================================================

        stage('09 - Delete Complete S3 Backend Bucket') {

            steps {

                withCredentials(
                    [
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: 'aws-creds',
                            accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                            secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                        ]
                    ]
                ) {

                    sh '''
                        set -eu

                        BUCKET="${TERRAFORM_BACKEND_BUCKET}"

                        echo "================================================"
                        echo "DELETING COMPLETE S3 BACKEND BUCKET"
                        echo "================================================"

                        if ! aws s3api head-bucket \
                            --bucket "${BUCKET}" \
                            --region "${AWS_REGION}" \
                            >/dev/null 2>&1
                        then

                            echo "Bucket already does not exist."
                            exit 0

                        fi

                        aws s3api delete-bucket \
                            --bucket "${BUCKET}" \
                            --region "${AWS_REGION}"

                        echo ""
                        echo "S3 bucket deletion requested."

                        echo "================================================"
                    '''
                }

            }
        }


        // ============================================================
        // 10 - WAIT S3 DELETE
        // ============================================================

        stage('10 - Verify S3 Bucket Deleted') {

            steps {

                withCredentials(
                    [
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: 'aws-creds',
                            accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                            secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                        ]
                    ]
                ) {

                    sh '''
                        set -eu

                        BUCKET="${TERRAFORM_BACKEND_BUCKET}"

                        echo "================================================"
                        echo "VERIFYING S3 BUCKET DELETION"
                        echo "================================================"

                        ATTEMPT=1
                        MAX_ATTEMPTS=20

                        while [ "${ATTEMPT}" -le "${MAX_ATTEMPTS}" ]
                        do

                            if aws s3api head-bucket \
                                --bucket "${BUCKET}" \
                                --region "${AWS_REGION}" \
                                >/dev/null 2>&1
                            then

                                echo "Bucket still exists."
                                echo "Waiting..."

                                sleep 3

                            else

                                echo ""
                                echo "S3 BUCKET SUCCESSFULLY DELETED."

                                exit 0

                            fi

                            ATTEMPT=$((ATTEMPT + 1))

                        done

                        echo ""
                        echo "ERROR: S3 bucket still appears to exist after verification."

                        exit 1
                    '''
                }

            }
        }


        // ============================================================
        // 11 - DELETE DYNAMODB
        // ============================================================

        stage('11 - Delete DynamoDB Lock Table') {

            steps {

                withCredentials(
                    [
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: 'aws-creds',
                            accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                            secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                        ]
                    ]
                ) {

                    sh '''
                        set -eu

                        TABLE="${DYNAMODB_LOCK_TABLE}"

                        echo "================================================"
                        echo "DELETING DYNAMODB LOCK TABLE"
                        echo "================================================"

                        if ! aws dynamodb describe-table \
                            --table-name "${TABLE}" \
                            --region "${AWS_REGION}" \
                            >/dev/null 2>&1
                        then

                            echo "DynamoDB table does not exist."
                            exit 0

                        fi

                        echo "Deleting table: ${TABLE}"

                        aws dynamodb delete-table \
                            --table-name "${TABLE}" \
                            --region "${AWS_REGION}"

                        echo ""
                        echo "DynamoDB deletion requested."

                        echo "================================================"
                    '''
                }

            }
        }


        // ============================================================
        // 12 - WAIT DYNAMODB
        // ============================================================

        stage('12 - Wait For DynamoDB Deletion') {

            steps {

                withCredentials(
                    [
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: 'aws-creds',
                            accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                            secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                        ]
                    ]
                ) {

                    sh '''
                        set -eu

                        TABLE="${DYNAMODB_LOCK_TABLE}"

                        echo "================================================"
                        echo "WAITING FOR DYNAMODB TABLE DELETION"
                        echo "================================================"

                        echo "Waiting for AWS to finish deleting:"
                        echo "${TABLE}"

                        aws dynamodb wait table-not-exists \
                            --table-name "${TABLE}" \
                            --region "${AWS_REGION}"

                        echo ""
                        echo "DynamoDB table deletion completed."

                        echo "================================================"
                    '''
                }

            }
        }


        // ============================================================
        // 13 - FINAL DYNAMODB VERIFICATION
        // ============================================================

        stage('13 - Verify DynamoDB Table Deleted') {

            steps {

                withCredentials(
                    [
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: 'aws-creds',
                            accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                            secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                        ]
                    ]
                ) {

                    sh '''
                        set -eu

                        TABLE="${DYNAMODB_LOCK_TABLE}"

                        echo "================================================"
                        echo "FINAL DYNAMODB VERIFICATION"
                        echo "================================================"

                        if aws dynamodb describe-table \
                            --table-name "${TABLE}" \
                            --region "${AWS_REGION}" \
                            >/dev/null 2>&1
                        then

                            echo ""
                            echo "ERROR: DynamoDB table still exists."

                            exit 1

                        else

                            echo ""
                            echo "DYNAMODB TABLE SUCCESSFULLY DELETED."

                        fi

                        echo "================================================"
                    '''
                }

            }
        }


        // ============================================================
        // 14 - FINAL VERIFICATION
        // ============================================================

        stage('14 - Final Backend Verification') {

            steps {

                withCredentials(
                    [
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: 'aws-creds',
                            accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                            secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                        ]
                    ]
                ) {

                    sh '''
                        set -eu

                        BUCKET="${TERRAFORM_BACKEND_BUCKET}"
                        TABLE="${DYNAMODB_LOCK_TABLE}"

                        echo ""
                        echo "================================================"
                        echo "      FINAL BACKEND DESTRUCTION VERIFICATION"
                        echo "================================================"

                        echo ""
                        echo "Checking S3 bucket..."

                        if aws s3api head-bucket \
                            --bucket "${BUCKET}" \
                            --region "${AWS_REGION}" \
                            >/dev/null 2>&1
                        then

                            echo "ERROR: S3 bucket still exists."
                            exit 1

                        else

                            echo "S3 bucket: DELETED"

                        fi


                        echo ""
                        echo "Checking DynamoDB table..."

                        if aws dynamodb describe-table \
                            --table-name "${TABLE}" \
                            --region "${AWS_REGION}" \
                            >/dev/null 2>&1
                        then

                            echo "ERROR: DynamoDB table still exists."
                            exit 1

                        else

                            echo "DynamoDB table: DELETED"

                        fi


                        echo ""
                        echo "================================================"
                        echo "       FINAL VERIFICATION SUCCESSFUL"
                        echo "================================================"
                    '''
                }

            }
        }


        // ============================================================
        // 15 - FINAL REPORT
        // ============================================================

        stage('15 - Final Destruction Report') {

            steps {

                echo ''
                echo '================================================'
                echo '       TERRAFORM BACKEND DESTRUCTION REPORT'
                echo '================================================'
                echo ''
                echo "AWS Region               : ${params.AWS_REGION}"
                echo "S3 Backend Bucket        : ${params.TERRAFORM_BACKEND_BUCKET}"
                echo "S3 State Versions        : DELETED"
                echo "S3 Delete Markers        : DELETED"
                echo "S3 Bucket                : DELETED"
                echo "DynamoDB Lock Table      : DELETED"
                echo ''
                echo 'Terraform destroy        : NOT EXECUTED'
                echo 'EC2 resources            : NOT TOUCHED'
                echo 'VPC resources            : NOT TOUCHED'
                echo 'ALB resources            : NOT TOUCHED'
                echo 'Security Groups          : NOT TOUCHED'
                echo ''
                echo '================================================'
                echo '        BACKEND CLEANUP SUCCESSFUL'
                echo '================================================'
                echo ''

            }
        }

    }


    // ================================================================
    // POST ACTIONS
    // ================================================================

    post {

        success {

            echo ''
            echo '================================================'
            echo '       CLEANUP PIPELINE SUCCESSFUL'
            echo '================================================'
            echo ''
            echo "S3 backend bucket deleted:"
            echo "${params.TERRAFORM_BACKEND_BUCKET}"
            echo ''
            echo "DynamoDB lock table deleted:"
            echo "${params.DYNAMODB_LOCK_TABLE}"
            echo ''
            echo 'Terraform infrastructure was NOT destroyed.'
            echo ''
            echo '================================================'
        }


        failure {

            echo ''
            echo '================================================'
            echo '       CLEANUP PIPELINE FAILED'
            echo '================================================'
            echo ''
            echo "Environment/Region : ${params.AWS_REGION}"
            echo "S3 Bucket          : ${params.TERRAFORM_BACKEND_BUCKET}"
            echo "DynamoDB Table     : ${params.DYNAMODB_LOCK_TABLE}"
            echo ''
            echo 'Check the failed stage above.'
            echo ''
            echo 'IMPORTANT:'
            echo 'The pipeline stops immediately when a destructive'
            echo 'operation or verification fails.'
            echo ''
            echo '================================================'
        }


        always {

            echo ''
            echo '================================================'
            echo '       CLEANING JENKINS WORKSPACE'
            echo '================================================'

            cleanWs()

            echo ''
            echo 'Workspace cleanup completed.'
            echo '================================================'
        }

    }

}
