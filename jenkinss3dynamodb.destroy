pipeline {

    agent any

    // ================================================================
    // PIPELINE OPTIONS
    // ================================================================

    options {

        timestamps()

        ansiColor('xterm')

        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                daysToKeepStr: '30',
                numToKeepStr: '50'
            )
        )

        timeout(
            time: 120,
            unit: 'MINUTES'
        )
    }


    // ================================================================
    // PARAMETERS
    // ================================================================

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: [
                'dev',
                'qa',
                'stage',
                'prod'
            ],
            description: 'Terraform environment to destroy'
        )

        choice(
            name: 'AWS_REGION',
            choices: [
                'us-east-1'
            ],
            description: 'AWS region'
        )

        booleanParam(
            name: 'DELETE_TERRAFORM_BACKEND',
            defaultValue: true,
            description: 'Delete Terraform S3 state bucket and DynamoDB lock table after infrastructure destruction'
        )

        booleanParam(
            name: 'CONFIRM_DESTROY',
            defaultValue: false,
            description: 'Safety confirmation. Set this to TRUE before running destruction.'
        )
    }


    // ================================================================
    // ENVIRONMENT
    // ================================================================

    environment {

        AWS_DEFAULT_REGION = "${params.AWS_REGION}"

        AWS_REGION = "${params.AWS_REGION}"

        AWS_CREDENTIALS = 'aws-creds'

        GITHUB_CREDENTIALS = 'github-creds'

        TERRAFORM_REPO =
            'https://github.com/FAIZANSHEIKH223/terraform-aws-infra.git'

        TERRAFORM_BRANCH = 'main'

        TERRAFORM_DIR = 'terraform-infra'

        TF_STATE_BUCKET = 'terraform-state-faizan-001'

        TF_STATE_KEY = 'terraform.tfstate'

        TF_LOCK_TABLE = 'terraform-lock'
    }


    // ================================================================
    // STAGES
    // ================================================================

    stages {


        // ============================================================
        // 01 - START
        // ============================================================

        stage('01 - Start Destroy Pipeline') {

            steps {

                echo ''
                echo '================================================'
                echo '        TERRAFORM DESTROY PIPELINE'
                echo '================================================'

                echo "Environment              : ${params.ENVIRONMENT}"

                echo "AWS Region               : ${params.AWS_REGION}"

                echo "Terraform Backend Bucket : ${env.TF_STATE_BUCKET}"

                echo "Terraform State Key      : ${env.TF_STATE_KEY}"

                echo "DynamoDB Lock Table      : ${env.TF_LOCK_TABLE}"

                echo "Delete Backend           : ${params.DELETE_TERRAFORM_BACKEND}"

                echo "Destroy Confirmation     : ${params.CONFIRM_DESTROY}"

                echo '================================================'
                echo ''
            }
        }


        // ============================================================
        // 02 - CONFIRM DESTROY
        // ============================================================

        stage('02 - Confirm Destruction') {

            steps {

                script {

                    if (!params.CONFIRM_DESTROY) {

                        error(
                            'DESTRUCTION NOT CONFIRMED. Set CONFIRM_DESTROY=true before running this pipeline.'
                        )
                    }
                }

                echo 'Destruction confirmation received.'
            }
        }


        // ============================================================
        // 03 - CHECK REQUIRED TOOLS
        // ============================================================

        stage('03 - Check Required Tools') {

            steps {

                sh(
                    label: 'Check Terraform AWS CLI jq',
                    script: '''#!/bin/bash

set -eu

echo "================================================"
echo "CHECKING REQUIRED TOOLS"
echo "================================================"

command -v terraform

echo ""
echo "Terraform:"
terraform version

echo ""
command -v aws

echo "AWS CLI:"
aws --version

echo ""
command -v jq

echo "jq:"
jq --version

echo ""
echo "All required tools are available."

echo "================================================"
'''
                )
            }
        }


        // ============================================================
        // 04 - AWS AUTHENTICATION
        // ============================================================

        stage('04 - Verify AWS Authentication') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh(
                        label: 'Verify AWS authentication',
                        script: '''#!/bin/bash

set -eu

echo "================================================"
echo "VERIFYING AWS AUTHENTICATION"
echo "================================================"

aws sts get-caller-identity

echo ""
echo "AWS Region:"
echo "${AWS_DEFAULT_REGION}"

echo "================================================"
'''
                    )
                }
            }
        }


        // ============================================================
        // 05 - CHECK S3 BACKEND
        // ============================================================

        stage('05 - Check Terraform S3 Backend') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh(
                        label: 'Check Terraform S3 backend',
                        script: '''#!/bin/bash

set -eu

echo "================================================"
echo "CHECKING TERRAFORM S3 BACKEND"
echo "================================================"

BUCKET="${TF_STATE_BUCKET}"
REGION="${AWS_DEFAULT_REGION}"

echo "Bucket: ${BUCKET}"

if aws s3api head-bucket \
    --bucket "${BUCKET}" \
    --region "${REGION}" >/dev/null 2>&1
then

    echo "Terraform S3 backend bucket exists."

else

    echo "Terraform S3 backend bucket does not exist."

    echo "Nothing to delete from S3."

fi

echo "================================================"
'''
                    )
                }
            }
        }


        // ============================================================
        // 06 - CHECK DYNAMODB
        // ============================================================

        stage('06 - Check DynamoDB Lock Table') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh(
                        label: 'Check DynamoDB lock table',
                        script: '''#!/bin/bash

set -eu

echo "================================================"
echo "CHECKING DYNAMODB LOCK TABLE"
echo "================================================"

TABLE="${TF_LOCK_TABLE}"
REGION="${AWS_DEFAULT_REGION}"

echo "Table: ${TABLE}"

if aws dynamodb describe-table \
    --table-name "${TABLE}" \
    --region "${REGION}" >/dev/null 2>&1
then

    echo "DynamoDB lock table exists."

    STATUS=$(aws dynamodb describe-table \
        --table-name "${TABLE}" \
        --region "${REGION}" \
        --query 'Table.TableStatus' \
        --output text)

    echo "DynamoDB status: ${STATUS}"

else

    echo "DynamoDB lock table does not exist."

fi

echo "================================================"
'''
                    )
                }
            }
        }


        // ============================================================
        // 07 - CHECK ACTIVE LOCK
        // ============================================================

        stage('07 - Verify No Active Terraform Lock Before Destroy') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh(
                        label: 'Check Terraform lock',
                        script: '''#!/bin/bash

set -eu

echo "================================================"
echo "CHECKING TERRAFORM LOCK"
echo "================================================"

TABLE="${TF_LOCK_TABLE}"

LOCK_ID="${TF_STATE_BUCKET}/${TF_STATE_KEY}"

echo "LockID:"
echo "${LOCK_ID}"

DDB_KEY_JSON=$(printf '{"LockID":{"S":"%s"}}' "${LOCK_ID}")

echo ""
echo "Checking DynamoDB..."

if ! aws dynamodb describe-table \
    --table-name "${TABLE}" \
    --region "${AWS_DEFAULT_REGION}" >/dev/null 2>&1
then

    echo "DynamoDB table does not exist."

    exit 0

fi

LOCK_INFO=$(
    aws dynamodb get-item \
        --table-name "${TABLE}" \
        --key "${DDB_KEY_JSON}" \
        --consistent-read \
        --region "${AWS_DEFAULT_REGION}" \
        --query 'Item.Info.S' \
        --output text 2>/dev/null || true
)

if [ -z "${LOCK_INFO}" ] ||
   [ "${LOCK_INFO}" = "None" ] ||
   [ "${LOCK_INFO}" = "null" ]
then

    echo "No active Terraform lock detected."

else

    echo ""
    echo "================================================"
    echo "ACTIVE TERRAFORM LOCK DETECTED"
    echo "================================================"

    echo "${LOCK_INFO}"

    echo ""
    echo "Terraform destruction will NOT continue."

    exit 1

fi

echo "================================================"
'''
                    )
                }
            }
        }


        // ============================================================
        // 08 - CHECKOUT TERRAFORM
        // ============================================================

        stage('08 - Checkout Terraform Repository') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    deleteDir()

                    git(
                        branch: "${TERRAFORM_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${TERRAFORM_REPO}"
                    )
                }
            }
        }


        // ============================================================
        // 09 - TERRAFORM INIT
        // ============================================================

        stage('09 - Terraform Init') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh(
                            label: 'Terraform init',
                            script: '''#!/bin/bash

set -eu

echo "================================================"
echo "TERRAFORM INIT"
echo "================================================"

terraform init \
    -input=false \
    -reconfigure

echo ""
echo "Terraform initialization PASSED."

echo "================================================"
'''
                        )
                    }
                }
            }
        }


        // ============================================================
        // 10 - TERRAFORM VALIDATE
        // ============================================================

        stage('10 - Terraform Validate') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    sh(
                        label: 'Terraform validate',
                        script: '''#!/bin/bash

set -eu

echo "================================================"
echo "TERRAFORM VALIDATION"
echo "================================================"

terraform validate

echo ""
echo "Terraform validation PASSED."

echo "================================================"
'''
                    )
                }
            }
        }


        // ============================================================
        // 11 - TERRAFORM DESTROY PLAN
        // ============================================================

        stage('11 - Terraform Destroy Plan') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh(
                            label: 'Terraform destroy plan',
                            script: '''#!/bin/bash

set -eu

echo "================================================"
echo "TERRAFORM DESTROY PLAN"
echo "================================================"

TFVARS="environments/${ENVIRONMENT}/terraform.tfvars"

if [ ! -f "${TFVARS}" ]; then

    echo "ERROR: Terraform variables file not found:"
    echo "${TFVARS}"

    exit 1

fi

echo "Using:"
echo "${TFVARS}"

terraform plan \
    -destroy \
    -input=false \
    -var-file="${TFVARS}" \
    -out=destroy.tfplan

echo ""
echo "Terraform destroy plan created."

echo "================================================"
'''
                        )
                    }
                }
            }
        }


        // ============================================================
        // 12 - TERRAFORM DESTROY
        // ============================================================

        stage('12 - Terraform Destroy Infrastructure') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh(
                            label: 'Terraform destroy infrastructure',
                            script: '''#!/bin/bash

set -eu

echo "================================================"
echo "TERRAFORM DESTROY INFRASTRUCTURE"
echo "================================================"

TFVARS="environments/${ENVIRONMENT}/terraform.tfvars"

if [ ! -f "${TFVARS}" ]; then

    echo "ERROR: Terraform variables file not found:"
    echo "${TFVARS}"

    exit 1

fi

terraform destroy \
    -auto-approve \
    -input=false \
    -var-file="${TFVARS}"

echo ""
echo "Terraform infrastructure destruction PASSED."

echo "================================================"
'''
                        )
                    }
                }
            }
        }


        // ============================================================
        // 13 - WAIT FOR LOCK RELEASE
        // ============================================================

        stage('13 - Wait For Terraform Lock Release') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh(
                        label: 'Wait for Terraform lock release',
                        script: '''#!/bin/bash

set -eu

echo "================================================"
echo "WAITING FOR TERRAFORM LOCK RELEASE"
echo "================================================"

TABLE="${TF_LOCK_TABLE}"

LOCK_ID="${TF_STATE_BUCKET}/${TF_STATE_KEY}"

DDB_KEY_JSON=$(printf '{"LockID":{"S":"%s"}}' "${LOCK_ID}")

MAX_ATTEMPTS=30

SLEEP_SECONDS=5

ATTEMPT=1

while [ "${ATTEMPT}" -le "${MAX_ATTEMPTS}" ]
do

    echo ""
    echo "Lock check ${ATTEMPT}/${MAX_ATTEMPTS}"

    if ! aws dynamodb describe-table \
        --table-name "${TABLE}" \
        --region "${AWS_DEFAULT_REGION}" >/dev/null 2>&1
    then

        echo "DynamoDB table no longer exists."

        exit 0

    fi

    LOCK_INFO=$(
        aws dynamodb get-item \
            --table-name "${TABLE}" \
            --key "${DDB_KEY_JSON}" \
            --consistent-read \
            --region "${AWS_DEFAULT_REGION}" \
            --query 'Item.Info.S' \
            --output text 2>/dev/null || true
    )

    if [ -z "${LOCK_INFO}" ] ||
       [ "${LOCK_INFO}" = "None" ] ||
       [ "${LOCK_INFO}" = "null" ]
    then

        echo "Terraform lock released."

        exit 0

    fi

    echo "Terraform lock still exists."

    sleep "${SLEEP_SECONDS}"

    ATTEMPT=$((ATTEMPT + 1))

done

echo ""
echo "ERROR: Terraform lock was not released within timeout."

exit 1

'''
                    )
                }
            }
        }


        // ============================================================
        // 14 - FINAL LOCK CHECK
        // ============================================================

        stage('14 - Verify No Active Terraform Lock') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh(
                        label: 'Final Terraform lock verification',
                        script: '''#!/bin/bash

set -eu

echo "================================================"
echo "FINAL TERRAFORM LOCK VERIFICATION"
echo "================================================"

TABLE="${TF_LOCK_TABLE}"

LOCK_ID="${TF_STATE_BUCKET}/${TF_STATE_KEY}"

DDB_KEY_JSON=$(printf '{"LockID":{"S":"%s"}}' "${LOCK_ID}")

if ! aws dynamodb describe-table \
    --table-name "${TABLE}" \
    --region "${AWS_DEFAULT_REGION}" >/dev/null 2>&1
then

    echo "DynamoDB table does not exist."

    exit 0

fi

LOCK_INFO=$(
    aws dynamodb get-item \
        --table-name "${TABLE}" \
        --key "${DDB_KEY_JSON}" \
        --consistent-read \
        --region "${AWS_DEFAULT_REGION}" \
        --output json 2>/dev/null || true
)

ITEM_COUNT=$(
    echo "${LOCK_INFO}" |
    jq '.Item // {} | length'
)

if [ "${ITEM_COUNT}" -eq 0 ]; then

    echo "No active Terraform lock detected."

else

    echo ""
    echo "ERROR: Active Terraform lock still exists."

    echo "${LOCK_INFO}" | jq .

    exit 1

fi

echo "Terraform lock verification PASSED."

echo "================================================"
'''
                    )
                }
            }
        }


        // ============================================================
        // 15 - CHECK STATE OBJECT
        // ============================================================

        stage('15 - Check Terraform State Object') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh(
                        label: 'Check Terraform state object',
                        script: '''#!/bin/bash

set -eu

echo "================================================"
echo "CHECKING TERRAFORM STATE OBJECT"
echo "================================================"

BUCKET="${TF_STATE_BUCKET}"

KEY="${TF_STATE_KEY}"

if aws s3api head-object \
    --bucket "${BUCKET}" \
    --key "${KEY}" \
    --region "${AWS_DEFAULT_REGION}" >/dev/null 2>&1
then

    echo "Terraform state object exists."

else

    echo "Terraform state object does not currently exist."

fi

echo "================================================"
'''
                    )
                }
            }
        }


        // ============================================================
        // 16 - DELETE STATE OBJECT
        // ============================================================

        stage('16 - Delete Terraform State Object') {

            when {

                expression {
                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh(
                        label: 'Delete Terraform state object',
                        script: '''#!/bin/bash

set -eu

echo "================================================"
echo "DELETING TERRAFORM STATE OBJECT"
echo "================================================"

BUCKET="${TF_STATE_BUCKET}"

KEY="${TF_STATE_KEY}"

echo "Bucket : ${BUCKET}"

echo "Key    : ${KEY}"

if aws s3api head-object \
    --bucket "${BUCKET}" \
    --key "${KEY}" \
    --region "${AWS_DEFAULT_REGION}" >/dev/null 2>&1
then

    aws s3api delete-object \
        --bucket "${BUCKET}" \
        --key "${KEY}" \
        --region "${AWS_DEFAULT_REGION}"

    echo ""
    echo "Terraform state delete marker created."

else

    echo "Terraform state object does not exist."

fi

echo "================================================"
'''
                    )
                }
            }
        }


        // ============================================================
        // 17 - DELETE ALL S3 VERSIONS
        // ============================================================

        stage('17 - Delete All S3 Object Versions') {

            when {

                expression {
                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh(
                        label: 'Delete all S3 object versions',
                        script: '''#!/bin/bash

set -eu

echo "================================================"
echo "DELETING ALL S3 OBJECT VERSIONS"
echo "================================================"

BUCKET="${TF_STATE_BUCKET}"

REGION="${AWS_DEFAULT_REGION}"

DELETE_FILE="$(mktemp)"

trap 'rm -f "${DELETE_FILE}"' EXIT

echo "Bucket: ${BUCKET}"

if ! aws s3api head-bucket \
    --bucket "${BUCKET}" \
    --region "${REGION}" >/dev/null 2>&1
then

    echo "S3 bucket does not exist."

    exit 0

fi

echo ""
echo "Removing object versions and delete markers..."

while true
do

    RESPONSE_FILE="$(mktemp)"

    trap 'rm -f "${DELETE_FILE}" "${RESPONSE_FILE}"' EXIT

    aws s3api list-object-versions \
        --bucket "${BUCKET}" \
        --region "${REGION}" \
        --output json > "${RESPONSE_FILE}"

    jq -c '
        [
            (.Versions // [])[] |
            {
                Key: .Key,
                VersionId: .VersionId
            }
        ]
        +
        [
            (.DeleteMarkers // [])[] |
            {
                Key: .Key,
                VersionId: .VersionId
            }
        ]
    ' "${RESPONSE_FILE}" > "${DELETE_FILE}"

    COUNT=$(jq 'length' "${DELETE_FILE}")

    echo "Objects found in current page: ${COUNT}"

    if [ "${COUNT}" -eq 0 ]; then

        rm -f "${RESPONSE_FILE}"

        break

    fi

    echo ""
    echo "Deleting ${COUNT} object versions/delete markers..."

    aws s3api delete-objects \
        --bucket "${BUCKET}" \
        --delete "file://${DELETE_FILE}" \
        --region "${REGION}"

    rm -f "${RESPONSE_FILE}"

done

echo ""
echo "Checking whether any S3 versions remain..."

REMAINING_FILE="$(mktemp)"

aws s3api list-object-versions \
    --bucket "${BUCKET}" \
    --region "${REGION}" \
    --output json > "${REMAINING_FILE}"

REMAINING=$(
    jq '
        ((.Versions // []) | length)
        +
        ((.DeleteMarkers // []) | length)
    ' "${REMAINING_FILE}"
)

rm -f "${REMAINING_FILE}"

if [ "${REMAINING}" -ne 0 ]; then

    echo "ERROR: ${REMAINING} S3 versions/delete markers still remain."

    exit 1

fi

echo ""
echo "ALL S3 OBJECT VERSIONS DELETED."

echo "================================================"
'''
                    )
                }
            }
        }


        // ============================================================
        // 18 - VERIFY S3 EMPTY
        // ============================================================

        stage('18 - Verify S3 Bucket Empty') {

            when {

                expression {
                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh(
                        label: 'Verify S3 bucket empty',
                        script: '''#!/bin/bash

set -eu

echo "================================================"
echo "VERIFYING S3 BUCKET EMPTY"
echo "================================================"

BUCKET="${TF_STATE_BUCKET}"

if ! aws s3api head-bucket \
    --bucket "${BUCKET}" \
    --region "${AWS_DEFAULT_REGION}" >/dev/null 2>&1
then

    echo "Bucket already does not exist."

    exit 0

fi

OBJECT_COUNT=$(
    aws s3api list-objects-v2 \
        --bucket "${BUCKET}" \
        --region "${AWS_DEFAULT_REGION}" \
        --query 'KeyCount' \
        --output text
)

VERSION_COUNT=$(
    aws s3api list-object-versions \
        --bucket "${BUCKET}" \
        --region "${AWS_DEFAULT_REGION}" \
        --query 'length(Versions || [])' \
        --output text
)

DELETE_MARKER_COUNT=$(
    aws s3api list-object-versions \
        --bucket "${BUCKET}" \
        --region "${AWS_DEFAULT_REGION}" \
        --query 'length(DeleteMarkers || [])' \
        --output text
)

echo "Current objects        : ${OBJECT_COUNT}"

echo "Object versions        : ${VERSION_COUNT}"

echo "Delete markers         : ${DELETE_MARKER_COUNT}"

if [ "${OBJECT_COUNT}" != "0" ] ||
   [ "${VERSION_COUNT}" != "0" ] ||
   [ "${DELETE_MARKER_COUNT}" != "0" ]
then

    echo ""
    echo "ERROR: S3 bucket is not empty."

    exit 1

fi

echo ""
echo "S3 bucket is completely empty."

echo "================================================"
'''
                    )
                }
            }
        }


        // ============================================================
        // 19 - DELETE S3 BACKEND BUCKET
        // ============================================================

        stage('19 - Delete Terraform S3 Backend Bucket') {

            when {

                expression {
                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh(
                        label: 'Delete Terraform S3 backend bucket',
                        script: '''#!/bin/bash

set -eu

echo "================================================"
echo "DELETING TERRAFORM S3 BACKEND BUCKET"
echo "================================================"

BUCKET="${TF_STATE_BUCKET}"

if aws s3api head-bucket \
    --bucket "${BUCKET}" \
    --region "${AWS_DEFAULT_REGION}" >/dev/null 2>&1
then

    aws s3api delete-bucket \
        --bucket "${BUCKET}" \
        --region "${AWS_DEFAULT_REGION}"

    echo ""
    echo "S3 backend bucket deletion requested."

else

    echo "S3 backend bucket does not exist."

fi

echo "================================================"
'''
                    )
                }
            }
        }


        // ============================================================
        // 20 - VERIFY S3 DELETED
        // ============================================================

        stage('20 - Verify S3 Bucket Deleted') {

            when {

                expression {
                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh(
                        label: 'Verify S3 bucket deleted',
                        script: '''#!/bin/bash

set -eu

echo "================================================"
echo "VERIFYING S3 BUCKET DELETED"
echo "================================================"

BUCKET="${TF_STATE_BUCKET}"

MAX_ATTEMPTS=30

ATTEMPT=1

while [ "${ATTEMPT}" -le "${MAX_ATTEMPTS}" ]
do

    if aws s3api head-bucket \
        --bucket "${BUCKET}" \
        --region "${AWS_DEFAULT_REGION}" >/dev/null 2>&1
    then

        echo "Bucket still exists."

        sleep 5

        ATTEMPT=$((ATTEMPT + 1))

    else

        echo ""
        echo "S3 backend bucket has been deleted."

        exit 0

    fi

done

echo ""
echo "ERROR: S3 bucket still exists after verification timeout."

exit 1

'''
                    )
                }
            }
        }


        // ============================================================
        // 21 - DELETE DYNAMODB
        // ============================================================

        stage('21 - Delete DynamoDB Lock Table') {

            when {

                expression {
                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh(
                        label: 'Delete DynamoDB lock table',
                        script: '''#!/bin/bash

set -eu

echo "================================================"
echo "DELETING DYNAMODB LOCK TABLE"
echo "================================================"

TABLE="${TF_LOCK_TABLE}"

if aws dynamodb describe-table \
    --table-name "${TABLE}" \
    --region "${AWS_DEFAULT_REGION}" >/dev/null 2>&1
then

    STATUS=$(
        aws dynamodb describe-table \
            --table-name "${TABLE}" \
            --region "${AWS_DEFAULT_REGION}" \
            --query 'Table.TableStatus' \
            --output text
    )

    echo "Current DynamoDB status: ${STATUS}"

    if [ "${STATUS}" = "DELETING" ]; then

        echo "DynamoDB table is already being deleted."

    else

        aws dynamodb delete-table \
            --table-name "${TABLE}" \
            --region "${AWS_DEFAULT_REGION}"

        echo ""
        echo "DynamoDB deletion requested."

    fi

else

    echo "DynamoDB table does not exist."

fi

echo "================================================"
'''
                    )
                }
            }
        }


        // ============================================================
        // 22 - WAIT FOR DYNAMODB
        // ============================================================

        stage('22 - Wait For DynamoDB Table Deletion') {

            when {

                expression {
                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh(
                        label: 'Wait for DynamoDB deletion',
                        script: '''#!/bin/bash

set -eu

echo "================================================"
echo "WAITING FOR DYNAMODB TABLE DELETION"
echo "================================================"

TABLE="${TF_LOCK_TABLE}"

MAX_ATTEMPTS=30

ATTEMPT=1

while [ "${ATTEMPT}" -le "${MAX_ATTEMPTS}" ]
do

    if aws dynamodb describe-table \
        --table-name "${TABLE}" \
        --region "${AWS_DEFAULT_REGION}" >/dev/null 2>&1
    then

        STATUS=$(
            aws dynamodb describe-table \
                --table-name "${TABLE}" \
                --region "${AWS_DEFAULT_REGION}" \
                --query 'Table.TableStatus' \
                --output text
        )

        echo "Attempt ${ATTEMPT}/${MAX_ATTEMPTS}: ${STATUS}"

        sleep 5

        ATTEMPT=$((ATTEMPT + 1))

    else

        echo ""
        echo "DynamoDB table no longer exists."

        exit 0

    fi

done

echo ""
echo "ERROR: DynamoDB table still exists after timeout."

exit 1

'''
                    )
                }
            }
        }


        // ============================================================
        // 23 - FINAL VERIFICATION
        // ============================================================

        stage('23 - Final Destruction Verification') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh(
                        label: 'Final destruction verification',
                        script: '''#!/bin/bash

set -eu

echo "================================================"
echo "FINAL DESTRUCTION VERIFICATION"
echo "================================================"

BUCKET="${TF_STATE_BUCKET}"

TABLE="${TF_LOCK_TABLE}"

echo ""
echo "Checking S3 backend..."

if aws s3api head-bucket \
    --bucket "${BUCKET}" \
    --region "${AWS_DEFAULT_REGION}" >/dev/null 2>&1
then

    echo "ERROR: S3 backend bucket still exists."

    exit 1

else

    echo "S3 backend bucket: DELETED"

fi


echo ""
echo "Checking DynamoDB lock table..."

if aws dynamodb describe-table \
    --table-name "${TABLE}" \
    --region "${AWS_DEFAULT_REGION}" >/dev/null 2>&1
then

    echo "ERROR: DynamoDB lock table still exists."

    exit 1

else

    echo "DynamoDB lock table: DELETED"

fi


echo ""
echo "================================================"
echo "FINAL VERIFICATION PASSED"
echo "================================================"

echo ""
echo "Terraform infrastructure : DESTROYED"

echo "Terraform state bucket    : DELETED"

echo "Terraform state versions  : DELETED"

echo "DynamoDB lock table       : DELETED"

echo ""
echo "================================================"
'''
                    )
                }
            }
        }


        // ============================================================
        // 24 - FINAL REPORT
        // ============================================================

        stage('24 - Final Destruction Report') {

            steps {

                echo ''
                echo '================================================'
                echo '          TERRAFORM DESTROY COMPLETE'
                echo '================================================'

                echo ''

                echo "Environment              : ${params.ENVIRONMENT}"

                echo "AWS Region               : ${params.AWS_REGION}"

                echo "Terraform Repository     : ${TERRAFORM_REPO}"

                echo "Terraform Backend Bucket : ${TF_STATE_BUCKET}"

                echo "Terraform State Key      : ${TF_STATE_KEY}"

                echo "DynamoDB Lock Table      : ${TF_LOCK_TABLE}"

                echo ''

                echo 'Infrastructure            : DESTROYED'

                echo 'Terraform State           : REMOVED'

                echo 'S3 Object Versions        : REMOVED'

                echo 'S3 Delete Markers         : REMOVED'

                echo 'S3 Backend Bucket         : REMOVED'

                echo 'DynamoDB Lock Table       : REMOVED'

                echo ''

                echo '================================================'
                echo '          DESTRUCTION SUCCESSFUL'
                echo '================================================'
            }
        }
    }


    // ================================================================
    // POST ACTIONS
    // ================================================================

    post {

        always {

            echo ''
            echo '================================================'
            echo '        CLEANING JENKINS WORKSPACE'
            echo '================================================'

            cleanWs(
                deleteDirs: true,
                disableDeferredWipeout: true
            )
        }


        success {

            echo ''
            echo '================================================'
            echo '        DESTROY PIPELINE SUCCESSFUL'
            echo '================================================'

            echo "Environment : ${params.ENVIRONMENT}"

            echo "Build       : ${env.BUILD_NUMBER}"

            echo "Region      : ${params.AWS_REGION}"

            echo ''
            echo 'Terraform infrastructure and backend cleanup completed.'
            echo '================================================'
        }


        failure {

            echo ''
            echo '================================================'
            echo '        DESTROY PIPELINE FAILED'
            echo '================================================'

            echo "Environment : ${params.ENVIRONMENT}"

            echo "Build       : ${env.BUILD_NUMBER}"

            echo "Region      : ${params.AWS_REGION}"

            echo ''

            echo 'The pipeline stopped at the failed stage.'

            echo ''
            echo 'IMPORTANT:'

            echo 'The Terraform backend is protected until'
            echo 'Terraform destruction and verification succeed.'

            echo ''

            echo 'Check the failed stage in the Jenkins console.'

            echo '================================================'
        }


        aborted {

            echo ''
            echo '================================================'
            echo '        DESTROY PIPELINE ABORTED'
            echo '================================================'

            echo "Environment : ${params.ENVIRONMENT}"

            echo "Build       : ${env.BUILD_NUMBER}"

            echo "Region      : ${params.AWS_REGION}"

            echo ''
            echo 'The pipeline was manually aborted.'
            echo '================================================'
        }
    }
}
