pipeline {

    agent any

    // ================================================================
    // PIPELINE OPTIONS
    // ================================================================

    options {
        timestamps()
        ansiColor('xterm')
        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                daysToKeepStr: '30',
                numToKeepStr: '50'
            )
        )

        timeout(
            time: 120,
            unit: 'MINUTES'
        )
    }

    // ================================================================
    // PARAMETERS
    // ================================================================

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: [
                'dev',
                'qa',
                'stage',
                'prod'
            ],
            description: 'Terraform environment to destroy'
        )

        booleanParam(
            name: 'DELETE_TERRAFORM_BACKEND',
            defaultValue: true,
            description: 'Delete Terraform S3 state bucket and DynamoDB lock table after terraform destroy'
        )
    }

    // ================================================================
    // ENVIRONMENT
    // ================================================================

    environment {

        // ------------------------------------------------------------
        // GITHUB
        // ------------------------------------------------------------

        GITHUB_CREDENTIALS = 'github-creds'

        TERRAFORM_REPO = 'https://github.com/FAIZANSHEIKH223/terraform-aws-infra.git'
        TERRAFORM_BRANCH = 'main'
        TERRAFORM_DIR = 'terraform-infra'

        // ------------------------------------------------------------
        // AWS
        // ------------------------------------------------------------

        AWS_CREDENTIALS = 'aws-creds'
        AWS_DEFAULT_REGION = 'us-east-1'

        // ------------------------------------------------------------
        // TERRAFORM BACKEND
        // ------------------------------------------------------------

        TF_STATE_BUCKET = 'terraform-state-faizan-001'
        TF_STATE_KEY = 'terraform.tfstate'
        TF_LOCK_TABLE = 'terraform-locks'

        TF_IN_AUTOMATION = 'true'
        TF_INPUT = 'false'
    }

    // ================================================================
    // STAGES
    // ================================================================

    stages {

        // ============================================================
        // 1 - CHECKOUT TERRAFORM
        // ============================================================

        stage('1 - Checkout Terraform Repository') {

            steps {

                echo '================================================'
                echo 'CHECKOUT TERRAFORM REPOSITORY'
                echo '================================================'

                dir("${TERRAFORM_DIR}") {

                    deleteDir()

                    git(
                        branch: "${TERRAFORM_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${TERRAFORM_REPO}"
                    )
                }
            }
        }

        // ============================================================
        // 2 - VERIFY AWS CLI
        // ============================================================

        stage('2 - Verify AWS CLI') {

            steps {

                sh(
                    label: 'Verify AWS CLI',
                    script: '''#!/usr/bin/env bash

set -euo pipefail

echo "================================================"
echo "VERIFYING AWS CLI"
echo "================================================"

command -v aws

aws --version
'''
                )
            }
        }

        // ============================================================
        // 3 - VERIFY TERRAFORM
        // ============================================================

        stage('3 - Verify Terraform') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    sh(
                        label: 'Verify Terraform',
                        script: '''#!/usr/bin/env bash

set -euo pipefail

echo "================================================"
echo "VERIFYING TERRAFORM"
echo "================================================"

command -v terraform

terraform version
'''
                    )
                }
            }
        }

        // ============================================================
        // 4 - VERIFY TERRAFORM ENVIRONMENT
        // ============================================================

        stage('4 - Verify Terraform Environment') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    sh(
                        label: 'Verify Terraform environment',
                        script: '''#!/usr/bin/env bash

set -euo pipefail

echo "================================================"
echo "VERIFYING TERRAFORM ENVIRONMENT"
echo "================================================"

ENV_DIR="environments/${ENVIRONMENT}"

echo "Environment : ${ENVIRONMENT}"
echo "Directory   : ${ENV_DIR}"

if [ ! -d "${ENV_DIR}" ]; then
    echo "ERROR: Terraform environment directory does not exist."
    echo "${ENV_DIR}"
    exit 1
fi

if [ ! -f "${ENV_DIR}/terraform.tfvars" ]; then
    echo "ERROR: terraform.tfvars does not exist."
    echo "${ENV_DIR}/terraform.tfvars"
    exit 1
fi

echo ""
echo "Terraform environment verified successfully."
'''
                    )
                }
            }
        }

        // ============================================================
        // 5 - VERIFY AWS CREDENTIALS
        // ============================================================

        stage('5 - Verify AWS Credentials') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh(
                        label: 'Verify AWS credentials',
                        script: '''#!/usr/bin/env bash

set -euo pipefail

echo "================================================"
echo "VERIFYING AWS CREDENTIALS"
echo "================================================"

aws sts get-caller-identity \
    --region "${AWS_DEFAULT_REGION}"

echo ""
echo "AWS credentials are valid."
'''
                    )
                }
            }
        }

        // ============================================================
        // 6 - VERIFY S3 BACKEND
        // ============================================================

        stage('6 - Verify Terraform S3 Backend') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh(
                        label: 'Verify Terraform S3 backend',
                        script: '''#!/usr/bin/env bash

set -euo pipefail

echo "================================================"
echo "VERIFYING TERRAFORM S3 BACKEND"
echo "================================================"

echo "Bucket : ${TF_STATE_BUCKET}"
echo "Key    : ${TF_STATE_KEY}"
echo "Region : ${AWS_DEFAULT_REGION}"

if aws s3api head-bucket \
    --bucket "${TF_STATE_BUCKET}" \
    --region "${AWS_DEFAULT_REGION}" \
    > /dev/null 2>&1
then

    echo "Terraform S3 bucket exists."

else

    echo "ERROR: Terraform S3 bucket does not exist."
    echo "Bucket: ${TF_STATE_BUCKET}"
    exit 1

fi
'''
                    )
                }
            }
        }

        // ============================================================
        // 7 - VERIFY DYNAMODB
        // ============================================================

        stage('7 - Verify DynamoDB Lock Table') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh(
                        label: 'Verify DynamoDB lock table',
                        script: '''#!/usr/bin/env bash

set -euo pipefail

echo "================================================"
echo "VERIFYING DYNAMODB LOCK TABLE"
echo "================================================"

echo "Table  : ${TF_LOCK_TABLE}"
echo "Region : ${AWS_DEFAULT_REGION}"

if aws dynamodb describe-table \
    --table-name "${TF_LOCK_TABLE}" \
    --region "${AWS_DEFAULT_REGION}" \
    > /dev/null 2>&1
then

    echo "DynamoDB lock table exists."

else

    echo "ERROR: DynamoDB lock table does not exist."
    echo "Table: ${TF_LOCK_TABLE}"
    exit 1

fi

TABLE_STATUS="$(
    aws dynamodb describe-table \
        --table-name "${TF_LOCK_TABLE}" \
        --region "${AWS_DEFAULT_REGION}" \
        --query 'Table.TableStatus' \
        --output text
)"

echo "DynamoDB status: ${TABLE_STATUS}"

if [ "${TABLE_STATUS}" != "ACTIVE" ]; then
    echo "ERROR: DynamoDB table is not ACTIVE."
    exit 1
fi
'''
                    )
                }
            }
        }

        // ============================================================
        // 8 - TERRAFORM INIT
        // ============================================================

        stage('8 - Terraform Init') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh(
                            label: 'Terraform init',
                            script: '''#!/usr/bin/env bash

set -euo pipefail

echo "================================================"
echo "TERRAFORM INIT"
echo "================================================"

terraform init \
    -input=false \
    -reconfigure \
    -backend-config="bucket=${TF_STATE_BUCKET}" \
    -backend-config="key=${TF_STATE_KEY}" \
    -backend-config="region=${AWS_DEFAULT_REGION}" \
    -backend-config="dynamodb_table=${TF_LOCK_TABLE}" \
    -backend-config="encrypt=true"

echo ""
echo "Terraform initialization completed."
'''
                        )
                    }
                }
            }
        }

        // ============================================================
        // 9 - TERRAFORM VALIDATE
        // ============================================================

        stage('9 - Terraform Validate') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    sh(
                        label: 'Terraform validate',
                        script: '''#!/usr/bin/env bash

set -euo pipefail

echo "================================================"
echo "TERRAFORM VALIDATE"
echo "================================================"

terraform validate

echo ""
echo "Terraform configuration is valid."
'''
                    )
                }
            }
        }

        // ============================================================
        // 10 - VERIFY TERRAFORM STATE
        // ============================================================

        stage('10 - Verify Terraform State') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh(
                        label: 'Verify Terraform state',
                        script: '''#!/usr/bin/env bash

set -euo pipefail

echo "================================================"
echo "VERIFYING TERRAFORM STATE"
echo "================================================"

if aws s3api head-object \
    --bucket "${TF_STATE_BUCKET}" \
    --key "${TF_STATE_KEY}" \
    --region "${AWS_DEFAULT_REGION}" \
    > /dev/null 2>&1
then

    echo "Terraform state file exists."
    echo "s3://${TF_STATE_BUCKET}/${TF_STATE_KEY}"

else

    echo "WARNING: Terraform state file does not exist."
    echo "Terraform destroy cannot continue safely."
    exit 1

fi
'''
                    )
                }
            }
        }

        // ============================================================
        // 11 - VERIFY NO ACTIVE TERRAFORM LOCK
        // ============================================================

        stage('11 - Verify No Active Terraform Lock') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh(
                        label: 'Verify Terraform lock',
                        script: '''#!/usr/bin/env bash

set -euo pipefail

echo "================================================"
echo "CHECKING TERRAFORM LOCK"
echo "================================================"

LOCK_ID="${TF_STATE_BUCKET}/${TF_STATE_KEY}"

echo "LockID:"
echo "${LOCK_ID}"

echo ""
echo "Querying DynamoDB..."

LOCK_JSON="$(
    aws dynamodb get-item \
        --table-name "${TF_LOCK_TABLE}" \
        --key "{\"LockID\":{\"S\":\"${LOCK_ID}\"}}" \
        --consistent-read \
        --region "${AWS_DEFAULT_REGION}" \
        --output json
)"

echo "DynamoDB response:"
echo "${LOCK_JSON}"

ITEM_COUNT="$(
    echo "${LOCK_JSON}" |
    python3 -c '
import json
import sys

data = json.load(sys.stdin)
print(1 if data.get("Item") else 0)
'
)"

if [ "${ITEM_COUNT}" -eq 1 ]; then

    echo ""
    echo "================================================"
    echo "ACTIVE TERRAFORM LOCK DETECTED"
    echo "================================================"

    echo "${LOCK_JSON}"

    echo ""
    echo "The pipeline will NOT delete the lock."
    echo "The pipeline will NOT forcefully remove the lock."
    echo ""
    echo "Wait for the other Terraform operation to finish."
    exit 1

fi

echo ""
echo "No active Terraform lock detected."
echo "Safe to continue."
'''
                    )
                }
            }
        }

        // ============================================================
        // 12 - TERRAFORM STATE LIST
        // ============================================================

        stage('12 - Inspect Terraform State') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    sh(
                        label: 'Inspect Terraform state',
                        script: '''#!/usr/bin/env bash

set -euo pipefail

echo "================================================"
echo "TERRAFORM STATE"
echo "================================================"

terraform state list || true

echo ""
echo "Terraform state inspection completed."
'''
                    )
                }
            }
        }

        // ============================================================
        // 13 - TERRAFORM DESTROY PLAN
        // ============================================================

        stage('13 - Terraform Destroy Plan') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh(
                            label: 'Terraform destroy plan',
                            script: '''#!/usr/bin/env bash

set -euo pipefail

echo "================================================"
echo "TERRAFORM DESTROY PLAN"
echo "================================================"

rm -f destroy.tfplan

terraform plan \
    -destroy \
    -input=false \
    -var-file="environments/${ENVIRONMENT}/terraform.tfvars" \
    -out="destroy.tfplan"

if [ ! -f destroy.tfplan ]; then
    echo "ERROR: Terraform destroy plan was not created."
    exit 1
fi

echo ""
echo "Terraform destroy plan created successfully."
'''
                        )
                    }
                }
            }
        }

        // ============================================================
        // 14 - TERRAFORM DESTROY
        // ============================================================

        stage('14 - Terraform Destroy') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh(
                            label: 'Terraform destroy',
                            script: '''#!/usr/bin/env bash

set -euo pipefail

echo "================================================"
echo "TERRAFORM DESTROY"
echo "================================================"

if [ ! -f destroy.tfplan ]; then
    echo "ERROR: destroy.tfplan does not exist."
    exit 1
fi

terraform apply \
    -input=false \
    -auto-approve \
    destroy.tfplan

echo ""
echo "Terraform destroy completed successfully."
'''
                        )
                    }
                }
            }
        }

        // ============================================================
        // 15 - VERIFY TERRAFORM RESOURCES DESTROYED
        // ============================================================

        stage('15 - Verify Terraform Destruction') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    sh(
                        label: 'Verify Terraform destruction',
                        script: '''#!/usr/bin/env bash

set -euo pipefail

echo "================================================"
echo "VERIFYING TERRAFORM DESTRUCTION"
echo "================================================"

REMAINING="$(
    terraform state list 2>/dev/null || true
)"

if [ -n "${REMAINING}" ]; then

    echo "WARNING: Terraform state still contains resources:"
    echo "${REMAINING}"

else

    echo "Terraform state contains no managed resources."

fi

echo ""
echo "Terraform destruction verification completed."
'''
                    )
                }
            }
        }

        // ============================================================
        // 16 - DELETE TERRAFORM STATE OBJECT
        // ============================================================

        stage('16 - Delete Terraform State Object') {

            when {
                expression {
                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh(
                        label: 'Delete Terraform state object',
                        script: '''#!/usr/bin/env bash

set -euo pipefail

echo "================================================"
echo "DELETING TERRAFORM STATE OBJECT"
echo "================================================"

if aws s3api head-object \
    --bucket "${TF_STATE_BUCKET}" \
    --key "${TF_STATE_KEY}" \
    --region "${AWS_DEFAULT_REGION}" \
    > /dev/null 2>&1
then

    aws s3api delete-object \
        --bucket "${TF_STATE_BUCKET}" \
        --key "${TF_STATE_KEY}" \
        --region "${AWS_DEFAULT_REGION}"

    echo "Terraform state object deleted."

else

    echo "Terraform state object does not exist."
fi
'''
                    )
                }
            }
        }

        // ============================================================
        // 17 - DELETE ALL S3 OBJECT VERSIONS
        // ============================================================

        stage('17 - Delete All S3 Object Versions') {

            when {
                expression {
                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh(
                        label: 'Delete all S3 versions',
                        script: '''#!/usr/bin/env bash

set -euo pipefail

echo "================================================"
echo "DELETING ALL S3 OBJECT VERSIONS"
echo "================================================"

while true; do

    OBJECTS="$(
        aws s3api list-object-versions \
            --bucket "${TF_STATE_BUCKET}" \
            --region "${AWS_DEFAULT_REGION}" \
            --output json
    )"

    DELETE_JSON="$(
        echo "${OBJECTS}" |
        python3 -c '
import json
import sys

data = json.load(sys.stdin)

objects = []

for item in data.get("Versions", []):
    objects.append({
        "Key": item["Key"],
        "VersionId": item["VersionId"]
    })

for item in data.get("DeleteMarkers", []):
    objects.append({
        "Key": item["Key"],
        "VersionId": item["VersionId"]
    })

print(json.dumps({"Objects": objects, "Quiet": True}))
'
    )"

    OBJECT_COUNT="$(
        echo "${DELETE_JSON}" |
        python3 -c '
import json
import sys

data = json.load(sys.stdin)
print(len(data.get("Objects", [])))
'
    )"

    if [ "${OBJECT_COUNT}" -eq 0 ]; then
        echo "No remaining S3 object versions."
        break
    fi

    echo "Deleting ${OBJECT_COUNT} object versions/delete markers."

    aws s3api delete-objects \
        --bucket "${TF_STATE_BUCKET}" \
        --delete "${DELETE_JSON}" \
        --region "${AWS_DEFAULT_REGION}"

done

echo ""
echo "All S3 object versions and delete markers removed."
'''
                    )
                }
            }
        }

        // ============================================================
        // 18 - VERIFY S3 BUCKET EMPTY
        // ============================================================

        stage('18 - Verify S3 Bucket Empty') {

            when {
                expression {
                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh(
                        label: 'Verify S3 bucket empty',
                        script: '''#!/usr/bin/env bash

set -euo pipefail

echo "================================================"
echo "VERIFYING S3 BUCKET IS EMPTY"
echo "================================================"

REMAINING="$(
    aws s3api list-object-versions \
        --bucket "${TF_STATE_BUCKET}" \
        --region "${AWS_DEFAULT_REGION}" \
        --query 'length(Versions[]) + length(DeleteMarkers[])' \
        --output text
)"

if [ "${REMAINING}" != "0" ]; then
    echo "ERROR: S3 bucket still contains objects or versions."
    echo "Remaining count: ${REMAINING}"
    exit 1
fi

echo "S3 bucket is empty."
'''
                    )
                }
            }
        }

        // ============================================================
        // 19 - DELETE S3 BUCKET
        // ============================================================

        stage('19 - Delete Terraform S3 Backend Bucket') {

            when {
                expression {
                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh(
                        label: 'Delete Terraform S3 bucket',
                        script: '''#!/usr/bin/env bash

set -euo pipefail

echo "================================================"
echo "DELETING TERRAFORM S3 BACKEND BUCKET"
echo "================================================"

if aws s3api head-bucket \
    --bucket "${TF_STATE_BUCKET}" \
    --region "${AWS_DEFAULT_REGION}" \
    > /dev/null 2>&1
then

    aws s3api delete-bucket \
        --bucket "${TF_STATE_BUCKET}" \
        --region "${AWS_DEFAULT_REGION}"

    echo "S3 backend bucket deletion requested."

else

    echo "S3 backend bucket already does not exist."
fi
'''
                    )
                }
            }
        }

        // ============================================================
        // 20 - VERIFY S3 BUCKET DELETED
        // ============================================================

        stage('20 - Verify S3 Bucket Deleted') {

            when {
                expression {
                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh(
                        label: 'Verify S3 bucket deleted',
                        script: '''#!/usr/bin/env bash

set -euo pipefail

echo "================================================"
echo "VERIFYING S3 BUCKET DELETION"
echo "================================================"

if aws s3api head-bucket \
    --bucket "${TF_STATE_BUCKET}" \
    --region "${AWS_DEFAULT_REGION}" \
    > /dev/null 2>&1
then

    echo "ERROR: S3 bucket still exists."
    exit 1

else

    echo "S3 bucket has been deleted."

fi
'''
                    )
                }
            }
        }

        // ============================================================
        // 21 - DELETE DYNAMODB TABLE
        // ============================================================

        stage('21 - Delete DynamoDB Lock Table') {

            when {
                expression {
                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh(
                        label: 'Delete DynamoDB lock table',
                        script: '''#!/usr/bin/env bash

set -euo pipefail

echo "================================================"
echo "DELETING DYNAMODB LOCK TABLE"
echo "================================================"

if aws dynamodb describe-table \
    --table-name "${TF_LOCK_TABLE}" \
    --region "${AWS_DEFAULT_REGION}" \
    > /dev/null 2>&1
then

    aws dynamodb delete-table \
        --table-name "${TF_LOCK_TABLE}" \
        --region "${AWS_DEFAULT_REGION}"

    echo "DynamoDB deletion requested."

else

    echo "DynamoDB lock table already does not exist."
fi
'''
                    )
                }
            }
        }

        // ============================================================
        // 22 - VERIFY DYNAMODB TABLE DELETED
        // ============================================================

        stage('22 - Verify DynamoDB Table Deleted') {

            when {
                expression {
                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh(
                        label: 'Verify DynamoDB deletion',
                        script: '''#!/usr/bin/env bash

set -euo pipefail

echo "================================================"
echo "VERIFYING DYNAMODB DELETION"
echo "================================================"

echo "Waiting for DynamoDB table deletion..."

aws dynamodb wait table-not-exists \
    --table-name "${TF_LOCK_TABLE}" \
    --region "${AWS_DEFAULT_REGION}"

if aws dynamodb describe-table \
    --table-name "${TF_LOCK_TABLE}" \
    --region "${AWS_DEFAULT_REGION}" \
    > /dev/null 2>&1
then

    echo "ERROR: DynamoDB table still exists."
    exit 1

else

    echo "DynamoDB lock table has been deleted."

fi
'''
                    )
                }
            }
        }

        // ============================================================
        // 23 - FINAL VERIFICATION
        // ============================================================

        stage('23 - Final Destruction Verification') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    script {

                        sh(
                            label: 'Final AWS verification',
                            script: '''#!/usr/bin/env bash

set -euo pipefail

echo "================================================"
echo "FINAL DESTRUCTION VERIFICATION"
echo "================================================"

echo ""
echo "AWS Account:"
aws sts get-caller-identity \
    --region "${AWS_DEFAULT_REGION}"

echo ""
echo "Environment:"
echo "${ENVIRONMENT}"

echo ""
echo "Terraform backend deletion requested:"
echo "${DELETE_TERRAFORM_BACKEND:-true}"

echo ""
echo "Final verification completed."
'''
                        )

                        if (params.DELETE_TERRAFORM_BACKEND) {

                            echo '================================================'
                            echo 'TERRAFORM BACKEND DELETION: ENABLED'
                            echo '================================================'

                        } else {

                            echo '================================================'
                            echo 'TERRAFORM BACKEND DELETION: DISABLED'
                            echo '================================================'

                        }
                    }
                }
            }
        }

        // ============================================================
        // 24 - FINAL DESTRUCTION REPORT
        // ============================================================

        stage('24 - Final Destruction Report') {

            steps {

                script {

                    echo ''
                    echo '================================================'
                    echo '       FINAL DESTRUCTION REPORT'
                    echo '================================================'
                    echo ''

                    echo "Environment       : ${env.ENVIRONMENT}"
                    echo "AWS Region        : ${env.AWS_DEFAULT_REGION}"
                    echo "Terraform Repo    : ${env.TERRAFORM_REPO}"
                    echo "Terraform Dir     : ${env.TERRAFORM_DIR}"
                    echo ''

                    echo "Terraform Backend:"
                    echo "S3 Bucket         : ${env.TF_STATE_BUCKET}"
                    echo "State Key         : ${env.TF_STATE_KEY}"
                    echo "DynamoDB Table    : ${env.TF_LOCK_TABLE}"
                    echo ''

                    if (params.DELETE_TERRAFORM_BACKEND) {

                        echo "Backend Action    : DELETED"

                    } else {

                        echo "Backend Action    : PRESERVED"

                    }

                    echo ''
                    echo 'Terraform infrastructure destruction completed.'
                    echo ''
                    echo '================================================'
                    echo '       DESTRUCTION COMPLETE'
                    echo '================================================'
                }
            }
        }
    }

    // ================================================================
    // POST ACTIONS
    // ================================================================

    post {

        success {

            echo ''
            echo '================================================'
            echo '       DESTROY PIPELINE SUCCESS'
            echo '================================================'
            echo ''

            echo "Environment : ${env.ENVIRONMENT}"
            echo "Build       : ${env.BUILD_NUMBER}"
            echo "Region      : ${env.AWS_DEFAULT_REGION}"
            echo ''

            echo 'Terraform infrastructure : DESTROYED'

            if (params.DELETE_TERRAFORM_BACKEND) {

                echo 'S3 state bucket          : DELETED'
                echo 'Terraform state file     : DELETED'
                echo 'DynamoDB lock table      : DELETED'

            } else {

                echo 'S3 state bucket          : PRESERVED'
                echo 'Terraform state file     : PRESERVED'
                echo 'DynamoDB lock table      : PRESERVED'
            }

            echo ''
            echo '================================================'
            echo '       COMPLETE DESTRUCTION SUCCESS'
            echo '================================================'
        }

        failure {

            echo ''
            echo '================================================'
            echo '       DESTROY PIPELINE FAILED'
            echo '================================================'
            echo ''

            echo "Environment : ${env.ENVIRONMENT}"
            echo "Build       : ${env.BUILD_NUMBER}"
            echo "Region      : ${env.AWS_DEFAULT_REGION}"
            echo ''

            echo 'The pipeline stopped because a destruction or'
            echo 'verification step failed.'

            echo ''
            echo 'IMPORTANT:'
            echo 'If Terraform destroy failed, the backend was NOT'
            echo 'deleted by the later backend-deletion stages.'

            echo ''
            echo 'Check the failed stage above for the exact error.'

            echo '================================================'
        }

        aborted {

            echo ''
            echo '================================================'
            echo '       DESTROY PIPELINE ABORTED'
            echo '================================================'
            echo ''

            echo "Environment : ${env.ENVIRONMENT}"
            echo "Build       : ${env.BUILD_NUMBER}"
            echo ''

            echo 'The Jenkins build was manually aborted.'

            echo '================================================'
        }

        always {

            echo ''
            echo '================================================'
            echo '       DESTROY PIPELINE FINISHED'
            echo '================================================'
            echo ''

            echo "Environment : ${env.ENVIRONMENT}"
            echo "Build       : ${env.BUILD_NUMBER}"

            echo ''
            echo 'Pipeline execution finished.'
            echo '================================================'
        }
    }
}
