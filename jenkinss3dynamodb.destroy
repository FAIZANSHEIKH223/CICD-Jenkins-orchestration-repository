pipeline {

    agent any

    // ================================================================
    // PIPELINE OPTIONS
    // ================================================================

    options {

        timestamps()

        ansiColor('xterm')

        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                daysToKeepStr: '30',
                numToKeepStr: '50'
            )
        )

        timeout(
            time: 120,
            unit: 'MINUTES'
        )
    }

    // ================================================================
    // PARAMETERS
    // ================================================================

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: [
                'dev',
                'qa',
                'stage',
                'prod'
            ],
            description: 'Terraform environment to destroy'
        )

        string(
            name: 'AWS_REGION',
            defaultValue: 'us-east-1',
            description: 'AWS region'
        )

        string(
            name: 'TERRAFORM_BACKEND_BUCKET',
            defaultValue: 'terraform-state-faizan-001',
            description: 'S3 bucket containing Terraform remote state'
        )

        string(
            name: 'TERRAFORM_STATE_KEY',
            defaultValue: 'terraform.tfstate',
            description: 'Terraform state object key'
        )

        string(
            name: 'DYNAMODB_LOCK_TABLE',
            defaultValue: 'terraform-lock',
            description: 'DynamoDB table used for Terraform state locking'
        )

        string(
            name: 'AWS_CREDENTIALS_ID',
            defaultValue: 'aws-creds',
            description: 'Jenkins AWS credentials ID'
        )

        booleanParam(
            name: 'DELETE_TERRAFORM_BACKEND',
            defaultValue: true,
            description: 'Delete Terraform state, all S3 object versions, S3 backend bucket and DynamoDB lock table'
        )

        booleanParam(
            name: 'AUTO_APPROVE_DESTROY',
            defaultValue: true,
            description: 'Automatically approve terraform destroy'
        )
    }

    // ================================================================
    // ENVIRONMENT
    // ================================================================

    environment {

        AWS_DEFAULT_REGION = "${params.AWS_REGION}"

        TF_IN_AUTOMATION = "true"

        TF_INPUT = "false"
    }

    // ================================================================
    // STAGES
    // ================================================================

    stages {

        // ============================================================
        // 01 - START
        // ============================================================

        stage('01 - Start Destroy Pipeline') {

            steps {

                echo ''
                echo '================================================'
                echo '       TERRAFORM DESTROY PIPELINE'
                echo '================================================'
                echo "Environment              : ${params.ENVIRONMENT}"
                echo "AWS Region               : ${params.AWS_REGION}"
                echo "Terraform Backend Bucket : ${params.TERRAFORM_BACKEND_BUCKET}"
                echo "Terraform State Key      : ${params.TERRAFORM_STATE_KEY}"
                echo "DynamoDB Lock Table      : ${params.DYNAMODB_LOCK_TABLE}"
                echo "Delete Backend           : ${params.DELETE_TERRAFORM_BACKEND}"
                echo '================================================'
                echo ''
            }
        }

        // ============================================================
        // 02 - CHECK TOOLS
        // ============================================================

        stage('02 - Check Required Tools') {

            steps {

                sh '''
                    set -eu

                    echo "==============================================="
                    echo "CHECKING REQUIRED TOOLS"
                    echo "==============================================="

                    command -v terraform >/dev/null 2>&1
                    echo "Terraform:"
                    terraform version

                    command -v aws >/dev/null 2>&1
                    echo ""
                    echo "AWS CLI:"
                    aws --version

                    command -v jq >/dev/null 2>&1
                    echo ""
                    echo "jq:"
                    jq --version

                    echo ""
                    echo "Required tools are available."
                    echo "==============================================="
                '''
            }
        }

        // ============================================================
        // 03 - AWS AUTHENTICATION
        // ============================================================

        stage('03 - Verify AWS Authentication') {

            steps {

                withCredentials(
                    [
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${params.AWS_CREDENTIALS_ID}",
                            accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                            secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                        ]
                    ]
                ) {

                    sh '''
                        set -eu

                        echo "==============================================="
                        echo "VERIFYING AWS AUTHENTICATION"
                        echo "==============================================="

                        aws sts get-caller-identity

                        echo ""
                        echo "AWS Region:"
                        echo "${AWS_DEFAULT_REGION}"

                        echo "==============================================="
                    '''
                }
            }
        }

        // ============================================================
        // 04 - CHECK S3 BACKEND BUCKET
        // ============================================================

        stage('04 - Check Terraform S3 Backend') {

            steps {

                withCredentials(
                    [
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${params.AWS_CREDENTIALS_ID}",
                            accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                            secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                        ]
                    ]
                ) {

                    sh '''
                        set -eu

                        echo "==============================================="
                        echo "CHECKING TERRAFORM S3 BACKEND"
                        echo "==============================================="

                        if aws s3api head-bucket \
                            --bucket "${TERRAFORM_BACKEND_BUCKET}" \
                            --region "${AWS_DEFAULT_REGION}" >/dev/null 2>&1
                        then
                            echo "S3 backend bucket exists:"
                            echo "${TERRAFORM_BACKEND_BUCKET}"
                        else
                            echo "S3 backend bucket does not exist."
                            echo "Terraform backend deletion will be skipped."
                        fi

                        echo "==============================================="
                    '''
                }
            }
        }

        // ============================================================
        // 05 - CHECK DYNAMODB TABLE
        // ============================================================

        stage('05 - Check DynamoDB Lock Table') {

            steps {

                withCredentials(
                    [
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${params.AWS_CREDENTIALS_ID}",
                            accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                            secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                        ]
                    ]
                ) {

                    sh '''
                        set -eu

                        echo "==============================================="
                        echo "CHECKING DYNAMODB LOCK TABLE"
                        echo "==============================================="

                        if aws dynamodb describe-table \
                            --table-name "${DYNAMODB_LOCK_TABLE}" \
                            --region "${AWS_DEFAULT_REGION}" >/dev/null 2>&1
                        then
                            echo "DynamoDB lock table exists:"
                            echo "${DYNAMODB_LOCK_TABLE}"
                        else
                            echo "DynamoDB lock table does not exist."
                        fi

                        echo "==============================================="
                    '''
                }
            }
        }

        // ============================================================
        // 06 - TERRAFORM INIT
        // ============================================================

        stage('06 - Terraform Init') {

            steps {

                dir('terraform') {

                    sh '''
                        set -eu

                        echo "==============================================="
                        echo "TERRAFORM INIT"
                        echo "==============================================="

                        if [ -f "environments/${ENVIRONMENT}/terraform.tfvars" ]; then

                            echo "Using environment:"
                            echo "${ENVIRONMENT}"

                            terraform init \
                                -input=false \
                                -reconfigure

                        else

                            echo "Environment tfvars file not found:"
                            echo "environments/${ENVIRONMENT}/terraform.tfvars"

                            echo "Searching Terraform configuration..."

                            terraform init \
                                -input=false \
                                -reconfigure

                        fi

                        echo "==============================================="
                    '''
                }
            }
        }

        // ============================================================
        // 07 - TERRAFORM VALIDATE
        // ============================================================

        stage('07 - Terraform Validate') {

            steps {

                dir('terraform') {

                    sh '''
                        set -eu

                        echo "==============================================="
                        echo "TERRAFORM VALIDATE"
                        echo "==============================================="

                        terraform validate

                        echo "Terraform configuration is valid."
                        echo "==============================================="
                    '''
                }
            }
        }

        // ============================================================
        // 08 - TERRAFORM DESTROY
        // ============================================================

        stage('08 - Terraform Destroy Infrastructure') {

            steps {

                dir('terraform') {

                    script {

                        if (params.AUTO_APPROVE_DESTROY) {

                            sh '''
                                set -eu

                                echo "==============================================="
                                echo "TERRAFORM DESTROY"
                                echo "==============================================="

                                if [ -f "environments/${ENVIRONMENT}/terraform.tfvars" ]; then

                                    terraform destroy \
                                        -auto-approve \
                                        -input=false \
                                        -var-file="environments/${ENVIRONMENT}/terraform.tfvars"

                                else

                                    echo "No environment tfvars file found."
                                    echo "Running terraform destroy using initialized configuration."

                                    terraform destroy \
                                        -auto-approve \
                                        -input=false

                                fi

                                echo "Terraform infrastructure destruction completed."
                                echo "==============================================="
                            '''

                        } else {

                            sh '''
                                set -eu

                                echo "==============================================="
                                echo "TERRAFORM DESTROY"
                                echo "==============================================="

                                if [ -f "environments/${ENVIRONMENT}/terraform.tfvars" ]; then

                                    terraform destroy \
                                        -input=false \
                                        -var-file="environments/${ENVIRONMENT}/terraform.tfvars"

                                else

                                    terraform destroy \
                                        -input=false

                                fi

                                echo "Terraform infrastructure destruction completed."
                                echo "==============================================="
                            '''
                        }
                    }
                }
            }
        }

        // ============================================================
        // 09 - WAIT FOR TERRAFORM LOCK RELEASE
        // ============================================================

        stage('09 - Wait For Terraform Lock Release') {

            steps {

                withCredentials(
                    [
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${params.AWS_CREDENTIALS_ID}",
                            accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                            secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                        ]
                    ]
                ) {

                    sh '''
                        set -eu

                        echo "==============================================="
                        echo "WAITING FOR TERRAFORM LOCK RELEASE"
                        echo "==============================================="

                        LOCK_KEY="${TERRAFORM_BACKEND_BUCKET}/${TERRAFORM_STATE_KEY}"

                        echo "Expected LockID:"
                        echo "${LOCK_KEY}"

                        MAX_ATTEMPTS=12
                        ATTEMPT=1

                        while [ "${ATTEMPT}" -le "${MAX_ATTEMPTS}" ]; do

                            echo ""
                            echo "Lock check ${ATTEMPT}/${MAX_ATTEMPTS}"

                            LOCK_ITEM=$(aws dynamodb get-item \
                                --table-name "${DYNAMODB_LOCK_TABLE}" \
                                --key "{\"LockID\":{\"S\":\"${LOCK_KEY}\"}}" \
                                --region "${AWS_DEFAULT_REGION}" \
                                --output json 2>/dev/null || true)

                            if [ -z "${LOCK_ITEM}" ]; then
                                LOCK_ITEM='{}'
                            fi

                            LOCK_COUNT=$(echo "${LOCK_ITEM}" | jq '.Item | length')

                            if [ "${LOCK_COUNT}" -eq 0 ]; then

                                echo "Terraform lock is not present."
                                echo "Lock released successfully."

                                break

                            else

                                echo "Terraform lock still exists."
                                echo "Waiting 10 seconds..."

                                if [ "${ATTEMPT}" -eq "${MAX_ATTEMPTS}" ]; then
                                    echo "ERROR: Terraform lock still exists."
                                    exit 1
                                fi

                                sleep 10
                            fi

                            ATTEMPT=$((ATTEMPT + 1))

                        done

                        echo "==============================================="
                    '''
                }
            }
        }

        // ============================================================
        // 10 - VERIFY LOCK ONE MORE TIME
        // ============================================================

        stage('10 - Verify No Active Terraform Lock') {

            when {

                expression {
                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials(
                    [
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${params.AWS_CREDENTIALS_ID}",
                            accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                            secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                        ]
                    ]
                ) {

                    sh '''
                        set -eu

                        echo "==============================================="
                        echo "FINAL TERRAFORM LOCK CHECK"
                        echo "==============================================="

                        LOCK_KEY="${TERRAFORM_BACKEND_BUCKET}/${TERRAFORM_STATE_KEY}"

                        echo "LockID:"
                        echo "${LOCK_KEY}"

                        LOCK_ITEM=$(aws dynamodb get-item \
                            --table-name "${DYNAMODB_LOCK_TABLE}" \
                            --key "{\"LockID\":{\"S\":\"${LOCK_KEY}\"}}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            --output json 2>/dev/null || true)

                        if [ -z "${LOCK_ITEM}" ]; then
                            LOCK_ITEM='{}'
                        fi

                        echo ""
                        echo "DynamoDB response:"
                        echo "${LOCK_ITEM}"

                        ITEM_COUNT=$(echo "${LOCK_ITEM}" | jq '.Item | length')

                        if [ "${ITEM_COUNT}" -gt 0 ]; then
                            echo ""
                            echo "ERROR: ACTIVE TERRAFORM LOCK DETECTED."
                            echo "The backend will NOT be deleted."
                            exit 1
                        fi

                        echo ""
                        echo "No active Terraform lock detected."
                        echo "Safe to continue backend deletion."

                        echo "==============================================="
                    '''
                }
            }
        }

        // ============================================================
        // 11 - CHECK TERRAFORM STATE OBJECT
        // ============================================================

        stage('11 - Check Terraform State Object') {

            when {

                expression {
                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials(
                    [
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${params.AWS_CREDENTIALS_ID}",
                            accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                            secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                        ]
                    ]
                ) {

                    sh '''
                        set -eu

                        echo "==============================================="
                        echo "CHECKING TERRAFORM STATE OBJECT"
                        echo "==============================================="

                        if aws s3api head-object \
                            --bucket "${TERRAFORM_BACKEND_BUCKET}" \
                            --key "${TERRAFORM_STATE_KEY}" \
                            --region "${AWS_DEFAULT_REGION}" >/dev/null 2>&1
                        then

                            echo "Terraform state object exists:"
                            echo "s3://${TERRAFORM_BACKEND_BUCKET}/${TERRAFORM_STATE_KEY}"

                        else

                            echo "Terraform state object does not exist."

                        fi

                        echo "==============================================="
                    '''
                }
            }
        }

        // ============================================================
        // 12 - DELETE CURRENT STATE OBJECT
        // ============================================================

        stage('12 - Delete Terraform State Object') {

            when {

                expression {
                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials(
                    [
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${params.AWS_CREDENTIALS_ID}",
                            accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                            secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                        ]
                    ]
                ) {

                    sh '''
                        set -eu

                        echo "==============================================="
                        echo "DELETING CURRENT TERRAFORM STATE OBJECT"
                        echo "==============================================="

                        aws s3api delete-object \
                            --bucket "${TERRAFORM_BACKEND_BUCKET}" \
                            --key "${TERRAFORM_STATE_KEY}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            >/dev/null 2>&1 || true

                        echo "Current Terraform state object deletion requested."

                        echo "==============================================="
                    '''
                }
            }
        }

        // ============================================================
        // 13 - DELETE ALL S3 OBJECT VERSIONS
        // ============================================================

        stage('13 - Delete All S3 Object Versions') {

            when {

                expression {
                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials(
                    [
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${params.AWS_CREDENTIALS_ID}",
                            accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                            secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                        ]
                    ]
                ) {

                    sh '''
                        set -eu

                        echo "==============================================="
                        echo "DELETING ALL S3 OBJECT VERSIONS"
                        echo "==============================================="

                        if ! aws s3api head-bucket \
                            --bucket "${TERRAFORM_BACKEND_BUCKET}" \
                            --region "${AWS_DEFAULT_REGION}" >/dev/null 2>&1
                        then

                            echo "Bucket does not exist."
                            exit 0

                        fi

                        while true; do

                            VERSION_DATA=$(aws s3api list-object-versions \
                                --bucket "${TERRAFORM_BACKEND_BUCKET}" \
                                --region "${AWS_DEFAULT_REGION}" \
                                --output json)

                            DELETE_PAYLOAD=$(echo "${VERSION_DATA}" | jq -c '
                                [
                                    (.Versions // [])[] |
                                    {
                                        Key: .Key,
                                        VersionId: .VersionId
                                    }
                                ] +
                                [
                                    (.DeleteMarkers // [])[] |
                                    {
                                        Key: .Key,
                                        VersionId: .VersionId
                                    }
                                ]
                            ')

                            COUNT=$(echo "${DELETE_PAYLOAD}" | jq 'length')

                            if [ "${COUNT}" -eq 0 ]; then

                                echo "No object versions or delete markers remain."
                                break

                            fi

                            echo "Deleting ${COUNT} version/delete-marker entries..."

                            echo "${DELETE_PAYLOAD}" |
                            jq -c '{Objects: ., Quiet: true}' > /tmp/s3-delete.json

                            aws s3api delete-objects \
                                --bucket "${TERRAFORM_BACKEND_BUCKET}" \
                                --delete file:///tmp/s3-delete.json \
                                --region "${AWS_DEFAULT_REGION}"

                        done

                        rm -f /tmp/s3-delete.json

                        echo "All S3 object versions deleted."
                        echo "==============================================="
                    '''
                }
            }
        }

        // ============================================================
        // 14 - VERIFY S3 BUCKET EMPTY
        // ============================================================

        stage('14 - Verify S3 Bucket Empty') {

            when {

                expression {
                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials(
                    [
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${params.AWS_CREDENTIALS_ID}",
                            accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                            secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                        ]
                    ]
                ) {

                    sh '''
                        set -eu

                        echo "==============================================="
                        echo "VERIFYING S3 BUCKET IS EMPTY"
                        echo "==============================================="

                        if ! aws s3api head-bucket \
                            --bucket "${TERRAFORM_BACKEND_BUCKET}" \
                            --region "${AWS_DEFAULT_REGION}" >/dev/null 2>&1
                        then

                            echo "Bucket does not exist."
                            exit 0

                        fi

                        REMAINING=$(aws s3api list-object-versions \
                            --bucket "${TERRAFORM_BACKEND_BUCKET}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            --output json |
                            jq '((.Versions // []) + (.DeleteMarkers // [])) | length')

                        echo "Remaining objects/versions: ${REMAINING}"

                        if [ "${REMAINING}" -ne 0 ]; then

                            echo "ERROR: S3 bucket is not empty."
                            exit 1

                        fi

                        echo "S3 bucket is completely empty."

                        echo "==============================================="
                    '''
                }
            }
        }

        // ============================================================
        // 15 - DELETE S3 BACKEND BUCKET
        // ============================================================

        stage('15 - Delete Terraform S3 Backend Bucket') {

            when {

                expression {
                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials(
                    [
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${params.AWS_CREDENTIALS_ID}",
                            accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                            secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                        ]
                    ]
                ) {

                    sh '''
                        set -eu

                        echo "==============================================="
                        echo "DELETING TERRAFORM S3 BACKEND BUCKET"
                        echo "==============================================="

                        if aws s3api head-bucket \
                            --bucket "${TERRAFORM_BACKEND_BUCKET}" \
                            --region "${AWS_DEFAULT_REGION}" >/dev/null 2>&1
                        then

                            aws s3api delete-bucket \
                                --bucket "${TERRAFORM_BACKEND_BUCKET}" \
                                --region "${AWS_DEFAULT_REGION}"

                            echo "S3 backend bucket deletion requested."

                        else

                            echo "S3 backend bucket already does not exist."

                        fi

                        echo "==============================================="
                    '''
                }
            }
        }

        // ============================================================
        // 16 - VERIFY S3 BUCKET DELETED
        // ============================================================

        stage('16 - Verify S3 Bucket Deleted') {

            when {

                expression {
                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials(
                    [
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${params.AWS_CREDENTIALS_ID}",
                            accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                            secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                        ]
                    ]
                ) {

                    sh '''
                        set -eu

                        echo "==============================================="
                        echo "VERIFYING S3 BUCKET DELETION"
                        echo "==============================================="

                        if aws s3api head-bucket \
                            --bucket "${TERRAFORM_BACKEND_BUCKET}" \
                            --region "${AWS_DEFAULT_REGION}" >/dev/null 2>&1
                        then

                            echo "ERROR: S3 bucket still exists."
                            exit 1

                        fi

                        echo "S3 backend bucket successfully deleted."

                        echo "==============================================="
                    '''
                }
            }
        }

        // ============================================================
        // 17 - DELETE DYNAMODB LOCK TABLE
        // ============================================================

        stage('17 - Delete DynamoDB Lock Table') {

            when {

                expression {
                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials(
                    [
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${params.AWS_CREDENTIALS_ID}",
                            accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                            secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                        ]
                    ]
                ) {

                    sh '''
                        set -eu

                        echo "==============================================="
                        echo "DELETING DYNAMODB LOCK TABLE"
                        echo "==============================================="

                        if aws dynamodb describe-table \
                            --table-name "${DYNAMODB_LOCK_TABLE}" \
                            --region "${AWS_DEFAULT_REGION}" >/dev/null 2>&1
                        then

                            aws dynamodb delete-table \
                                --table-name "${DYNAMODB_LOCK_TABLE}" \
                                --region "${AWS_DEFAULT_REGION}"

                            echo "DynamoDB table deletion requested."

                        else

                            echo "DynamoDB lock table does not exist."

                        fi

                        echo "==============================================="
                    '''
                }
            }
        }

        // ============================================================
        // 18 - WAIT FOR DYNAMODB TABLE DELETION
        // ============================================================

        stage('18 - Wait For DynamoDB Table Deletion') {

            when {

                expression {
                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials(
                    [
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${params.AWS_CREDENTIALS_ID}",
                            accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                            secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                        ]
                    ]
                ) {

                    sh '''
                        set -eu

                        echo "==============================================="
                        echo "WAITING FOR DYNAMODB TABLE DELETION"
                        echo "==============================================="

                        MAX_ATTEMPTS=30
                        ATTEMPT=1

                        while [ "${ATTEMPT}" -le "${MAX_ATTEMPTS}" ]; do

                            if aws dynamodb describe-table \
                                --table-name "${DYNAMODB_LOCK_TABLE}" \
                                --region "${AWS_DEFAULT_REGION}" >/dev/null 2>&1
                            then

                                STATUS=$(aws dynamodb describe-table \
                                    --table-name "${DYNAMODB_LOCK_TABLE}" \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --query 'Table.TableStatus' \
                                    --output text 2>/dev/null || echo "UNKNOWN")

                                echo "Attempt ${ATTEMPT}/${MAX_ATTEMPTS}: DynamoDB status = ${STATUS}"

                                sleep 5

                            else

                                echo "DynamoDB table no longer exists."
                                break

                            fi

                            ATTEMPT=$((ATTEMPT + 1))

                        done

                        echo "==============================================="
                    '''
                }
            }
        }

        // ============================================================
        // 19 - VERIFY DYNAMODB TABLE DELETED
        // ============================================================

        stage('19 - Verify DynamoDB Table Deleted') {

            when {

                expression {
                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials(
                    [
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${params.AWS_CREDENTIALS_ID}",
                            accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                            secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                        ]
                    ]
                ) {

                    sh '''
                        set -eu

                        echo "==============================================="
                        echo "VERIFYING DYNAMODB TABLE DELETION"
                        echo "==============================================="

                        if aws dynamodb describe-table \
                            --table-name "${DYNAMODB_LOCK_TABLE}" \
                            --region "${AWS_DEFAULT_REGION}" >/dev/null 2>&1
                        then

                            echo "ERROR: DynamoDB table still exists."
                            exit 1

                        fi

                        echo "DynamoDB lock table successfully deleted."

                        echo "==============================================="
                    '''
                }
            }
        }

        // ============================================================
        // 20 - FINAL DESTRUCTION VERIFICATION
        // ============================================================

        stage('20 - Final Destruction Verification') {

            when {

                expression {
                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials(
                    [
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${params.AWS_CREDENTIALS_ID}",
                            accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                            secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                        ]
                    ]
                ) {

                    sh '''
                        set -eu

                        echo ""
                        echo "================================================"
                        echo "       FINAL DESTRUCTION VERIFICATION"
                        echo "================================================"

                        S3_EXISTS="NO"
                        DDB_EXISTS="NO"

                        if aws s3api head-bucket \
                            --bucket "${TERRAFORM_BACKEND_BUCKET}" \
                            --region "${AWS_DEFAULT_REGION}" >/dev/null 2>&1
                        then
                            S3_EXISTS="YES"
                        fi

                        if aws dynamodb describe-table \
                            --table-name "${DYNAMODB_LOCK_TABLE}" \
                            --region "${AWS_DEFAULT_REGION}" >/dev/null 2>&1
                        then
                            DDB_EXISTS="YES"
                        fi

                        echo ""
                        echo "S3 Backend Bucket : ${S3_EXISTS}"
                        echo "DynamoDB Lock     : ${DDB_EXISTS}"

                        if [ "${S3_EXISTS}" = "YES" ]; then
                            echo "ERROR: S3 backend still exists."
                            exit 1
                        fi

                        if [ "${DDB_EXISTS}" = "YES" ]; then
                            echo "ERROR: DynamoDB lock table still exists."
                            exit 1
                        fi

                        echo ""
                        echo "================================================"
                        echo "BACKEND DESTRUCTION VERIFIED"
                        echo "================================================"
                    '''
                }
            }
        }

        // ============================================================
        // 21 - FINAL REPORT
        // ============================================================

        stage('21 - Final Destruction Report') {

            steps {

                script {

                    echo ''
                    echo '================================================'
                    echo '       FINAL DESTROY REPORT'
                    echo '================================================'
                    echo ''
                    echo "Environment              : ${params.ENVIRONMENT}"
                    echo "AWS Region               : ${params.AWS_REGION}"
                    echo "Terraform Destroy        : COMPLETED"
                    echo "Terraform Lock Check     : PASSED"
                    echo "Terraform State Object   : REMOVED"
                    echo "S3 Object Versions       : REMOVED"
                    echo "S3 Backend Bucket        : DELETED"
                    echo "DynamoDB Lock Table      : DELETED"
                    echo ''
                    echo '================================================'
                    echo '       DESTROY COMPLETED SUCCESSFULLY'
                    echo '================================================'
                    echo ''
                }
            }
        }
    }

    // ================================================================
    // POST ACTIONS
    // ================================================================

    post {

        always {

            echo ''
            echo '================================================'
            echo '       DESTROY PIPELINE FINISHED'
            echo '================================================'
            echo ''
        }

        success {

            echo ''
            echo '================================================'
            echo '       DESTROY PIPELINE SUCCESS'
            echo '================================================'
            echo ''
            echo "Environment : ${params.ENVIRONMENT}"
            echo "Build       : ${BUILD_NUMBER}"
            echo "Region      : ${params.AWS_REGION}"
            echo ''
            echo 'Infrastructure and Terraform backend cleanup'
            echo 'completed successfully.'
            echo '================================================'
        }

        failure {

            echo ''
            echo '================================================'
            echo '       DESTROY PIPELINE FAILED'
            echo '================================================'
            echo ''
            echo "Environment : ${params.ENVIRONMENT}"
            echo "Build       : ${BUILD_NUMBER}"
            echo "Region      : ${params.AWS_REGION}"
            echo ''
            echo 'The pipeline stopped at the failed stage.'
            echo 'The Terraform backend is intentionally protected'
            echo 'if Terraform destruction or lock verification fails.'
            echo ''
            echo 'Check the failed stage above.'
            echo '================================================'
        }

        aborted {

            echo ''
            echo '================================================'
            echo '       DESTROY PIPELINE ABORTED'
            echo '================================================'
            echo ''
            echo "Environment : ${params.ENVIRONMENT}"
            echo "Build       : ${BUILD_NUMBER}"
            echo ''
            echo 'The build was manually aborted.'
            echo '================================================'
        }
    }
}
