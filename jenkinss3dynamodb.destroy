pipeline {

    agent any

    // ================================================================
    // PIPELINE OPTIONS
    // ================================================================

    options {

        timestamps()

        ansiColor('xterm')

        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                daysToKeepStr: '30',
                numToKeepStr: '50'
            )
        )

        timeout(
            time: 120,
            unit: 'MINUTES'
        )
    }


    // ================================================================
    // PARAMETERS
    // ================================================================

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: [
                'dev',
                'qa',
                'stage',
                'prod'
            ],
            description: 'Terraform environment to destroy'
        )

        string(
            name: 'AWS_REGION',
            defaultValue: 'us-east-1',
            description: 'AWS region'
        )

        string(
            name: 'TERRAFORM_REPO',
            defaultValue: 'https://github.com/FAIZANSHEIKH223/terraform-aws-infra.git',
            description: 'Terraform infrastructure repository'
        )

        string(
            name: 'TERRAFORM_BRANCH',
            defaultValue: 'main',
            description: 'Terraform repository branch'
        )

        string(
            name: 'AWS_CREDENTIALS',
            defaultValue: 'aws-creds',
            description: 'Jenkins AWS credentials ID'
        )

        string(
            name: 'GITHUB_CREDENTIALS',
            defaultValue: 'github-creds',
            description: 'Jenkins GitHub credentials ID'
        )

        string(
            name: 'TERRAFORM_BACKEND_BUCKET',
            defaultValue: 'terraform-state-faizan-001',
            description: 'Terraform S3 backend bucket'
        )

        string(
            name: 'TERRAFORM_STATE_KEY',
            defaultValue: 'terraform.tfstate',
            description: 'Terraform state object key'
        )

        string(
            name: 'DYNAMODB_LOCK_TABLE',
            defaultValue: 'terraform-locks',
            description: 'Terraform DynamoDB lock table'
        )

        booleanParam(
            name: 'DELETE_TERRAFORM_BACKEND',
            defaultValue: true,
            description: 'Delete Terraform state, all S3 object versions, S3 backend bucket and DynamoDB lock table after infrastructure destruction'
        )

        booleanParam(
            name: 'CONFIRM_DESTRUCTION',
            defaultValue: false,
            description: 'Safety confirmation. Must be TRUE to destroy infrastructure and backend.'
        )
    }


    // ================================================================
    // ENVIRONMENT
    // ================================================================

    environment {

        TF_DIR = 'terraform-infra'

        AWS_DEFAULT_REGION = "${params.AWS_REGION}"

        TF_IN_AUTOMATION = 'true'

        TF_INPUT = 'false'

        TF_STATE_BUCKET = "${params.TERRAFORM_BACKEND_BUCKET}"

        TF_STATE_KEY = "${params.TERRAFORM_STATE_KEY}"

        TF_LOCK_TABLE = "${params.DYNAMODB_LOCK_TABLE}"

        TF_LOCK_ID = "${params.TERRAFORM_BACKEND_BUCKET}/${params.TERRAFORM_STATE_KEY}"
    }


    // ================================================================
    // STAGES
    // ================================================================

    stages {


        // ============================================================
        // 01 - START
        // ============================================================

        stage('01 - Start Destroy Pipeline') {

            steps {

                echo ''
                echo '================================================'
                echo '       TERRAFORM DESTROY PIPELINE'
                echo '================================================'
                echo ''
                echo "Environment              : ${params.ENVIRONMENT}"
                echo "AWS Region               : ${params.AWS_REGION}"
                echo "Terraform Backend Bucket : ${params.TERRAFORM_BACKEND_BUCKET}"
                echo "Terraform State Key      : ${params.TERRAFORM_STATE_KEY}"
                echo "DynamoDB Lock Table      : ${params.DYNAMODB_LOCK_TABLE}"
                echo "Delete Backend           : ${params.DELETE_TERRAFORM_BACKEND}"
                echo "Destruction Confirmed    : ${params.CONFIRM_DESTRUCTION}"
                echo ''
                echo '================================================'
            }
        }


        // ============================================================
        // 02 - CONFIRM DESTRUCTION
        // ============================================================

        stage('02 - Confirm Destruction') {

            steps {

                script {

                    if (!params.CONFIRM_DESTRUCTION) {

                        error(
                            'DESTRUCTION NOT CONFIRMED. Set CONFIRM_DESTRUCTION=true before running this pipeline.'
                        )
                    }

                    echo ''
                    echo 'Destruction confirmation received.'
                    echo 'Continuing with Terraform destruction.'
                    echo ''
                }
            }
        }


        // ============================================================
        // 03 - CHECK REQUIRED TOOLS
        // ============================================================

        stage('03 - Check Required Tools') {

            steps {

                sh '''
                    set -eu

                    echo "================================================"
                    echo "CHECKING REQUIRED TOOLS"
                    echo "================================================"

                    command -v terraform >/dev/null 2>&1 || {
                        echo "ERROR: Terraform is not installed."
                        exit 1
                    }

                    command -v aws >/dev/null 2>&1 || {
                        echo "ERROR: AWS CLI is not installed."
                        exit 1
                    }

                    command -v jq >/dev/null 2>&1 || {
                        echo "ERROR: jq is not installed."
                        exit 1
                    }

                    echo ""
                    echo "Terraform:"
                    terraform version

                    echo ""
                    echo "AWS CLI:"
                    aws --version

                    echo ""
                    echo "jq:"
                    jq --version

                    echo ""
                    echo "All required tools are available."
                    echo "================================================"
                '''
            }
        }


        // ============================================================
        // 04 - AWS AUTHENTICATION
        // ============================================================

        stage('04 - Verify AWS Authentication') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${params.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -eu

                        export AWS_DEFAULT_REGION="${AWS_REGION}"

                        echo "================================================"
                        echo "VERIFYING AWS AUTHENTICATION"
                        echo "================================================"

                        aws sts get-caller-identity

                        echo ""
                        echo "AWS Region:"
                        echo "${AWS_DEFAULT_REGION}"

                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // 05 - CHECK S3 BACKEND
        // ============================================================

        stage('05 - Check Terraform S3 Backend') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${params.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -eu

                        export AWS_DEFAULT_REGION="${AWS_REGION}"

                        BUCKET="${TF_STATE_BUCKET}"

                        echo "================================================"
                        echo "CHECKING TERRAFORM S3 BACKEND"
                        echo "================================================"

                        echo "Bucket: ${BUCKET}"
                        echo "Region: ${AWS_DEFAULT_REGION}"
                        echo ""

                        if aws s3api head-bucket \
                            --bucket "${BUCKET}" \
                            >/dev/null 2>&1
                        then

                            echo "S3 backend bucket EXISTS."

                        else

                            echo "S3 backend bucket does NOT exist."
                            echo "Terraform backend cleanup will be skipped later."

                        fi

                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // 06 - CHECK DYNAMODB
        // ============================================================

        stage('06 - Check DynamoDB Lock Table') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${params.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -eu

                        export AWS_DEFAULT_REGION="${AWS_REGION}"

                        TABLE="${TF_LOCK_TABLE}"

                        echo "================================================"
                        echo "CHECKING DYNAMODB LOCK TABLE"
                        echo "================================================"

                        echo "Table: ${TABLE}"
                        echo "Region: ${AWS_DEFAULT_REGION}"
                        echo ""

                        if aws dynamodb describe-table \
                            --table-name "${TABLE}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            >/dev/null 2>&1
                        then

                            echo "DynamoDB table EXISTS."

                            STATUS=$(aws dynamodb describe-table \
                                --table-name "${TABLE}" \
                                --region "${AWS_DEFAULT_REGION}" \
                                --query 'Table.TableStatus' \
                                --output text)

                            echo "DynamoDB status: ${STATUS}"

                        else

                            echo "DynamoDB table does NOT exist."
                            echo "DynamoDB cleanup will be skipped later."

                        fi

                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // 07 - CHECKOUT TERRAFORM
        // ============================================================

        stage('07 - Checkout Terraform Repository') {

            steps {

                dir("${TF_DIR}") {

                    deleteDir()

                    git(
                        branch: "${params.TERRAFORM_BRANCH}",
                        credentialsId: "${params.GITHUB_CREDENTIALS}",
                        url: "${params.TERRAFORM_REPO}"
                    )
                }
            }
        }


        // ============================================================
        // 08 - TERRAFORM FORMAT
        // ============================================================

        stage('08 - Terraform Format Check') {

            steps {

                dir("${TF_DIR}") {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "TERRAFORM FORMAT CHECK"
                        echo "================================================"

                        terraform fmt -check -recursive

                        echo ""
                        echo "Terraform format check PASSED."
                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // 09 - TERRAFORM INIT
        // ============================================================

        stage('09 - Terraform Init') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${params.AWS_CREDENTIALS}"
                    ]
                ]) {

                    dir("${TF_DIR}") {

                        sh '''
                            set -eu

                            export AWS_DEFAULT_REGION="${AWS_REGION}"

                            echo "================================================"
                            echo "TERRAFORM INIT"
                            echo "================================================"

                            echo "Backend bucket : ${TF_STATE_BUCKET}"
                            echo "State key      : ${TF_STATE_KEY}"
                            echo "Lock table     : ${TF_LOCK_TABLE}"
                            echo "Region         : ${AWS_DEFAULT_REGION}"
                            echo ""

                            terraform init \
                                -reconfigure \
                                -input=false

                            echo ""
                            echo "Terraform initialization PASSED."
                            echo "================================================"
                        '''
                    }
                }
            }
        }


        // ============================================================
        // 10 - TERRAFORM VALIDATE
        // ============================================================

        stage('10 - Terraform Validate') {

            steps {

                dir("${TF_DIR}") {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "TERRAFORM VALIDATE"
                        echo "================================================"

                        terraform validate

                        echo ""
                        echo "Terraform validation PASSED."
                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // 11 - TERRAFORM PLAN DESTROY
        // ============================================================

        stage('11 - Terraform Destroy Plan') {

            steps {

                dir("${TF_DIR}") {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "TERRAFORM DESTROY PLAN"
                        echo "================================================"

                        TFVARS="environments/${ENVIRONMENT}/terraform.tfvars"

                        if [ ! -f "${TFVARS}" ]; then
                            echo "ERROR: Terraform variable file not found:"
                            echo "${TFVARS}"
                            exit 1
                        fi

                        terraform plan \
                            -destroy \
                            -input=false \
                            -var-file="${TFVARS}" \
                            -out=destroy.tfplan

                        echo ""
                        echo "Terraform destroy plan created successfully."
                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // 12 - TERRAFORM DESTROY
        // ============================================================

        stage('12 - Terraform Destroy Infrastructure') {

            steps {

                dir("${TF_DIR}") {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "DESTROYING TERRAFORM INFRASTRUCTURE"
                        echo "================================================"

                        if [ ! -f "destroy.tfplan" ]; then

                            echo "ERROR: destroy.tfplan does not exist."

                            exit 1
                        fi

                        terraform apply \
                            -input=false \
                            -auto-approve \
                            destroy.tfplan

                        echo ""
                        echo "Terraform infrastructure destruction PASSED."
                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // 13 - WAIT FOR LOCK RELEASE
        // ============================================================

        stage('13 - Wait For Terraform Lock Release') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${params.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -eu

                        export AWS_DEFAULT_REGION="${AWS_REGION}"

                        TABLE="${TF_LOCK_TABLE}"
                        LOCK_ID="${TF_LOCK_ID}"

                        echo "================================================"
                        echo "WAITING FOR TERRAFORM LOCK RELEASE"
                        echo "================================================"

                        echo "Lock table : ${TABLE}"
                        echo "Lock ID    : ${LOCK_ID}"
                        echo ""

                        MAX_ATTEMPTS=30
                        ATTEMPT=1

                        while [ "${ATTEMPT}" -le "${MAX_ATTEMPTS}" ]; do

                            LOCK_EXISTS=$(aws dynamodb get-item \
                                --table-name "${TABLE}" \
                                --key "{\"LockID\":{\"S\":\"${LOCK_ID}\"}}" \
                                --region "${AWS_DEFAULT_REGION}" \
                                --output json \
                                | jq -r 'if .Item then "yes" else "no" end')

                            if [ "${LOCK_EXISTS}" = "no" ]; then

                                echo "No Terraform lock detected."

                                break

                            fi

                            echo "Terraform lock still exists."
                            echo "Waiting 10 seconds..."
                            echo "Attempt ${ATTEMPT}/${MAX_ATTEMPTS}"

                            sleep 10

                            ATTEMPT=$((ATTEMPT + 1))

                        done

                        if [ "${ATTEMPT}" -gt "${MAX_ATTEMPTS}" ]; then

                            echo ""
                            echo "ERROR: Terraform lock was not released."
                            echo "Backend deletion will NOT continue."

                            exit 1

                        fi

                        echo ""
                        echo "Terraform lock released successfully."
                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // 14 - VERIFY NO ACTIVE LOCK
        // ============================================================

        stage('14 - Verify No Active Terraform Lock') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${params.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -eu

                        export AWS_DEFAULT_REGION="${AWS_REGION}"

                        TABLE="${TF_LOCK_TABLE}"
                        LOCK_ID="${TF_LOCK_ID}"

                        echo "================================================"
                        echo "VERIFYING NO ACTIVE TERRAFORM LOCK"
                        echo "================================================"

                        if ! aws dynamodb describe-table \
                            --table-name "${TABLE}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            >/dev/null 2>&1
                        then

                            echo "DynamoDB table does not exist."
                            echo "No active Terraform lock possible."

                            exit 0

                        fi

                        ITEM=$(aws dynamodb get-item \
                            --table-name "${TABLE}" \
                            --key "{\"LockID\":{\"S\":\"${LOCK_ID}\"}}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            --output json)

                        if echo "${ITEM}" | jq -e '.Item' >/dev/null 2>&1; then

                            echo ""
                            echo "ERROR: ACTIVE TERRAFORM LOCK DETECTED."
                            echo ""
                            echo "${ITEM}" | jq .

                            echo ""
                            echo "Backend deletion has been stopped for safety."

                            exit 1

                        fi

                        echo ""
                        echo "No active Terraform lock detected."
                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // 15 - CHECK STATE OBJECT
        // ============================================================

        stage('15 - Check Terraform State Object') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${params.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -eu

                        export AWS_DEFAULT_REGION="${AWS_REGION}"

                        BUCKET="${TF_STATE_BUCKET}"
                        KEY="${TF_STATE_KEY}"

                        echo "================================================"
                        echo "CHECKING TERRAFORM STATE OBJECT"
                        echo "================================================"

                        if aws s3api head-object \
                            --bucket "${BUCKET}" \
                            --key "${KEY}" \
                            >/dev/null 2>&1
                        then

                            echo "Terraform state object EXISTS."
                            echo "s3://${BUCKET}/${KEY}"

                        else

                            echo "Terraform state object does NOT exist."

                        fi

                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // 16 - DELETE CURRENT STATE OBJECT
        // ============================================================

        stage('16 - Delete Terraform State Object') {

            when {

                expression {

                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${params.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -eu

                        export AWS_DEFAULT_REGION="${AWS_REGION}"

                        BUCKET="${TF_STATE_BUCKET}"
                        KEY="${TF_STATE_KEY}"

                        echo "================================================"
                        echo "DELETING CURRENT TERRAFORM STATE OBJECT"
                        echo "================================================"

                        if aws s3api head-object \
                            --bucket "${BUCKET}" \
                            --key "${KEY}" \
                            >/dev/null 2>&1
                        then

                            aws s3api delete-object \
                                --bucket "${BUCKET}" \
                                --key "${KEY}" \
                                --region "${AWS_DEFAULT_REGION}"

                            echo "Current Terraform state object deleted."

                        else

                            echo "Current Terraform state object already absent."

                        fi

                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // 17 - DELETE ALL S3 VERSIONS
        // ============================================================

        stage('17 - Delete All S3 Object Versions') {

            when {

                expression {

                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${params.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -eu

                        export AWS_DEFAULT_REGION="${AWS_REGION}"

                        BUCKET="${TF_STATE_BUCKET}"

                        echo "================================================"
                        echo "DELETING ALL S3 OBJECT VERSIONS"
                        echo "================================================"

                        if ! aws s3api head-bucket \
                            --bucket "${BUCKET}" \
                            >/dev/null 2>&1
                        then

                            echo "Bucket does not exist."
                            exit 0

                        fi

                        echo "Deleting all object versions and delete markers..."

                        while true; do

                            VERSIONS=$(aws s3api list-object-versions \
                                --bucket "${BUCKET}" \
                                --region "${AWS_DEFAULT_REGION}" \
                                --output json)

                            COUNT=$(echo "${VERSIONS}" | jq '
                                (
                                    (.Versions // []) +
                                    (.DeleteMarkers // [])
                                ) | length
                            ')

                            if [ "${COUNT}" -eq 0 ]; then

                                echo "No remaining object versions or delete markers."

                                break

                            fi

                            echo "Found ${COUNT} version/delete-marker entries."

                            DELETE_JSON=$(echo "${VERSIONS}" | jq '
                                {
                                    Objects:
                                        (
                                            ((.Versions // []) + (.DeleteMarkers // []))
                                            | map({
                                                Key: .Key,
                                                VersionId: .VersionId
                                            })
                                        ),
                                    Quiet: true
                                }
                            ')

                            aws s3api delete-objects \
                                --bucket "${BUCKET}" \
                                --delete "${DELETE_JSON}" \
                                --region "${AWS_DEFAULT_REGION}"

                            sleep 2

                        done

                        echo ""
                        echo "All S3 object versions deleted."
                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // 18 - VERIFY BUCKET EMPTY
        // ============================================================

        stage('18 - Verify S3 Bucket Empty') {

            when {

                expression {

                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${params.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -eu

                        export AWS_DEFAULT_REGION="${AWS_REGION}"

                        BUCKET="${TF_STATE_BUCKET}"

                        echo "================================================"
                        echo "VERIFYING S3 BUCKET IS EMPTY"
                        echo "================================================"

                        if ! aws s3api head-bucket \
                            --bucket "${BUCKET}" \
                            >/dev/null 2>&1
                        then

                            echo "Bucket does not exist."

                            exit 0

                        fi

                        REMAINING=$(aws s3api list-object-versions \
                            --bucket "${BUCKET}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            --output json \
                            | jq '
                                (
                                    (.Versions // []) +
                                    (.DeleteMarkers // [])
                                ) | length
                            ')

                        echo "Remaining objects/version entries: ${REMAINING}"

                        if [ "${REMAINING}" -ne 0 ]; then

                            echo ""
                            echo "ERROR: S3 bucket is not empty."

                            exit 1

                        fi

                        echo ""
                        echo "S3 bucket is completely empty."
                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // 19 - DELETE S3 BACKEND BUCKET
        // ============================================================

        stage('19 - Delete Terraform S3 Backend Bucket') {

            when {

                expression {

                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${params.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -eu

                        export AWS_DEFAULT_REGION="${AWS_REGION}"

                        BUCKET="${TF_STATE_BUCKET}"

                        echo "================================================"
                        echo "DELETING TERRAFORM S3 BACKEND BUCKET"
                        echo "================================================"

                        if aws s3api head-bucket \
                            --bucket "${BUCKET}" \
                            >/dev/null 2>&1
                        then

                            aws s3api delete-bucket \
                                --bucket "${BUCKET}" \
                                --region "${AWS_DEFAULT_REGION}"

                            echo ""
                            echo "S3 backend bucket deletion requested."

                        else

                            echo "S3 backend bucket already absent."

                        fi

                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // 20 - VERIFY S3 BUCKET DELETED
        // ============================================================

        stage('20 - Verify S3 Bucket Deleted') {

            when {

                expression {

                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${params.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -eu

                        export AWS_DEFAULT_REGION="${AWS_REGION}"

                        BUCKET="${TF_STATE_BUCKET}"

                        echo "================================================"
                        echo "VERIFYING S3 BACKEND BUCKET DELETED"
                        echo "================================================"

                        ATTEMPT=1
                        MAX_ATTEMPTS=30

                        while [ "${ATTEMPT}" -le "${MAX_ATTEMPTS}" ]; do

                            if aws s3api head-bucket \
                                --bucket "${BUCKET}" \
                                >/dev/null 2>&1
                            then

                                echo "Bucket still exists."
                                echo "Waiting 5 seconds..."
                                echo "Attempt ${ATTEMPT}/${MAX_ATTEMPTS}"

                                sleep 5

                                ATTEMPT=$((ATTEMPT + 1))

                            else

                                echo ""
                                echo "S3 backend bucket has been deleted."

                                break

                            fi

                        done

                        if aws s3api head-bucket \
                            --bucket "${BUCKET}" \
                            >/dev/null 2>&1
                        then

                            echo ""
                            echo "ERROR: S3 bucket still exists."

                            exit 1

                        fi

                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // 21 - DELETE DYNAMODB LOCK TABLE
        // ============================================================

        stage('21 - Delete DynamoDB Lock Table') {

            when {

                expression {

                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${params.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -eu

                        export AWS_DEFAULT_REGION="${AWS_REGION}"

                        TABLE="${TF_LOCK_TABLE}"

                        echo "================================================"
                        echo "DELETING DYNAMODB LOCK TABLE"
                        echo "================================================"

                        if aws dynamodb describe-table \
                            --table-name "${TABLE}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            >/dev/null 2>&1
                        then

                            STATUS=$(aws dynamodb describe-table \
                                --table-name "${TABLE}" \
                                --region "${AWS_DEFAULT_REGION}" \
                                --query 'Table.TableStatus' \
                                --output text)

                            echo "Current DynamoDB status: ${STATUS}"

                            if [ "${STATUS}" = "ACTIVE" ]; then

                                aws dynamodb delete-table \
                                    --table-name "${TABLE}" \
                                    --region "${AWS_DEFAULT_REGION}"

                                echo "DynamoDB table deletion requested."

                            else

                                echo "DynamoDB table is not ACTIVE."
                                echo "Waiting for deletion if already in progress."

                            fi

                        else

                            echo "DynamoDB table already absent."

                        fi

                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // 22 - WAIT FOR DYNAMODB DELETION
        // ============================================================

        stage('22 - Wait For DynamoDB Table Deletion') {

            when {

                expression {

                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${params.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -eu

                        export AWS_DEFAULT_REGION="${AWS_REGION}"

                        TABLE="${TF_LOCK_TABLE}"

                        echo "================================================"
                        echo "WAITING FOR DYNAMODB TABLE DELETION"
                        echo "================================================"

                        ATTEMPT=1
                        MAX_ATTEMPTS=30

                        while [ "${ATTEMPT}" -le "${MAX_ATTEMPTS}" ]; do

                            if aws dynamodb describe-table \
                                --table-name "${TABLE}" \
                                --region "${AWS_DEFAULT_REGION}" \
                                >/dev/null 2>&1
                            then

                                echo "DynamoDB table still exists."
                                echo "Waiting 5 seconds..."
                                echo "Attempt ${ATTEMPT}/${MAX_ATTEMPTS}"

                                sleep 5

                                ATTEMPT=$((ATTEMPT + 1))

                            else

                                echo ""
                                echo "DynamoDB table no longer exists."

                                break

                            fi

                        done

                        if aws dynamodb describe-table \
                            --table-name "${TABLE}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            >/dev/null 2>&1
                        then

                            echo ""
                            echo "ERROR: DynamoDB table still exists."

                            exit 1

                        fi

                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // 23 - FINAL VERIFICATION
        // ============================================================

        stage('23 - Final Destruction Verification') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${params.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -eu

                        export AWS_DEFAULT_REGION="${AWS_REGION}"

                        BUCKET="${TF_STATE_BUCKET}"
                        TABLE="${TF_LOCK_TABLE}"

                        echo ""
                        echo "================================================"
                        echo "FINAL DESTRUCTION VERIFICATION"
                        echo "================================================"

                        BACKEND_OK="true"

                        echo ""
                        echo "Checking S3 bucket..."

                        if aws s3api head-bucket \
                            --bucket "${BUCKET}" \
                            >/dev/null 2>&1
                        then

                            echo "FAIL: S3 bucket still exists."
                            BACKEND_OK="false"

                        else

                            echo "PASS: S3 bucket deleted."

                        fi


                        echo ""
                        echo "Checking DynamoDB table..."

                        if aws dynamodb describe-table \
                            --table-name "${TABLE}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            >/dev/null 2>&1
                        then

                            echo "FAIL: DynamoDB table still exists."
                            BACKEND_OK="false"

                        else

                            echo "PASS: DynamoDB table deleted."

                        fi


                        if [ "${BACKEND_OK}" != "true" ]; then

                            echo ""
                            echo "FINAL BACKEND VERIFICATION FAILED."

                            exit 1

                        fi


                        echo ""
                        echo "================================================"
                        echo "FINAL BACKEND VERIFICATION PASSED"
                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // 24 - FINAL REPORT
        // ============================================================

        stage('24 - Final Destruction Report') {

            steps {

                echo ''
                echo '================================================'
                echo '          TERRAFORM DESTROY COMPLETE'
                echo '================================================'
                echo ''
                echo "Environment       : ${params.ENVIRONMENT}"
                echo "AWS Region        : ${params.AWS_REGION}"
                echo ''
                echo 'Infrastructure    : DESTROYED'
                echo 'Terraform Lock    : RELEASED'
                echo 'Terraform State   : REMOVED'
                echo 'S3 Versions       : REMOVED'
                echo 'S3 Backend        : DELETED'
                echo 'DynamoDB Lock     : DELETED'
                echo ''
                echo '================================================'
                echo '          DESTRUCTION SUCCESSFUL'
                echo '================================================'
            }
        }
    }


    // ================================================================
    // POST ACTIONS
    // ================================================================

    post {

        success {

            echo ''
            echo '================================================'
            echo '       DESTROY PIPELINE SUCCESSFUL'
            echo '================================================'
            echo ''
            echo "Environment : ${params.ENVIRONMENT}"
            echo "Build       : ${env.BUILD_NUMBER}"
            echo "Region      : ${params.AWS_REGION}"
            echo ''
            echo 'Terraform infrastructure has been destroyed.'
            echo 'Terraform backend cleanup completed.'
            echo ''
            echo '================================================'
        }


        failure {

            echo ''
            echo '================================================'
            echo '       DESTROY PIPELINE FAILED'
            echo '================================================'
            echo ''
            echo "Environment : ${params.ENVIRONMENT}"
            echo "Build       : ${env.BUILD_NUMBER}"
            echo "Region      : ${params.AWS_REGION}"
            echo ''
            echo 'The pipeline stopped at the failed stage.'
            echo ''
            echo 'IMPORTANT:'
            echo 'The S3/DynamoDB backend is protected until'
            echo 'Terraform destruction and lock verification'
            echo 'successfully complete.'
            echo ''
            echo 'Check the failed stage above.'
            echo ''
            echo '================================================'
        }


        always {

            echo ''
            echo '================================================'
            echo '       CLEANING JENKINS WORKSPACE'
            echo '================================================'

            cleanWs(
                deleteDirs: true,
                disableDeferredWipeout: true
            )
        }
    }
}
