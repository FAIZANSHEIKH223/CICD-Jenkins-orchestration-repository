pipeline {

    agent any

    // ================================================================
    // PIPELINE OPTIONS
    // ================================================================

    options {

        timestamps()

        ansiColor('xterm')

        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                daysToKeepStr: '30',
                numToKeepStr: '50'
            )
        )

        timeout(
            time: 120,
            unit: 'MINUTES'
        )

        skipDefaultCheckout(false)
    }


    // ================================================================
    // PARAMETERS
    // ================================================================

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: [
                'dev',
                'qa',
                'stage',
                'prod'
            ],
            description: 'Terraform environment to destroy.'
        )

        string(
            name: 'AWS_REGION',
            defaultValue: 'us-east-1',
            description: 'AWS region.'
        )

        string(
            name: 'TERRAFORM_BACKEND_BUCKET',
            defaultValue: 'terraform-state-faizan-001',
            description: 'Terraform S3 backend bucket.'
        )

        string(
            name: 'TERRAFORM_STATE_KEY',
            defaultValue: 'terraform.tfstate',
            description: 'Terraform state object key.'
        )

        string(
            name: 'DYNAMODB_LOCK_TABLE',
            defaultValue: 'terraform-lock',
            description: 'Terraform DynamoDB lock table.'
        )

        booleanParam(
            name: 'DELETE_TERRAFORM_BACKEND',
            defaultValue: true,
            description: 'Delete Terraform S3 backend bucket and DynamoDB lock table after infrastructure destruction.'
        )

        booleanParam(
            name: 'CONFIRM_DESTROY',
            defaultValue: true,
            description: 'CONFIRMATION: destroy the selected Terraform environment and optionally remove the Terraform backend.'
        )
    }


    // ================================================================
    // ENVIRONMENT
    // ================================================================

    environment {

        AWS_DEFAULT_REGION = "${params.AWS_REGION}"

        AWS_REGION = "${params.AWS_REGION}"

        TF_IN_AUTOMATION = "true"

        TF_INPUT = "false"

        TF_CLI_ARGS = "-no-color"

        TERRAFORM_DIR = "terraform-infra"
    }


    // ================================================================
    // STAGES
    // ================================================================

    stages {


        // ============================================================
        // 01
        // ============================================================

        stage('01 - Start Destroy Pipeline') {

            steps {

                echo ''
                echo '================================================'
                echo '        TERRAFORM DESTROY PIPELINE'
                echo '================================================'
                echo "Environment              : ${params.ENVIRONMENT}"
                echo "AWS Region               : ${params.AWS_REGION}"
                echo "Terraform Backend Bucket : ${params.TERRAFORM_BACKEND_BUCKET}"
                echo "Terraform State Key      : ${params.TERRAFORM_STATE_KEY}"
                echo "DynamoDB Lock Table      : ${params.DYNAMODB_LOCK_TABLE}"
                echo "Delete Backend           : ${params.DELETE_TERRAFORM_BACKEND}"
                echo "Destroy Confirmation     : ${params.CONFIRM_DESTROY}"
                echo '================================================'
                echo ''
            }
        }


        // ============================================================
        // 02
        // ============================================================

        stage('02 - Confirm Destruction') {

            steps {

                script {

                    if (!params.CONFIRM_DESTROY) {

                        error(
                            'DESTRUCTION NOT CONFIRMED. Set CONFIRM_DESTROY=true before running this pipeline.'
                        )
                    }

                    echo ''
                    echo '================================================'
                    echo '        DESTRUCTION CONFIRMED'
                    echo '================================================'
                    echo 'Terraform infrastructure will be destroyed.'
                    echo "Environment : ${params.ENVIRONMENT}"
                    echo "Region      : ${params.AWS_REGION}"
                    echo ''
                    echo 'Backend deletion:'
                    echo "DELETE_TERRAFORM_BACKEND = ${params.DELETE_TERRAFORM_BACKEND}"
                    echo '================================================'
                    echo ''
                }
            }
        }


        // ============================================================
        // 03
        // ============================================================

        stage('03 - Check Required Tools') {

            steps {

                sh '''
                    set -eu

                    echo "================================================"
                    echo "CHECKING REQUIRED TOOLS"
                    echo "================================================"

                    command -v terraform

                    echo ""
                    echo "Terraform:"
                    terraform version

                    command -v aws

                    echo ""
                    echo "AWS CLI:"
                    aws --version

                    command -v jq

                    echo ""
                    echo "jq:"
                    jq --version

                    echo ""
                    echo "Required tools are available."
                    echo "================================================"
                '''
            }
        }


        // ============================================================
        // 04
        // ============================================================

        stage('04 - Verify AWS Authentication') {

            steps {

                withCredentials(
                    [
                        usernamePassword(
                            credentialsId: 'aws-creds',
                            usernameVariable: 'AWS_ACCESS_KEY_ID',
                            passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                        )
                    ]
                ) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "VERIFYING AWS AUTHENTICATION"
                        echo "================================================"

                        export AWS_ACCESS_KEY_ID="$AWS_ACCESS_KEY_ID"
                        export AWS_SECRET_ACCESS_KEY="$AWS_SECRET_ACCESS_KEY"
                        export AWS_DEFAULT_REGION="$AWS_DEFAULT_REGION"
                        export AWS_REGION="$AWS_REGION"

                        aws sts get-caller-identity

                        echo ""
                        echo "AWS Region:"
                        echo "$AWS_REGION"

                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // 05
        // ============================================================

        stage('05 - Check Terraform S3 Backend') {

            steps {

                withCredentials(
                    [
                        usernamePassword(
                            credentialsId: 'aws-creds',
                            usernameVariable: 'AWS_ACCESS_KEY_ID',
                            passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                        )
                    ]
                ) {

                    sh '''
                        set -eu

                        export AWS_ACCESS_KEY_ID="$AWS_ACCESS_KEY_ID"
                        export AWS_SECRET_ACCESS_KEY="$AWS_SECRET_ACCESS_KEY"
                        export AWS_DEFAULT_REGION="$AWS_DEFAULT_REGION"
                        export AWS_REGION="$AWS_REGION"

                        BUCKET="$TERRAFORM_BACKEND_BUCKET"

                        echo "================================================"
                        echo "CHECKING TERRAFORM S3 BACKEND"
                        echo "================================================"
                        echo "Bucket: $BUCKET"
                        echo ""

                        if aws s3api head-bucket \
                            --bucket "$BUCKET" \
                            --region "$AWS_REGION" >/dev/null 2>&1
                        then

                            echo "Terraform backend bucket EXISTS."

                        else

                            echo "Terraform backend bucket DOES NOT EXIST."

                        fi

                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // 06
        // ============================================================

        stage('06 - Check DynamoDB Lock Table') {

            steps {

                withCredentials(
                    [
                        usernamePassword(
                            credentialsId: 'aws-creds',
                            usernameVariable: 'AWS_ACCESS_KEY_ID',
                            passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                        )
                    ]
                ) {

                    sh '''
                        set -eu

                        export AWS_ACCESS_KEY_ID="$AWS_ACCESS_KEY_ID"
                        export AWS_SECRET_ACCESS_KEY="$AWS_SECRET_ACCESS_KEY"
                        export AWS_DEFAULT_REGION="$AWS_DEFAULT_REGION"
                        export AWS_REGION="$AWS_REGION"

                        TABLE="$DYNAMODB_LOCK_TABLE"

                        echo "================================================"
                        echo "CHECKING DYNAMODB LOCK TABLE"
                        echo "================================================"
                        echo "Table: $TABLE"
                        echo ""

                        if aws dynamodb describe-table \
                            --table-name "$TABLE" \
                            --region "$AWS_REGION" >/dev/null 2>&1
                        then

                            echo "DynamoDB lock table EXISTS."

                            aws dynamodb describe-table \
                                --table-name "$TABLE" \
                                --region "$AWS_REGION" \
                                --query 'Table.[TableName,TableStatus]' \
                                --output table

                        else

                            echo "DynamoDB lock table DOES NOT EXIST."

                        fi

                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // 07
        // ============================================================

        stage('07 - Verify No Active Terraform Lock Before Destroy') {

            steps {

                withCredentials(
                    [
                        usernamePassword(
                            credentialsId: 'aws-creds',
                            usernameVariable: 'AWS_ACCESS_KEY_ID',
                            passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                        )
                    ]
                ) {

                    sh '''
                        set -eu

                        export AWS_ACCESS_KEY_ID="$AWS_ACCESS_KEY_ID"
                        export AWS_SECRET_ACCESS_KEY="$AWS_SECRET_ACCESS_KEY"
                        export AWS_DEFAULT_REGION="$AWS_DEFAULT_REGION"
                        export AWS_REGION="$AWS_REGION"

                        TABLE="$DYNAMODB_LOCK_TABLE"

                        echo "================================================"
                        echo "CHECKING TERRAFORM LOCK"
                        echo "================================================"

                        if ! aws dynamodb describe-table \
                            --table-name "$TABLE" \
                            --region "$AWS_REGION" >/dev/null 2>&1
                        then

                            echo "DynamoDB lock table does not exist."
                            echo "No Terraform lock can exist."
                            exit 0

                        fi

                        LOCK_ID="${TERRAFORM_BACKEND_BUCKET}/${TERRAFORM_STATE_KEY}"

                        echo "LockID: $LOCK_ID"
                        echo ""

                        ITEM_JSON=$(jq -n \
                            --arg lockid "$LOCK_ID" \
                            '{
                                LockID: {
                                    S: $lockid
                                }
                            }'
                        )

                        echo "Checking lock item..."

                        ITEM=$(aws dynamodb get-item \
                            --table-name "$TABLE" \
                            --key "$ITEM_JSON" \
                            --region "$AWS_REGION" \
                            --output json)

                        if echo "$ITEM" | jq -e '.Item and (.Item | length > 0)' >/dev/null
                        then

                            echo ""
                            echo "================================================"
                            echo "ACTIVE TERRAFORM LOCK FOUND"
                            echo "================================================"
                            echo "$ITEM" | jq .
                            echo ""
                            echo "Terraform destruction has been stopped."
                            echo "================================================"

                            exit 1

                        else

                            echo "No active Terraform lock found."
                            echo "Safe to continue."

                        fi
                    '''
                }
            }
        }


        // ============================================================
        // 08
        // ============================================================

        stage('08 - Checkout Terraform Repository') {

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    deleteDir()

                    dir('tmp') {
                        deleteDir()
                    }

                    checkout(
                        [
                            $class: 'GitSCM',
                            branches: [
                                [
                                    name: '*/main'
                                ]
                            ],
                            userRemoteConfigs: [
                                [
                                    credentialsId: 'github-creds',
                                    url: 'https://github.com/FAIZANSHEIKH223/terraform-aws-infra.git'
                                ]
                            ]
                        ]
                    )
                }
            }
        }


        // ============================================================
        // 09
        // ============================================================

        stage('09 - Terraform Init') {

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    withCredentials(
                        [
                            usernamePassword(
                                credentialsId: 'aws-creds',
                                usernameVariable: 'AWS_ACCESS_KEY_ID',
                                passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                            )
                        ]
                    ) {

                        sh '''
                            set -eu

                            export AWS_ACCESS_KEY_ID="$AWS_ACCESS_KEY_ID"
                            export AWS_SECRET_ACCESS_KEY="$AWS_SECRET_ACCESS_KEY"
                            export AWS_DEFAULT_REGION="$AWS_DEFAULT_REGION"
                            export AWS_REGION="$AWS_REGION"

                            echo "================================================"
                            echo "TERRAFORM INIT"
                            echo "================================================"

                            terraform init \
                                -input=false \
                                -reconfigure

                            echo ""
                            echo "Terraform initialization PASSED."
                            echo "================================================"
                        '''
                    }
                }
            }
        }


        // ============================================================
        // 10
        // ============================================================

        stage('10 - Terraform Validate') {

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "TERRAFORM VALIDATION"
                        echo "================================================"

                        terraform validate

                        echo ""
                        echo "Terraform validation PASSED."
                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // 11
        // ============================================================

        stage('11 - Terraform Destroy Plan') {

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    withCredentials(
                        [
                            usernamePassword(
                                credentialsId: 'aws-creds',
                                usernameVariable: 'AWS_ACCESS_KEY_ID',
                                passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                            )
                        ]
                    ) {

                        sh '''
                            set -eu

                            export AWS_ACCESS_KEY_ID="$AWS_ACCESS_KEY_ID"
                            export AWS_SECRET_ACCESS_KEY="$AWS_SECRET_ACCESS_KEY"
                            export AWS_DEFAULT_REGION="$AWS_DEFAULT_REGION"
                            export AWS_REGION="$AWS_REGION"

                            TFVARS="environments/${ENVIRONMENT}/terraform.tfvars"

                            echo "================================================"
                            echo "TERRAFORM DESTROY PLAN"
                            echo "================================================"
                            echo "Variable file: $TFVARS"
                            echo ""

                            if [ ! -f "$TFVARS" ]
                            then
                                echo "ERROR: Terraform variable file not found:"
                                echo "$TFVARS"
                                exit 1
                            fi

                            terraform plan \
                                -destroy \
                                -input=false \
                                -var-file="$TFVARS" \
                                -out=destroy.tfplan

                            echo ""
                            echo "Terraform destroy plan created."
                            echo "================================================"
                        '''
                    }
                }
            }
        }


        // ============================================================
        // 12
        // ============================================================

        stage('12 - Terraform Destroy Infrastructure') {

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    withCredentials(
                        [
                            usernamePassword(
                                credentialsId: 'aws-creds',
                                usernameVariable: 'AWS_ACCESS_KEY_ID',
                                passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                            )
                        ]
                    ) {

                        sh '''
                            set -eu

                            export AWS_ACCESS_KEY_ID="$AWS_ACCESS_KEY_ID"
                            export AWS_SECRET_ACCESS_KEY="$AWS_SECRET_ACCESS_KEY"
                            export AWS_DEFAULT_REGION="$AWS_DEFAULT_REGION"
                            export AWS_REGION="$AWS_REGION"

                            echo "================================================"
                            echo "DESTROYING TERRAFORM INFRASTRUCTURE"
                            echo "================================================"

                            if [ ! -f destroy.tfplan ]
                            then
                                echo "ERROR: destroy.tfplan does not exist."
                                exit 1
                            fi

                            terraform apply \
                                -input=false \
                                -auto-approve \
                                destroy.tfplan

                            echo ""
                            echo "Terraform infrastructure destruction PASSED."
                            echo "================================================"
                        '''
                    }
                }
            }
        }


        // ============================================================
        // 13
        // ============================================================

        stage('13 - Wait For Terraform Lock Release') {

            steps {

                withCredentials(
                    [
                        usernamePassword(
                            credentialsId: 'aws-creds',
                            usernameVariable: 'AWS_ACCESS_KEY_ID',
                            passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                        )
                    ]
                ) {

                    sh '''
                        set -eu

                        export AWS_ACCESS_KEY_ID="$AWS_ACCESS_KEY_ID"
                        export AWS_SECRET_ACCESS_KEY="$AWS_SECRET_ACCESS_KEY"
                        export AWS_DEFAULT_REGION="$AWS_DEFAULT_REGION"
                        export AWS_REGION="$AWS_REGION"

                        TABLE="$DYNAMODB_LOCK_TABLE"
                        LOCK_ID="${TERRAFORM_BACKEND_BUCKET}/${TERRAFORM_STATE_KEY}"

                        echo "================================================"
                        echo "WAITING FOR TERRAFORM LOCK RELEASE"
                        echo "================================================"

                        if ! aws dynamodb describe-table \
                            --table-name "$TABLE" \
                            --region "$AWS_REGION" >/dev/null 2>&1
                        then

                            echo "DynamoDB table does not exist."
                            exit 0

                        fi

                        MAX_ATTEMPTS=30
                        ATTEMPT=1

                        while [ "$ATTEMPT" -le "$MAX_ATTEMPTS" ]
                        do

                            ITEM_JSON=$(jq -n \
                                --arg lockid "$LOCK_ID" \
                                '{
                                    LockID: {
                                        S: $lockid
                                    }
                                }'
                            )

                            ITEM=$(aws dynamodb get-item \
                                --table-name "$TABLE" \
                                --key "$ITEM_JSON" \
                                --region "$AWS_REGION" \
                                --output json)

                            if echo "$ITEM" | jq -e '.Item and (.Item | length > 0)' >/dev/null
                            then

                                echo "Terraform lock still exists."
                                echo "Attempt $ATTEMPT/$MAX_ATTEMPTS"

                                sleep 5

                            else

                                echo "Terraform lock has been released."
                                exit 0

                            fi

                            ATTEMPT=$((ATTEMPT + 1))

                        done

                        echo "ERROR: Terraform lock was not released."
                        exit 1
                    '''
                }
            }
        }


        // ============================================================
        // 14
        // ============================================================

        stage('14 - Verify No Active Terraform Lock') {

            steps {

                withCredentials(
                    [
                        usernamePassword(
                            credentialsId: 'aws-creds',
                            usernameVariable: 'AWS_ACCESS_KEY_ID',
                            passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                        )
                    ]
                ) {

                    sh '''
                        set -eu

                        export AWS_ACCESS_KEY_ID="$AWS_ACCESS_KEY_ID"
                        export AWS_SECRET_ACCESS_KEY="$AWS_SECRET_ACCESS_KEY"
                        export AWS_DEFAULT_REGION="$AWS_DEFAULT_REGION"
                        export AWS_REGION="$AWS_REGION"

                        TABLE="$DYNAMODB_LOCK_TABLE"
                        LOCK_ID="${TERRAFORM_BACKEND_BUCKET}/${TERRAFORM_STATE_KEY}"

                        echo "================================================"
                        echo "FINAL TERRAFORM LOCK CHECK"
                        echo "================================================"

                        if ! aws dynamodb describe-table \
                            --table-name "$TABLE" \
                            --region "$AWS_REGION" >/dev/null 2>&1
                        then

                            echo "DynamoDB table does not exist."
                            echo "No active lock."

                            exit 0

                        fi

                        ITEM_JSON=$(jq -n \
                            --arg lockid "$LOCK_ID" \
                            '{
                                LockID: {
                                    S: $lockid
                                }
                            }'
                        )

                        ITEM=$(aws dynamodb get-item \
                            --table-name "$TABLE" \
                            --key "$ITEM_JSON" \
                            --region "$AWS_REGION" \
                            --output json)

                        if echo "$ITEM" | jq -e '.Item and (.Item | length > 0)' >/dev/null
                        then

                            echo "ERROR: ACTIVE TERRAFORM LOCK STILL EXISTS."
                            echo "$ITEM" | jq .
                            exit 1

                        fi

                        echo "No active Terraform lock."
                        echo "Safe to delete Terraform state."
                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // 15
        // ============================================================

        stage('15 - Check Terraform State Object') {

            when {

                expression {

                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials(
                    [
                        usernamePassword(
                            credentialsId: 'aws-creds',
                            usernameVariable: 'AWS_ACCESS_KEY_ID',
                            passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                        )
                    ]
                ) {

                    sh '''
                        set -eu

                        export AWS_ACCESS_KEY_ID="$AWS_ACCESS_KEY_ID"
                        export AWS_SECRET_ACCESS_KEY="$AWS_SECRET_ACCESS_KEY"
                        export AWS_DEFAULT_REGION="$AWS_DEFAULT_REGION"
                        export AWS_REGION="$AWS_REGION"

                        echo "================================================"
                        echo "CHECKING TERRAFORM STATE OBJECT"
                        echo "================================================"

                        if aws s3api head-object \
                            --bucket "$TERRAFORM_BACKEND_BUCKET" \
                            --key "$TERRAFORM_STATE_KEY" \
                            --region "$AWS_REGION" >/dev/null 2>&1
                        then

                            echo "Terraform state object EXISTS."

                        else

                            echo "Terraform state object does not exist."

                        fi

                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // 16
        // ============================================================

        stage('16 - Delete Terraform State Object') {

            when {

                expression {

                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials(
                    [
                        usernamePassword(
                            credentialsId: 'aws-creds',
                            usernameVariable: 'AWS_ACCESS_KEY_ID',
                            passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                        )
                    ]
                ) {

                    sh '''
                        set -eu

                        export AWS_ACCESS_KEY_ID="$AWS_ACCESS_KEY_ID"
                        export AWS_SECRET_ACCESS_KEY="$AWS_SECRET_ACCESS_KEY"
                        export AWS_DEFAULT_REGION="$AWS_DEFAULT_REGION"
                        export AWS_REGION="$AWS_REGION"

                        echo "================================================"
                        echo "DELETING TERRAFORM STATE OBJECT"
                        echo "================================================"

                        if aws s3api head-object \
                            --bucket "$TERRAFORM_BACKEND_BUCKET" \
                            --key "$TERRAFORM_STATE_KEY" \
                            --region "$AWS_REGION" >/dev/null 2>&1
                        then

                            aws s3api delete-object \
                                --bucket "$TERRAFORM_BACKEND_BUCKET" \
                                --key "$TERRAFORM_STATE_KEY" \
                                --region "$AWS_REGION"

                            echo ""
                            echo "Terraform state delete marker created."

                        else

                            echo "Terraform state object does not currently exist."

                        fi

                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // 17
        // ============================================================

        stage('17 - Delete All S3 Object Versions') {

            when {

                expression {

                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials(
                    [
                        usernamePassword(
                            credentialsId: 'aws-creds',
                            usernameVariable: 'AWS_ACCESS_KEY_ID',
                            passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                        )
                    ]
                ) {

                    sh '''
                        set -eu

                        export AWS_ACCESS_KEY_ID="$AWS_ACCESS_KEY_ID"
                        export AWS_SECRET_ACCESS_KEY="$AWS_SECRET_ACCESS_KEY"
                        export AWS_DEFAULT_REGION="$AWS_DEFAULT_REGION"
                        export AWS_REGION="$AWS_REGION"

                        BUCKET="$TERRAFORM_BACKEND_BUCKET"

                        echo "================================================"
                        echo "DELETING ALL S3 OBJECT VERSIONS"
                        echo "================================================"
                        echo "Bucket: $BUCKET"
                        echo ""

                        if ! aws s3api head-bucket \
                            --bucket "$BUCKET" \
                            --region "$AWS_REGION" >/dev/null 2>&1
                        then

                            echo "Bucket does not exist."
                            exit 0

                        fi

                        while true
                        do

                            OBJECTS=$(aws s3api list-object-versions \
                                --bucket "$BUCKET" \
                                --region "$AWS_REGION" \
                                --output json)

                            DELETE_JSON=$(echo "$OBJECTS" | jq -c '
                                [
                                    (.Versions // [])[] |
                                    {
                                        Key: .Key,
                                        VersionId: .VersionId
                                    }
                                ]
                                +
                                [
                                    (.DeleteMarkers // [])[] |
                                    {
                                        Key: .Key,
                                        VersionId: .VersionId
                                    }
                                ]
                            ')

                            COUNT=$(echo "$DELETE_JSON" | jq 'length')

                            echo "Objects/versions/delete markers found: $COUNT"

                            if [ "$COUNT" -eq 0 ]
                            then

                                echo "No S3 object versions remain."
                                break

                            fi

                            echo "Deleting $COUNT object versions/delete markers..."

                            # IMPORTANT:
                            # Use file:// so AWS CLI receives valid JSON.
                            DELETE_FILE="$(mktemp)"

                            jq -n \
                                --argjson objects "$DELETE_JSON" \
                                '{
                                    Objects: $objects,
                                    Quiet: false
                                }' \
                                > "$DELETE_FILE"

                            aws s3api delete-objects \
                                --bucket "$BUCKET" \
                                --delete "file://$DELETE_FILE" \
                                --region "$AWS_REGION"

                            rm -f "$DELETE_FILE"

                            echo "Deletion batch completed."

                            sleep 2

                        done

                        echo ""
                        echo "All S3 object versions and delete markers removed."
                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // 18
        // ============================================================

        stage('18 - Verify S3 Bucket Empty') {

            when {

                expression {

                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials(
                    [
                        usernamePassword(
                            credentialsId: 'aws-creds',
                            usernameVariable: 'AWS_ACCESS_KEY_ID',
                            passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                        )
                    ]
                ) {

                    sh '''
                        set -eu

                        export AWS_ACCESS_KEY_ID="$AWS_ACCESS_KEY_ID"
                        export AWS_SECRET_ACCESS_KEY="$AWS_SECRET_ACCESS_KEY"
                        export AWS_DEFAULT_REGION="$AWS_DEFAULT_REGION"
                        export AWS_REGION="$AWS_REGION"

                        BUCKET="$TERRAFORM_BACKEND_BUCKET"

                        echo "================================================"
                        echo "VERIFYING S3 BUCKET EMPTY"
                        echo "================================================"

                        if ! aws s3api head-bucket \
                            --bucket "$BUCKET" \
                            --region "$AWS_REGION" >/dev/null 2>&1
                        then

                            echo "Bucket does not exist."
                            exit 0

                        fi

                        OBJECTS=$(aws s3api list-object-versions \
                            --bucket "$BUCKET" \
                            --region "$AWS_REGION" \
                            --output json)

                        COUNT=$(echo "$OBJECTS" | jq '
                            ((.Versions // []) + (.DeleteMarkers // []))
                            | length
                        ')

                        if [ "$COUNT" -ne 0 ]
                        then

                            echo "ERROR: S3 bucket is not empty."
                            echo "$OBJECTS" | jq .
                            exit 1

                        fi

                        echo "S3 bucket is completely empty."
                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // 19
        // ============================================================

        stage('19 - Delete Terraform S3 Backend Bucket') {

            when {

                expression {

                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials(
                    [
                        usernamePassword(
                            credentialsId: 'aws-creds',
                            usernameVariable: 'AWS_ACCESS_KEY_ID',
                            passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                        )
                    ]
                ) {

                    sh '''
                        set -eu

                        export AWS_ACCESS_KEY_ID="$AWS_ACCESS_KEY_ID"
                        export AWS_SECRET_ACCESS_KEY="$AWS_SECRET_ACCESS_KEY"
                        export AWS_DEFAULT_REGION="$AWS_DEFAULT_REGION"
                        export AWS_REGION="$AWS_REGION"

                        BUCKET="$TERRAFORM_BACKEND_BUCKET"

                        echo "================================================"
                        echo "DELETING TERRAFORM S3 BACKEND BUCKET"
                        echo "================================================"

                        if aws s3api head-bucket \
                            --bucket "$BUCKET" \
                            --region "$AWS_REGION" >/dev/null 2>&1
                        then

                            aws s3api delete-bucket \
                                --bucket "$BUCKET" \
                                --region "$AWS_REGION"

                            echo ""
                            echo "S3 backend bucket deletion requested."

                        else

                            echo "S3 backend bucket already does not exist."

                        fi

                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // 20
        // ============================================================

        stage('20 - Verify S3 Bucket Deleted') {

            when {

                expression {

                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials(
                    [
                        usernamePassword(
                            credentialsId: 'aws-creds',
                            usernameVariable: 'AWS_ACCESS_KEY_ID',
                            passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                        )
                    ]
                ) {

                    sh '''
                        set -eu

                        export AWS_ACCESS_KEY_ID="$AWS_ACCESS_KEY_ID"
                        export AWS_SECRET_ACCESS_KEY="$AWS_SECRET_ACCESS_KEY"
                        export AWS_DEFAULT_REGION="$AWS_DEFAULT_REGION"
                        export AWS_REGION="$AWS_REGION"

                        BUCKET="$TERRAFORM_BACKEND_BUCKET"

                        echo "================================================"
                        echo "VERIFYING S3 BUCKET DELETION"
                        echo "================================================"

                        MAX_ATTEMPTS=30
                        ATTEMPT=1

                        while [ "$ATTEMPT" -le "$MAX_ATTEMPTS" ]
                        do

                            if aws s3api head-bucket \
                                --bucket "$BUCKET" \
                                --region "$AWS_REGION" >/dev/null 2>&1
                            then

                                echo "Bucket still exists."
                                echo "Attempt $ATTEMPT/$MAX_ATTEMPTS"

                                sleep 3

                            else

                                echo ""
                                echo "S3 backend bucket has been deleted."
                                exit 0

                            fi

                            ATTEMPT=$((ATTEMPT + 1))

                        done

                        echo "ERROR: S3 bucket still exists after waiting."
                        exit 1
                    '''
                }
            }
        }


        // ============================================================
        // 21
        // ============================================================

        stage('21 - Delete DynamoDB Lock Table') {

            when {

                expression {

                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials(
                    [
                        usernamePassword(
                            credentialsId: 'aws-creds',
                            usernameVariable: 'AWS_ACCESS_KEY_ID',
                            passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                        )
                    ]
                ) {

                    sh '''
                        set -eu

                        export AWS_ACCESS_KEY_ID="$AWS_ACCESS_KEY_ID"
                        export AWS_SECRET_ACCESS_KEY="$AWS_SECRET_ACCESS_KEY"
                        export AWS_DEFAULT_REGION="$AWS_DEFAULT_REGION"
                        export AWS_REGION="$AWS_REGION"

                        TABLE="$DYNAMODB_LOCK_TABLE"

                        echo "================================================"
                        echo "DELETING DYNAMODB LOCK TABLE"
                        echo "================================================"

                        if aws dynamodb describe-table \
                            --table-name "$TABLE" \
                            --region "$AWS_REGION" >/dev/null 2>&1
                        then

                            aws dynamodb delete-table \
                                --table-name "$TABLE" \
                                --region "$AWS_REGION"

                            echo ""
                            echo "DynamoDB deletion requested."

                        else

                            echo "DynamoDB lock table already does not exist."

                        fi

                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // 22
        // ============================================================

        stage('22 - Wait For DynamoDB Table Deletion') {

            when {

                expression {

                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials(
                    [
                        usernamePassword(
                            credentialsId: 'aws-creds',
                            usernameVariable: 'AWS_ACCESS_KEY_ID',
                            passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                        )
                    ]
                ) {

                    sh '''
                        set -eu

                        export AWS_ACCESS_KEY_ID="$AWS_ACCESS_KEY_ID"
                        export AWS_SECRET_ACCESS_KEY="$AWS_SECRET_ACCESS_KEY"
                        export AWS_DEFAULT_REGION="$AWS_DEFAULT_REGION"
                        export AWS_REGION="$AWS_REGION"

                        TABLE="$DYNAMODB_LOCK_TABLE"

                        echo "================================================"
                        echo "WAITING FOR DYNAMODB DELETION"
                        echo "================================================"

                        MAX_ATTEMPTS=40
                        ATTEMPT=1

                        while [ "$ATTEMPT" -le "$MAX_ATTEMPTS" ]
                        do

                            if aws dynamodb describe-table \
                                --table-name "$TABLE" \
                                --region "$AWS_REGION" >/dev/null 2>&1
                            then

                                echo "DynamoDB table still exists."
                                echo "Attempt $ATTEMPT/$MAX_ATTEMPTS"

                                sleep 5

                            else

                                echo ""
                                echo "DynamoDB table deletion completed."
                                exit 0

                            fi

                            ATTEMPT=$((ATTEMPT + 1))

                        done

                        echo "ERROR: DynamoDB table still exists."
                        exit 1
                    '''
                }
            }
        }


        // ============================================================
        // 23
        // ============================================================

        stage('23 - Final Destruction Verification') {

            steps {

                withCredentials(
                    [
                        usernamePassword(
                            credentialsId: 'aws-creds',
                            usernameVariable: 'AWS_ACCESS_KEY_ID',
                            passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                        )
                    ]
                ) {

                    sh '''
                        set -eu

                        export AWS_ACCESS_KEY_ID="$AWS_ACCESS_KEY_ID"
                        export AWS_SECRET_ACCESS_KEY="$AWS_SECRET_ACCESS_KEY"
                        export AWS_DEFAULT_REGION="$AWS_DEFAULT_REGION"
                        export AWS_REGION="$AWS_REGION"

                        echo "================================================"
                        echo "FINAL DESTRUCTION VERIFICATION"
                        echo "================================================"

                        FAILED=0

                        echo ""
                        echo "Checking S3 backend bucket..."

                        if aws s3api head-bucket \
                            --bucket "$TERRAFORM_BACKEND_BUCKET" \
                            --region "$AWS_REGION" >/dev/null 2>&1
                        then

                            echo "ERROR: S3 backend bucket still exists."
                            FAILED=1

                        else

                            echo "OK: S3 backend bucket does not exist."

                        fi


                        echo ""
                        echo "Checking DynamoDB lock table..."

                        if aws dynamodb describe-table \
                            --table-name "$DYNAMODB_LOCK_TABLE" \
                            --region "$AWS_REGION" >/dev/null 2>&1
                        then

                            echo "ERROR: DynamoDB lock table still exists."
                            FAILED=1

                        else

                            echo "OK: DynamoDB lock table does not exist."

                        fi


                        if [ "$FAILED" -ne 0 ]
                        then

                            echo ""
                            echo "================================================"
                            echo "FINAL VERIFICATION FAILED"
                            echo "================================================"

                            exit 1

                        fi


                        echo ""
                        echo "================================================"
                        echo "FINAL VERIFICATION PASSED"
                        echo "================================================"
                        echo "Terraform backend has been completely removed."
                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // 24
        // ============================================================

        stage('24 - Final Destruction Report') {

            steps {

                echo ''
                echo '================================================'
                echo '        FINAL DESTRUCTION REPORT'
                echo '================================================'
                echo ''
                echo "Environment              : ${params.ENVIRONMENT}"
                echo "AWS Region               : ${params.AWS_REGION}"
                echo ''
                echo 'Terraform Infrastructure : DESTROYED'
                echo ''
                echo "Terraform State Bucket   : ${params.TERRAFORM_BACKEND_BUCKET}"
                echo 'S3 Backend Bucket        : DELETED'
                echo 'S3 State Object          : DELETED'
                echo 'S3 Object Versions       : DELETED'
                echo 'S3 Delete Markers        : DELETED'
                echo ''
                echo "DynamoDB Lock Table      : ${params.DYNAMODB_LOCK_TABLE}"
                echo 'DynamoDB Lock Table      : DELETED'
                echo ''
                echo 'Terraform Lock           : VERIFIED CLEAR'
                echo 'Final Verification       : PASSED'
                echo ''
                echo '================================================'
                echo '        DESTROY COMPLETED SUCCESSFULLY'
                echo '================================================'
                echo ''
            }
        }
    }


    // ================================================================
    // POST ACTIONS
    // ================================================================

    post {

        always {

            echo ''
            echo '================================================'
            echo '        CLEANING JENKINS WORKSPACE'
            echo '================================================'

            cleanWs()

            echo ''
        }


        success {

            echo ''
            echo '================================================'
            echo '        DESTROY PIPELINE SUCCESSFUL'
            echo '================================================'
            echo "Environment : ${params.ENVIRONMENT}"
            echo "Build       : ${env.BUILD_NUMBER}"
            echo "Region      : ${params.AWS_REGION}"
            echo ''
            echo 'Terraform infrastructure destroyed.'
            echo 'Terraform backend cleanup completed.'
            echo 'S3 and DynamoDB verification passed.'
            echo '================================================'
            echo ''
        }


        failure {

            echo ''
            echo '================================================'
            echo '        DESTROY PIPELINE FAILED'
            echo '================================================'
            echo "Environment : ${params.ENVIRONMENT}"
            echo "Build       : ${env.BUILD_NUMBER}"
            echo "Region      : ${params.AWS_REGION}"
            echo ''
            echo 'The pipeline stopped at the failed stage.'
            echo ''
            echo 'If the failure occurred before backend deletion,'
            echo 'the Terraform S3/DynamoDB backend was intentionally'
            echo 'protected.'
            echo ''
            echo 'Check the failed stage in the Jenkins console.'
            echo '================================================'
            echo ''
        }
    }
}
