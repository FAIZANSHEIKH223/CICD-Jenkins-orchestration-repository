pipeline {

    agent any

    // ================================================================
    // PIPELINE OPTIONS
    // ================================================================

    options {

        timestamps()

        ansiColor('xterm')

        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                daysToKeepStr: '30',
                numToKeepStr: '50'
            )
        )

        timeout(
            time: 90,
            unit: 'MINUTES'
        )
    }


    // ================================================================
    // PARAMETERS
    // ================================================================

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: [
                'dev',
                'qa',
                'prod'
            ],
            description: 'Environment to destroy'
        )

        booleanParam(
            name: 'CONFIRM_DESTROY',
            defaultValue: false,
            description: 'MUST be checked to permanently delete AWS resources'
        )
    }


    // ================================================================
    // ENVIRONMENT
    // ================================================================

    environment {

        // ------------------------------------------------------------
        // AWS
        // ------------------------------------------------------------

        AWS_REGION = 'us-east-1'

        AWS_ACCOUNT_ID = '103282536465'

        AWS_CREDENTIALS = 'aws-creds'


        // ------------------------------------------------------------
        // GITHUB
        // ------------------------------------------------------------

        GITHUB_CREDENTIALS = 'github-creds'

        TERRAFORM_REPO =
            'https://github.com/FAIZANSHEIKH223/terraform-aws-infra.git'

        TERRAFORM_BRANCH = 'main'

        TERRAFORM_DIR = 'terraform-infra'


        // ------------------------------------------------------------
        // APPLICATION
        // ------------------------------------------------------------

        APP_NAME = 'practice1'


        // ------------------------------------------------------------
        // ECR
        // ------------------------------------------------------------

        ECR_REPOSITORY = 'practice1'


        // ------------------------------------------------------------
        // ECS
        // ------------------------------------------------------------

        ECS_CLUSTER = "practice1-${params.ENVIRONMENT}-cluster"

        ECS_SERVICE = "practice1-${params.ENVIRONMENT}-service"

        ECS_TASK_FAMILY = "practice1-${params.ENVIRONMENT}-task"


        // ------------------------------------------------------------
        // LOAD BALANCER
        // ------------------------------------------------------------

        ALB_NAME = "practice1-${params.ENVIRONMENT}-alb"

        TARGET_GROUP_NAME = "practice1-${params.ENVIRONMENT}-tg"


        // ------------------------------------------------------------
        // SECURITY GROUPS
        // ------------------------------------------------------------

        ALB_SG_NAME = "practice1-${params.ENVIRONMENT}-alb-sg"

        ECS_SG_NAME = "practice1-${params.ENVIRONMENT}-ecs-sg"


        // ------------------------------------------------------------
        // TERRAFORM BACKEND
        // ------------------------------------------------------------

        TF_STATE_BUCKET = 'terraform-state-faizan-001'

        TF_LOCK_TABLE = 'terraform-locks'


        // ------------------------------------------------------------
        // AWS VPC
        // ------------------------------------------------------------

        VPC_ID = 'vpc-045d80e8f7e1275ae'
    }


    // ================================================================
    // STAGES
    // ================================================================

    stages {


        // ============================================================
        // 01 - CONFIRM DESTROY
        // ============================================================

        stage('01 - Confirm Destroy') {

            steps {

                script {

                    if (params.CONFIRM_DESTROY != true) {

                        error(
                            'CONFIRM_DESTROY must be checked. ' +
                            'No AWS resources were deleted.'
                        )
                    }

                    echo '================================================'
                    echo '        AWS DESTROY PIPELINE'
                    echo '================================================'
                    echo "Environment : ${params.ENVIRONMENT}"
                    echo "Region      : ${AWS_REGION}"
                    echo "Application : ${APP_NAME}"
                    echo '================================================'
                }
            }
        }


        // ============================================================
        // 02 - AWS IDENTITY
        // ============================================================

        stage('02 - Verify AWS Credentials') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set +e

                        echo "Checking AWS credentials..."

                        aws sts get-caller-identity \
                            --region "${AWS_REGION}" \
                            --output json

                        RC=$?

                        if [ $RC -ne 0 ]; then
                            echo "WARNING: AWS identity check failed."
                            echo "Continuing so cleanup remains idempotent."
                        else
                            echo "AWS credentials are valid."
                        fi

                        exit 0
                    '''
                }
            }
        }


        // ============================================================
        // 03 - DELETE ECS SERVICE
        // ============================================================

        stage('03 - Delete ECS Service') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "DELETING ECS SERVICE"
                        echo "================================================"

                        SERVICE_STATUS=$(aws ecs describe-services \
                            --region "${AWS_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}" \
                            --query 'services[0].status' \
                            --output text 2>/dev/null)

                        if [ "$SERVICE_STATUS" = "ACTIVE" ] ||
                           [ "$SERVICE_STATUS" = "DRAINING" ]; then

                            echo "ECS service status: $SERVICE_STATUS"

                            echo "Scaling service to zero..."

                            aws ecs update-service \
                                --region "${AWS_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --service "${ECS_SERVICE}" \
                                --desired-count 0 \
                                --force-new-deployment \
                                >/dev/null 2>&1

                            sleep 10

                            echo "Deleting ECS service..."

                            aws ecs delete-service \
                                --region "${AWS_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --service "${ECS_SERVICE}" \
                                --force \
                                >/dev/null 2>&1

                            echo "ECS delete request submitted."

                        elif [ "$SERVICE_STATUS" = "INACTIVE" ]; then

                            echo "ECS service is already INACTIVE."

                        else

                            echo "ECS service does not exist."
                            echo "Nothing to delete."

                        fi

                        exit 0
                    '''
                }
            }
        }


        // ============================================================
        // 04 - WAIT FOR ECS SERVICE DELETION
        // ============================================================

        stage('04 - Wait for ECS Service Deletion') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "WAITING FOR ECS SERVICE DELETION"
                        echo "================================================"

                        for i in $(seq 1 30); do

                            STATUS=$(aws ecs describe-services \
                                --region "${AWS_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --services "${ECS_SERVICE}" \
                                --query 'services[0].status' \
                                --output text 2>/dev/null)

                            if [ "$STATUS" = "ACTIVE" ] ||
                               [ "$STATUS" = "DRAINING" ]; then

                                echo "Attempt $i/30: service still exists: $STATUS"
                                sleep 10

                            else

                                echo "ECS service is deleted/not found."
                                break

                            fi

                        done

                        exit 0
                    '''
                }
            }
        }


        // ============================================================
        // 05 - STOP REMAINING ECS TASKS
        // ============================================================

        stage('05 - Stop Remaining ECS Tasks') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "STOPPING REMAINING ECS TASKS"
                        echo "================================================"

                        TASKS=$(aws ecs list-tasks \
                            --region "${AWS_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --desired-status RUNNING \
                            --query 'taskArns[]' \
                            --output text 2>/dev/null)

                        if [ -n "$TASKS" ] && [ "$TASKS" != "None" ]; then

                            for TASK in $TASKS; do

                                echo "Stopping task: $TASK"

                                aws ecs stop-task \
                                    --region "${AWS_REGION}" \
                                    --cluster "${ECS_CLUSTER}" \
                                    --task "$TASK" \
                                    --reason "Jenkins destroy pipeline" \
                                    >/dev/null 2>&1

                            done

                        else

                            echo "No running ECS tasks found."

                        fi

                        exit 0
                    '''
                }
            }
        }


        // ============================================================
        // 06 - DELETE ALB LISTENERS
        // ============================================================

        stage('06 - Delete ALB Listeners') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "DELETING ALB LISTENERS"
                        echo "================================================"

                        ALB_ARN=$(aws elbv2 describe-load-balancers \
                            --region "${AWS_REGION}" \
                            --names "${ALB_NAME}" \
                            --query 'LoadBalancers[0].LoadBalancerArn' \
                            --output text 2>/dev/null)

                        if [ -n "$ALB_ARN" ] &&
                           [ "$ALB_ARN" != "None" ]; then

                            echo "ALB ARN: $ALB_ARN"

                            LISTENERS=$(aws elbv2 describe-listeners \
                                --region "${AWS_REGION}" \
                                --load-balancer-arn "$ALB_ARN" \
                                --query 'Listeners[].ListenerArn' \
                                --output text 2>/dev/null)

                            for LISTENER in $LISTENERS; do

                                echo "Deleting listener: $LISTENER"

                                aws elbv2 delete-listener \
                                    --region "${AWS_REGION}" \
                                    --listener-arn "$LISTENER" \
                                    >/dev/null 2>&1

                            done

                        else

                            echo "ALB not found."
                            echo "No listeners to delete."

                        fi

                        exit 0
                    '''
                }
            }
        }


        // ============================================================
        // 07 - DELETE ALB
        // ============================================================

        stage('07 - Delete Application Load Balancer') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "DELETING APPLICATION LOAD BALANCER"
                        echo "================================================"

                        ALB_ARN=$(aws elbv2 describe-load-balancers \
                            --region "${AWS_REGION}" \
                            --names "${ALB_NAME}" \
                            --query 'LoadBalancers[0].LoadBalancerArn' \
                            --output text 2>/dev/null)

                        if [ -n "$ALB_ARN" ] &&
                           [ "$ALB_ARN" != "None" ]; then

                            echo "Deleting ALB: $ALB_NAME"

                            aws elbv2 delete-load-balancer \
                                --region "${AWS_REGION}" \
                                --load-balancer-arn "$ALB_ARN" \
                                >/dev/null 2>&1

                            echo "ALB deletion requested."

                        else

                            echo "ALB already deleted."

                        fi

                        exit 0
                    '''
                }
            }
        }


        // ============================================================
        // 08 - WAIT FOR ALB
        // ============================================================

        stage('08 - Wait for ALB Deletion') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set +e

                        echo "Waiting for ALB deletion..."

                        for i in $(seq 1 30); do

                            aws elbv2 describe-load-balancers \
                                --region "${AWS_REGION}" \
                                --names "${ALB_NAME}" \
                                >/dev/null 2>&1

                            if [ $? -ne 0 ]; then

                                echo "ALB deleted."
                                break

                            fi

                            echo "Attempt $i/30: ALB still exists."
                            sleep 10

                        done

                        exit 0
                    '''
                }
            }
        }


        // ============================================================
        // 09 - DELETE TARGET GROUP
        // ============================================================

        stage('09 - Delete Target Group') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "DELETING TARGET GROUP"
                        echo "================================================"

                        TG_ARN=$(aws elbv2 describe-target-groups \
                            --region "${AWS_REGION}" \
                            --names "${TARGET_GROUP_NAME}" \
                            --query 'TargetGroups[0].TargetGroupArn' \
                            --output text 2>/dev/null)

                        if [ -n "$TG_ARN" ] &&
                           [ "$TG_ARN" != "None" ]; then

                            echo "Deleting target group..."

                            aws elbv2 delete-target-group \
                                --region "${AWS_REGION}" \
                                --target-group-arn "$TG_ARN" \
                                >/dev/null 2>&1

                            echo "Target group deletion requested."

                        else

                            echo "Target group already deleted."

                        fi

                        exit 0
                    '''
                }
            }
        }


        // ============================================================
        // 10 - DEREGISTER ECS TASK DEFINITIONS
        // ============================================================

        stage('10 - Deregister ECS Task Definitions') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "DEREGISTERING ECS TASK DEFINITIONS"
                        echo "================================================"

                        REVISIONS=$(aws ecs list-task-definitions \
                            --region "${AWS_REGION}" \
                            --family-prefix "${ECS_TASK_FAMILY}" \
                            --status ACTIVE \
                            --query 'taskDefinitionArns[]' \
                            --output text 2>/dev/null)

                        if [ -n "$REVISIONS" ] &&
                           [ "$REVISIONS" != "None" ]; then

                            for TASK_DEF in $REVISIONS; do

                                echo "Deregistering: $TASK_DEF"

                                aws ecs deregister-task-definition \
                                    --region "${AWS_REGION}" \
                                    --task-definition "$TASK_DEF" \
                                    >/dev/null 2>&1

                            done

                        else

                            echo "No active task definitions found."

                        fi

                        exit 0
                    '''
                }
            }
        }


        // ============================================================
        // 11 - DELETE ECS CLUSTER
        // ============================================================

        stage('11 - Delete ECS Cluster') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "DELETING ECS CLUSTER"
                        echo "================================================"

                        CLUSTER_STATUS=$(aws ecs describe-clusters \
                            --region "${AWS_REGION}" \
                            --clusters "${ECS_CLUSTER}" \
                            --query 'clusters[0].status' \
                            --output text 2>/dev/null)

                        if [ "$CLUSTER_STATUS" = "ACTIVE" ]; then

                            echo "Deleting ECS cluster..."

                            aws ecs delete-cluster \
                                --region "${AWS_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                >/dev/null 2>&1

                            echo "ECS cluster deletion requested."

                        elif [ "$CLUSTER_STATUS" = "INACTIVE" ]; then

                            echo "ECS cluster is already INACTIVE."

                        else

                            echo "ECS cluster does not exist."

                        fi

                        exit 0
                    '''
                }
            }
        }


        // ============================================================
        // 12 - WAIT FOR ECS CLUSTER
        // ============================================================

        stage('12 - Wait for ECS Cluster Deletion') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set +e

                        echo "Waiting for ECS cluster deletion..."

                        for i in $(seq 1 30); do

                            STATUS=$(aws ecs describe-clusters \
                                --region "${AWS_REGION}" \
                                --clusters "${ECS_CLUSTER}" \
                                --query 'clusters[0].status' \
                                --output text 2>/dev/null)

                            if [ "$STATUS" = "INACTIVE" ] ||
                               [ -z "$STATUS" ] ||
                               [ "$STATUS" = "None" ]; then

                                echo "ECS cluster is inactive/deleted."
                                break

                            fi

                            echo "Attempt $i/30: cluster status = $STATUS"
                            sleep 5

                        done

                        exit 0
                    '''
                }
            }
        }


        // ============================================================
        // 13 - DELETE IAM EXECUTION ROLE
        // ============================================================

        stage('13 - Delete ECS IAM Execution Role') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set +e

                        ROLE_NAME="practice1-ecsTaskExecutionRole"

                        echo "================================================"
                        echo "DELETING ECS IAM EXECUTION ROLE"
                        echo "================================================"

                        aws iam get-role \
                            --role-name "$ROLE_NAME" \
                            >/dev/null 2>&1

                        if [ $? -ne 0 ]; then

                            echo "IAM role does not exist."
                            exit 0

                        fi


                        echo "Removing attached managed policies..."

                        ATTACHED_POLICIES=$(aws iam list-attached-role-policies \
                            --role-name "$ROLE_NAME" \
                            --query 'AttachedPolicies[].PolicyArn' \
                            --output text 2>/dev/null)

                        for POLICY in $ATTACHED_POLICIES; do

                            echo "Detaching policy: $POLICY"

                            aws iam detach-role-policy \
                                --role-name "$ROLE_NAME" \
                                --policy-arn "$POLICY" \
                                >/dev/null 2>&1

                        done


                        echo "Removing inline policies..."

                        INLINE_POLICIES=$(aws iam list-role-policies \
                            --role-name "$ROLE_NAME" \
                            --query 'PolicyNames[]' \
                            --output text 2>/dev/null)

                        for POLICY_NAME in $INLINE_POLICIES; do

                            echo "Deleting inline policy: $POLICY_NAME"

                            aws iam delete-role-policy \
                                --role-name "$ROLE_NAME" \
                                --policy-name "$POLICY_NAME" \
                                >/dev/null 2>&1

                        done


                        echo "Deleting IAM role..."

                        aws iam delete-role \
                            --role-name "$ROLE_NAME" \
                            >/dev/null 2>&1

                        if [ $? -eq 0 ]; then
                            echo "IAM execution role deleted."
                        else
                            echo "IAM role deletion returned an error."
                            echo "Continuing because cleanup is idempotent."
                        fi

                        exit 0
                    '''
                }
            }
        }


        // ============================================================
        // 14 - DELETE ECR
        // ============================================================

        stage('14 - Delete ECR Repository and Images') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "DELETING ECR REPOSITORY"
                        echo "================================================"

                        aws ecr describe-repositories \
                            --repository-names "${ECR_REPOSITORY}" \
                            --region "${AWS_REGION}" \
                            >/dev/null 2>&1

                        if [ $? -eq 0 ]; then

                            echo "Deleting ECR repository and ALL images..."

                            aws ecr delete-repository \
                                --repository-name "${ECR_REPOSITORY}" \
                                --region "${AWS_REGION}" \
                                --force

                            echo "ECR deletion command completed."

                        else

                            echo "ECR repository already deleted."

                        fi

                        exit 0
                    '''
                }
            }
        }


        // ============================================================
        // 15 - DELETE SECURITY GROUPS
        // ============================================================

        stage('15 - Delete Security Groups') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "DELETING SECURITY GROUPS"
                        echo "================================================"


                        delete_sg_by_name() {

                            SG_NAME="$1"

                            echo ""
                            echo "Processing SG: $SG_NAME"

                            SG_ID=$(aws ec2 describe-security-groups \
                                --region "${AWS_REGION}" \
                                --filters "Name=group-name,Values=${SG_NAME}" \
                                --query 'SecurityGroups[0].GroupId' \
                                --output text 2>/dev/null)

                            if [ -z "$SG_ID" ] ||
                               [ "$SG_ID" = "None" ]; then

                                echo "Security group does not exist."
                                return 0

                            fi


                            echo "Security Group ID: $SG_ID"


                            for ATTEMPT in $(seq 1 12); do

                                echo "Delete attempt $ATTEMPT/12"

                                aws ec2 delete-security-group \
                                    --region "${AWS_REGION}" \
                                    --group-id "$SG_ID"

                                RC=$?

                                if [ $RC -eq 0 ]; then

                                    echo "Security group deleted."
                                    return 0

                                fi


                                echo "Security group still has dependencies."
                                echo "Waiting 10 seconds..."

                                sleep 10

                            done


                            echo "WARNING: Could not delete $SG_NAME."
                            echo "Terraform will attempt cleanup later."

                            return 0
                        }


                        delete_sg_by_name "${ECS_SG_NAME}"

                        delete_sg_by_name "${ALB_SG_NAME}"

                        exit 0
                    '''
                }
            }
        }


        // ============================================================
        // 16 - VERIFY ECS CLEANUP
        // ============================================================

        stage('16 - Verify ECS Cleanup') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "VERIFYING ECS CLEANUP"
                        echo "================================================"


                        echo "ECS Service:"

                        SERVICE=$(aws ecs describe-services \
                            --region "${AWS_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}" \
                            --query 'services[0].status' \
                            --output text 2>/dev/null)

                        echo "${SERVICE}"


                        echo ""
                        echo "ECS Cluster:"

                        CLUSTER=$(aws ecs describe-clusters \
                            --region "${AWS_REGION}" \
                            --clusters "${ECS_CLUSTER}" \
                            --query 'clusters[0].status' \
                            --output text 2>/dev/null)

                        echo "${CLUSTER}"


                        echo ""
                        echo "Running Tasks:"

                        TASKS=$(aws ecs list-tasks \
                            --region "${AWS_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --desired-status RUNNING \
                            --query 'taskArns[]' \
                            --output text 2>/dev/null)

                        echo "${TASKS}"

                        exit 0
                    '''
                }
            }
        }


        // ============================================================
        // 17 - VERIFY ALB CLEANUP
        // ============================================================

        stage('17 - Verify ALB Cleanup') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "VERIFYING ALB CLEANUP"
                        echo "================================================"


                        echo "ALB:"

                        aws elbv2 describe-load-balancers \
                            --region "${AWS_REGION}" \
                            --names "${ALB_NAME}" \
                            --query 'LoadBalancers[0].LoadBalancerArn' \
                            --output text 2>/dev/null

                        echo ""
                        echo "Target Group:"

                        aws elbv2 describe-target-groups \
                            --region "${AWS_REGION}" \
                            --names "${TARGET_GROUP_NAME}" \
                            --query 'TargetGroups[0].TargetGroupArn' \
                            --output text 2>/dev/null

                        exit 0
                    '''
                }
            }
        }


        // ============================================================
        // 18 - VERIFY ECR
        // ============================================================

        stage('18 - Verify ECR Cleanup') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "VERIFYING ECR CLEANUP"
                        echo "================================================"

                        aws ecr describe-repositories \
                            --repository-names "${ECR_REPOSITORY}" \
                            --region "${AWS_REGION}" \
                            >/dev/null 2>&1

                        if [ $? -eq 0 ]; then
                            echo "WARNING: ECR repository still exists."
                        else
                            echo "ECR repository deleted."
                        fi

                        exit 0
                    '''
                }
            }
        }


        // ============================================================
        // 19 - CHECKOUT TERRAFORM
        // ============================================================

        stage('19 - Checkout Terraform Repository') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    git(
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${TERRAFORM_REPO}",
                        branch: "${TERRAFORM_BRANCH}"
                    )
                }
            }
        }


        // ============================================================
        // 20 - TERRAFORM INIT
        // ============================================================

        stage('20 - Terraform Init') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    withCredentials([
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${AWS_CREDENTIALS}"
                        ]
                    ]) {

                        sh '''
                            set +e

                            echo "================================================"
                            echo "TERRAFORM INIT"
                            echo "================================================"

                            terraform init -reconfigure

                            RC=$?

                            if [ $RC -ne 0 ]; then

                                echo "WARNING: Terraform init failed."
                                echo "Continuing because manual AWS cleanup already ran."

                            fi

                            exit 0
                        '''
                    }
                }
            }
        }


        // ============================================================
        // 21 - TERRAFORM VALIDATE
        // ============================================================

        stage('21 - Terraform Validate') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    sh '''
                        set +e

                        terraform validate

                        if [ $? -ne 0 ]; then
                            echo "WARNING: Terraform validation failed."
                        fi

                        exit 0
                    '''
                }
            }
        }


        // ============================================================
        // 22 - TERRAFORM STATE
        // ============================================================

        stage('22 - Terraform State Before Destroy') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    withCredentials([
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${AWS_CREDENTIALS}"
                        ]
                    ]) {

                        sh '''
                            set +e

                            echo "================================================"
                            echo "TERRAFORM STATE BEFORE DESTROY"
                            echo "================================================"

                            terraform state list

                            exit 0
                        '''
                    }
                }
            }
        }


        // ============================================================
        // 23 - TERRAFORM DESTROY
        // ============================================================

        stage('23 - Terraform Destroy') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    withCredentials([
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${AWS_CREDENTIALS}"
                        ]
                    ]) {

                        sh """
                            set +e

                            echo "================================================"
                            echo "RUNNING TERRAFORM DESTROY"
                            echo "================================================"

                            terraform destroy \\
                                -auto-approve \\
                                -var-file="environments/${params.ENVIRONMENT}/terraform.tfvars"

                            RC=\\$?

                            if [ \\$RC -ne 0 ]; then

                                echo ""
                                echo "WARNING: Terraform destroy returned exit code \\$RC."
                                echo "Manual AWS cleanup has already been attempted."
                                echo "Continuing to final verification."

                            else

                                echo "Terraform destroy completed."

                            fi

                            exit 0
                        """
                    }
                }
            }
        }


        // ============================================================
        // 24 - TERRAFORM STATE AFTER DESTROY
        // ============================================================

        stage('24 - Verify Terraform Destruction') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    withCredentials([
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${AWS_CREDENTIALS}"
                        ]
                    ]) {

                        sh '''
                            set +e

                            echo "================================================"
                            echo "TERRAFORM STATE AFTER DESTROY"
                            echo "================================================"

                            terraform state list

                            exit 0
                        '''
                    }
                }
            }
        }


        // ============================================================
        // 25 - FINAL AWS VERIFICATION
        // ============================================================

        stage('25 - Final AWS Cleanup Verification') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set +e

                        echo ""
                        echo "================================================"
                        echo "FINAL AWS CLEANUP VERIFICATION"
                        echo "================================================"


                        echo ""
                        echo "1. ECS SERVICE"

                        aws ecs describe-services \
                            --region "${AWS_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}" \
                            --query 'services[0].status' \
                            --output text 2>/dev/null


                        echo ""
                        echo "2. ECS CLUSTER"

                        aws ecs describe-clusters \
                            --region "${AWS_REGION}" \
                            --clusters "${ECS_CLUSTER}" \
                            --query 'clusters[0].status' \
                            --output text 2>/dev/null


                        echo ""
                        echo "3. ALB"

                        aws elbv2 describe-load-balancers \
                            --region "${AWS_REGION}" \
                            --names "${ALB_NAME}" \
                            --query 'LoadBalancers[0].LoadBalancerArn' \
                            --output text 2>/dev/null


                        echo ""
                        echo "4. TARGET GROUP"

                        aws elbv2 describe-target-groups \
                            --region "${AWS_REGION}" \
                            --names "${TARGET_GROUP_NAME}" \
                            --query 'TargetGroups[0].TargetGroupArn' \
                            --output text 2>/dev/null


                        echo ""
                        echo "5. ECR"

                        aws ecr describe-repositories \
                            --region "${AWS_REGION}" \
                            --repository-names "${ECR_REPOSITORY}" \
                            --query 'repositories[0].repositoryName' \
                            --output text 2>/dev/null


                        echo ""
                        echo "6. IAM ROLE"

                        aws iam get-role \
                            --role-name practice1-ecsTaskExecutionRole \
                            --query 'Role.RoleName' \
                            --output text 2>/dev/null


                        echo ""
                        echo "7. SECURITY GROUPS"

                        aws ec2 describe-security-groups \
                            --region "${AWS_REGION}" \
                            --filters \
                                "Name=group-name,Values=${ALB_SG_NAME},${ECS_SG_NAME}" \
                            --query 'SecurityGroups[].GroupId' \
                            --output text 2>/dev/null


                        echo ""
                        echo "================================================"
                        echo "FINAL VERIFICATION COMPLETE"
                        echo "================================================"

                        exit 0
                    '''
                }
            }
        }


        // ============================================================
        // 26 - VERIFY TERRAFORM BACKEND REMAINS
        // ============================================================

        stage('26 - Verify Terraform Backend Remains') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "VERIFYING TERRAFORM BACKEND"
                        echo "================================================"


                        echo "S3 State Bucket:"

                        aws s3api head-bucket \
                            --bucket "${TF_STATE_BUCKET}" \
                            --region "${AWS_REGION}" \
                            >/dev/null 2>&1

                        if [ $? -eq 0 ]; then

                            echo "Terraform state bucket EXISTS."
                            echo "This is intentional."

                        else

                            echo "WARNING: Terraform state bucket not found."

                        fi


                        echo ""
                        echo "DynamoDB Lock Table:"

                        aws dynamodb describe-table \
                            --table-name "${TF_LOCK_TABLE}" \
                            --region "${AWS_REGION}" \
                            >/dev/null 2>&1

                        if [ $? -eq 0 ]; then

                            echo "Terraform lock table EXISTS."
                            echo "This is intentional."

                        else

                            echo "WARNING: Terraform lock table not found."

                        fi


                        exit 0
                    '''
                }
            }
        }


        // ============================================================
        // 27 - DESTROY SUMMARY
        // ============================================================

        stage('27 - Destroy Summary') {

            steps {

                echo ''
                echo '================================================'
                echo '           DESTROY PIPELINE COMPLETE'
                echo '================================================'
                echo ''
                echo "Application : ${APP_NAME}"
                echo "Environment : ${params.ENVIRONMENT}"
                echo "Region      : ${AWS_REGION}"
                echo ''
                echo 'Cleanup attempted for:'
                echo '  - ECS Service'
                echo '  - ECS Tasks'
                echo '  - ECS Cluster'
                echo '  - ECS Task Definitions'
                echo '  - ALB Listeners'
                echo '  - Application Load Balancer'
                echo '  - Target Group'
                echo '  - IAM Execution Role'
                echo '  - ECR Repository + Images'
                echo '  - Security Groups'
                echo '  - Terraform-managed resources'
                echo ''
                echo 'Terraform backend was intentionally preserved.'
                echo ''
                echo '================================================'
            }
        }
    }


    // ================================================================
    // POST ACTIONS
    // ================================================================

    post {

        always {

            echo ''
            echo '================================================'
            echo 'CLEANING JENKINS WORKSPACE'
            echo '================================================'

            cleanWs()
        }


        success {

            echo ''
            echo '================================================'
            echo '       DESTROY PIPELINE COMPLETED'
            echo '================================================'
            echo ''
            echo 'The cleanup pipeline completed all stages.'
            echo 'Already-deleted AWS resources were treated as'
            echo 'successful cleanup instead of failures.'
            echo ''
        }


        failure {

            echo ''
            echo '================================================'
            echo '       DESTROY PIPELINE FAILED'
            echo '================================================'
            echo ''
            echo 'A Jenkins-level error occurred.'
            echo 'Review the console output.'
            echo ''
        }
    }
}
