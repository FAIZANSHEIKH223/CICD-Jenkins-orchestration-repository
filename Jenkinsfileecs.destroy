pipeline {

    agent any

    // ================================================================
    // PIPELINE OPTIONS
    // ================================================================

    options {

        timestamps()

        ansiColor('xterm')

        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                daysToKeepStr: '30',
                numToKeepStr: '50'
            )
        )

        timeout(
            time: 90,
            unit: 'MINUTES'
        )
    }

    // ================================================================
    // PARAMETERS
    // ================================================================

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: [
                'dev',
                'qa',
                'stage',
                'prod'
            ],
            description: 'Terraform environment to destroy'
        )

        booleanParam(
            name: 'DELETE_ECR',
            defaultValue: true,
            description: 'Delete ECR repository and all images'
        )

        booleanParam(
            name: 'DELETE_IAM_ROLE',
            defaultValue: true,
            description: 'Delete ECS execution IAM role'
        )

        booleanParam(
            name: 'DELETE_LOG_GROUP',
            defaultValue: true,
            description: 'Delete ECS CloudWatch log group'
        )

        booleanParam(
            name: 'RUN_TERRAFORM_DESTROY',
            defaultValue: true,
            description: 'Destroy Terraform-managed infrastructure'
        )
    }

    // ================================================================
    // ENVIRONMENT
    // ================================================================

    environment {

        // ============================================================
        // GITHUB
        // ============================================================

        QUALITY_REPO = 'https://github.com/FAIZANSHEIKH223/pylint_flake8_int_jenkins.git'
        QUALITY_BRANCH = 'main'

        TERRAFORM_REPO = 'https://github.com/FAIZANSHEIKH223/terraform-aws-infra.git'
        TERRAFORM_BRANCH = 'main'

        GITHUB_CREDENTIALS = 'github-creds'
        AWS_CREDENTIALS = 'aws-creds'

        // ============================================================
        // DIRECTORIES
        // ============================================================

        QUALITY_DIR = 'quality-tools'
        TERRAFORM_DIR = 'terraform-infra'

        // ============================================================
        // AWS
        // ============================================================

        AWS_DEFAULT_REGION = 'us-east-1'

        // ============================================================
        // APPLICATION
        // ============================================================

        APP_NAME = 'practice1'
        CONTAINER_NAME = 'practice1'
        CONTAINER_PORT = '8501'

        // ============================================================
        // ECR
        // ============================================================

        ECR_REPOSITORY = 'practice1'

        // ============================================================
        // ECS
        // ============================================================

        ECS_CLUSTER = "practice1-${ENVIRONMENT}-cluster"
        ECS_SERVICE = "practice1-${ENVIRONMENT}-service"
        ECS_TASK_FAMILY = "practice1-${ENVIRONMENT}-task"
        ECS_CONTAINER_NAME = 'practice1'

        // ============================================================
        // LOAD BALANCER
        // ============================================================

        ALB_NAME = "practice1-${ENVIRONMENT}-alb"
        TARGET_GROUP_NAME = "practice1-${ENVIRONMENT}-tg"

        ALB_SG_NAME = "practice1-${ENVIRONMENT}-alb-sg"
        ECS_SG_NAME = "practice1-${ENVIRONMENT}-ecs-sg"

        // ============================================================
        // IAM
        // ============================================================

        EXECUTION_ROLE_NAME = 'practice1-ecsTaskExecutionRole'

        // ============================================================
        // TERRAFORM
        // ============================================================

        TF_STATE_BUCKET = 'terraform-state-faizan-001'
        TF_LOCK_TABLE = 'terraform-locks'

        TF_IN_AUTOMATION = 'true'
        TF_INPUT = 'false'
    }

    // ================================================================
    // STAGES
    // ================================================================

    stages {

        // ============================================================
        // 1. AWS VERIFICATION
        // ============================================================

        stage('1 - AWS Verification') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "AWS VERIFICATION"
                        echo "================================================"

                        command -v aws

                        aws --version

                        aws sts get-caller-identity \
                            --region "${AWS_DEFAULT_REGION}"

                        echo ""
                        echo "Environment:"
                        echo "${ENVIRONMENT}"

                        echo ""
                        echo "Region:"
                        echo "${AWS_DEFAULT_REGION}"
                    '''
                }
            }
        }

        // ============================================================
        // 2. DISCOVER AWS RESOURCES
        // ============================================================

        stage('2 - Discover AWS Resources') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        env.ALB_ARN = sh(
                            script: '''
                                aws elbv2 describe-load-balancers \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --names "${ALB_NAME}" \
                                    --query 'LoadBalancers[0].LoadBalancerArn' \
                                    --output text \
                                    2>/dev/null || true
                            ''',
                            returnStdout: true
                        ).trim()

                        if (!env.ALB_ARN ||
                            env.ALB_ARN == 'None') {

                            env.ALB_ARN = ''
                        }

                        env.TARGET_GROUP_ARN = sh(
                            script: '''
                                aws elbv2 describe-target-groups \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --names "${TARGET_GROUP_NAME}" \
                                    --query 'TargetGroups[0].TargetGroupArn' \
                                    --output text \
                                    2>/dev/null || true
                            ''',
                            returnStdout: true
                        ).trim()

                        if (!env.TARGET_GROUP_ARN ||
                            env.TARGET_GROUP_ARN == 'None') {

                            env.TARGET_GROUP_ARN = ''
                        }

                        env.ALB_SG_ID = sh(
                            script: '''
                                aws ec2 describe-security-groups \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --filters \
                                        "Name=group-name,Values=${ALB_SG_NAME}" \
                                    --query 'SecurityGroups[0].GroupId' \
                                    --output text \
                                    2>/dev/null || true
                            ''',
                            returnStdout: true
                        ).trim()

                        if (!env.ALB_SG_ID ||
                            env.ALB_SG_ID == 'None') {

                            env.ALB_SG_ID = ''
                        }

                        env.ECS_SG_ID = sh(
                            script: '''
                                aws ec2 describe-security-groups \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --filters \
                                        "Name=group-name,Values=${ECS_SG_NAME}" \
                                    --query 'SecurityGroups[0].GroupId' \
                                    --output text \
                                    2>/dev/null || true
                            ''',
                            returnStdout: true
                        ).trim()

                        if (!env.ECS_SG_ID ||
                            env.ECS_SG_ID == 'None') {

                            env.ECS_SG_ID = ''
                        }

                        echo "ALB ARN          : ${env.ALB_ARN ?: 'NOT FOUND'}"
                        echo "Target Group ARN : ${env.TARGET_GROUP_ARN ?: 'NOT FOUND'}"
                        echo "ALB SG           : ${env.ALB_SG_ID ?: 'NOT FOUND'}"
                        echo "ECS SG           : ${env.ECS_SG_ID ?: 'NOT FOUND'}"
                    }
                }
            }
        }

        // ============================================================
        // 3. ECS SERVICE
        // ============================================================

        stage('3 - Remove ECS Service') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "REMOVING ECS SERVICE"
                        echo "================================================"

                        SERVICE_STATUS=$(aws ecs describe-services \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}" \
                            --query 'services[0].status' \
                            --output text \
                            2>/dev/null || true)

                        echo "Service status: ${SERVICE_STATUS}"

                        if [ "${SERVICE_STATUS}" = "ACTIVE" ]; then

                            echo "Scaling service to zero..."

                            aws ecs update-service \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --service "${ECS_SERVICE}" \
                                --desired-count 0 \
                                > /dev/null

                            echo "Waiting for ECS service to reach zero tasks..."

                            for i in $(seq 1 60)
                            do

                                RUNNING=$(aws ecs describe-services \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --cluster "${ECS_CLUSTER}" \
                                    --services "${ECS_SERVICE}" \
                                    --query 'services[0].runningCount' \
                                    --output text \
                                    2>/dev/null || true)

                                PENDING=$(aws ecs describe-services \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --cluster "${ECS_CLUSTER}" \
                                    --services "${ECS_SERVICE}" \
                                    --query 'services[0].pendingCount' \
                                    --output text \
                                    2>/dev/null || true)

                                echo "Check ${i}/60: running=${RUNNING} pending=${PENDING}"

                                if [ "${RUNNING:-0}" = "0" ] &&
                                   [ "${PENDING:-0}" = "0" ]; then
                                    break
                                fi

                                sleep 5
                            done

                            echo "Deleting ECS service..."

                            aws ecs delete-service \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --service "${ECS_SERVICE}" \
                                --force \
                                > /dev/null

                            echo "Waiting for ECS service deletion..."

                            for i in $(seq 1 60)
                            do

                                STATUS=$(aws ecs describe-services \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --cluster "${ECS_CLUSTER}" \
                                    --services "${ECS_SERVICE}" \
                                    --query 'services[0].status' \
                                    --output text \
                                    2>/dev/null || true)

                                echo "Deletion check ${i}/60: ${STATUS}"

                                if [ "${STATUS}" = "None" ] ||
                                   [ -z "${STATUS}" ]; then
                                    break
                                fi

                                sleep 5
                            done

                        else

                            echo "ECS service does not exist."
                        fi

                        echo "ECS service removal completed."
                    '''
                }
            }
        }

        // ============================================================
        // 4. STOP REMAINING TASKS
        // ============================================================

        stage('4 - Stop Remaining ECS Tasks') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "STOPPING REMAINING ECS TASKS"
                        echo "================================================"

                        TASKS=$(aws ecs list-tasks \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --desired-status RUNNING \
                            --query 'taskArns[]' \
                            --output text \
                            2>/dev/null || true)

                        if [ -z "${TASKS}" ] ||
                           [ "${TASKS}" = "None" ]; then

                            echo "No running ECS tasks found."

                        else

                            for TASK in ${TASKS}
                            do

                                echo "Stopping task:"
                                echo "${TASK}"

                                aws ecs stop-task \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --cluster "${ECS_CLUSTER}" \
                                    --task "${TASK}" \
                                    --reason "CI/CD destroy pipeline" \
                                    > /dev/null 2>&1 || true

                            done

                            echo "Waiting for tasks to stop..."

                            for i in $(seq 1 60)
                            do

                                REMAINING=$(aws ecs list-tasks \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --cluster "${ECS_CLUSTER}" \
                                    --desired-status RUNNING \
                                    --query 'length(taskArns)' \
                                    --output text \
                                    2>/dev/null || true)

                                echo "Task check ${i}/60: ${REMAINING}"

                                if [ "${REMAINING:-0}" = "0" ]; then
                                    break
                                fi

                                sleep 5
                            done
                        fi

                        echo "Remaining ECS tasks removed."
                    '''
                }
            }
        }

        // ============================================================
        // 5. DELETE ALB LISTENER
        // ============================================================

        stage('5 - Delete ALB Listener') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "DELETING ALB LISTENER"
                        echo "================================================"

                        if [ -z "${ALB_ARN}" ]; then

                            echo "ALB does not exist."

                        else

                            LISTENER_ARN=$(aws elbv2 describe-listeners \
                                --region "${AWS_DEFAULT_REGION}" \
                                --load-balancer-arn "${ALB_ARN}" \
                                --query 'Listeners[?Port==`80`].ListenerArn | [0]' \
                                --output text \
                                2>/dev/null || true)

                            if [ -n "${LISTENER_ARN}" ] &&
                               [ "${LISTENER_ARN}" != "None" ]; then

                                echo "Deleting listener:"
                                echo "${LISTENER_ARN}"

                                aws elbv2 delete-listener \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --listener-arn "${LISTENER_ARN}"

                            else

                                echo "Port 80 listener not found."
                            fi
                        fi
                    '''
                }
            }
        }

        // ============================================================
        // 6. DELETE ALB
        // ============================================================

        stage('6 - Delete ALB') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "DELETING APPLICATION LOAD BALANCER"
                        echo "================================================"

                        if [ -z "${ALB_ARN}" ]; then

                            echo "ALB does not exist."

                        else

                            echo "Deleting ALB:"
                            echo "${ALB_ARN}"

                            aws elbv2 delete-load-balancer \
                                --region "${AWS_DEFAULT_REGION}" \
                                --load-balancer-arn "${ALB_ARN}" \
                                2>/dev/null || true

                            echo "Waiting for ALB deletion..."

                            for i in $(seq 1 60)
                            do

                                STATUS=$(aws elbv2 describe-load-balancers \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --load-balancer-arns "${ALB_ARN}" \
                                    --query 'LoadBalancers[0].State.Code' \
                                    --output text \
                                    2>/dev/null || true)

                                echo "ALB deletion check ${i}/60: ${STATUS}"

                                if [ -z "${STATUS}" ] ||
                                   [ "${STATUS}" = "None" ]; then
                                    break
                                fi

                                sleep 5
                            done
                        fi

                        echo "ALB deletion completed."
                    '''
                }
            }
        }

        // ============================================================
        // 7. DELETE TARGET GROUP
        // ============================================================

        stage('7 - Delete Target Group') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "DELETING TARGET GROUP"
                        echo "================================================"

                        if [ -z "${TARGET_GROUP_ARN}" ]; then

                            echo "Target group does not exist."

                        else

                            echo "Deleting target group:"
                            echo "${TARGET_GROUP_ARN}"

                            for i in $(seq 1 20)
                            do

                                if aws elbv2 delete-target-group \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --target-group-arn "${TARGET_GROUP_ARN}" \
                                    2>/dev/null
                                then

                                    echo "Target group deleted."
                                    break

                                else

                                    echo "Target group is still being released. Retry ${i}/20."
                                    sleep 5
                                fi

                            done
                        fi
                    '''
                }
            }
        }

        // ============================================================
        // 8. DELETE ECS CLUSTER
        // ============================================================

        stage('8 - Delete ECS Cluster') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "DELETING ECS CLUSTER"
                        echo "================================================"

                        CLUSTER_STATUS=$(aws ecs describe-clusters \
                            --region "${AWS_DEFAULT_REGION}" \
                            --clusters "${ECS_CLUSTER}" \
                            --query 'clusters[0].status' \
                            --output text \
                            2>/dev/null || true)

                        echo "Cluster status: ${CLUSTER_STATUS}"

                        if [ "${CLUSTER_STATUS}" = "ACTIVE" ]; then

                            echo "Deleting ECS cluster..."

                            aws ecs delete-cluster \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                > /dev/null

                            echo "ECS cluster deletion requested."

                        else

                            echo "ECS cluster does not exist or is already deleted."
                        fi
                    '''
                }
            }
        }

        // ============================================================
        // 9. DELETE ECR
        // ============================================================

        stage('9 - Delete ECR Repository') {

            when {

                expression {
                    return params.DELETE_ECR
                }
            }

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "DELETING ECR REPOSITORY"
                        echo "================================================"

                        if aws ecr describe-repositories \
                            --region "${AWS_DEFAULT_REGION}" \
                            --repository-names "${ECR_REPOSITORY}" \
                            > /dev/null 2>&1
                        then

                            echo "Deleting ECR repository:"
                            echo "${ECR_REPOSITORY}"

                            aws ecr delete-repository \
                                --region "${AWS_DEFAULT_REGION}" \
                                --repository-name "${ECR_REPOSITORY}" \
                                --force

                            echo "ECR repository deleted."

                        else

                            echo "ECR repository does not exist."
                        fi
                    '''
                }
            }
        }

        // ============================================================
        // 10. DELETE CLOUDWATCH LOG GROUP
        // ============================================================

        stage('10 - Delete CloudWatch Log Group') {

            when {

                expression {
                    return params.DELETE_LOG_GROUP
                }
            }

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "DELETING CLOUDWATCH LOG GROUP"
                        echo "================================================"

                        LOG_GROUP="/ecs/${ECS_TASK_FAMILY}"

                        if aws logs describe-log-groups \
                            --region "${AWS_DEFAULT_REGION}" \
                            --log-group-name-prefix "${LOG_GROUP}" \
                            --query "logGroups[?logGroupName=='${LOG_GROUP}'].logGroupName" \
                            --output text |
                            grep -q "${LOG_GROUP}"
                        then

                            echo "Deleting log group:"
                            echo "${LOG_GROUP}"

                            aws logs delete-log-group \
                                --region "${AWS_DEFAULT_REGION}" \
                                --log-group-name "${LOG_GROUP}"

                            echo "CloudWatch log group deleted."

                        else

                            echo "CloudWatch log group does not exist."
                        fi
                    '''
                }
            }
        }

        // ============================================================
        // 11. DELETE SECURITY GROUPS
        // ============================================================

        stage('11 - Delete Security Groups') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "DELETING SECURITY GROUPS"
                        echo "================================================"

                        delete_sg() {

                            SG_ID="$1"
                            SG_NAME="$2"

                            if [ -z "${SG_ID}" ]; then

                                echo "Security group ${SG_NAME} was not found."
                                return 0
                            fi

                            echo ""
                            echo "Security group:"
                            echo "${SG_NAME}"

                            echo "ID:"
                            echo "${SG_ID}"

                            for i in $(seq 1 20)
                            do

                                if aws ec2 delete-security-group \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --group-id "${SG_ID}"
                                then

                                    echo "Security group deleted."
                                    return 0

                                else

                                    echo "Security group is still in use."
                                    echo "Retry ${i}/20..."

                                    sleep 10
                                fi

                            done

                            echo "ERROR: Could not delete security group:"
                            echo "${SG_ID}"

                            exit 1
                        }

                        delete_sg \
                            "${ECS_SG_ID}" \
                            "${ECS_SG_NAME}"

                        delete_sg \
                            "${ALB_SG_ID}" \
                            "${ALB_SG_NAME}"

                        echo ""
                        echo "Security group cleanup completed."
                    '''
                }
            }
        }

        // ============================================================
        // 12. DELETE IAM ROLE
        // ============================================================

        stage('12 - Delete ECS Execution IAM Role') {

            when {

                expression {
                    return params.DELETE_IAM_ROLE
                }
            }

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "DELETING ECS EXECUTION IAM ROLE"
                        echo "================================================"

                        if aws iam get-role \
                            --role-name "${EXECUTION_ROLE_NAME}" \
                            > /dev/null 2>&1
                        then

                            echo "Detaching ECS execution policy..."

                            aws iam detach-role-policy \
                                --role-name "${EXECUTION_ROLE_NAME}" \
                                --policy-arn \
                                arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy \
                                2>/dev/null || true

                            echo "Deleting IAM role..."

                            aws iam delete-role \
                                --role-name "${EXECUTION_ROLE_NAME}"

                            echo "IAM role deleted."

                        else

                            echo "IAM role does not exist."
                        fi
                    '''
                }
            }
        }

        // ============================================================
        // 13. TERRAFORM CHECKOUT
        // ============================================================

        stage('13 - Terraform Checkout') {

            when {

                expression {
                    return params.RUN_TERRAFORM_DESTROY
                }
            }

            steps {

                dir("${TERRAFORM_DIR}") {

                    deleteDir()

                    git(
                        branch: "${TERRAFORM_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${TERRAFORM_REPO}"
                    )
                }
            }
        }

        // ============================================================
        // 14. TERRAFORM DESTROY
        // ============================================================

        stage('14 - Terraform Destroy') {

            when {

                expression {
                    return params.RUN_TERRAFORM_DESTROY
                }
            }

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh '''
                            set -eu

                            echo "================================================"
                            echo "TERRAFORM DESTROY"
                            echo "================================================"

                            command -v terraform

                            terraform version

                            if [ ! -d "environments/${ENVIRONMENT}" ]; then

                                echo "ERROR: Terraform environment does not exist:"
                                echo "environments/${ENVIRONMENT}"

                                exit 1
                            fi

                            if [ ! -f "environments/${ENVIRONMENT}/terraform.tfvars" ]; then

                                echo "ERROR: Terraform variables file not found:"
                                echo "environments/${ENVIRONMENT}/terraform.tfvars"

                                exit 1
                            fi

                            echo ""
                            echo "Terraform environment:"
                            echo "${ENVIRONMENT}"

                            echo ""
                            echo "================================================"
                            echo "TERRAFORM INIT"
                            echo "================================================"

                            terraform init \
                                -input=false

                            echo ""
                            echo "================================================"
                            echo "TERRAFORM VALIDATE"
                            echo "================================================"

                            terraform validate

                            echo ""
                            echo "================================================"
                            echo "TERRAFORM DESTROY PLAN"
                            echo "================================================"

                            terraform plan \
                                -destroy \
                                -input=false \
                                -var-file="environments/${ENVIRONMENT}/terraform.tfvars" \
                                -out="destroy.tfplan"

                            test -f destroy.tfplan

                            echo ""
                            echo "================================================"
                            echo "TERRAFORM DESTROY APPLY"
                            echo "================================================"

                            terraform apply \
                                -input=false \
                                -auto-approve \
                                destroy.tfplan

                            echo ""
                            echo "================================================"
                            echo "TERRAFORM DESTROY COMPLETE"
                            echo "================================================"

                            terraform state list || true
                        '''
                    }
                }
            }
        }

        // ============================================================
        // 15. FINAL AWS VERIFICATION
        // ============================================================

        stage('15 - Final AWS Verification') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "FINAL RESOURCE VERIFICATION"
                        echo "================================================"

                        echo ""
                        echo "ECS SERVICE"

                        SERVICE_STATUS=$(aws ecs describe-services \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}" \
                            --query 'services[0].status' \
                            --output text \
                            2>/dev/null || true)

                        echo "Status: ${SERVICE_STATUS:-NOT FOUND}"

                        echo ""
                        echo "ECS CLUSTER"

                        CLUSTER_STATUS=$(aws ecs describe-clusters \
                            --region "${AWS_DEFAULT_REGION}" \
                            --clusters "${ECS_CLUSTER}" \
                            --query 'clusters[0].status' \
                            --output text \
                            2>/dev/null || true)

                        echo "Status: ${CLUSTER_STATUS:-NOT FOUND}"

                        echo ""
                        echo "ECR"

                        if aws ecr describe-repositories \
                            --region "${AWS_DEFAULT_REGION}" \
                            --repository-names "${ECR_REPOSITORY}" \
                            > /dev/null 2>&1
                        then

                            echo "ECR repository STILL EXISTS."

                        else

                            echo "ECR repository: DELETED"
                        fi

                        echo ""
                        echo "ALB"

                        ALB_CHECK=$(aws elbv2 describe-load-balancers \
                            --region "${AWS_DEFAULT_REGION}" \
                            --names "${ALB_NAME}" \
                            --query 'LoadBalancers[0].LoadBalancerArn' \
                            --output text \
                            2>/dev/null || true)

                        if [ -z "${ALB_CHECK}" ] ||
                           [ "${ALB_CHECK}" = "None" ]; then

                            echo "ALB: DELETED"

                        else

                            echo "ALB STILL EXISTS:"
                            echo "${ALB_CHECK}"
                        fi

                        echo ""
                        echo "TARGET GROUP"

                        TG_CHECK=$(aws elbv2 describe-target-groups \
                            --region "${AWS_DEFAULT_REGION}" \
                            --names "${TARGET_GROUP_NAME}" \
                            --query 'TargetGroups[0].TargetGroupArn' \
                            --output text \
                            2>/dev/null || true)

                        if [ -z "${TG_CHECK}" ] ||
                           [ "${TG_CHECK}" = "None" ]; then

                            echo "Target group: DELETED"

                        else

                            echo "Target group STILL EXISTS:"
                            echo "${TG_CHECK}"
                        fi

                        echo ""
                        echo "SECURITY GROUPS"

                        ALB_SG_CHECK=$(aws ec2 describe-security-groups \
                            --region "${AWS_DEFAULT_REGION}" \
                            --filters \
                                "Name=group-name,Values=${ALB_SG_NAME}" \
                            --query 'SecurityGroups[0].GroupId' \
                            --output text \
                            2>/dev/null || true)

                        ECS_SG_CHECK=$(aws ec2 describe-security-groups \
                            --region "${AWS_DEFAULT_REGION}" \
                            --filters \
                                "Name=group-name,Values=${ECS_SG_NAME}" \
                            --query 'SecurityGroups[0].GroupId' \
                            --output text \
                            2>/dev/null || true)

                        echo "ALB SG: ${ALB_SG_CHECK:-DELETED}"
                        echo "ECS SG: ${ECS_SG_CHECK:-DELETED}"

                        echo ""
                        echo "IAM ROLE"

                        ROLE_CHECK=$(aws iam get-role \
                            --role-name "${EXECUTION_ROLE_NAME}" \
                            --query 'Role.RoleName' \
                            --output text \
                            2>/dev/null || true)

                        if [ -z "${ROLE_CHECK}" ] ||
                           [ "${ROLE_CHECK}" = "None" ]; then

                            echo "IAM role: DELETED"

                        else

                            echo "IAM role STILL EXISTS:"
                            echo "${ROLE_CHECK}"
                        fi

                        echo ""
                        echo "================================================"
                        echo "FINAL VERIFICATION COMPLETE"
                        echo "================================================"
                    '''
                }
            }
        }

        // ============================================================
        // 16. FINAL SUMMARY
        // ============================================================

        stage('16 - Destroy Summary') {

            steps {

                echo ''
                echo '================================================'
                echo '       DESTROY PIPELINE SUMMARY'
                echo '================================================'

                echo ''
                echo "Environment      : ${env.ENVIRONMENT}"
                echo "ECS Cluster      : ${env.ECS_CLUSTER}"
                echo "ECS Service      : ${env.ECS_SERVICE}"
                echo "ALB              : ${env.ALB_NAME}"
                echo "Target Group     : ${env.TARGET_GROUP_NAME}"
                echo "ECR Repository   : ${env.ECR_REPOSITORY}"
                echo "IAM Role         : ${env.EXECUTION_ROLE_NAME}"
                echo "Terraform Destroy: ${params.RUN_TERRAFORM_DESTROY}"

                echo ''
                echo '================================================'
                echo '       DESTROY OPERATION COMPLETE'
                echo '================================================'
            }
        }
    }

    // ================================================================
    // POST ACTIONS
    // ================================================================

    post {

        success {

            echo ''
            echo '================================================'
            echo '       COMPLETE DESTROY SUCCESS'
            echo '================================================'

            echo ''
            echo 'ECS SERVICE       : REMOVED'
            echo 'ECS TASKS         : STOPPED'
            echo 'ALB LISTENER      : REMOVED'
            echo 'ALB               : REMOVED'
            echo 'TARGET GROUP      : REMOVED'
            echo 'ECS CLUSTER       : REMOVED'
            echo 'ECR               : REMOVED'
            echo 'CLOUDWATCH LOGS   : REMOVED'
            echo 'SECURITY GROUPS   : REMOVED'
            echo 'IAM ROLE          : REMOVED'
            echo 'TERRAFORM         : DESTROYED'

            echo ''
            echo '================================================'
            echo '       ALL DEPLOYED RESOURCES REMOVED'
            echo '================================================'
        }

        failure {

            echo ''
            echo '================================================'
            echo '       DESTROY PIPELINE FAILED'
            echo '================================================'

            echo ''
            echo 'The destroy operation encountered an error.'

            echo ''
            echo 'Check the Jenkins console output.'

            echo ''
            echo 'Important areas:'
            echo '1. ECS service/tasks'
            echo '2. ALB'
            echo '3. Target group'
            echo '4. ECS cluster'
            echo '5. ECR'
            echo '6. CloudWatch'
            echo '7. Security groups'
            echo '8. IAM'
            echo '9. Terraform'

            echo ''
            echo '================================================'
        }

        always {

            echo ''
            echo '================================================'
            echo 'CLEANING JENKINS WORKSPACE'
            echo '================================================'

            cleanWs(
                deleteDirs: true,
                disableDeferredWipeout: true
            )
        }
    }
}
