pipeline {

    agent any

    // ================================================================
    // OPTIONS
    // ================================================================

    options {

        timestamps()

        ansiColor('xterm')

        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                daysToKeepStr: '30',
                numToKeepStr: '50'
            )
        )

        timeout(
            time: 120,
            unit: 'MINUTES'
        )
    }


    // ================================================================
    // PARAMETERS
    // ================================================================

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: [
                'dev',
                'qa',
                'stage',
                'prod'
            ],
            description: 'Environment to completely destroy'
        )
    }


    // ================================================================
    // ENVIRONMENT
    // ================================================================

    environment {

        AWS_DEFAULT_REGION = 'us-east-1'

        AWS_CREDENTIALS = 'aws-creds'

        GITHUB_CREDENTIALS = 'github-creds'

        TERRAFORM_REPO =
            'https://github.com/FAIZANSHEIKH223/terraform-aws-infra.git'

        TERRAFORM_BRANCH = 'main'

        TERRAFORM_DIR = 'terraform-infra'

        ECR_REPOSITORY = 'practice1'

        APP_NAME = 'practice1'

        CONTAINER_PORT = '8501'

        ECS_CONTAINER_NAME = 'practice1'

        ECS_EXECUTION_ROLE = 'practice1-ecsTaskExecutionRole'

        TF_STATE_BUCKET = 'terraform-state-faizan-001'

        TF_LOCK_TABLE = 'terraform-locks'
    }


    // ================================================================
    // STAGES
    // ================================================================

    stages {


        // ============================================================
        // 01 - SHOW DESTROY TARGET
        // ============================================================

        stage('01 - Confirm Destroy Target') {

            steps {

                script {

                    echo ''
                    echo '================================================'
                    echo '        COMPLETE AWS DESTROY PIPELINE'
                    echo '================================================'
                    echo ''
                    echo "Environment : ${params.ENVIRONMENT}"
                    echo "Region      : ${env.AWS_DEFAULT_REGION}"
                    echo ''
                    echo 'The following resources will be searched for:'
                    echo ''
                    echo "ECS Cluster       : practice1-${params.ENVIRONMENT}-cluster"
                    echo "ECS Service       : practice1-${params.ENVIRONMENT}-service"
                    echo "Task Family       : practice1-${params.ENVIRONMENT}-task"
                    echo "ALB               : practice1-${params.ENVIRONMENT}-alb"
                    echo "Target Group      : practice1-${params.ENVIRONMENT}-tg"
                    echo "ALB Security Group: practice1-${params.ENVIRONMENT}-alb-sg"
                    echo "ECS Security Group: practice1-${params.ENVIRONMENT}-ecs-sg"
                    echo "ECR Repository    : practice1"
                    echo "IAM Role          : practice1-ecsTaskExecutionRole"
                    echo "Log Group         : /ecs/practice1-${params.ENVIRONMENT}-task"
                    echo ''
                    echo 'Terraform infrastructure will also be destroyed.'
                    echo ''
                    echo 'Terraform backend WILL NOT be deleted.'
                    echo "State bucket      : ${env.TF_STATE_BUCKET}"
                    echo "Lock table        : ${env.TF_LOCK_TABLE}"
                    echo ''
                    echo '================================================'
                }
            }
        }


        // ============================================================
        // 02 - VERIFY AWS CLI
        // ============================================================

        stage('02 - Verify AWS CLI and Credentials') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "VERIFYING AWS"
                        echo "================================================"

                        command -v aws

                        if [ $? -ne 0 ]; then
                            echo "ERROR: AWS CLI not installed."
                            exit 1
                        fi

                        aws --version

                        echo ""
                        echo "AWS identity:"

                        aws sts get-caller-identity \
                            --region "${AWS_DEFAULT_REGION}"

                        if [ $? -ne 0 ]; then
                            echo "ERROR: AWS credentials are invalid."
                            exit 1
                        fi

                        echo ""
                        echo "AWS credentials verified."
                    '''
                }
            }
        }


        // ============================================================
        // 03 - STOP ALL ECS TASKS
        // ============================================================

        stage('03 - Stop ECS Tasks') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "STOPPING ECS TASKS"
                        echo "================================================"

                        CLUSTER="practice1-${ENVIRONMENT}-cluster"
                        SERVICE="practice1-${ENVIRONMENT}-service"

                        echo "Cluster: ${CLUSTER}"
                        echo "Service: ${SERVICE}"

                        TASKS=$(aws ecs list-tasks \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${CLUSTER}" \
                            --service-name "${SERVICE}" \
                            --desired-status RUNNING \
                            --query 'taskArns[]' \
                            --output text 2>/dev/null)

                        if [ -z "${TASKS}" ] || [ "${TASKS}" = "None" ]; then

                            echo "No running ECS service tasks found."

                        else

                            for TASK in ${TASKS}
                            do

                                echo "Stopping task:"
                                echo "${TASK}"

                                aws ecs stop-task \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --cluster "${CLUSTER}" \
                                    --task "${TASK}" \
                                    --reason "Jenkins complete destroy"

                            done

                        fi

                        echo ""
                        echo "Waiting for ECS tasks to stop..."

                        for i in $(seq 1 30)
                        do

                            RUNNING=$(aws ecs list-tasks \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${CLUSTER}" \
                                --service-name "${SERVICE}" \
                                --desired-status RUNNING \
                                --query 'taskArns[]' \
                                --output text 2>/dev/null)

                            if [ -z "${RUNNING}" ] || [ "${RUNNING}" = "None" ]; then

                                echo "All service tasks stopped."
                                break

                            fi

                            echo "Still running. Attempt ${i}/30"

                            sleep 10

                        done
                    '''
                }
            }
        }


        // ============================================================
        // 04 - SCALE ECS SERVICE TO ZERO
        // ============================================================

        stage('04 - Scale ECS Service to Zero') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        CLUSTER="practice1-${ENVIRONMENT}-cluster"
                        SERVICE="practice1-${ENVIRONMENT}-service"

                        echo "================================================"
                        echo "SCALING ECS SERVICE TO ZERO"
                        echo "================================================"

                        aws ecs update-service \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${CLUSTER}" \
                            --service "${SERVICE}" \
                            --desired-count 0 \
                            2>/dev/null

                        echo "Service scaled to zero."
                    '''
                }
            }
        }


        // ============================================================
        // 05 - DELETE ECS SERVICE
        // ============================================================

        stage('05 - Delete ECS Service') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        CLUSTER="practice1-${ENVIRONMENT}-cluster"
                        SERVICE="practice1-${ENVIRONMENT}-service"

                        echo "================================================"
                        echo "DELETING ECS SERVICE"
                        echo "================================================"

                        SERVICE_STATUS=$(aws ecs describe-services \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${CLUSTER}" \
                            --services "${SERVICE}" \
                            --query 'services[0].status' \
                            --output text 2>/dev/null)

                        if [ "${SERVICE_STATUS}" = "ACTIVE" ] || \
                           [ "${SERVICE_STATUS}" = "DRAINING" ]; then

                            echo "Deleting ECS service..."

                            aws ecs delete-service \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${CLUSTER}" \
                                --service "${SERVICE}" \
                                --force

                            echo "Waiting for ECS service deletion..."

                            for i in $(seq 1 30)
                            do

                                STATUS=$(aws ecs describe-services \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --cluster "${CLUSTER}" \
                                    --services "${SERVICE}" \
                                    --query 'services[0].status' \
                                    --output text 2>/dev/null)

                                if [ -z "${STATUS}" ] || \
                                   [ "${STATUS}" = "None" ]; then

                                    echo "ECS service deleted."
                                    break

                                fi

                                echo "Service status: ${STATUS}"

                                sleep 5

                            done

                        else

                            echo "ECS service does not exist."

                        fi
                    '''
                }
            }
        }


        // ============================================================
        // 06 - STOP ANY REMAINING ECS TASKS
        // ============================================================

        stage('06 - Final ECS Task Cleanup') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        CLUSTER="practice1-${ENVIRONMENT}-cluster"

                        echo "================================================"
                        echo "FINAL ECS TASK CLEANUP"
                        echo "================================================"

                        TASKS=$(aws ecs list-tasks \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${CLUSTER}" \
                            --desired-status RUNNING \
                            --query 'taskArns[]' \
                            --output text 2>/dev/null)

                        if [ -z "${TASKS}" ] || [ "${TASKS}" = "None" ]; then

                            echo "No remaining running tasks."

                        else

                            for TASK in ${TASKS}
                            do

                                echo "Stopping remaining task: ${TASK}"

                                aws ecs stop-task \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --cluster "${CLUSTER}" \
                                    --task "${TASK}" \
                                    --reason "Final Jenkins cleanup"

                            done

                        fi

                        sleep 15
                    '''
                }
            }
        }


        // ============================================================
        // 07 - DELETE ALB LISTENERS
        // ============================================================

        stage('07 - Delete ALB Listeners') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        ALB_NAME="practice1-${ENVIRONMENT}-alb"

                        echo "================================================"
                        echo "DELETING ALB LISTENERS"
                        echo "================================================"

                        ALB_ARN=$(aws elbv2 describe-load-balancers \
                            --region "${AWS_DEFAULT_REGION}" \
                            --names "${ALB_NAME}" \
                            --query 'LoadBalancers[0].LoadBalancerArn' \
                            --output text 2>/dev/null)

                        if [ -z "${ALB_ARN}" ] || [ "${ALB_ARN}" = "None" ]; then

                            echo "ALB does not exist."

                        else

                            LISTENERS=$(aws elbv2 describe-listeners \
                                --region "${AWS_DEFAULT_REGION}" \
                                --load-balancer-arn "${ALB_ARN}" \
                                --query 'Listeners[].ListenerArn' \
                                --output text 2>/dev/null)

                            for LISTENER in ${LISTENERS}
                            do

                                echo "Deleting listener: ${LISTENER}"

                                aws elbv2 delete-listener \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --listener-arn "${LISTENER}"

                            done

                        fi
                    '''
                }
            }
        }


        // ============================================================
        // 08 - DELETE ALB
        // ============================================================

        stage('08 - Delete Application Load Balancer') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        ALB_NAME="practice1-${ENVIRONMENT}-alb"

                        echo "================================================"
                        echo "DELETING APPLICATION LOAD BALANCER"
                        echo "================================================"

                        ALB_ARN=$(aws elbv2 describe-load-balancers \
                            --region "${AWS_DEFAULT_REGION}" \
                            --names "${ALB_NAME}" \
                            --query 'LoadBalancers[0].LoadBalancerArn' \
                            --output text 2>/dev/null)

                        if [ -z "${ALB_ARN}" ] || [ "${ALB_ARN}" = "None" ]; then

                            echo "ALB already deleted."

                        else

                            aws elbv2 delete-load-balancer \
                                --region "${AWS_DEFAULT_REGION}" \
                                --load-balancer-arn "${ALB_ARN}"

                            echo "ALB deletion requested."

                            for i in $(seq 1 30)
                            do

                                CHECK=$(aws elbv2 describe-load-balancers \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --names "${ALB_NAME}" \
                                    --query 'LoadBalancers[0].State.Code' \
                                    --output text 2>/dev/null)

                                if [ -z "${CHECK}" ] || [ "${CHECK}" = "None" ]; then

                                    echo "ALB deleted."
                                    break

                                fi

                                echo "ALB still exists. Attempt ${i}/30"

                                sleep 10

                            done

                        fi
                    '''
                }
            }
        }


        // ============================================================
        // 09 - DELETE TARGET GROUP
        // ============================================================

        stage('09 - Delete Target Group') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        TARGET_GROUP="practice1-${ENVIRONMENT}-tg"

                        echo "================================================"
                        echo "DELETING TARGET GROUP"
                        echo "================================================"

                        TG_ARN=$(aws elbv2 describe-target-groups \
                            --region "${AWS_DEFAULT_REGION}" \
                            --names "${TARGET_GROUP}" \
                            --query 'TargetGroups[0].TargetGroupArn' \
                            --output text 2>/dev/null)

                        if [ -z "${TG_ARN}" ] || [ "${TG_ARN}" = "None" ]; then

                            echo "Target group already deleted."

                        else

                            for i in $(seq 1 12)
                            do

                                aws elbv2 delete-target-group \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --target-group-arn "${TG_ARN}"

                                if [ $? -eq 0 ]; then

                                    echo "Target group deleted."
                                    break

                                fi

                                echo "Target group still in use."
                                echo "Retry ${i}/12"

                                sleep 10

                            done

                        fi
                    '''
                }
            }
        }


        // ============================================================
        // 10 - DELETE ECS CLUSTER
        // ============================================================

        stage('10 - Delete ECS Cluster') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        CLUSTER="practice1-${ENVIRONMENT}-cluster"

                        echo "================================================"
                        echo "DELETING ECS CLUSTER"
                        echo "================================================"

                        aws ecs delete-cluster \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${CLUSTER}" \
                            2>/dev/null

                        echo "ECS cluster deletion requested."

                        sleep 10
                    '''
                }
            }
        }


        // ============================================================
        // 11 - DEREGISTER ALL TASK DEFINITIONS
        // ============================================================

        stage('11 - Deregister ECS Task Definitions') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        FAMILY="practice1-${ENVIRONMENT}-task"

                        echo "================================================"
                        echo "DEREGISTERING ECS TASK DEFINITIONS"
                        echo "================================================"

                        REVISIONS=$(aws ecs list-task-definitions \
                            --region "${AWS_DEFAULT_REGION}" \
                            --family-prefix "${FAMILY}" \
                            --status ACTIVE \
                            --query 'taskDefinitionArns[]' \
                            --output text 2>/dev/null)

                        if [ -z "${REVISIONS}" ] || [ "${REVISIONS}" = "None" ]; then

                            echo "No ACTIVE task definitions found."

                        else

                            for TD in ${REVISIONS}
                            do

                                echo "Deregistering:"
                                echo "${TD}"

                                aws ecs deregister-task-definition \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --task-definition "${TD}" \
                                    >/dev/null 2>&1

                            done

                        fi

                        echo "Task definition cleanup completed."
                    '''
                }
            }
        }


        // ============================================================
        // 12 - DELETE CLOUDWATCH LOG GROUP
        // ============================================================

        stage('12 - Delete CloudWatch Log Group') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        LOG_GROUP="/ecs/practice1-${ENVIRONMENT}-task"

                        echo "================================================"
                        echo "DELETING CLOUDWATCH LOG GROUP"
                        echo "================================================"

                        aws logs delete-log-group \
                            --region "${AWS_DEFAULT_REGION}" \
                            --log-group-name "${LOG_GROUP}"

                        if [ $? -eq 0 ]; then

                            echo "Log group deleted."

                        else

                            echo "Log group does not exist or is already deleted."

                        fi
                    '''
                }
            }
        }


        // ============================================================
        // 13 - REMOVE ECS SECURITY GROUP RULES
        // ============================================================

        stage('13 - Remove Security Group Dependencies') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        ALB_SG_NAME="practice1-${ENVIRONMENT}-alb-sg"
                        ECS_SG_NAME="practice1-${ENVIRONMENT}-ecs-sg"

                        echo "================================================"
                        echo "REMOVING SECURITY GROUP DEPENDENCIES"
                        echo "================================================"

                        ALB_SG_ID=$(aws ec2 describe-security-groups \
                            --region "${AWS_DEFAULT_REGION}" \
                            --filters \
                                "Name=group-name,Values=${ALB_SG_NAME}" \
                            --query 'SecurityGroups[0].GroupId' \
                            --output text 2>/dev/null)

                        ECS_SG_ID=$(aws ec2 describe-security-groups \
                            --region "${AWS_DEFAULT_REGION}" \
                            --filters \
                                "Name=group-name,Values=${ECS_SG_NAME}" \
                            --query 'SecurityGroups[0].GroupId' \
                            --output text 2>/dev/null)

                        echo "ALB SG: ${ALB_SG_ID}"
                        echo "ECS SG: ${ECS_SG_ID}"

                        if [ -n "${ECS_SG_ID}" ] && \
                           [ "${ECS_SG_ID}" != "None" ] && \
                           [ -n "${ALB_SG_ID}" ] && \
                           [ "${ALB_SG_ID}" != "None" ]; then

                            aws ec2 revoke-security-group-ingress \
                                --region "${AWS_DEFAULT_REGION}" \
                                --group-id "${ECS_SG_ID}" \
                                --source-group "${ALB_SG_ID}" \
                                2>/dev/null

                            echo "Security group dependency removed."

                        fi
                    '''
                }
            }
        }


        // ============================================================
        // 14 - DELETE ECS SECURITY GROUP
        // ============================================================

        stage('14 - Delete ECS Security Group') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        SG_NAME="practice1-${ENVIRONMENT}-ecs-sg"

                        echo "================================================"
                        echo "DELETING ECS SECURITY GROUP"
                        echo "================================================"

                        SG_ID=$(aws ec2 describe-security-groups \
                            --region "${AWS_DEFAULT_REGION}" \
                            --filters \
                                "Name=group-name,Values=${SG_NAME}" \
                            --query 'SecurityGroups[0].GroupId' \
                            --output text 2>/dev/null)

                        if [ -z "${SG_ID}" ] || [ "${SG_ID}" = "None" ]; then

                            echo "ECS security group already deleted."

                        else

                            for i in $(seq 1 20)
                            do

                                aws ec2 delete-security-group \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --group-id "${SG_ID}"

                                if [ $? -eq 0 ]; then

                                    echo "ECS security group deleted."
                                    break

                                fi

                                echo "ECS security group still in use."
                                echo "Retry ${i}/20"

                                sleep 10

                            done

                        fi
                    '''
                }
            }
        }


        // ============================================================
        // 15 - DELETE ALB SECURITY GROUP
        // ============================================================

        stage('15 - Delete ALB Security Group') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        SG_NAME="practice1-${ENVIRONMENT}-alb-sg"

                        echo "================================================"
                        echo "DELETING ALB SECURITY GROUP"
                        echo "================================================"

                        SG_ID=$(aws ec2 describe-security-groups \
                            --region "${AWS_DEFAULT_REGION}" \
                            --filters \
                                "Name=group-name,Values=${SG_NAME}" \
                            --query 'SecurityGroups[0].GroupId' \
                            --output text 2>/dev/null)

                        if [ -z "${SG_ID}" ] || [ "${SG_ID}" = "None" ]; then

                            echo "ALB security group already deleted."

                        else

                            for i in $(seq 1 20)
                            do

                                aws ec2 delete-security-group \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --group-id "${SG_ID}"

                                if [ $? -eq 0 ]; then

                                    echo "ALB security group deleted."
                                    break

                                fi

                                echo "ALB security group still in use."
                                echo "Retry ${i}/20"

                                sleep 10

                            done

                        fi
                    '''
                }
            }
        }


        // ============================================================
        // 16 - DELETE ECR REPOSITORY
        // ============================================================

        stage('16 - Delete ECR Repository and Images') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "DELETING ECR REPOSITORY"
                        echo "================================================"

                        echo "Repository:"
                        echo "${ECR_REPOSITORY}"

                        aws ecr delete-repository \
                            --region "${AWS_DEFAULT_REGION}" \
                            --repository-name "${ECR_REPOSITORY}" \
                            --force

                        if [ $? -eq 0 ]; then

                            echo "ECR repository and ALL images deleted."

                        else

                            echo "ECR repository does not exist."

                        fi
                    '''
                }
            }
        }


        // ============================================================
        // 17 - DELETE IAM ROLE POLICIES
        // ============================================================

        stage('17 - Detach IAM Role Policies') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        ROLE="${ECS_EXECUTION_ROLE}"

                        echo "================================================"
                        echo "DETACHING IAM POLICIES"
                        echo "================================================"

                        ATTACHED=$(aws iam list-attached-role-policies \
                            --role-name "${ROLE}" \
                            --query 'AttachedPolicies[].PolicyArn' \
                            --output text 2>/dev/null)

                        if [ -n "${ATTACHED}" ] && [ "${ATTACHED}" != "None" ]; then

                            for POLICY in ${ATTACHED}
                            do

                                echo "Detaching:"
                                echo "${POLICY}"

                                aws iam detach-role-policy \
                                    --role-name "${ROLE}" \
                                    --policy-arn "${POLICY}"

                            done

                        else

                            echo "No attached policies found."

                        fi
                    '''
                }
            }
        }


        // ============================================================
        // 18 - DELETE IAM INLINE POLICIES
        // ============================================================

        stage('18 - Delete IAM Inline Policies') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        ROLE="${ECS_EXECUTION_ROLE}"

                        echo "================================================"
                        echo "DELETING IAM INLINE POLICIES"
                        echo "================================================"

                        POLICIES=$(aws iam list-role-policies \
                            --role-name "${ROLE}" \
                            --query 'PolicyNames[]' \
                            --output text 2>/dev/null)

                        if [ -n "${POLICIES}" ] && [ "${POLICIES}" != "None" ]; then

                            for POLICY in ${POLICIES}
                            do

                                echo "Deleting inline policy:"
                                echo "${POLICY}"

                                aws iam delete-role-policy \
                                    --role-name "${ROLE}" \
                                    --policy-name "${POLICY}"

                            done

                        else

                            echo "No inline policies found."

                        fi
                    '''
                }
            }
        }


        // ============================================================
        // 19 - DELETE IAM ROLE
        // ============================================================

        stage('19 - Delete ECS IAM Execution Role') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        ROLE="${ECS_EXECUTION_ROLE}"

                        echo "================================================"
                        echo "DELETING ECS IAM EXECUTION ROLE"
                        echo "================================================"

                        aws iam delete-role \
                            --role-name "${ROLE}"

                        if [ $? -eq 0 ]; then

                            echo "IAM execution role deleted."

                        else

                            echo "IAM role does not exist or is already deleted."

                        fi
                    '''
                }
            }
        }


        // ============================================================
        // 20 - CHECK ECS CLUSTER
        // ============================================================

        stage('20 - Verify ECS Cluster Deletion') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        CLUSTER="practice1-${ENVIRONMENT}-cluster"

                        echo "================================================"
                        echo "VERIFYING ECS CLUSTER"
                        echo "================================================"

                        STATUS=$(aws ecs describe-clusters \
                            --region "${AWS_DEFAULT_REGION}" \
                            --clusters "${CLUSTER}" \
                            --query 'clusters[0].status' \
                            --output text 2>/dev/null)

                        if [ -z "${STATUS}" ] || [ "${STATUS}" = "None" ]; then

                            echo "ECS cluster deleted."

                        else

                            echo "ECS cluster status: ${STATUS}"

                        fi
                    '''
                }
            }
        }


        // ============================================================
        // 21 - CHECK AWS RESOURCES
        // ============================================================

        stage('21 - AWS Cleanup Verification') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "AWS CLEANUP VERIFICATION"
                        echo "================================================"

                        CLUSTER="practice1-${ENVIRONMENT}-cluster"
                        SERVICE="practice1-${ENVIRONMENT}-service"
                        ALB="practice1-${ENVIRONMENT}-alb"
                        TG="practice1-${ENVIRONMENT}-tg"
                        ALB_SG="practice1-${ENVIRONMENT}-alb-sg"
                        ECS_SG="practice1-${ENVIRONMENT}-ecs-sg"
                        LOG_GROUP="/ecs/practice1-${ENVIRONMENT}-task"

                        echo ""
                        echo "ECS CLUSTER:"
                        aws ecs describe-clusters \
                            --region "${AWS_DEFAULT_REGION}" \
                            --clusters "${CLUSTER}" \
                            --query 'clusters[].{Name:clusterName,Status:status}' \
                            --output table 2>/dev/null

                        echo ""
                        echo "ECS SERVICE:"
                        aws ecs describe-services \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${CLUSTER}" \
                            --services "${SERVICE}" \
                            --query 'services[].{Name:serviceName,Status:status,Desired:desiredCount,Running:runningCount}' \
                            --output table 2>/dev/null

                        echo ""
                        echo "ALB:"
                        aws elbv2 describe-load-balancers \
                            --region "${AWS_DEFAULT_REGION}" \
                            --names "${ALB}" \
                            --query 'LoadBalancers[].{Name:LoadBalancerName,State:State.Code}' \
                            --output table 2>/dev/null

                        echo ""
                        echo "TARGET GROUP:"
                        aws elbv2 describe-target-groups \
                            --region "${AWS_DEFAULT_REGION}" \
                            --names "${TG}" \
                            --query 'TargetGroups[].{Name:TargetGroupName}' \
                            --output table 2>/dev/null

                        echo ""
                        echo "SECURITY GROUPS:"
                        aws ec2 describe-security-groups \
                            --region "${AWS_DEFAULT_REGION}" \
                            --filters \
                                "Name=group-name,Values=${ALB_SG},${ECS_SG}" \
                            --query 'SecurityGroups[].{Name:GroupName,Id:GroupId}' \
                            --output table 2>/dev/null

                        echo ""
                        echo "LOG GROUP:"
                        aws logs describe-log-groups \
                            --region "${AWS_DEFAULT_REGION}" \
                            --log-group-name-prefix "${LOG_GROUP}" \
                            --query 'logGroups[].logGroupName' \
                            --output table 2>/dev/null

                        echo ""
                        echo "ECR:"
                        aws ecr describe-repositories \
                            --region "${AWS_DEFAULT_REGION}" \
                            --repository-names "${ECR_REPOSITORY}" \
                            --query 'repositories[].repositoryName' \
                            --output table 2>/dev/null

                        echo ""
                        echo "IAM ROLE:"
                        aws iam get-role \
                            --role-name "${ECS_EXECUTION_ROLE}" \
                            --query 'Role.RoleName' \
                            --output text 2>/dev/null

                        echo ""
                        echo "Verification commands completed."
                    '''
                }
            }
        }


        // ============================================================
        // 22 - CHECK TERRAFORM
        // ============================================================

        stage('22 - Checkout Terraform Repository') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    deleteDir()

                    git(
                        branch: "${TERRAFORM_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${TERRAFORM_REPO}"
                    )
                }
            }
        }


        // ============================================================
        // 23 - TERRAFORM INIT
        // ============================================================

        stage('23 - Terraform Init') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh '''
                            set +e

                            echo "================================================"
                            echo "TERRAFORM INIT"
                            echo "================================================"

                            terraform init \
                                -input=false \
                                -reconfigure

                            if [ $? -ne 0 ]; then

                                echo "WARNING: Terraform init returned an error."

                            fi
                        '''
                    }
                }
            }
        }


        // ============================================================
        // 24 - TERRAFORM STATE LIST
        // ============================================================

        stage('24 - Inspect Terraform State') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh '''
                            set +e

                            echo "================================================"
                            echo "TERRAFORM STATE"
                            echo "================================================"

                            terraform state list

                            echo ""
                            echo "Terraform state inspection completed."
                        '''
                    }
                }
            }
        }


        // ============================================================
        // 25 - TERRAFORM DESTROY
        // ============================================================

        stage('25 - Terraform Destroy') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh '''
                            set +e

                            echo "================================================"
                            echo "TERRAFORM DESTROY"
                            echo "================================================"

                            echo ""
                            echo "Environment:"
                            echo "${ENVIRONMENT}"

                            echo ""
                            echo "Destroying Terraform-managed resources..."

                            terraform destroy \
                                -input=false \
                                -auto-approve \
                                -var-file="environments/${ENVIRONMENT}/terraform.tfvars"

                            TF_EXIT=$?

                            if [ ${TF_EXIT} -eq 0 ]; then

                                echo ""
                                echo "Terraform destroy completed successfully."

                            else

                                echo ""
                                echo "WARNING: Terraform destroy returned:"
                                echo "${TF_EXIT}"

                                echo ""
                                echo "Continuing with final AWS cleanup."

                            fi
                        '''
                    }
                }
            }
        }


        // ============================================================
        // 26 - SECOND AWS CLEANUP PASS
        // ============================================================

        stage('26 - Final AWS Cleanup Pass') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "FINAL AWS CLEANUP PASS"
                        echo "================================================"

                        CLUSTER="practice1-${ENVIRONMENT}-cluster"
                        SERVICE="practice1-${ENVIRONMENT}-service"
                        ALB="practice1-${ENVIRONMENT}-alb"
                        TG="practice1-${ENVIRONMENT}-tg"
                        ALB_SG="practice1-${ENVIRONMENT}-alb-sg"
                        ECS_SG="practice1-${ENVIRONMENT}-ecs-sg"
                        LOG_GROUP="/ecs/practice1-${ENVIRONMENT}-task"

                        echo ""
                        echo "Stopping any remaining tasks..."

                        TASKS=$(aws ecs list-tasks \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${CLUSTER}" \
                            --desired-status RUNNING \
                            --query 'taskArns[]' \
                            --output text 2>/dev/null)

                        for TASK in ${TASKS}
                        do

                            aws ecs stop-task \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${CLUSTER}" \
                                --task "${TASK}" \
                                --reason "Final cleanup" \
                                2>/dev/null

                        done


                        echo ""
                        echo "Deleting ECS service again..."

                        aws ecs delete-service \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${CLUSTER}" \
                            --service "${SERVICE}" \
                            --force \
                            2>/dev/null


                        echo ""
                        echo "Deleting ECS cluster again..."

                        aws ecs delete-cluster \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${CLUSTER}" \
                            2>/dev/null


                        echo ""
                        echo "Deleting target group again..."

                        TG_ARN=$(aws elbv2 describe-target-groups \
                            --region "${AWS_DEFAULT_REGION}" \
                            --names "${TG}" \
                            --query 'TargetGroups[0].TargetGroupArn' \
                            --output text 2>/dev/null)

                        if [ -n "${TG_ARN}" ] && [ "${TG_ARN}" != "None" ]; then

                            aws elbv2 delete-target-group \
                                --region "${AWS_DEFAULT_REGION}" \
                                --target-group-arn "${TG_ARN}" \
                                2>/dev/null

                        fi


                        echo ""
                        echo "Deleting ALB again..."

                        ALB_ARN=$(aws elbv2 describe-load-balancers \
                            --region "${AWS_DEFAULT_REGION}" \
                            --names "${ALB}" \
                            --query 'LoadBalancers[0].LoadBalancerArn' \
                            --output text 2>/dev/null)

                        if [ -n "${ALB_ARN}" ] && [ "${ALB_ARN}" != "None" ]; then

                            aws elbv2 delete-load-balancer \
                                --region "${AWS_DEFAULT_REGION}" \
                                --load-balancer-arn "${ALB_ARN}" \
                                2>/dev/null

                        fi


                        echo ""
                        echo "Deleting ECR repository again..."

                        aws ecr delete-repository \
                            --region "${AWS_DEFAULT_REGION}" \
                            --repository-name "${ECR_REPOSITORY}" \
                            --force \
                            2>/dev/null


                        echo ""
                        echo "Deleting CloudWatch log group again..."

                        aws logs delete-log-group \
                            --region "${AWS_DEFAULT_REGION}" \
                            --log-group-name "${LOG_GROUP}" \
                            2>/dev/null


                        echo ""
                        echo "Final AWS cleanup pass completed."
                    '''
                }
            }
        }


        // ============================================================
        // 27 - CLEAN LOCAL DOCKER RESOURCES
        // ============================================================

        stage('27 - Cleanup Jenkins Docker Resources') {

            steps {

                sh '''
                    set +e

                    echo "================================================"
                    echo "CLEANING LOCAL DOCKER RESOURCES"
                    echo "================================================"

                    docker logout 2>/dev/null || true

                    docker rm -f practice1 2>/dev/null || true

                    docker images \
                        --format "{{.Repository}}:{{.Tag}}" \
                        | grep '^practice1:' \
                        | xargs -r docker rmi -f \
                        2>/dev/null || true

                    docker images \
                        --format "{{.Repository}}:{{.Tag}}" \
                        | grep 'practice1' \
                        | xargs -r docker rmi -f \
                        2>/dev/null || true

                    docker image prune -f 2>/dev/null || true

                    echo ""
                    echo "Local Docker cleanup completed."
                '''
            }
        }


        // ============================================================
        // 28 - FINAL RESOURCE CHECK
        // ============================================================

        stage('28 - Final Destroy Verification') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo ""
                        echo "================================================"
                        echo "        FINAL DESTROY VERIFICATION"
                        echo "================================================"

                        CLUSTER="practice1-${ENVIRONMENT}-cluster"
                        SERVICE="practice1-${ENVIRONMENT}-service"
                        ALB="practice1-${ENVIRONMENT}-alb"
                        TG="practice1-${ENVIRONMENT}-tg"
                        ALB_SG="practice1-${ENVIRONMENT}-alb-sg"
                        ECS_SG="practice1-${ENVIRONMENT}-ecs-sg"
                        LOG_GROUP="/ecs/practice1-${ENVIRONMENT}-task"

                        REMAINING=0


                        echo ""
                        echo "1. ECS CLUSTER"

                        CLUSTER_STATUS=$(aws ecs describe-clusters \
                            --region "${AWS_DEFAULT_REGION}" \
                            --clusters "${CLUSTER}" \
                            --query 'clusters[0].status' \
                            --output text 2>/dev/null)

                        if [ -z "${CLUSTER_STATUS}" ] || \
                           [ "${CLUSTER_STATUS}" = "None" ]; then

                            echo "PASS - ECS cluster removed."

                        else

                            echo "WARNING - ECS cluster still exists: ${CLUSTER_STATUS}"
                            REMAINING=1

                        fi


                        echo ""
                        echo "2. ECS SERVICE"

                        SERVICE_STATUS=$(aws ecs describe-services \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${CLUSTER}" \
                            --services "${SERVICE}" \
                            --query 'services[0].status' \
                            --output text 2>/dev/null)

                        if [ -z "${SERVICE_STATUS}" ] || \
                           [ "${SERVICE_STATUS}" = "None" ]; then

                            echo "PASS - ECS service removed."

                        else

                            echo "WARNING - ECS service still exists: ${SERVICE_STATUS}"
                            REMAINING=1

                        fi


                        echo ""
                        echo "3. ALB"

                        ALB_CHECK=$(aws elbv2 describe-load-balancers \
                            --region "${AWS_DEFAULT_REGION}" \
                            --names "${ALB}" \
                            --query 'LoadBalancers[0].LoadBalancerName' \
                            --output text 2>/dev/null)

                        if [ -z "${ALB_CHECK}" ] || \
                           [ "${ALB_CHECK}" = "None" ]; then

                            echo "PASS - ALB removed."

                        else

                            echo "WARNING - ALB still exists."
                            REMAINING=1

                        fi


                        echo ""
                        echo "4. TARGET GROUP"

                        TG_CHECK=$(aws elbv2 describe-target-groups \
                            --region "${AWS_DEFAULT_REGION}" \
                            --names "${TG}" \
                            --query 'TargetGroups[0].TargetGroupName' \
                            --output text 2>/dev/null)

                        if [ -z "${TG_CHECK}" ] || \
                           [ "${TG_CHECK}" = "None" ]; then

                            echo "PASS - Target group removed."

                        else

                            echo "WARNING - Target group still exists."
                            REMAINING=1

                        fi


                        echo ""
                        echo "5. ECR"

                        ECR_CHECK=$(aws ecr describe-repositories \
                            --region "${AWS_DEFAULT_REGION}" \
                            --repository-names "${ECR_REPOSITORY}" \
                            --query 'repositories[0].repositoryName' \
                            --output text 2>/dev/null)

                        if [ -z "${ECR_CHECK}" ] || \
                           [ "${ECR_CHECK}" = "None" ]; then

                            echo "PASS - ECR repository removed."

                        else

                            echo "WARNING - ECR repository still exists."
                            REMAINING=1

                        fi


                        echo ""
                        echo "6. IAM ROLE"

                        IAM_CHECK=$(aws iam get-role \
                            --role-name "${ECS_EXECUTION_ROLE}" \
                            --query 'Role.RoleName' \
                            --output text 2>/dev/null)

                        if [ -z "${IAM_CHECK}" ] || \
                           [ "${IAM_CHECK}" = "None" ]; then

                            echo "PASS - IAM execution role removed."

                        else

                            echo "WARNING - IAM role still exists."
                            REMAINING=1

                        fi


                        echo ""
                        echo "7. CLOUDWATCH LOG GROUP"

                        LOG_CHECK=$(aws logs describe-log-groups \
                            --region "${AWS_DEFAULT_REGION}" \
                            --log-group-name-prefix "${LOG_GROUP}" \
                            --query 'logGroups[0].logGroupName' \
                            --output text 2>/dev/null)

                        if [ -z "${LOG_CHECK}" ] || \
                           [ "${LOG_CHECK}" = "None" ]; then

                            echo "PASS - CloudWatch log group removed."

                        else

                            echo "WARNING - CloudWatch log group still exists."
                            REMAINING=1

                        fi


                        echo ""
                        echo "================================================"
                        echo "        DESTROY VERIFICATION COMPLETE"
                        echo "================================================"

                        echo ""
                        echo "Terraform backend intentionally preserved:"
                        echo "S3 bucket : ${TF_STATE_BUCKET}"
                        echo "DynamoDB   : ${TF_LOCK_TABLE}"

                        echo ""
                        echo "Remaining resource flag: ${REMAINING}"

                        echo ""
                        echo "The pipeline will complete after all cleanup"
                        echo "commands have been attempted."
                    '''
                }
            }
        }


        // ============================================================
        // 29 - FINAL SUMMARY
        // ============================================================

        stage('29 - Destroy Summary') {

            steps {

                echo ''
                echo '================================================'
                echo '       COMPLETE DESTROY OPERATION'
                echo '================================================'
                echo ''
                echo 'Application resources targeted:'
                echo ''
                echo 'ECS Tasks              : STOPPED'
                echo 'ECS Service            : DELETED'
                echo 'ECS Cluster            : DELETED'
                echo 'ALB Listeners          : DELETED'
                echo 'Application Load Balancer: DELETED'
                echo 'Target Group           : DELETED'
                echo 'Security Groups        : DELETED'
                echo 'CloudWatch Log Group   : DELETED'
                echo 'ECS Task Definitions   : DEREGISTERED'
                echo 'ECS IAM Role           : DELETED'
                echo 'ECR Repository         : DELETED'
                echo 'ECR Images             : DELETED'
                echo 'Terraform Resources    : DESTROYED'
                echo 'Local Docker Resources : CLEANED'
                echo ''
                echo 'Terraform backend was intentionally preserved.'
                echo ''
                echo '================================================'
                echo '       DESTROY PIPELINE COMPLETE'
                echo '================================================'
            }
        }
    }


    // ================================================================
    // POST ACTIONS
    // ================================================================

    post {

        success {

            echo ''
            echo '================================================'
            echo '       DESTROY PIPELINE SUCCESS'
            echo '================================================'
            echo ''
            echo "Environment: ${params.ENVIRONMENT}"
            echo ''
            echo 'AWS application infrastructure cleanup completed.'
            echo ''
            echo 'Terraform backend preserved:'
            echo "S3      : ${TF_STATE_BUCKET}"
            echo "DynamoDB: ${TF_LOCK_TABLE}"
            echo ''
            echo '================================================'
        }


        failure {

            echo ''
            echo '================================================'
            echo '       DESTROY PIPELINE FAILED'
            echo '================================================'
            echo ''
            echo 'Check the Jenkins console output.'
            echo ''
            echo 'The pipeline is designed to continue through'
            echo 'resource-not-found and dependency cleanup errors.'
            echo ''
            echo 'An AWS permission problem, Terraform state problem,'
            echo 'or resource dependency may still require attention.'
            echo ''
            echo '================================================'
        }


        always {

            echo ''
            echo '================================================'
            echo '       CLEANING JENKINS WORKSPACE'
            echo '================================================'

            cleanWs(
                deleteDirs: true,
                disableDeferredWipeout: true
            )

            echo ''
            echo 'Jenkins workspace cleaned.'
        }
    }
}
