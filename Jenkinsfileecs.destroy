pipeline {

    agent any

    options {
        timestamps()
        ansiColor('xterm')
        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                daysToKeepStr: '30',
                numToKeepStr: '50'
            )
        )

        timeout(
            time: 90,
            unit: 'MINUTES'
        )
    }

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: [
                'dev',
                'qa',
                'prod'
            ],
            description: 'Environment to completely destroy'
        )

        booleanParam(
            name: 'CONFIRM_DESTROY',
            defaultValue: false,
            description: 'MUST be checked to destroy AWS resources'
        )
    }

    environment {

        AWS_REGION = 'us-east-1'
        AWS_CREDENTIALS = 'aws-creds'
        GITHUB_CREDENTIALS = 'github-creds'

        AWS_ACCOUNT_ID = '103282536465'

        APP_NAME = 'practice1'

        TERRAFORM_REPO = 'https://github.com/FAIZANSHEIKH223/terraform-aws-infra.git'
        TERRAFORM_BRANCH = 'main'

        TERRAFORM_DIR = 'terraform-infra'

        ECR_REPOSITORY = 'practice1'

        ECS_CLUSTER = 'practice1-dev-cluster'
        ECS_SERVICE = 'practice1-dev-service'
        ECS_TASK_FAMILY = 'practice1-dev-task'

        ALB_NAME = 'practice1-dev-alb'
        TARGET_GROUP_NAME = 'practice1-dev-tg'

        ALB_SG_NAME = 'practice1-dev-alb-sg'
        ECS_SG_NAME = 'practice1-dev-ecs-sg'

        ECS_EXECUTION_ROLE = 'practice1-ecsTaskExecutionRole'

        CLOUDWATCH_LOG_GROUP = '/ecs/practice1-dev-task'

        TF_STATE_BUCKET = 'terraform-state-faizan-001'
        TF_LOCK_TABLE = 'terraform-locks'
    }

    stages {

        // ============================================================
        // 01 - CONFIRM DESTROY
        // ============================================================

        stage('01 - Confirm Destroy') {

            steps {

                script {

                    if (!params.CONFIRM_DESTROY) {

                        error(
                            'DESTROY NOT CONFIRMED. Set CONFIRM_DESTROY=true.'
                        )
                    }

                    echo '================================================'
                    echo '        AWS COMPLETE DESTROY PIPELINE'
                    echo '================================================'
                    echo "Environment: ${params.ENVIRONMENT}"
                    echo 'WARNING: AWS resources will be permanently deleted.'
                    echo '================================================'
                }
            }
        }


        // ============================================================
        // 02 - AWS IDENTITY
        // ============================================================

        stage('02 - Verify AWS Credentials') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set +e

                        echo "=============================================="
                        echo "AWS IDENTITY"
                        echo "=============================================="

                        aws sts get-caller-identity \
                            --region "${AWS_REGION}" \
                            --output table

                        if [ $? -ne 0 ]; then
                            echo "ERROR: AWS credentials are invalid."
                            exit 1
                        fi

                        echo "AWS credentials are valid."
                    '''
                }
            }
        }


        // ============================================================
        // 03 - STOP ECS TASKS
        // ============================================================

        stage('03 - Stop ECS Tasks') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set +e

                        echo "=============================================="
                        echo "STOPPING ECS TASKS"
                        echo "=============================================="

                        CLUSTER_EXISTS=$(aws ecs describe-clusters \
                            --region "${AWS_REGION}" \
                            --clusters "${ECS_CLUSTER}" \
                            --query 'clusters[?status!=`INACTIVE`].clusterName' \
                            --output text 2>/dev/null)

                        if [ -z "${CLUSTER_EXISTS}" ]; then
                            echo "ECS cluster does not exist. Nothing to stop."
                            exit 0
                        fi

                        TASKS=$(aws ecs list-tasks \
                            --region "${AWS_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --desired-status RUNNING \
                            --query 'taskArns[]' \
                            --output text 2>/dev/null)

                        if [ -z "${TASKS}" ]; then
                            echo "No running ECS tasks."
                            exit 0
                        fi

                        for TASK in ${TASKS}; do

                            echo "Stopping task: ${TASK}"

                            aws ecs stop-task \
                                --region "${AWS_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --task "${TASK}" \
                                --reason "Jenkins destroy pipeline"

                        done

                        echo "All running ECS tasks stop requested."
                    '''
                }
            }
        }


        // ============================================================
        // 04 - DELETE ECS SERVICE
        // ============================================================

        stage('04 - Delete ECS Service') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set +e

                        echo "=============================================="
                        echo "DELETING ECS SERVICE"
                        echo "=============================================="

                        STATUS=$(aws ecs describe-services \
                            --region "${AWS_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}" \
                            --query 'services[0].status' \
                            --output text 2>/dev/null)

                        if [ -z "${STATUS}" ] || [ "${STATUS}" = "None" ]; then
                            echo "ECS service does not exist."
                            exit 0
                        fi

                        if [ "${STATUS}" = "INACTIVE" ]; then
                            echo "ECS service is already INACTIVE."
                            exit 0
                        fi

                        echo "Deleting ECS service..."

                        aws ecs update-service \
                            --region "${AWS_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --service "${ECS_SERVICE}" \
                            --desired-count 0 \
                            --force-new-deployment \
                            >/dev/null 2>&1

                        aws ecs delete-service \
                            --region "${AWS_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --service "${ECS_SERVICE}" \
                            --force

                        echo "ECS service deletion requested."

                        echo "Waiting for service removal..."

                        for i in $(seq 1 30); do

                            STATUS=$(aws ecs describe-services \
                                --region "${AWS_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --services "${ECS_SERVICE}" \
                                --query 'services[0].status' \
                                --output text 2>/dev/null)

                            if [ -z "${STATUS}" ] || [ "${STATUS}" = "None" ] || [ "${STATUS}" = "INACTIVE" ]; then
                                echo "ECS service removed."
                                break
                            fi

                            echo "Current service status: ${STATUS}"
                            sleep 5

                        done
                    '''
                }
            }
        }


        // ============================================================
        // 05 - DELETE ECS CLUSTER
        // ============================================================

        stage('05 - Delete ECS Cluster') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set +e

                        echo "=============================================="
                        echo "DELETING ECS CLUSTER"
                        echo "=============================================="

                        STATUS=$(aws ecs describe-clusters \
                            --region "${AWS_REGION}" \
                            --clusters "${ECS_CLUSTER}" \
                            --query 'clusters[0].status' \
                            --output text 2>/dev/null)

                        if [ -z "${STATUS}" ] || [ "${STATUS}" = "None" ] || [ "${STATUS}" = "INACTIVE" ]; then
                            echo "ECS cluster already deleted/inactive."
                            exit 0
                        fi

                        echo "Deleting ECS cluster..."

                        aws ecs delete-cluster \
                            --region "${AWS_REGION}" \
                            --cluster "${ECS_CLUSTER}"

                        echo "ECS cluster deletion requested."
                    '''
                }
            }
        }


        // ============================================================
        // 06 - DELETE ALB LISTENERS
        // ============================================================

        stage('06 - Delete ALB Listeners') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set +e

                        echo "=============================================="
                        echo "DELETING ALB LISTENERS"
                        echo "=============================================="

                        ALB_ARN=$(aws elbv2 describe-load-balancers \
                            --region "${AWS_REGION}" \
                            --names "${ALB_NAME}" \
                            --query 'LoadBalancers[0].LoadBalancerArn' \
                            --output text 2>/dev/null)

                        if [ -z "${ALB_ARN}" ] || [ "${ALB_ARN}" = "None" ]; then
                            echo "ALB does not exist."
                            exit 0
                        fi

                        LISTENERS=$(aws elbv2 describe-listeners \
                            --region "${AWS_REGION}" \
                            --load-balancer-arn "${ALB_ARN}" \
                            --query 'Listeners[].ListenerArn' \
                            --output text 2>/dev/null)

                        if [ -z "${LISTENERS}" ]; then
                            echo "No ALB listeners found."
                            exit 0
                        fi

                        for LISTENER in ${LISTENERS}; do

                            echo "Deleting listener: ${LISTENER}"

                            aws elbv2 delete-listener \
                                --region "${AWS_REGION}" \
                                --listener-arn "${LISTENER}"

                        done

                        echo "ALB listeners deleted."
                    '''
                }
            }
        }


        // ============================================================
        // 07 - DELETE ALB
        // ============================================================

        stage('07 - Delete ALB') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set +e

                        echo "=============================================="
                        echo "DELETING APPLICATION LOAD BALANCER"
                        echo "=============================================="

                        ALB_ARN=$(aws elbv2 describe-load-balancers \
                            --region "${AWS_REGION}" \
                            --names "${ALB_NAME}" \
                            --query 'LoadBalancers[0].LoadBalancerArn' \
                            --output text 2>/dev/null)

                        if [ -z "${ALB_ARN}" ] || [ "${ALB_ARN}" = "None" ]; then
                            echo "ALB already deleted."
                            exit 0
                        fi

                        aws elbv2 delete-load-balancer \
                            --region "${AWS_REGION}" \
                            --load-balancer-arn "${ALB_ARN}"

                        echo "ALB deletion requested."

                        sleep 15
                    '''
                }
            }
        }


        // ============================================================
        // 08 - DELETE TARGET GROUP
        // ============================================================

        stage('08 - Delete Target Group') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set +e

                        echo "=============================================="
                        echo "DELETING TARGET GROUP"
                        echo "=============================================="

                        TG_ARN=$(aws elbv2 describe-target-groups \
                            --region "${AWS_REGION}" \
                            --names "${TARGET_GROUP_NAME}" \
                            --query 'TargetGroups[0].TargetGroupArn' \
                            --output text 2>/dev/null)

                        if [ -z "${TG_ARN}" ] || [ "${TG_ARN}" = "None" ]; then
                            echo "Target group already deleted."
                            exit 0
                        fi

                        aws elbv2 delete-target-group \
                            --region "${AWS_REGION}" \
                            --target-group-arn "${TG_ARN}"

                        echo "Target group deleted."
                    '''
                }
            }
        }


        // ============================================================
        // 09 - DELETE SECURITY GROUPS
        // ============================================================

        stage('09 - Delete Security Groups') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set +e

                        echo "=============================================="
                        echo "DELETING SECURITY GROUPS"
                        echo "=============================================="

                        for SG_NAME in "${ALB_SG_NAME}" "${ECS_SG_NAME}"; do

                            SG_ID=$(aws ec2 describe-security-groups \
                                --region "${AWS_REGION}" \
                                --filters "Name=group-name,Values=${SG_NAME}" \
                                --query 'SecurityGroups[0].GroupId' \
                                --output text 2>/dev/null)

                            if [ -z "${SG_ID}" ] || [ "${SG_ID}" = "None" ]; then
                                echo "Security group ${SG_NAME} does not exist."
                                continue
                            fi

                            echo "Security group found: ${SG_ID}"

                            echo "Removing possible ingress rules..."

                            aws ec2 revoke-security-group-ingress \
                                --region "${AWS_REGION}" \
                                --group-id "${SG_ID}" \
                                --ip-permissions file:///dev/null \
                                >/dev/null 2>&1

                            echo "Removing possible egress rules..."

                            aws ec2 revoke-security-group-egress \
                                --region "${AWS_REGION}" \
                                --group-id "${SG_ID}" \
                                --ip-permissions file:///dev/null \
                                >/dev/null 2>&1

                            echo "Deleting security group..."

                            aws ec2 delete-security-group \
                                --region "${AWS_REGION}" \
                                --group-id "${SG_ID}"

                            if [ $? -eq 0 ]; then
                                echo "Deleted security group: ${SG_ID}"
                            else
                                echo "Could not delete ${SG_ID} immediately."
                                echo "It may still be referenced by AWS resources."
                            fi

                        done
                    '''
                }
            }
        }


        // ============================================================
        // 10 - DELETE CLOUDWATCH LOG GROUP
        // ============================================================

        stage('10 - Delete CloudWatch Log Group') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set +e

                        echo "=============================================="
                        echo "DELETING CLOUDWATCH LOG GROUP"
                        echo "=============================================="

                        aws logs describe-log-groups \
                            --region "${AWS_REGION}" \
                            --log-group-name-prefix "${CLOUDWATCH_LOG_GROUP}" \
                            --query 'logGroups[].logGroupName' \
                            --output text 2>/dev/null |
                        while read LOG_GROUP; do

                            if [ -n "${LOG_GROUP}" ] && [ "${LOG_GROUP}" != "None" ]; then

                                echo "Deleting log group: ${LOG_GROUP}"

                                aws logs delete-log-group \
                                    --region "${AWS_REGION}" \
                                    --log-group-name "${LOG_GROUP}"

                            fi

                        done

                        echo "CloudWatch cleanup completed."
                    '''
                }
            }
        }


        // ============================================================
        // 11 - DEREGISTER ECS TASK DEFINITIONS
        // ============================================================

        stage('11 - Deregister ECS Task Definitions') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set +e

                        echo "=============================================="
                        echo "DEREGISTERING ECS TASK DEFINITIONS"
                        echo "=============================================="

                        REVISIONS=$(aws ecs list-task-definitions \
                            --region "${AWS_REGION}" \
                            --family-prefix "${ECS_TASK_FAMILY}" \
                            --status ACTIVE \
                            --query 'taskDefinitionArns[]' \
                            --output text 2>/dev/null)

                        if [ -z "${REVISIONS}" ]; then
                            echo "No ACTIVE task definitions found."
                            exit 0
                        fi

                        for TASK_DEF in ${REVISIONS}; do

                            echo "Deregistering: ${TASK_DEF}"

                            aws ecs deregister-task-definition \
                                --region "${AWS_REGION}" \
                                --task-definition "${TASK_DEF}" \
                                >/dev/null 2>&1

                        done

                        echo "Task definitions deregistered."
                    '''
                }
            }
        }


        // ============================================================
        // 12 - DELETE IAM EXECUTION ROLE
        // ============================================================

        stage('12 - Delete ECS IAM Execution Role') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set +e

                        echo "=============================================="
                        echo "DELETING ECS IAM EXECUTION ROLE"
                        echo "=============================================="

                        ROLE_EXISTS=$(aws iam get-role \
                            --role-name "${ECS_EXECUTION_ROLE}" \
                            --query 'Role.RoleName' \
                            --output text 2>/dev/null)

                        if [ -z "${ROLE_EXISTS}" ] || [ "${ROLE_EXISTS}" = "None" ]; then
                            echo "IAM role does not exist."
                            exit 0
                        fi

                        echo "Removing managed policies..."

                        POLICIES=$(aws iam list-attached-role-policies \
                            --role-name "${ECS_EXECUTION_ROLE}" \
                            --query 'AttachedPolicies[].PolicyArn' \
                            --output text 2>/dev/null)

                        for POLICY in ${POLICIES}; do

                            if [ -n "${POLICY}" ]; then

                                echo "Detaching: ${POLICY}"

                                aws iam detach-role-policy \
                                    --role-name "${ECS_EXECUTION_ROLE}" \
                                    --policy-arn "${POLICY}"

                            fi

                        done

                        echo "Removing inline policies..."

                        INLINE_POLICIES=$(aws iam list-role-policies \
                            --role-name "${ECS_EXECUTION_ROLE}" \
                            --query 'PolicyNames[]' \
                            --output text 2>/dev/null)

                        for POLICY_NAME in ${INLINE_POLICIES}; do

                            if [ -n "${POLICY_NAME}" ]; then

                                aws iam delete-role-policy \
                                    --role-name "${ECS_EXECUTION_ROLE}" \
                                    --policy-name "${POLICY_NAME}"

                            fi

                        done

                        echo "Deleting IAM role..."

                        aws iam delete-role \
                            --role-name "${ECS_EXECUTION_ROLE}"

                        echo "IAM execution role deleted."
                    '''
                }
            }
        }


        // ============================================================
        // 13 - DELETE ECR
        // ============================================================

        stage('13 - Delete ECR Repository') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set +e

                        echo "=============================================="
                        echo "DELETING ECR REPOSITORY"
                        echo "=============================================="

                        EXISTS=$(aws ecr describe-repositories \
                            --region "${AWS_REGION}" \
                            --repository-names "${ECR_REPOSITORY}" \
                            --query 'repositories[0].repositoryName' \
                            --output text 2>/dev/null)

                        if [ -z "${EXISTS}" ] || [ "${EXISTS}" = "None" ]; then
                            echo "ECR repository does not exist."
                            exit 0
                        fi

                        echo "Deleting repository and ALL images..."

                        aws ecr delete-repository \
                            --region "${AWS_REGION}" \
                            --repository-name "${ECR_REPOSITORY}" \
                            --force

                        echo "ECR repository deleted."
                    '''
                }
            }
        }


        // ============================================================
        // 14 - CHECK TERRAFORM STATE
        // ============================================================

        stage('14 - Checkout Terraform Repository') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    git(
                        branch: "${TERRAFORM_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${TERRAFORM_REPO}"
                    )
                }
            }
        }


        // ============================================================
        // 15 - TERRAFORM INIT
        // ============================================================

        stage('15 - Terraform Init') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    withCredentials([
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${AWS_CREDENTIALS}"
                        ]
                    ]) {

                        sh '''
                            set -e

                            terraform init -input=false
                        '''
                    }
                }
            }
        }


        // ============================================================
        // 16 - TERRAFORM VALIDATE
        // ============================================================

        stage('16 - Terraform Validate') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    sh '''
                        set -e

                        terraform validate
                    '''
                }
            }
        }


        // ============================================================
        // 17 - TERRAFORM DESTROY
        // ============================================================

        stage('17 - Terraform Destroy') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    withCredentials([
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${AWS_CREDENTIALS}"
                        ]
                    ]) {

                        sh '''
                            set +e

                            echo "=============================================="
                            echo "TERRAFORM DESTROY"
                            echo "=============================================="

                            if [ -f "environments/${ENVIRONMENT}/terraform.tfvars" ]; then

                                echo "Using environment:"
                                echo "${ENVIRONMENT}"

                                terraform destroy \
                                    -auto-approve \
                                    -input=false \
                                    -var-file="environments/${ENVIRONMENT}/terraform.tfvars"

                            else

                                echo "Environment tfvars file not found."

                                echo "Attempting standard Terraform destroy..."

                                terraform destroy \
                                    -auto-approve \
                                    -input=false

                            fi

                            TF_EXIT=$?

                            if [ ${TF_EXIT} -eq 0 ]; then
                                echo "Terraform destroy completed."
                            else
                                echo "Terraform destroy returned exit code ${TF_EXIT}."
                                echo "Manual AWS cleanup was already attempted."
                            fi

                            exit 0
                        '''
                    }
                }
            }
        }


        // ============================================================
        // 18 - FINAL AWS VERIFICATION
        // ============================================================

        stage('18 - Final AWS Cleanup Verification') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "FINAL AWS CLEANUP VERIFICATION"
                        echo "================================================"

                        FAILURE_COUNT=0


                        echo ""
                        echo "1. ECS SERVICE"

                        SERVICE_STATUS=$(aws ecs describe-services \
                            --region "${AWS_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}" \
                            --query 'services[0].status' \
                            --output text 2>/dev/null)

                        if [ -z "${SERVICE_STATUS}" ] || \
                           [ "${SERVICE_STATUS}" = "None" ] || \
                           [ "${SERVICE_STATUS}" = "INACTIVE" ]; then

                            echo "PASS: ECS service removed."

                        else

                            echo "FAIL: ECS service still exists: ${SERVICE_STATUS}"
                            FAILURE_COUNT=$((FAILURE_COUNT + 1))

                        fi


                        echo ""
                        echo "2. ECS CLUSTER"

                        CLUSTER_STATUS=$(aws ecs describe-clusters \
                            --region "${AWS_REGION}" \
                            --clusters "${ECS_CLUSTER}" \
                            --query 'clusters[0].status' \
                            --output text 2>/dev/null)

                        if [ -z "${CLUSTER_STATUS}" ] || \
                           [ "${CLUSTER_STATUS}" = "None" ] || \
                           [ "${CLUSTER_STATUS}" = "INACTIVE" ]; then

                            echo "PASS: ECS cluster removed."

                        else

                            echo "FAIL: ECS cluster still exists."
                            FAILURE_COUNT=$((FAILURE_COUNT + 1))

                        fi


                        echo ""
                        echo "3. ALB"

                        ALB_CHECK=$(aws elbv2 describe-load-balancers \
                            --region "${AWS_REGION}" \
                            --names "${ALB_NAME}" \
                            --query 'LoadBalancers[0].LoadBalancerArn' \
                            --output text 2>/dev/null)

                        if [ -z "${ALB_CHECK}" ] || [ "${ALB_CHECK}" = "None" ]; then

                            echo "PASS: ALB removed."

                        else

                            echo "FAIL: ALB still exists."
                            FAILURE_COUNT=$((FAILURE_COUNT + 1))

                        fi


                        echo ""
                        echo "4. TARGET GROUP"

                        TG_CHECK=$(aws elbv2 describe-target-groups \
                            --region "${AWS_REGION}" \
                            --names "${TARGET_GROUP_NAME}" \
                            --query 'TargetGroups[0].TargetGroupArn' \
                            --output text 2>/dev/null)

                        if [ -z "${TG_CHECK}" ] || [ "${TG_CHECK}" = "None" ]; then

                            echo "PASS: Target group removed."

                        else

                            echo "FAIL: Target group still exists."
                            FAILURE_COUNT=$((FAILURE_COUNT + 1))

                        fi


                        echo ""
                        echo "5. ECR"

                        ECR_CHECK=$(aws ecr describe-repositories \
                            --region "${AWS_REGION}" \
                            --repository-names "${ECR_REPOSITORY}" \
                            --query 'repositories[0].repositoryName' \
                            --output text 2>/dev/null)

                        if [ -z "${ECR_CHECK}" ] || [ "${ECR_CHECK}" = "None" ]; then

                            echo "PASS: ECR repository removed."

                        else

                            echo "FAIL: ECR repository still exists."
                            FAILURE_COUNT=$((FAILURE_COUNT + 1))

                        fi


                        echo ""
                        echo "6. IAM ROLE"

                        IAM_CHECK=$(aws iam get-role \
                            --role-name "${ECS_EXECUTION_ROLE}" \
                            --query 'Role.RoleName' \
                            --output text 2>/dev/null)

                        if [ -z "${IAM_CHECK}" ] || [ "${IAM_CHECK}" = "None" ]; then

                            echo "PASS: IAM execution role removed."

                        else

                            echo "FAIL: IAM role still exists."
                            FAILURE_COUNT=$((FAILURE_COUNT + 1))

                        fi


                        echo ""
                        echo "================================================"
                        echo "FINAL CLEANUP RESULT"
                        echo "================================================"

                        if [ ${FAILURE_COUNT} -eq 0 ]; then

                            echo "ALL CHECKED AWS RESOURCES ARE CLEAN."
                            exit 0

                        else

                            echo "${FAILURE_COUNT} resource check(s) still report existing resources."

                            echo ""
                            echo "This pipeline intentionally does not fail merely"
                            echo "because an already-deleted AWS resource returns"
                            echo "a *NotFound error."

                            exit 0

                        fi
                    '''
                }
            }
        }


        // ============================================================
        // 19 - BACKEND VERIFICATION
        // ============================================================

        stage('19 - Verify Terraform Backend Remains') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "VERIFYING TERRAFORM BACKEND"
                        echo "================================================"

                        echo "S3 State Bucket:"
                        aws s3api head-bucket \
                            --bucket "${TF_STATE_BUCKET}" \
                            --region "${AWS_REGION}" \
                            >/dev/null 2>&1

                        if [ $? -eq 0 ]; then
                            echo "PASS: Terraform state bucket still exists."
                        else
                            echo "WARNING: Terraform state bucket not found."
                        fi

                        echo ""
                        echo "DynamoDB Lock Table:"

                        aws dynamodb describe-table \
                            --table-name "${TF_LOCK_TABLE}" \
                            --region "${AWS_REGION}" \
                            >/dev/null 2>&1

                        if [ $? -eq 0 ]; then
                            echo "PASS: Terraform lock table still exists."
                        else
                            echo "WARNING: Terraform lock table not found."
                        fi
                    '''
                }
            }
        }


        // ============================================================
        // 20 - DESTROY SUMMARY
        // ============================================================

        stage('20 - Destroy Summary') {

            steps {

                echo '================================================'
                echo '           DESTROY PIPELINE COMPLETE'
                echo '================================================'

                echo 'ECS service cleanup attempted.'
                echo 'ECS cluster cleanup attempted.'
                echo 'ALB cleanup attempted.'
                echo 'Target group cleanup attempted.'
                echo 'Security group cleanup attempted.'
                echo 'CloudWatch cleanup attempted.'
                echo 'IAM role cleanup attempted.'
                echo 'ECR cleanup attempted.'
                echo 'Terraform destroy attempted.'
                echo 'Terraform backend was NOT intentionally deleted.'

                echo '================================================'
            }
        }
    }


    // ================================================================
    // POST ACTIONS
    // ================================================================

    post {

        always {

            echo '================================================'
            echo 'CLEANING JENKINS WORKSPACE'
            echo '================================================'

            cleanWs()
        }

        success {

            echo '================================================'
            echo '       DESTROY PIPELINE FINISHED'
            echo '================================================'

            echo 'AWS cleanup operations completed.'
        }

        failure {

            echo '================================================'
            echo '       DESTROY PIPELINE FAILED'
            echo '================================================'

            echo 'Check the stage that failed.'
        }
    }
}
