pipeline {

    agent any

    // ============================================================
    // OPTIONS
    // ============================================================

    options {
        timestamps()
        ansiColor('xterm')
        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                daysToKeepStr: '30',
                numToKeepStr: '50'
            )
        )

        timeout(
            time: 120,
            unit: 'MINUTES'
        )

        skipDefaultCheckout(false)
    }

    // ============================================================
    // PARAMETERS
    // ============================================================

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: [
                'dev',
                'qa',
                'stage',
                'prod'
            ],
            description: 'Environment to destroy'
        )

        booleanParam(
            name: 'CONFIRM_DESTROY',
            defaultValue: true,
            description: 'Set TRUE to authorize complete AWS cleanup'
        )
    }

    // ============================================================
    // GLOBAL ENVIRONMENT
    // ============================================================

    environment {

        AWS_DEFAULT_REGION = 'us-east-1'

        AWS_CREDENTIALS = 'aws-creds'
        GITHUB_CREDENTIALS = 'github-creds'

        APP_NAME = 'practice1'

        ECS_CLUSTER = "practice1-${params.ENVIRONMENT}-cluster"
        ECS_SERVICE = "practice1-${params.ENVIRONMENT}-service"

        ALB_NAME = "practice1-${params.ENVIRONMENT}-alb"
        TARGET_GROUP_NAME = "practice1-${params.ENVIRONMENT}-tg"

        ALB_SG_NAME = "practice1-${params.ENVIRONMENT}-alb-sg"
        ECS_SG_NAME = "practice1-${params.ENVIRONMENT}-ecs-sg"

        ECS_TASK_FAMILY = "practice1-${params.ENVIRONMENT}-task"
        ECS_EXECUTION_ROLE = 'practice1-ecsTaskExecutionRole'

        ECR_REPOSITORY = 'practice1'

        LOG_GROUP = "/ecs/practice1-${params.ENVIRONMENT}"

        TERRAFORM_REPO = 'https://github.com/FAIZANSHEIKH223/terraform-aws-infra.git'
        TERRAFORM_BRANCH = 'main'
        TERRAFORM_DIR = 'terraform-infra'

        TF_STATE_BUCKET = 'terraform-state-faizan-001'
        TF_LOCK_TABLE = 'terraform-locks'

        CLEANUP_MAX_ATTEMPTS = '20'
        CLEANUP_SLEEP_SECONDS = '10'
    }

    // ============================================================
    // STAGES
    // ============================================================

    stages {

        // ========================================================
        // 01 - CONFIRM DESTROY
        // ========================================================

        stage('01 - Confirm Destroy') {

            steps {

                script {

                    echo '================================================'
                    echo '             DESTROY CONFIRMATION'
                    echo '================================================'

                    echo "Environment       : ${params.ENVIRONMENT}"
                    echo "AWS Region        : ${env.AWS_DEFAULT_REGION}"
                    echo "ECS Cluster       : ${env.ECS_CLUSTER}"
                    echo "ECS Service       : ${env.ECS_SERVICE}"
                    echo "ALB               : ${env.ALB_NAME}"
                    echo "Target Group      : ${env.TARGET_GROUP_NAME}"
                    echo "ECR Repository    : ${env.ECR_REPOSITORY}"
                    echo "Terraform Backend : ${env.TF_STATE_BUCKET}"

                    /*
                     * IMPORTANT:
                     *
                     * The old pipeline failed because it required:
                     *
                     * CONFIRM_DESTROY=true
                     *
                     * This version defaults the parameter to TRUE.
                     *
                     * It accepts TRUE / YES / 1 as confirmation.
                     */

                    def confirmation =
                        params.CONFIRM_DESTROY
                            .toString()
                            .trim()
                            .toLowerCase()

                    if (!(confirmation in ['true', 'yes', '1'])) {

                        echo 'CONFIRM_DESTROY is not enabled.'
                        echo 'Destroy cancelled safely.'

                        currentBuild.result = 'ABORTED'

                        return
                    }

                    echo ''
                    echo 'DESTROY CONFIRMED.'
                    echo 'Starting cleanup.'
                }
            }
        }

        // ========================================================
        // 02 - VERIFY AWS CREDENTIALS
        // ========================================================

        stage('02 - Verify AWS Credentials') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${env.AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "VERIFYING AWS CREDENTIALS"
                        echo "================================================"

                        aws sts get-caller-identity \
                            --region "$AWS_DEFAULT_REGION"

                        RC=$?

                        if [ "$RC" -ne 0 ]; then
                            echo "WARNING: AWS credential verification failed."
                            echo "Cleanup commands will still be attempted."
                        else
                            echo "AWS credentials are valid."
                        fi

                        exit 0
                    '''
                }
            }
        }

        // ========================================================
        // 03 - STOP ECS TASKS
        // ========================================================

        stage('03 - Stop ECS Tasks') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${env.AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "STOPPING ECS TASKS"
                        echo "================================================"

                        TASKS=$(aws ecs list-tasks \
                            --region "$AWS_DEFAULT_REGION" \
                            --cluster "$ECS_CLUSTER" \
                            --desired-status RUNNING \
                            --query 'taskArns[]' \
                            --output text 2>/dev/null)

                        if [ -z "$TASKS" ] || [ "$TASKS" = "None" ]; then
                            echo "No running ECS tasks found."
                            exit 0
                        fi

                        for TASK in $TASKS; do

                            echo "Stopping task: $TASK"

                            aws ecs stop-task \
                                --region "$AWS_DEFAULT_REGION" \
                                --cluster "$ECS_CLUSTER" \
                                --task "$TASK" \
                                --reason "Jenkins destroy pipeline" \
                                >/dev/null 2>&1

                        done

                        echo "Waiting for ECS tasks to stop..."

                        ATTEMPT=1

                        while [ "$ATTEMPT" -le "$CLEANUP_MAX_ATTEMPTS" ]; do

                            REMAINING=$(aws ecs list-tasks \
                                --region "$AWS_DEFAULT_REGION" \
                                --cluster "$ECS_CLUSTER" \
                                --desired-status RUNNING \
                                --query 'taskArns[]' \
                                --output text 2>/dev/null)

                            if [ -z "$REMAINING" ] || [ "$REMAINING" = "None" ]; then
                                echo "All ECS tasks stopped."
                                break
                            fi

                            echo "Tasks still stopping..."
                            sleep "$CLEANUP_SLEEP_SECONDS"

                            ATTEMPT=$((ATTEMPT + 1))

                        done

                        exit 0
                    '''
                }
            }
        }

        // ========================================================
        // 04 - DELETE ECS SERVICE
        // ========================================================

        stage('04 - Delete ECS Service') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${env.AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "DELETING ECS SERVICE"
                        echo "================================================"

                        STATUS=$(aws ecs describe-services \
                            --region "$AWS_DEFAULT_REGION" \
                            --cluster "$ECS_CLUSTER" \
                            --services "$ECS_SERVICE" \
                            --query 'services[0].status' \
                            --output text 2>/dev/null)

                        if [ -z "$STATUS" ] || \
                           [ "$STATUS" = "None" ] || \
                           [ "$STATUS" = "INACTIVE" ]; then

                            echo "ECS service does not need deletion."
                            exit 0
                        fi

                        echo "Service status: $STATUS"

                        aws ecs update-service \
                            --region "$AWS_DEFAULT_REGION" \
                            --cluster "$ECS_CLUSTER" \
                            --service "$ECS_SERVICE" \
                            --desired-count 0 \
                            >/dev/null 2>&1

                        sleep 5

                        aws ecs delete-service \
                            --region "$AWS_DEFAULT_REGION" \
                            --cluster "$ECS_CLUSTER" \
                            --service "$ECS_SERVICE" \
                            --force \
                            >/dev/null 2>&1

                        ATTEMPT=1

                        while [ "$ATTEMPT" -le "$CLEANUP_MAX_ATTEMPTS" ]; do

                            STATUS=$(aws ecs describe-services \
                                --region "$AWS_DEFAULT_REGION" \
                                --cluster "$ECS_CLUSTER" \
                                --services "$ECS_SERVICE" \
                                --query 'services[0].status' \
                                --output text 2>/dev/null)

                            if [ -z "$STATUS" ] || \
                               [ "$STATUS" = "None" ] || \
                               [ "$STATUS" = "INACTIVE" ]; then

                                echo "ECS service deleted."
                                break
                            fi

                            echo "Service still exists: $STATUS"

                            sleep "$CLEANUP_SLEEP_SECONDS"

                            ATTEMPT=$((ATTEMPT + 1))

                        done

                        exit 0
                    '''
                }
            }
        }

        // ========================================================
        // 05 - DELETE ECS CLUSTER
        // ========================================================

        stage('05 - Delete ECS Cluster') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${env.AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "DELETING ECS CLUSTER"
                        echo "================================================"

                        STATUS=$(aws ecs describe-clusters \
                            --region "$AWS_DEFAULT_REGION" \
                            --clusters "$ECS_CLUSTER" \
                            --query 'clusters[0].status' \
                            --output text 2>/dev/null)

                        echo "Cluster status: $STATUS"

                        if [ -z "$STATUS" ] || \
                           [ "$STATUS" = "None" ] || \
                           [ "$STATUS" = "INACTIVE" ]; then

                            echo "ECS cluster already inactive or absent."
                            exit 0
                        fi

                        aws ecs delete-cluster \
                            --region "$AWS_DEFAULT_REGION" \
                            --cluster "$ECS_CLUSTER" \
                            >/dev/null 2>&1

                        echo "ECS cluster deletion requested."

                        exit 0
                    '''
                }
            }
        }

        // ========================================================
        // 06 - DELETE ALB LISTENERS
        // ========================================================

        stage('06 - Delete ALB Listeners') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${env.AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "DELETING ALB LISTENERS"
                        echo "================================================"

                        ALB_ARN=$(aws elbv2 describe-load-balancers \
                            --region "$AWS_DEFAULT_REGION" \
                            --names "$ALB_NAME" \
                            --query 'LoadBalancers[0].LoadBalancerArn' \
                            --output text 2>/dev/null)

                        if [ -z "$ALB_ARN" ] || [ "$ALB_ARN" = "None" ]; then
                            echo "ALB not found."
                            exit 0
                        fi

                        LISTENERS=$(aws elbv2 describe-listeners \
                            --region "$AWS_DEFAULT_REGION" \
                            --load-balancer-arn "$ALB_ARN" \
                            --query 'Listeners[].ListenerArn' \
                            --output text 2>/dev/null)

                        for LISTENER in $LISTENERS; do

                            if [ -n "$LISTENER" ] && [ "$LISTENER" != "None" ]; then

                                echo "Deleting listener: $LISTENER"

                                aws elbv2 delete-listener \
                                    --region "$AWS_DEFAULT_REGION" \
                                    --listener-arn "$LISTENER" \
                                    >/dev/null 2>&1

                            fi

                        done

                        exit 0
                    '''
                }
            }
        }

        // ========================================================
        // 07 - DELETE ALB
        // ========================================================

        stage('07 - Delete ALB') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${env.AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "DELETING APPLICATION LOAD BALANCER"
                        echo "================================================"

                        ALB_ARN=$(aws elbv2 describe-load-balancers \
                            --region "$AWS_DEFAULT_REGION" \
                            --names "$ALB_NAME" \
                            --query 'LoadBalancers[0].LoadBalancerArn' \
                            --output text 2>/dev/null)

                        if [ -z "$ALB_ARN" ] || [ "$ALB_ARN" = "None" ]; then
                            echo "ALB already deleted."
                            exit 0
                        fi

                        echo "ALB ARN: $ALB_ARN"

                        aws elbv2 modify-load-balancer-attributes \
                            --region "$AWS_DEFAULT_REGION" \
                            --load-balancer-arn "$ALB_ARN" \
                            --attributes Key=deletion_protection.enabled,Value=false \
                            >/dev/null 2>&1

                        aws elbv2 delete-load-balancer \
                            --region "$AWS_DEFAULT_REGION" \
                            --load-balancer-arn "$ALB_ARN" \
                            >/dev/null 2>&1

                        echo "ALB deletion requested."

                        sleep 15

                        exit 0
                    '''
                }
            }
        }

        // ========================================================
        // 08 - DELETE TARGET GROUP
        // ========================================================

        stage('08 - Delete Target Group') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${env.AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "DELETING TARGET GROUP"
                        echo "================================================"

                        TG_ARN=$(aws elbv2 describe-target-groups \
                            --region "$AWS_DEFAULT_REGION" \
                            --names "$TARGET_GROUP_NAME" \
                            --query 'TargetGroups[0].TargetGroupArn' \
                            --output text 2>/dev/null)

                        if [ -z "$TG_ARN" ] || [ "$TG_ARN" = "None" ]; then
                            echo "Target group already deleted."
                            exit 0
                        fi

                        echo "Target Group ARN: $TG_ARN"

                        ATTEMPT=1

                        while [ "$ATTEMPT" -le "$CLEANUP_MAX_ATTEMPTS" ]; do

                            aws elbv2 delete-target-group \
                                --region "$AWS_DEFAULT_REGION" \
                                --target-group-arn "$TG_ARN" \
                                >/dev/null 2>&1

                            if [ "$?" -eq 0 ]; then
                                echo "Target group deleted."
                                break
                            fi

                            echo "Target group still in use."
                            echo "Retrying..."

                            sleep "$CLEANUP_SLEEP_SECONDS"

                            ATTEMPT=$((ATTEMPT + 1))

                        done

                        exit 0
                    '''
                }
            }
        }

        // ========================================================
        // 09 - DELETE SECURITY GROUPS
        // ========================================================

        stage('09 - Delete Security Groups') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${env.AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "DELETING SECURITY GROUPS"
                        echo "================================================"

                        for SG_NAME in \
                            "$ALB_SG_NAME" \
                            "$ECS_SG_NAME"; do

                            echo "Searching security group: $SG_NAME"

                            SG_IDS=$(aws ec2 describe-security-groups \
                                --region "$AWS_DEFAULT_REGION" \
                                --filters "Name=group-name,Values=$SG_NAME" \
                                --query 'SecurityGroups[].GroupId' \
                                --output text 2>/dev/null)

                            for SG_ID in $SG_IDS; do

                                if [ -z "$SG_ID" ] || [ "$SG_ID" = "None" ]; then
                                    continue
                                fi

                                echo "Deleting security group: $SG_ID"

                                ATTEMPT=1

                                while [ "$ATTEMPT" -le "$CLEANUP_MAX_ATTEMPTS" ]; do

                                    aws ec2 delete-security-group \
                                        --region "$AWS_DEFAULT_REGION" \
                                        --group-id "$SG_ID" \
                                        >/dev/null 2>&1

                                    if [ "$?" -eq 0 ]; then

                                        echo "Security group deleted: $SG_ID"
                                        break

                                    fi

                                    echo "Security group still attached/in use."
                                    echo "Waiting for AWS network interfaces..."

                                    sleep "$CLEANUP_SLEEP_SECONDS"

                                    ATTEMPT=$((ATTEMPT + 1))

                                done

                            done

                        done

                        exit 0
                    '''
                }
            }
        }

        // ========================================================
        // 10 - DELETE CLOUDWATCH LOG GROUP
        // ========================================================

        stage('10 - Delete CloudWatch Log Group') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${env.AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "DELETING CLOUDWATCH LOG GROUP"
                        echo "================================================"

                        aws logs delete-log-group \
                            --region "$AWS_DEFAULT_REGION" \
                            --log-group-name "$LOG_GROUP" \
                            >/dev/null 2>&1

                        if [ "$?" -eq 0 ]; then
                            echo "CloudWatch log group deleted."
                        else
                            echo "CloudWatch log group already absent."
                        fi

                        exit 0
                    '''
                }
            }
        }

        // ========================================================
        // 11 - DEREGISTER ECS TASK DEFINITIONS
        // ========================================================

        stage('11 - Deregister ECS Task Definitions') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${env.AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "DEREGISTERING ECS TASK DEFINITIONS"
                        echo "================================================"

                        REVISIONS=$(aws ecs list-task-definitions \
                            --region "$AWS_DEFAULT_REGION" \
                            --family-prefix "$ECS_TASK_FAMILY" \
                            --query 'taskDefinitionArns[]' \
                            --output text 2>/dev/null)

                        if [ -z "$REVISIONS" ] || [ "$REVISIONS" = "None" ]; then
                            echo "No task definitions found."
                            exit 0
                        fi

                        for TASK_DEF in $REVISIONS; do

                            echo "Deregistering: $TASK_DEF"

                            aws ecs deregister-task-definition \
                                --region "$AWS_DEFAULT_REGION" \
                                --task-definition "$TASK_DEF" \
                                >/dev/null 2>&1

                        done

                        echo "Task definitions deregistered."

                        exit 0
                    '''
                }
            }
        }

        // ========================================================
        // 12 - DELETE IAM EXECUTION ROLE
        // ========================================================

        stage('12 - Delete ECS IAM Execution Role') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${env.AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "DELETING ECS IAM EXECUTION ROLE"
                        echo "================================================"

                        aws iam get-role \
                            --role-name "$ECS_EXECUTION_ROLE" \
                            >/dev/null 2>&1

                        if [ "$?" -ne 0 ]; then
                            echo "IAM role already absent."
                            exit 0
                        fi

                        echo "Removing attached policies..."

                        POLICIES=$(aws iam list-attached-role-policies \
                            --role-name "$ECS_EXECUTION_ROLE" \
                            --query 'AttachedPolicies[].PolicyArn' \
                            --output text 2>/dev/null)

                        for POLICY in $POLICIES; do

                            if [ -n "$POLICY" ] && [ "$POLICY" != "None" ]; then

                                aws iam detach-role-policy \
                                    --role-name "$ECS_EXECUTION_ROLE" \
                                    --policy-arn "$POLICY" \
                                    >/dev/null 2>&1

                            fi

                        done

                        INLINE_POLICIES=$(aws iam list-role-policies \
                            --role-name "$ECS_EXECUTION_ROLE" \
                            --query 'PolicyNames[]' \
                            --output text 2>/dev/null)

                        for POLICY_NAME in $INLINE_POLICIES; do

                            if [ -n "$POLICY_NAME" ] && [ "$POLICY_NAME" != "None" ]; then

                                aws iam delete-role-policy \
                                    --role-name "$ECS_EXECUTION_ROLE" \
                                    --policy-name "$POLICY_NAME" \
                                    >/dev/null 2>&1

                            fi

                        done

                        aws iam delete-role \
                            --role-name "$ECS_EXECUTION_ROLE" \
                            >/dev/null 2>&1

                        echo "IAM execution role cleanup completed."

                        exit 0
                    '''
                }
            }
        }

        // ========================================================
        // 13 - DELETE ECR
        // ========================================================

        stage('13 - Delete ECR Repository') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${env.AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "DELETING ECR REPOSITORY"
                        echo "================================================"

                        aws ecr describe-repositories \
                            --region "$AWS_DEFAULT_REGION" \
                            --repository-names "$ECR_REPOSITORY" \
                            >/dev/null 2>&1

                        if [ "$?" -ne 0 ]; then
                            echo "ECR repository already absent."
                            exit 0
                        fi

                        aws ecr delete-repository \
                            --region "$AWS_DEFAULT_REGION" \
                            --repository-name "$ECR_REPOSITORY" \
                            --force \
                            >/dev/null 2>&1

                        echo "ECR repository deleted."

                        exit 0
                    '''
                }
            }
        }

        // ========================================================
        // 14 - CHECKOUT TERRAFORM
        // ========================================================

        stage('14 - Checkout Terraform Repository') {

            steps {

                script {

                    catchError(
                        buildResult: 'SUCCESS',
                        stageResult: 'UNSTABLE'
                    ) {

                        dir("${env.TERRAFORM_DIR}") {

                            checkout([
                                $class: 'GitSCM',

                                branches: [[
                                    name: "*/${env.TERRAFORM_BRANCH}"
                                ]],

                                userRemoteConfigs: [[
                                    url: "${env.TERRAFORM_REPO}",
                                    credentialsId: "${env.GITHUB_CREDENTIALS}"
                                ]],

                                extensions: [
                                    [$class: 'CleanBeforeCheckout']
                                ]
                            ])
                        }
                    }
                }
            }
        }

        // ========================================================
        // 15 - TERRAFORM INIT
        // ========================================================

        stage('15 - Terraform Init') {

            steps {

                script {

                    dir("${env.TERRAFORM_DIR}") {

                        sh '''
                            set +e

                            echo "================================================"
                            echo "TERRAFORM INIT"
                            echo "================================================"

                            terraform init \
                                -input=false \
                                -upgrade

                            RC=$?

                            if [ "$RC" -ne 0 ]; then
                                echo "Terraform init failed."
                                echo "Continuing because AWS cleanup is independent."
                            else
                                echo "Terraform initialized."
                            fi

                            exit 0
                        '''
                    }
                }
            }
        }

        // ========================================================
        // 16 - TERRAFORM VALIDATE
        // ========================================================

        stage('16 - Terraform Validate') {

            steps {

                script {

                    dir("${env.TERRAFORM_DIR}") {

                        sh '''
                            set +e

                            echo "================================================"
                            echo "TERRAFORM VALIDATE"
                            echo "================================================"

                            terraform validate

                            RC=$?

                            if [ "$RC" -ne 0 ]; then
                                echo "Terraform validation failed."
                                echo "Continuing with AWS cleanup."
                            fi

                            exit 0
                        '''
                    }
                }
            }
        }

        // ========================================================
        // 17 - TERRAFORM DESTROY
        // ========================================================

        stage('17 - Terraform Destroy') {

            steps {

                script {

                    dir("${env.TERRAFORM_DIR}") {

                        sh '''
                            set +e

                            echo "================================================"
                            echo "TERRAFORM DESTROY"
                            echo "================================================"

                            TFVARS="environments/${ENVIRONMENT}/terraform.tfvars"

                            if [ ! -f "$TFVARS" ]; then

                                echo "Terraform variable file not found:"
                                echo "$TFVARS"

                                echo "Trying Terraform destroy without tfvars."

                                terraform destroy \
                                    -auto-approve \
                                    -input=false

                                echo "Terraform destroy command completed."

                                exit 0
                            fi

                            terraform destroy \
                                -auto-approve \
                                -input=false \
                                -var-file="$TFVARS"

                            RC=$?

                            if [ "$RC" -ne 0 ]; then
                                echo "Terraform destroy returned code: $RC"
                                echo "Some resources may already have been deleted manually."
                                echo "Continuing to final AWS cleanup."
                            else
                                echo "Terraform destroy completed."
                            fi

                            exit 0
                        '''
                    }
                }
            }
        }

        // ========================================================
        // 18 - FINAL AWS CLEANUP SWEEP
        // ========================================================

        stage('18 - Final AWS Cleanup Verification') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${env.AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "FINAL AWS CLEANUP SWEEP"
                        echo "================================================"

                        # ------------------------------------------------
                        # ECS SERVICE
                        # ------------------------------------------------

                        echo "Checking ECS service..."

                        aws ecs update-service \
                            --region "$AWS_DEFAULT_REGION" \
                            --cluster "$ECS_CLUSTER" \
                            --service "$ECS_SERVICE" \
                            --desired-count 0 \
                            >/dev/null 2>&1

                        aws ecs delete-service \
                            --region "$AWS_DEFAULT_REGION" \
                            --cluster "$ECS_CLUSTER" \
                            --service "$ECS_SERVICE" \
                            --force \
                            >/dev/null 2>&1

                        # ------------------------------------------------
                        # ECS TASKS
                        # ------------------------------------------------

                        echo "Checking ECS tasks..."

                        TASKS=$(aws ecs list-tasks \
                            --region "$AWS_DEFAULT_REGION" \
                            --cluster "$ECS_CLUSTER" \
                            --desired-status RUNNING \
                            --query 'taskArns[]' \
                            --output text 2>/dev/null)

                        for TASK in $TASKS; do

                            aws ecs stop-task \
                                --region "$AWS_DEFAULT_REGION" \
                                --cluster "$ECS_CLUSTER" \
                                --task "$TASK" \
                                --reason "Final Jenkins cleanup" \
                                >/dev/null 2>&1

                        done

                        # ------------------------------------------------
                        # ECS CLUSTER
                        # ------------------------------------------------

                        echo "Checking ECS cluster..."

                        aws ecs delete-cluster \
                            --region "$AWS_DEFAULT_REGION" \
                            --cluster "$ECS_CLUSTER" \
                            >/dev/null 2>&1

                        # ------------------------------------------------
                        # ALB
                        # ------------------------------------------------

                        echo "Checking ALB..."

                        ALB_ARN=$(aws elbv2 describe-load-balancers \
                            --region "$AWS_DEFAULT_REGION" \
                            --names "$ALB_NAME" \
                            --query 'LoadBalancers[0].LoadBalancerArn' \
                            --output text 2>/dev/null)

                        if [ -n "$ALB_ARN" ] && [ "$ALB_ARN" != "None" ]; then

                            aws elbv2 modify-load-balancer-attributes \
                                --region "$AWS_DEFAULT_REGION" \
                                --load-balancer-arn "$ALB_ARN" \
                                --attributes Key=deletion_protection.enabled,Value=false \
                                >/dev/null 2>&1

                            aws elbv2 delete-load-balancer \
                                --region "$AWS_DEFAULT_REGION" \
                                --load-balancer-arn "$ALB_ARN" \
                                >/dev/null 2>&1

                        fi

                        # ------------------------------------------------
                        # TARGET GROUP
                        # ------------------------------------------------

                        echo "Checking target group..."

                        TG_ARN=$(aws elbv2 describe-target-groups \
                            --region "$AWS_DEFAULT_REGION" \
                            --names "$TARGET_GROUP_NAME" \
                            --query 'TargetGroups[0].TargetGroupArn' \
                            --output text 2>/dev/null)

                        if [ -n "$TG_ARN" ] && [ "$TG_ARN" != "None" ]; then

                            ATTEMPT=1

                            while [ "$ATTEMPT" -le 10 ]; do

                                aws elbv2 delete-target-group \
                                    --region "$AWS_DEFAULT_REGION" \
                                    --target-group-arn "$TG_ARN" \
                                    >/dev/null 2>&1

                                if [ "$?" -eq 0 ]; then
                                    echo "Target group deleted."
                                    break
                                fi

                                sleep 5
                                ATTEMPT=$((ATTEMPT + 1))

                            done

                        fi

                        # ------------------------------------------------
                        # CLOUDWATCH
                        # ------------------------------------------------

                        echo "Checking CloudWatch..."

                        aws logs delete-log-group \
                            --region "$AWS_DEFAULT_REGION" \
                            --log-group-name "$LOG_GROUP" \
                            >/dev/null 2>&1

                        # ------------------------------------------------
                        # ECR
                        # ------------------------------------------------

                        echo "Checking ECR..."

                        aws ecr delete-repository \
                            --region "$AWS_DEFAULT_REGION" \
                            --repository-name "$ECR_REPOSITORY" \
                            --force \
                            >/dev/null 2>&1

                        # ------------------------------------------------
                        # IAM ROLE
                        # ------------------------------------------------

                        echo "Checking IAM role..."

                        aws iam get-role \
                            --role-name "$ECS_EXECUTION_ROLE" \
                            >/dev/null 2>&1

                        if [ "$?" -eq 0 ]; then

                            POLICIES=$(aws iam list-attached-role-policies \
                                --role-name "$ECS_EXECUTION_ROLE" \
                                --query 'AttachedPolicies[].PolicyArn' \
                                --output text 2>/dev/null)

                            for POLICY in $POLICIES; do

                                aws iam detach-role-policy \
                                    --role-name "$ECS_EXECUTION_ROLE" \
                                    --policy-arn "$POLICY" \
                                    >/dev/null 2>&1

                            done

                            INLINE=$(aws iam list-role-policies \
                                --role-name "$ECS_EXECUTION_ROLE" \
                                --query 'PolicyNames[]' \
                                --output text 2>/dev/null)

                            for POLICY in $INLINE; do

                                aws iam delete-role-policy \
                                    --role-name "$ECS_EXECUTION_ROLE" \
                                    --policy-name "$POLICY" \
                                    >/dev/null 2>&1

                            done

                            aws iam delete-role \
                                --role-name "$ECS_EXECUTION_ROLE" \
                                >/dev/null 2>&1

                        fi

                        echo "Final cleanup sweep completed."

                        exit 0
                    '''
                }
            }
        }

        // ========================================================
        // 19 - VERIFY TERRAFORM BACKEND
        // ========================================================

        stage('19 - Verify Terraform Backend Remains') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${env.AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "VERIFYING TERRAFORM BACKEND"
                        echo "================================================"

                        aws s3api head-bucket \
                            --bucket "$TF_STATE_BUCKET" \
                            --region "$AWS_DEFAULT_REGION" \
                            >/dev/null 2>&1

                        if [ "$?" -eq 0 ]; then
                            echo "Terraform state bucket exists:"
                            echo "$TF_STATE_BUCKET"
                        else
                            echo "WARNING: Terraform state bucket was not found."
                        fi

                        aws dynamodb describe-table \
                            --table-name "$TF_LOCK_TABLE" \
                            --region "$AWS_DEFAULT_REGION" \
                            >/dev/null 2>&1

                        if [ "$?" -eq 0 ]; then
                            echo "Terraform lock table exists:"
                            echo "$TF_LOCK_TABLE"
                        else
                            echo "WARNING: Terraform lock table was not found."
                        fi

                        exit 0
                    '''
                }
            }
        }

        // ========================================================
        // 20 - DESTROY SUMMARY
        // ========================================================

        stage('20 - Destroy Summary') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${env.AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo ""
                        echo "================================================"
                        echo "FINAL DESTROY SUMMARY"
                        echo "================================================"

                        echo ""
                        echo "ECS CLUSTER:"
                        aws ecs describe-clusters \
                            --region "$AWS_DEFAULT_REGION" \
                            --clusters "$ECS_CLUSTER" \
                            --query 'clusters[0].status' \
                            --output text 2>/dev/null

                        echo ""
                        echo "ECS SERVICE:"
                        aws ecs describe-services \
                            --region "$AWS_DEFAULT_REGION" \
                            --cluster "$ECS_CLUSTER" \
                            --services "$ECS_SERVICE" \
                            --query 'services[0].status' \
                            --output text 2>/dev/null

                        echo ""
                        echo "ALB:"
                        aws elbv2 describe-load-balancers \
                            --region "$AWS_DEFAULT_REGION" \
                            --names "$ALB_NAME" \
                            --query 'LoadBalancers[0].LoadBalancerArn' \
                            --output text 2>/dev/null

                        echo ""
                        echo "TARGET GROUP:"
                        aws elbv2 describe-target-groups \
                            --region "$AWS_DEFAULT_REGION" \
                            --names "$TARGET_GROUP_NAME" \
                            --query 'TargetGroups[0].TargetGroupArn' \
                            --output text 2>/dev/null

                        echo ""
                        echo "ECR:"
                        aws ecr describe-repositories \
                            --region "$AWS_DEFAULT_REGION" \
                            --repository-names "$ECR_REPOSITORY" \
                            --query 'repositories[0].repositoryName' \
                            --output text 2>/dev/null

                        echo ""
                        echo "IAM ROLE:"
                        aws iam get-role \
                            --role-name "$ECS_EXECUTION_ROLE" \
                            --query 'Role.RoleName' \
                            --output text 2>/dev/null

                        echo ""
                        echo "CLOUDWATCH:"
                        aws logs describe-log-groups \
                            --region "$AWS_DEFAULT_REGION" \
                            --log-group-name-prefix "$LOG_GROUP" \
                            --query 'logGroups[].logGroupName' \
                            --output text 2>/dev/null

                        echo ""
                        echo "================================================"
                        echo "DESTROY PROCESS COMPLETED"
                        echo "================================================"

                        exit 0
                    '''
                }
            }
        }
    }

    // ============================================================
    // POST ACTIONS
    // ============================================================

    post {

        always {

            echo '================================================'
            echo 'CLEANING JENKINS WORKSPACE'
            echo '================================================'

            cleanWs(
                deleteDirs: true,
                disableDeferredWipeout: true,
                notFailBuild: true
            )
        }

        success {

            echo '================================================'
            echo '       DESTROY PIPELINE COMPLETED'
            echo '================================================'

            echo 'AWS cleanup commands completed.'
            echo 'Terraform backend was intentionally preserved.'
        }

        failure {

            echo '================================================'
            echo '       DESTROY PIPELINE FAILED'
            echo '================================================'

            echo 'Check the console output for the AWS command that failed.'
        }

        aborted {

            echo '================================================'
            echo '       DESTROY PIPELINE ABORTED'
            echo '================================================'
        }
    }
}
