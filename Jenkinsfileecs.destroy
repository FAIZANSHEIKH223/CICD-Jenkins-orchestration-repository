pipeline {

    agent any

    // ================================================================
    // OPTIONS
    // ================================================================

    options {

        timestamps()

        ansiColor('xterm')

        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                daysToKeepStr: '30',
                numToKeepStr: '50'
            )
        )

        timeout(
            time: 90,
            unit: 'MINUTES'
        )
    }

    // ================================================================
    // PARAMETERS
    // ================================================================

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: [
                'dev',
                'qa',
                'stage',
                'prod'
            ],
            description: 'Terraform environment to completely destroy'
        )
    }

    // ================================================================
    // ENVIRONMENT
    // ================================================================

    environment {

        // ------------------------------------------------------------
        // GITHUB
        // ------------------------------------------------------------

        TERRAFORM_REPO =
            'https://github.com/FAIZANSHEIKH223/terraform-aws-infra.git'

        TERRAFORM_BRANCH = 'main'

        GITHUB_CREDENTIALS = 'github-creds'

        TERRAFORM_DIR = 'terraform-infra'

        // ------------------------------------------------------------
        // AWS
        // ------------------------------------------------------------

        AWS_CREDENTIALS = 'aws-creds'

        AWS_DEFAULT_REGION = 'us-east-1'

        // ------------------------------------------------------------
        // APPLICATION
        // ------------------------------------------------------------

        APP_NAME = 'practice1'

        CONTAINER_PORT = '8501'

        // ------------------------------------------------------------
        // ECR
        // ------------------------------------------------------------

        ECR_REPOSITORY = 'practice1'

        // ------------------------------------------------------------
        // ECS
        // ------------------------------------------------------------

        ECS_CLUSTER =
            "practice1-${ENVIRONMENT}-cluster"

        ECS_SERVICE =
            "practice1-${ENVIRONMENT}-service"

        ECS_TASK_FAMILY =
            "practice1-${ENVIRONMENT}-task"

        ECS_CONTAINER_NAME = 'practice1'

        // ------------------------------------------------------------
        // LOAD BALANCER
        // ------------------------------------------------------------

        ALB_NAME =
            "practice1-${ENVIRONMENT}-alb"

        TARGET_GROUP_NAME =
            "practice1-${ENVIRONMENT}-tg"

        ALB_SG_NAME =
            "practice1-${ENVIRONMENT}-alb-sg"

        ECS_SG_NAME =
            "practice1-${ENVIRONMENT}-ecs-sg"

        // ------------------------------------------------------------
        // IAM
        // ------------------------------------------------------------

        EXECUTION_ROLE_NAME =
            'practice1-ecsTaskExecutionRole'

        // ------------------------------------------------------------
        // TERRAFORM BACKEND
        // ------------------------------------------------------------

        TF_STATE_BUCKET =
            'terraform-state-faizan-001'

        TF_LOCK_TABLE =
            'terraform-locks'

        TF_IN_AUTOMATION = 'true'

        TF_INPUT = 'false'
    }

    // ================================================================
    // STAGES
    // ================================================================

    stages {

        // ============================================================
        // 1. AWS VERIFICATION
        // ============================================================

        stage('1 - AWS Verification') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "AWS VERIFICATION"
                        echo "================================================"

                        command -v aws

                        if [ $? -ne 0 ]; then
                            echo "ERROR: AWS CLI is not installed."
                            exit 1
                        fi

                        aws --version

                        echo ""
                        echo "AWS Account:"

                        aws sts get-caller-identity \
                            --region "${AWS_DEFAULT_REGION}"

                        echo ""
                        echo "Environment:"
                        echo "${ENVIRONMENT}"

                        echo ""
                        echo "Region:"
                        echo "${AWS_DEFAULT_REGION}"
                    '''
                }
            }
        }

        // ============================================================
        // 2. STOP ECS TASKS
        // ============================================================

        stage('2 - Stop All ECS Tasks') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "STOPPING ECS TASKS"
                        echo "================================================"

                        TASKS=$(aws ecs list-tasks \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --service-name "${ECS_SERVICE}" \
                            --desired-status RUNNING \
                            --query 'taskArns[]' \
                            --output text 2>/dev/null)

                        if [ -z "${TASKS}" ] ||
                           [ "${TASKS}" = "None" ]; then

                            echo "No RUNNING ECS tasks found."
                        else

                            for TASK in ${TASKS}
                            do
                                echo "Stopping task: ${TASK}"

                                aws ecs stop-task \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --cluster "${ECS_CLUSTER}" \
                                    --task "${TASK}" \
                                    --reason "Forced destruction by Jenkins" \
                                    2>/dev/null || true
                            done
                        fi

                        TASKS_PENDING=$(aws ecs list-tasks \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --service-name "${ECS_SERVICE}" \
                            --desired-status STOPPED \
                            --query 'taskArns[]' \
                            --output text 2>/dev/null)

                        echo ""
                        echo "ECS task stop command completed."

                        # Do not wait for ECS draining.
                        # Continue immediately.
                    '''
                }
            }
        }

        // ============================================================
        // 3. FORCE DELETE ECS SERVICE
        // ============================================================

        stage('3 - Force Delete ECS Service') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "FORCE DELETING ECS SERVICE"
                        echo "================================================"

                        SERVICE_STATUS=$(aws ecs describe-services \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}" \
                            --query 'services[0].status' \
                            --output text 2>/dev/null)

                        if [ -z "${SERVICE_STATUS}" ] ||
                           [ "${SERVICE_STATUS}" = "None" ] ||
                           [ "${SERVICE_STATUS}" = "null" ]; then

                            echo "ECS service does not exist."
                            echo "NOT FOUND - SKIPPING"

                        else

                            echo "Existing service status: ${SERVICE_STATUS}"

                            echo "Setting desired count to 0..."

                            aws ecs update-service \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --service "${ECS_SERVICE}" \
                                --desired-count 0 \
                                2>/dev/null || true

                            echo ""
                            echo "FORCE deleting ECS service..."

                            aws ecs delete-service \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --service "${ECS_SERVICE}" \
                                --force \
                                2>/dev/null || true

                            echo "ECS delete command completed."

                            # IMPORTANT:
                            # Do NOT wait for DRAINING to become None.
                            # AWS may keep the service in DRAINING while
                            # resources are being released.
                        fi
                    '''
                }
            }
        }

        // ============================================================
        // 4. DELETE ECS TASK DEFINITIONS
        // ============================================================

        stage('4 - Deregister ECS Task Definitions') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "DEREGISTERING ECS TASK DEFINITIONS"
                        echo "================================================"

                        TASK_DEFINITIONS=$(aws ecs list-task-definitions \
                            --region "${AWS_DEFAULT_REGION}" \
                            --family-prefix "${ECS_TASK_FAMILY}" \
                            --status ACTIVE \
                            --query 'taskDefinitionArns[]' \
                            --output text 2>/dev/null)

                        if [ -z "${TASK_DEFINITIONS}" ] ||
                           [ "${TASK_DEFINITIONS}" = "None" ]; then

                            echo "No ACTIVE task definitions found."
                        else

                            for TD in ${TASK_DEFINITIONS}
                            do
                                echo "Deregistering:"
                                echo "${TD}"

                                aws ecs deregister-task-definition \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --task-definition "${TD}" \
                                    2>/dev/null || true
                            done
                        fi

                        echo ""
                        echo "Task definition cleanup completed."
                    '''
                }
            }
        }

        // ============================================================
        // 5. DELETE ALB LISTENER
        // ============================================================

        stage('5 - Delete ALB Listener') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "DELETING ALB LISTENER"
                        echo "================================================"

                        ALB_ARN=$(aws elbv2 describe-load-balancers \
                            --region "${AWS_DEFAULT_REGION}" \
                            --names "${ALB_NAME}" \
                            --query 'LoadBalancers[0].LoadBalancerArn' \
                            --output text 2>/dev/null)

                        if [ -z "${ALB_ARN}" ] ||
                           [ "${ALB_ARN}" = "None" ]; then

                            echo "ALB does not exist."
                            echo "NOT FOUND - SKIPPING"

                        else

                            echo "ALB ARN:"
                            echo "${ALB_ARN}"

                            LISTENERS=$(aws elbv2 describe-listeners \
                                --region "${AWS_DEFAULT_REGION}" \
                                --load-balancer-arn "${ALB_ARN}" \
                                --query 'Listeners[].ListenerArn' \
                                --output text 2>/dev/null)

                            if [ -z "${LISTENERS}" ] ||
                               [ "${LISTENERS}" = "None" ]; then

                                echo "No ALB listeners found."
                            else

                                for LISTENER in ${LISTENERS}
                                do

                                    echo "Deleting listener:"
                                    echo "${LISTENER}"

                                    aws elbv2 delete-listener \
                                        --region "${AWS_DEFAULT_REGION}" \
                                        --listener-arn "${LISTENER}" \
                                        2>/dev/null || true
                                done
                            fi
                        fi
                    '''
                }
            }
        }

        // ============================================================
        // 6. DELETE ALB
        // ============================================================

        stage('6 - Delete ALB') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "DELETING ALB"
                        echo "================================================"

                        ALB_ARN=$(aws elbv2 describe-load-balancers \
                            --region "${AWS_DEFAULT_REGION}" \
                            --names "${ALB_NAME}" \
                            --query 'LoadBalancers[0].LoadBalancerArn' \
                            --output text 2>/dev/null)

                        if [ -z "${ALB_ARN}" ] ||
                           [ "${ALB_ARN}" = "None" ]; then

                            echo "ALB already deleted."
                            echo "NOT FOUND - SKIPPING"

                        else

                            echo "Deleting ALB:"
                            echo "${ALB_ARN}"

                            aws elbv2 delete-load-balancer \
                                --region "${AWS_DEFAULT_REGION}" \
                                --load-balancer-arn "${ALB_ARN}" \
                                2>/dev/null || true

                            echo "ALB deletion command completed."
                        fi
                    '''
                }
            }
        }

        // ============================================================
        // 7. DELETE TARGET GROUP
        // ============================================================

        stage('7 - Delete Target Group') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "DELETING TARGET GROUP"
                        echo "================================================"

                        TARGET_GROUP_ARN=$(aws elbv2 describe-target-groups \
                            --region "${AWS_DEFAULT_REGION}" \
                            --names "${TARGET_GROUP_NAME}" \
                            --query 'TargetGroups[0].TargetGroupArn' \
                            --output text 2>/dev/null)

                        if [ -z "${TARGET_GROUP_ARN}" ] ||
                           [ "${TARGET_GROUP_ARN}" = "None" ]; then

                            echo "Target group already deleted."
                            echo "NOT FOUND - SKIPPING"

                        else

                            echo "Deleting target group:"
                            echo "${TARGET_GROUP_ARN}"

                            aws elbv2 delete-target-group \
                                --region "${AWS_DEFAULT_REGION}" \
                                --target-group-arn "${TARGET_GROUP_ARN}" \
                                2>/dev/null || true

                            echo "Target group deletion command completed."
                        fi
                    '''
                }
            }
        }

        // ============================================================
        // 8. DELETE ECS CLUSTER
        // ============================================================

        stage('8 - Delete ECS Cluster') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "DELETING ECS CLUSTER"
                        echo "================================================"

                        CLUSTER_STATUS=$(aws ecs describe-clusters \
                            --region "${AWS_DEFAULT_REGION}" \
                            --clusters "${ECS_CLUSTER}" \
                            --query 'clusters[0].status' \
                            --output text 2>/dev/null)

                        if [ -z "${CLUSTER_STATUS}" ] ||
                           [ "${CLUSTER_STATUS}" = "None" ] ||
                           [ "${CLUSTER_STATUS}" = "INACTIVE" ]; then

                            echo "ECS cluster does not exist."
                            echo "NOT FOUND - SKIPPING"

                        else

                            echo "Cluster status:"
                            echo "${CLUSTER_STATUS}"

                            aws ecs delete-cluster \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                2>/dev/null || true

                            echo "ECS cluster delete command completed."
                        fi
                    '''
                }
            }
        }

        // ============================================================
        // 9. DELETE CLOUDWATCH LOG GROUP
        // ============================================================

        stage('9 - Delete CloudWatch Logs') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "DELETING CLOUDWATCH LOG GROUP"
                        echo "================================================"

                        LOG_GROUP="/ecs/${ECS_TASK_FAMILY}"

                        aws logs describe-log-groups \
                            --region "${AWS_DEFAULT_REGION}" \
                            --log-group-name-prefix "${LOG_GROUP}" \
                            --query 'logGroups[].logGroupName' \
                            --output text 2>/dev/null |
                        while read GROUP
                        do

                            if [ -n "${GROUP}" ] &&
                               [ "${GROUP}" != "None" ]; then

                                echo "Deleting log group:"
                                echo "${GROUP}"

                                aws logs delete-log-group \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --log-group-name "${GROUP}" \
                                    2>/dev/null || true
                            fi

                        done

                        echo "CloudWatch cleanup completed."
                    '''
                }
            }
        }

        // ============================================================
        // 10. DELETE ECR
        // ============================================================

        stage('10 - Force Delete ECR Repository') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "FORCE DELETING ECR REPOSITORY"
                        echo "================================================"

                        EXISTS=$(aws ecr describe-repositories \
                            --region "${AWS_DEFAULT_REGION}" \
                            --repository-names "${ECR_REPOSITORY}" \
                            --query 'repositories[0].repositoryName' \
                            --output text 2>/dev/null)

                        if [ -z "${EXISTS}" ] ||
                           [ "${EXISTS}" = "None" ]; then

                            echo "ECR repository already deleted."
                            echo "NOT FOUND - SKIPPING"

                        else

                            echo "ECR repository exists:"
                            echo "${ECR_REPOSITORY}"

                            echo ""
                            echo "FORCE deleting ECR repository and ALL images..."

                            aws ecr delete-repository \
                                --region "${AWS_DEFAULT_REGION}" \
                                --repository-name "${ECR_REPOSITORY}" \
                                --force \
                                2>/dev/null || true

                            echo "ECR cleanup completed."
                        fi
                    '''
                }
            }
        }

        // ============================================================
        // 11. IAM ROLE
        // ============================================================

        stage('11 - Delete ECS IAM Role') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "DELETING ECS IAM ROLE"
                        echo "================================================"

                        ROLE_EXISTS=$(aws iam get-role \
                            --role-name "${EXECUTION_ROLE_NAME}" \
                            --query 'Role.RoleName' \
                            --output text 2>/dev/null)

                        if [ -z "${ROLE_EXISTS}" ] ||
                           [ "${ROLE_EXISTS}" = "None" ]; then

                            echo "IAM role already deleted."
                            echo "NOT FOUND - SKIPPING"

                        else

                            echo "Role found:"
                            echo "${EXECUTION_ROLE_NAME}"

                            echo ""
                            echo "Detaching AWS managed policy..."

                            aws iam detach-role-policy \
                                --role-name "${EXECUTION_ROLE_NAME}" \
                                --policy-arn \
                                arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy \
                                2>/dev/null || true

                            echo ""
                            echo "Deleting inline policies..."

                            INLINE_POLICIES=$(aws iam list-role-policies \
                                --role-name "${EXECUTION_ROLE_NAME}" \
                                --query 'PolicyNames[]' \
                                --output text 2>/dev/null)

                            for POLICY in ${INLINE_POLICIES}
                            do

                                if [ -n "${POLICY}" ] &&
                                   [ "${POLICY}" != "None" ]; then

                                    aws iam delete-role-policy \
                                        --role-name "${EXECUTION_ROLE_NAME}" \
                                        --policy-name "${POLICY}" \
                                        2>/dev/null || true
                                fi

                            done

                            echo ""
                            echo "Deleting IAM role..."

                            aws iam delete-role \
                                --role-name "${EXECUTION_ROLE_NAME}" \
                                2>/dev/null || true

                            echo "IAM role cleanup completed."
                        fi
                    '''
                }
            }
        }

        // ============================================================
        // 12. SECURITY GROUPS
        // ============================================================

        stage('12 - Delete Security Groups') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "DELETING SECURITY GROUPS"
                        echo "================================================"

                        VPCS=$(aws ec2 describe-vpcs \
                            --region "${AWS_DEFAULT_REGION}" \
                            --query 'Vpcs[].VpcId' \
                            --output text 2>/dev/null)

                        for VPC in ${VPCS}
                        do

                            echo ""
                            echo "Checking VPC: ${VPC}"

                            ALB_SG_ID=$(aws ec2 describe-security-groups \
                                --region "${AWS_DEFAULT_REGION}" \
                                --filters \
                                    "Name=vpc-id,Values=${VPC}" \
                                    "Name=group-name,Values=${ALB_SG_NAME}" \
                                --query 'SecurityGroups[0].GroupId' \
                                --output text 2>/dev/null)

                            if [ -n "${ALB_SG_ID}" ] &&
                               [ "${ALB_SG_ID}" != "None" ]; then

                                echo "Deleting ALB SG: ${ALB_SG_ID}"

                                aws ec2 delete-security-group \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --group-id "${ALB_SG_ID}" \
                                    2>/dev/null || true
                            else

                                echo "ALB SG not found."
                            fi

                            ECS_SG_ID=$(aws ec2 describe-security-groups \
                                --region "${AWS_DEFAULT_REGION}" \
                                --filters \
                                    "Name=vpc-id,Values=${VPC}" \
                                    "Name=group-name,Values=${ECS_SG_NAME}" \
                                --query 'SecurityGroups[0].GroupId' \
                                --output text 2>/dev/null)

                            if [ -n "${ECS_SG_ID}" ] &&
                               [ "${ECS_SG_ID}" != "None" ]; then

                                echo "Deleting ECS SG: ${ECS_SG_ID}"

                                aws ec2 delete-security-group \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --group-id "${ECS_SG_ID}" \
                                    2>/dev/null || true
                            else

                                echo "ECS SG not found."
                            fi

                        done

                        echo ""
                        echo "Security group cleanup attempted."
                    '''
                }
            }
        }

        // ============================================================
        // 13. TERRAFORM DESTROY
        // ============================================================

        stage('13 - Terraform Destroy') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    deleteDir()

                    git(
                        branch: "${TERRAFORM_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${TERRAFORM_REPO}"
                    )
                }

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh '''
                            set +e

                            echo "================================================"
                            echo "TERRAFORM DESTROY"
                            echo "================================================"

                            if ! command -v terraform >/dev/null 2>&1
                            then
                                echo "Terraform is not installed."
                                echo "SKIPPING TERRAFORM DESTROY."
                                exit 0
                            fi

                            terraform version

                            if [ ! -d "environments/${ENVIRONMENT}" ]; then
                                echo "Terraform environment does not exist."
                                echo "SKIPPING."
                                exit 0
                            fi

                            if [ ! -f "environments/${ENVIRONMENT}/terraform.tfvars" ]; then
                                echo "terraform.tfvars does not exist."
                                echo "SKIPPING."
                                exit 0
                            fi

                            echo ""
                            echo "Terraform init..."

                            terraform init \
                                -input=false

                            if [ $? -ne 0 ]; then
                                echo "WARNING: Terraform init failed."
                                echo "Continuing with manual AWS cleanup."
                                exit 0
                            fi

                            echo ""
                            echo "Terraform destroy..."

                            terraform destroy \
                                -input=false \
                                -auto-approve \
                                -var-file="environments/${ENVIRONMENT}/terraform.tfvars"

                            TF_EXIT=$?

                            if [ ${TF_EXIT} -eq 0 ]; then

                                echo ""
                                echo "Terraform destroy completed."

                            else

                                echo ""
                                echo "WARNING: Terraform destroy returned:"
                                echo "${TF_EXIT}"

                                echo ""
                                echo "Manual cleanup will continue."
                            fi

                            exit 0
                        '''
                    }
                }
            }
        }

        // ============================================================
        // 14. DELETE ECR AGAIN
        // ============================================================

        stage('14 - Final ECR Cleanup') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "FINAL ECR CLEANUP"
                        echo "================================================"

                        aws ecr delete-repository \
                            --region "${AWS_DEFAULT_REGION}" \
                            --repository-name "${ECR_REPOSITORY}" \
                            --force \
                            2>/dev/null || true

                        echo "Final ECR cleanup completed."
                    '''
                }
            }
        }

        // ============================================================
        // 15. FINAL SECURITY GROUP RETRY
        // ============================================================

        stage('15 - Final Security Group Cleanup') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "FINAL SECURITY GROUP CLEANUP"
                        echo "================================================"

                        echo ""
                        echo "Trying ALB security group..."

                        for VPC in $(aws ec2 describe-vpcs \
                            --region "${AWS_DEFAULT_REGION}" \
                            --query 'Vpcs[].VpcId' \
                            --output text 2>/dev/null)
                        do

                            ALB_SG_ID=$(aws ec2 describe-security-groups \
                                --region "${AWS_DEFAULT_REGION}" \
                                --filters \
                                    "Name=vpc-id,Values=${VPC}" \
                                    "Name=group-name,Values=${ALB_SG_NAME}" \
                                --query 'SecurityGroups[0].GroupId' \
                                --output text 2>/dev/null)

                            if [ -n "${ALB_SG_ID}" ] &&
                               [ "${ALB_SG_ID}" != "None" ]; then

                                aws ec2 delete-security-group \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --group-id "${ALB_SG_ID}" \
                                    2>/dev/null || true
                            fi

                            ECS_SG_ID=$(aws ec2 describe-security-groups \
                                --region "${AWS_DEFAULT_REGION}" \
                                --filters \
                                    "Name=vpc-id,Values=${VPC}" \
                                    "Name=group-name,Values=${ECS_SG_NAME}" \
                                --query 'SecurityGroups[0].GroupId' \
                                --output text 2>/dev/null)

                            if [ -n "${ECS_SG_ID}" ] &&
                               [ "${ECS_SG_ID}" != "None" ]; then

                                aws ec2 delete-security-group \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --group-id "${ECS_SG_ID}" \
                                    2>/dev/null || true
                            fi

                        done

                        echo "Final security group cleanup completed."
                    '''
                }
            }
        }

        // ============================================================
        // 16. EMPTY TERRAFORM STATE BUCKET
        // ============================================================

        stage('16 - Empty Terraform State Bucket') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "EMPTYING TERRAFORM STATE BUCKET"
                        echo "================================================"

                        BUCKET="${TF_STATE_BUCKET}"

                        echo "Checking bucket:"
                        echo "${BUCKET}"

                        aws s3api head-bucket \
                            --bucket "${BUCKET}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            >/dev/null 2>&1

                        if [ $? -ne 0 ]; then

                            echo "Terraform state bucket does not exist."
                            echo "NOT FOUND - SKIPPING"

                        else

                            echo "Bucket exists."

                            echo ""
                            echo "Deleting normal objects..."

                            aws s3 rm \
                                "s3://${BUCKET}" \
                                --recursive \
                                --region "${AWS_DEFAULT_REGION}" \
                                2>/dev/null || true

                            echo ""
                            echo "Deleting object versions..."

                            VERSIONS=$(aws s3api list-object-versions \
                                --bucket "${BUCKET}" \
                                --region "${AWS_DEFAULT_REGION}" \
                                --query 'Versions[].{Key:Key,VersionId:VersionId}' \
                                --output text 2>/dev/null)

                            if [ -n "${VERSIONS}" ] &&
                               [ "${VERSIONS}" != "None" ]; then

                                echo "${VERSIONS}" |
                                while read KEY VERSION
                                do

                                    if [ -n "${KEY}" ] &&
                                       [ -n "${VERSION}" ]; then

                                        aws s3api delete-object \
                                            --bucket "${BUCKET}" \
                                            --key "${KEY}" \
                                            --version-id "${VERSION}" \
                                            --region "${AWS_DEFAULT_REGION}" \
                                            2>/dev/null || true
                                    fi

                                done
                            fi

                            echo ""
                            echo "Deleting delete markers..."

                            MARKERS=$(aws s3api list-object-versions \
                                --bucket "${BUCKET}" \
                                --region "${AWS_DEFAULT_REGION}" \
                                --query 'DeleteMarkers[].{Key:Key,VersionId:VersionId}' \
                                --output text 2>/dev/null)

                            if [ -n "${MARKERS}" ] &&
                               [ "${MARKERS}" != "None" ]; then

                                echo "${MARKERS}" |
                                while read KEY VERSION
                                do

                                    if [ -n "${KEY}" ] &&
                                       [ -n "${VERSION}" ]; then

                                        aws s3api delete-object \
                                            --bucket "${BUCKET}" \
                                            --key "${KEY}" \
                                            --version-id "${VERSION}" \
                                            --region "${AWS_DEFAULT_REGION}" \
                                            2>/dev/null || true
                                    fi

                                done
                            fi

                            echo ""
                            echo "Terraform state bucket emptied."
                        fi
                    '''
                }
            }
        }

        // ============================================================
        // 17. DELETE TERRAFORM BACKEND BUCKET
        // ============================================================

        stage('17 - Delete Terraform Backend Bucket') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "DELETING TERRAFORM BACKEND BUCKET"
                        echo "================================================"

                        BUCKET="${TF_STATE_BUCKET}"

                        aws s3api head-bucket \
                            --bucket "${BUCKET}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            >/dev/null 2>&1

                        if [ $? -ne 0 ]; then

                            echo "Bucket already deleted."
                            echo "NOT FOUND - SKIPPING"

                        else

                            echo "Deleting:"
                            echo "${BUCKET}"

                            aws s3api delete-bucket \
                                --bucket "${BUCKET}" \
                                --region "${AWS_DEFAULT_REGION}"

                            if [ $? -eq 0 ]; then
                                echo "Terraform backend bucket deleted."
                            else
                                echo "WARNING: Bucket deletion failed."
                                echo "Continuing to DynamoDB."
                            fi
                        fi
                    '''
                }
            }
        }

        // ============================================================
        // 18. DELETE TERRAFORM LOCK TABLE
        // ============================================================

        stage('18 - Delete Terraform Lock Table') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "DELETING TERRAFORM LOCK TABLE"
                        echo "================================================"

                        TABLE="${TF_LOCK_TABLE}"

                        STATUS=$(aws dynamodb describe-table \
                            --table-name "${TABLE}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            --query 'Table.TableStatus' \
                            --output text 2>/dev/null)

                        if [ -z "${STATUS}" ] ||
                           [ "${STATUS}" = "None" ]; then

                            echo "DynamoDB lock table already deleted."
                            echo "NOT FOUND - SKIPPING"

                        else

                            echo "Table exists:"
                            echo "${TABLE}"

                            echo "Status:"
                            echo "${STATUS}"

                            aws dynamodb delete-table \
                                --table-name "${TABLE}" \
                                --region "${AWS_DEFAULT_REGION}" \
                                2>/dev/null || true

                            echo "DynamoDB delete command completed."
                        fi
                    '''
                }
            }
        }

        // ============================================================
        // 19. FINAL RESOURCE VERIFICATION
        // ============================================================

        stage('19 - Final Verification') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "FINAL DESTRUCTION VERIFICATION"
                        echo "================================================"

                        echo ""
                        echo "ECS SERVICE:"
                        aws ecs describe-services \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}" \
                            --query 'services[0].status' \
                            --output text \
                            2>/dev/null || echo "NOT FOUND"

                        echo ""
                        echo "ECS CLUSTER:"
                        aws ecs describe-clusters \
                            --region "${AWS_DEFAULT_REGION}" \
                            --clusters "${ECS_CLUSTER}" \
                            --query 'clusters[0].status' \
                            --output text \
                            2>/dev/null || echo "NOT FOUND"

                        echo ""
                        echo "ALB:"
                        aws elbv2 describe-load-balancers \
                            --region "${AWS_DEFAULT_REGION}" \
                            --names "${ALB_NAME}" \
                            --query 'LoadBalancers[0].State.Code' \
                            --output text \
                            2>/dev/null || echo "NOT FOUND"

                        echo ""
                        echo "TARGET GROUP:"
                        aws elbv2 describe-target-groups \
                            --region "${AWS_DEFAULT_REGION}" \
                            --names "${TARGET_GROUP_NAME}" \
                            --query 'TargetGroups[0].TargetGroupName' \
                            --output text \
                            2>/dev/null || echo "NOT FOUND"

                        echo ""
                        echo "ECR:"
                        aws ecr describe-repositories \
                            --region "${AWS_DEFAULT_REGION}" \
                            --repository-names "${ECR_REPOSITORY}" \
                            --query 'repositories[0].repositoryName' \
                            --output text \
                            2>/dev/null || echo "NOT FOUND"

                        echo ""
                        echo "IAM ROLE:"
                        aws iam get-role \
                            --role-name "${EXECUTION_ROLE_NAME}" \
                            --query 'Role.RoleName' \
                            --output text \
                            2>/dev/null || echo "NOT FOUND"

                        echo ""
                        echo "TERRAFORM BUCKET:"
                        aws s3api head-bucket \
                            --bucket "${TF_STATE_BUCKET}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            >/dev/null 2>&1

                        if [ $? -eq 0 ]; then
                            echo "STILL EXISTS"
                        else
                            echo "NOT FOUND"
                        fi

                        echo ""
                        echo "TERRAFORM LOCK TABLE:"
                        aws dynamodb describe-table \
                            --table-name "${TF_LOCK_TABLE}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            --query 'Table.TableStatus' \
                            --output text \
                            2>/dev/null || echo "NOT FOUND"

                        echo ""
                        echo "================================================"
                        echo "DESTRUCTION COMMANDS COMPLETED"
                        echo "================================================"

                        # Verification is informational only.
                        # It must not make the Jenkins build fail.
                        exit 0
                    '''
                }
            }
        }
    }

    // ================================================================
    // POST
    // ================================================================

    post {

        success {

            echo ''
            echo '================================================'
            echo '       COMPLETE DESTROY PIPELINE SUCCESS'
            echo '================================================'

            echo ''
            echo 'ECS SERVICE             : CLEANUP COMPLETED'
            echo 'ECS TASKS               : STOP COMMAND SENT'
            echo 'ECS TASK DEFINITIONS    : DEREGISTERED'
            echo 'ALB LISTENERS           : CLEANUP COMPLETED'
            echo 'ALB                     : CLEANUP COMPLETED'
            echo 'TARGET GROUP            : CLEANUP COMPLETED'
            echo 'ECS CLUSTER             : CLEANUP COMPLETED'
            echo 'CLOUDWATCH LOGS         : CLEANUP COMPLETED'
            echo 'ECR                     : FORCE DELETE COMPLETED'
            echo 'IAM ROLE                : CLEANUP COMPLETED'
            echo 'SECURITY GROUPS         : CLEANUP ATTEMPTED'
            echo 'TERRAFORM               : DESTROY ATTEMPTED'
            echo 'TF STATE BUCKET         : DELETE ATTEMPTED'
            echo 'TF LOCK TABLE           : DELETE ATTEMPTED'

            echo ''
            echo '================================================'
            echo '          DESTRUCTION COMPLETE'
            echo '================================================'
        }

        failure {

            echo ''
            echo '================================================'
            echo '       DESTROY PIPELINE FAILED'
            echo '================================================'

            echo ''
            echo 'A critical Jenkins/AWS command failed.'
            echo 'Review the console log above.'

            echo ''
            echo 'The cleanup stages are designed to continue'
            echo 'when individual AWS resources are already gone.'

            echo ''
            echo '================================================'
        }

        always {

            echo ''
            echo '================================================'
            echo '       CLEANING JENKINS WORKSPACE'
            echo '================================================'

            cleanWs(
                deleteDirs: true,
                disableDeferredWipeout: true
            )
        }
    }
}
