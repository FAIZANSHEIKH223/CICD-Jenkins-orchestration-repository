pipeline {

    agent any

    // ================================================================
    // PIPELINE OPTIONS
    // ================================================================

    options {

        timestamps()

        ansiColor('xterm')

        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                daysToKeepStr: '30',
                numToKeepStr: '50'
            )
        )

        timeout(
            time: 90,
            unit: 'MINUTES'
        )
    }


    // ================================================================
    // PARAMETERS
    // ================================================================

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: [
                'dev',
                'qa',
                'stage',
                'prod'
            ],
            description: 'Terraform environment to destroy'
        )

        booleanParam(
            name: 'DELETE_TERRAFORM_BACKEND',
            defaultValue: true,
            description: 'Delete Terraform S3 state bucket and DynamoDB lock table after Terraform destroy'
        )

        booleanParam(
            name: 'DELETE_ECR_REPOSITORY',
            defaultValue: true,
            description: 'Delete ECR repository and all images'
        )
    }


    // ================================================================
    // ENVIRONMENT
    // ================================================================

    environment {

        // ------------------------------------------------------------
        // GITHUB
        // ------------------------------------------------------------

        GITHUB_CREDENTIALS = 'github-creds'


        // ------------------------------------------------------------
        // TERRAFORM
        // ------------------------------------------------------------

        TERRAFORM_REPO =
            'https://github.com/FAIZANSHEIKH223/terraform-aws-infra.git'

        TERRAFORM_BRANCH = 'main'

        TERRAFORM_DIR = 'terraform-infra'


        // ------------------------------------------------------------
        // AWS
        // ------------------------------------------------------------

        AWS_CREDENTIALS = 'aws-creds'

        AWS_DEFAULT_REGION = 'us-east-1'

        AWS_REGION = 'us-east-1'


        // ------------------------------------------------------------
        // TERRAFORM BACKEND
        // ------------------------------------------------------------

        TF_STATE_BUCKET =
            'terraform-state-faizan-001'

        TF_LOCK_TABLE =
            'terraform-locks'


        // ------------------------------------------------------------
        // ECR
        // ------------------------------------------------------------

        ECR_REPOSITORY = 'practice1'


        // ------------------------------------------------------------
        // DEPLOYMENT EC2
        // ------------------------------------------------------------

        DEPLOY_SSH_CREDENTIALS = 'deploy-ssh-key'

        DEPLOY_USER = 'ubuntu'

        DEPLOY_INSTANCE_ROLE = 'application'

        CONTAINER_NAME = 'practice1'


        // ------------------------------------------------------------
        // JENKINS
        // ------------------------------------------------------------

        TF_IN_AUTOMATION = 'true'

        TF_INPUT = 'false'
    }


    // ================================================================
    // STAGES
    // ================================================================

    stages {


        // ============================================================
        // PART 1
        // CHECK AWS
        // ============================================================

        stage('1 - Verify AWS CLI') {

            steps {

                sh '''
                    set -e

                    echo "================================================"
                    echo "VERIFYING AWS CLI"
                    echo "================================================"

                    command -v aws

                    aws --version
                '''
            }
        }


        // ============================================================
        // PART 2
        // CHECK AWS CREDENTIALS
        // ============================================================

        stage('2 - Verify AWS Credentials') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "VERIFYING AWS CREDENTIALS"
                        echo "================================================"

                        aws sts get-caller-identity \
                            --region "${AWS_DEFAULT_REGION}"

                        echo ""
                        echo "AWS credentials are valid."
                    '''
                }
            }
        }


        // ============================================================
        // PART 3
        // LOCATE DEPLOYMENT EC2
        // ============================================================

        stage('3 - Locate Deployment EC2') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        echo "================================================"
                        echo "LOCATING DEPLOYMENT EC2"
                        echo "================================================"

                        echo "Environment : ${params.ENVIRONMENT}"
                        echo "Role        : ${DEPLOY_INSTANCE_ROLE}"
                        echo "Region      : ${AWS_DEFAULT_REGION}"


                        def instanceId = sh(
                            script: '''
                                aws ec2 describe-instances \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --filters \
                                        "Name=instance-state-name,Values=running,stopped" \
                                        "Name=tag:Role,Values=${DEPLOY_INSTANCE_ROLE}" \
                                        "Name=tag:Environment,Values=${ENVIRONMENT}" \
                                    --query 'Reservations[].Instances[].InstanceId' \
                                    --output text
                            ''',
                            returnStdout: true
                        ).trim()


                        if (!instanceId || instanceId == 'None') {

                            echo ""
                            echo "No deployment EC2 found."
                            echo "This is acceptable if Terraform infrastructure was already removed."

                        } else {

                            def instanceList =
                                instanceId.split("\\s+")


                            if (instanceList.size() != 1) {

                                error(
                                    "Expected exactly one deployment EC2. " +
                                    "Found ${instanceList.size()}: ${instanceId}"
                                )
                            }


                            env.DEPLOY_INSTANCE_ID =
                                instanceList[0]


                            def publicIp = sh(
                                script: """
                                    aws ec2 describe-instances \
                                        --region "${AWS_DEFAULT_REGION}" \
                                        --instance-ids "${env.DEPLOY_INSTANCE_ID}" \
                                        --query 'Reservations[0].Instances[0].PublicIpAddress' \
                                        --output text
                                """,
                                returnStdout: true
                            ).trim()


                            env.DEPLOY_HOST = publicIp


                            echo ""
                            echo "Deployment Instance : ${env.DEPLOY_INSTANCE_ID}"
                            echo "Deployment Host     : ${env.DEPLOY_HOST}"
                        }
                    }
                }
            }
        }


        // ============================================================
        // PART 4
        // CLEAN DEPLOYMENT EC2
        // ============================================================

        stage('4 - Remove Application Container') {

            when {

                expression {

                    return env.DEPLOY_HOST &&
                           env.DEPLOY_HOST != 'None'
                }
            }

            steps {

                sshagent(
                    credentials: ["${DEPLOY_SSH_CREDENTIALS}"]
                ) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "REMOVING APPLICATION CONTAINER"
                        echo "================================================"

                        ssh \
                            -o StrictHostKeyChecking=no \
                            -o ConnectTimeout=20 \
                            "${DEPLOY_USER}@${DEPLOY_HOST}" \
                            'bash -s' <<'REMOTE_SCRIPT'

set -e

echo "Checking Docker..."

if ! command -v docker >/dev/null 2>&1; then
    echo "Docker is not installed."
    exit 0
fi

echo ""
echo "Stopping application container..."

sudo docker stop "practice1" || true

echo ""
echo "Removing application container..."

sudo docker rm -f "practice1" || true

echo ""
echo "Application container removed."

REMOTE_SCRIPT
                    '''
                }
            }
        }


        // ============================================================
        // PART 5
        // REMOVE DOCKER IMAGES
        // ============================================================

        stage('5 - Remove Docker Images From Deployment EC2') {

            when {

                expression {

                    return env.DEPLOY_HOST &&
                           env.DEPLOY_HOST != 'None'
                }
            }

            steps {

                sshagent(
                    credentials: ["${DEPLOY_SSH_CREDENTIALS}"]
                ) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "REMOVING DOCKER DATA"
                        echo "================================================"

                        ssh \
                            -o StrictHostKeyChecking=no \
                            -o ConnectTimeout=20 \
                            "${DEPLOY_USER}@${DEPLOY_HOST}" \
                            'bash -s' <<'REMOTE_SCRIPT'

set -e

if ! command -v docker >/dev/null 2>&1; then
    exit 0
fi

echo "Removing practice1 Docker images..."

sudo docker images \
    --format '{{.Repository}}:{{.Tag}} {{.ID}}' \
    | awk '$1 ~ /^.*practice1/ {print $2}' \
    | sort -u \
    | xargs -r sudo docker rmi -f || true

echo ""
echo "Removing unused Docker images..."

sudo docker image prune -af || true

echo ""
echo "Removing stopped containers..."

sudo docker container prune -f || true

echo ""
echo "Removing unused Docker networks..."

sudo docker network prune -f || true

echo ""
echo "Docker cleanup completed."

REMOTE_SCRIPT
                    '''
                }
            }
        }


        // ============================================================
        // PART 6
        // CHECK ECR
        // ============================================================

        stage('6 - Check ECR Repository') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "CHECKING ECR REPOSITORY"
                        echo "================================================"

                        if aws ecr describe-repositories \
                            --repository-names "${ECR_REPOSITORY}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            > /dev/null 2>&1
                        then

                            echo "ECR repository exists."

                        else

                            echo "ECR repository does not exist."

                        fi
                    '''
                }
            }
        }


        // ============================================================
        // PART 7
        // DELETE ECR
        // ============================================================

        stage('7 - Delete ECR Repository And Images') {

            when {

                expression {

                    return params.DELETE_ECR_REPOSITORY
                }
            }

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "DELETING ECR REPOSITORY"
                        echo "================================================"

                        if aws ecr describe-repositories \
                            --repository-names "${ECR_REPOSITORY}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            > /dev/null 2>&1
                        then

                            echo "Deleting all ECR images..."

                            aws ecr batch-delete-image \
                                --repository-name "${ECR_REPOSITORY}" \
                                --image-ids "$(
                                    aws ecr list-images \
                                        --repository-name "${ECR_REPOSITORY}" \
                                        --region "${AWS_DEFAULT_REGION}" \
                                        --query 'imageIds[*]' \
                                        --output json
                                )" \
                                --region "${AWS_DEFAULT_REGION}" \
                                || true


                            echo ""
                            echo "Deleting ECR repository..."

                            aws ecr delete-repository \
                                --repository-name "${ECR_REPOSITORY}" \
                                --force \
                                --region "${AWS_DEFAULT_REGION}"

                            echo ""
                            echo "ECR repository deleted."

                        else

                            echo "ECR repository does not exist."

                        fi
                    '''
                }
            }
        }


        // ============================================================
        // PART 8
        // CHECKOUT TERRAFORM
        // ============================================================

        stage('8 - Checkout Terraform Repository') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    git(
                        branch: "${TERRAFORM_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${TERRAFORM_REPO}"
                    )
                }
            }
        }


        // ============================================================
        // PART 9
        // VERIFY TERRAFORM
        // ============================================================

        stage('9 - Verify Terraform') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "VERIFYING TERRAFORM"
                        echo "================================================"

                        command -v terraform

                        terraform version

                        echo ""
                        echo "Terraform files:"

                        find . \
                            -type f \
                            -name "*.tf" \
                            -print
                    '''
                }
            }
        }


        // ============================================================
        // PART 10
        // VERIFY ENVIRONMENT
        // ============================================================

        stage('10 - Verify Terraform Environment') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "VERIFYING TERRAFORM ENVIRONMENT"
                        echo "================================================"

                        echo "Environment: ${ENVIRONMENT}"

                        if [ ! -d "environments/${ENVIRONMENT}" ]; then

                            echo "ERROR: Environment directory does not exist."

                            exit 1

                        fi


                        if [ ! -f "environments/${ENVIRONMENT}/terraform.tfvars" ]; then

                            echo "ERROR: terraform.tfvars not found."

                            exit 1

                        fi


                        echo "Terraform environment verified."
                    '''
                }
            }
        }


        // ============================================================
        // PART 11
        // TERRAFORM INIT
        // ============================================================

        stage('11 - Terraform Init') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh '''
                            set -e

                            echo "================================================"
                            echo "TERRAFORM INIT"
                            echo "================================================"

                            terraform init \
                                -input=false \
                                -reconfigure
                        '''
                    }
                }
            }
        }


        // ============================================================
        // PART 12
        // TERRAFORM VALIDATE
        // ============================================================

        stage('12 - Terraform Validate') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    sh '''
                        set -e

                        terraform validate
                    '''
                }
            }
        }


        // ============================================================
        // PART 13
        // SHOW TERRAFORM STATE
        // ============================================================

        stage('13 - Show Terraform Resources') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh '''
                            set -e

                            echo "================================================"
                            echo "CURRENT TERRAFORM RESOURCES"
                            echo "================================================"

                            terraform state list || true
                        '''
                    }
                }
            }
        }


        // ============================================================
        // PART 14
        // TERRAFORM DESTROY
        // ============================================================

        stage('14 - Terraform Destroy') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh '''
                            set -e

                            echo "================================================"
                            echo "DESTROYING TERRAFORM INFRASTRUCTURE"
                            echo "================================================"

                            echo ""
                            echo "Environment:"
                            echo "${ENVIRONMENT}"

                            echo ""
                            echo "Terraform resources BEFORE destroy:"

                            terraform state list || true

                            echo ""
                            echo "Running Terraform destroy..."

                            terraform destroy \
                                -input=false \
                                -auto-approve \
                                -var-file="environments/${ENVIRONMENT}/terraform.tfvars"

                            echo ""
                            echo "Terraform destroy completed."
                        '''
                    }
                }
            }
        }


        // ============================================================
        // PART 15
        // VERIFY TERRAFORM DESTROY
        // ============================================================

        stage('15 - Verify Terraform Destroy') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh '''
                            set -e

                            echo "================================================"
                            echo "VERIFYING TERRAFORM DESTROY"
                            echo "================================================"

                            echo ""
                            echo "Terraform state after destroy:"

                            terraform state list || true

                            echo ""
                            echo "Terraform destroy verification completed."
                        '''
                    }
                }
            }
        }


        // ============================================================
        // PART 16
        // VERIFY DEPLOYMENT EC2 IS GONE
        // ============================================================

        stage('16 - Verify Deployment EC2 Removed') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "VERIFYING DEPLOYMENT EC2 REMOVAL"
                        echo "================================================"

                        INSTANCE_COUNT=$(aws ec2 describe-instances \
                            --region "${AWS_DEFAULT_REGION}" \
                            --filters \
                                "Name=instance-state-name,Values=pending,running,stopping,stopped" \
                                "Name=tag:Role,Values=${DEPLOY_INSTANCE_ROLE}" \
                                "Name=tag:Environment,Values=${ENVIRONMENT}" \
                            --query 'Reservations[].Instances[].InstanceId' \
                            --output text)

                        if [ -z "${INSTANCE_COUNT}" ] || [ "${INSTANCE_COUNT}" = "None" ]; then

                            echo "Deployment EC2 successfully removed."

                        else

                            echo ""
                            echo "WARNING: Deployment EC2 still exists:"
                            echo "${INSTANCE_COUNT}"

                        fi
                    '''
                }
            }
        }


        // ============================================================
        // PART 17
        // DELETE TERRAFORM STATE BUCKET
        // ============================================================

        stage('17 - Delete Terraform State Bucket') {

            when {

                expression {

                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "DELETING TERRAFORM S3 STATE BUCKET"
                        echo "================================================"

                        if aws s3api head-bucket \
                            --bucket "${TF_STATE_BUCKET}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            > /dev/null 2>&1
                        then

                            echo "S3 bucket exists."

                            echo ""
                            echo "Deleting all current objects..."

                            aws s3 rm \
                                "s3://${TF_STATE_BUCKET}" \
                                --recursive \
                                --region "${AWS_DEFAULT_REGION}" \
                                || true


                            echo ""
                            echo "Deleting all object versions and delete markers..."

                            while true
                            do

                                OBJECTS=$(aws s3api list-object-versions \
                                    --bucket "${TF_STATE_BUCKET}" \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --query 'Versions[].{Key:Key,VersionId:VersionId}' \
                                    --output json)

                                DELETE_MARKERS=$(aws s3api list-object-versions \
                                    --bucket "${TF_STATE_BUCKET}" \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --query 'DeleteMarkers[].{Key:Key,VersionId:VersionId}' \
                                    --output json)


                                if [ "${OBJECTS}" = "[]" ] && \
                                   [ "${DELETE_MARKERS}" = "[]" ]; then

                                    break

                                fi


                                if [ "${OBJECTS}" != "[]" ]; then

                                    echo "${OBJECTS}" \
                                        > /tmp/s3-versions.json

                                    aws s3api delete-objects \
                                        --bucket "${TF_STATE_BUCKET}" \
                                        --delete file:///tmp/s3-versions.json \
                                        --region "${AWS_DEFAULT_REGION}" \
                                        || true

                                fi


                                if [ "${DELETE_MARKERS}" != "[]" ]; then

                                    echo "${DELETE_MARKERS}" \
                                        > /tmp/s3-delete-markers.json

                                    aws s3api delete-objects \
                                        --bucket "${TF_STATE_BUCKET}" \
                                        --delete file:///tmp/s3-delete-markers.json \
                                        --region "${AWS_DEFAULT_REGION}" \
                                        || true

                                fi

                            done


                            echo ""
                            echo "Deleting S3 bucket..."

                            aws s3api delete-bucket \
                                --bucket "${TF_STATE_BUCKET}" \
                                --region "${AWS_DEFAULT_REGION}"


                            echo ""
                            echo "Terraform state bucket deleted."

                        else

                            echo "Terraform state bucket does not exist."

                        fi
                    '''
                }
            }
        }


        // ============================================================
        // PART 18
        // DELETE DYNAMODB LOCK TABLE
        // ============================================================

        stage('18 - Delete Terraform Lock Table') {

            when {

                expression {

                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "DELETING TERRAFORM DYNAMODB LOCK TABLE"
                        echo "================================================"

                        if aws dynamodb describe-table \
                            --table-name "${TF_LOCK_TABLE}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            > /dev/null 2>&1
                        then

                            echo "DynamoDB lock table exists."

                            aws dynamodb delete-table \
                                --table-name "${TF_LOCK_TABLE}" \
                                --region "${AWS_DEFAULT_REGION}"

                            echo ""
                            echo "Waiting for DynamoDB table deletion..."

                            aws dynamodb wait table-not-exists \
                                --table-name "${TF_LOCK_TABLE}" \
                                --region "${AWS_DEFAULT_REGION}"

                            echo ""
                            echo "DynamoDB lock table deleted."

                        else

                            echo "DynamoDB lock table does not exist."

                        fi
                    '''
                }
            }
        }


        // ============================================================
        // PART 19
        // FINAL AWS RESOURCE CHECK
        // ============================================================

        stage('19 - Final AWS Cleanup Verification') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "FINAL AWS CLEANUP VERIFICATION"
                        echo "================================================"


                        echo ""
                        echo "Checking ECR..."

                        if aws ecr describe-repositories \
                            --repository-names "${ECR_REPOSITORY}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            > /dev/null 2>&1
                        then

                            echo "WARNING: ECR repository still exists."

                        else

                            echo "ECR repository: REMOVED"

                        fi


                        echo ""
                        echo "Checking Terraform S3 backend..."

                        if aws s3api head-bucket \
                            --bucket "${TF_STATE_BUCKET}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            > /dev/null 2>&1
                        then

                            echo "WARNING: Terraform state bucket still exists."

                        else

                            echo "Terraform state bucket: REMOVED"

                        fi


                        echo ""
                        echo "Checking DynamoDB lock table..."

                        if aws dynamodb describe-table \
                            --table-name "${TF_LOCK_TABLE}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            > /dev/null 2>&1
                        then

                            echo "WARNING: DynamoDB lock table still exists."

                        else

                            echo "DynamoDB lock table: REMOVED"

                        fi


                        echo ""
                        echo "Checking deployment EC2..."

                        INSTANCE_IDS=$(aws ec2 describe-instances \
                            --region "${AWS_DEFAULT_REGION}" \
                            --filters \
                                "Name=instance-state-name,Values=pending,running,stopping,stopped" \
                                "Name=tag:Role,Values=${DEPLOY_INSTANCE_ROLE}" \
                                "Name=tag:Environment,Values=${ENVIRONMENT}" \
                            --query 'Reservations[].Instances[].InstanceId' \
                            --output text)

                        if [ -z "${INSTANCE_IDS}" ] || \
                           [ "${INSTANCE_IDS}" = "None" ]; then

                            echo "Deployment EC2: REMOVED"

                        else

                            echo "WARNING: Deployment EC2 still exists:"
                            echo "${INSTANCE_IDS}"

                        fi


                        echo ""
                        echo "================================================"
                        echo "FINAL CLEANUP CHECK COMPLETED"
                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // PART 20
        // SUCCESS
        // ============================================================

        stage('20 - Destroy Success') {

            steps {

                echo ''
                echo '================================================'
                echo '        COMPLETE DESTROY SUCCESS'
                echo '================================================'

                echo ''
                echo "Environment : ${params.ENVIRONMENT}"

                echo ''
                echo 'Application container : REMOVED'
                echo 'Docker images         : CLEANED'
                echo 'ECR repository        : REMOVED'
                echo 'Terraform resources   : DESTROYED'
                echo 'Deployment EC2        : DESTROYED'
                echo 'Terraform state       : REMOVED'
                echo 'DynamoDB lock table   : REMOVED'

                echo ''
                echo 'AWS cleanup completed.'

                echo '================================================'
            }
        }
    }


    // ================================================================
    // POST ACTIONS
    // ================================================================

    post {

        success {

            echo ''
            echo '================================================'
            echo '       DESTROY PIPELINE SUCCESS'
            echo '================================================'

            echo ''
            echo "Environment : ${params.ENVIRONMENT}"

            echo ''
            echo 'All resources created by this deployment'
            echo 'pipeline have been requested for deletion.'

            echo '================================================'
        }


        failure {

            echo ''
            echo '================================================'
            echo '       DESTROY PIPELINE FAILED'
            echo '================================================'

            echo ''
            echo 'The pipeline stopped at the failed stage.'

            echo ''
            echo 'IMPORTANT: Some resources may still exist.'

            echo 'Check the Jenkins console output and'
            echo 'run the destroy pipeline again after'
            echo 'correcting the failed resource.'

            echo '================================================'
        }


        always {

            echo ''
            echo '================================================'
            echo 'CLEANING JENKINS WORKSPACE'
            echo '================================================'

            cleanWs(
                deleteDirs: true,
                disableDeferredWipeout: true
            )
        }
    }
}
