pipeline {

    agent any

    // ================================================================
    // PIPELINE OPTIONS
    // ================================================================

    options {

        timestamps()

        ansiColor('xterm')

        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                daysToKeepStr: '30',
                numToKeepStr: '50'
            )
        )

        timeout(
            time: 90,
            unit: 'MINUTES'
        )
    }


    // ================================================================
    // PARAMETERS
    // ================================================================

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: [
                'dev',
                'qa',
                'stage',
                'prod'
            ],
            description: 'Terraform environment to destroy'
        )

        choice(
            name: 'CONFIRM_DESTROY',
            choices: [
                'NO',
                'YES'
            ],
            description: 'Select YES to permanently destroy the selected environment'
        )
    }


    // ================================================================
    // ENVIRONMENT
    // ================================================================

    environment {

        // ------------------------------------------------------------
        // GITHUB
        // ------------------------------------------------------------

        GITHUB_CREDENTIALS = 'github-creds'

        TERRAFORM_REPO = 'https://github.com/FAIZANSHEIKH223/terraform-aws-infra.git'
        TERRAFORM_BRANCH = 'main'

        TERRAFORM_DIR = 'terraform-infra'


        // ------------------------------------------------------------
        // AWS
        // ------------------------------------------------------------

        AWS_CREDENTIALS = 'aws-creds'

        AWS_DEFAULT_REGION = 'us-east-1'


        // ------------------------------------------------------------
        // APPLICATION
        // ------------------------------------------------------------

        APP_NAME = 'practice1'

        CONTAINER_NAME = 'practice1'

        CONTAINER_PORT = '8501'


        // ------------------------------------------------------------
        // ECR
        // ------------------------------------------------------------

        ECR_REPOSITORY = 'practice1'


        // ------------------------------------------------------------
        // ECS
        // ------------------------------------------------------------

        ECS_CLUSTER = "practice1-${ENVIRONMENT}-cluster"

        ECS_SERVICE = "practice1-${ENVIRONMENT}-service"

        ECS_TASK_FAMILY = "practice1-${ENVIRONMENT}-task"

        ECS_CONTAINER_NAME = 'practice1'


        // ------------------------------------------------------------
        // LOAD BALANCER
        // ------------------------------------------------------------

        ALB_NAME = "practice1-${ENVIRONMENT}-alb"

        TARGET_GROUP_NAME = "practice1-${ENVIRONMENT}-tg"

        ALB_SG_NAME = "practice1-${ENVIRONMENT}-alb-sg"

        ECS_SG_NAME = "practice1-${ENVIRONMENT}-ecs-sg"


        // ------------------------------------------------------------
        // IAM
        // ------------------------------------------------------------

        ECS_EXECUTION_ROLE_NAME = 'practice1-ecsTaskExecutionRole'


        // ------------------------------------------------------------
        // TERRAFORM BACKEND
        // ------------------------------------------------------------

        /*
         * IMPORTANT:
         *
         * These are intentionally NOT deleted.
         *
         * The deployment pipeline uses them as the Terraform backend.
         */

        TF_STATE_BUCKET = 'terraform-state-faizan-001'

        TF_LOCK_TABLE = 'terraform-locks'

        TF_IN_AUTOMATION = 'true'

        TF_INPUT = 'false'
    }


    // ================================================================
    // STAGES
    // ================================================================

    stages {


        // ============================================================
        // 1 - SAFETY CONFIRMATION
        // ============================================================

        stage('1 - Destroy Confirmation') {

            steps {

                script {

                    echo ''
                    echo '================================================'
                    echo '          TERRAFORM / AWS DESTROY'
                    echo '================================================'

                    echo ''
                    echo "Environment : ${ENVIRONMENT}"
                    echo "Region      : ${AWS_DEFAULT_REGION}"

                    echo ''
                    echo 'Resources that may be destroyed:'
                    echo ' - ECS service'
                    echo ' - Fargate tasks'
                    echo ' - ECS cluster'
                    echo ' - ECS task definitions'
                    echo ' - Application Load Balancer'
                    echo ' - ALB listener'
                    echo ' - Target group'
                    echo ' - ECS security group'
                    echo ' - ALB security group'
                    echo ' - CloudWatch ECS log group'
                    echo ' - ECR repository and images'
                    echo ' - ECS IAM execution role'
                    echo ' - Terraform-managed infrastructure'
                    echo ''
                    echo 'Terraform backend will NOT be deleted:'
                    echo " - ${TF_STATE_BUCKET}"
                    echo " - ${TF_LOCK_TABLE}"

                    echo ''

                    if (params.CONFIRM_DESTROY != 'YES') {

                        error(
                            "DESTROY ABORTED. " +
                            "Set CONFIRM_DESTROY=YES to continue."
                        )
                    }

                    echo 'DESTROY CONFIRMATION: YES'
                }
            }
        }


        // ============================================================
        // 2 - VERIFY AWS
        // ============================================================

        stage('2 - Verify AWS CLI and Credentials') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "VERIFYING AWS"
                        echo "================================================"

                        command -v aws

                        aws --version

                        echo ""
                        echo "AWS identity:"

                        aws sts get-caller-identity \
                            --region "${AWS_DEFAULT_REGION}"
                    '''
                }
            }
        }


        // ============================================================
        // 3 - CHECK EXISTING RESOURCES
        // ============================================================

        stage('3 - Discover Existing Resources') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "DISCOVERING RESOURCES"
                        echo "================================================"

                        echo ""
                        echo "ECR:"
                        aws ecr describe-repositories \
                            --repository-names "${ECR_REPOSITORY}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            --query 'repositories[].repositoryUri' \
                            --output text

                        echo ""
                        echo "ECS Cluster:"
                        aws ecs describe-clusters \
                            --region "${AWS_DEFAULT_REGION}" \
                            --clusters "${ECS_CLUSTER}" \
                            --query 'clusters[].status' \
                            --output text

                        echo ""
                        echo "ECS Service:"
                        aws ecs describe-services \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}" \
                            --query 'services[].status' \
                            --output text

                        echo ""
                        echo "ALB:"
                        aws elbv2 describe-load-balancers \
                            --region "${AWS_DEFAULT_REGION}" \
                            --names "${ALB_NAME}" \
                            --query 'LoadBalancers[].LoadBalancerArn' \
                            --output text

                        echo ""
                        echo "Target Group:"
                        aws elbv2 describe-target-groups \
                            --region "${AWS_DEFAULT_REGION}" \
                            --names "${TARGET_GROUP_NAME}" \
                            --query 'TargetGroups[].TargetGroupArn' \
                            --output text

                        echo ""
                        echo "IAM Role:"
                        aws iam get-role \
                            --role-name "${ECS_EXECUTION_ROLE_NAME}" \
                            --query 'Role.Arn' \
                            --output text

                        echo ""
                        echo "Discovery completed."
                    '''
                }
            }
        }


        // ============================================================
        // 4 - DELETE ECS SERVICE
        // ============================================================

        stage('4 - Delete ECS Service') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "DELETING ECS SERVICE"
                        echo "================================================"

                        SERVICE_STATUS=$(aws ecs describe-services \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}" \
                            --query 'services[0].status' \
                            --output text \
                            2>/dev/null)

                        if [ "${SERVICE_STATUS}" = "ACTIVE" ]; then

                            echo "Scaling ECS service to zero..."

                            aws ecs update-service \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --service "${ECS_SERVICE}" \
                                --desired-count 0

                            echo "Waiting for running tasks to stop..."

                            aws ecs wait services-stable \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --services "${ECS_SERVICE}" \
                                || true

                            echo "Deleting ECS service..."

                            aws ecs delete-service \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --service "${ECS_SERVICE}" \
                                --force

                            echo "ECS service deletion requested."

                        else

                            echo "ECS service does not exist."

                        fi
                    '''
                }
            }
        }


        // ============================================================
        // 5 - WAIT FOR TASKS TO STOP
        // ============================================================

        stage('5 - Wait for Fargate Tasks to Stop') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "WAITING FOR FARGATE TASKS"
                        echo "================================================"

                        for i in $(seq 1 30)
                        do

                            RUNNING_TASKS=$(aws ecs list-tasks \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --desired-status RUNNING \
                                --query 'taskArns[]' \
                                --output text)

                            if [ -z "${RUNNING_TASKS}" ] ||
                               [ "${RUNNING_TASKS}" = "None" ]; then

                                echo "No RUNNING tasks remain."

                                break

                            fi

                            echo "Still running:"
                            echo "${RUNNING_TASKS}"

                            sleep 10

                        done


                        REMAINING_TASKS=$(aws ecs list-tasks \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --desired-status RUNNING \
                            --query 'taskArns[]' \
                            --output text)


                        if [ -n "${REMAINING_TASKS}" ] &&
                           [ "${REMAINING_TASKS}" != "None" ]; then

                            echo "ERROR: Fargate tasks are still running."

                            echo "${REMAINING_TASKS}"

                            exit 1

                        fi


                        echo "All Fargate tasks have stopped."
                    '''
                }
            }
        }


        // ============================================================
        // 6 - DELETE ECS TASK DEFINITIONS
        // ============================================================

        stage('6 - Delete ECS Task Definitions') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "DELETING ECS TASK DEFINITIONS"
                        echo "================================================"


                        TASK_DEFINITIONS=$(aws ecs list-task-definitions \
                            --region "${AWS_DEFAULT_REGION}" \
                            --family-prefix "${ECS_TASK_FAMILY}" \
                            --status ACTIVE \
                            --query 'taskDefinitionArns[]' \
                            --output text)


                        if [ -z "${TASK_DEFINITIONS}" ] ||
                           [ "${TASK_DEFINITIONS}" = "None" ]; then

                            echo "No ACTIVE task definitions found."

                        else

                            for TASK_DEF in ${TASK_DEFINITIONS}
                            do

                                echo "Deregistering:"
                                echo "${TASK_DEF}"

                                aws ecs deregister-task-definition \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --task-definition "${TASK_DEF}" \
                                    > /dev/null

                            done

                        fi


                        ALL_TASK_DEFINITIONS=$(aws ecs list-task-definitions \
                            --region "${AWS_DEFAULT_REGION}" \
                            --family-prefix "${ECS_TASK_FAMILY}" \
                            --query 'taskDefinitionArns[]' \
                            --output text)


                        if [ -n "${ALL_TASK_DEFINITIONS}" ] &&
                           [ "${ALL_TASK_DEFINITIONS}" != "None" ]; then

                            for TASK_DEF in ${ALL_TASK_DEFINITIONS}
                            do

                                echo "Deleting:"
                                echo "${TASK_DEF}"

                                aws ecs delete-task-definitions \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --task-definitions "${TASK_DEF}" \
                                    > /dev/null 2>&1 || true

                            done

                        fi


                        echo "Task definition cleanup completed."
                    '''
                }
            }
        }


        // ============================================================
        // 7 - DELETE ALB LISTENER
        // ============================================================

        stage('7 - Delete ALB Listener') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "DELETING ALB LISTENER"
                        echo "================================================"


                        ALB_ARN=$(aws elbv2 describe-load-balancers \
                            --region "${AWS_DEFAULT_REGION}" \
                            --names "${ALB_NAME}" \
                            --query 'LoadBalancers[0].LoadBalancerArn' \
                            --output text \
                            2>/dev/null)


                        if [ "${ALB_ARN}" = "None" ] ||
                           [ -z "${ALB_ARN}" ]; then

                            echo "ALB does not exist."

                            exit 0

                        fi


                        LISTENERS=$(aws elbv2 describe-listeners \
                            --region "${AWS_DEFAULT_REGION}" \
                            --load-balancer-arn "${ALB_ARN}" \
                            --query 'Listeners[].ListenerArn' \
                            --output text)


                        for LISTENER in ${LISTENERS}
                        do

                            echo "Deleting listener:"
                            echo "${LISTENER}"

                            aws elbv2 delete-listener \
                                --region "${AWS_DEFAULT_REGION}" \
                                --listener-arn "${LISTENER}"

                        done


                        echo "ALB listener cleanup completed."
                    '''
                }
            }
        }


        // ============================================================
        // 8 - DELETE TARGET GROUP
        // ============================================================

        stage('8 - Delete Target Group') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "DELETING TARGET GROUP"
                        echo "================================================"


                        TARGET_GROUP_ARN=$(aws elbv2 describe-target-groups \
                            --region "${AWS_DEFAULT_REGION}" \
                            --names "${TARGET_GROUP_NAME}" \
                            --query 'TargetGroups[0].TargetGroupArn' \
                            --output text \
                            2>/dev/null)


                        if [ "${TARGET_GROUP_ARN}" = "None" ] ||
                           [ -z "${TARGET_GROUP_ARN}" ]; then

                            echo "Target group does not exist."

                            exit 0

                        fi


                        aws elbv2 delete-target-group \
                            --region "${AWS_DEFAULT_REGION}" \
                            --target-group-arn "${TARGET_GROUP_ARN}"


                        echo "Target group deleted."
                    '''
                }
            }
        }


        // ============================================================
        // 9 - DELETE ALB
        // ============================================================

        stage('9 - Delete Application Load Balancer') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "DELETING APPLICATION LOAD BALANCER"
                        echo "================================================"


                        ALB_ARN=$(aws elbv2 describe-load-balancers \
                            --region "${AWS_DEFAULT_REGION}" \
                            --names "${ALB_NAME}" \
                            --query 'LoadBalancers[0].LoadBalancerArn' \
                            --output text \
                            2>/dev/null)


                        if [ "${ALB_ARN}" = "None" ] ||
                           [ -z "${ALB_ARN}" ]; then

                            echo "ALB does not exist."

                            exit 0

                        fi


                        aws elbv2 delete-load-balancer \
                            --region "${AWS_DEFAULT_REGION}" \
                            --load-balancer-arn "${ALB_ARN}"


                        echo "ALB deletion requested."

                        echo "Waiting for ALB to disappear..."


                        for i in $(seq 1 30)
                        do

                            CHECK=$(aws elbv2 describe-load-balancers \
                                --region "${AWS_DEFAULT_REGION}" \
                                --names "${ALB_NAME}" \
                                --query 'LoadBalancers[0].State.Code' \
                                --output text \
                                2>/dev/null)


                            if [ -z "${CHECK}" ] ||
                               [ "${CHECK}" = "None" ]; then

                                echo "ALB deleted."

                                break

                            fi


                            echo "ALB still exists..."

                            sleep 10

                        done
                    '''
                }
            }
        }


        // ============================================================
        // 10 - DELETE ECS CLUSTER
        // ============================================================

        stage('10 - Delete ECS Cluster') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "DELETING ECS CLUSTER"
                        echo "================================================"


                        CLUSTER_STATUS=$(aws ecs describe-clusters \
                            --region "${AWS_DEFAULT_REGION}" \
                            --clusters "${ECS_CLUSTER}" \
                            --query 'clusters[0].status' \
                            --output text \
                            2>/dev/null)


                        if [ "${CLUSTER_STATUS}" = "ACTIVE" ]; then

                            aws ecs delete-cluster \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}"

                            echo "ECS cluster deleted."

                        else

                            echo "ECS cluster does not exist."

                        fi
                    '''
                }
            }
        }


        // ============================================================
        // 11 - DELETE SECURITY GROUPS
        // ============================================================

        stage('11 - Delete Security Groups') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "DELETING SECURITY GROUPS"
                        echo "================================================"


                        ALB_SG_ID=$(aws ec2 describe-security-groups \
                            --region "${AWS_DEFAULT_REGION}" \
                            --filters \
                                "Name=group-name,Values=${ALB_SG_NAME}" \
                            --query 'SecurityGroups[0].GroupId' \
                            --output text \
                            2>/dev/null)


                        ECS_SG_ID=$(aws ec2 describe-security-groups \
                            --region "${AWS_DEFAULT_REGION}" \
                            --filters \
                                "Name=group-name,Values=${ECS_SG_NAME}" \
                            --query 'SecurityGroups[0].GroupId' \
                            --output text \
                            2>/dev/null)


                        if [ -n "${ALB_SG_ID}" ] &&
                           [ "${ALB_SG_ID}" != "None" ]; then

                            echo "Deleting ALB security group:"
                            echo "${ALB_SG_ID}"

                            aws ec2 delete-security-group \
                                --region "${AWS_DEFAULT_REGION}" \
                                --group-id "${ALB_SG_ID}" \
                                || echo "WARNING: ALB security group could not be deleted."

                        else

                            echo "ALB security group not found."

                        fi


                        if [ -n "${ECS_SG_ID}" ] &&
                           [ "${ECS_SG_ID}" != "None" ]; then

                            echo "Deleting ECS security group:"
                            echo "${ECS_SG_ID}"

                            aws ec2 delete-security-group \
                                --region "${AWS_DEFAULT_REGION}" \
                                --group-id "${ECS_SG_ID}" \
                                || echo "WARNING: ECS security group could not be deleted."

                        else

                            echo "ECS security group not found."

                        fi
                    '''
                }
            }
        }


        // ============================================================
        // 12 - DELETE CLOUDWATCH LOG GROUP
        // ============================================================

        stage('12 - Delete CloudWatch Log Group') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "DELETING CLOUDWATCH LOG GROUP"
                        echo "================================================"


                        LOG_GROUP="/ecs/${ECS_TASK_FAMILY}"


                        aws logs delete-log-group \
                            --log-group-name "${LOG_GROUP}" \
                            --region "${AWS_DEFAULT_REGION}"


                        if [ $? -eq 0 ]; then

                            echo "CloudWatch log group deleted."

                        else

                            echo "CloudWatch log group does not exist or was already deleted."

                        fi
                    '''
                }
            }
        }


        // ============================================================
        // 13 - DELETE IAM ROLE
        // ============================================================

        stage('13 - Delete ECS IAM Execution Role') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "DELETING ECS IAM EXECUTION ROLE"
                        echo "================================================"


                        ROLE_EXISTS=$(aws iam get-role \
                            --role-name "${ECS_EXECUTION_ROLE_NAME}" \
                            --query 'Role.RoleName' \
                            --output text \
                            2>/dev/null)


                        if [ "${ROLE_EXISTS}" = "${ECS_EXECUTION_ROLE_NAME}" ]; then

                            echo "Removing attached policies..."


                            POLICIES=$(aws iam list-attached-role-policies \
                                --role-name "${ECS_EXECUTION_ROLE_NAME}" \
                                --query 'AttachedPolicies[].PolicyArn' \
                                --output text)


                            for POLICY in ${POLICIES}
                            do

                                echo "Detaching:"
                                echo "${POLICY}"

                                aws iam detach-role-policy \
                                    --role-name "${ECS_EXECUTION_ROLE_NAME}" \
                                    --policy-arn "${POLICY}"

                            done


                            INLINE_POLICIES=$(aws iam list-role-policies \
                                --role-name "${ECS_EXECUTION_ROLE_NAME}" \
                                --query 'PolicyNames[]' \
                                --output text)


                            for POLICY in ${INLINE_POLICIES}
                            do

                                aws iam delete-role-policy \
                                    --role-name "${ECS_EXECUTION_ROLE_NAME}" \
                                    --policy-name "${POLICY}"

                            done


                            aws iam delete-role \
                                --role-name "${ECS_EXECUTION_ROLE_NAME}"


                            echo "IAM execution role deleted."

                        else

                            echo "IAM execution role does not exist."

                        fi
                    '''
                }
            }
        }


        // ============================================================
        // 14 - DELETE ECR REPOSITORY
        // ============================================================

        stage('14 - Delete ECR Repository and Images') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "DELETING ECR REPOSITORY"
                        echo "================================================"


                        aws ecr describe-repositories \
                            --repository-names "${ECR_REPOSITORY}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            > /dev/null 2>&1


                        if [ $? -eq 0 ]; then

                            echo "Deleting ECR repository and ALL images..."

                            aws ecr delete-repository \
                                --repository-name "${ECR_REPOSITORY}" \
                                --region "${AWS_DEFAULT_REGION}" \
                                --force

                            echo "ECR repository deleted."

                        else

                            echo "ECR repository does not exist."

                        fi
                    '''
                }
            }
        }


        // ============================================================
        // 15 - CHECK FOR LEFTOVER ECS RESOURCES
        // ============================================================

        stage('15 - Verify ECS Cleanup') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "VERIFYING ECS CLEANUP"
                        echo "================================================"


                        echo ""
                        echo "Running tasks:"

                        aws ecs list-tasks \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --desired-status RUNNING \
                            --query 'taskArns[]' \
                            --output text


                        echo ""
                        echo "ECS service:"

                        aws ecs describe-services \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}" \
                            --query 'services[].status' \
                            --output text


                        echo ""
                        echo "ECS cluster:"

                        aws ecs describe-clusters \
                            --region "${AWS_DEFAULT_REGION}" \
                            --clusters "${ECS_CLUSTER}" \
                            --query 'clusters[].status' \
                            --output text
                    '''
                }
            }
        }


        // ============================================================
        // 16 - CHECK FOR LEFTOVER ALB
        // ============================================================

        stage('16 - Verify ALB Cleanup') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "VERIFYING ALB CLEANUP"
                        echo "================================================"


                        echo ""
                        echo "ALB:"

                        aws elbv2 describe-load-balancers \
                            --region "${AWS_DEFAULT_REGION}" \
                            --names "${ALB_NAME}" \
                            --query 'LoadBalancers[].LoadBalancerArn' \
                            --output text


                        echo ""
                        echo "Target Group:"

                        aws elbv2 describe-target-groups \
                            --region "${AWS_DEFAULT_REGION}" \
                            --names "${TARGET_GROUP_NAME}" \
                            --query 'TargetGroups[].TargetGroupArn' \
                            --output text
                    '''
                }
            }
        }


        // ============================================================
        // 17 - CHECK FOR LEFTOVER ECR
        // ============================================================

        stage('17 - Verify ECR Cleanup') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "VERIFYING ECR CLEANUP"
                        echo "================================================"


                        aws ecr describe-repositories \
                            --repository-names "${ECR_REPOSITORY}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            --query 'repositories[].repositoryName' \
                            --output text
                    '''
                }
            }
        }


        // ============================================================
        // 18 - CHECK FOR LEFTOVER IAM ROLE
        // ============================================================

        stage('18 - Verify IAM Cleanup') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "VERIFYING IAM CLEANUP"
                        echo "================================================"


                        aws iam get-role \
                            --role-name "${ECS_EXECUTION_ROLE_NAME}" \
                            --query 'Role.Arn' \
                            --output text
                    '''
                }
            }
        }


        // ============================================================
        // 19 - CHECK TERRAFORM
        // ============================================================

        stage('19 - Checkout Terraform Repository') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    deleteDir()

                    git(
                        branch: "${TERRAFORM_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${TERRAFORM_REPO}"
                    )
                }
            }
        }


        // ============================================================
        // 20 - TERRAFORM INIT
        // ============================================================

        stage('20 - Terraform Init') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh '''
                            set -e

                            echo "================================================"
                            echo "TERRAFORM INIT"
                            echo "================================================"

                            terraform init \
                                -input=false
                        '''
                    }
                }
            }
        }


        // ============================================================
        // 21 - TERRAFORM VALIDATE
        // ============================================================

        stage('21 - Terraform Validate') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    sh '''
                        set -e

                        terraform validate
                    '''
                }
            }
        }


        // ============================================================
        // 22 - TERRAFORM STATE
        // ============================================================

        stage('22 - Terraform State Before Destroy') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh '''
                            set +e

                            echo "================================================"
                            echo "TERRAFORM STATE BEFORE DESTROY"
                            echo "================================================"

                            terraform state list

                            echo ""
                            echo "Terraform outputs:"

                            terraform output
                        '''
                    }
                }
            }
        }


        // ============================================================
        // 23 - TERRAFORM DESTROY
        // ============================================================

        stage('23 - Terraform Destroy') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh '''
                            set -e

                            echo "================================================"
                            echo "        TERRAFORM DESTROY"
                            echo "================================================"

                            echo ""
                            echo "Environment:"
                            echo "${ENVIRONMENT}"

                            echo ""
                            echo "Terraform will destroy the resources"
                            echo "managed by this environment state."

                            terraform destroy \
                                -input=false \
                                -auto-approve \
                                -var-file="environments/${ENVIRONMENT}/terraform.tfvars"

                            echo ""
                            echo "Terraform destroy completed."
                        '''
                    }
                }
            }
        }


        // ============================================================
        // 24 - VERIFY TERRAFORM STATE
        // ============================================================

        stage('24 - Verify Terraform Destruction') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh '''
                            set +e

                            echo "================================================"
                            echo "VERIFYING TERRAFORM DESTRUCTION"
                            echo "================================================"

                            echo ""
                            echo "Remaining Terraform state:"

                            terraform state list

                            echo ""
                            echo "Remaining Terraform outputs:"

                            terraform output
                        '''
                    }
                }
            }
        }


        // ============================================================
        // 25 - FINAL AWS RESOURCE SCAN
        // ============================================================

        stage('25 - Final AWS Cleanup Verification') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo ""
                        echo "================================================"
                        echo "       FINAL AWS CLEANUP VERIFICATION"
                        echo "================================================"


                        echo ""
                        echo "---------------- ECS SERVICE ----------------"

                        aws ecs describe-services \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}" \
                            --query 'services[].{Status:status,Running:runningCount,Desired:desiredCount}' \
                            --output table


                        echo ""
                        echo "---------------- ECS CLUSTER ----------------"

                        aws ecs describe-clusters \
                            --region "${AWS_DEFAULT_REGION}" \
                            --clusters "${ECS_CLUSTER}" \
                            --query 'clusters[].{Name:clusterName,Status:status}' \
                            --output table


                        echo ""
                        echo "---------------- ALB ----------------"

                        aws elbv2 describe-load-balancers \
                            --region "${AWS_DEFAULT_REGION}" \
                            --names "${ALB_NAME}" \
                            --query 'LoadBalancers[].{Name:LoadBalancerName,State:State.Code}' \
                            --output table


                        echo ""
                        echo "---------------- TARGET GROUP ----------------"

                        aws elbv2 describe-target-groups \
                            --region "${AWS_DEFAULT_REGION}" \
                            --names "${TARGET_GROUP_NAME}" \
                            --query 'TargetGroups[].TargetGroupName' \
                            --output table


                        echo ""
                        echo "---------------- ECR ----------------"

                        aws ecr describe-repositories \
                            --repository-names "${ECR_REPOSITORY}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            --query 'repositories[].repositoryName' \
                            --output table


                        echo ""
                        echo "---------------- IAM ROLE ----------------"

                        aws iam get-role \
                            --role-name "${ECS_EXECUTION_ROLE_NAME}" \
                            --query 'Role.RoleName' \
                            --output text


                        echo ""
                        echo "================================================"
                        echo "FINAL RESOURCE SCAN COMPLETED"
                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // 26 - BACKEND VERIFICATION
        // ============================================================

        stage('26 - Verify Terraform Backend Remains') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "VERIFYING TERRAFORM BACKEND"
                        echo "================================================"

                        echo ""
                        echo "Terraform state bucket:"
                        echo "${TF_STATE_BUCKET}"

                        aws s3api head-bucket \
                            --bucket "${TF_STATE_BUCKET}" \
                            --region "${AWS_DEFAULT_REGION}"

                        echo "S3 backend is PRESENT."

                        echo ""
                        echo "Terraform lock table:"

                        aws dynamodb describe-table \
                            --table-name "${TF_LOCK_TABLE}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            --query 'Table.TableName' \
                            --output text

                        echo ""
                        echo "DynamoDB lock table is PRESENT."

                        echo ""
                        echo "IMPORTANT:"
                        echo "Terraform backend was intentionally NOT deleted."
                    '''
                }
            }
        }


        // ============================================================
        // 27 - FINAL SUCCESS
        // ============================================================

        stage('27 - Destroy Summary') {

            steps {

                echo ''
                echo '================================================'
                echo '        DESTROY PIPELINE COMPLETED'
                echo '================================================'

                echo ''
                echo "Environment : ${ENVIRONMENT}"
                echo "Region      : ${AWS_DEFAULT_REGION}"

                echo ''
                echo 'Deleted / Destroyed:'

                echo '1. ECS Fargate service'
                echo '2. Fargate running tasks'
                echo '3. ECS task definitions'
                echo '4. ECS cluster'
                echo '5. Application Load Balancer'
                echo '6. ALB listeners'
                echo '7. Target group'
                echo '8. ALB security group'
                echo '9. ECS security group'
                echo '10. CloudWatch ECS log group'
                echo '11. ECS IAM execution role'
                echo '12. ECR repository'
                echo '13. ECR container images'
                echo '14. Terraform-managed infrastructure'

                echo ''
                echo 'Intentionally preserved:'

                echo '1. Terraform S3 state bucket'
                echo '2. Terraform DynamoDB lock table'

                echo ''
                echo '================================================'
                echo '        AWS ENVIRONMENT DESTROYED'
                echo '================================================'
            }
        }
    }


    // ================================================================
    // POST ACTIONS
    // ================================================================

    post {

        success {

            echo ''
            echo '================================================'
            echo '       COMPLETE DESTROY SUCCESS'
            echo '================================================'

            echo ''
            echo "Environment ${ENVIRONMENT} has been destroyed."

            echo ''
            echo 'All deployment resources were removed.'

            echo ''
            echo 'Terraform backend was preserved:'

            echo "S3 : ${TF_STATE_BUCKET}"
            echo "DynamoDB : ${TF_LOCK_TABLE}"

            echo ''
            echo '================================================'
        }


        failure {

            echo ''
            echo '================================================'
            echo '          DESTROY PIPELINE FAILED'
            echo '================================================'

            echo ''
            echo 'IMPORTANT: Some AWS resources may still exist.'

            echo ''
            echo 'Check the Jenkins console output for:'

            echo '1. ECS service/tasks'
            echo '2. ECS cluster'
            echo '3. ALB'
            echo '4. Target group'
            echo '5. Security groups'
            echo '6. ECR repository'
            echo '7. IAM role'
            echo '8. CloudWatch log group'
            echo '9. Terraform resources'

            echo ''
            echo 'DO NOT assume the environment is fully deleted'
            echo 'until the final cleanup verification passes.'

            echo ''
            echo '================================================'
        }


        always {

            echo ''
            echo '================================================'
            echo 'CLEANING JENKINS WORKSPACE'
            echo '================================================'

            cleanWs(
                deleteDirs: true,
                disableDeferredWipeout: true
            )
        }
    }
}
