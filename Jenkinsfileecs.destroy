pipeline {

    agent any

    // ================================================================
    // PIPELINE OPTIONS
    // ================================================================

    options {

        timestamps()

        ansiColor('xterm')

        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                daysToKeepStr: '30',
                numToKeepStr: '50'
            )
        )

        timeout(
            time: 90,
            unit: 'MINUTES'
        )
    }

    // ================================================================
    // PARAMETERS
    // ================================================================

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: [
                'dev',
                'qa',
                'stage',
                'prod'
            ],
            description: 'Terraform environment to destroy'
        )

        booleanParam(
            name: 'DELETE_TERRAFORM_BACKEND',
            defaultValue: true,
            description: 'WARNING: Delete Terraform S3 backend bucket and DynamoDB lock table'
        )
    }

    // ================================================================
    // ENVIRONMENT
    // ================================================================

    environment {

        // ============================================================
        // GITHUB
        // ============================================================

        GITHUB_CREDENTIALS = 'github-creds'

        TERRAFORM_REPO = 'https://github.com/FAIZANSHEIKH223/terraform-aws-infra.git'

        TERRAFORM_BRANCH = 'main'

        TERRAFORM_DIR = 'terraform-infra'


        // ============================================================
        // AWS
        // ============================================================

        AWS_CREDENTIALS = 'aws-creds'

        AWS_DEFAULT_REGION = 'us-east-1'


        // ============================================================
        // APPLICATION
        // ============================================================

        APP_NAME = 'practice1'

        CONTAINER_NAME = 'practice1'

        CONTAINER_PORT = '8501'


        // ============================================================
        // ECR
        // ============================================================

        ECR_REPOSITORY = 'practice1'


        // ============================================================
        // ECS
        // ============================================================

        ECS_CLUSTER = "practice1-${ENVIRONMENT}-cluster"

        ECS_SERVICE = "practice1-${ENVIRONMENT}-service"

        ECS_TASK_FAMILY = "practice1-${ENVIRONMENT}-task"


        // ============================================================
        // LOAD BALANCER
        // ============================================================

        ALB_NAME = "practice1-${ENVIRONMENT}-alb"

        TARGET_GROUP_NAME = "practice1-${ENVIRONMENT}-tg"

        ALB_SG_NAME = "practice1-${ENVIRONMENT}-alb-sg"

        ECS_SG_NAME = "practice1-${ENVIRONMENT}-ecs-sg"


        // ============================================================
        // TERRAFORM BACKEND
        // ============================================================

        TF_STATE_BUCKET = 'terraform-state-faizan-001'

        TF_LOCK_TABLE = 'terraform-locks'

        TF_IN_AUTOMATION = 'true'

        TF_INPUT = 'false'
    }


    // ================================================================
    // STAGES
    // ================================================================

    stages {


        // ============================================================
        // 1. AWS VERIFICATION
        // ============================================================

        stage('1 - Verify AWS') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "VERIFYING AWS"
                        echo "================================================"

                        command -v aws

                        aws --version

                        aws sts get-caller-identity \
                            --region "${AWS_DEFAULT_REGION}"

                        echo ""
                        echo "AWS REGION:"
                        echo "${AWS_DEFAULT_REGION}"

                        echo ""
                        echo "ENVIRONMENT:"
                        echo "${ENVIRONMENT}"
                    '''
                }
            }
        }


        // ============================================================
        // 2. TERRAFORM CHECKOUT
        // ============================================================

        stage('2 - Checkout Terraform') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    deleteDir()

                    git(
                        branch: "${TERRAFORM_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${TERRAFORM_REPO}"
                    )
                }
            }
        }


        // ============================================================
        // 3. TERRAFORM DESTROY
        // ============================================================

        stage('3 - Terraform Destroy') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh '''
                            set -eu

                            echo "================================================"
                            echo "TERRAFORM DESTROY"
                            echo "================================================"

                            command -v terraform

                            terraform version

                            echo ""
                            echo "Environment:"
                            echo "${ENVIRONMENT}"

                            if [ ! -d "environments/${ENVIRONMENT}" ]; then
                                echo "ERROR: Terraform environment does not exist:"
                                echo "environments/${ENVIRONMENT}"
                                exit 1
                            fi

                            if [ ! -f "environments/${ENVIRONMENT}/terraform.tfvars" ]; then
                                echo "ERROR: Terraform variables file does not exist:"
                                echo "environments/${ENVIRONMENT}/terraform.tfvars"
                                exit 1
                            fi

                            echo ""
                            echo "================================================"
                            echo "TERRAFORM INIT"
                            echo "================================================"

                            terraform init \
                                -input=false \
                                -reconfigure

                            echo ""
                            echo "================================================"
                            echo "TERRAFORM VALIDATE"
                            echo "================================================"

                            terraform validate

                            echo ""
                            echo "================================================"
                            echo "TERRAFORM DESTROY"
                            echo "================================================"

                            terraform destroy \
                                -input=false \
                                -auto-approve \
                                -var-file="environments/${ENVIRONMENT}/terraform.tfvars"

                            echo ""
                            echo "Terraform destroy completed."
                        '''
                    }
                }
            }
        }


        // ============================================================
        // 4. ECS SERVICE DELETE
        // ============================================================

        stage('4 - Delete ECS Service') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "DELETE ECS SERVICE"
                        echo "================================================"

                        SERVICE_STATUS=$(aws ecs describe-services \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}" \
                            --query 'services[0].status' \
                            --output text \
                            2>/dev/null || true)

                        echo "Initial service status: ${SERVICE_STATUS}"

                        if [ "${SERVICE_STATUS}" = "ACTIVE" ] ||
                           [ "${SERVICE_STATUS}" = "DRAINING" ]; then

                            echo ""
                            echo "Scaling ECS service to zero..."

                            aws ecs update-service \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --service "${ECS_SERVICE}" \
                                --desired-count 0 \
                                --force-new-deployment \
                                2>/dev/null || true

                            echo ""
                            echo "Force deleting ECS service..."

                            aws ecs delete-service \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --service "${ECS_SERVICE}" \
                                --force \
                                2>/dev/null || true

                        else

                            echo "ECS service does not appear to be ACTIVE."
                            echo "Nothing to delete."

                        fi

                        echo ""
                        echo "================================================"
                        echo "WAITING FOR ECS SERVICE DELETION"
                        echo "================================================"

                        SERVICE_DELETED="false"

                        for i in $(seq 1 60)
                        do

                            STATUS=$(aws ecs describe-services \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --services "${ECS_SERVICE}" \
                                --query 'services[0].status' \
                                --output text \
                                2>/dev/null || true)

                            echo "Deletion check ${i}/60: ${STATUS}"

                            if [ "${STATUS}" = "None" ] ||
                               [ -z "${STATUS}" ]; then

                                SERVICE_DELETED="true"
                                echo "ECS service no longer exists."
                                break
                            fi

                            if [ "${STATUS}" = "DRAINING" ]; then

                                echo "Service is DRAINING."
                                echo "Stopping remaining tasks separately."

                                TASK_ARNS=$(aws ecs list-tasks \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --cluster "${ECS_CLUSTER}" \
                                    --service-name "${ECS_SERVICE}" \
                                    --desired-status RUNNING \
                                    --query 'taskArns[]' \
                                    --output text \
                                    2>/dev/null || true)

                                if [ -n "${TASK_ARNS}" ] &&
                                   [ "${TASK_ARNS}" != "None" ]; then

                                    for TASK in ${TASK_ARNS}
                                    do
                                        echo "Stopping task: ${TASK}"

                                        aws ecs stop-task \
                                            --region "${AWS_DEFAULT_REGION}" \
                                            --cluster "${ECS_CLUSTER}" \
                                            --task "${TASK}" \
                                            --reason "Destroy pipeline" \
                                            2>/dev/null || true
                                    done
                                fi
                            fi

                            sleep 5
                        done

                        if [ "${SERVICE_DELETED}" != "true" ]; then

                            echo ""
                            echo "WARNING:"
                            echo "ECS service still exists after 5 minutes."

                            echo ""
                            echo "Current ECS service state:"

                            aws ecs describe-services \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --services "${ECS_SERVICE}" \
                                --query 'services[0].{Status:status,Desired:desiredCount,Running:runningCount,Pending:pendingCount}' \
                                --output json \
                                2>/dev/null || true

                            echo ""
                            echo "Continuing cleanup."
                            echo "DRAINING will not stop the pipeline."
                        fi
                    '''
                }
            }
        }


        // ============================================================
        // 5. STOP REMAINING ECS TASKS
        // ============================================================

        stage('5 - Stop Remaining ECS Tasks') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "STOPPING REMAINING ECS TASKS"
                        echo "================================================"

                        for STATUS in RUNNING PENDING
                        do

                            TASK_ARNS=$(aws ecs list-tasks \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --desired-status "${STATUS}" \
                                --query 'taskArns[]' \
                                --output text \
                                2>/dev/null || true)

                            if [ -n "${TASK_ARNS}" ] &&
                               [ "${TASK_ARNS}" != "None" ]; then

                                for TASK in ${TASK_ARNS}
                                do

                                    echo "Stopping ${STATUS} task:"
                                    echo "${TASK}"

                                    aws ecs stop-task \
                                        --region "${AWS_DEFAULT_REGION}" \
                                        --cluster "${ECS_CLUSTER}" \
                                        --task "${TASK}" \
                                        --reason "Destroy pipeline" \
                                        2>/dev/null || true

                                done

                            else

                                echo "No ${STATUS} tasks found."

                            fi
                        done

                        echo ""
                        echo "Waiting for tasks to stop..."

                        for i in $(seq 1 30)
                        do

                            RUNNING=$(aws ecs list-tasks \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --desired-status RUNNING \
                                --query 'length(taskArns)' \
                                --output text \
                                2>/dev/null || echo "0")

                            PENDING=$(aws ecs list-tasks \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --desired-status PENDING \
                                --query 'length(taskArns)' \
                                --output text \
                                2>/dev/null || echo "0")

                            echo "Task check ${i}/30: running=${RUNNING} pending=${PENDING}"

                            if [ "${RUNNING}" = "0" ] &&
                               [ "${PENDING}" = "0" ]; then

                                echo "All ECS tasks stopped."
                                break
                            fi

                            sleep 5
                        done
                    '''
                }
            }
        }


        // ============================================================
        // 6. DELETE ALB LISTENER
        // ============================================================

        stage('6 - Delete ALB Listener') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "DELETE ALB LISTENER"
                        echo "================================================"

                        ALB_ARN=$(aws elbv2 describe-load-balancers \
                            --region "${AWS_DEFAULT_REGION}" \
                            --names "${ALB_NAME}" \
                            --query 'LoadBalancers[0].LoadBalancerArn' \
                            --output text \
                            2>/dev/null || true)

                        if [ -z "${ALB_ARN}" ] ||
                           [ "${ALB_ARN}" = "None" ]; then

                            echo "ALB not found."
                            exit 0
                        fi

                        echo "ALB ARN: ${ALB_ARN}"

                        LISTENERS=$(aws elbv2 describe-listeners \
                            --region "${AWS_DEFAULT_REGION}" \
                            --load-balancer-arn "${ALB_ARN}" \
                            --query 'Listeners[].ListenerArn' \
                            --output text \
                            2>/dev/null || true)

                        if [ -n "${LISTENERS}" ] &&
                           [ "${LISTENERS}" != "None" ]; then

                            for LISTENER in ${LISTENERS}
                            do

                                echo "Deleting listener:"
                                echo "${LISTENER}"

                                aws elbv2 delete-listener \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --listener-arn "${LISTENER}" \
                                    2>/dev/null || true

                            done

                        else

                            echo "No listeners found."

                        fi

                        sleep 5
                    '''
                }
            }
        }


        // ============================================================
        // 7. DELETE ALB
        // ============================================================

        stage('7 - Delete ALB') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "DELETE APPLICATION LOAD BALANCER"
                        echo "================================================"

                        ALB_ARN=$(aws elbv2 describe-load-balancers \
                            --region "${AWS_DEFAULT_REGION}" \
                            --names "${ALB_NAME}" \
                            --query 'LoadBalancers[0].LoadBalancerArn' \
                            --output text \
                            2>/dev/null || true)

                        if [ -z "${ALB_ARN}" ] ||
                           [ "${ALB_ARN}" = "None" ]; then

                            echo "ALB does not exist."
                            exit 0
                        fi

                        echo "Deleting ALB:"
                        echo "${ALB_ARN}"

                        aws elbv2 delete-load-balancer \
                            --region "${AWS_DEFAULT_REGION}" \
                            --load-balancer-arn "${ALB_ARN}" \
                            2>/dev/null || true

                        echo ""
                        echo "Waiting for ALB deletion..."

                        for i in $(seq 1 36)
                        do

                            ALB_STATUS=$(aws elbv2 describe-load-balancers \
                                --region "${AWS_DEFAULT_REGION}" \
                                --names "${ALB_NAME}" \
                                --query 'LoadBalancers[0].State.Code' \
                                --output text \
                                2>/dev/null || true)

                            echo "ALB deletion check ${i}/36: ${ALB_STATUS}"

                            if [ -z "${ALB_STATUS}" ] ||
                               [ "${ALB_STATUS}" = "None" ]; then

                                echo "ALB deleted."
                                break
                            fi

                            sleep 5
                        done
                    '''
                }
            }
        }


        // ============================================================
        // 8. DELETE TARGET GROUP
        // ============================================================

        stage('8 - Delete Target Group') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "DELETE TARGET GROUP"
                        echo "================================================"

                        TG_ARN=$(aws elbv2 describe-target-groups \
                            --region "${AWS_DEFAULT_REGION}" \
                            --names "${TARGET_GROUP_NAME}" \
                            --query 'TargetGroups[0].TargetGroupArn' \
                            --output text \
                            2>/dev/null || true)

                        if [ -z "${TG_ARN}" ] ||
                           [ "${TG_ARN}" = "None" ]; then

                            echo "Target group does not exist."
                            exit 0
                        fi

                        echo "Target Group ARN:"
                        echo "${TG_ARN}"

                        for i in $(seq 1 12)
                        do

                            if aws elbv2 delete-target-group \
                                --region "${AWS_DEFAULT_REGION}" \
                                --target-group-arn "${TG_ARN}"
                            then

                                echo "Target group deleted."
                                break

                            else

                                echo "Target group still attached."
                                echo "Retry ${i}/12."

                                sleep 5
                            fi
                        done
                    '''
                }
            }
        }


        // ============================================================
        // 9. DELETE ECS CLUSTER
        // ============================================================

        stage('9 - Delete ECS Cluster') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "DELETE ECS CLUSTER"
                        echo "================================================"

                        CLUSTER_STATUS=$(aws ecs describe-clusters \
                            --region "${AWS_DEFAULT_REGION}" \
                            --clusters "${ECS_CLUSTER}" \
                            --query 'clusters[0].status' \
                            --output text \
                            2>/dev/null || true)

                        echo "Cluster status: ${CLUSTER_STATUS}"

                        if [ "${CLUSTER_STATUS}" = "ACTIVE" ] ||
                           [ "${CLUSTER_STATUS}" = "DRAINING" ]; then

                            aws ecs delete-cluster \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}"

                            echo "ECS cluster deletion requested."

                        else

                            echo "ECS cluster does not exist."

                        fi

                        for i in $(seq 1 30)
                        do

                            STATUS=$(aws ecs describe-clusters \
                                --region "${AWS_DEFAULT_REGION}" \
                                --clusters "${ECS_CLUSTER}" \
                                --query 'clusters[0].status' \
                                --output text \
                                2>/dev/null || true)

                            echo "Cluster deletion check ${i}/30: ${STATUS}"

                            if [ -z "${STATUS}" ] ||
                               [ "${STATUS}" = "None" ]; then

                                echo "ECS cluster deleted."
                                break
                            fi

                            sleep 5
                        done
                    '''
                }
            }
        }


        // ============================================================
        // 10. DELETE ECR
        // ============================================================

        stage('10 - Delete ECR Repository') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "DELETE ECR REPOSITORY"
                        echo "================================================"

                        if aws ecr describe-repositories \
                            --region "${AWS_DEFAULT_REGION}" \
                            --repository-names "${ECR_REPOSITORY}" \
                            > /dev/null 2>&1
                        then

                            echo "Deleting ECR repository:"
                            echo "${ECR_REPOSITORY}"

                            aws ecr delete-repository \
                                --region "${AWS_DEFAULT_REGION}" \
                                --repository-name "${ECR_REPOSITORY}" \
                                --force

                            echo "ECR repository deleted."

                        else

                            echo "ECR repository does not exist."

                        fi
                    '''
                }
            }
        }


        // ============================================================
        // 11. DELETE CLOUDWATCH LOG GROUP
        // ============================================================

        stage('11 - Delete CloudWatch Logs') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "DELETE CLOUDWATCH LOG GROUP"
                        echo "================================================"

                        LOG_GROUP="/ecs/${ECS_TASK_FAMILY}"

                        if aws logs describe-log-groups \
                            --region "${AWS_DEFAULT_REGION}" \
                            --log-group-name-prefix "${LOG_GROUP}" \
                            --query "logGroups[?logGroupName=='${LOG_GROUP}'].logGroupName" \
                            --output text |
                            grep -q "${LOG_GROUP}"
                        then

                            echo "Deleting:"
                            echo "${LOG_GROUP}"

                            aws logs delete-log-group \
                                --region "${AWS_DEFAULT_REGION}" \
                                --log-group-name "${LOG_GROUP}"

                            echo "CloudWatch log group deleted."

                        else

                            echo "CloudWatch log group does not exist."

                        fi
                    '''
                }
            }
        }


        // ============================================================
        // 12. DEREGISTER ECS TASK DEFINITIONS
        // ============================================================

        stage('12 - Deregister ECS Task Definitions') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "DEREGISTER ECS TASK DEFINITIONS"
                        echo "================================================"

                        TASK_DEFINITIONS=$(aws ecs list-task-definitions \
                            --region "${AWS_DEFAULT_REGION}" \
                            --family-prefix "${ECS_TASK_FAMILY}" \
                            --status ACTIVE \
                            --query 'taskDefinitionArns[]' \
                            --output text \
                            2>/dev/null || true)

                        if [ -n "${TASK_DEFINITIONS}" ] &&
                           [ "${TASK_DEFINITIONS}" != "None" ]; then

                            for TASK_DEF in ${TASK_DEFINITIONS}
                            do

                                echo "Deregistering:"
                                echo "${TASK_DEF}"

                                aws ecs deregister-task-definition \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --task-definition "${TASK_DEF}" \
                                    > /dev/null \
                                    2>/dev/null || true

                            done

                        else

                            echo "No active task definitions found."

                        fi
                    '''
                }
            }
        }


        // ============================================================
        // 13. DELETE SECURITY GROUPS
        // ============================================================

        stage('13 - Delete Security Groups') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "DELETE SECURITY GROUPS"
                        echo "================================================"

                        VPC_ID=$(aws ec2 describe-security-groups \
                            --region "${AWS_DEFAULT_REGION}" \
                            --filters \
                                "Name=group-name,Values=${ALB_SG_NAME}" \
                            --query 'SecurityGroups[0].VpcId' \
                            --output text \
                            2>/dev/null || true)

                        echo "Detected VPC: ${VPC_ID}"


                        // ------------------------------------------------
                        // ALB SECURITY GROUP
                        // ------------------------------------------------

                        ALB_SG_ID=$(aws ec2 describe-security-groups \
                            --region "${AWS_DEFAULT_REGION}" \
                            --filters \
                                "Name=group-name,Values=${ALB_SG_NAME}" \
                            --query 'SecurityGroups[0].GroupId' \
                            --output text \
                            2>/dev/null || true)

                        if [ -n "${ALB_SG_ID}" ] &&
                           [ "${ALB_SG_ID}" != "None" ]; then

                            echo "Deleting ALB SG: ${ALB_SG_ID}"

                            aws ec2 delete-security-group \
                                --region "${AWS_DEFAULT_REGION}" \
                                --group-id "${ALB_SG_ID}" \
                                2>/dev/null || true

                        else

                            echo "ALB security group not found."

                        fi


                        // ------------------------------------------------
                        // ECS SECURITY GROUP
                        // ------------------------------------------------

                        ECS_SG_ID=$(aws ec2 describe-security-groups \
                            --region "${AWS_DEFAULT_REGION}" \
                            --filters \
                                "Name=group-name,Values=${ECS_SG_NAME}" \
                            --query 'SecurityGroups[0].GroupId' \
                            --output text \
                            2>/dev/null || true)

                        if [ -n "${ECS_SG_ID}" ] &&
                           [ "${ECS_SG_ID}" != "None" ]; then

                            echo "Deleting ECS SG: ${ECS_SG_ID}"

                            aws ec2 delete-security-group \
                                --region "${AWS_DEFAULT_REGION}" \
                                --group-id "${ECS_SG_ID}" \
                                2>/dev/null || true

                        else

                            echo "ECS security group not found."

                        fi
                    '''
                }
            }
        }


        // ============================================================
        // 14. DELETE IAM EXECUTION ROLE
        // ============================================================

        stage('14 - Delete ECS IAM Role') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "DELETE ECS IAM EXECUTION ROLE"
                        echo "================================================"

                        ROLE_NAME="practice1-ecsTaskExecutionRole"

                        if aws iam get-role \
                            --role-name "${ROLE_NAME}" \
                            > /dev/null 2>&1
                        then

                            echo "Detaching policy..."

                            aws iam detach-role-policy \
                                --role-name "${ROLE_NAME}" \
                                --policy-arn \
                                arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy \
                                2>/dev/null || true

                            echo "Deleting role..."

                            aws iam delete-role \
                                --role-name "${ROLE_NAME}"

                            echo "IAM execution role deleted."

                        else

                            echo "IAM execution role does not exist."

                        fi
                    '''
                }
            }
        }


        // ============================================================
        // 15. DELETE TERRAFORM BACKEND
        // ============================================================

        stage('15 - Delete Terraform Backend') {

            when {

                expression {
                    return params.DELETE_TERRAFORM_BACKEND
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "DELETE TERRAFORM BACKEND"
                        echo "================================================"

                        echo ""
                        echo "WARNING:"
                        echo "The following Terraform backend resources"
                        echo "will be permanently deleted:"

                        echo ""
                        echo "S3 Bucket:"
                        echo "${TF_STATE_BUCKET}"

                        echo ""
                        echo "DynamoDB Table:"
                        echo "${TF_LOCK_TABLE}"

                        echo ""
                        echo "================================================"
                        echo "DELETE DYNAMODB LOCK TABLE"
                        echo "================================================"

                        TABLE_STATUS=$(aws dynamodb describe-table \
                            --region "${AWS_DEFAULT_REGION}" \
                            --table-name "${TF_LOCK_TABLE}" \
                            --query 'Table.TableStatus' \
                            --output text \
                            2>/dev/null || true)

                        if [ -n "${TABLE_STATUS}" ] &&
                           [ "${TABLE_STATUS}" != "None" ]; then

                            echo "DynamoDB table exists."

                            aws dynamodb delete-table \
                                --region "${AWS_DEFAULT_REGION}" \
                                --table-name "${TF_LOCK_TABLE}" \
                                > /dev/null

                            echo "Waiting for DynamoDB table deletion..."

                            aws dynamodb wait table-not-exists \
                                --region "${AWS_DEFAULT_REGION}" \
                                --table-name "${TF_LOCK_TABLE}" \
                                2>/dev/null || true

                            echo "DynamoDB table deleted."

                        else

                            echo "DynamoDB table does not exist."

                        fi


                        echo ""
                        echo "================================================"
                        echo "EMPTY TERRAFORM S3 BUCKET"
                        echo "================================================"

                        BUCKET_EXISTS="false"

                        if aws s3api head-bucket \
                            --bucket "${TF_STATE_BUCKET}" \
                            2>/dev/null
                        then

                            BUCKET_EXISTS="true"

                            echo "S3 bucket exists:"
                            echo "${TF_STATE_BUCKET}"

                        else

                            echo "S3 bucket does not exist."

                        fi


                        if [ "${BUCKET_EXISTS}" = "true" ]; then

                            echo ""
                            echo "Deleting current S3 objects..."

                            aws s3 rm \
                                "s3://${TF_STATE_BUCKET}" \
                                --recursive \
                                2>/dev/null || true


                            echo ""
                            echo "Deleting ALL versioned objects and delete markers..."

                            while true
                            do

                                VERSION_DATA=$(aws s3api list-object-versions \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --bucket "${TF_STATE_BUCKET}" \
                                    --output json \
                                    2>/dev/null || echo '{}')

                                echo "${VERSION_DATA}" > /tmp/s3-versions.json


                                python3 - <<'PY'
import json

with open("/tmp/s3-versions.json", "r") as f:
    data = json.load(f)

objects = []

for item in data.get("Versions", []):
    objects.append({
        "Key": item["Key"],
        "VersionId": item["VersionId"]
    })

for item in data.get("DeleteMarkers", []):
    objects.append({
        "Key": item["Key"],
        "VersionId": item["VersionId"]
    })

with open("/tmp/delete-objects.json", "w") as f:
    json.dump({"Objects": objects}, f)

print(len(objects))
PY


                                OBJECT_COUNT=$(python3 - <<'PY'
import json

with open("/tmp/delete-objects.json", "r") as f:
    data = json.load(f)

print(len(data.get("Objects", [])))
PY
)

                                echo "Versioned objects found: ${OBJECT_COUNT}"


                                if [ "${OBJECT_COUNT}" = "0" ]; then

                                    break

                                fi


                                aws s3api delete-objects \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --bucket "${TF_STATE_BUCKET}" \
                                    --delete file:///tmp/delete-objects.json \
                                    > /dev/null


                            done


                            echo ""
                            echo "Deleting remaining current objects..."

                            aws s3 rm \
                                "s3://${TF_STATE_BUCKET}" \
                                --recursive \
                                2>/dev/null || true


                            echo ""
                            echo "================================================"
                            echo "DELETE TERRAFORM S3 BUCKET"
                            echo "================================================"

                            aws s3api delete-bucket \
                                --region "${AWS_DEFAULT_REGION}" \
                                --bucket "${TF_STATE_BUCKET}"

                            echo ""
                            echo "Terraform S3 state bucket deleted."

                        fi
                    '''
                }
            }
        }


        // ============================================================
        // 16. FINAL VERIFICATION
        // ============================================================

        stage('16 - Final Resource Verification') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set +e

                        echo ""
                        echo "================================================"
                        echo "FINAL RESOURCE VERIFICATION"
                        echo "================================================"


                        echo ""
                        echo "1. ECS SERVICE"

                        SERVICE=$(aws ecs describe-services \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}" \
                            --query 'services[0].status' \
                            --output text \
                            2>/dev/null)

                        echo "Status: ${SERVICE}"


                        echo ""
                        echo "2. ECS CLUSTER"

                        CLUSTER=$(aws ecs describe-clusters \
                            --region "${AWS_DEFAULT_REGION}" \
                            --clusters "${ECS_CLUSTER}" \
                            --query 'clusters[0].status' \
                            --output text \
                            2>/dev/null)

                        echo "Status: ${CLUSTER}"


                        echo ""
                        echo "3. ECR REPOSITORY"

                        aws ecr describe-repositories \
                            --region "${AWS_DEFAULT_REGION}" \
                            --repository-names "${ECR_REPOSITORY}" \
                            > /dev/null 2>&1

                        if [ "$?" -eq 0 ]; then
                            echo "WARNING: ECR repository still exists."
                        else
                            echo "ECR repository: DELETED"
                        fi


                        echo ""
                        echo "4. ALB"

                        ALB=$(aws elbv2 describe-load-balancers \
                            --region "${AWS_DEFAULT_REGION}" \
                            --names "${ALB_NAME}" \
                            --query 'LoadBalancers[0].State.Code' \
                            --output text \
                            2>/dev/null)

                        if [ -z "${ALB}" ] ||
                           [ "${ALB}" = "None" ]; then

                            echo "ALB: DELETED"

                        else

                            echo "WARNING: ALB still exists: ${ALB}"

                        fi


                        echo ""
                        echo "5. TARGET GROUP"

                        TG=$(aws elbv2 describe-target-groups \
                            --region "${AWS_DEFAULT_REGION}" \
                            --names "${TARGET_GROUP_NAME}" \
                            --query 'TargetGroups[0].TargetGroupArn' \
                            --output text \
                            2>/dev/null)

                        if [ -z "${TG}" ] ||
                           [ "${TG}" = "None" ]; then

                            echo "Target group: DELETED"

                        else

                            echo "WARNING: Target group still exists."

                        fi


                        echo ""
                        echo "6. CLOUDWATCH LOG GROUP"

                        LOG_GROUP="/ecs/${ECS_TASK_FAMILY}"

                        LOG=$(aws logs describe-log-groups \
                            --region "${AWS_DEFAULT_REGION}" \
                            --log-group-name-prefix "${LOG_GROUP}" \
                            --query "logGroups[?logGroupName=='${LOG_GROUP}'].logGroupName" \
                            --output text \
                            2>/dev/null)

                        if [ -z "${LOG}" ]; then

                            echo "CloudWatch log group: DELETED"

                        else

                            echo "WARNING: CloudWatch log group still exists."

                        fi


                        echo ""
                        echo "7. TERRAFORM BACKEND"

                        if [ "${DELETE_TERRAFORM_BACKEND}" = "true" ]; then

                            if aws s3api head-bucket \
                                --bucket "${TF_STATE_BUCKET}" \
                                2>/dev/null
                            then

                                echo "WARNING: Terraform S3 bucket still exists."

                            else

                                echo "Terraform S3 bucket: DELETED"

                            fi


                            aws dynamodb describe-table \
                                --region "${AWS_DEFAULT_REGION}" \
                                --table-name "${TF_LOCK_TABLE}" \
                                > /dev/null 2>&1

                            if [ "$?" -eq 0 ]; then

                                echo "WARNING: Terraform DynamoDB table still exists."

                            else

                                echo "Terraform DynamoDB table: DELETED"

                            fi

                        else

                            echo "Terraform backend deletion was disabled."

                        fi


                        echo ""
                        echo "================================================"
                        echo "DESTROY VERIFICATION COMPLETE"
                        echo "================================================"
                    '''
                }
            }
        }
    }


    // ================================================================
    // POST ACTIONS
    // ================================================================

    post {

        success {

            echo ''
            echo '================================================'
            echo '       COMPLETE DESTROY SUCCESS'
            echo '================================================'

            echo ''
            echo "Environment          : ${env.ENVIRONMENT}"
            echo "ECS Cluster          : ${env.ECS_CLUSTER}"
            echo "ECS Service          : ${env.ECS_SERVICE}"
            echo "ECR Repository       : ${env.ECR_REPOSITORY}"
            echo "ALB                  : ${env.ALB_NAME}"
            echo "Target Group         : ${env.TARGET_GROUP_NAME}"
            echo "Terraform State      : ${env.TF_STATE_BUCKET}"
            echo "Terraform Lock Table : ${env.TF_LOCK_TABLE}"

            echo ''
            echo '================================================'
            echo '       DESTROY PIPELINE COMPLETED'
            echo '================================================'
        }


        failure {

            echo ''
            echo '================================================'
            echo '       DESTROY PIPELINE FAILED'
            echo '================================================'

            echo ''
            echo 'Check the Jenkins console output.'
            echo ''
            echo 'The ECS DRAINING state is handled as non-fatal.'
            echo 'Remaining ECS tasks are explicitly stopped.'
            echo ''
            echo '================================================'
        }


        always {

            echo ''
            echo '================================================'
            echo '       CLEANING JENKINS WORKSPACE'
            echo '================================================'

            cleanWs(
                deleteDirs: true,
                disableDeferredWipeout: true
            )
        }
    }
}
