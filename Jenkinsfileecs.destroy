pipeline {

    agent any

    options {
        timestamps()
        ansiColor('xterm')
        disableConcurrentBuilds()

        buildDiscarder(logRotator(
            daysToKeepStr: '30',
            numToKeepStr: '50'
        ))

        timeout(
            time: 90,
            unit: 'MINUTES'
        )
    }

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: [
                'dev',
                'qa',
                'prod'
            ],
            description: 'Select Terraform Environment to destroy'
        )

        booleanParam(
            name: 'CONFIRM_DESTROY',
            defaultValue: false,
            description: 'MUST be checked to allow complete infrastructure destruction'
        )
    }

    environment {

        //==========================================================
        // AWS
        //==========================================================

        AWS_REGION = "us-east-1"

        AWS_ACCOUNT_ID = "103282536465"

        AWS_CREDENTIALS = "aws-creds"


        //==========================================================
        // GitHub
        //==========================================================

        GITHUB_CREDENTIALS = "github-creds"

        TERRAFORM_REPO =
            "https://github.com/FAIZANSHEIKH223/terraform-aws-infra.git"

        TERRAFORM_BRANCH = "main"


        //==========================================================
        // Terraform
        //==========================================================

        TF_DIR = "terraform-aws-infra"

        BACKEND_CONFIG = "backend-${params.ENVIRONMENT}.conf"

        TF_VARS =
            "environments/${params.ENVIRONMENT}/terraform.tfvars"


        //==========================================================
        // Terraform Backend
        //==========================================================

        TF_STATE_BUCKET = "terraform-state-faizan-001"

        TF_LOCK_TABLE = "terraform-locks"


        //==========================================================
        // ECR
        //==========================================================

        IMAGE_NAME = "terraform-demo-dev"


        //==========================================================
        // ECS
        //==========================================================

        ECS_CLUSTER_NAME = "terraform-demo-dev-cluster"

        ECS_TASK_FAMILY = "terraform-demo-task"

        ECS_SERVICE_NAME = "terraform-demo-service"
    }


    stages {


        //==========================================================
        // DESTROY CONFIRMATION
        //==========================================================

        stage('Destroy Confirmation') {

            steps {

                script {

                    if (!params.CONFIRM_DESTROY) {

                        error(
                            "DESTROY BLOCKED: You must set CONFIRM_DESTROY=true."
                        )
                    }

                    echo ""
                    echo "======================================================"
                    echo "        TERRAFORM COMPLETE DESTROY"
                    echo "======================================================"
                    echo ""
                    echo "Environment : ${params.ENVIRONMENT}"
                    echo "AWS Region  : ${AWS_REGION}"
                    echo ""
                    echo "This pipeline will attempt to remove:"
                    echo ""
                    echo "  - ECS services"
                    echo "  - ECS tasks"
                    echo "  - ECS cluster"
                    echo "  - Load balancers"
                    echo "  - Target groups"
                    echo "  - EC2 resources managed by Terraform"
                    echo "  - Security groups managed by Terraform"
                    echo "  - VPC resources managed by Terraform"
                    echo "  - ECR repository/images"
                    echo ""
                    echo "  - S3 bucket: ${TF_STATE_BUCKET}"
                    echo "  - DynamoDB table: ${TF_LOCK_TABLE}"
                    echo ""
                    echo "======================================================"
                }
            }
        }


        //==========================================================
        // CHECK AWS CONNECTION
        //==========================================================

        stage('Check AWS Connection') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -e

                        echo "Checking AWS credentials..."

                        aws sts get-caller-identity

                        echo ""
                        echo "AWS Region:"
                        echo "${AWS_REGION}"

                        echo ""
                        echo "AWS connection successful."
                    '''
                }
            }
        }


        //==========================================================
        // CHECK TERRAFORM
        //==========================================================

        stage('Check Terraform') {

            steps {

                sh '''
                    set -e

                    echo "Checking Terraform..."

                    terraform version

                    echo "Terraform is available."
                '''
            }
        }


        //==========================================================
        // CHECKOUT TERRAFORM REPOSITORY
        //==========================================================

        stage('Checkout Terraform Repository') {

            steps {

                dir("${TF_DIR}") {

                    git(
                        branch: "${TERRAFORM_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${TERRAFORM_REPO}"
                    )
                }
            }
        }


        //==========================================================
        // TERRAFORM FORMAT CHECK
        //==========================================================

        stage('Terraform Format Check') {

            steps {

                dir("${TF_DIR}") {

                    sh '''
                        set -e

                        terraform fmt -check -recursive

                        echo "Terraform formatting check passed."
                    '''
                }
            }
        }


        //==========================================================
        // TERRAFORM INIT
        //==========================================================

        stage('Terraform Init') {

            steps {

                dir("${TF_DIR}") {

                    withCredentials([
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${AWS_CREDENTIALS}"
                        ]
                    ]) {

                        sh '''
                            set -e

                            echo "Initializing Terraform..."

                            terraform init \
                                -reconfigure \
                                -backend-config="${BACKEND_CONFIG}"

                            echo "Terraform initialization completed."
                        '''
                    }
                }
            }
        }


        //==========================================================
        // TERRAFORM VALIDATE
        //==========================================================

        stage('Terraform Validate') {

            steps {

                dir("${TF_DIR}") {

                    sh '''
                        set -e

                        terraform validate

                        echo "Terraform validation passed."
                    '''
                }
            }
        }


        //==========================================================
        // CHECK CURRENT TERRAFORM STATE
        //==========================================================

        stage('Terraform State Check') {

            steps {

                dir("${TF_DIR}") {

                    withCredentials([
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${AWS_CREDENTIALS}"
                        ]
                    ]) {

                        sh '''
                            set +e

                            echo ""
                            echo "======================================================"
                            echo "Current Terraform Resources"
                            echo "======================================================"

                            terraform state list

                            echo ""
                            echo "======================================================"

                            set -e
                        '''
                    }
                }
            }
        }


        //==========================================================
        // CLEAN ECR IMAGES
        //==========================================================

        stage('Clean ECR Images') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set +e

                        echo ""
                        echo "======================================================"
                        echo "Cleaning ECR Images"
                        echo "======================================================"

                        REPOSITORY="${IMAGE_NAME}"

                        if aws ecr describe-repositories \
                            --repository-names "$REPOSITORY" \
                            --region "$AWS_REGION" \
                            >/dev/null 2>&1; then

                            echo "ECR repository exists."

                            IMAGE_IDS=$(aws ecr list-images \
                                --repository-name "$REPOSITORY" \
                                --region "$AWS_REGION" \
                                --query 'imageIds[*]' \
                                --output json)

                            if [ "$IMAGE_IDS" != "[]" ] && \
                               [ "$IMAGE_IDS" != "null" ]; then

                                echo "Deleting all ECR images..."

                                aws ecr batch-delete-image \
                                    --repository-name "$REPOSITORY" \
                                    --image-ids "$IMAGE_IDS" \
                                    --region "$AWS_REGION"

                            else

                                echo "No ECR images found."

                            fi

                        else

                            echo "ECR repository does not exist."

                        fi

                        set -e
                    '''
                }
            }
        }


        //==========================================================
        // STOP ECS SERVICE
        //==========================================================

        stage('Stop ECS Service') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set +e

                        echo ""
                        echo "======================================================"
                        echo "Stopping ECS Service"
                        echo "======================================================"

                        SERVICE_EXISTS=$(aws ecs describe-services \
                            --cluster "$ECS_CLUSTER_NAME" \
                            --services "$ECS_SERVICE_NAME" \
                            --region "$AWS_REGION" \
                            --query 'services[0].serviceName' \
                            --output text 2>/dev/null)

                        if [ "$SERVICE_EXISTS" = "$ECS_SERVICE_NAME" ]; then

                            echo "ECS service exists."

                            aws ecs update-service \
                                --cluster "$ECS_CLUSTER_NAME" \
                                --service "$ECS_SERVICE_NAME" \
                                --desired-count 0 \
                                --region "$AWS_REGION"

                            echo "Waiting for ECS tasks to stop..."

                            sleep 30

                        else

                            echo "ECS service does not exist."

                        fi

                        set -e
                    '''
                }
            }
        }


        //==========================================================
        // TERRAFORM DESTROY
        //==========================================================

        stage('Terraform Destroy') {

            steps {

                dir("${TF_DIR}") {

                    withCredentials([
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${AWS_CREDENTIALS}"
                        ]
                    ]) {

                        sh '''
                            set -e

                            echo ""
                            echo "======================================================"
                            echo "        TERRAFORM DESTROY STARTING"
                            echo "======================================================"

                            terraform destroy \
                                -var-file="${TF_VARS}" \
                                -auto-approve

                            echo ""
                            echo "======================================================"
                            echo "        TERRAFORM DESTROY COMPLETED"
                            echo "======================================================"
                        '''
                    }
                }
            }
        }


        //==========================================================
        // REMOVE REMAINING ECS SERVICE
        //==========================================================

        stage('Remove Remaining ECS Service') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set +e

                        echo ""
                        echo "======================================================"
                        echo "Removing Remaining ECS Service"
                        echo "======================================================"

                        SERVICE_EXISTS=$(aws ecs describe-services \
                            --cluster "$ECS_CLUSTER_NAME" \
                            --services "$ECS_SERVICE_NAME" \
                            --region "$AWS_REGION" \
                            --query 'services[0].serviceName' \
                            --output text 2>/dev/null)

                        if [ "$SERVICE_EXISTS" = "$ECS_SERVICE_NAME" ]; then

                            echo "Deleting ECS service..."

                            aws ecs update-service \
                                --cluster "$ECS_CLUSTER_NAME" \
                                --service "$ECS_SERVICE_NAME" \
                                --desired-count 0 \
                                --region "$AWS_REGION" \
                                >/dev/null 2>&1

                            sleep 10

                            aws ecs delete-service \
                                --cluster "$ECS_CLUSTER_NAME" \
                                --service "$ECS_SERVICE_NAME" \
                                --force \
                                --region "$AWS_REGION" \
                                >/dev/null 2>&1

                            echo "ECS service deleted."

                        else

                            echo "No remaining ECS service."

                        fi

                        set -e
                    '''
                }
            }
        }


        //==========================================================
        // STOP REMAINING ECS TASKS
        //==========================================================

        stage('Stop Remaining ECS Tasks') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set +e

                        echo ""
                        echo "======================================================"
                        echo "Stopping Remaining ECS Tasks"
                        echo "======================================================"

                        TASKS=$(aws ecs list-tasks \
                            --cluster "$ECS_CLUSTER_NAME" \
                            --region "$AWS_REGION" \
                            --query 'taskArns[*]' \
                            --output text 2>/dev/null)

                        if [ -n "$TASKS" ] && [ "$TASKS" != "None" ]; then

                            for TASK in $TASKS
                            do

                                echo "Stopping task: $TASK"

                                aws ecs stop-task \
                                    --cluster "$ECS_CLUSTER_NAME" \
                                    --task "$TASK" \
                                    --reason "Jenkins complete destroy" \
                                    --region "$AWS_REGION" \
                                    >/dev/null 2>&1

                            done

                        else

                            echo "No running ECS tasks."

                        fi

                        set -e
                    '''
                }
            }
        }


        //==========================================================
        // DELETE REMAINING ECS CLUSTER
        //==========================================================

        stage('Remove Remaining ECS Cluster') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set +e

                        echo ""
                        echo "======================================================"
                        echo "Removing Remaining ECS Cluster"
                        echo "======================================================"

                        CLUSTER_STATUS=$(aws ecs describe-clusters \
                            --clusters "$ECS_CLUSTER_NAME" \
                            --region "$AWS_REGION" \
                            --query 'clusters[0].status' \
                            --output text 2>/dev/null)

                        if [ "$CLUSTER_STATUS" = "ACTIVE" ]; then

                            echo "Deleting ECS cluster..."

                            aws ecs delete-cluster \
                                --cluster "$ECS_CLUSTER_NAME" \
                                --region "$AWS_REGION"

                            echo "ECS cluster deleted."

                        else

                            echo "No active ECS cluster."

                        fi

                        set -e
                    '''
                }
            }
        }


        //==========================================================
        // DELETE ECR REPOSITORY
        //==========================================================

        stage('Remove ECR Repository') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set +e

                        echo ""
                        echo "======================================================"
                        echo "Removing ECR Repository"
                        echo "======================================================"

                        if aws ecr describe-repositories \
                            --repository-names "$IMAGE_NAME" \
                            --region "$AWS_REGION" \
                            >/dev/null 2>&1; then

                            echo "Deleting ECR repository..."

                            aws ecr delete-repository \
                                --repository-name "$IMAGE_NAME" \
                                --force \
                                --region "$AWS_REGION"

                            echo "ECR repository deleted."

                        else

                            echo "ECR repository does not exist."

                        fi

                        set -e
                    '''
                }
            }
        }


        //==========================================================
        // DELETE S3 TERRAFORM STATE BUCKET
        //
        // Bucket:
        // terraform-state-faizan-001
        //
        // This handles:
        // - normal objects
        // - versioned objects
        // - delete markers
        //==========================================================

        stage('Delete Terraform State S3 Bucket') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set +e

                        echo ""
                        echo "======================================================"
                        echo "DELETE TERRAFORM STATE S3 BUCKET"
                        echo "======================================================"

                        BUCKET="$TF_STATE_BUCKET"

                        echo "Bucket: $BUCKET"
                        echo "Region: $AWS_REGION"

                        if aws s3api head-bucket \
                            --bucket "$BUCKET" \
                            >/dev/null 2>&1; then

                            echo ""
                            echo "S3 bucket exists."

                            echo ""
                            echo "Deleting current objects..."

                            aws s3 rm \
                                "s3://$BUCKET" \
                                --recursive \
                                --region "$AWS_REGION"

                            echo ""
                            echo "Deleting all object versions and delete markers..."

                            while true
                            do

                                VERSION_DATA=$(aws s3api list-object-versions \
                                    --bucket "$BUCKET" \
                                    --region "$AWS_REGION" \
                                    --output json)

                                python3 - "$VERSION_DATA" <<'PY'
import json
import subprocess
import sys

bucket = "terraform-state-faizan-001"

data = json.loads(sys.argv[1])

objects = []

for item in data.get("Versions", []):
    objects.append({
        "Key": item["Key"],
        "VersionId": item["VersionId"]
    })

for item in data.get("DeleteMarkers", []):
    objects.append({
        "Key": item["Key"],
        "VersionId": item["VersionId"]
    })

for obj in objects:

    subprocess.run(
        [
            "aws",
            "s3api",
            "delete-object",
            "--bucket",
            bucket,
            "--key",
            obj["Key"],
            "--version-id",
            obj["VersionId"],
            "--region",
            "us-east-1"
        ],
        check=False
    )

print(f"Deleted {len(objects)} object versions/delete markers.")
PY

                                REMAINING=$(aws s3api list-object-versions \
                                    --bucket "$BUCKET" \
                                    --region "$AWS_REGION" \
                                    --query '[Versions,DeleteMarkers] | flatten(@) | length(@)' \
                                    --output text)

                                if [ "$REMAINING" = "0" ] || [ "$REMAINING" = "None" ]; then
                                    break
                                fi

                            done

                            echo ""
                            echo "Deleting S3 bucket..."

                            aws s3api delete-bucket \
                                --bucket "$BUCKET" \
                                --region "$AWS_REGION"

                            echo ""
                            echo "S3 Terraform state bucket deleted successfully."

                        else

                            echo ""
                            echo "S3 Terraform state bucket does not exist."

                        fi

                        set -e
                    '''
                }
            }
        }


        //==========================================================
        // DELETE DYNAMODB TERRAFORM LOCK TABLE
        //
        // Table:
        // terraform-locks
        //==========================================================

        stage('Delete Terraform DynamoDB Lock Table') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set +e

                        echo ""
                        echo "======================================================"
                        echo "DELETE TERRAFORM DYNAMODB LOCK TABLE"
                        echo "======================================================"

                        TABLE="$TF_LOCK_TABLE"

                        echo "Table: $TABLE"
                        echo "Region: $AWS_REGION"

                        if aws dynamodb describe-table \
                            --table-name "$TABLE" \
                            --region "$AWS_REGION" \
                            >/dev/null 2>&1; then

                            echo ""
                            echo "DynamoDB table exists."

                            echo ""
                            echo "Deleting DynamoDB table..."

                            aws dynamodb delete-table \
                                --table-name "$TABLE" \
                                --region "$AWS_REGION"

                            echo ""
                            echo "Waiting for DynamoDB table deletion..."

                            aws dynamodb wait table-not-exists \
                                --table-name "$TABLE" \
                                --region "$AWS_REGION"

                            echo ""
                            echo "DynamoDB lock table deleted successfully."

                        else

                            echo ""
                            echo "DynamoDB lock table does not exist."

                        fi

                        set -e
                    '''
                }
            }
        }


        //==========================================================
        // FINAL AWS CLEANUP VERIFICATION
        //==========================================================

        stage('Final AWS Cleanup Verification') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set +e

                        echo ""
                        echo "======================================================"
                        echo "FINAL AWS CLEANUP VERIFICATION"
                        echo "======================================================"


                        //==================================================
                        // ECS SERVICE
                        //==================================================

                        echo ""
                        echo "----- ECS SERVICE -----"

                        SERVICE_CHECK=$(aws ecs describe-services \
                            --cluster "$ECS_CLUSTER_NAME" \
                            --services "$ECS_SERVICE_NAME" \
                            --region "$AWS_REGION" \
                            --query 'services[0].serviceName' \
                            --output text 2>/dev/null)

                        if [ "$SERVICE_CHECK" = "$ECS_SERVICE_NAME" ]; then
                            echo "WARNING: ECS service still exists."
                        else
                            echo "OK: ECS service does not exist."
                        fi


                        //==================================================
                        // ECS TASKS
                        //==================================================

                        echo ""
                        echo "----- ECS TASKS -----"

                        TASK_COUNT=$(aws ecs list-tasks \
                            --cluster "$ECS_CLUSTER_NAME" \
                            --region "$AWS_REGION" \
                            --query 'length(taskArns)' \
                            --output text 2>/dev/null)

                        if [ "$TASK_COUNT" = "0" ] || [ "$TASK_COUNT" = "None" ]; then
                            echo "OK: No ECS tasks."
                        else
                            echo "WARNING: ECS tasks still exist: $TASK_COUNT"
                        fi


                        //==================================================
                        // ECS CLUSTER
                        //==================================================

                        echo ""
                        echo "----- ECS CLUSTER -----"

                        CLUSTER_CHECK=$(aws ecs describe-clusters \
                            --clusters "$ECS_CLUSTER_NAME" \
                            --region "$AWS_REGION" \
                            --query 'clusters[0].clusterName' \
                            --output text 2>/dev/null)

                        if [ "$CLUSTER_CHECK" = "$ECS_CLUSTER_NAME" ]; then
                            echo "WARNING: ECS cluster still exists."
                        else
                            echo "OK: ECS cluster does not exist."
                        fi


                        //==================================================
                        // ECR
                        //==================================================

                        echo ""
                        echo "----- ECR REPOSITORY -----"

                        ECR_CHECK=$(aws ecr describe-repositories \
                            --repository-names "$IMAGE_NAME" \
                            --region "$AWS_REGION" \
                            --query 'repositories[0].repositoryName' \
                            --output text 2>/dev/null)

                        if [ "$ECR_CHECK" = "$IMAGE_NAME" ]; then
                            echo "WARNING: ECR repository still exists."
                        else
                            echo "OK: ECR repository does not exist."
                        fi


                        //==================================================
                        // S3 STATE BUCKET
                        //==================================================

                        echo ""
                        echo "----- S3 TERRAFORM STATE BUCKET -----"

                        if aws s3api head-bucket \
                            --bucket "$TF_STATE_BUCKET" \
                            >/dev/null 2>&1; then

                            echo "WARNING: S3 bucket still exists."

                        else

                            echo "OK: S3 Terraform state bucket deleted."

                        fi


                        //==================================================
                        // DYNAMODB LOCK TABLE
                        //==================================================

                        echo ""
                        echo "----- DYNAMODB TERRAFORM LOCK TABLE -----"

                        if aws dynamodb describe-table \
                            --table-name "$TF_LOCK_TABLE" \
                            --region "$AWS_REGION" \
                            >/dev/null 2>&1; then

                            echo "WARNING: DynamoDB table still exists."

                        else

                            echo "OK: DynamoDB lock table deleted."

                        fi


                        echo ""
                        echo "======================================================"
                        echo "FINAL CLEANUP VERIFICATION COMPLETED"
                        echo "======================================================"

                        set -e
                    '''
                }
            }
        }


        //==========================================================
        // DESTROY COMPLETE
        //==========================================================

        stage('Destroy Successful') {

            steps {

                echo ""
                echo "=========================================================="
                echo "       COMPLETE AWS ENVIRONMENT DESTROYED"
                echo "=========================================================="
                echo ""
                echo "Environment : ${ENVIRONMENT}"
                echo "Region      : ${AWS_REGION}"
                echo ""
                echo "Terraform infrastructure was destroyed."
                echo "ECS resources were cleaned."
                echo "ECR resources were cleaned."
                echo "Terraform state bucket was removed."
                echo "DynamoDB lock table was removed."
                echo ""
                echo "=========================================================="
            }
        }
    }


    //==============================================================
    // POST ACTIONS
    //==============================================================

    post {

        always {

            echo ""
            echo "Cleaning Jenkins workspace..."

            cleanWs()
        }

        success {

            echo ""
            echo "=============================================="
            echo " COMPLETE DESTROY PIPELINE SUCCESSFUL"
            echo "=============================================="
        }

        failure {

            echo ""
            echo "=============================================="
            echo " DESTROY PIPELINE FAILED"
            echo "=============================================="
            echo ""
            echo "Check the Jenkins console output."
            echo "Some AWS resources may require manual inspection."
            echo ""
        }

        unstable {

            echo ""
            echo "=============================================="
            echo " DESTROY PIPELINE UNSTABLE"
            echo "=============================================="
        }
    }
}
