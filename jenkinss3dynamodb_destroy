pipeline {

    agent any

    // ================================================================
    // PIPELINE OPTIONS
    // ================================================================

    options {

        timestamps()

        ansiColor('xterm')

        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                daysToKeepStr: '30',
                numToKeepStr: '50'
            )
        )

        timeout(
            time: 60,
            unit: 'MINUTES'
        )
    }

    // ================================================================
    // PARAMETERS
    // ================================================================

    parameters {

        booleanParam(
            name: 'CONFIRM_DELETE',
            defaultValue: false,
            description: 'MUST be true. This permanently deletes the Terraform S3 backend bucket and DynamoDB lock table.'
        )

        string(
            name: 'AWS_REGION',
            defaultValue: 'us-east-1',
            description: 'AWS region containing the Terraform backend.'
        )

        string(
            name: 'S3_BACKEND_BUCKET',
            defaultValue: 'terraform-state-faizan-001',
            description: 'Terraform S3 backend bucket to permanently delete.'
        )

        string(
            name: 'DYNAMODB_LOCK_TABLE',
            defaultValue: 'terraform-locks',
            description: 'Terraform DynamoDB lock table to permanently delete.'
        )
    }

    // ================================================================
    // ENVIRONMENT
    // ================================================================

    environment {

        AWS_DEFAULT_REGION = "${params.AWS_REGION}"

        AWS_PAGER = ""

        S3_BUCKET = "${params.S3_BACKEND_BUCKET}"

        DDB_TABLE = "${params.DYNAMODB_LOCK_TABLE}"
    }

    // ================================================================
    // STAGES
    // ================================================================

    stages {

        // ============================================================
        // 01 - START
        // ============================================================

        stage('01 - Start Backend Cleanup') {

            steps {

                echo ''
                echo '================================================'
                echo '       TERRAFORM BACKEND CLEANUP PIPELINE'
                echo '================================================'
                echo ''
                echo "AWS Region          : ${params.AWS_REGION}"
                echo "S3 Backend Bucket   : ${params.S3_BACKEND_BUCKET}"
                echo "DynamoDB Lock Table : ${params.DYNAMODB_LOCK_TABLE}"
                echo "Delete Confirmation : ${params.CONFIRM_DELETE}"
                echo ''
                echo 'THIS PIPELINE WILL ONLY DELETE:'
                echo ''
                echo '1. S3 object versions'
                echo '2. S3 delete markers'
                echo '3. Complete Terraform S3 backend bucket'
                echo '4. Terraform DynamoDB lock table'
                echo ''
                echo 'THIS PIPELINE WILL NOT DELETE:'
                echo ''
                echo 'EC2 resources'
                echo 'ECS resources'
                echo 'ALB resources'
                echo 'VPC resources'
                echo 'Security Groups'
                echo 'Application resources'
                echo ''
                echo '================================================'
                echo ''
            }
        }

        // ============================================================
        // 02 - CONFIRM DESTRUCTIVE OPERATION
        // ============================================================

        stage('02 - Confirm Destructive Operation') {

            steps {

                script {

                    if (!params.CONFIRM_DELETE) {

                        error(
                            'DELETION NOT CONFIRMED. Set CONFIRM_DELETE=true before running this pipeline.'
                        )
                    }

                    echo ''
                    echo '================================================'
                    echo '           DELETION CONFIRMED'
                    echo '================================================'
                    echo ''
                    echo 'The following resources will be permanently deleted:'
                    echo ''
                    echo "S3 Bucket   : ${params.S3_BACKEND_BUCKET}"
                    echo "DynamoDB    : ${params.DYNAMODB_LOCK_TABLE}"
                    echo "AWS Region  : ${params.AWS_REGION}"
                    echo ''
                    echo 'Terraform infrastructure will NOT be destroyed.'
                    echo 'Only the Terraform backend will be removed.'
                    echo ''
                    echo '================================================'
                    echo ''
                }
            }
        }

        // ============================================================
        // 03 - CHECK REQUIRED TOOLS
        // ============================================================

        stage('03 - Check Required Tools') {

            steps {

                sh '''
                    set -eu

                    echo "================================================"
                    echo "CHECKING REQUIRED TOOLS"
                    echo "================================================"

                    echo ""
                    echo "Checking AWS CLI..."
                    command -v aws

                    echo ""
                    echo "Checking jq..."
                    command -v jq

                    echo ""
                    echo "AWS CLI version:"
                    aws --version

                    echo ""
                    echo "jq version:"
                    jq --version

                    echo ""
                    echo "All required tools are available."

                    echo "================================================"
                '''
            }
        }

        // ============================================================
        // 04 - AWS AUTHENTICATION
        // ============================================================

        stage('04 - Verify AWS Authentication') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds']
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "VERIFYING AWS AUTHENTICATION"
                        echo "================================================"

                        echo ""
                        echo "AWS Caller Identity:"
                        aws sts get-caller-identity

                        echo ""
                        echo "AWS Region:"
                        echo "$AWS_DEFAULT_REGION"

                        echo ""
                        echo "AWS authentication successful."

                        echo "================================================"
                    '''
                }
            }
        }

        // ============================================================
        // 05 - CHECK S3 BACKEND
        // ============================================================

        stage('05 - Check S3 Backend Bucket') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds']
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "CHECKING S3 BACKEND BUCKET"
                        echo "================================================"

                        echo ""
                        echo "Bucket:"
                        echo "$S3_BUCKET"

                        if aws s3api head-bucket \
                            --bucket "$S3_BUCKET" \
                            --region "$AWS_DEFAULT_REGION" \
                            >/dev/null 2>&1
                        then

                            echo ""
                            echo "S3 bucket EXISTS."

                        else

                            echo ""
                            echo "S3 bucket does NOT exist."
                            echo "S3 cleanup will be skipped."

                        fi

                        echo "================================================"
                    '''
                }
            }
        }

        // ============================================================
        // 06 - CHECK DYNAMODB
        // ============================================================

        stage('06 - Check DynamoDB Lock Table') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds']
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "CHECKING DYNAMODB LOCK TABLE"
                        echo "================================================"

                        echo ""
                        echo "Table:"
                        echo "$DDB_TABLE"

                        if aws dynamodb describe-table \
                            --table-name "$DDB_TABLE" \
                            --region "$AWS_DEFAULT_REGION" \
                            >/dev/null 2>&1
                        then

                            echo ""
                            echo "DynamoDB table EXISTS."

                            echo ""
                            echo "Table status:"
                            aws dynamodb describe-table \
                                --table-name "$DDB_TABLE" \
                                --region "$AWS_DEFAULT_REGION" \
                                --query 'Table.TableStatus' \
                                --output text

                        else

                            echo ""
                            echo "DynamoDB table does NOT exist."
                            echo "DynamoDB cleanup will be skipped."

                        fi

                        echo "================================================"
                    '''
                }
            }
        }

        // ============================================================
        // 07 - DELETE ALL S3 VERSIONS AND DELETE MARKERS
        // ============================================================

        stage('07 - Delete All S3 Object Versions') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds']
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "DELETING ALL S3 OBJECT VERSIONS"
                        echo "================================================"

                        # ------------------------------------------------
                        # Check whether bucket exists
                        # ------------------------------------------------

                        if ! aws s3api head-bucket \
                            --bucket "$S3_BUCKET" \
                            --region "$AWS_DEFAULT_REGION" \
                            >/dev/null 2>&1
                        then

                            echo ""
                            echo "S3 bucket does not exist."
                            echo "Nothing to delete."
                            echo "Skipping S3 version cleanup."

                            exit 0
                        fi

                        # ------------------------------------------------
                        # Temporary working directory
                        # ------------------------------------------------

                        WORK_DIR="$(mktemp -d)"

                        cleanup() {
                            rm -rf "$WORK_DIR"
                        }

                        trap cleanup EXIT

                        VERSIONS_FILE="$WORK_DIR/versions.json"
                        DELETE_FILE="$WORK_DIR/delete.json"
                        BATCH_FILE="$WORK_DIR/batch.json"

                        BATCH_NUMBER=0
                        TOTAL_DELETED=0

                        echo ""
                        echo "Starting S3 version/delete-marker cleanup..."
                        echo ""

                        # ------------------------------------------------
                        # Keep listing and deleting until bucket is empty
                        #
                        # AWS CLI automatically handles API pagination.
                        # Only the first 1000 items are deleted per batch.
                        # ------------------------------------------------

                        while true; do

                            echo "Listing current S3 object versions and delete markers..."

                            aws s3api list-object-versions \
                                --bucket "$S3_BUCKET" \
                                --region "$AWS_DEFAULT_REGION" \
                                --output json \
                                > "$VERSIONS_FILE"

                            # --------------------------------------------
                            # Build deletion list
                            # --------------------------------------------

                            jq -c '
                                [
                                    (.Versions // [])[],
                                    (.DeleteMarkers // [])[]
                                ]
                                |
                                map({
                                    Key: .Key,
                                    VersionId: .VersionId
                                })
                            ' "$VERSIONS_FILE" > "$DELETE_FILE"

                            TOTAL_COUNT="$(
                                jq 'length' "$DELETE_FILE"
                            )"

                            echo ""
                            echo "Objects/versions currently found: $TOTAL_COUNT"

                            # --------------------------------------------
                            # Nothing left
                            # --------------------------------------------

                            if [ "$TOTAL_COUNT" -eq 0 ]; then

                                echo ""
                                echo "No S3 object versions remain."
                                echo "No S3 delete markers remain."
                                echo ""
                                echo "S3 version cleanup completed."

                                break
                            fi

                            # --------------------------------------------
                            # Create batch of maximum 1000 objects
                            # --------------------------------------------

                            BATCH_NUMBER=$((BATCH_NUMBER + 1))

                            jq '
                                .[0:1000]
                                |
                                {
                                    Objects: .,
                                    Quiet: true
                                }
                            ' "$DELETE_FILE" > "$BATCH_FILE"

                            BATCH_COUNT="$(
                                jq '.Objects | length' "$BATCH_FILE"
                            )"

                            echo ""
                            echo "Deleting S3 batch:"
                            echo "Batch number : $BATCH_NUMBER"
                            echo "Batch size   : $BATCH_COUNT"

                            # --------------------------------------------
                            # Delete batch
                            # --------------------------------------------

                            aws s3api delete-objects \
                                --bucket "$S3_BUCKET" \
                                --region "$AWS_DEFAULT_REGION" \
                                --delete "file://$BATCH_FILE"

                            TOTAL_DELETED=$((TOTAL_DELETED + BATCH_COUNT))

                            echo ""
                            echo "Batch deletion completed."
                            echo "Total items deleted so far: $TOTAL_DELETED"

                            # --------------------------------------------
                            # Continue loop.
                            #
                            # The bucket is re-listed so remaining pages
                            # are discovered automatically.
                            # --------------------------------------------

                        done

                        echo ""
                        echo "================================================"
                        echo "S3 VERSION CLEANUP COMPLETED"
                        echo "Total items deleted: $TOTAL_DELETED"
                        echo "================================================"
                    '''
                }
            }
        }

        // ============================================================
        // 08 - VERIFY S3 EMPTY
        // ============================================================

        stage('08 - Verify S3 Bucket Empty') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds']
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "VERIFYING S3 BUCKET IS EMPTY"
                        echo "================================================"

                        # ------------------------------------------------
                        # Check bucket
                        # ------------------------------------------------

                        if ! aws s3api head-bucket \
                            --bucket "$S3_BUCKET" \
                            --region "$AWS_DEFAULT_REGION" \
                            >/dev/null 2>&1
                        then

                            echo ""
                            echo "S3 bucket does not exist."
                            echo "Nothing remains to verify."

                            exit 0
                        fi

                        WORK_DIR="$(mktemp -d)"

                        cleanup() {
                            rm -rf "$WORK_DIR"
                        }

                        trap cleanup EXIT

                        CHECK_FILE="$WORK_DIR/check.json"

                        # ------------------------------------------------
                        # AWS CLI automatically handles pagination here
                        # ------------------------------------------------

                        aws s3api list-object-versions \
                            --bucket "$S3_BUCKET" \
                            --region "$AWS_DEFAULT_REGION" \
                            --output json \
                            > "$CHECK_FILE"

                        REMAINING="$(
                            jq '
                                ((.Versions // []) | length)
                                +
                                ((.DeleteMarkers // []) | length)
                            ' "$CHECK_FILE"
                        )"

                        echo ""
                        echo "Remaining S3 versions/delete markers:"
                        echo "$REMAINING"

                        if [ "$REMAINING" -ne 0 ]; then

                            echo ""
                            echo "ERROR: S3 bucket is NOT empty."
                            echo ""
                            echo "Remaining versions/delete markers:"

                            jq '
                                {
                                    Versions: (.Versions // []),
                                    DeleteMarkers: (.DeleteMarkers // [])
                                }
                            ' "$CHECK_FILE"

                            exit 1
                        fi

                        echo ""
                        echo "S3 bucket contains no object versions."
                        echo "S3 bucket contains no delete markers."
                        echo ""
                        echo "S3 bucket is completely empty."

                        echo "================================================"
                    '''
                }
            }
        }

        // ============================================================
        // 09 - DELETE S3 BUCKET
        // ============================================================

        stage('09 - Delete Complete S3 Backend Bucket') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds']
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "DELETING COMPLETE S3 BACKEND BUCKET"
                        echo "================================================"

                        # ------------------------------------------------
                        # Check bucket
                        # ------------------------------------------------

                        if ! aws s3api head-bucket \
                            --bucket "$S3_BUCKET" \
                            --region "$AWS_DEFAULT_REGION" \
                            >/dev/null 2>&1
                        then

                            echo ""
                            echo "S3 bucket does not exist."
                            echo "Nothing to delete."

                            exit 0
                        fi

                        echo ""
                        echo "Deleting bucket:"
                        echo "$S3_BUCKET"

                        aws s3api delete-bucket \
                            --bucket "$S3_BUCKET" \
                            --region "$AWS_DEFAULT_REGION"

                        echo ""
                        echo "S3 bucket deletion request completed."

                        echo "================================================"
                    '''
                }
            }
        }

        // ============================================================
        // 10 - VERIFY S3 DELETED
        // ============================================================

        stage('10 - Verify S3 Bucket Deleted') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds']
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "VERIFYING S3 BUCKET DELETION"
                        echo "================================================"

                        ATTEMPTS=0
                        MAX_ATTEMPTS=30

                        while [ "$ATTEMPTS" -lt "$MAX_ATTEMPTS" ]; do

                            ATTEMPTS=$((ATTEMPTS + 1))

                            if aws s3api head-bucket \
                                --bucket "$S3_BUCKET" \
                                --region "$AWS_DEFAULT_REGION" \
                                >/dev/null 2>&1
                            then

                                echo ""
                                echo "S3 bucket still exists."
                                echo "Waiting..."
                                echo "Attempt: $ATTEMPTS/$MAX_ATTEMPTS"

                                sleep 2

                            else

                                echo ""
                                echo "S3 bucket deletion VERIFIED."
                                echo "Bucket: $S3_BUCKET"

                                echo "================================================"

                                exit 0
                            fi

                        done

                        echo ""
                        echo "ERROR: S3 bucket deletion could not be verified."
                        echo "Bucket may still exist."

                        exit 1
                    '''
                }
            }
        }

        // ============================================================
        // 11 - DELETE DYNAMODB
        // ============================================================

        stage('11 - Delete DynamoDB Lock Table') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds']
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "DELETING DYNAMODB LOCK TABLE"
                        echo "================================================"

                        # ------------------------------------------------
                        # Check table
                        # ------------------------------------------------

                        if ! aws dynamodb describe-table \
                            --table-name "$DDB_TABLE" \
                            --region "$AWS_DEFAULT_REGION" \
                            >/dev/null 2>&1
                        then

                            echo ""
                            echo "DynamoDB table does not exist."
                            echo "Nothing to delete."

                            exit 0
                        fi

                        echo ""
                        echo "DynamoDB table exists:"
                        echo "$DDB_TABLE"

                        echo ""
                        echo "Current table status:"

                        aws dynamodb describe-table \
                            --table-name "$DDB_TABLE" \
                            --region "$AWS_DEFAULT_REGION" \
                            --query 'Table.TableStatus' \
                            --output text

                        echo ""
                        echo "Deleting DynamoDB table..."

                        aws dynamodb delete-table \
                            --table-name "$DDB_TABLE" \
                            --region "$AWS_DEFAULT_REGION"

                        echo ""
                        echo "DynamoDB deletion request submitted."

                        echo "================================================"
                    '''
                }
            }
        }

        // ============================================================
        // 12 - WAIT FOR DYNAMODB DELETION
        // ============================================================

        stage('12 - Wait For DynamoDB Deletion') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds']
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "WAITING FOR DYNAMODB TABLE DELETION"
                        echo "================================================"

                        echo ""
                        echo "Waiting for table:"
                        echo "$DDB_TABLE"

                        # ------------------------------------------------
                        # AWS CLI waiter
                        # ------------------------------------------------

                        if aws dynamodb wait table-not-exists \
                            --table-name "$DDB_TABLE" \
                            --region "$AWS_DEFAULT_REGION"
                        then

                            echo ""
                            echo "DynamoDB table deletion VERIFIED."
                            echo "Table: $DDB_TABLE"

                        else

                            echo ""
                            echo "ERROR: DynamoDB table deletion could not be verified."

                            exit 1
                        fi

                        echo "================================================"
                    '''
                }
            }
        }

        // ============================================================
        // 13 - FINAL VERIFICATION
        // ============================================================

        stage('13 - Final Backend Verification') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds']
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "FINAL BACKEND VERIFICATION"
                        echo "================================================"

                        S3_STATUS="DELETED"
                        DDB_STATUS="DELETED"

                        # ------------------------------------------------
                        # Final S3 check
                        # ------------------------------------------------

                        if aws s3api head-bucket \
                            --bucket "$S3_BUCKET" \
                            --region "$AWS_DEFAULT_REGION" \
                            >/dev/null 2>&1
                        then

                            S3_STATUS="STILL EXISTS"

                        fi

                        # ------------------------------------------------
                        # Final DynamoDB check
                        # ------------------------------------------------

                        if aws dynamodb describe-table \
                            --table-name "$DDB_TABLE" \
                            --region "$AWS_DEFAULT_REGION" \
                            >/dev/null 2>&1
                        then

                            DDB_STATUS="STILL EXISTS"

                        fi

                        echo ""
                        echo "------------------------------------------------"
                        echo "FINAL STATUS"
                        echo "------------------------------------------------"
                        echo ""
                        echo "S3 Backend Bucket : $S3_STATUS"
                        echo "DynamoDB Lock     : $DDB_STATUS"
                        echo ""

                        # ------------------------------------------------
                        # Validate S3
                        # ------------------------------------------------

                        if [ "$S3_STATUS" != "DELETED" ]; then

                            echo "ERROR: S3 bucket still exists."

                            exit 1
                        fi

                        # ------------------------------------------------
                        # Validate DynamoDB
                        # ------------------------------------------------

                        if [ "$DDB_STATUS" != "DELETED" ]; then

                            echo "ERROR: DynamoDB table still exists."

                            exit 1
                        fi

                        echo "------------------------------------------------"
                        echo ""
                        echo "FINAL VERIFICATION SUCCESSFUL"
                        echo ""
                        echo "Terraform S3 backend: DELETED"
                        echo "Terraform DynamoDB lock table: DELETED"
                        echo ""
                        echo "Terraform infrastructure was NOT destroyed."
                        echo ""
                        echo "================================================"
                    '''
                }
            }
        }

        // ============================================================
        // 14 - FINAL REPORT
        // ============================================================

        stage('14 - Final Destruction Report') {

            steps {

                echo ''
                echo '================================================'
                echo '       BACKEND CLEANUP COMPLETED'
                echo '================================================'
                echo ''

                echo 'Terraform S3 Backend: DELETED'
                echo "Bucket: ${params.S3_BACKEND_BUCKET}"
                echo ''

                echo 'S3 Object Versions: DELETED'
                echo 'S3 Delete Markers: DELETED'
                echo ''

                echo 'Terraform DynamoDB Lock Table: DELETED'
                echo "Table: ${params.DYNAMODB_LOCK_TABLE}"
                echo ''

                echo 'Terraform Infrastructure: NOT TOUCHED'
                echo 'EC2 Resources: NOT TOUCHED'
                echo 'ECS Resources: NOT TOUCHED'
                echo 'ALB Resources: NOT TOUCHED'
                echo 'VPC Resources: NOT TOUCHED'
                echo 'Security Groups: NOT TOUCHED'
                echo 'Application Resources: NOT TOUCHED'
                echo ''

                echo '================================================'
                echo '       CLEANUP SUCCESSFUL'
                echo '================================================'
                echo ''
            }
        }
    }

    // ================================================================
    // POST ACTIONS
    // ================================================================

    post {

        always {

            echo ''
            echo '================================================'
            echo '       CLEANING JENKINS WORKSPACE'
            echo '================================================'
            echo ''

            cleanWs()

            echo ''
            echo 'Workspace cleanup completed.'
            echo ''
        }

        success {

            echo ''
            echo '================================================'
            echo '       CLEANUP PIPELINE SUCCESSFUL'
            echo '================================================'
            echo ''

            echo "S3 Bucket      : ${params.S3_BACKEND_BUCKET}"
            echo "DynamoDB Table : ${params.DYNAMODB_LOCK_TABLE}"
            echo "AWS Region     : ${params.AWS_REGION}"

            echo ''
            echo 'Terraform backend resources were removed.'
            echo 'Terraform infrastructure was NOT destroyed.'
            echo ''

            echo '================================================'
        }

        failure {

            echo ''
            echo '================================================'
            echo '       CLEANUP PIPELINE FAILED'
            echo '================================================'
            echo ''

            echo "S3 Bucket      : ${params.S3_BACKEND_BUCKET}"
            echo "DynamoDB Table : ${params.DYNAMODB_LOCK_TABLE}"
            echo "AWS Region     : ${params.AWS_REGION}"

            echo ''
            echo 'Check the failed stage in the Jenkins console.'
            echo ''

            echo '================================================'
        }
    }
}
