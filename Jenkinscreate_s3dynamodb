pipeline {

    agent any

    // ============================================================
    // PIPELINE OPTIONS
    // ============================================================

    options {
        timestamps()
        ansiColor('xterm')
        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                daysToKeepStr: '30',
                numToKeepStr: '50'
            )
        )

        timeout(
            time: 30,
            unit: 'MINUTES'
        )
    }

    // ============================================================
    // ENVIRONMENT
    // ============================================================

    environment {
        AWS_DEFAULT_REGION = 'us-east-1'

        TERRAFORM_STATE_BUCKET = 'terraform-state-faizan-001'
        TERRAFORM_LOCK_TABLE = 'terraform-locks'
    }

    // ============================================================
    // PARAMETERS
    // ============================================================

    parameters {

        booleanParam(
            name: 'FORCE_BUCKET_VERSIONING',
            defaultValue: true,
            description: 'Ensure S3 bucket versioning is enabled.'
        )

        booleanParam(
            name: 'FORCE_BUCKET_ENCRYPTION',
            defaultValue: true,
            description: 'Ensure S3 default encryption is enabled.'
        )

        booleanParam(
            name: 'FORCE_PUBLIC_ACCESS_BLOCK',
            defaultValue: true,
            description: 'Ensure S3 public access is blocked.'
        )
    }

    // ============================================================
    // STAGES
    // ============================================================

    stages {

        // --------------------------------------------------------
        // 1. CHECK AWS CLI
        // --------------------------------------------------------

        stage('01 - Check AWS CLI') {

            steps {

                sh '''
                    set -eu

                    echo "=============================================="
                    echo "Checking AWS CLI"
                    echo "=============================================="

                    aws --version

                    echo ""
                    echo "AWS region:"
                    echo "${AWS_DEFAULT_REGION}"

                    echo ""
                    echo "AWS account:"
                    aws sts get-caller-identity

                    echo ""
                    echo "AWS CLI check completed."
                '''
            }
        }

        // --------------------------------------------------------
        // 2. CHECK S3 BUCKET
        // --------------------------------------------------------

        stage('02 - Check S3 Backend Bucket') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds',
                     accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                     secretKeyVariable: 'AWS_SECRET_ACCESS_KEY']
                ]) {

                    sh '''
                        set -eu

                        echo "=============================================="
                        echo "Checking Terraform State S3 Bucket"
                        echo "=============================================="

                        echo "Bucket:"
                        echo "${TERRAFORM_STATE_BUCKET}"

                        if aws s3api head-bucket \
                            --bucket "${TERRAFORM_STATE_BUCKET}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            >/dev/null 2>&1
                        then
                            echo ""
                            echo "S3 bucket already exists."
                        else
                            echo ""
                            echo "S3 bucket does not exist."
                            echo "It will be created by the next stage."
                        fi
                    '''
                }
            }
        }

        // --------------------------------------------------------
        // 3. CREATE S3 BUCKET
        // --------------------------------------------------------

        stage('03 - Create S3 Backend Bucket') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds',
                     accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                     secretKeyVariable: 'AWS_SECRET_ACCESS_KEY']
                ]) {

                    sh '''
                        set -eu

                        echo "=============================================="
                        echo "Creating Terraform State S3 Bucket"
                        echo "=============================================="

                        if aws s3api head-bucket \
                            --bucket "${TERRAFORM_STATE_BUCKET}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            >/dev/null 2>&1
                        then

                            echo "Bucket already exists."
                            echo "No creation required."

                        else

                            echo "Creating bucket..."

                            aws s3api create-bucket \
                                --bucket "${TERRAFORM_STATE_BUCKET}" \
                                --region "${AWS_DEFAULT_REGION}"

                            echo "Bucket creation command completed."

                        fi

                        echo ""
                        echo "Waiting for S3 bucket to become available..."

                        aws s3api wait bucket-exists \
                            --bucket "${TERRAFORM_STATE_BUCKET}" \
                            --region "${AWS_DEFAULT_REGION}"

                        echo ""
                        echo "S3 bucket is available."
                    '''
                }
            }
        }

        // --------------------------------------------------------
        // 4. CONFIGURE S3
        // --------------------------------------------------------

        stage('04 - Configure S3 Backend Bucket') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds',
                     accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                     secretKeyVariable: 'AWS_SECRET_ACCESS_KEY']
                ]) {

                    sh '''
                        set -eu

                        echo "=============================================="
                        echo "Configuring S3 Backend Bucket"
                        echo "=============================================="

                        if [ "${FORCE_BUCKET_VERSIONING}" = "true" ]; then

                            echo ""
                            echo "Enabling S3 versioning..."

                            aws s3api put-bucket-versioning \
                                --bucket "${TERRAFORM_STATE_BUCKET}" \
                                --region "${AWS_DEFAULT_REGION}" \
                                --versioning-configuration Status=Enabled

                            echo "S3 versioning enabled."

                        fi

                        if [ "${FORCE_BUCKET_ENCRYPTION}" = "true" ]; then

                            echo ""
                            echo "Enabling S3 default encryption..."

                            aws s3api put-bucket-encryption \
                                --bucket "${TERRAFORM_STATE_BUCKET}" \
                                --region "${AWS_DEFAULT_REGION}" \
                                --server-side-encryption-configuration '{
                                    "Rules": [
                                        {
                                            "ApplyServerSideEncryptionByDefault": {
                                                "SSEAlgorithm": "AES256"
                                            }
                                        }
                                    ]
                                }'

                            echo "S3 default encryption enabled."

                        fi

                        if [ "${FORCE_PUBLIC_ACCESS_BLOCK}" = "true" ]; then

                            echo ""
                            echo "Blocking public access..."

                            aws s3api put-public-access-block \
                                --bucket "${TERRAFORM_STATE_BUCKET}" \
                                --region "${AWS_DEFAULT_REGION}" \
                                --public-access-block-configuration \
                                BlockPublicAcls=true,IgnorePublicAcls=true,BlockPublicPolicy=true,RestrictPublicBuckets=true

                            echo "S3 public access blocked."

                        fi

                        echo ""
                        echo "S3 configuration completed."
                    '''
                }
            }
        }

        // --------------------------------------------------------
        // 5. CHECK DYNAMODB TABLE
        // --------------------------------------------------------

        stage('05 - Check DynamoDB Lock Table') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds',
                     accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                     secretKeyVariable: 'AWS_SECRET_ACCESS_KEY']
                ]) {

                    sh '''
                        set -eu

                        echo "=============================================="
                        echo "Checking DynamoDB Terraform Lock Table"
                        echo "=============================================="

                        if aws dynamodb describe-table \
                            --table-name "${TERRAFORM_LOCK_TABLE}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            >/dev/null 2>&1
                        then

                            echo ""
                            echo "DynamoDB table already exists."

                        else

                            echo ""
                            echo "DynamoDB table does not exist."
                            echo "It will be created by the next stage."

                        fi
                    '''
                }
            }
        }

        // --------------------------------------------------------
        // 6. CREATE DYNAMODB TABLE
        // --------------------------------------------------------

        stage('06 - Create DynamoDB Lock Table') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds',
                     accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                     secretKeyVariable: 'AWS_SECRET_ACCESS_KEY']
                ]) {

                    sh '''
                        set -eu

                        echo "=============================================="
                        echo "Creating Terraform DynamoDB Lock Table"
                        echo "=============================================="

                        if aws dynamodb describe-table \
                            --table-name "${TERRAFORM_LOCK_TABLE}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            >/dev/null 2>&1
                        then

                            echo "DynamoDB table already exists."
                            echo "No creation required."

                        else

                            echo "Creating DynamoDB table..."

                            aws dynamodb create-table \
                                --table-name "${TERRAFORM_LOCK_TABLE}" \
                                --attribute-definitions \
                                    AttributeName=LockID,AttributeType=S \
                                --key-schema \
                                    AttributeName=LockID,KeyType=HASH \
                                --billing-mode PAY_PER_REQUEST \
                                --region "${AWS_DEFAULT_REGION}"

                            echo ""
                            echo "DynamoDB creation command completed."

                        fi

                        echo ""
                        echo "Waiting for DynamoDB table to become ACTIVE..."

                        aws dynamodb wait table-exists \
                            --table-name "${TERRAFORM_LOCK_TABLE}" \
                            --region "${AWS_DEFAULT_REGION}"

                        echo ""
                        echo "DynamoDB table is available."
                    '''
                }
            }
        }

        // --------------------------------------------------------
        // 7. VERIFY S3
        // --------------------------------------------------------

        stage('07 - Verify S3 Backend') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds',
                     accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                     secretKeyVariable: 'AWS_SECRET_ACCESS_KEY']
                ]) {

                    sh '''
                        set -eu

                        echo "=============================================="
                        echo "Verifying S3 Backend"
                        echo "=============================================="

                        aws s3api head-bucket \
                            --bucket "${TERRAFORM_STATE_BUCKET}" \
                            --region "${AWS_DEFAULT_REGION}"

                        echo ""
                        echo "S3 versioning status:"

                        aws s3api get-bucket-versioning \
                            --bucket "${TERRAFORM_STATE_BUCKET}" \
                            --region "${AWS_DEFAULT_REGION}"

                        echo ""
                        echo "S3 encryption configuration:"

                        aws s3api get-bucket-encryption \
                            --bucket "${TERRAFORM_STATE_BUCKET}" \
                            --region "${AWS_DEFAULT_REGION}"

                        echo ""
                        echo "S3 public access block:"

                        aws s3api get-public-access-block \
                            --bucket "${TERRAFORM_STATE_BUCKET}" \
                            --region "${AWS_DEFAULT_REGION}"

                        echo ""
                        echo "S3 backend verification successful."
                    '''
                }
            }
        }

        // --------------------------------------------------------
        // 8. VERIFY DYNAMODB
        // --------------------------------------------------------

        stage('08 - Verify DynamoDB Lock Table') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds',
                     accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                     secretKeyVariable: 'AWS_SECRET_ACCESS_KEY']
                ]) {

                    sh '''
                        set -eu

                        echo "=============================================="
                        echo "Verifying DynamoDB Lock Table"
                        echo "=============================================="

                        aws dynamodb describe-table \
                            --table-name "${TERRAFORM_LOCK_TABLE}" \
                            --region "${AWS_DEFAULT_REGION}"

                        echo ""
                        echo "Checking table status..."

                        TABLE_STATUS=$(aws dynamodb describe-table \
                            --table-name "${TERRAFORM_LOCK_TABLE}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            --query 'Table.TableStatus' \
                            --output text)

                        echo "DynamoDB table status: ${TABLE_STATUS}"

                        if [ "${TABLE_STATUS}" != "ACTIVE" ]; then
                            echo "ERROR: DynamoDB table is not ACTIVE."
                            exit 1
                        fi

                        echo ""
                        echo "DynamoDB lock table verification successful."
                    '''
                }
            }
        }

        // --------------------------------------------------------
        // 9. FINAL REPORT
        // --------------------------------------------------------

        stage('09 - Final Backend Report') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds',
                     accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                     secretKeyVariable: 'AWS_SECRET_ACCESS_KEY']
                ]) {

                    sh '''
                        set -eu

                        echo ""
                        echo "============================================================"
                        echo "           TERRAFORM BACKEND BOOTSTRAP REPORT"
                        echo "============================================================"
                        echo ""
                        echo "AWS Region:"
                        echo "${AWS_DEFAULT_REGION}"
                        echo ""
                        echo "S3 State Bucket:"
                        echo "${TERRAFORM_STATE_BUCKET}"
                        echo ""
                        echo "DynamoDB Lock Table:"
                        echo "${TERRAFORM_LOCK_TABLE}"
                        echo ""
                        echo "S3 Status:"
                        aws s3api head-bucket \
                            --bucket "${TERRAFORM_STATE_BUCKET}" \
                            --region "${AWS_DEFAULT_REGION}"

                        echo "AVAILABLE"
                        echo ""
                        echo "DynamoDB Status:"

                        aws dynamodb describe-table \
                            --table-name "${TERRAFORM_LOCK_TABLE}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            --query 'Table.TableStatus' \
                            --output text

                        echo ""
                        echo "============================================================"
                        echo "              BACKEND READY"
                        echo "============================================================"
                        echo ""
                        echo "Your existing Terraform pipeline can now run:"
                        echo ""
                        echo "terraform init"
                        echo ""
                        echo "The backend resources were created independently."
                        echo ""
                        echo "IMPORTANT:"
                        echo "This bootstrap pipeline does NOT delete the"
                        echo "S3 bucket or DynamoDB table."
                        echo ""
                        echo "============================================================"
                    '''
                }
            }
        }
    }

    // ============================================================
    // POST ACTIONS
    // ============================================================

    post {

        success {

            echo 'Terraform backend bootstrap completed successfully.'

        }

        failure {

            echo 'Terraform backend bootstrap FAILED. Check the stage above for the exact error.'

        }

        always {

            echo 'Terraform backend bootstrap pipeline execution finished.'
        }
    }
}
