pipeline {

    agent any

    // ============================================================
    // PIPELINE OPTIONS
    // ============================================================

    options {

        timestamps()

        ansiColor('xterm')

        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                daysToKeepStr: '30',
                numToKeepStr: '50'
            )
        )

        timeout(
            time: 30,
            unit: 'MINUTES'
        )
    }

    // ============================================================
    // ENVIRONMENT
    // ============================================================

    environment {

        AWS_DEFAULT_REGION = 'us-east-1'

        TERRAFORM_STATE_BUCKET = 'terraform-state-faizan-001'

        TERRAFORM_LOCK_TABLE = 'terraform-locks'
    }

    // ============================================================
    // PARAMETERS
    // ============================================================

    parameters {

        booleanParam(
            name: 'ENABLE_BUCKET_VERSIONING',
            defaultValue: true,
            description: 'Enable versioning on the Terraform state S3 bucket.'
        )

        booleanParam(
            name: 'ENABLE_BUCKET_ENCRYPTION',
            defaultValue: true,
            description: 'Enable AES256 server-side encryption on the S3 bucket.'
        )

        booleanParam(
            name: 'BLOCK_PUBLIC_ACCESS',
            defaultValue: true,
            description: 'Block all public access to the S3 bucket.'
        )
    }

    // ============================================================
    // STAGES
    // ============================================================

    stages {

        // ========================================================
        // 01 - CHECK AWS CLI AND CREDENTIALS
        // ========================================================

        stage('01 - Check AWS CLI and Credentials') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds',
                     accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                     secretKeyVariable: 'AWS_SECRET_ACCESS_KEY']
                ]) {

                    sh '''
                        set -eu

                        echo "=============================================="
                        echo "AWS CLI AND CREDENTIAL CHECK"
                        echo "=============================================="

                        echo ""
                        echo "AWS CLI version:"
                        aws --version

                        echo ""
                        echo "AWS region:"
                        echo "${AWS_DEFAULT_REGION}"

                        echo ""
                        echo "Checking AWS credentials..."

                        aws sts get-caller-identity

                        echo ""
                        echo "AWS credentials are working."
                        echo "=============================================="
                    '''
                }
            }
        }

        // ========================================================
        // 02 - CHECK S3 BUCKET
        // ========================================================

        stage('02 - Check S3 Backend Bucket') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds',
                     accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                     secretKeyVariable: 'AWS_SECRET_ACCESS_KEY']
                ]) {

                    sh '''
                        set -eu

                        echo "=============================================="
                        echo "CHECKING S3 BACKEND BUCKET"
                        echo "=============================================="

                        echo ""
                        echo "Bucket:"
                        echo "${TERRAFORM_STATE_BUCKET}"

                        if aws s3api head-bucket \
                            --bucket "${TERRAFORM_STATE_BUCKET}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            >/dev/null 2>&1
                        then

                            echo ""
                            echo "S3 bucket already exists."

                        else

                            echo ""
                            echo "S3 bucket does not exist."
                            echo "The next stage will create it."

                        fi

                        echo ""
                        echo "S3 check completed."
                    '''
                }
            }
        }

        // ========================================================
        // 03 - CREATE S3 BUCKET
        // ========================================================

        stage('03 - Create S3 Backend Bucket') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds',
                     accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                     secretKeyVariable: 'AWS_SECRET_ACCESS_KEY']
                ]) {

                    sh '''
                        set -eu

                        echo "=============================================="
                        echo "CREATING S3 BACKEND BUCKET"
                        echo "=============================================="

                        if aws s3api head-bucket \
                            --bucket "${TERRAFORM_STATE_BUCKET}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            >/dev/null 2>&1
                        then

                            echo ""
                            echo "Bucket already exists."
                            echo "No creation required."

                        else

                            echo ""
                            echo "Creating S3 bucket:"
                            echo "${TERRAFORM_STATE_BUCKET}"

                            aws s3api create-bucket \
                                --bucket "${TERRAFORM_STATE_BUCKET}" \
                                --region "${AWS_DEFAULT_REGION}"

                            echo ""
                            echo "S3 bucket creation request completed."

                        fi

                        echo ""
                        echo "Waiting for S3 bucket..."

                        aws s3api wait bucket-exists \
                            --bucket "${TERRAFORM_STATE_BUCKET}" \
                            --region "${AWS_DEFAULT_REGION}"

                        echo ""
                        echo "S3 bucket is available."
                    '''
                }
            }
        }

        // ========================================================
        // 04 - CONFIGURE S3
        // ========================================================

        stage('04 - Configure S3 Backend Bucket') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds',
                     accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                     secretKeyVariable: 'AWS_SECRET_ACCESS_KEY']
                ]) {

                    sh '''
                        set -eu

                        echo "=============================================="
                        echo "CONFIGURING S3 BACKEND BUCKET"
                        echo "=============================================="

                        if [ "${ENABLE_BUCKET_VERSIONING}" = "true" ]; then

                            echo ""
                            echo "Enabling S3 versioning..."

                            aws s3api put-bucket-versioning \
                                --bucket "${TERRAFORM_STATE_BUCKET}" \
                                --region "${AWS_DEFAULT_REGION}" \
                                --versioning-configuration Status=Enabled

                            echo "S3 versioning enabled."

                        else

                            echo "S3 versioning was disabled by parameter."

                        fi

                        if [ "${ENABLE_BUCKET_ENCRYPTION}" = "true" ]; then

                            echo ""
                            echo "Enabling AES256 encryption..."

                            aws s3api put-bucket-encryption \
                                --bucket "${TERRAFORM_STATE_BUCKET}" \
                                --region "${AWS_DEFAULT_REGION}" \
                                --server-side-encryption-configuration '{
                                    "Rules": [
                                        {
                                            "ApplyServerSideEncryptionByDefault": {
                                                "SSEAlgorithm": "AES256"
                                            }
                                        }
                                    ]
                                }'

                            echo "S3 encryption enabled."

                        else

                            echo "S3 encryption configuration was disabled by parameter."

                        fi

                        if [ "${BLOCK_PUBLIC_ACCESS}" = "true" ]; then

                            echo ""
                            echo "Blocking public access..."

                            aws s3api put-public-access-block \
                                --bucket "${TERRAFORM_STATE_BUCKET}" \
                                --region "${AWS_DEFAULT_REGION}" \
                                --public-access-block-configuration \
                                BlockPublicAcls=true,IgnorePublicAcls=true,BlockPublicPolicy=true,RestrictPublicBuckets=true

                            echo "S3 public access blocked."

                        else

                            echo "S3 public access block was disabled by parameter."

                        fi

                        echo ""
                        echo "S3 configuration completed."
                    '''
                }
            }
        }

        // ========================================================
        // 05 - VERIFY S3
        // ========================================================

        stage('05 - Verify S3 Backend') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds',
                     accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                     secretKeyVariable: 'AWS_SECRET_ACCESS_KEY']
                ]) {

                    sh '''
                        set -eu

                        echo "=============================================="
                        echo "VERIFYING S3 BACKEND"
                        echo "=============================================="

                        echo ""
                        echo "Checking bucket existence..."

                        aws s3api head-bucket \
                            --bucket "${TERRAFORM_STATE_BUCKET}" \
                            --region "${AWS_DEFAULT_REGION}"

                        echo ""
                        echo "Bucket exists."

                        echo ""
                        echo "Checking versioning..."

                        aws s3api get-bucket-versioning \
                            --bucket "${TERRAFORM_STATE_BUCKET}" \
                            --region "${AWS_DEFAULT_REGION}"

                        echo ""
                        echo "Checking encryption..."

                        aws s3api get-bucket-encryption \
                            --bucket "${TERRAFORM_STATE_BUCKET}" \
                            --region "${AWS_DEFAULT_REGION}"

                        echo ""
                        echo "Checking public access block..."

                        aws s3api get-public-access-block \
                            --bucket "${TERRAFORM_STATE_BUCKET}" \
                            --region "${AWS_DEFAULT_REGION}"

                        echo ""
                        echo "S3 backend verification successful."
                    '''
                }
            }
        }

        // ========================================================
        // 06 - CHECK DYNAMODB
        // ========================================================

        stage('06 - Check DynamoDB Lock Table') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds',
                     accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                     secretKeyVariable: 'AWS_SECRET_ACCESS_KEY']
                ]) {

                    sh '''
                        set -eu

                        echo "=============================================="
                        echo "CHECKING DYNAMODB LOCK TABLE"
                        echo "=============================================="

                        echo ""
                        echo "Table:"
                        echo "${TERRAFORM_LOCK_TABLE}"

                        if aws dynamodb describe-table \
                            --table-name "${TERRAFORM_LOCK_TABLE}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            >/dev/null 2>&1
                        then

                            echo ""
                            echo "DynamoDB table already exists."

                        else

                            echo ""
                            echo "DynamoDB table does not exist."
                            echo "The next stage will create it."

                        fi

                        echo ""
                        echo "DynamoDB check completed."
                    '''
                }
            }
        }

        // ========================================================
        // 07 - CREATE DYNAMODB
        // ========================================================

        stage('07 - Create DynamoDB Lock Table') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds',
                     accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                     secretKeyVariable: 'AWS_SECRET_ACCESS_KEY']
                ]) {

                    sh '''
                        set -eu

                        echo "=============================================="
                        echo "CREATING DYNAMODB LOCK TABLE"
                        echo "=============================================="

                        if aws dynamodb describe-table \
                            --table-name "${TERRAFORM_LOCK_TABLE}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            >/dev/null 2>&1
                        then

                            echo ""
                            echo "DynamoDB table already exists."
                            echo "No creation required."

                        else

                            echo ""
                            echo "Creating DynamoDB table:"
                            echo "${TERRAFORM_LOCK_TABLE}"

                            aws dynamodb create-table \
                                --table-name "${TERRAFORM_LOCK_TABLE}" \
                                --attribute-definitions \
                                    AttributeName=LockID,AttributeType=S \
                                --key-schema \
                                    AttributeName=LockID,KeyType=HASH \
                                --billing-mode PAY_PER_REQUEST \
                                --region "${AWS_DEFAULT_REGION}"

                            echo ""
                            echo "DynamoDB creation request completed."

                        fi

                        echo ""
                        echo "Waiting for DynamoDB table to become ACTIVE..."

                        aws dynamodb wait table-exists \
                            --table-name "${TERRAFORM_LOCK_TABLE}" \
                            --region "${AWS_DEFAULT_REGION}"

                        echo ""
                        echo "DynamoDB table is available."
                    '''
                }
            }
        }

        // ========================================================
        // 08 - VERIFY DYNAMODB
        // ========================================================

        stage('08 - Verify DynamoDB Lock Table') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds',
                     accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                     secretKeyVariable: 'AWS_SECRET_ACCESS_KEY']
                ]) {

                    sh '''
                        set -eu

                        echo "=============================================="
                        echo "VERIFYING DYNAMODB LOCK TABLE"
                        echo "=============================================="

                        TABLE_STATUS=$(aws dynamodb describe-table \
                            --table-name "${TERRAFORM_LOCK_TABLE}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            --query 'Table.TableStatus' \
                            --output text)

                        echo ""
                        echo "DynamoDB table status:"
                        echo "${TABLE_STATUS}"

                        if [ "${TABLE_STATUS}" != "ACTIVE" ]; then

                            echo ""
                            echo "ERROR: DynamoDB table is not ACTIVE."

                            exit 1

                        fi

                        echo ""
                        echo "Checking table key..."

                        aws dynamodb describe-table \
                            --table-name "${TERRAFORM_LOCK_TABLE}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            --query 'Table.KeySchema'

                        echo ""
                        echo "DynamoDB verification successful."
                    '''
                }
            }
        }

        // ========================================================
        // 09 - FINAL REPORT
        // ========================================================

        stage('09 - Final Backend Report') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds',
                     accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                     secretKeyVariable: 'AWS_SECRET_ACCESS_KEY']
                ]) {

                    sh '''
                        set -eu

                        echo ""
                        echo "============================================================"
                        echo "             TERRAFORM BACKEND REPORT"
                        echo "============================================================"

                        echo ""
                        echo "AWS Region:"
                        echo "${AWS_DEFAULT_REGION}"

                        echo ""
                        echo "S3 State Bucket:"
                        echo "${TERRAFORM_STATE_BUCKET}"

                        echo ""
                        echo "DynamoDB Lock Table:"
                        echo "${TERRAFORM_LOCK_TABLE}"

                        echo ""
                        echo "------------------------------------------------------------"
                        echo "S3 STATUS"
                        echo "------------------------------------------------------------"

                        aws s3api head-bucket \
                            --bucket "${TERRAFORM_STATE_BUCKET}" \
                            --region "${AWS_DEFAULT_REGION}"

                        echo "S3 bucket: AVAILABLE"

                        echo ""
                        echo "------------------------------------------------------------"
                        echo "DYNAMODB STATUS"
                        echo "------------------------------------------------------------"

                        TABLE_STATUS=$(aws dynamodb describe-table \
                            --table-name "${TERRAFORM_LOCK_TABLE}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            --query 'Table.TableStatus' \
                            --output text)

                        echo "DynamoDB table: ${TABLE_STATUS}"

                        if [ "${TABLE_STATUS}" != "ACTIVE" ]; then
                            echo ""
                            echo "ERROR: DynamoDB table is not ACTIVE."
                            exit 1
                        fi

                        echo ""
                        echo "============================================================"
                        echo "                 BACKEND READY"
                        echo "============================================================"

                        echo ""
                        echo "S3 bucket is ready for Terraform state."

                        echo "DynamoDB table is ready for Terraform locking."

                        echo ""
                        echo "Your existing Terraform pipeline can now run:"
                        echo ""
                        echo "terraform init -input=false"
                        echo ""
                        echo "This bootstrap pipeline does not destroy either resource."

                        echo ""
                        echo "============================================================"
                    '''
                }
            }
        }
    }

    // ============================================================
    // POST ACTIONS
    // ============================================================

    post {

        success {

            echo 'Terraform backend bootstrap completed successfully.'

        }

        failure {

            echo 'Terraform backend bootstrap FAILED. Review the failed stage above.'

        }

        always {

            echo 'Terraform backend bootstrap pipeline execution finished.'
        }
    }
}
