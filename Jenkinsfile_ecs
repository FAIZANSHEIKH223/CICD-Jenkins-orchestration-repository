pipeline {

    agent any

    options {
        timestamps()
        ansiColor('xterm')
        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                daysToKeepStr: '30',
                numToKeepStr: '50'
            )
        )

        timeout(
            time: 90,
            unit: 'MINUTES'
        )
    }

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: [
                'dev',
                'qa',
                'stage',
                'prod'
            ],
            description: 'Terraform environment to deploy'
        )
    }

    environment {

        // ============================================================
        // GITHUB
        // ============================================================

        APP_REPO = 'https://github.com/FAIZANSHEIKH223/practice1.git'
        APP_BRANCH = 'main'

        QUALITY_REPO = 'https://github.com/FAIZANSHEIKH223/pylint_flake8_int_jenkins.git'
        QUALITY_BRANCH = 'main'

        TERRAFORM_REPO = 'https://github.com/FAIZANSHEIKH223/terraform-aws-infra.git'
        TERRAFORM_BRANCH = 'main'

        GITHUB_CREDENTIALS = 'github-creds'
        AWS_CREDENTIALS = 'aws-creds'

        // ============================================================
        // DIRECTORIES
        // ============================================================

        APP_DIR = 'practice1'
        QUALITY_DIR = 'quality-tools'
        TERRAFORM_DIR = 'terraform-infra'

        VENV_DIR = 'venv'
        REPORT_DIR = 'reports'

        PYTHON = 'python3.12'

        // ============================================================
        // AWS
        // ============================================================

        AWS_DEFAULT_REGION = 'us-east-1'

        // ============================================================
        // APPLICATION
        // ============================================================

        APP_NAME = 'practice1'
        CONTAINER_NAME = 'practice1'

        /*
         * IMPORTANT
         *
         * Your application/container is listening on 8501.
         */
        CONTAINER_PORT = '8501'

        /*
         * Streamlit root URL.
         *
         * ALB will check:
         *
         * http://TASK-IP:8501/
         */
        HEALTH_PATH = '/'

        // ============================================================
        // DOCKER
        // ============================================================

        DOCKER_IMAGE_NAME = 'practice1'
        DOCKER_IMAGE_TAG = "${BUILD_NUMBER}"
        DOCKER_IMAGE = "practice1:${BUILD_NUMBER}"

        // ============================================================
        // ECR
        // ============================================================

        ECR_REPOSITORY = 'practice1'
        ECR_IMAGE_TAG = "${BUILD_NUMBER}"

        // ============================================================
        // ECS
        // ============================================================

        ECS_CLUSTER = "practice1-${ENVIRONMENT}-cluster"
        ECS_SERVICE = "practice1-${ENVIRONMENT}-service"
        ECS_TASK_FAMILY = "practice1-${ENVIRONMENT}-task"

        ECS_CONTAINER_NAME = 'practice1'

        FARGATE_CPU = '256'
        FARGATE_MEMORY = '512'

        // ============================================================
        // LOAD BALANCER
        // ============================================================

        ALB_NAME = "practice1-${ENVIRONMENT}-alb"
        TARGET_GROUP_NAME = "practice1-${ENVIRONMENT}-tg"

        ALB_SG_NAME = "practice1-${ENVIRONMENT}-alb-sg"
        ECS_SG_NAME = "practice1-${ENVIRONMENT}-ecs-sg"

        // ============================================================
        // TERRAFORM
        // ============================================================

        TF_STATE_BUCKET = 'terraform-state-faizan-001'
        TF_LOCK_TABLE = 'terraform-locks'

        TF_IN_AUTOMATION = 'true'
        TF_INPUT = 'false'

        // ============================================================
        // PLACEHOLDERS
        // ============================================================

        DNS_NAME = ''
    }

    stages {

        // ============================================================
        // PART 1
        // APPLICATION
        // ============================================================

        stage('1 - Application Checkout') {

            steps {

                echo '================================================'
                echo 'CHECKOUT APPLICATION'
                echo '================================================'

                dir("${APP_DIR}") {

                    deleteDir()

                    git(
                        branch: "${APP_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${APP_REPO}"
                    )
                }
            }
        }

        // ============================================================
        // QUALITY REPOSITORY
        // ============================================================

        stage('2 - Quality Repository Checkout') {

            steps {

                echo '================================================'
                echo 'CHECKOUT QUALITY REPOSITORY'
                echo '================================================'

                dir("${QUALITY_DIR}") {

                    deleteDir()

                    git(
                        branch: "${QUALITY_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${QUALITY_REPO}"
                    )
                }
            }
        }

        // ============================================================
        // PYTHON
        // ============================================================

        stage('3 - Python Environment') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "PYTHON ENVIRONMENT"
                        echo "================================================"

                        command -v "${PYTHON}"

                        "${PYTHON}" --version

                        rm -rf "${VENV_DIR}"

                        "${PYTHON}" -m venv "${VENV_DIR}"

                        "${VENV_DIR}/bin/python" --version

                        "${VENV_DIR}/bin/python" -m pip install --upgrade pip
                    '''
                }
            }
        }

        // ============================================================
        // DEPENDENCIES
        // ============================================================

        stage('4 - Install Dependencies and Quality Tools') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "INSTALLING DEPENDENCIES"
                        echo "================================================"

                        if [ -f requirements.txt ]; then

                            "${VENV_DIR}/bin/pip" install -r requirements.txt

                        else

                            echo "WARNING: requirements.txt not found."

                        fi

                        "${VENV_DIR}/bin/pip" install \
                            flake8 \
                            pylint \
                            pytest

                        "${VENV_DIR}/bin/flake8" --version
                        "${VENV_DIR}/bin/pylint" --version
                        "${VENV_DIR}/bin/pytest" --version
                    '''
                }
            }
        }

        // ============================================================
        // QUALITY
        // ============================================================

        stage('5 - Code Quality') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "CODE QUALITY"
                        echo "================================================"

                        mkdir -p "${REPORT_DIR}"

                        echo "Running Flake8..."

                        "${VENV_DIR}/bin/flake8" \
                            . \
                            --exclude="${VENV_DIR},.git,${REPORT_DIR},__pycache__" \
                            --count \
                            --statistics \
                            --tee \
                            --output-file="${REPORT_DIR}/flake8-report.txt"

                        echo "Running Pylint..."

                        PYTHON_FILES=$(find . \
                            -type f \
                            -name "*.py" \
                            ! -path "./${VENV_DIR}/*" \
                            ! -path "./.git/*" \
                            ! -path "./${REPORT_DIR}/*" \
                            ! -path "*/__pycache__/*")

                        if [ -z "${PYTHON_FILES}" ]; then
                            echo "ERROR: No Python files found."
                            exit 1
                        fi

                        "${VENV_DIR}/bin/pylint" \
                            ${PYTHON_FILES} \
                            --output-format=text \
                            > "${REPORT_DIR}/pylint-report.txt"

                        echo "Code quality completed."
                    '''
                }
            }
        }

        // ============================================================
        // TEST
        // ============================================================

        stage('6 - Automated Tests') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "AUTOMATED TESTS"
                        echo "================================================"

                        mkdir -p "${REPORT_DIR}"

                        if [ ! -d tests ]; then

                            echo "ERROR: tests/ directory does not exist."
                            exit 1

                        fi

                        TEST_FILES=$(find tests \
                            -type f \
                            \\( \
                                -name "test_*.py" \
                                -o \
                                -name "*_test.py" \
                            \\))

                        if [ -z "${TEST_FILES}" ]; then

                            echo "ERROR: No pytest test files found."
                            exit 1

                        fi

                        echo "Test files:"
                        echo "${TEST_FILES}"

                        "${VENV_DIR}/bin/pytest" \
                            tests/ \
                            -v \
                            --junitxml="${REPORT_DIR}/pytest-results.xml"
                    '''
                }
            }
        }

        // ============================================================
        // REPORT
        // ============================================================

        stage('7 - Publish Test Reports') {

            steps {

                junit(
                    testResults: "${APP_DIR}/${REPORT_DIR}/pytest-results.xml",
                    allowEmptyResults: false
                )

                archiveArtifacts(
                    artifacts:
                        "${APP_DIR}/${REPORT_DIR}/pytest-results.xml," +
                        "${APP_DIR}/${REPORT_DIR}/flake8-report.txt," +
                        "${APP_DIR}/${REPORT_DIR}/pylint-report.txt",
                    allowEmptyArchive: false,
                    fingerprint: true
                )
            }
        }

        // ============================================================
        // DOCKER
        // ============================================================

        stage('8 - Docker Build') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "DOCKER BUILD"
                        echo "================================================"

                        command -v docker

                        docker --version

                        docker info > /dev/null

                        if [ ! -f Dockerfile ]; then

                            echo "ERROR: Dockerfile not found."
                            exit 1

                        fi

                        cat > .dockerignore <<'EOF'
venv/
.venv/
.git/
.gitignore
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
reports/
*.log
.DS_Store
EOF

                        docker build \
                            --pull \
                            --tag "${DOCKER_IMAGE}" \
                            .

                        docker image inspect "${DOCKER_IMAGE}" > /dev/null

                        echo "Docker image created:"
                        echo "${DOCKER_IMAGE}"
                    '''
                }
            }
        }

        // ============================================================
        // ECR
        // ============================================================

        stage('9 - ECR Deployment') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        sh '''
                            set -eu

                            echo "================================================"
                            echo "AWS VERIFICATION"
                            echo "================================================"

                            command -v aws

                            aws --version

                            aws sts get-caller-identity \
                                --region "${AWS_DEFAULT_REGION}"
                        '''

                        sh '''
                            set -eu

                            echo "================================================"
                            echo "ECR REPOSITORY"
                            echo "================================================"

                            if aws ecr describe-repositories \
                                --repository-names "${ECR_REPOSITORY}" \
                                --region "${AWS_DEFAULT_REGION}" \
                                > /dev/null 2>&1
                            then

                                echo "ECR repository already exists."

                            else

                                aws ecr create-repository \
                                    --repository-name "${ECR_REPOSITORY}" \
                                    --region "${AWS_DEFAULT_REGION}"

                            fi
                        '''

                        env.AWS_ACCOUNT_ID = sh(
                            script: '''
                                aws sts get-caller-identity \
                                    --query Account \
                                    --output text \
                                    --region "${AWS_DEFAULT_REGION}"
                            ''',
                            returnStdout: true
                        ).trim()

                        env.ECR_REGISTRY =
                            "${env.AWS_ACCOUNT_ID}.dkr.ecr.${env.AWS_DEFAULT_REGION}.amazonaws.com"

                        env.ECR_IMAGE =
                            "${env.ECR_REGISTRY}/${env.ECR_REPOSITORY}:${env.ECR_IMAGE_TAG}"

                        echo "AWS Account : ${env.AWS_ACCOUNT_ID}"
                        echo "ECR Registry: ${env.ECR_REGISTRY}"
                        echo "ECR Image   : ${env.ECR_IMAGE}"

                        sh '''
                            set -eu

                            echo "================================================"
                            echo "ECR LOGIN"
                            echo "================================================"

                            aws ecr get-login-password \
                                --region "${AWS_DEFAULT_REGION}" |
                            docker login \
                                --username AWS \
                                --password-stdin \
                                "${ECR_REGISTRY}"
                        '''

                        sh '''
                            set -eu

                            docker tag \
                                "${DOCKER_IMAGE}" \
                                "${ECR_IMAGE}"

                            docker image inspect \
                                "${ECR_IMAGE}" > /dev/null

                            docker push "${ECR_IMAGE}"
                        '''

                        sh '''
                            set -eu

                            aws ecr describe-images \
                                --repository-name "${ECR_REPOSITORY}" \
                                --image-ids imageTag="${ECR_IMAGE_TAG}" \
                                --region "${AWS_DEFAULT_REGION}"
                        '''
                    }
                }
            }
        }

        // ============================================================
        // TERRAFORM
        // ============================================================

        stage('10 - Terraform Deployment') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    deleteDir()

                    git(
                        branch: "${TERRAFORM_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${TERRAFORM_REPO}"
                    )
                }

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh '''
                            set -eu

                            echo "================================================"
                            echo "TERRAFORM"
                            echo "================================================"

                            command -v terraform

                            terraform version

                            if [ ! -d "environments/${ENVIRONMENT}" ]; then

                                echo "ERROR: Terraform environment does not exist:"
                                echo "environments/${ENVIRONMENT}"

                                exit 1

                            fi

                            if [ ! -f "environments/${ENVIRONMENT}/terraform.tfvars" ]; then

                                echo "ERROR: terraform.tfvars not found."

                                exit 1

                            fi

                            terraform init \
                                -input=false

                            terraform validate

                            terraform plan \
                                -input=false \
                                -var-file="environments/${ENVIRONMENT}/terraform.tfvars" \
                                -out=tfplan

                            terraform apply \
                                -input=false \
                                -auto-approve \
                                tfplan

                            echo "Terraform deployment completed."
                        '''
                    }
                }
            }
        }

        // ============================================================
        // AWS NETWORK DISCOVERY
        //
        // THIS IS THE IMPORTANT FIX.
        //
        // We NEVER use AvailabilityZone as SUBNET_1/SUBNET_2.
        //
        // SUBNET_1 and SUBNET_2 contain actual:
        //
        // subnet-xxxxxxxx
        //
        // IDs.
        // ============================================================

        stage('11 - Discover AWS Network') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        echo '================================================'
                        echo 'DISCOVERING AWS NETWORK'
                        echo '================================================'

                        // ------------------------------------------------
                        // Find VPC
                        // ------------------------------------------------

                        env.VPC_ID = sh(
                            script: '''
                                set -eu

                                VPC_ID=$(aws ec2 describe-vpcs \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --filters \
                                        "Name=tag:Environment,Values=${ENVIRONMENT}" \
                                    --query 'Vpcs[0].VpcId' \
                                    --output text)

                                if [ "${VPC_ID}" = "None" ] ||
                                   [ -z "${VPC_ID}" ]; then

                                    VPC_ID=$(aws ec2 describe-vpcs \
                                        --region "${AWS_DEFAULT_REGION}" \
                                        --filters \
                                            "Name=is-default,Values=true" \
                                        --query 'Vpcs[0].VpcId' \
                                        --output text)

                                fi

                                if [ "${VPC_ID}" = "None" ] ||
                                   [ -z "${VPC_ID}" ]; then

                                    echo "ERROR: No VPC found."
                                    exit 1

                                fi

                                echo "${VPC_ID}"
                            ''',
                            returnStdout: true
                        ).trim()

                        echo "VPC ID: ${env.VPC_ID}"

                        // ------------------------------------------------
                        // IMPORTANT FIX
                        //
                        // Get ONLY SubnetId here.
                        //
                        // Do NOT query:
                        //
                        // {Id:SubnetId,AZ:AvailabilityZone}
                        //
                        // because parsing the text output can result in
                        // the AZ being assigned to SUBNET_1.
                        // ------------------------------------------------

                        def subnetIdsOutput = sh(
                            script: '''
                                set -eu

                                aws ec2 describe-subnets \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --filters \
                                        "Name=vpc-id,Values=${VPC_ID}" \
                                        "Name=state,Values=available" \
                                        "Name=map-public-ip-on-launch,Values=true" \
                                    --query 'Subnets[].SubnetId' \
                                    --output text
                            ''',
                            returnStdout: true
                        ).trim()

                        if (!subnetIdsOutput ||
                            subnetIdsOutput == 'None') {

                            error(
                                "No public subnets found in VPC ${env.VPC_ID}"
                            )
                        }

                        echo "Candidate subnet IDs:"
                        echo "${subnetIdsOutput}"

                        def subnetIds =
                            subnetIdsOutput
                                .split(/\s+/)
                                .findAll {
                                    it?.startsWith('subnet-')
                                }

                        if (subnetIds.size() < 2) {

                            error(
                                "At least 2 public subnets are required. " +
                                "Found: ${subnetIds}"
                            )
                        }

                        // ------------------------------------------------
                        // Find two subnet IDs in different AZs.
                        // ------------------------------------------------

                        def selectedSubnets = []
                        def usedAzs = []

                        subnetIds.each { subnetId ->

                            if (selectedSubnets.size() >= 2) {
                                return
                            }

                            def az = sh(
                                script: """
                                    aws ec2 describe-subnets \
                                        --region "${env.AWS_DEFAULT_REGION}" \
                                        --subnet-ids "${subnetId}" \
                                        --query 'Subnets[0].AvailabilityZone' \
                                        --output text
                                """,
                                returnStdout: true
                            ).trim()

                            echo "Subnet ${subnetId} -> AZ ${az}"

                            if (az &&
                                az != 'None' &&
                                !usedAzs.contains(az)) {

                                selectedSubnets.add(subnetId)
                                usedAzs.add(az)
                            }
                        }

                        if (selectedSubnets.size() < 2) {

                            error(
                                "Could not find two public subnets " +
                                "in different Availability Zones. " +
                                "Subnet candidates: ${subnetIds}"
                            )
                        }

                        env.SUBNET_1 = selectedSubnets[0]
                        env.SUBNET_2 = selectedSubnets[1]

                        env.SUBNET_1_AZ = usedAzs[0]
                        env.SUBNET_2_AZ = usedAzs[1]

                        // ------------------------------------------------
                        // FINAL VALIDATION
                        // ------------------------------------------------

                        if (!env.SUBNET_1.startsWith('subnet-')) {

                            error(
                                "SUBNET_1 is invalid: ${env.SUBNET_1}"
                            )
                        }

                        if (!env.SUBNET_2.startsWith('subnet-')) {

                            error(
                                "SUBNET_2 is invalid: ${env.SUBNET_2}"
                            )
                        }

                        if (env.SUBNET_1_AZ == env.SUBNET_2_AZ) {

                            error(
                                "SUBNET_1 and SUBNET_2 are in the same AZ."
                            )
                        }

                        echo ''
                        echo '================================================'
                        echo 'SELECTED PUBLIC SUBNETS'
                        echo '================================================'
                        echo "VPC      : ${env.VPC_ID}"
                        echo "Subnet 1 : ${env.SUBNET_1}"
                        echo "AZ 1     : ${env.SUBNET_1_AZ}"
                        echo "Subnet 2 : ${env.SUBNET_2}"
                        echo "AZ 2     : ${env.SUBNET_2_AZ}"
                        echo '================================================'

                        // ------------------------------------------------
                        // HARD SAFETY CHECK
                        //
                        // If anything other than subnet-* somehow enters
                        // the variables, stop before ALB creation.
                        // ------------------------------------------------

                        sh """
                            set -eu

                            case "${env.SUBNET_1}" in
                                subnet-*) ;;
                                *)
                                    echo "ERROR: Invalid SUBNET_1: ${env.SUBNET_1}"
                                    exit 1
                                    ;;
                            esac

                            case "${env.SUBNET_2}" in
                                subnet-*) ;;
                                *)
                                    echo "ERROR: Invalid SUBNET_2: ${env.SUBNET_2}"
                                    exit 1
                                    ;;
                            esac

                            echo "Subnet validation PASSED."
                        """
                    }
                }
            }
        }

        // ============================================================
        // IAM + SECURITY GROUPS
        // ============================================================

        stage('12 - Prepare ECS IAM and Security Groups') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        // ------------------------------------------------
                        // IAM ROLE
                        // ------------------------------------------------

                        sh '''
                            set -eu

                            echo "================================================"
                            echo "ECS EXECUTION ROLE"
                            echo "================================================"

                            EXECUTION_ROLE_NAME="practice1-ecsTaskExecutionRole"

                            if ! aws iam get-role \
                                --role-name "${EXECUTION_ROLE_NAME}" \
                                > /dev/null 2>&1
                            then

                                cat > /tmp/ecs-trust-policy.json <<'EOF'
{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "Service": "ecs-tasks.amazonaws.com"
      },
      "Action": "sts:AssumeRole"
    }
  ]
}
EOF

                                aws iam create-role \
                                    --role-name "${EXECUTION_ROLE_NAME}" \
                                    --assume-role-policy-document \
                                    file:///tmp/ecs-trust-policy.json
                            fi

                            aws iam attach-role-policy \
                                --role-name "${EXECUTION_ROLE_NAME}" \
                                --policy-arn \
                                arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy \
                                || true

                            sleep 5

                            aws iam get-role \
                                --role-name "${EXECUTION_ROLE_NAME}" \
                                --query 'Role.Arn' \
                                --output text
                        '''

                        // ------------------------------------------------
                        // SECURITY GROUPS
                        // ------------------------------------------------

                        sh '''
                            set -eu

                            echo "================================================"
                            echo "CREATING SECURITY GROUPS"
                            echo "================================================"

                            ALB_SG_ID=$(aws ec2 describe-security-groups \
                                --region "${AWS_DEFAULT_REGION}" \
                                --filters \
                                    "Name=vpc-id,Values=${VPC_ID}" \
                                    "Name=group-name,Values=${ALB_SG_NAME}" \
                                --query 'SecurityGroups[0].GroupId' \
                                --output text)

                            if [ "${ALB_SG_ID}" = "None" ] ||
                               [ -z "${ALB_SG_ID}" ]; then

                                ALB_SG_ID=$(aws ec2 create-security-group \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --group-name "${ALB_SG_NAME}" \
                                    --description "ALB security group for practice1" \
                                    --vpc-id "${VPC_ID}" \
                                    --query 'GroupId' \
                                    --output text)
                            fi

                            ECS_SG_ID=$(aws ec2 describe-security-groups \
                                --region "${AWS_DEFAULT_REGION}" \
                                --filters \
                                    "Name=vpc-id,Values=${VPC_ID}" \
                                    "Name=group-name,Values=${ECS_SG_NAME}" \
                                --query 'SecurityGroups[0].GroupId' \
                                --output text)

                            if [ "${ECS_SG_ID}" = "None" ] ||
                               [ -z "${ECS_SG_ID}" ]; then

                                ECS_SG_ID=$(aws ec2 create-security-group \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --group-name "${ECS_SG_NAME}" \
                                    --description "ECS Fargate security group for practice1" \
                                    --vpc-id "${VPC_ID}" \
                                    --query 'GroupId' \
                                    --output text)
                            fi

                            echo "ALB SG: ${ALB_SG_ID}"
                            echo "ECS SG: ${ECS_SG_ID}"

                            # ALB accepts HTTP from Internet
                            aws ec2 authorize-security-group-ingress \
                                --region "${AWS_DEFAULT_REGION}" \
                                --group-id "${ALB_SG_ID}" \
                                --protocol tcp \
                                --port 80 \
                                --cidr 0.0.0.0/0 \
                                2>/dev/null || true

                            # ECS accepts 8501 ONLY from ALB
                            aws ec2 authorize-security-group-ingress \
                                --region "${AWS_DEFAULT_REGION}" \
                                --group-id "${ECS_SG_ID}" \
                                --protocol tcp \
                                --port "${CONTAINER_PORT}" \
                                --source-group "${ALB_SG_ID}" \
                                2>/dev/null || true

                            # ECS outbound Internet
                            aws ec2 authorize-security-group-egress \
                                --region "${AWS_DEFAULT_REGION}" \
                                --group-id "${ECS_SG_ID}" \
                                --protocol -1 \
                                --cidr 0.0.0.0/0 \
                                2>/dev/null || true

                            # ALB outbound Internet
                            aws ec2 authorize-security-group-egress \
                                --region "${AWS_DEFAULT_REGION}" \
                                --group-id "${ALB_SG_ID}" \
                                --protocol -1 \
                                --cidr 0.0.0.0/0 \
                                2>/dev/null || true
                        '''

                        env.ALB_SG_ID = sh(
                            script: '''
                                aws ec2 describe-security-groups \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --filters \
                                        "Name=vpc-id,Values=${VPC_ID}" \
                                        "Name=group-name,Values=${ALB_SG_NAME}" \
                                    --query 'SecurityGroups[0].GroupId' \
                                    --output text
                            ''',
                            returnStdout: true
                        ).trim()

                        env.ECS_SG_ID = sh(
                            script: '''
                                aws ec2 describe-security-groups \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --filters \
                                        "Name=vpc-id,Values=${VPC_ID}" \
                                        "Name=group-name,Values=${ECS_SG_NAME}" \
                                    --query 'SecurityGroups[0].GroupId' \
                                    --output text
                            ''',
                            returnStdout: true
                        ).trim()

                        if (!env.ALB_SG_ID.startsWith('sg-')) {

                            error(
                                "Invalid ALB security group: ${env.ALB_SG_ID}"
                            )
                        }

                        if (!env.ECS_SG_ID.startsWith('sg-')) {

                            error(
                                "Invalid ECS security group: ${env.ECS_SG_ID}"
                            )
                        }

                        echo "ALB SG ID: ${env.ALB_SG_ID}"
                        echo "ECS SG ID: ${env.ECS_SG_ID}"
                    }
                }
            }
        }

        // ============================================================
        // ALB + TARGET GROUP
        // ============================================================

        stage('13 - Create ALB and Target Group') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        echo '================================================'
                        echo 'ALB CREATION'
                        echo '================================================'

                        // ------------------------------------------------
                        // EXTRA SUBNET VALIDATION BEFORE ALB
                        // ------------------------------------------------

                        sh '''
                            set -eu

                            echo "Validating subnet IDs before ALB creation..."

                            aws ec2 describe-subnets \
                                --region "${AWS_DEFAULT_REGION}" \
                                --subnet-ids "${SUBNET_1}" "${SUBNET_2}" \
                                --query 'Subnets[].{SubnetId:SubnetId,AZ:AvailabilityZone,State:State,PublicIP:MapPublicIpOnLaunch}' \
                                --output table

                            echo ""
                            echo "ALB will use:"
                            echo "SUBNET_1=${SUBNET_1}"
                            echo "SUBNET_2=${SUBNET_2}"

                            case "${SUBNET_1}" in
                                subnet-*) ;;
                                *)
                                    echo "ERROR: SUBNET_1 is not a subnet ID."
                                    exit 1
                                    ;;
                            esac

                            case "${SUBNET_2}" in
                                subnet-*) ;;
                                *)
                                    echo "ERROR: SUBNET_2 is not a subnet ID."
                                    exit 1
                                    ;;
                            esac
                        '''

                        // ------------------------------------------------
                        // FIND EXISTING ALB
                        // ------------------------------------------------

                        env.ALB_ARN = sh(
                            script: '''
                                aws elbv2 describe-load-balancers \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --names "${ALB_NAME}" \
                                    --query 'LoadBalancers[0].LoadBalancerArn' \
                                    --output text \
                                    2>/dev/null || true
                            ''',
                            returnStdout: true
                        ).trim()

                        // ------------------------------------------------
                        // CREATE ALB
                        // ------------------------------------------------

                        if (!env.ALB_ARN ||
                            env.ALB_ARN == 'None') {

                            echo "ALB does not exist. Creating ALB..."

                            env.ALB_ARN = sh(
                                script: '''
                                    set -eu

                                    aws elbv2 create-load-balancer \
                                        --region "${AWS_DEFAULT_REGION}" \
                                        --name "${ALB_NAME}" \
                                        --subnets "${SUBNET_1}" "${SUBNET_2}" \
                                        --security-groups "${ALB_SG_ID}" \
                                        --scheme internet-facing \
                                        --type application \
                                        --ip-address-type ipv4 \
                                        --query 'LoadBalancers[0].LoadBalancerArn' \
                                        --output text
                                ''',
                                returnStdout: true
                            ).trim()

                        } else {

                            echo "ALB already exists:"
                            echo "${env.ALB_ARN}"
                        }

                        if (!env.ALB_ARN.startsWith('arn:aws:elasticloadbalancing:')) {

                            error(
                                "Invalid ALB ARN: ${env.ALB_ARN}"
                            )
                        }

                        // ------------------------------------------------
                        // WAIT FOR ALB
                        // ------------------------------------------------

                        sh '''
                            set -eu

                            echo "Waiting for ALB to become available..."

                            aws elbv2 wait load-balancer-available \
                                --region "${AWS_DEFAULT_REGION}" \
                                --load-balancer-arns "${ALB_ARN}"
                        '''

                        // ------------------------------------------------
                        // ALB DNS
                        // ------------------------------------------------

                        env.ALB_DNS = sh(
                            script: '''
                                aws elbv2 describe-load-balancers \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --load-balancer-arns "${ALB_ARN}" \
                                    --query 'LoadBalancers[0].DNSName' \
                                    --output text
                            ''',
                            returnStdout: true
                        ).trim()

                        echo "ALB DNS: ${env.ALB_DNS}"

                        // ------------------------------------------------
                        // TARGET GROUP
                        // ------------------------------------------------

                        env.TARGET_GROUP_ARN = sh(
                            script: '''
                                aws elbv2 describe-target-groups \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --names "${TARGET_GROUP_NAME}" \
                                    --query 'TargetGroups[0].TargetGroupArn' \
                                    --output text \
                                    2>/dev/null || true
                            ''',
                            returnStdout: true
                        ).trim()

                        if (!env.TARGET_GROUP_ARN ||
                            env.TARGET_GROUP_ARN == 'None') {

                            echo "Creating target group..."

                            env.TARGET_GROUP_ARN = sh(
                                script: '''
                                    aws elbv2 create-target-group \
                                        --region "${AWS_DEFAULT_REGION}" \
                                        --name "${TARGET_GROUP_NAME}" \
                                        --protocol HTTP \
                                        --port "${CONTAINER_PORT}" \
                                        --target-type ip \
                                        --vpc-id "${VPC_ID}" \
                                        --health-check-protocol HTTP \
                                        --health-check-path "${HEALTH_PATH}" \
                                        --health-check-port traffic-port \
                                        --health-check-interval-seconds 10 \
                                        --health-check-timeout-seconds 5 \
                                        --healthy-threshold-count 2 \
                                        --unhealthy-threshold-count 5 \
                                        --matcher HttpCode=200-399 \
                                        --query 'TargetGroups[0].TargetGroupArn' \
                                        --output text
                                ''',
                                returnStdout: true
                            ).trim()

                        } else {

                            echo "Target group already exists."

                            // ------------------------------------------------
                            // IMPORTANT:
                            // Correct existing target group health settings.
                            // ------------------------------------------------

                            sh '''
                                set -eu

                                aws elbv2 modify-target-group \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --target-group-arn "${TARGET_GROUP_ARN}" \
                                    --health-check-protocol HTTP \
                                    --health-check-path "${HEALTH_PATH}" \
                                    --health-check-port traffic-port \
                                    --health-check-interval-seconds 10 \
                                    --health-check-timeout-seconds 5 \
                                    --healthy-threshold-count 2 \
                                    --unhealthy-threshold-count 5 \
                                    --matcher 'HttpCode=200-399'
                            '''
                        }

                        echo "Target Group ARN:"
                        echo "${env.TARGET_GROUP_ARN}"

                        // ------------------------------------------------
                        // LISTENER
                        // ------------------------------------------------

                        sh '''
                            set -eu

                            LISTENER_ARN=$(aws elbv2 describe-listeners \
                                --region "${AWS_DEFAULT_REGION}" \
                                --load-balancer-arn "${ALB_ARN}" \
                                --query 'Listeners[?Port==`80`].ListenerArn | [0]' \
                                --output text)

                            if [ "${LISTENER_ARN}" = "None" ] ||
                               [ -z "${LISTENER_ARN}" ]; then

                                echo "Creating HTTP listener..."

                                aws elbv2 create-listener \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --load-balancer-arn "${ALB_ARN}" \
                                    --protocol HTTP \
                                    --port 80 \
                                    --default-actions \
                                    Type=forward,TargetGroupArn="${TARGET_GROUP_ARN}"

                            else

                                echo "HTTP listener already exists."

                                aws elbv2 modify-listener \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --listener-arn "${LISTENER_ARN}" \
                                    --default-actions \
                                    Type=forward,TargetGroupArn="${TARGET_GROUP_ARN}"

                            fi
                        '''

                        echo ''
                        echo '================================================'
                        echo 'ALB CREATED / VERIFIED'
                        echo '================================================'
                        echo "ALB ARN      : ${env.ALB_ARN}"
                        echo "ALB DNS      : ${env.ALB_DNS}"
                        echo "Target Group : ${env.TARGET_GROUP_ARN}"
                        echo "Health Path  : ${env.HEALTH_PATH}"
                        echo "Health Port  : ${env.CONTAINER_PORT}"
                        echo '================================================'
                    }
                }
            }
        }

        // ============================================================
        // ECS CLUSTER
        // ============================================================

        stage('14 - Create ECS Cluster') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "ECS CLUSTER"
                        echo "================================================"

                        CLUSTER_STATUS=$(aws ecs describe-clusters \
                            --region "${AWS_DEFAULT_REGION}" \
                            --clusters "${ECS_CLUSTER}" \
                            --query 'clusters[0].status' \
                            --output text \
                            2>/dev/null || true)

                        echo "Cluster status: ${CLUSTER_STATUS}"

                        if [ "${CLUSTER_STATUS}" != "ACTIVE" ]; then

                            aws ecs create-cluster \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster-name "${ECS_CLUSTER}" \
                                > /dev/null 2>&1 || true

                        fi

                        for i in $(seq 1 20)
                        do

                            STATUS=$(aws ecs describe-clusters \
                                --region "${AWS_DEFAULT_REGION}" \
                                --clusters "${ECS_CLUSTER}" \
                                --query 'clusters[0].status' \
                                --output text \
                                2>/dev/null || true)

                            echo "Cluster check ${i}/20: ${STATUS}"

                            if [ "${STATUS}" = "ACTIVE" ]; then
                                break
                            fi

                            sleep 3
                        done

                        FINAL_STATUS=$(aws ecs describe-clusters \
                            --region "${AWS_DEFAULT_REGION}" \
                            --clusters "${ECS_CLUSTER}" \
                            --query 'clusters[0].status' \
                            --output text)

                        if [ "${FINAL_STATUS}" != "ACTIVE" ]; then

                            echo "ERROR: ECS cluster is not ACTIVE."
                            exit 1

                        fi

                        echo "ECS cluster is ACTIVE."
                    '''
                }
            }
        }

        // ============================================================
        // TASK DEFINITION
        // ============================================================

        stage('15 - Register ECS Task Definition') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        env.EXECUTION_ROLE_ARN = sh(
                            script: '''
                                aws iam get-role \
                                    --role-name "practice1-ecsTaskExecutionRole" \
                                    --query 'Role.Arn' \
                                    --output text
                            ''',
                            returnStdout: true
                        ).trim()

                        if (!env.EXECUTION_ROLE_ARN ||
                            env.EXECUTION_ROLE_ARN == 'None') {

                            error(
                                'ECS execution role ARN could not be determined.'
                            )
                        }

                        sh '''
                            set -eu

                            echo "================================================"
                            echo "ECS TASK DEFINITION"
                            echo "================================================"

                            cat > task-definition.json <<EOF
{
  "family": "${ECS_TASK_FAMILY}",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "${FARGATE_CPU}",
  "memory": "${FARGATE_MEMORY}",
  "executionRoleArn": "${EXECUTION_ROLE_ARN}",
  "containerDefinitions": [
    {
      "name": "${ECS_CONTAINER_NAME}",
      "image": "${ECR_IMAGE}",
      "essential": true,
      "portMappings": [
        {
          "containerPort": ${CONTAINER_PORT},
          "hostPort": ${CONTAINER_PORT},
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "STREAMLIT_SERVER_ADDRESS",
          "value": "0.0.0.0"
        },
        {
          "name": "STREAMLIT_SERVER_PORT",
          "value": "${CONTAINER_PORT}"
        },
        {
          "name": "STREAMLIT_SERVER_HEADLESS",
          "value": "true"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/${ECS_TASK_FAMILY}",
          "awslogs-region": "${AWS_DEFAULT_REGION}",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
EOF

                            python3 -m json.tool \
                                task-definition.json \
                                > /dev/null

                            aws logs create-log-group \
                                --log-group-name "/ecs/${ECS_TASK_FAMILY}" \
                                --region "${AWS_DEFAULT_REGION}" \
                                2>/dev/null || true

                            aws ecs register-task-definition \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cli-input-json file://task-definition.json

                            TASK_DEFINITION_ARN=$(aws ecs describe-task-definition \
                                --region "${AWS_DEFAULT_REGION}" \
                                --task-definition "${ECS_TASK_FAMILY}" \
                                --query 'taskDefinition.taskDefinitionArn' \
                                --output text)

                            if [ -z "${TASK_DEFINITION_ARN}" ] ||
                               [ "${TASK_DEFINITION_ARN}" = "None" ]; then

                                echo "ERROR: Task definition ARN not found."
                                exit 1

                            fi

                            echo "Task Definition:"
                            echo "${TASK_DEFINITION_ARN}"
                        '''
                    }
                }
            }
        }

        // ============================================================
        // ECS SERVICE
        // ============================================================

        stage('16 - Deploy ECS Fargate Service') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "ECS FARGATE SERVICE"
                        echo "================================================"

                        SERVICE_STATUS=$(aws ecs describe-services \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}" \
                            --query 'services[0].status' \
                            --output text \
                            2>/dev/null || true)

                        echo "Existing service status: ${SERVICE_STATUS}"

                        if [ "${SERVICE_STATUS}" = "ACTIVE" ]; then

                            echo "Updating ECS service..."

                            aws ecs update-service \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --service "${ECS_SERVICE}" \
                                --task-definition "${ECS_TASK_FAMILY}" \
                                --desired-count 1 \
                                --force-new-deployment

                        else

                            echo "Creating ECS service..."

                            aws ecs create-service \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --service-name "${ECS_SERVICE}" \
                                --task-definition "${ECS_TASK_FAMILY}" \
                                --desired-count 1 \
                                --launch-type FARGATE \
                                --platform-version LATEST \
                                --network-configuration \
                                    "awsvpcConfiguration={subnets=[${SUBNET_1},${SUBNET_2}],securityGroups=[${ECS_SG_ID}],assignPublicIp=ENABLED}" \
                                --load-balancers \
                                    "targetGroupArn=${TARGET_GROUP_ARN},containerName=${ECS_CONTAINER_NAME},containerPort=${CONTAINER_PORT}"
                        fi

                        echo ""
                        echo "Waiting for ECS task..."

                        RUNNING_COUNT=0

                        for i in $(seq 1 60)
                        do

                            SERVICE_INFO=$(aws ecs describe-services \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --services "${ECS_SERVICE}" \
                                --query 'services[0].[status,desiredCount,runningCount,pendingCount]' \
                                --output text \
                                2>/dev/null || true)

                            STATUS=$(echo "${SERVICE_INFO}" | awk '{print $1}')
                            DESIRED=$(echo "${SERVICE_INFO}" | awk '{print $2}')
                            RUNNING=$(echo "${SERVICE_INFO}" | awk '{print $3}')
                            PENDING=$(echo "${SERVICE_INFO}" | awk '{print $4}')

                            echo "Check ${i}/60: status=${STATUS} desired=${DESIRED} running=${RUNNING} pending=${PENDING}"

                            if [ "${STATUS}" = "ACTIVE" ] &&
                               [ "${RUNNING:-0}" -ge 1 ]; then

                                RUNNING_COUNT="${RUNNING}"
                                break

                            fi

                            sleep 5
                        done

                        if [ "${RUNNING_COUNT}" -lt 1 ]; then

                            echo "ERROR: ECS service has no running task."

                            aws ecs describe-services \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --services "${ECS_SERVICE}" \
                                --query 'services[0].{Status:status,Desired:desiredCount,Running:runningCount,Pending:pendingCount,Events:events[0:15]}' \
                                --output json || true

                            exit 1

                        fi

                        echo "ECS service has a running task."
                    '''
                }
            }
        }

        // ============================================================
        // ECS TASK VERIFICATION
        // ============================================================

        stage('17 - Verify Running ECS Task') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "VERIFYING ECS TASK"
                        echo "================================================"

                        TASK_ARN=""

                        for i in $(seq 1 36)
                        do

                            TASK_ARN=$(aws ecs list-tasks \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --service-name "${ECS_SERVICE}" \
                                --desired-status RUNNING \
                                --query 'taskArns[0]' \
                                --output text \
                                2>/dev/null || true)

                            echo "Task lookup ${i}/36: ${TASK_ARN}"

                            if [ -n "${TASK_ARN}" ] &&
                               [ "${TASK_ARN}" != "None" ]; then

                                break

                            fi

                            sleep 5

                        done

                        if [ -z "${TASK_ARN}" ] ||
                           [ "${TASK_ARN}" = "None" ]; then

                            echo "ERROR: Running ECS task not found."
                            exit 1

                        fi

                        TASK_STATUS=$(aws ecs describe-tasks \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --tasks "${TASK_ARN}" \
                            --query 'tasks[0].lastStatus' \
                            --output text)

                        CONTAINER_STATUS=$(aws ecs describe-tasks \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --tasks "${TASK_ARN}" \
                            --query "tasks[0].containers[?name=='${ECS_CONTAINER_NAME}'].lastStatus | [0]" \
                            --output text)

                        TASK_IP=$(aws ecs describe-tasks \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --tasks "${TASK_ARN}" \
                            --query 'tasks[0].attachments[0].details[?name==`privateIPv4Address`].value | [0]' \
                            --output text)

                        echo "Task ARN        : ${TASK_ARN}"
                        echo "Task Status     : ${TASK_STATUS}"
                        echo "Task Private IP : ${TASK_IP}"
                        echo "Container       : ${ECS_CONTAINER_NAME}"
                        echo "Container State : ${CONTAINER_STATUS}"

                        if [ "${TASK_STATUS}" != "RUNNING" ]; then

                            aws ecs describe-tasks \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --tasks "${TASK_ARN}" \
                                --query 'tasks[0].{LastStatus:lastStatus,DesiredStatus:desiredStatus,StoppedReason:stoppedReason,StopCode:stopCode,Containers:containers}' \
                                --output json || true

                            exit 1

                        fi

                        if [ "${CONTAINER_STATUS}" != "RUNNING" ]; then

                            echo "ERROR: Container is not RUNNING."

                            aws ecs describe-tasks \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --tasks "${TASK_ARN}" \
                                --query 'tasks[0].containers' \
                                --output json || true

                            exit 1

                        fi

                        echo "ECS TASK: RUNNING"
                        echo "CONTAINER: RUNNING"
                    '''
                }
            }
        }

        // ============================================================
        // ALB HEALTH CHECK
        // ============================================================

        stage('18 - Verify ALB Target Health') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "ALB TARGET HEALTH CHECK"
                        echo "================================================"

                        echo "Target Group : ${TARGET_GROUP_ARN}"
                        echo "Health Path  : ${HEALTH_PATH}"
                        echo "Health Port  : ${CONTAINER_PORT}"

                        echo ""
                        echo "ALB target health will be checked for up to 5 minutes."

                        for i in $(seq 1 60)
                        do

                            TARGET_HEALTH=$(aws elbv2 describe-target-health \
                                --region "${AWS_DEFAULT_REGION}" \
                                --target-group-arn "${TARGET_GROUP_ARN}" \
                                --query 'TargetHealthDescriptions[0].TargetHealth' \
                                --output json \
                                2>/dev/null || echo '{}')

                            HEALTH=$(echo "${TARGET_HEALTH}" |
                                python3 -c '
import json
import sys

try:
    data=json.load(sys.stdin)
    print(data.get("State","unknown"))
except:
    print("unknown")
')

                            REASON=$(echo "${TARGET_HEALTH}" |
                                python3 -c '
import json
import sys

try:
    data=json.load(sys.stdin)
    print(data.get("Reason",""))
except:
    print("")
')

                            DESCRIPTION=$(echo "${TARGET_HEALTH}" |
                                python3 -c '
import json
import sys

try:
    data=json.load(sys.stdin)
    print(data.get("Description",""))
except:
    print("")
')

                            echo ""
                            echo "Health check ${i}/60"
                            echo "State       : ${HEALTH}"
                            echo "Reason      : ${REASON}"
                            echo "Description : ${DESCRIPTION}"

                            if [ "${HEALTH}" = "healthy" ]; then

                                echo ""
                                echo "================================================"
                                echo "ALB TARGET IS HEALTHY"
                                echo "================================================"

                                aws elbv2 describe-target-health \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --target-group-arn "${TARGET_GROUP_ARN}" \
                                    --output table

                                exit 0
                            fi

                            sleep 5
                        done

                        echo ""
                        echo "================================================"
                        echo "ALB TARGET FAILED HEALTH CHECK"
                        echo "================================================"

                        aws elbv2 describe-target-health \
                            --region "${AWS_DEFAULT_REGION}" \
                            --target-group-arn "${TARGET_GROUP_ARN}" \
                            --output json || true

                        echo ""
                        echo "ECS service events:"

                        aws ecs describe-services \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}" \
                            --query 'services[0].events[0:15]' \
                            --output table || true

                        exit 1
                    '''
                }
            }
        }

        // ============================================================
        // APPLICATION HTTP CHECK
        // ============================================================

        stage('19 - Verify Application Through ALB') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "APPLICATION HTTP CHECK"
                        echo "================================================"

                        command -v curl

                        ALB_DNS=$(aws elbv2 describe-load-balancers \
                            --region "${AWS_DEFAULT_REGION}" \
                            --load-balancer-arns "${ALB_ARN}" \
                            --query 'LoadBalancers[0].DNSName' \
                            --output text)

                        if [ -z "${ALB_DNS}" ] ||
                           [ "${ALB_DNS}" = "None" ]; then

                            echo "ERROR: ALB DNS could not be determined."
                            exit 1

                        fi

                        APPLICATION_URL="http://${ALB_DNS}${HEALTH_PATH}"

                        echo ""
                        echo "ALB DNS:"
                        echo "${ALB_DNS}"

                        echo ""
                        echo "APPLICATION URL:"
                        echo "${APPLICATION_URL}"

                        HTTP_CODE="000"

                        for i in $(seq 1 12)
                        do

                            HTTP_CODE=$(curl \
                                --silent \
                                --show-error \
                                --output /dev/null \
                                --write-out "%{http_code}" \
                                --connect-timeout 10 \
                                --max-time 15 \
                                "${APPLICATION_URL}" \
                                || true)

                            echo "HTTP check ${i}/12: ${HTTP_CODE}"

                            case "${HTTP_CODE}" in

                                2*|3*)

                                    echo ""
                                    echo "================================================"
                                    echo "APPLICATION IS REACHABLE"
                                    echo "================================================"

                                    echo "HTTP STATUS: ${HTTP_CODE}"
                                    echo "URL: ${APPLICATION_URL}"

                                    exit 0
                                    ;;

                            esac

                            sleep 5
                        done

                        echo ""
                        echo "APPLICATION HTTP CHECK FAILED"
                        echo "Final HTTP status: ${HTTP_CODE}"

                        echo ""
                        echo "ALB target health:"

                        aws elbv2 describe-target-health \
                            --region "${AWS_DEFAULT_REGION}" \
                            --target-group-arn "${TARGET_GROUP_ARN}" \
                            --output table || true

                        exit 1
                    '''
                }
            }
        }

        // ============================================================
        // FINAL SUMMARY
        // ============================================================

        stage('20 - Final Deployment Summary') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        env.ALB_DNS = sh(
                            script: '''
                                aws elbv2 describe-load-balancers \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --load-balancer-arns "${ALB_ARN}" \
                                    --query 'LoadBalancers[0].DNSName' \
                                    --output text
                            ''',
                            returnStdout: true
                        ).trim()

                        env.APPLICATION_URL =
                            "http://${env.ALB_DNS}${env.HEALTH_PATH}"

                        echo ''
                        echo '================================================'
                        echo '       DEPLOYMENT SUCCESSFUL'
                        echo '================================================'

                        echo "Environment     : ${env.ENVIRONMENT}"
                        echo "ECR Image       : ${env.ECR_IMAGE}"
                        echo "ECS Cluster     : ${env.ECS_CLUSTER}"
                        echo "ECS Service     : ${env.ECS_SERVICE}"
                        echo "ALB Name        : ${env.ALB_NAME}"
                        echo "ALB DNS         : ${env.ALB_DNS}"
                        echo "Target Group    : ${env.TARGET_GROUP_ARN}"
                        echo "Health Path     : ${env.HEALTH_PATH}"
                        echo "Container Port  : ${env.CONTAINER_PORT}"

                        echo ''
                        echo '------------------------------------------------'
                        echo 'APPLICATION URL'
                        echo '------------------------------------------------'

                        echo "${env.APPLICATION_URL}"

                        echo ''
                        echo '------------------------------------------------'
                        echo 'INFRASTRUCTURE'
                        echo '------------------------------------------------'

                        echo "VPC             : ${env.VPC_ID}"
                        echo "Subnet 1        : ${env.SUBNET_1}"
                        echo "Subnet 1 AZ     : ${env.SUBNET_1_AZ}"
                        echo "Subnet 2        : ${env.SUBNET_2}"
                        echo "Subnet 2 AZ     : ${env.SUBNET_2_AZ}"
                        echo "ALB SG          : ${env.ALB_SG_ID}"
                        echo "ECS SG          : ${env.ECS_SG_ID}"

                        echo ''
                        echo '================================================'
                        echo ' ECS SERVICE      : RUNNING'
                        echo ' FARGATE TASK     : RUNNING'
                        echo ' CONTAINER        : RUNNING'
                        echo ' ALB              : AVAILABLE'
                        echo ' ALB TARGET       : HEALTHY'
                        echo ' APPLICATION HTTP : PASSED'
                        echo '================================================'

                        echo ''
                        echo 'OPEN THIS URL:'
                        echo "${env.APPLICATION_URL}"
                        echo ''
                    }
                }
            }
        }
    }

    // ================================================================
    // POST ACTIONS
    // ================================================================

    post {

        success {

            echo ''
            echo '================================================'
            echo '       COMPLETE CI/CD PIPELINE SUCCESS'
            echo '================================================'

            echo ''
            echo 'APPLICATION CODE      : PASSED'
            echo 'CODE QUALITY          : PASSED'
            echo 'AUTOMATED TESTS       : PASSED'
            echo 'DOCKER BUILD          : PASSED'
            echo 'ECR PUSH              : PASSED'
            echo 'TERRAFORM             : PASSED'
            echo 'ALB                   : AVAILABLE'
            echo 'ALB TARGET            : HEALTHY'
            echo 'APPLICATION HTTP      : PASSED'
            echo 'ECS FARGATE           : PASSED'
            echo 'ECS TASK              : RUNNING'
            echo 'CONTAINER             : RUNNING'

            echo ''
            echo '================================================'
            echo '          APPLICATION URL'
            echo '================================================'

            echo "${env.APPLICATION_URL}"

            echo ''
            echo '================================================'
            echo '          DEPLOYMENT COMPLETE'
            echo '================================================'
        }

        failure {

            echo ''
            echo '================================================'
            echo '          CI/CD PIPELINE FAILED'
            echo '================================================'

            echo ''
            echo 'The pipeline stopped because a deployment step failed.'

            echo ''
            echo 'Check the Jenkins console output for the exact failing stage.'

            echo ''
            echo 'Important areas:'
            echo '1. Python / tests'
            echo '2. Docker'
            echo '3. ECR'
            echo '4. Terraform'
            echo '5. VPC / subnet discovery'
            echo '6. Security groups'
            echo '7. IAM'
            echo '8. ALB'
            echo '9. Target group'
            echo '10. ECS cluster'
            echo '11. ECS task'
            echo '12. ALB target health'
            echo '13. Application HTTP check'

            echo ''
            echo '================================================'
        }

        always {

            echo ''
            echo '================================================'
            echo 'CLEANING JENKINS WORKSPACE'
            echo '================================================'

            cleanWs(
                deleteDirs: true,
                disableDeferredWipeout: true
            )
        }
    }
}
