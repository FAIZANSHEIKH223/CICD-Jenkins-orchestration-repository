pipeline {

    agent any

    options {
        timestamps()
        ansiColor('xterm')
        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                daysToKeepStr: '30',
                numToKeepStr: '50'
            )
        )

        timeout(
            time: 90,
            unit: 'MINUTES'
        )
    }

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: [
                'dev',
                'qa',
                'prod'
            ],
            description: 'Select Terraform environment'
        )

        choice(
            name: 'ACTION',
            choices: [
                'DEPLOY',
                'DESTROY'
            ],
            description: 'Select infrastructure action'
        )
    }

    environment {

        AWS_DEFAULT_REGION = 'us-east-1'

        TERRAFORM_REPO =
            'https://github.com/FAIZANSHEIKH223/terraform-aws-infra.git'

        APPLICATION_REPO =
            'https://github.com/FAIZANSHEIKH223/practice1.git'

        QUALITY_REPO =
            'https://github.com/FAIZANSHEIKH223/pylint_flake8_int_jenkins.git'

        ORCHESTRATION_REPO =
            'https://github.com/FAIZANSHEIKH223/CICD-Jenkins-orchestration-repository.git'

        GITHUB_CREDENTIALS = 'github-creds'

        AWS_CREDENTIALS = 'aws-creds'

        TERRAFORM_DIR = 'terraform-aws-infra'

        APPLICATION_DIR = 'application'

        QUALITY_DIR = 'quality-tools'

        ORCHESTRATION_DIR = 'orchestration'

        PROJECT_NAME = 'terraform-demo'

        ECR_REPOSITORY = 'terraform-demo-dev'

        ECS_CLUSTER = 'terraform-demo-dev-cluster'

        ECS_SERVICE = 'terraform-demo-service'

        ECS_TASK_FAMILY = 'terraform-demo-task'

        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages {

        /*
         * ============================================================
         * CHECK REQUIRED TOOLS
         * ============================================================
         */

        stage('Check Required Tools') {

            steps {

                sh '''
                    set -e

                    echo "=========================================="
                    echo "Checking Required Tools"
                    echo "=========================================="

                    echo ""
                    echo "Terraform:"
                    terraform version

                    echo ""
                    echo "AWS CLI:"
                    aws --version

                    echo ""
                    echo "Docker:"
                    docker --version

                    echo ""
                    echo "Python:"
                    python3.12 --version

                    echo ""
                    echo "JQ:"
                    jq --version

                    echo ""
                    echo "Curl:"
                    curl --version | head -n 1

                    echo ""
                    echo "Git:"
                    git --version

                    echo ""
                    echo "=========================================="
                    echo "All Required Tools Found"
                    echo "=========================================="
                '''
            }
        }


        /*
         * ============================================================
         * PIPELINE INFORMATION
         * ============================================================
         */

        stage('Pipeline Information') {

            steps {

                echo """
==========================================
JENKINS CI/CD PIPELINE
==========================================

Environment : ${params.ENVIRONMENT}
Action      : ${params.ACTION}
Build       : ${BUILD_NUMBER}

Repositories:

1. Terraform
   ${env.TERRAFORM_REPO}

2. Application
   ${env.APPLICATION_REPO}

3. Quality Tools
   ${env.QUALITY_REPO}

4. Orchestration
   ${env.ORCHESTRATION_REPO}

==========================================
"""
            }
        }


        /*
         * ============================================================
         * CHECKOUT TERRAFORM REPOSITORY
         * ============================================================
         */

        stage('Checkout Terraform Repository') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    deleteDir()

                    git(
                        branch: 'main',
                        credentialsId: "${env.GITHUB_CREDENTIALS}",
                        url: "${env.TERRAFORM_REPO}"
                    )
                }
            }
        }


        /*
         * ============================================================
         * CHECKOUT APPLICATION REPOSITORY
         * ============================================================
         */

        stage('Checkout Application Repository') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    deleteDir()

                    git(
                        branch: 'main',
                        credentialsId: "${env.GITHUB_CREDENTIALS}",
                        url: "${env.APPLICATION_REPO}"
                    )
                }
            }
        }


        /*
         * ============================================================
         * CHECKOUT QUALITY REPOSITORY
         * ============================================================
         */

        stage('Checkout Quality Repository') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.QUALITY_DIR}") {

                    deleteDir()

                    git(
                        branch: 'main',
                        credentialsId: "${env.GITHUB_CREDENTIALS}",
                        url: "${env.QUALITY_REPO}"
                    )
                }
            }
        }


        /*
         * ============================================================
         * CHECKOUT ORCHESTRATION REPOSITORY
         * ============================================================
         */

        stage('Checkout Orchestration Repository') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.ORCHESTRATION_DIR}") {

                    deleteDir()

                    git(
                        branch: 'main',
                        credentialsId: "${env.GITHUB_CREDENTIALS}",
                        url: "${env.ORCHESTRATION_REPO}"
                    )
                }
            }
        }


        /*
         * ============================================================
         * VERIFY ALL FOUR REPOSITORIES
         * ============================================================
         */

        stage('Verify All Repositories') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                sh '''
                    set -e

                    echo "=========================================="
                    echo "Verifying Four Repositories"
                    echo "=========================================="

                    echo ""
                    echo "Terraform repository:"
                    test -d "$TERRAFORM_DIR"
                    ls -la "$TERRAFORM_DIR" | head

                    echo ""
                    echo "Application repository:"
                    test -d "$APPLICATION_DIR"
                    ls -la "$APPLICATION_DIR" | head

                    echo ""
                    echo "Quality repository:"
                    test -d "$QUALITY_DIR"
                    ls -la "$QUALITY_DIR" | head

                    echo ""
                    echo "Orchestration repository:"
                    test -d "$ORCHESTRATION_DIR"
                    ls -la "$ORCHESTRATION_DIR" | head

                    echo ""
                    echo "All four repositories verified successfully."
                '''
            }
        }


        /*
         * ============================================================
         * FIX TERRAFORM IMPORT CONFIGURATION
         *
         * IMPORTANT:
         *
         * This version DOES NOT use:
         *
         *     < <(...)
         *
         * Therefore it works with Jenkins /bin/sh.
         *
         * Python scans every .tf file automatically.
         * No manual Terraform modification is required.
         * ============================================================
         */

        stage('Fix Terraform Import Configuration') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    sh '''
                        set -e

                        echo "=========================================="
                        echo "Checking Terraform Import Blocks"
                        echo "=========================================="

                        python3.12 <<'PYTHON'

import os
import re
import shutil

target = "module.ec2.aws_iam_role.ecs_instance_role"

found = False

for root, dirs, files in os.walk("."):

    dirs[:] = [
        d for d in dirs
        if d not in [".git", ".terraform"]
    ]

    for filename in files:

        if not filename.endswith(".tf"):
            continue

        filepath = os.path.join(root, filename)

        try:
            with open(
                filepath,
                "r",
                encoding="utf-8"
            ) as file:
                content = file.read()

        except Exception as error:
            print(
                f"Unable to read {filepath}: {error}"
            )
            continue

        if target not in content:
            continue

        print("")
        print("Found stale import configuration:")
        print(filepath)

        pattern = re.compile(
            r'import\\s*\\{.*?\\}',
            re.DOTALL
        )

        matches = pattern.findall(content)

        new_content = content
        removed = 0

        for block in matches:

            if target in block:

                new_content = new_content.replace(
                    block,
                    "",
                    1
                )

                removed += 1

        if removed > 0:

            backup = filepath + ".jenkins-backup"

            shutil.copy2(
                filepath,
                backup
            )

            with open(
                filepath,
                "w",
                encoding="utf-8"
            ) as file:
                file.write(new_content)

            print(
                f"Removed {removed} stale import block(s)"
            )

            print(
                f"Backup created: {backup}"
            )

            found = True


if found:

    print("")
    print(
        "Stale Terraform import configuration "
        "was automatically removed."
    )

else:

    print("")
    print(
        "No stale Terraform import configuration found."
    )

print("")
print(
    "Terraform import configuration check completed."
)

PYTHON
                    '''
                }
            }
        }


        /*
         * ============================================================
         * TERRAFORM FORMAT
         *
         * Automatically formats Terraform.
         * No manual terraform fmt required.
         * ============================================================
         */

        stage('Terraform Format') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    sh '''
                        set -e

                        echo "=========================================="
                        echo "Terraform Format"
                        echo "=========================================="

                        terraform fmt -recursive

                        echo ""
                        echo "Terraform formatting completed."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * CREATE TERRAFORM BACKEND
         * ============================================================
         */

        stage('Create Terraform Backend') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -e

                        BUCKET="terraform-state-faizan-001"
                        TABLE="terraform-locks"
                        REGION="$AWS_DEFAULT_REGION"

                        echo "=========================================="
                        echo "Checking Terraform Backend"
                        echo "=========================================="

                        if aws s3api head-bucket \
                            --bucket "$BUCKET" \
                            --region "$REGION" \
                            2>/dev/null
                        then

                            echo "S3 bucket already exists:"
                            echo "$BUCKET"

                        else

                            echo "Creating S3 bucket:"
                            echo "$BUCKET"

                            if [ "$REGION" = "us-east-1" ]; then

                                aws s3api create-bucket \
                                    --bucket "$BUCKET" \
                                    --region "$REGION"

                            else

                                aws s3api create-bucket \
                                    --bucket "$BUCKET" \
                                    --region "$REGION" \
                                    --create-bucket-configuration \
                                    LocationConstraint="$REGION"

                            fi

                            aws s3api put-bucket-versioning \
                                --bucket "$BUCKET" \
                                --versioning-configuration \
                                Status=Enabled

                            aws s3api put-bucket-encryption \
                                --bucket "$BUCKET" \
                                --server-side-encryption-configuration \
                                '{
                                    "Rules": [
                                        {
                                            "ApplyServerSideEncryptionByDefault": {
                                                "SSEAlgorithm": "AES256"
                                            }
                                        }
                                    ]
                                }'

                        fi


                        if aws dynamodb describe-table \
                            --table-name "$TABLE" \
                            --region "$REGION" \
                            >/dev/null 2>&1
                        then

                            echo "DynamoDB table already exists:"
                            echo "$TABLE"

                        else

                            echo "Creating DynamoDB table:"
                            echo "$TABLE"

                            aws dynamodb create-table \
                                --table-name "$TABLE" \
                                --attribute-definitions \
                                    AttributeName=LockID,AttributeType=S \
                                --key-schema \
                                    AttributeName=LockID,KeyType=HASH \
                                --billing-mode PAY_PER_REQUEST \
                                --region "$REGION"

                            aws dynamodb wait table-exists \
                                --table-name "$TABLE" \
                                --region "$REGION"

                        fi

                        echo ""
                        echo "Terraform backend is ready."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * TERRAFORM INIT
         * ============================================================
         */

        stage('Terraform Init') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    withCredentials([
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${env.AWS_CREDENTIALS}"
                        ]
                    ]) {

                        sh '''
                            set -e

                            BACKEND_CONFIG="backend-${ENVIRONMENT}.conf"

                            if [ ! -f "$BACKEND_CONFIG" ]; then

                                echo "ERROR: Backend configuration not found:"
                                echo "$BACKEND_CONFIG"

                                exit 1
                            fi

                            terraform init \
                                -reconfigure \
                                -backend-config="$BACKEND_CONFIG"
                        '''
                    }
                }
            }
        }


        /*
         * ============================================================
         * TERRAFORM VALIDATE
         * ============================================================
         */

        stage('Terraform Validate') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    sh '''
                        set -e

                        terraform validate

                        echo "Terraform validation successful."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * TERRAFORM PLAN
         * ============================================================
         */

        stage('Terraform Plan') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    withCredentials([
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${env.AWS_CREDENTIALS}"
                        ]
                    ]) {

                        sh '''
                            set -e

                            TF_VARS="environments/${ENVIRONMENT}/terraform.tfvars"

                            if [ ! -f "$TF_VARS" ]; then

                                echo "ERROR: Terraform variables file not found:"
                                echo "$TF_VARS"

                                exit 1
                            fi

                            terraform plan \
                                -var-file="$TF_VARS" \
                                -out=tfplan

                            echo "Terraform plan completed."
                        '''
                    }
                }
            }
        }


        /*
         * ============================================================
         * TERRAFORM APPROVAL
         * ============================================================
         */

        stage('Terraform Approval') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                input(
                    message: "Terraform plan completed. Deploy ${params.ENVIRONMENT}?",
                    ok: "Deploy"
                )
            }
        }


        /*
         * ============================================================
         * TERRAFORM APPLY
         * ============================================================
         */

        stage('Terraform Apply') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    withCredentials([
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${env.AWS_CREDENTIALS}"
                        ]
                    ]) {

                        sh '''
                            set -e

                            terraform apply \
                                -auto-approve \
                                tfplan

                            echo "Terraform apply completed."
                        '''
                    }
                }
            }
        }


        /*
         * ============================================================
         * PYTHON VERSION
         * ============================================================
         */

        stage('Python Version') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                sh '''
                    set -e

                    python3.12 --version
                    python3.12 -m pip --version
                '''
            }
        }


        /*
         * ============================================================
         * CREATE VIRTUAL ENVIRONMENT
         * ============================================================
         */

        stage('Create Virtual Environment') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    sh '''
                        set -e

                        rm -rf venv

                        python3.12 -m venv venv

                        ./venv/bin/python --version
                    '''
                }
            }
        }


        /*
         * ============================================================
         * INSTALL APPLICATION DEPENDENCIES
         * ============================================================
         */

        stage('Install Application Dependencies') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    sh '''
                        set -e

                        ./venv/bin/pip install --upgrade pip

                        if [ -f requirements.txt ]; then

                            ./venv/bin/pip install \
                                -r requirements.txt

                        fi

                        ./venv/bin/pip install \
                            pytest \
                            pytest-cov \
                            coverage \
                            pylint \
                            flake8
                    '''
                }
            }
        }


        /*
         * ============================================================
         * USE QUALITY REPOSITORY
         * ============================================================
         */

        stage('Use Quality Repository') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                sh '''
                    set -e

                    echo "=========================================="
                    echo "Quality Repository"
                    echo "=========================================="

                    echo "Repository:"
                    echo "$QUALITY_REPO"

                    echo ""
                    echo "Quality repository contents:"

                    find "$QUALITY_DIR" \
                        -maxdepth 2 \
                        -type f \
                        -print \
                        | sort

                    echo ""
                    echo "Quality repository verified."
                '''
            }
        }


        /*
         * ============================================================
         * PYTEST
         * ============================================================
         */

        stage('Run Pytest') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    sh '''
                        set -e

                        mkdir -p reports

                        ./venv/bin/pytest \
                            -v \
                            --junitxml=reports/pytest-results.xml
                    '''
                }
            }
        }


        /*
         * ============================================================
         * COVERAGE
         * ============================================================
         */

        stage('Coverage') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    sh '''
                        set -e

                        ./venv/bin/coverage run \
                            -m pytest

                        ./venv/bin/coverage report

                        ./venv/bin/coverage html \
                            -d reports/coverage
                    '''
                }
            }
        }


        /*
         * ============================================================
         * PYLINT
         * ============================================================
         */

        stage('Pylint') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    sh '''
                        set +e

                        ./venv/bin/pylint . \
                            --ignore=venv,.git,reports,__pycache__ \
                            --output-format=text \
                            > reports/pylint-report.txt

                        PYLINT_EXIT=$?

                        cat reports/pylint-report.txt

                        if [ "$PYLINT_EXIT" -ne 0 ]; then

                            echo ""
                            echo "WARNING: Pylint reported issues."
                            echo "Pipeline continues because Pylint is a quality gate."

                        fi

                        exit 0
                    '''
                }
            }
        }


        /*
         * ============================================================
         * FLAKE8
         * ============================================================
         */

        stage('Flake8') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    sh '''
                        set +e

                        ./venv/bin/flake8 . \
                            --exclude=venv,.git,reports,__pycache__ \
                            --statistics \
                            --count \
                            --tee \
                            --output-file=reports/flake8-report.txt

                        FLAKE8_EXIT=$?

                        echo ""
                        echo "Flake8 exit code:"
                        echo "$FLAKE8_EXIT"

                        exit 0
                    '''
                }
            }
        }


        /*
         * ============================================================
         * ARCHIVE REPORTS
         * ============================================================
         */

        stage('Archive Reports') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                archiveArtifacts(
                    artifacts: 'application/reports/**/*',
                    allowEmptyArchive: true,
                    fingerprint: true
                )

                junit(
                    testResults: 'application/reports/pytest-results.xml',
                    allowEmptyResults: true
                )
            }
        }


        /*
         * ============================================================
         * PREPARE ECR
         * ============================================================
         */

        stage('Prepare ECR Repository') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -e

                        aws ecr describe-repositories \
                            --repository-names "$ECR_REPOSITORY" \
                            --region "$AWS_DEFAULT_REGION" \
                            >/dev/null

                        echo "ECR repository verified:"
                        echo "$ECR_REPOSITORY"
                    '''
                }
            }
        }


        /*
         * ============================================================
         * DOCKER BUILD
         * ============================================================
         */

        stage('Docker Build') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    sh '''
                        set -e

                        if [ ! -f Dockerfile ]; then

                            echo "ERROR: Dockerfile not found."

                            exit 1
                        fi

                        AWS_ACCOUNT_ID=$(
                            aws sts get-caller-identity \
                                --query Account \
                                --output text
                        )

                        ECR_REGISTRY="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_DEFAULT_REGION}.amazonaws.com"

                        IMAGE="${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}"

                        LATEST_IMAGE="${ECR_REGISTRY}/${ECR_REPOSITORY}:latest"

                        docker build \
                            -t "$IMAGE" \
                            -t "$LATEST_IMAGE" \
                            .

                        echo "$IMAGE" > ../docker-image.txt

                        echo "Docker build completed."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * LOGIN ECR
         * ============================================================
         */

        stage('Login to Amazon ECR') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -e

                        AWS_ACCOUNT_ID=$(
                            aws sts get-caller-identity \
                                --query Account \
                                --output text
                        )

                        ECR_REGISTRY="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_DEFAULT_REGION}.amazonaws.com"

                        aws ecr get-login-password \
                            --region "$AWS_DEFAULT_REGION" \
                        | docker login \
                            --username AWS \
                            --password-stdin "$ECR_REGISTRY"

                        echo "ECR login successful."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * PUSH IMAGE
         * ============================================================
         */

        stage('Push Docker Image') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                sh '''
                    set -e

                    AWS_ACCOUNT_ID=$(
                        aws sts get-caller-identity \
                            --query Account \
                            --output text
                    )

                    ECR_REGISTRY="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_DEFAULT_REGION}.amazonaws.com"

                    IMAGE="${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}"

                    LATEST_IMAGE="${ECR_REGISTRY}/${ECR_REPOSITORY}:latest"

                    docker push "$IMAGE"

                    docker push "$LATEST_IMAGE"

                    echo "$IMAGE" > docker-image.txt

                    echo "Docker image pushed successfully."
                '''
            }
        }


        /*
         * ============================================================
         * VERIFY ECR
         * ============================================================
         */

        stage('Verify ECR') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -e

                        aws ecr describe-images \
                            --repository-name "$ECR_REPOSITORY" \
                            --region "$AWS_DEFAULT_REGION"

                        echo "ECR verification successful."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * VERIFY ECS CLUSTER
         * ============================================================
         */

        stage('Verify ECS Cluster') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -e

                        aws ecs describe-clusters \
                            --clusters "$ECS_CLUSTER" \
                            --region "$AWS_DEFAULT_REGION"

                        echo "ECS cluster verified."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * REGISTER ECS TASK DEFINITION
         * ============================================================
         */

        stage('Register ECS Task Definition') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -e

                        AWS_ACCOUNT_ID=$(
                            aws sts get-caller-identity \
                                --query Account \
                                --output text
                        )

                        ECR_IMAGE="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_DEFAULT_REGION}.amazonaws.com/${ECR_REPOSITORY}:${IMAGE_TAG}"

                        EXECUTION_ROLE="arn:aws:iam::${AWS_ACCOUNT_ID}:role/terraform-demo-${ENVIRONMENT}-ecs-task-execution-role"

                        cat > ecs-task-definition.json <<EOF
{
    "family": "${ECS_TASK_FAMILY}",
    "networkMode": "bridge",
    "requiresCompatibilities": [
        "EC2"
    ],
    "cpu": "256",
    "memory": "512",
    "executionRoleArn": "${EXECUTION_ROLE}",
    "containerDefinitions": [
        {
            "name": "app",
            "image": "${ECR_IMAGE}",
            "essential": true,
            "cpu": 256,
            "memory": 512,
            "portMappings": [
                {
                    "containerPort": 8501,
                    "hostPort": 8501,
                    "protocol": "tcp"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/terraform-demo",
                    "awslogs-region": "${AWS_DEFAULT_REGION}",
                    "awslogs-stream-prefix": "ecs"
                }
            }
        }
    ]
}
EOF

                        aws ecs register-task-definition \
                            --cli-input-json file://ecs-task-definition.json \
                            --region "$AWS_DEFAULT_REGION"

                        echo "ECS task definition registered."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * GET ECS REVISION
         * ============================================================
         */

        stage('Get ECS Revision') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -e

                        REVISION=$(
                            aws ecs describe-task-definition \
                                --task-definition "$ECS_TASK_FAMILY" \
                                --region "$AWS_DEFAULT_REGION" \
                                --query 'taskDefinition.revision' \
                                --output text
                        )

                        echo "$REVISION" > ecs-revision.txt

                        echo "ECS revision:"
                        echo "$REVISION"
                    '''
                }
            }
        }


        /*
         * ============================================================
         * DEPLOY ECS SERVICE
         * ============================================================
         */

        stage('Deploy ECS Service') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -e

                        REVISION=$(cat ecs-revision.txt)

                        aws ecs update-service \
                            --cluster "$ECS_CLUSTER" \
                            --service "$ECS_SERVICE" \
                            --task-definition "${ECS_TASK_FAMILY}:${REVISION}" \
                            --force-new-deployment \
                            --region "$AWS_DEFAULT_REGION"

                        echo "ECS service deployment started."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * WAIT FOR ECS
         * ============================================================
         */

        stage('Wait For ECS Deployment') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -e

                        aws ecs wait services-stable \
                            --cluster "$ECS_CLUSTER" \
                            --services "$ECS_SERVICE" \
                            --region "$AWS_DEFAULT_REGION"

                        echo "ECS service is stable."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * HEALTH CHECK
         * ============================================================
         */

        stage('Health Check') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    withCredentials([
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${env.AWS_CREDENTIALS}"
                        ]
                    ]) {

                        sh '''
                            set -e

                            ALB_DNS=$(
                                terraform output \
                                    -raw alb_dns_name
                            )

                            if [ -z "$ALB_DNS" ]; then

                                echo "ERROR: ALB DNS output is empty."

                                exit 1
                            fi

                            echo "ALB DNS:"
                            echo "$ALB_DNS"

                            echo ""
                            echo "Waiting for ALB..."
                            sleep 30

                            echo ""
                            echo "Checking application..."

                            curl \
                                --fail \
                                --max-time 20 \
                                "http://${ALB_DNS}/"

                            echo ""
                            echo "Health check successful."
                        '''
                    }
                }
            }
        }


        /*
         * ============================================================
         * DOCKER CLEANUP
         * ============================================================
         */

        stage('Docker Cleanup') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                sh '''
                    set +e

                    docker image prune -af

                    echo "Docker cleanup completed."
                '''
            }
        }


        /*
         * ============================================================
         * DEPLOYMENT SUCCESS
         * ============================================================
         */

        stage('Deployment Successful') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                echo """
==========================================
DEPLOYMENT SUCCESSFUL
==========================================

Environment : ${params.ENVIRONMENT}
Build       : ${BUILD_NUMBER}

Terraform   : SUCCESS
Application : SUCCESS
Quality     : SUCCESS
Docker      : SUCCESS
ECR         : SUCCESS
ECS         : SUCCESS
Health      : SUCCESS

==========================================
"""
            }
        }


        /*
         * ============================================================
         * DESTROY
         * ============================================================
         */

        stage('Terraform Destroy') {

            when {
                expression {
                    params.ACTION == 'DESTROY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    deleteDir()

                    git(
                        branch: 'main',
                        credentialsId: "${env.GITHUB_CREDENTIALS}",
                        url: "${env.TERRAFORM_REPO}"
                    )

                    withCredentials([
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${env.AWS_CREDENTIALS}"
                        ]
                    ]) {

                        sh '''
                            set -e

                            BACKEND_CONFIG="backend-${ENVIRONMENT}.conf"

                            TF_VARS="environments/${ENVIRONMENT}/terraform.tfvars"

                            echo "=========================================="
                            echo "Terraform Destroy"
                            echo "=========================================="

                            if [ ! -f "$BACKEND_CONFIG" ]; then

                                echo "ERROR: Backend configuration not found:"
                                echo "$BACKEND_CONFIG"

                                exit 1
                            fi

                            if [ ! -f "$TF_VARS" ]; then

                                echo "ERROR: Terraform variables file not found:"
                                echo "$TF_VARS"

                                exit 1
                            fi

                            terraform init \
                                -reconfigure \
                                -backend-config="$BACKEND_CONFIG"

                            terraform destroy \
                                -var-file="$TF_VARS" \
                                -auto-approve

                            echo ""
                            echo "Terraform destroy completed successfully."
                        '''
                    }
                }
            }
        }

    }


    /*
     * ================================================================
     * POST ACTIONS
     * ================================================================
     */

    post {

        always {

            echo "=========================================="
            echo "Cleaning Jenkins workspace"
            echo "=========================================="

            cleanWs(
                deleteDirs: true,
                disableDeferredWipeout: true
            )
        }

        success {

            echo "=========================================="
            echo "PIPELINE SUCCESS"
            echo "=========================================="
        }

        failure {

            echo "=========================================="
            echo "PIPELINE FAILED"
            echo "=========================================="

            echo "Check the failed stage and error above."
        }
    }
}
