pipeline {

    agent any

    options {
        timestamps()
        ansiColor('xterm')
        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                daysToKeepStr: '30',
                numToKeepStr: '50'
            )
        )

        timeout(
            time: 90,
            unit: 'MINUTES'
        )
    }

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: [
                'dev',
                'qa',
                'prod'
            ],
            description: 'Select Terraform environment'
        )

        choice(
            name: 'ACTION',
            choices: [
                'DEPLOY',
                'DESTROY'
            ],
            description: 'Select infrastructure action'
        )
    }

    environment {

        AWS_DEFAULT_REGION = 'us-east-1'

        TERRAFORM_REPO =
            'https://github.com/FAIZANSHEIKH223/terraform-aws-infra.git'

        APPLICATION_REPO =
            'https://github.com/FAIZANSHEIKH223/practice1.git'

        QUALITY_REPO =
            'https://github.com/FAIZANSHEIKH223/pylint_flake8_int_jenkins.git'

        ORCHESTRATION_REPO =
            'https://github.com/FAIZANSHEIKH223/CICD-Jenkins-orchestration-repository.git'

        GITHUB_CREDENTIALS = 'github-creds'
        AWS_CREDENTIALS = 'aws-creds'

        TERRAFORM_DIR = 'terraform-aws-infra'
        APPLICATION_DIR = 'application'
        QUALITY_DIR = 'quality-tools'
        ORCHESTRATION_DIR = 'orchestration'

        PROJECT_NAME = 'terraform-demo'

        ECR_REPOSITORY = 'terraform-demo-dev'

        ECS_CLUSTER = 'terraform-demo-dev-cluster'
        ECS_SERVICE = 'terraform-demo-service'
        ECS_TASK_FAMILY = 'terraform-demo-task'

        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages {

        /*
         * ============================================================
         * 1. CHECK REQUIRED TOOLS
         * ============================================================
         */

        stage('Check Required Tools') {

            steps {

                sh '''
                    set -eu

                    echo "=========================================="
                    echo "Checking Required Tools"
                    echo "=========================================="

                    terraform version
                    aws --version
                    docker --version
                    python3.12 --version
                    jq --version
                    curl --version | head -n 1
                    git --version

                    echo ""
                    echo "All required tools are available."
                '''
            }
        }


        /*
         * ============================================================
         * 2. PIPELINE INFORMATION
         * ============================================================
         */

        stage('Pipeline Information') {

            steps {

                echo """
                ==========================================
                Jenkins CI/CD Pipeline
                ==========================================

                Environment : ${params.ENVIRONMENT}
                Action      : ${params.ACTION}
                Build       : ${BUILD_NUMBER}

                Terraform Repository:
                ${env.TERRAFORM_REPO}

                Application Repository:
                ${env.APPLICATION_REPO}

                Quality Repository:
                ${env.QUALITY_REPO}

                Orchestration Repository:
                ${env.ORCHESTRATION_REPO}

                ==========================================
                """
            }
        }


        /*
         * ============================================================
         * 3. CHECKOUT ORCHESTRATION REPOSITORY
         * ============================================================
         */

        stage('Checkout Orchestration Repository') {

            steps {

                dir("${env.ORCHESTRATION_DIR}") {

                    deleteDir()

                    git(
                        branch: 'main',
                        credentialsId: "${env.GITHUB_CREDENTIALS}",
                        url: "${env.ORCHESTRATION_REPO}"
                    )

                    sh '''
                        set -eu

                        echo "=========================================="
                        echo "Orchestration Repository"
                        echo "=========================================="

                        find . \
                            -maxdepth 2 \
                            -type f \
                            -not -path './.git/*' \
                            | sort \
                            | head -100

                        echo ""
                        echo "Orchestration repository checkout successful."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * 4. CHECKOUT TERRAFORM REPOSITORY
         * ============================================================
         */

        stage('Checkout Terraform Repository') {

            when {
                expression {
                    params.ACTION == 'DEPLOY' || params.ACTION == 'DESTROY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    deleteDir()

                    git(
                        branch: 'main',
                        credentialsId: "${env.GITHUB_CREDENTIALS}",
                        url: "${env.TERRAFORM_REPO}"
                    )

                    sh '''
                        set -eu

                        echo "Terraform repository checkout successful."

                        echo ""
                        echo "Terraform files:"
                        find . \
                            -maxdepth 3 \
                            -type f \
                            -not -path './.git/*' \
                            | sort \
                            | head -150
                    '''
                }
            }
        }


        /*
         * ============================================================
         * 5. CHECKOUT APPLICATION REPOSITORY
         * ============================================================
         */

        stage('Checkout Application Repository') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    deleteDir()

                    git(
                        branch: 'main',
                        credentialsId: "${env.GITHUB_CREDENTIALS}",
                        url: "${env.APPLICATION_REPO}"
                    )

                    sh '''
                        set -eu

                        echo "Application repository checkout successful."

                        find . \
                            -maxdepth 3 \
                            -type f \
                            -not -path './.git/*' \
                            | sort \
                            | head -150
                    '''
                }
            }
        }


        /*
         * ============================================================
         * 6. CHECKOUT QUALITY REPOSITORY
         * ============================================================
         */

        stage('Checkout Quality Repository') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.QUALITY_DIR}") {

                    deleteDir()

                    git(
                        branch: 'main',
                        credentialsId: "${env.GITHUB_CREDENTIALS}",
                        url: "${env.QUALITY_REPO}"
                    )

                    sh '''
                        set -eu

                        echo "Quality repository checkout successful."

                        find . \
                            -maxdepth 3 \
                            -type f \
                            -not -path './.git/*' \
                            | sort \
                            | head -150
                    '''
                }
            }
        }


        /*
         * ============================================================
         * 7. PREPARE QUALITY CONFIGURATION
         * ============================================================
         */

        stage('Prepare Quality Configuration') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                sh '''
                    set -eu

                    echo "=========================================="
                    echo "Preparing Quality Configuration"
                    echo "=========================================="

                    mkdir -p application/reports

                    if [ -f quality-tools/.flake8 ]; then
                        cp quality-tools/.flake8 application/.flake8
                        echo "Copied .flake8 configuration."
                    fi

                    if [ -f quality-tools/pylintrc ]; then
                        cp quality-tools/pylintrc application/pylintrc
                        echo "Copied pylint configuration."
                    fi

                    if [ -f quality-tools/.pylintrc ]; then
                        cp quality-tools/.pylintrc application/.pylintrc
                        echo "Copied .pylintrc configuration."
                    fi

                    if [ -f quality-tools/pyproject.toml ]; then
                        cp quality-tools/pyproject.toml application/pyproject.toml
                        echo "Copied pyproject.toml."
                    fi

                    if [ -f quality-tools/setup.cfg ]; then
                        cp quality-tools/setup.cfg application/setup.cfg
                        echo "Copied setup.cfg."
                    fi

                    echo ""
                    echo "Quality configuration preparation completed."
                '''
            }
        }


        /*
         * ============================================================
         * 8. TERRAFORM FORMAT
         * ============================================================
         */

        stage('Terraform Format') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    sh '''
                        set -eu

                        echo "=========================================="
                        echo "Terraform Format"
                        echo "=========================================="

                        terraform fmt -check -recursive

                        echo ""
                        echo "Terraform format check passed."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * 9. CREATE TERRAFORM BACKEND
         * ============================================================
         */

        stage('Create Terraform Backend') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -eu

                        BUCKET="terraform-state-faizan-001"
                        TABLE="terraform-locks"
                        REGION="$AWS_DEFAULT_REGION"

                        echo "=========================================="
                        echo "Terraform Backend"
                        echo "=========================================="

                        if aws s3api head-bucket \
                            --bucket "$BUCKET" \
                            --region "$REGION" \
                            >/dev/null 2>&1
                        then

                            echo "S3 bucket already exists:"
                            echo "$BUCKET"

                        else

                            echo "Creating S3 bucket:"
                            echo "$BUCKET"

                            if [ "$REGION" = "us-east-1" ]; then

                                aws s3api create-bucket \
                                    --bucket "$BUCKET" \
                                    --region "$REGION"

                            else

                                aws s3api create-bucket \
                                    --bucket "$BUCKET" \
                                    --region "$REGION" \
                                    --create-bucket-configuration \
                                    LocationConstraint="$REGION"

                            fi

                            aws s3api put-bucket-versioning \
                                --bucket "$BUCKET" \
                                --versioning-configuration \
                                Status=Enabled

                            aws s3api put-bucket-encryption \
                                --bucket "$BUCKET" \
                                --server-side-encryption-configuration \
                                '{
                                    "Rules": [
                                        {
                                            "ApplyServerSideEncryptionByDefault": {
                                                "SSEAlgorithm": "AES256"
                                            }
                                        }
                                    ]
                                }'

                            echo "S3 backend bucket created."
                        fi


                        if aws dynamodb describe-table \
                            --table-name "$TABLE" \
                            --region "$REGION" \
                            >/dev/null 2>&1
                        then

                            echo "DynamoDB lock table already exists:"
                            echo "$TABLE"

                        else

                            echo "Creating DynamoDB lock table:"

                            aws dynamodb create-table \
                                --table-name "$TABLE" \
                                --attribute-definitions \
                                    AttributeName=LockID,AttributeType=S \
                                --key-schema \
                                    AttributeName=LockID,KeyType=HASH \
                                --billing-mode PAY_PER_REQUEST \
                                --region "$REGION"

                            aws dynamodb wait table-exists \
                                --table-name "$TABLE" \
                                --region "$REGION"

                            echo "DynamoDB lock table created."
                        fi

                        echo ""
                        echo "Terraform backend is ready."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * 10. TERRAFORM INIT
         * ============================================================
         */

        stage('Terraform Init') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    withCredentials([
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${env.AWS_CREDENTIALS}"
                        ]
                    ]) {

                        sh '''
                            set -eu

                            BACKEND_CONFIG="backend-${ENVIRONMENT}.conf"

                            if [ ! -f "$BACKEND_CONFIG" ]; then
                                echo ""
                                echo "ERROR: Backend configuration not found:"
                                echo "$BACKEND_CONFIG"
                                exit 1
                            fi

                            echo "Using backend:"
                            cat "$BACKEND_CONFIG"

                            terraform init \
                                -reconfigure \
                                -input=false \
                                -backend-config="$BACKEND_CONFIG"

                            echo ""
                            echo "Terraform initialization successful."
                        '''
                    }
                }
            }
        }


        /*
         * ============================================================
         * 11. FIX EXISTING AWS RESOURCES
         *
         * Existing IAM role is IMPORTED.
         * It is NOT deleted.
         * ============================================================
         */

        stage('Fix Existing AWS Resources') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    withCredentials([
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${env.AWS_CREDENTIALS}"
                        ]
                    ]) {

                        sh '''
                            set -eu

                            echo "=========================================="
                            echo "Checking Existing AWS Resources"
                            echo "=========================================="

                            TF_VARS="environments/${ENVIRONMENT}/terraform.tfvars"

                            if [ ! -f "$TF_VARS" ]; then
                                echo ""
                                echo "ERROR: Terraform variables file not found:"
                                echo "$TF_VARS"
                                exit 1
                            fi

                            echo "Using Terraform variables:"
                            echo "$TF_VARS"


                            echo ""
                            echo "=========================================="
                            echo "Checking Terraform Variables"
                            echo "=========================================="

                            terraform validate \
                                -no-color

                            terraform plan \
                                -input=false \
                                -refresh=false \
                                -var-file="$TF_VARS" \
                                -out=/tmp/terraform-variable-check.tfplan \
                                >/tmp/terraform-variable-check.log 2>&1 || {

                                echo ""
                                echo "Terraform variable validation failed."
                                echo ""
                                cat /tmp/terraform-variable-check.log

                                rm -f /tmp/terraform-variable-check.tfplan
                                rm -f /tmp/terraform-variable-check.log

                                exit 1
                            }

                            rm -f /tmp/terraform-variable-check.tfplan
                            rm -f /tmp/terraform-variable-check.log


                            echo ""
                            echo "=========================================="
                            echo "Checking IAM Role"
                            echo "=========================================="

                            IAM_ROLE_NAME="terraform-demo-${ENVIRONMENT}-ecs-instance-role"

                            echo "IAM role:"
                            echo "$IAM_ROLE_NAME"


                            if aws iam get-role \
                                --role-name "$IAM_ROLE_NAME" \
                                >/dev/null 2>&1
                            then

                                echo ""
                                echo "IAM role already exists in AWS."

                                if terraform state show \
                                    module.iam.aws_iam_role.ecs_instance_role \
                                    >/dev/null 2>&1
                                then

                                    echo ""
                                    echo "IAM role already exists in Terraform state."
                                    echo "No import required."

                                else

                                    echo ""
                                    echo "IAM role exists in AWS but not in Terraform state."
                                    echo "Importing automatically..."

                                    terraform import \
                                        -input=false \
                                        -var-file="$TF_VARS" \
                                        module.iam.aws_iam_role.ecs_instance_role \
                                        "$IAM_ROLE_NAME"

                                    echo ""
                                    echo "IAM role imported successfully."
                                fi

                            else

                                echo ""
                                echo "IAM role does not exist in AWS."
                                echo "Terraform will create it."
                            fi


                            echo ""
                            echo "=========================================="
                            echo "AWS Resource Check Complete"
                            echo "=========================================="
                        '''
                    }
                }
            }
        }


        /*
         * ============================================================
         * 12. TERRAFORM VALIDATE
         * ============================================================
         */

        stage('Terraform Validate') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    sh '''
                        set -eu

                        terraform validate

                        echo ""
                        echo "Terraform validation successful."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * 13. TERRAFORM PLAN
         * ============================================================
         */

        stage('Terraform Plan') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    withCredentials([
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${env.AWS_CREDENTIALS}"
                        ]
                    ]) {

                        sh '''
                            set -eu

                            TF_VARS="environments/${ENVIRONMENT}/terraform.tfvars"

                            if [ ! -f "$TF_VARS" ]; then
                                echo "ERROR: Terraform variables file not found:"
                                echo "$TF_VARS"
                                exit 1
                            fi

                            echo "=========================================="
                            echo "Terraform Plan"
                            echo "=========================================="

                            terraform plan \
                                -input=false \
                                -var-file="$TF_VARS" \
                                -out=tfplan

                            echo ""
                            echo "Terraform plan completed successfully."
                        '''
                    }
                }
            }
        }


        /*
         * ============================================================
         * 14. TERRAFORM APPLY
         *
         * No manual approval.
         * Fully automated CI/CD.
         * ============================================================
         */

        stage('Terraform Apply') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    withCredentials([
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${env.AWS_CREDENTIALS}"
                        ]
                    ]) {

                        sh '''
                            set -eu

                            terraform apply \
                                -input=false \
                                -auto-approve \
                                tfplan

                            echo ""
                            echo "Terraform apply completed successfully."
                        '''
                    }
                }
            }
        }


        /*
         * ============================================================
         * 15. WAIT FOR INFRASTRUCTURE
         * ============================================================
         */

        stage('Wait For Infrastructure') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                sh '''
                    set -eu

                    echo "Waiting for AWS infrastructure..."

                    sleep 20

                    echo "Infrastructure wait completed."
                '''
            }
        }


        /*
         * ============================================================
         * 16. PYTHON VERSION
         * ============================================================
         */

        stage('Python Version') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    sh '''
                        set -eu

                        python3.12 --version
                        python3.12 -m pip --version
                    '''
                }
            }
        }


        /*
         * ============================================================
         * 17. CREATE VIRTUAL ENVIRONMENT
         * ============================================================
         */

        stage('Create Virtual Environment') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    sh '''
                        set -eu

                        rm -rf venv

                        python3.12 -m venv venv

                        ./venv/bin/python --version
                        ./venv/bin/pip --version
                    '''
                }
            }
        }


        /*
         * ============================================================
         * 18. INSTALL APPLICATION DEPENDENCIES
         * ============================================================
         */

        stage('Install Application Dependencies') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    sh '''
                        set -eu

                        ./venv/bin/pip install \
                            --upgrade pip

                        if [ -f requirements.txt ]; then

                            ./venv/bin/pip install \
                                -r requirements.txt

                        else

                            echo "No requirements.txt found."

                        fi

                        ./venv/bin/pip install \
                            pytest \
                            pytest-cov \
                            pylint \
                            flake8 \
                            coverage

                        echo ""
                        echo "Python dependencies installed."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * 19. VERIFY PYTHON TESTS
         * ============================================================
         */

        stage('Verify Python Tests') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    sh '''
                        set -eu

                        echo "=========================================="
                        echo "Checking Python Tests"
                        echo "=========================================="

                        TEST_COUNT=$(
                            find . \
                                -type f \
                                \\( \
                                    -name "test_*.py" \
                                    -o \
                                    -name "*_test.py" \
                                \\) \
                                -not -path "./venv/*" \
                                -not -path "./.git/*" \
                                | wc -l
                        )

                        echo "Test files found: $TEST_COUNT"

                        if [ "$TEST_COUNT" -eq 0 ]; then

                            echo ""
                            echo "ERROR: No pytest test files found."
                            echo ""
                            echo "Expected examples:"
                            echo "tests/test_app.py"
                            echo "test_app.py"
                            echo "app_test.py"
                            echo ""

                            exit 1
                        fi

                        echo ""
                        echo "Python test files found."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * 20. PYTEST
         * ============================================================
         */

        stage('Run Pytest') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    sh '''
                        set -eu

                        mkdir -p reports

                        ./venv/bin/pytest \
                            -v \
                            --junitxml=reports/pytest-results.xml

                        echo ""
                        echo "Pytest completed successfully."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * 21. COVERAGE
         * ============================================================
         */

        stage('Coverage') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    sh '''
                        set -eu

                        mkdir -p reports

                        ./venv/bin/coverage erase

                        ./venv/bin/coverage run \
                            -m pytest

                        ./venv/bin/coverage report

                        ./venv/bin/coverage html \
                            -d reports/coverage

                        echo ""
                        echo "Coverage completed successfully."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * 22. PYLINT
         * ============================================================
         */

        stage('Pylint') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    sh '''
                        set -eu

                        mkdir -p reports

                        ./venv/bin/pylint . \
                            --ignore=venv,.git,reports,__pycache__ \
                            --output-format=text \
                            > reports/pylint-report.txt

                        cat reports/pylint-report.txt

                        echo ""
                        echo "Pylint completed successfully."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * 23. FLAKE8
         * ============================================================
         */

        stage('Flake8') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    sh '''
                        set -eu

                        mkdir -p reports

                        ./venv/bin/flake8 . \
                            --exclude=venv,.git,reports,__pycache__ \
                            --statistics \
                            --count \
                            --tee \
                            --output-file=reports/flake8-report.txt

                        echo ""
                        echo "Flake8 completed successfully."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * 24. ARCHIVE QUALITY REPORTS
         * ============================================================
         */

        stage('Archive Quality Reports') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                archiveArtifacts(
                    artifacts: 'application/reports/**/*',
                    allowEmptyArchive: false,
                    fingerprint: true
                )

                junit(
                    testResults: 'application/reports/pytest-results.xml',
                    allowEmptyResults: false
                )
            }
        }


        /*
         * ============================================================
         * 25. PREPARE ECR
         * ============================================================
         */

        stage('Prepare ECR Repository') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -eu

                        echo "=========================================="
                        echo "Checking ECR Repository"
                        echo "=========================================="

                        if aws ecr describe-repositories \
                            --repository-names "$ECR_REPOSITORY" \
                            --region "$AWS_DEFAULT_REGION" \
                            >/dev/null 2>&1
                        then

                            echo "ECR repository already exists:"
                            echo "$ECR_REPOSITORY"

                        else

                            echo "ECR repository does not exist."

                            echo "Creating ECR repository..."

                            aws ecr create-repository \
                                --repository-name "$ECR_REPOSITORY" \
                                --region "$AWS_DEFAULT_REGION"

                            echo "ECR repository created."
                        fi
                    '''
                }
            }
        }


        /*
         * ============================================================
         * 26. DOCKER BUILD
         * ============================================================
         */

        stage('Docker Build') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    withCredentials([
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${env.AWS_CREDENTIALS}"
                        ]
                    ]) {

                        sh '''
                            set -eu

                            if [ ! -f Dockerfile ]; then

                                echo "ERROR: Dockerfile not found."

                                exit 1
                            fi

                            AWS_ACCOUNT_ID=$(
                                aws sts get-caller-identity \
                                    --query Account \
                                    --output text
                            )

                            ECR_REGISTRY="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_DEFAULT_REGION}.amazonaws.com"

                            IMAGE="${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}"

                            LATEST_IMAGE="${ECR_REGISTRY}/${ECR_REPOSITORY}:latest"

                            echo "Building Docker image:"
                            echo "$IMAGE"

                            docker build \
                                -t "$IMAGE" \
                                -t "$LATEST_IMAGE" \
                                .

                            echo "$IMAGE" > ../docker-image.txt

                            echo ""
                            echo "Docker image built successfully."
                        '''
                    }
                }
            }
        }


        /*
         * ============================================================
         * 27. LOGIN TO ECR
         * ============================================================
         */

        stage('Login to Amazon ECR') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -eu

                        AWS_ACCOUNT_ID=$(
                            aws sts get-caller-identity \
                                --query Account \
                                --output text
                        )

                        ECR_REGISTRY="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_DEFAULT_REGION}.amazonaws.com"

                        aws ecr get-login-password \
                            --region "$AWS_DEFAULT_REGION" \
                        | docker login \
                            --username AWS \
                            --password-stdin "$ECR_REGISTRY"

                        echo "ECR login successful."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * 28. PUSH DOCKER IMAGE
         * ============================================================
         */

        stage('Push Docker Image') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -eu

                        AWS_ACCOUNT_ID=$(
                            aws sts get-caller-identity \
                                --query Account \
                                --output text
                        )

                        ECR_REGISTRY="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_DEFAULT_REGION}.amazonaws.com"

                        IMAGE="${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}"

                        LATEST_IMAGE="${ECR_REGISTRY}/${ECR_REPOSITORY}:latest"

                        docker push "$IMAGE"

                        docker push "$LATEST_IMAGE"

                        echo "$IMAGE" > docker-image.txt

                        echo ""
                        echo "Docker images pushed successfully."
                        echo "$IMAGE"
                    '''
                }
            }
        }


        /*
         * ============================================================
         * 29. VERIFY ECR
         * ============================================================
         */

        stage('Verify ECR Image') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -eu

                        aws ecr describe-images \
                            --repository-name "$ECR_REPOSITORY" \
                            --region "$AWS_DEFAULT_REGION"

                        echo ""
                        echo "ECR image verification successful."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * 30. DOCKER CLEANUP
         * ============================================================
         */

        stage('Docker Cleanup') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                sh '''
                    set +e

                    docker image prune -af

                    echo "Docker cleanup completed."
                '''
            }
        }


        /*
         * ============================================================
         * 31. VERIFY ECS CLUSTER
         * ============================================================
         */

        stage('Verify ECS Cluster') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -eu

                        aws ecs describe-clusters \
                            --clusters "$ECS_CLUSTER" \
                            --region "$AWS_DEFAULT_REGION"

                        echo ""
                        echo "ECS cluster verified."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * 32. REGISTER ECS TASK DEFINITION
         * ============================================================
         */

        stage('Register New Task Definition') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -eu

                        AWS_ACCOUNT_ID=$(
                            aws sts get-caller-identity \
                                --query Account \
                                --output text
                        )

                        ECR_IMAGE="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_DEFAULT_REGION}.amazonaws.com/${ECR_REPOSITORY}:${IMAGE_TAG}"

                        EXECUTION_ROLE="arn:aws:iam::${AWS_ACCOUNT_ID}:role/terraform-demo-${ENVIRONMENT}-ecs-task-execution-role"

                        echo "ECR image:"
                        echo "$ECR_IMAGE"

                        echo ""
                        echo "Execution role:"
                        echo "$EXECUTION_ROLE"

                        cat > ecs-task-definition.json <<EOF
{
    "family": "${ECS_TASK_FAMILY}",
    "networkMode": "bridge",
    "requiresCompatibilities": [
        "EC2"
    ],
    "cpu": "256",
    "memory": "512",
    "executionRoleArn": "${EXECUTION_ROLE}",
    "containerDefinitions": [
        {
            "name": "app",
            "image": "${ECR_IMAGE}",
            "essential": true,
            "cpu": 256,
            "memory": 512,
            "portMappings": [
                {
                    "containerPort": 8501,
                    "hostPort": 8501,
                    "protocol": "tcp"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/terraform-demo",
                    "awslogs-region": "${AWS_DEFAULT_REGION}",
                    "awslogs-stream-prefix": "ecs"
                }
            }
        }
    ]
}
EOF

                        jq empty ecs-task-definition.json

                        aws ecs register-task-definition \
                            --cli-input-json file://ecs-task-definition.json \
                            --region "$AWS_DEFAULT_REGION"

                        echo ""
                        echo "ECS task definition registered."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * 33. GET LATEST ECS REVISION
         * ============================================================
         */

        stage('Get Latest Revision') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -eu

                        REVISION=$(
                            aws ecs describe-task-definition \
                                --task-definition "$ECS_TASK_FAMILY" \
                                --region "$AWS_DEFAULT_REGION" \
                                --query 'taskDefinition.revision' \
                                --output text
                        )

                        echo "$REVISION" > ecs-revision.txt

                        echo "Latest ECS revision:"
                        echo "$REVISION"
                    '''
                }
            }
        }


        /*
         * ============================================================
         * 34. DEPLOY ECS SERVICE
         * ============================================================
         */

        stage('Deploy ECS Service') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -eu

                        REVISION=$(cat ecs-revision.txt)

                        aws ecs update-service \
                            --cluster "$ECS_CLUSTER" \
                            --service "$ECS_SERVICE" \
                            --task-definition "${ECS_TASK_FAMILY}:${REVISION}" \
                            --force-new-deployment \
                            --region "$AWS_DEFAULT_REGION"

                        echo ""
                        echo "ECS service deployment started."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * 35. WAIT FOR ECS
         * ============================================================
         */

        stage('Wait For ECS Deployment') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -eu

                        echo "Waiting for ECS service to become stable..."

                        aws ecs wait services-stable \
                            --cluster "$ECS_CLUSTER" \
                            --services "$ECS_SERVICE" \
                            --region "$AWS_DEFAULT_REGION"

                        echo ""
                        echo "ECS service is stable."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * 36. HEALTH CHECK
         * ============================================================
         */

        stage('Health Check') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    withCredentials([
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${env.AWS_CREDENTIALS}"
                        ]
                    ]) {

                        sh '''
                            set -eu

                            echo "=========================================="
                            echo "Application Health Check"
                            echo "=========================================="

                            ALB_DNS=$(
                                terraform output \
                                    -raw alb_dns_name
                            )

                            if [ -z "$ALB_DNS" ]; then

                                echo "ERROR: ALB DNS output is empty."

                                exit 1
                            fi

                            echo "ALB DNS:"
                            echo "$ALB_DNS"

                            echo ""
                            echo "Waiting for ALB..."
                            sleep 30

                            echo ""
                            echo "Checking application..."

                            curl \
                                --fail \
                                --silent \
                                --show-error \
                                --max-time 30 \
                                "http://${ALB_DNS}/"

                            echo ""
                            echo ""
                            echo "Application health check successful."
                        '''
                    }
                }
            }
        }


        /*
         * ============================================================
         * 37. DEPLOYMENT SUCCESS
         * ============================================================
         */

        stage('Deployment Successful') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                echo """
                ==========================================
                DEPLOYMENT SUCCESSFUL
                ==========================================

                Environment : ${params.ENVIRONMENT}
                Build       : ${BUILD_NUMBER}

                Terraform   : SUCCESS
                Tests       : SUCCESS
                Coverage    : SUCCESS
                Pylint      : SUCCESS
                Flake8      : SUCCESS
                Docker      : SUCCESS
                ECR         : SUCCESS
                ECS         : SUCCESS
                Health      : SUCCESS

                ==========================================
                """
            }
        }


        /*
         * ============================================================
         * 38. TERRAFORM DESTROY
         * ============================================================
         */

        stage('Terraform Destroy') {

            when {
                expression {
                    params.ACTION == 'DESTROY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    withCredentials([
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${env.AWS_CREDENTIALS}"
                        ]
                    ]) {

                        sh '''
                            set -eu

                            echo "=========================================="
                            echo "Terraform Destroy"
                            echo "=========================================="

                            BACKEND_CONFIG="backend-${ENVIRONMENT}.conf"
                            TF_VARS="environments/${ENVIRONMENT}/terraform.tfvars"

                            if [ ! -f "$BACKEND_CONFIG" ]; then

                                echo "ERROR: Backend configuration not found:"
                                echo "$BACKEND_CONFIG"

                                exit 1
                            fi

                            if [ ! -f "$TF_VARS" ]; then

                                echo "ERROR: Terraform variables file not found:"
                                echo "$TF_VARS"

                                exit 1
                            fi

                            terraform init \
                                -reconfigure \
                                -input=false \
                                -backend-config="$BACKEND_CONFIG"

                            terraform destroy \
                                -input=false \
                                -var-file="$TF_VARS" \
                                -auto-approve

                            echo ""
                            echo "Terraform destroy completed successfully."
                        '''
                    }
                }
            }
        }


        /*
         * ============================================================
         * 39. DESTROY SUCCESS
         * ============================================================
         */

        stage('Destroy Successful') {

            when {
                expression {
                    params.ACTION == 'DESTROY'
                }
            }

            steps {

                echo """
                ==========================================
                DESTROY SUCCESSFUL
                ==========================================

                Environment : ${params.ENVIRONMENT}
                Build       : ${BUILD_NUMBER}

                Terraform infrastructure has been
                destroyed successfully.

                ==========================================
                """
            }
        }
    }


    /*
     * ================================================================
     * POST ACTIONS
     * ================================================================
     */

    post {

        always {

            echo "=========================================="
            echo "Cleaning Jenkins Workspace"
            echo "=========================================="

            cleanWs(
                deleteDirs: true,
                disableDeferredWipeout: true
            )
        }

        success {

            echo "=========================================="
            echo "PIPELINE SUCCESS"
            echo "=========================================="
        }

        failure {

            echo "=========================================="
            echo "PIPELINE FAILED"
            echo "=========================================="

            echo "Check the failed stage above."
        }

        aborted {

            echo "=========================================="
            echo "PIPELINE ABORTED"
            echo "=========================================="
        }
    }
}
