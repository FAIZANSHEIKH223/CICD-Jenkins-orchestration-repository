pipeline {

    agent any

    // ================================================================
    // PIPELINE OPTIONS
    // ================================================================

    options {

        timestamps()

        ansiColor('xterm')

        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                daysToKeepStr: '30',
                numToKeepStr: '50'
            )
        )

        timeout(
            time: 90,
            unit: 'MINUTES'
        )
    }


    // ================================================================
    // PARAMETERS
    // ================================================================

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: [
                'dev',
                'qa',
                'stage',
                'prod'
            ],
            description: 'Terraform environment to deploy'
        )
    }


    // ================================================================
    // ENVIRONMENT
    // ================================================================

    environment {

        APP_REPO = 'https://github.com/FAIZANSHEIKH223/practice1.git'
        APP_BRANCH = 'main'

        QUALITY_REPO = 'https://github.com/FAIZANSHEIKH223/pylint_flake8_int_jenkins.git'
        QUALITY_BRANCH = 'main'

        TERRAFORM_REPO = 'https://github.com/FAIZANSHEIKH223/terraform-aws-infra.git'
        TERRAFORM_BRANCH = 'main'

        GITHUB_CREDENTIALS = 'github-creds'
        AWS_CREDENTIALS = 'aws-creds'

        APP_DIR = 'practice1'
        QUALITY_DIR = 'quality-tools'
        TERRAFORM_DIR = 'terraform-infra'
        VENV_DIR = 'venv'
        REPORT_DIR = 'reports'

        PYTHON = 'python3.12'

        AWS_DEFAULT_REGION = 'us-east-1'

        APP_NAME = 'practice1'
        CONTAINER_NAME = 'practice1'
        CONTAINER_PORT = '8501'

        DOCKER_IMAGE_NAME = 'practice1'
        DOCKER_IMAGE_TAG = "${BUILD_NUMBER}"
        DOCKER_IMAGE = "${DOCKER_IMAGE_NAME}:${BUILD_NUMBER}"

        ECR_REPOSITORY = 'practice1'
        ECR_IMAGE_TAG = "${BUILD_NUMBER}"

        ECS_CLUSTER = "practice1-${ENVIRONMENT}-cluster"
        ECS_SERVICE = "practice1-${ENVIRONMENT}-service"
        ECS_TASK_FAMILY = "practice1-${ENVIRONMENT}-task"
        ECS_CONTAINER_NAME = 'practice1'

        FARGATE_CPU = '256'
        FARGATE_MEMORY = '512'

        ALB_NAME = "practice1-${ENVIRONMENT}-alb"
        TARGET_GROUP_NAME = "practice1-${ENVIRONMENT}-tg"
        ALB_SG_NAME = "practice1-${ENVIRONMENT}-alb-sg"
        ECS_SG_NAME = "practice1-${ENVIRONMENT}-ecs-sg"

        TF_STATE_BUCKET = 'terraform-state-faizan-001'
        TF_LOCK_TABLE = 'terraform-locks'
        TF_IN_AUTOMATION = 'true'
        TF_INPUT = 'false'

        HEALTH_PATH = '/'

        DNS_NAME = ''
    }


    // ================================================================
    // STAGES
    // ================================================================

    stages {


        // ============================================================
        // PART 1
        // ============================================================

        stage('1 - Checkout Application') {

            steps {

                echo '================================================'
                echo 'CHECKOUT APPLICATION'
                echo '================================================'

                dir("${APP_DIR}") {

                    deleteDir()

                    git(
                        branch: "${APP_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${APP_REPO}"
                    )
                }
            }
        }


        stage('2 - Checkout Quality Repository') {

            steps {

                echo '================================================'
                echo 'CHECKOUT QUALITY REPOSITORY'
                echo '================================================'

                dir("${QUALITY_DIR}") {

                    deleteDir()

                    git(
                        branch: "${QUALITY_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${QUALITY_REPO}"
                    )
                }
            }
        }


        stage('3 - Verify Python') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "VERIFYING PYTHON"
                        echo "================================================"

                        command -v "${PYTHON}"

                        "${PYTHON}" --version

                        "${PYTHON}" -m pip --version
                    '''
                }
            }
        }


        stage('4 - Create Python Virtual Environment') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "CREATING PYTHON VIRTUAL ENVIRONMENT"
                        echo "================================================"

                        rm -rf "${VENV_DIR}"

                        "${PYTHON}" -m venv "${VENV_DIR}"

                        "${VENV_DIR}/bin/python" --version
                    '''
                }
            }
        }


        stage('5 - Install Application Dependencies') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "INSTALLING APPLICATION DEPENDENCIES"
                        echo "================================================"

                        "${VENV_DIR}/bin/python" \
                            -m pip install --upgrade pip

                        if [ -f requirements.txt ]; then

                            "${VENV_DIR}/bin/pip" \
                                install \
                                -r requirements.txt

                        else

                            echo "WARNING: requirements.txt not found."

                        fi
                    '''
                }
            }
        }


        stage('6 - Install Quality Tools') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "INSTALLING QUALITY TOOLS"
                        echo "================================================"

                        "${VENV_DIR}/bin/pip" \
                            install \
                            flake8 \
                            pylint

                        "${VENV_DIR}/bin/flake8" --version

                        "${VENV_DIR}/bin/pylint" --version
                    '''
                }
            }
        }


        stage('7 - Flake8 Code Quality') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "RUNNING FLAKE8"
                        echo "================================================"

                        mkdir -p "${REPORT_DIR}"

                        "${VENV_DIR}/bin/flake8" \
                            . \
                            --exclude="${VENV_DIR},.git,${REPORT_DIR},__pycache__" \
                            --count \
                            --statistics \
                            --tee \
                            --output-file="${REPORT_DIR}/flake8-report.txt"
                    '''
                }
            }
        }


        stage('8 - Pylint Code Quality') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "RUNNING PYLINT"
                        echo "================================================"

                        mkdir -p "${REPORT_DIR}"

                        PYTHON_FILES=$(find . \
                            -type f \
                            -name "*.py" \
                            ! -path "./${VENV_DIR}/*" \
                            ! -path "./.git/*" \
                            ! -path "./${REPORT_DIR}/*" \
                            ! -path "*/__pycache__/*")

                        if [ -z "${PYTHON_FILES}" ]; then

                            echo "ERROR: No Python files found."

                            exit 1

                        fi

                        "${VENV_DIR}/bin/pylint" \
                            ${PYTHON_FILES} \
                            --output-format=text \
                            > "${REPORT_DIR}/pylint-report.txt"
                    '''
                }
            }
        }


        stage('9 - Part 1 Success') {

            steps {

                echo '================================================'
                echo 'PART 1 - CODE QUALITY SUCCESS'
                echo '================================================'

                echo 'Flake8 : PASSED'
                echo 'Pylint : PASSED'
            }
        }


        // ============================================================
        // PART 2
        // ============================================================

        stage('10 - Install Pytest') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "INSTALLING PYTEST"
                        echo "================================================"

                        "${VENV_DIR}/bin/pip" install pytest

                        "${VENV_DIR}/bin/pytest" --version
                    '''
                }
            }
        }


        stage('11 - Verify Tests') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "VERIFYING TESTS"
                        echo "================================================"

                        if [ ! -d "tests" ]; then

                            echo "ERROR: tests/ directory does not exist."

                            exit 1

                        fi

                        TEST_FILES=$(find tests \
                            -type f \
                            \\( \
                                -name "test_*.py" \
                                -o \
                                -name "*_test.py" \
                            \\))

                        if [ -z "${TEST_FILES}" ]; then

                            echo "ERROR: No pytest test files found."

                            exit 1

                        fi

                        echo "Test files:"
                        echo "${TEST_FILES}"
                    '''
                }
            }
        }


        stage('12 - Run Automated Tests') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "RUNNING AUTOMATED TESTS"
                        echo "================================================"

                        mkdir -p "${REPORT_DIR}"

                        "${VENV_DIR}/bin/pytest" \
                            tests/ \
                            -v \
                            --junitxml="${REPORT_DIR}/pytest-results.xml"
                    '''
                }
            }
        }


        stage('13 - Publish Test Results') {

            steps {

                junit(
                    testResults: "${APP_DIR}/${REPORT_DIR}/pytest-results.xml",
                    allowEmptyResults: false
                )

                archiveArtifacts(
                    artifacts:
                        "${APP_DIR}/${REPORT_DIR}/pytest-results.xml," +
                        "${APP_DIR}/${REPORT_DIR}/flake8-report.txt," +
                        "${APP_DIR}/${REPORT_DIR}/pylint-report.txt",
                    allowEmptyArchive: false,
                    fingerprint: true
                )
            }
        }


        stage('14 - Part 2 Success') {

            steps {

                echo '================================================'
                echo 'PART 2 - TESTING SUCCESS'
                echo '================================================'

                echo 'Pytest : PASSED'
            }
        }


        // ============================================================
        // PART 3
        // ============================================================

        stage('15 - Verify Docker') {

            steps {

                sh '''
                    set -eu

                    echo "================================================"
                    echo "VERIFYING DOCKER"
                    echo "================================================"

                    command -v docker

                    docker --version

                    docker info > /dev/null

                    echo "Docker daemon is accessible."
                '''
            }
        }


        stage('16 - Prepare Docker Build Context') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "PREPARING DOCKER BUILD CONTEXT"
                        echo "================================================"

                        if [ ! -f Dockerfile ]; then

                            echo "ERROR: Dockerfile not found."

                            exit 1

                        fi

                        printf '%s\\n' \
                            'venv/' \
                            '.venv/' \
                            '.git/' \
                            '.gitignore' \
                            '__pycache__/' \
                            '*.pyc' \
                            '*.pyo' \
                            '.pytest_cache/' \
                            '.mypy_cache/' \
                            'reports/' \
                            '*.log' \
                            '.DS_Store' \
                            > .dockerignore

                        cat .dockerignore
                    '''
                }
            }
        }


        stage('17 - Build Docker Image') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "BUILDING DOCKER IMAGE"
                        echo "================================================"

                        docker build \
                            --pull \
                            --tag "${DOCKER_IMAGE}" \
                            .

                        docker image inspect \
                            "${DOCKER_IMAGE}" \
                            > /dev/null

                        echo "Docker image created successfully."
                    '''
                }
            }
        }


        stage('18 - Docker Image Verification') {

            steps {

                sh '''
                    set -eu

                    docker image inspect \
                        "${DOCKER_IMAGE}" \
                        --format='Image={{.RepoTags}} Size={{.Size}}'

                    docker images "${DOCKER_IMAGE_NAME}"
                '''
            }
        }


        stage('19 - Part 3 Success') {

            steps {

                echo '================================================'
                echo 'PART 3 - DOCKER SUCCESS'
                echo '================================================'

                echo "Docker Image: ${DOCKER_IMAGE}"
            }
        }


        // ============================================================
        // PART 4
        // ============================================================

        stage('20 - Verify AWS CLI') {

            steps {

                sh '''
                    set -eu

                    command -v aws

                    aws --version
                '''
            }
        }


        stage('21 - Verify AWS Credentials') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -eu

                        aws sts get-caller-identity \
                            --region "${AWS_DEFAULT_REGION}"
                    '''
                }
            }
        }


        stage('22 - Create ECR Repository') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -eu

                        if aws ecr describe-repositories \
                            --repository-names "${ECR_REPOSITORY}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            > /dev/null 2>&1
                        then

                            echo "ECR repository already exists."

                        else

                            aws ecr create-repository \
                                --repository-name "${ECR_REPOSITORY}" \
                                --region "${AWS_DEFAULT_REGION}"

                        fi
                    '''
                }
            }
        }


        stage('23 - Get ECR Image URI') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        def accountId = sh(
                            script: '''
                                aws sts get-caller-identity \
                                    --query Account \
                                    --output text \
                                    --region "${AWS_DEFAULT_REGION}"
                            ''',
                            returnStdout: true
                        ).trim()

                        env.AWS_ACCOUNT_ID = accountId

                        env.ECR_REGISTRY =
                            "${accountId}.dkr.ecr.${AWS_DEFAULT_REGION}.amazonaws.com"

                        env.ECR_IMAGE =
                            "${env.ECR_REGISTRY}/${env.ECR_REPOSITORY}:${env.ECR_IMAGE_TAG}"

                        echo "AWS Account ID : ${env.AWS_ACCOUNT_ID}"
                        echo "ECR Registry   : ${env.ECR_REGISTRY}"
                        echo "ECR Image URI  : ${env.ECR_IMAGE}"
                    }
                }
            }
        }


        stage('24 - Login Docker to ECR') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -eu

                        aws ecr get-login-password \
                            --region "${AWS_DEFAULT_REGION}" |
                        docker login \
                            --username AWS \
                            --password-stdin \
                            "${ECR_REGISTRY}"
                    '''
                }
            }
        }


        stage('25 - Tag Image with ECR URI') {

            steps {

                sh '''
                    set -eu

                    docker tag \
                        "${DOCKER_IMAGE}" \
                        "${ECR_IMAGE}"

                    docker image inspect \
                        "${ECR_IMAGE}" \
                        > /dev/null
                '''
            }
        }


        stage('26 - Push Image to ECR') {

            steps {

                sh '''
                    set -eu

                    docker push "${ECR_IMAGE}"
                '''
            }
        }


        stage('27 - Verify ECR Image') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -eu

                        aws ecr describe-images \
                            --repository-name "${ECR_REPOSITORY}" \
                            --image-ids imageTag="${ECR_IMAGE_TAG}" \
                            --region "${AWS_DEFAULT_REGION}"
                    '''
                }
            }
        }


        stage('28 - Part 4 Success') {

            steps {

                echo '================================================'
                echo 'PART 4 - ECR SUCCESS'
                echo '================================================'

                echo "ECR Image URI: ${env.ECR_IMAGE}"
            }
        }


        // ============================================================
        // PART 5
        // ============================================================

        stage('29 - Checkout Terraform Repository') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    deleteDir()

                    git(
                        branch: "${TERRAFORM_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${TERRAFORM_REPO}"
                    )
                }
            }
        }


        stage('30 - Verify Terraform') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    sh '''
                        set -eu

                        command -v terraform

                        terraform version

                        find . \
                            -maxdepth 3 \
                            -type f \
                            -name "*.tf" \
                            -print
                    '''
                }
            }
        }


        stage('31 - Terraform Environment Verification') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    sh '''
                        set -eu

                        if [ ! -d "environments/${ENVIRONMENT}" ]; then
                            echo "ERROR: Terraform environment does not exist."
                            exit 1
                        fi

                        if [ ! -f "environments/${ENVIRONMENT}/terraform.tfvars" ]; then
                            echo "ERROR: terraform.tfvars not found."
                            exit 1
                        fi

                        echo "Terraform environment verified."
                    '''
                }
            }
        }


        stage('32 - Terraform Init') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh '''
                            set -eu

                            terraform init \
                                -input=false
                        '''
                    }
                }
            }
        }


        stage('33 - Terraform Validate') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    sh '''
                        set -eu

                        terraform validate
                    '''
                }
            }
        }


        stage('34 - Terraform Plan') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh '''
                            set -eu

                            terraform plan \
                                -input=false \
                                -var-file="environments/${ENVIRONMENT}/terraform.tfvars" \
                                -out="tfplan"
                        '''
                    }
                }
            }
        }


        stage('35 - Terraform Apply') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh '''
                            set -eu

                            test -f tfplan

                            terraform apply \
                                -input=false \
                                -auto-approve \
                                tfplan
                        '''
                    }
                }
            }
        }


        stage('36 - Terraform Deployment Verification') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh '''
                            set -eu

                            terraform state list || true

                            terraform output || true

                            aws sts get-caller-identity \
                                --region "${AWS_DEFAULT_REGION}"
                        '''
                    }
                }
            }
        }


        // ============================================================
        // PART 6 - NETWORK
        // ============================================================

        stage('37 - Discover AWS Network') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        def vpcId = sh(
                            script: '''
                                set -eu

                                VPC_ID=$(aws ec2 describe-vpcs \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --filters \
                                        "Name=tag:Environment,Values=${ENVIRONMENT}" \
                                    --query 'Vpcs[0].VpcId' \
                                    --output text)

                                if [ "${VPC_ID}" = "None" ] || [ -z "${VPC_ID}" ]; then

                                    VPC_ID=$(aws ec2 describe-vpcs \
                                        --region "${AWS_DEFAULT_REGION}" \
                                        --filters \
                                            "Name=is-default,Values=true" \
                                        --query 'Vpcs[0].VpcId' \
                                        --output text)

                                fi

                                if [ "${VPC_ID}" = "None" ] || [ -z "${VPC_ID}" ]; then
                                    echo "ERROR: No VPC found."
                                    exit 1
                                fi

                                echo "${VPC_ID}"
                            ''',
                            returnStdout: true
                        ).trim()

                        env.VPC_ID = vpcId


                        def subnetOutput = sh(
                            script: '''
                                set -eu

                                aws ec2 describe-subnets \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --filters \
                                        "Name=vpc-id,Values=${VPC_ID}" \
                                        "Name=map-public-ip-on-launch,Values=true" \
                                    --query 'Subnets[].{Id:SubnetId,AZ:AvailabilityZone}' \
                                    --output text
                            ''',
                            returnStdout: true
                        ).trim()


                        if (!subnetOutput || subnetOutput == 'None') {
                            error('No public subnets found.')
                        }


                        def selectedSubnets = []
                        def usedAzs = []

                        subnetOutput.readLines().each { line ->

                            def parts = line.trim().split(/\s+/)

                            if (parts.size() >= 2) {

                                def subnetId = parts[0]
                                def az = parts[1]

                                if (!usedAzs.contains(az)) {

                                    selectedSubnets.add(subnetId)
                                    usedAzs.add(az)
                                }
                            }
                        }


                        if (selectedSubnets.size() < 2) {

                            error(
                                "At least 2 public subnets in different AZs are required. " +
                                "Discovered: ${subnetOutput}"
                            )
                        }


                        env.SUBNET_1 = selectedSubnets[0]
                        env.SUBNET_2 = selectedSubnets[1]

                        echo "VPC ID  : ${env.VPC_ID}"
                        echo "Subnet 1: ${env.SUBNET_1}"
                        echo "Subnet 2: ${env.SUBNET_2}"
                    }
                }
            }
        }


        stage('38 - Create IAM Roles for ECS') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -eu

                        EXECUTION_ROLE_NAME="practice1-ecsTaskExecutionRole"

                        if ! aws iam get-role \
                            --role-name "${EXECUTION_ROLE_NAME}" \
                            > /dev/null 2>&1
                        then

                            cat > /tmp/ecs-trust-policy.json <<'EOF'
{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "Service": "ecs-tasks.amazonaws.com"
      },
      "Action": "sts:AssumeRole"
    }
  ]
}
EOF

                            aws iam create-role \
                                --role-name "${EXECUTION_ROLE_NAME}" \
                                --assume-role-policy-document \
                                file:///tmp/ecs-trust-policy.json
                        fi


                        aws iam attach-role-policy \
                            --role-name "${EXECUTION_ROLE_NAME}" \
                            --policy-arn \
                            arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy \
                            || true


                        echo "Waiting for IAM propagation..."

                        sleep 10


                        aws iam get-role \
                            --role-name "${EXECUTION_ROLE_NAME}" \
                            --query 'Role.Arn' \
                            --output text
                    '''
                }
            }
        }


        stage('39 - Create Security Groups') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        sh '''
                            set -eu

                            ALB_SG_ID=$(aws ec2 describe-security-groups \
                                --region "${AWS_DEFAULT_REGION}" \
                                --filters \
                                    "Name=vpc-id,Values=${VPC_ID}" \
                                    "Name=group-name,Values=${ALB_SG_NAME}" \
                                --query 'SecurityGroups[0].GroupId' \
                                --output text)


                            if [ "${ALB_SG_ID}" = "None" ] || [ -z "${ALB_SG_ID}" ]; then

                                ALB_SG_ID=$(aws ec2 create-security-group \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --group-name "${ALB_SG_NAME}" \
                                    --description "ALB security group for practice1" \
                                    --vpc-id "${VPC_ID}" \
                                    --query 'GroupId' \
                                    --output text)

                            fi


                            ECS_SG_ID=$(aws ec2 describe-security-groups \
                                --region "${AWS_DEFAULT_REGION}" \
                                --filters \
                                    "Name=vpc-id,Values=${VPC_ID}" \
                                    "Name=group-name,Values=${ECS_SG_NAME}" \
                                --query 'SecurityGroups[0].GroupId' \
                                --output text)


                            if [ "${ECS_SG_ID}" = "None" ] || [ -z "${ECS_SG_ID}" ]; then

                                ECS_SG_ID=$(aws ec2 create-security-group \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --group-name "${ECS_SG_NAME}" \
                                    --description "ECS Fargate security group for practice1" \
                                    --vpc-id "${VPC_ID}" \
                                    --query 'GroupId' \
                                    --output text)

                            fi


                            aws ec2 authorize-security-group-ingress \
                                --region "${AWS_DEFAULT_REGION}" \
                                --group-id "${ALB_SG_ID}" \
                                --protocol tcp \
                                --port 80 \
                                --cidr 0.0.0.0/0 \
                                2>/dev/null || true


                            aws ec2 authorize-security-group-egress \
                                --region "${AWS_DEFAULT_REGION}" \
                                --group-id "${ALB_SG_ID}" \
                                --protocol -1 \
                                --cidr 0.0.0.0/0 \
                                2>/dev/null || true


                            aws ec2 authorize-security-group-ingress \
                                --region "${AWS_DEFAULT_REGION}" \
                                --group-id "${ECS_SG_ID}" \
                                --protocol tcp \
                                --port "${CONTAINER_PORT}" \
                                --source-group "${ALB_SG_ID}" \
                                2>/dev/null || true


                            aws ec2 authorize-security-group-egress \
                                --region "${AWS_DEFAULT_REGION}" \
                                --group-id "${ECS_SG_ID}" \
                                --protocol -1 \
                                --cidr 0.0.0.0/0 \
                                2>/dev/null || true
                        '''


                        env.ALB_SG_ID = sh(
                            script: """
                                aws ec2 describe-security-groups \
                                    --region '${env.AWS_DEFAULT_REGION}' \
                                    --filters \
                                        Name=vpc-id,Values=${env.VPC_ID} \
                                        Name=group-name,Values=${env.ALB_SG_NAME} \
                                    --query 'SecurityGroups[0].GroupId' \
                                    --output text
                            """,
                            returnStdout: true
                        ).trim()


                        env.ECS_SG_ID = sh(
                            script: """
                                aws ec2 describe-security-groups \
                                    --region '${env.AWS_DEFAULT_REGION}' \
                                    --filters \
                                        Name=vpc-id,Values=${env.VPC_ID} \
                                        Name=group-name,Values=${env.ECS_SG_NAME} \
                                    --query 'SecurityGroups[0].GroupId' \
                                    --output text
                            """,
                            returnStdout: true
                        ).trim()


                        if (!env.ALB_SG_ID || env.ALB_SG_ID == 'None') {
                            error('ALB security group ID could not be determined.')
                        }

                        if (!env.ECS_SG_ID || env.ECS_SG_ID == 'None') {
                            error('ECS security group ID could not be determined.')
                        }


                        echo "ALB SG ID: ${env.ALB_SG_ID}"
                        echo "ECS SG ID: ${env.ECS_SG_ID}"
                    }
                }
            }
        }


        stage('40 - Create Application Load Balancer') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        def albArn = sh(
                            script: '''
                                aws elbv2 describe-load-balancers \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --names "${ALB_NAME}" \
                                    --query 'LoadBalancers[0].LoadBalancerArn' \
                                    --output text \
                                    2>/dev/null || true
                            ''',
                            returnStdout: true
                        ).trim()


                        if (!albArn || albArn == 'None') {

                            albArn = sh(
                                script: '''
                                    aws elbv2 create-load-balancer \
                                        --region "${AWS_DEFAULT_REGION}" \
                                        --name "${ALB_NAME}" \
                                        --subnets "${SUBNET_1}" "${SUBNET_2}" \
                                        --security-groups "${ALB_SG_ID}" \
                                        --scheme internet-facing \
                                        --type application \
                                        --ip-address-type ipv4 \
                                        --query 'LoadBalancers[0].LoadBalancerArn' \
                                        --output text
                                ''',
                                returnStdout: true
                            ).trim()
                        }


                        env.ALB_ARN = albArn


                        sh '''
                            set -eu

                            aws elbv2 wait load-balancer-available \
                                --region "${AWS_DEFAULT_REGION}" \
                                --load-balancer-arns "${ALB_ARN}"
                        '''


                        env.ALB_DNS = sh(
                            script: '''
                                aws elbv2 describe-load-balancers \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --load-balancer-arns "${ALB_ARN}" \
                                    --query 'LoadBalancers[0].DNSName' \
                                    --output text
                            ''',
                            returnStdout: true
                        ).trim()


                        echo "ALB ARN: ${env.ALB_ARN}"
                        echo "ALB DNS: ${env.ALB_DNS}"
                    }
                }
            }
        }


        stage('41 - Create Target Group') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        def targetGroupArn = sh(
                            script: '''
                                aws elbv2 describe-target-groups \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --names "${TARGET_GROUP_NAME}" \
                                    --query 'TargetGroups[0].TargetGroupArn' \
                                    --output text \
                                    2>/dev/null || true
                            ''',
                            returnStdout: true
                        ).trim()


                        if (!targetGroupArn || targetGroupArn == 'None') {

                            targetGroupArn = sh(
                                script: '''
                                    aws elbv2 create-target-group \
                                        --region "${AWS_DEFAULT_REGION}" \
                                        --name "${TARGET_GROUP_NAME}" \
                                        --protocol HTTP \
                                        --port "${CONTAINER_PORT}" \
                                        --target-type ip \
                                        --vpc-id "${VPC_ID}" \
                                        --health-check-protocol HTTP \
                                        --health-check-path "${HEALTH_PATH}" \
                                        --health-check-port traffic-port \
                                        --health-check-interval-seconds 15 \
                                        --health-check-timeout-seconds 10 \
                                        --healthy-threshold-count 2 \
                                        --unhealthy-threshold-count 5 \
                                        --matcher HttpCode=200-399 \
                                        --query 'TargetGroups[0].TargetGroupArn' \
                                        --output text
                                ''',
                                returnStdout: true
                            ).trim()
                        }


                        env.TARGET_GROUP_ARN = targetGroupArn


                        sh '''
                            set -eu

                            aws elbv2 modify-target-group \
                                --region "${AWS_DEFAULT_REGION}" \
                                --target-group-arn "${TARGET_GROUP_ARN}" \
                                --health-check-path "${HEALTH_PATH}" \
                                --health-check-port traffic-port \
                                --health-check-interval-seconds 15 \
                                --health-check-timeout-seconds 10 \
                                --healthy-threshold-count 2 \
                                --unhealthy-threshold-count 5 \
                                --matcher HttpCode=200-399
                        '''


                        echo "Target Group ARN: ${env.TARGET_GROUP_ARN}"
                    }
                }
            }
        }


        stage('42 - Create ALB Listener') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -eu

                        LISTENER_ARN=$(aws elbv2 describe-listeners \
                            --region "${AWS_DEFAULT_REGION}" \
                            --load-balancer-arn "${ALB_ARN}" \
                            --query 'Listeners[?Port==`80`].ListenerArn | [0]' \
                            --output text)


                        if [ "${LISTENER_ARN}" = "None" ] || [ -z "${LISTENER_ARN}" ]; then

                            aws elbv2 create-listener \
                                --region "${AWS_DEFAULT_REGION}" \
                                --load-balancer-arn "${ALB_ARN}" \
                                --protocol HTTP \
                                --port 80 \
                                --default-actions \
                                    Type=forward,TargetGroupArn="${TARGET_GROUP_ARN}"

                        else

                            aws elbv2 modify-listener \
                                --region "${AWS_DEFAULT_REGION}" \
                                --listener-arn "${LISTENER_ARN}" \
                                --default-actions \
                                    Type=forward,TargetGroupArn="${TARGET_GROUP_ARN}"

                        fi
                    '''
                }
            }
        }


        // ============================================================
        // ECS CLUSTER
        // ============================================================

        stage('43 - Create ECS Cluster') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -eu

                        CLUSTER_STATUS=$(aws ecs describe-clusters \
                            --region "${AWS_DEFAULT_REGION}" \
                            --clusters "${ECS_CLUSTER}" \
                            --query 'clusters[0].status' \
                            --output text \
                            2>/dev/null || true)


                        echo "Cluster status: ${CLUSTER_STATUS}"


                        if [ "${CLUSTER_STATUS}" != "ACTIVE" ]; then

                            aws ecs create-cluster \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster-name "${ECS_CLUSTER}" \
                                > /dev/null 2>&1 || true

                        fi


                        for i in $(seq 1 20)
                        do

                            FINAL_STATUS=$(aws ecs describe-clusters \
                                --region "${AWS_DEFAULT_REGION}" \
                                --clusters "${ECS_CLUSTER}" \
                                --query 'clusters[0].status' \
                                --output text \
                                2>/dev/null || true)


                            echo "Cluster readiness ${i}/20: ${FINAL_STATUS}"


                            if [ "${FINAL_STATUS}" = "ACTIVE" ]; then

                                echo "ECS cluster is ACTIVE."

                                break

                            fi


                            sleep 3

                        done


                        FINAL_STATUS=$(aws ecs describe-clusters \
                            --region "${AWS_DEFAULT_REGION}" \
                            --clusters "${ECS_CLUSTER}" \
                            --query 'clusters[0].status' \
                            --output text)


                        if [ "${FINAL_STATUS}" != "ACTIVE" ]; then

                            echo "ERROR: ECS cluster is not ACTIVE."

                            exit 1

                        fi
                    '''
                }
            }
        }


        // ============================================================
        // TASK DEFINITION
        // ============================================================

        stage('44 - Register ECS Fargate Task Definition') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        env.EXECUTION_ROLE_ARN = sh(
                            script: '''
                                aws iam get-role \
                                    --role-name "practice1-ecsTaskExecutionRole" \
                                    --query 'Role.Arn' \
                                    --output text
                            ''',
                            returnStdout: true
                        ).trim()


                        if (!env.EXECUTION_ROLE_ARN ||
                            env.EXECUTION_ROLE_ARN == 'None') {

                            error('ECS execution role ARN could not be determined.')
                        }


                        sh '''
                            set -eu

                            cat > task-definition.json <<EOF
{
  "family": "${ECS_TASK_FAMILY}",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "${FARGATE_CPU}",
  "memory": "${FARGATE_MEMORY}",
  "executionRoleArn": "${EXECUTION_ROLE_ARN}",
  "containerDefinitions": [
    {
      "name": "${ECS_CONTAINER_NAME}",
      "image": "${ECR_IMAGE}",
      "essential": true,
      "portMappings": [
        {
          "containerPort": ${CONTAINER_PORT},
          "hostPort": ${CONTAINER_PORT},
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "STREAMLIT_SERVER_ADDRESS",
          "value": "0.0.0.0"
        },
        {
          "name": "STREAMLIT_SERVER_PORT",
          "value": "${CONTAINER_PORT}"
        },
        {
          "name": "STREAMLIT_SERVER_HEADLESS",
          "value": "true"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/${ECS_TASK_FAMILY}",
          "awslogs-region": "${AWS_DEFAULT_REGION}",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
EOF


                            aws logs create-log-group \
                                --log-group-name "/ecs/${ECS_TASK_FAMILY}" \
                                --region "${AWS_DEFAULT_REGION}" \
                                2>/dev/null || true


                            aws ecs register-task-definition \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cli-input-json file://task-definition.json


                            TASK_DEFINITION_ARN=$(aws ecs describe-task-definition \
                                --region "${AWS_DEFAULT_REGION}" \
                                --task-definition "${ECS_TASK_FAMILY}" \
                                --query 'taskDefinition.taskDefinitionArn' \
                                --output text)


                            if [ -z "${TASK_DEFINITION_ARN}" ] ||
                               [ "${TASK_DEFINITION_ARN}" = "None" ]; then

                                echo "ERROR: Task definition ARN not found."

                                exit 1

                            fi


                            echo "Task definition:"
                            echo "${TASK_DEFINITION_ARN}"
                        '''
                    }
                }
            }
        }


        // ============================================================
        // ECS SERVICE
        // ============================================================

        stage('45 - Create or Update ECS Fargate Service') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "DEPLOYING ECS FARGATE SERVICE"
                        echo "================================================"


                        SERVICE_STATUS=$(aws ecs describe-services \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}" \
                            --query 'services[0].status' \
                            --output text \
                            2>/dev/null || true)


                        echo "Existing service status: ${SERVICE_STATUS}"


                        if [ "${SERVICE_STATUS}" = "ACTIVE" ]; then

                            echo "Updating existing ECS service..."


                            aws ecs update-service \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --service "${ECS_SERVICE}" \
                                --task-definition "${ECS_TASK_FAMILY}" \
                                --desired-count 1 \
                                --health-check-grace-period-seconds 120 \
                                --force-new-deployment

                        else

                            echo "Creating ECS service..."


                            aws ecs create-service \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --service-name "${ECS_SERVICE}" \
                                --task-definition "${ECS_TASK_FAMILY}" \
                                --desired-count 1 \
                                --launch-type FARGATE \
                                --platform-version LATEST \
                                --health-check-grace-period-seconds 120 \
                                --network-configuration \
                                    "awsvpcConfiguration={subnets=[${SUBNET_1},${SUBNET_2}],securityGroups=[${ECS_SG_ID}],assignPublicIp=ENABLED}" \
                                --load-balancers \
                                    "targetGroupArn=${TARGET_GROUP_ARN},containerName=${ECS_CONTAINER_NAME},containerPort=${CONTAINER_PORT}"

                        fi


                        echo ""
                        echo "Waiting for ECS deployment..."


                        for i in $(seq 1 90)
                        do

                            SERVICE_INFO=$(aws ecs describe-services \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --services "${ECS_SERVICE}" \
                                --query 'services[0].[status,desiredCount,runningCount,pendingCount]' \
                                --output text \
                                2>/dev/null || true)


                            STATUS=$(echo "${SERVICE_INFO}" | awk '{print $1}')
                            DESIRED=$(echo "${SERVICE_INFO}" | awk '{print $2}')
                            RUNNING=$(echo "${SERVICE_INFO}" | awk '{print $3}')
                            PENDING=$(echo "${SERVICE_INFO}" | awk '{print $4}')


                            echo "ECS deployment check ${i}/90: status=${STATUS} desired=${DESIRED} running=${RUNNING} pending=${PENDING}"


                            if [ "${STATUS}" = "ACTIVE" ] &&
                               [ "${DESIRED:-0}" -ge 1 ] &&
                               [ "${RUNNING:-0}" -ge 1 ]; then

                                echo "ECS reports at least one running task."

                                break

                            fi


                            sleep 5

                        done


                        echo ""
                        echo "Final ECS service state:"


                        aws ecs describe-services \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}" \
                            --query 'services[0].{Status:status,Desired:desiredCount,Running:runningCount,Pending:pendingCount,Deployments:deployments,Events:events[0:15]}' \
                            --output json


                        FINAL_RUNNING=$(aws ecs describe-services \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}" \
                            --query 'services[0].runningCount' \
                            --output text)


                        if [ "${FINAL_RUNNING}" -lt 1 ]; then

                            echo ""
                            echo "ERROR: ECS service has no running task."

                            echo ""
                            echo "Recent ECS service events:"

                            aws ecs describe-services \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --services "${ECS_SERVICE}" \
                                --query 'services[0].events[0:20]' \
                                --output table || true

                            exit 1

                        fi


                        echo ""
                        echo "ECS service deployment accepted."
                    '''
                }
            }
        }


        // ============================================================
        // FIXED ECS TASK VERIFICATION
        // ============================================================

        stage('46 - Verify ECS Running Task') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "VERIFYING ECS FARGATE TASK"
                        echo "================================================"


                        RUNNING_COUNT=$(aws ecs describe-services \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}" \
                            --query 'services[0].runningCount' \
                            --output text)


                        DESIRED_COUNT=$(aws ecs describe-services \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}" \
                            --query 'services[0].desiredCount' \
                            --output text)


                        echo "Desired tasks : ${DESIRED_COUNT}"
                        echo "Running tasks : ${RUNNING_COUNT}"


                        if [ "${RUNNING_COUNT}" -lt 1 ]; then

                            echo "ERROR: No running Fargate task."

                            aws ecs describe-services \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --services "${ECS_SERVICE}" \
                                --query 'services[0].events[0:20]' \
                                --output table || true

                            exit 1

                        fi


                        TASK_ARN="None"


                        echo ""
                        echo "Waiting for ECS task ARN to become visible..."


                        for i in $(seq 1 36)
                        do

                            TASK_ARN=$(aws ecs list-tasks \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --service-name "${ECS_SERVICE}" \
                                --desired-status RUNNING \
                                --query 'taskArns[0]' \
                                --output text \
                                2>/dev/null || true)


                            echo "Task discovery attempt ${i}/36: ${TASK_ARN}"


                            if [ -n "${TASK_ARN}" ] &&
                               [ "${TASK_ARN}" != "None" ]; then

                                break

                            fi


                            sleep 5

                        done


                        if [ -z "${TASK_ARN}" ] ||
                           [ "${TASK_ARN}" = "None" ]; then

                            echo ""
                            echo "Primary task lookup did not return an ARN."
                            echo "Using ECS service deployment fallback..."


                            TASK_ARN=$(aws ecs list-tasks \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --service-name "${ECS_SERVICE}" \
                                --query 'taskArns[0]' \
                                --output text \
                                2>/dev/null || true)

                        fi


                        if [ -z "${TASK_ARN}" ] ||
                           [ "${TASK_ARN}" = "None" ]; then

                            echo ""
                            echo "ERROR: ECS reports a running task but no task ARN is currently discoverable."


                            echo ""
                            echo "ECS SERVICE DETAILS:"


                            aws ecs describe-services \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --services "${ECS_SERVICE}" \
                                --query 'services[0].{Status:status,Desired:desiredCount,Running:runningCount,Pending:pendingCount,Deployments:deployments,Events:events[0:20]}' \
                                --output json || true


                            echo ""
                            echo "ALL ECS TASKS:"


                            aws ecs list-tasks \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --service-name "${ECS_SERVICE}" \
                                --output table || true


                            exit 1

                        fi


                        echo ""
                        echo "Running Task:"
                        echo "${TASK_ARN}"


                        TASK_STATUS=$(aws ecs describe-tasks \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --tasks "${TASK_ARN}" \
                            --query 'tasks[0].lastStatus' \
                            --output text)


                        echo "Task Status: ${TASK_STATUS}"


                        if [ "${TASK_STATUS}" != "RUNNING" ]; then

                            echo ""
                            echo "ERROR: Task ARN was found but task is not RUNNING."


                            aws ecs describe-tasks \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --tasks "${TASK_ARN}" \
                                --query 'tasks[0].{LastStatus:lastStatus,DesiredStatus:desiredStatus,Health:healthStatus,StoppedReason:stoppedReason,StopCode:stopCode,Containers:containers[*].{Name:name,Status:lastStatus,ExitCode:exitCode,Reason:reason}}' \
                                --output json || true

                            exit 1

                        fi


                        echo ""
                        echo "ECS TASK IS CONFIRMED RUNNING."


                        aws ecs describe-tasks \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --tasks "${TASK_ARN}" \
                            --query 'tasks[0].{TaskArn:taskArn,LastStatus:lastStatus,DesiredStatus:desiredStatus,Health:healthStatus}' \
                            --output table
                    '''
                }
            }
        }


        stage('47 - Verify ALB Target Health') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "VERIFYING CURRENT ALB TARGET HEALTH"
                        echo "================================================"


                        TASK_ARN="None"


                        for i in $(seq 1 24)
                        do

                            TASK_ARN=$(aws ecs list-tasks \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --service-name "${ECS_SERVICE}" \
                                --desired-status RUNNING \
                                --query 'taskArns[0]' \
                                --output text \
                                2>/dev/null || true)


                            if [ -n "${TASK_ARN}" ] &&
                               [ "${TASK_ARN}" != "None" ]; then

                                break

                            fi


                            echo "Waiting for running task visibility ${i}/24..."

                            sleep 5

                        done


                        if [ -z "${TASK_ARN}" ] ||
                           [ "${TASK_ARN}" = "None" ]; then

                            echo "ERROR: No RUNNING ECS task exists."

                            exit 1

                        fi


                        TASK_IP=$(aws ecs describe-tasks \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --tasks "${TASK_ARN}" \
                            --query "tasks[0].attachments[?type=='ElasticNetworkInterface'].details[?name=='privateIPv4Address'].value | [0]" \
                            --output text)


                        TASK_ENI=$(aws ecs describe-tasks \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --tasks "${TASK_ARN}" \
                            --query "tasks[0].attachments[?type=='ElasticNetworkInterface'].details[?name=='networkInterfaceId'].value | [0]" \
                            --output text)


                        echo "Running task : ${TASK_ARN}"
                        echo "Task IP      : ${TASK_IP}"
                        echo "Task ENI     : ${TASK_ENI}"


                        if [ -z "${TASK_IP}" ] ||
                           [ "${TASK_IP}" = "None" ]; then

                            echo "ERROR: Could not determine task private IP."

                            exit 1

                        fi


                        echo ""
                        echo "ECS task/container state:"


                        aws ecs describe-tasks \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --tasks "${TASK_ARN}" \
                            --query 'tasks[0].{LastStatus:lastStatus,Health:healthStatus,StoppedReason:stoppedReason,Containers:containers[*].{Name:name,LastStatus:lastStatus,ExitCode:exitCode,Reason:reason}}' \
                            --output table


                        HEALTH="not-registered"


                        for i in $(seq 1 45)
                        do

                            TARGET_JSON=$(aws elbv2 describe-target-health \
                                --region "${AWS_DEFAULT_REGION}" \
                                --target-group-arn "${TARGET_GROUP_ARN}" \
                                --query "TargetHealthDescriptions[?Target.Id=='${TASK_IP}'].[TargetHealth.State,TargetHealth.Reason,TargetHealth.Description] | [0]" \
                                --output text \
                                2>/dev/null || true)


                            HEALTH=$(echo "${TARGET_JSON}" | awk '{print $1}')
                            REASON=$(echo "${TARGET_JSON}" | awk '{print $2}')
                            DESCRIPTION=$(echo "${TARGET_JSON}" | cut -d' ' -f3-)


                            if [ -z "${HEALTH}" ] ||
                               [ "${HEALTH}" = "None" ]; then

                                HEALTH="not-registered"

                            fi


                            echo "ALB health ${i}/45: ${HEALTH} | ${REASON} | ${DESCRIPTION}"


                            if [ "${HEALTH}" = "healthy" ]; then

                                echo ""
                                echo "CURRENT FARGATE TARGET IS HEALTHY."

                                break

                            fi


                            sleep 10

                        done


                        if [ "${HEALTH}" != "healthy" ]; then

                            echo ""
                            echo "ERROR: Current Fargate target did not become healthy."


                            echo ""
                            echo "All target registrations:"


                            aws elbv2 describe-target-health \
                                --region "${AWS_DEFAULT_REGION}" \
                                --target-group-arn "${TARGET_GROUP_ARN}" \
                                --output table || true


                            echo ""
                            echo "ECS service events:"


                            aws ecs describe-services \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --services "${ECS_SERVICE}" \
                                --query 'services[0].events[0:20]' \
                                --output table || true


                            exit 1

                        fi
                    '''
                }
            }
        }


        stage('48 - Verify ALB DNS') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        env.ALB_DNS = sh(
                            script: '''
                                aws elbv2 describe-load-balancers \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --load-balancer-arns "${ALB_ARN}" \
                                    --query 'LoadBalancers[0].DNSName' \
                                    --output text
                            ''',
                            returnStdout: true
                        ).trim()


                        if (!env.ALB_DNS || env.ALB_DNS == 'None') {
                            error('Could not retrieve ALB DNS.')
                        }


                        env.APPLICATION_URL =
                            "http://${env.ALB_DNS}"


                        echo "ALB DNS: ${env.ALB_DNS}"
                        echo "Application URL: ${env.APPLICATION_URL}"
                    }
                }
            }
        }


        stage('49 - HTTP Application Health Check') {

            steps {

                sh '''
                    set -eu

                    echo "================================================"
                    echo "CHECKING APPLICATION"
                    echo "================================================"

                    echo "URL: ${APPLICATION_URL}"


                    for i in $(seq 1 30)
                    do

                        HTTP_CODE=$(curl \
                            --connect-timeout 10 \
                            --max-time 20 \
                            --silent \
                            --output /dev/null \
                            --write-out "%{http_code}" \
                            "${APPLICATION_URL}/" \
                            || true)


                        echo "HTTP check ${i}/30: ${HTTP_CODE}"


                        case "${HTTP_CODE}" in

                            2??|3??)

                                echo "APPLICATION HTTP CHECK PASSED."

                                exit 0
                                ;;

                        esac


                        sleep 10

                    done


                    echo "ERROR: Application did not respond successfully."

                    exit 1
                '''
            }
        }


        stage('50 - Final Deployment Verification') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -eu

                        echo ""
                        echo "================================================"
                        echo "FINAL DEPLOYMENT VERIFICATION"
                        echo "================================================"

                        echo "Environment      : ${ENVIRONMENT}"
                        echo "ECR Image        : ${ECR_IMAGE}"
                        echo "ECS Cluster      : ${ECS_CLUSTER}"
                        echo "ECS Service      : ${ECS_SERVICE}"
                        echo "Task Definition  : ${ECS_TASK_FAMILY}"
                        echo "ALB              : ${ALB_NAME}"
                        echo "ALB DNS          : ${ALB_DNS}"
                        echo "Application URL  : ${APPLICATION_URL}"

                        echo ""
                        echo "APPLICATION IS LIVE"
                    '''
                }
            }
        }


        // ============================================================
        // PART 7
        // ============================================================

        stage('51 - Part 7 - Wait for Application Startup') {

            steps {

                echo '================================================'
                echo 'PART 7 - POST DEPLOYMENT HEALTH CHECK'
                echo '================================================'

                sleep(
                    time: 20,
                    unit: 'SECONDS'
                )
            }
        }


        stage('52 - Part 7 - Verify ECS Service') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "PART 7 - VERIFYING ECS SERVICE"
                        echo "================================================"


                        for i in $(seq 1 30)
                        do

                            SERVICE_INFO=$(aws ecs describe-services \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --services "${ECS_SERVICE}" \
                                --query 'services[0].[status,desiredCount,runningCount,pendingCount]' \
                                --output text \
                                2>/dev/null || true)


                            SERVICE_STATUS=$(echo "${SERVICE_INFO}" | awk '{print $1}')
                            DESIRED_COUNT=$(echo "${SERVICE_INFO}" | awk '{print $2}')
                            RUNNING_COUNT=$(echo "${SERVICE_INFO}" | awk '{print $3}')
                            PENDING_COUNT=$(echo "${SERVICE_INFO}" | awk '{print $4}')


                            echo "Check ${i}/30: status=${SERVICE_STATUS} desired=${DESIRED_COUNT} running=${RUNNING_COUNT} pending=${PENDING_COUNT}"


                            if [ "${SERVICE_STATUS}" = "ACTIVE" ] &&
                               [ "${RUNNING_COUNT:-0}" -ge 1 ] &&
                               [ "${RUNNING_COUNT:-0}" -ge "${DESIRED_COUNT:-1}" ]; then

                                echo ""
                                echo "ECS SERVICE CHECK: PASSED"

                                exit 0

                            fi


                            sleep 5

                        done


                        echo ""
                        echo "ERROR: ECS service did not remain healthy."


                        aws ecs describe-services \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}" \
                            --query 'services[0].{Status:status,Desired:desiredCount,Running:runningCount,Pending:pendingCount,Deployments:deployments,Events:events[0:20]}' \
                            --output json || true


                        exit 1
                    '''
                }
            }
        }


        stage('53 - Part 7 - Verify Running Task and Container') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "PART 7 - VERIFYING TASK AND CONTAINER"
                        echo "================================================"


                        TASK_ARN="None"


                        for i in $(seq 1 36)
                        do

                            TASK_ARN=$(aws ecs list-tasks \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --service-name "${ECS_SERVICE}" \
                                --desired-status RUNNING \
                                --query 'taskArns[0]' \
                                --output text \
                                2>/dev/null || true)


                            echo "Task lookup ${i}/36: ${TASK_ARN}"


                            if [ -n "${TASK_ARN}" ] &&
                               [ "${TASK_ARN}" != "None" ]; then

                                break

                            fi


                            sleep 5

                        done


                        if [ -z "${TASK_ARN}" ] ||
                           [ "${TASK_ARN}" = "None" ]; then

                            echo "ERROR: Running task ARN could not be discovered."

                            exit 1

                        fi


                        TASK_STATUS=$(aws ecs describe-tasks \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --tasks "${TASK_ARN}" \
                            --query 'tasks[0].lastStatus' \
                            --output text)


                        CONTAINER_STATUS=$(aws ecs describe-tasks \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --tasks "${TASK_ARN}" \
                            --query "tasks[0].containers[?name=='${ECS_CONTAINER_NAME}'].lastStatus | [0]" \
                            --output text)


                        echo ""
                        echo "Task ARN        : ${TASK_ARN}"
                        echo "Task Status     : ${TASK_STATUS}"
                        echo "Container       : ${ECS_CONTAINER_NAME}"
                        echo "Container State : ${CONTAINER_STATUS}"


                        if [ "${TASK_STATUS}" != "RUNNING" ]; then

                            echo ""
                            echo "ERROR: ECS task is not RUNNING."

                            aws ecs describe-tasks \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --tasks "${TASK_ARN}" \
                                --query 'tasks[0].{LastStatus:lastStatus,Health:healthStatus,StoppedReason:stoppedReason,StopCode:stopCode,Containers:containers}' \
                                --output json || true

                            exit 1

                        fi


                        if [ "${CONTAINER_STATUS}" != "RUNNING" ]; then

                            echo ""
                            echo "ERROR: Application container is not RUNNING."

                            exit 1

                        fi


                        echo ""
                        echo "TASK CHECK: PASSED"
                        echo "CONTAINER CHECK: PASSED"
                    '''
                }
            }
        }


        stage('54 - Part 7 - Verify ALB Target Health') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "PART 7 - VERIFYING LOAD BALANCER TARGET"
                        echo "================================================"


                        TASK_ARN="None"


                        for i in $(seq 1 36)
                        do

                            TASK_ARN=$(aws ecs list-tasks \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --service-name "${ECS_SERVICE}" \
                                --desired-status RUNNING \
                                --query 'taskArns[0]' \
                                --output text \
                                2>/dev/null || true)


                            if [ -n "${TASK_ARN}" ] &&
                               [ "${TASK_ARN}" != "None" ]; then

                                break

                            fi


                            echo "Waiting for task visibility ${i}/36..."

                            sleep 5

                        done


                        if [ -z "${TASK_ARN}" ] ||
                           [ "${TASK_ARN}" = "None" ]; then

                            echo "ERROR: No running task found."

                            exit 1

                        fi


                        TASK_IP=$(aws ecs describe-tasks \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --tasks "${TASK_ARN}" \
                            --query "tasks[0].attachments[?type=='ElasticNetworkInterface'].details[?name=='privateIPv4Address'].value | [0]" \
                            --output text)


                        if [ -z "${TASK_IP}" ] ||
                           [ "${TASK_IP}" = "None" ]; then

                            echo "ERROR: Could not determine task IP."

                            exit 1

                        fi


                        echo "Task IP: ${TASK_IP}"
                        echo "Target Group: ${TARGET_GROUP_NAME}"


                        HEALTH="not-registered"


                        for i in $(seq 1 30)
                        do

                            HEALTH=$(aws elbv2 describe-target-health \
                                --region "${AWS_DEFAULT_REGION}" \
                                --target-group-arn "${TARGET_GROUP_ARN}" \
                                --query "TargetHealthDescriptions[?Target.Id=='${TASK_IP}'].TargetHealth.State | [0]" \
                                --output text \
                                2>/dev/null || true)


                            echo "ALB health ${i}/30: ${HEALTH}"


                            if [ "${HEALTH}" = "healthy" ]; then

                                echo ""
                                echo "ALB TARGET HEALTH: PASSED"

                                break

                            fi


                            sleep 10

                        done


                        if [ "${HEALTH}" != "healthy" ]; then

                            echo ""
                            echo "ERROR: Current ECS task target is not healthy."


                            aws elbv2 describe-target-health \
                                --region "${AWS_DEFAULT_REGION}" \
                                --target-group-arn "${TARGET_GROUP_ARN}" \
                                --output table || true


                            exit 1

                        fi
                    '''
                }
            }
        }


        stage('55 - Part 7 - Verify Application URL') {

            steps {

                sh '''
                    set -eu

                    echo "================================================"
                    echo "PART 7 - APPLICATION HEALTH CHECK"
                    echo "================================================"


                    if [ -z "${APPLICATION_URL}" ]; then

                        echo "ERROR: APPLICATION_URL is empty."

                        exit 1

                    fi


                    echo "Application URL:"
                    echo "${APPLICATION_URL}"


                    SUCCESS=false


                    for i in $(seq 1 30)
                    do

                        HTTP_CODE=$(curl \
                            --connect-timeout 10 \
                            --max-time 20 \
                            --silent \
                            --show-error \
                            --output /dev/null \
                            --write-out "%{http_code}" \
                            "${APPLICATION_URL}${HEALTH_PATH}" \
                            || true)


                        echo "Application health ${i}/30: ${HTTP_CODE}"


                        case "${HTTP_CODE}" in

                            2??|3??)

                                SUCCESS=true

                                break
                                ;;

                        esac


                        sleep 10

                    done


                    if [ "${SUCCESS}" != "true" ]; then

                        echo ""
                        echo "APPLICATION HEALTH CHECK FAILED."

                        exit 1

                    fi


                    echo ""
                    echo "APPLICATION HTTP HEALTH CHECK: PASSED"
                '''
            }
        }


        stage('56 - Part 7 - Final Health Summary') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -eu

                        echo ""
                        echo "================================================"
                        echo "        PART 7 HEALTH CHECK SUMMARY"
                        echo "================================================"

                        echo ""
                        echo "Environment       : ${ENVIRONMENT}"
                        echo "ECS Cluster       : ${ECS_CLUSTER}"
                        echo "ECS Service       : ${ECS_SERVICE}"
                        echo "Container         : ${ECS_CONTAINER_NAME}"
                        echo "ALB               : ${ALB_NAME}"
                        echo "Target Group      : ${TARGET_GROUP_NAME}"
                        echo "Application URL   : ${APPLICATION_URL}"

                        echo ""
                        echo "------------------------------------------------"
                        echo "ECS SERVICE        : HEALTHY"
                        echo "FARGATE TASK       : RUNNING"
                        echo "CONTAINER          : RUNNING"
                        echo "ALB TARGET         : HEALTHY"
                        echo "APPLICATION HTTP   : HEALTHY"
                        echo "------------------------------------------------"

                        echo ""
                        echo "PART 7 - HEALTH CHECK: PASSED"

                        echo ""
                        echo "================================================"
                        echo "       DEPLOYMENT IS GENUINELY HEALTHY"
                        echo "================================================"
                    '''
                }
            }
        }
    }


    // ================================================================
    // POST ACTIONS
    // ================================================================

    post {

        success {

            echo ''
            echo '================================================'
            echo '       COMPLETE CI/CD PIPELINE SUCCESS'
            echo '================================================'

            echo ''
            echo 'PART 1 - CODE QUALITY      : PASSED'
            echo 'PART 2 - TESTING           : PASSED'
            echo 'PART 3 - DOCKER            : PASSED'
            echo 'PART 4 - ECR               : PASSED'
            echo 'PART 5 - TERRAFORM         : PASSED'
            echo 'PART 6 - ECS FARGATE       : PASSED'
            echo 'PART 6 - ALB               : PASSED'
            echo 'PART 6 - HTTP CHECK        : PASSED'
            echo 'PART 7 - HEALTH CHECK      : PASSED'

            echo ''
            echo '================================================'
            echo '          FINAL APPLICATION URL'
            echo '================================================'

            echo "${env.APPLICATION_URL}"

            echo ''
            echo '================================================'
            echo '          DEPLOYMENT COMPLETE'
            echo '================================================'
        }


        failure {

            echo ''
            echo '================================================'
            echo '          CI/CD PIPELINE FAILED'
            echo '================================================'

            echo ''
            echo 'The pipeline stopped because a deployment or health check failed.'

            echo ''
            echo 'Possible areas to inspect:'
            echo '1. ECS service'
            echo '2. Fargate task'
            echo '3. Container'
            echo '4. ALB target group'
            echo '5. Application HTTP endpoint'

            echo ''
            echo 'Check the Jenkins console output above.'

            echo '================================================'
        }


        always {

            echo ''
            echo '================================================'
            echo 'CLEANING JENKINS WORKSPACE'
            echo '================================================'

            cleanWs(
                deleteDirs: true,
                disableDeferredWipeout: true
            )
        }
    }
}
