pipeline {

    agent any

    // ================================================================
    // PIPELINE OPTIONS
    // ================================================================

    options {

        timestamps()

        ansiColor('xterm')

        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                daysToKeepStr: '30',
                numToKeepStr: '50'
            )
        )

        timeout(
            time: 120,
            unit: 'MINUTES'
        )
    }


    // ================================================================
    // PARAMETERS
    // ================================================================

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: [
                'dev',
                'qa',
                'stage',
                'prod'
            ],
            description: 'Terraform environment to deploy'
        )
    }


    // ================================================================
    // ENVIRONMENT
    // ================================================================

    environment {

        APP_REPO = 'https://github.com/FAIZANSHEIKH223/practice1.git'
        APP_BRANCH = 'main'

        QUALITY_REPO = 'https://github.com/FAIZANSHEIKH223/pylint_flake8_int_jenkins.git'
        QUALITY_BRANCH = 'main'

        TERRAFORM_REPO = 'https://github.com/FAIZANSHEIKH223/terraform-aws-infra.git'
        TERRAFORM_BRANCH = 'main'

        GITHUB_CREDENTIALS = 'github-creds'
        AWS_CREDENTIALS = 'aws-creds'

        APP_DIR = 'practice1'
        QUALITY_DIR = 'quality-tools'
        TERRAFORM_DIR = 'terraform-infra'

        VENV_DIR = 'venv'
        REPORT_DIR = 'reports'

        PYTHON = 'python3.12'

        AWS_DEFAULT_REGION = 'us-east-1'

        APP_NAME = 'practice1'
        CONTAINER_NAME = 'practice1'
        CONTAINER_PORT = '8501'

        DOCKER_IMAGE_NAME = 'practice1'
        DOCKER_IMAGE_TAG = "${BUILD_NUMBER}"
        DOCKER_IMAGE = "${DOCKER_IMAGE_NAME}:${DOCKER_IMAGE_TAG}"

        ECR_REPOSITORY = 'practice1'
        ECR_IMAGE_TAG = "${BUILD_NUMBER}"

        ECS_CLUSTER = "practice1-${ENVIRONMENT}-cluster"
        ECS_SERVICE = "practice1-${ENVIRONMENT}-service"
        ECS_TASK_FAMILY = "practice1-${ENVIRONMENT}-task"
        ECS_CONTAINER_NAME = 'practice1'

        FARGATE_CPU = '256'
        FARGATE_MEMORY = '512'

        ALB_NAME = "practice1-${ENVIRONMENT}-alb"
        TARGET_GROUP_NAME = "practice1-${ENVIRONMENT}-tg"
        ALB_SG_NAME = "practice1-${ENVIRONMENT}-alb-sg"
        ECS_SG_NAME = "practice1-${ENVIRONMENT}-ecs-sg"

        TF_STATE_BUCKET = 'terraform-state-faizan-001'
        TF_LOCK_TABLE = 'terraform-locks'
        TF_STATE_KEY = 'terraform.tfstate'

        TF_IN_AUTOMATION = 'true'
        TF_INPUT = 'false'
    }


    // ================================================================
    // STAGES
    // ================================================================

    stages {


        // ============================================================
        // PART 1 - CODE QUALITY
        // ============================================================

        stage('1 - Checkout Application') {

            steps {

                echo '================================================'
                echo 'CHECKOUT APPLICATION'
                echo '================================================'

                dir("${APP_DIR}") {

                    deleteDir()

                    git(
                        branch: "${APP_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${APP_REPO}"
                    )
                }
            }
        }


        stage('2 - Checkout Quality Repository') {

            steps {

                echo '================================================'
                echo 'CHECKOUT QUALITY REPOSITORY'
                echo '================================================'

                dir("${QUALITY_DIR}") {

                    deleteDir()

                    git(
                        branch: "${QUALITY_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${QUALITY_REPO}"
                    )
                }
            }
        }


        stage('3 - Verify Python') {

            steps {

                dir("${APP_DIR}") {

                    sh(
                        script: '''#!/usr/bin/env bash
set -euo pipefail

echo "================================================"
echo "VERIFYING PYTHON"
echo "================================================"

command -v "${PYTHON}"

"${PYTHON}" --version

"${PYTHON}" -m pip --version
''',
                        label: 'Verify Python'
                    )
                }
            }
        }


        stage('4 - Create Python Virtual Environment') {

            steps {

                dir("${APP_DIR}") {

                    sh(
                        script: '''#!/usr/bin/env bash
set -euo pipefail

echo "================================================"
echo "CREATING PYTHON VIRTUAL ENVIRONMENT"
echo "================================================"

rm -rf "${VENV_DIR}"

"${PYTHON}" -m venv "${VENV_DIR}"

"${VENV_DIR}/bin/python" --version
''',
                        label: 'Create Python virtual environment'
                    )
                }
            }
        }


        stage('5 - Install Application Dependencies') {

            steps {

                dir("${APP_DIR}") {

                    sh(
                        script: '''#!/usr/bin/env bash
set -euo pipefail

echo "================================================"
echo "INSTALLING APPLICATION DEPENDENCIES"
echo "================================================"

"${VENV_DIR}/bin/python" -m pip install --upgrade pip

if [ -f requirements.txt ]; then

    "${VENV_DIR}/bin/pip" install -r requirements.txt

else

    echo "WARNING: requirements.txt not found."

fi
''',
                        label: 'Install application dependencies'
                    )
                }
            }
        }


        stage('6 - Install Quality Tools') {

            steps {

                dir("${APP_DIR}") {

                    sh(
                        script: '''#!/usr/bin/env bash
set -euo pipefail

echo "================================================"
echo "INSTALLING QUALITY TOOLS"
echo "================================================"

"${VENV_DIR}/bin/pip" install flake8 pylint

"${VENV_DIR}/bin/flake8" --version

"${VENV_DIR}/bin/pylint" --version
''',
                        label: 'Install quality tools'
                    )
                }
            }
        }


        stage('7 - Flake8 Code Quality') {

            steps {

                dir("${APP_DIR}") {

                    sh(
                        script: '''#!/usr/bin/env bash
set -euo pipefail

mkdir -p "${REPORT_DIR}"

echo "================================================"
echo "RUNNING FLAKE8"
echo "================================================"

"${VENV_DIR}/bin/flake8" \
    . \
    --exclude="${VENV_DIR},.git,${REPORT_DIR},__pycache__" \
    --count \
    --statistics \
    --tee \
    --output-file="${REPORT_DIR}/flake8-report.txt"
''',
                        label: 'Run Flake8'
                    )
                }
            }
        }


        stage('8 - Pylint Code Quality') {

            steps {

                dir("${APP_DIR}") {

                    sh(
                        script: '''#!/usr/bin/env bash
set -euo pipefail

mkdir -p "${REPORT_DIR}"

echo "================================================"
echo "RUNNING PYLINT"
echo "================================================"

mapfile -t PYTHON_FILES < <(
    find . \
        -type f \
        -name "*.py" \
        ! -path "./${VENV_DIR}/*" \
        ! -path "./.git/*" \
        ! -path "./${REPORT_DIR}/*" \
        ! -path "*/__pycache__/*"
)

if [ "${#PYTHON_FILES[@]}" -eq 0 ]; then

    echo "ERROR: No Python files found."

    exit 1

fi

"${VENV_DIR}/bin/pylint" \
    "${PYTHON_FILES[@]}" \
    --output-format=text \
    > "${REPORT_DIR}/pylint-report.txt"
''',
                        label: 'Run Pylint'
                    )
                }
            }
        }


        stage('9 - Part 1 Success') {

            steps {

                echo '================================================'
                echo 'PART 1 - CODE QUALITY SUCCESS'
                echo '================================================'

                echo 'Flake8 : PASSED'
                echo 'Pylint : PASSED'
            }
        }


        // ============================================================
        // PART 2 - TESTING
        // ============================================================

        stage('10 - Install Pytest') {

            steps {

                dir("${APP_DIR}") {

                    sh(
                        script: '''#!/usr/bin/env bash
set -euo pipefail

"${VENV_DIR}/bin/pip" install pytest

"${VENV_DIR}/bin/pytest" --version
''',
                        label: 'Install pytest'
                    )
                }
            }
        }


        stage('11 - Verify Tests') {

            steps {

                dir("${APP_DIR}") {

                    sh(
                        script: '''#!/usr/bin/env bash
set -euo pipefail

echo "================================================"
echo "VERIFYING TESTS"
echo "================================================"

if [ ! -d "tests" ]; then

    echo "ERROR: tests/ directory does not exist."

    exit 1

fi

mapfile -t TEST_FILES < <(
    find tests \
        -type f \
        \\( \
            -name "test_*.py" \
            -o \
            -name "*_test.py" \
        \\)
)

if [ "${#TEST_FILES[@]}" -eq 0 ]; then

    echo "ERROR: No pytest test files found."

    exit 1

fi

echo "Test files:"

printf '%s\\n' "${TEST_FILES[@]}"
''',
                        label: 'Verify tests'
                    )
                }
            }
        }


        stage('12 - Run Automated Tests') {

            steps {

                dir("${APP_DIR}") {

                    sh(
                        script: '''#!/usr/bin/env bash
set -euo pipefail

mkdir -p "${REPORT_DIR}"

"${VENV_DIR}/bin/pytest" \
    tests/ \
    -v \
    --junitxml="${REPORT_DIR}/pytest-results.xml"
''',
                        label: 'Run automated tests'
                    )
                }
            }
        }


        stage('13 - Publish Test Results') {

            steps {

                junit(
                    testResults: "${APP_DIR}/${REPORT_DIR}/pytest-results.xml",
                    allowEmptyResults: false
                )

                archiveArtifacts(
                    artifacts:
                        "${APP_DIR}/${REPORT_DIR}/pytest-results.xml," +
                        "${APP_DIR}/${REPORT_DIR}/flake8-report.txt," +
                        "${APP_DIR}/${REPORT_DIR}/pylint-report.txt",
                    allowEmptyArchive: false,
                    fingerprint: true
                )
            }
        }


        stage('14 - Part 2 Success') {

            steps {

                echo '================================================'
                echo 'PART 2 - TESTING SUCCESS'
                echo '================================================'

                echo 'Pytest : PASSED'
            }
        }


        // ============================================================
        // PART 3 - DOCKER
        // ============================================================

        stage('15 - Verify Docker') {

            steps {

                sh(
                    script: '''#!/usr/bin/env bash
set -euo pipefail

command -v docker

docker --version

docker info > /dev/null

echo "Docker daemon is accessible."
''',
                    label: 'Verify Docker'
                )
            }
        }


        stage('16 - Prepare Docker Build Context') {

            steps {

                dir("${APP_DIR}") {

                    sh(
                        script: '''#!/usr/bin/env bash
set -euo pipefail

if [ ! -f Dockerfile ]; then

    echo "ERROR: Dockerfile not found."

    exit 1

fi

cat > .dockerignore <<'EOF'
venv/
.venv/
.git/
.gitignore
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
reports/
*.log
.DS_Store
EOF

echo ""
echo "Docker ignore file:"
cat .dockerignore

echo ""
echo "Dockerfile:"
cat Dockerfile
''',
                        label: 'Prepare Docker build context'
                    )
                }
            }
        }


        stage('17 - Build Docker Image') {

            steps {

                dir("${APP_DIR}") {

                    sh(
                        script: '''#!/usr/bin/env bash
set -euo pipefail

docker build \
    --pull \
    --tag "${DOCKER_IMAGE}" \
    .

docker image inspect "${DOCKER_IMAGE}" > /dev/null

echo "Docker image created successfully."
''',
                        label: 'Build Docker image'
                    )
                }
            }
        }


        stage('18 - Docker Image Verification') {

            steps {

                sh(
                    script: '''#!/usr/bin/env bash
set -euo pipefail

docker image inspect \
    "${DOCKER_IMAGE}" \
    --format='Image={{.RepoTags}} Size={{.Size}}'

docker images "${DOCKER_IMAGE_NAME}"
''',
                    label: 'Verify Docker image'
                )
            }
        }


        stage('19 - Part 3 Success') {

            steps {

                echo '================================================'
                echo 'PART 3 - DOCKER SUCCESS'
                echo '================================================'

                echo "Docker Image: ${DOCKER_IMAGE}"
            }
        }


        // ============================================================
        // PART 4 - ECR
        // ============================================================

        stage('20 - Verify AWS CLI') {

            steps {

                sh(
                    script: '''#!/usr/bin/env bash
set -euo pipefail

command -v aws

aws --version
''',
                    label: 'Verify AWS CLI'
                )
            }
        }


        stage('21 - Verify AWS Credentials') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh(
                        script: '''#!/usr/bin/env bash
set -euo pipefail

aws sts get-caller-identity \
    --region "${AWS_DEFAULT_REGION}"
''',
                        label: 'Verify AWS credentials'
                    )
                }
            }
        }


        stage('22 - Create Or Reuse ECR Repository') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh(
                        script: '''#!/usr/bin/env bash
set -euo pipefail

echo "================================================"
echo "CHECKING ECR REPOSITORY"
echo "================================================"

if aws ecr describe-repositories \
    --repository-names "${ECR_REPOSITORY}" \
    --region "${AWS_DEFAULT_REGION}" \
    > /dev/null 2>&1
then

    echo "ECR repository already exists."
    echo "REUSING existing ECR repository."

else

    echo "ECR repository does not exist."
    echo "Creating ECR repository."

    aws ecr create-repository \
        --repository-name "${ECR_REPOSITORY}" \
        --region "${AWS_DEFAULT_REGION}"

fi

REPOSITORY_URI=$(aws ecr describe-repositories \
    --repository-names "${ECR_REPOSITORY}" \
    --region "${AWS_DEFAULT_REGION}" \
    --query 'repositories[0].repositoryUri' \
    --output text)

if [ -z "${REPOSITORY_URI}" ] ||
   [ "${REPOSITORY_URI}" = "None" ]; then

    echo "ERROR: ECR repository could not be verified."

    exit 1

fi

echo "Repository URI: ${REPOSITORY_URI}"
''',
                        label: 'Create or reuse ECR repository'
                    )
                }
            }
        }


        stage('23 - Get ECR Image URI') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        def accountId = sh(
                            script: '''#!/usr/bin/env bash
set -euo pipefail

aws sts get-caller-identity \
    --query Account \
    --output text \
    --region "${AWS_DEFAULT_REGION}"
''',
                            returnStdout: true
                        ).trim()

                        if (!accountId ||
                            accountId == 'None') {

                            error('Unable to determine AWS account ID.')
                        }

                        env.AWS_ACCOUNT_ID = accountId

                        env.ECR_REGISTRY =
                            "${accountId}.dkr.ecr.${AWS_DEFAULT_REGION}.amazonaws.com"

                        env.ECR_IMAGE =
                            "${env.ECR_REGISTRY}/${env.ECR_REPOSITORY}:${env.ECR_IMAGE_TAG}"

                        echo "AWS Account ID : ${env.AWS_ACCOUNT_ID}"
                        echo "ECR Registry   : ${env.ECR_REGISTRY}"
                        echo "ECR Image URI  : ${env.ECR_IMAGE}"
                    }
                }
            }
        }


        stage('24 - Login Docker to ECR') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh(
                        script: '''#!/usr/bin/env bash
set -euo pipefail

aws ecr get-login-password \
    --region "${AWS_DEFAULT_REGION}" |
docker login \
    --username AWS \
    --password-stdin \
    "${ECR_REGISTRY}"
''',
                        label: 'Login Docker to ECR'
                    )
                }
            }
        }


        stage('25 - Tag Image with ECR URI') {

            steps {

                sh(
                    script: '''#!/usr/bin/env bash
set -euo pipefail

docker tag \
    "${DOCKER_IMAGE}" \
    "${ECR_IMAGE}"

docker image inspect \
    "${ECR_IMAGE}" > /dev/null
''',
                    label: 'Tag Docker image'
                )
            }
        }


        stage('26 - Push Image to ECR') {

            steps {

                sh(
                    script: '''#!/usr/bin/env bash
set -euo pipefail

docker push "${ECR_IMAGE}"
''',
                    label: 'Push image to ECR'
                )
            }
        }


        stage('27 - Verify ECR Image') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh(
                        script: '''#!/usr/bin/env bash
set -euo pipefail

aws ecr describe-images \
    --repository-name "${ECR_REPOSITORY}" \
    --image-ids imageTag="${ECR_IMAGE_TAG}" \
    --region "${AWS_DEFAULT_REGION}"
''',
                        label: 'Verify ECR image'
                    )
                }
            }
        }


        stage('28 - Part 4 Success') {

            steps {

                echo '================================================'
                echo 'PART 4 - ECR SUCCESS'
                echo '================================================'

                echo "ECR Image URI: ${env.ECR_IMAGE}"
            }
        }


        // ============================================================
        // PART 5 - TERRAFORM CHECKOUT
        // ============================================================

        stage('29 - Checkout Terraform Repository') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    deleteDir()

                    git(
                        branch: "${TERRAFORM_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${TERRAFORM_REPO}"
                    )
                }
            }
        }


        stage('30 - Verify Terraform') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    sh(
                        script: '''#!/usr/bin/env bash
set -euo pipefail

command -v terraform

terraform version

find . \
    -maxdepth 3 \
    -type f \
    -name "*.tf" \
    -print
''',
                        label: 'Verify Terraform'
                    )
                }
            }
        }


        stage('31 - Terraform Environment Verification') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    sh(
                        script: '''#!/usr/bin/env bash
set -euo pipefail

if [ ! -d "environments/${ENVIRONMENT}" ]; then

    echo "ERROR: Terraform environment does not exist:"
    echo "environments/${ENVIRONMENT}"

    exit 1

fi

if [ ! -f "environments/${ENVIRONMENT}/terraform.tfvars" ]; then

    echo "ERROR: terraform.tfvars not found."

    exit 1

fi

echo "Terraform environment verified."
''',
                        label: 'Verify Terraform environment'
                    )
                }
            }
        }


        // ============================================================
        // 32 - ENSURE TERRAFORM BACKEND
        // ============================================================

        stage('32 - Ensure Terraform Backend Exists') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh(
                        script: '''#!/usr/bin/env bash
set -euo pipefail

echo "================================================"
echo "ENSURING TERRAFORM BACKEND"
echo "================================================"

echo "S3 Bucket      : ${TF_STATE_BUCKET}"
echo "DynamoDB Table : ${TF_LOCK_TABLE}"
echo "State Key      : ${TF_STATE_KEY}"

aws sts get-caller-identity \
    --region "${AWS_DEFAULT_REGION}"

echo ""
echo "Checking S3 bucket."

if aws s3api head-bucket \
    --bucket "${TF_STATE_BUCKET}" \
    --region "${AWS_DEFAULT_REGION}" \
    > /dev/null 2>&1
then

    echo "S3 backend bucket already exists."
    echo "REUSING existing S3 bucket."

else

    echo "S3 backend bucket does not exist."
    echo "Creating bucket."

    if [ "${AWS_DEFAULT_REGION}" = "us-east-1" ]; then

        aws s3api create-bucket \
            --bucket "${TF_STATE_BUCKET}" \
            --region "${AWS_DEFAULT_REGION}"

    else

        aws s3api create-bucket \
            --bucket "${TF_STATE_BUCKET}" \
            --region "${AWS_DEFAULT_REGION}" \
            --create-bucket-configuration \
            "LocationConstraint=${AWS_DEFAULT_REGION}"

    fi

fi

echo ""
echo "Enabling S3 versioning."

aws s3api put-bucket-versioning \
    --bucket "${TF_STATE_BUCKET}" \
    --region "${AWS_DEFAULT_REGION}" \
    --versioning-configuration Status=Enabled

echo ""
echo "Enabling S3 encryption."

aws s3api put-bucket-encryption \
    --bucket "${TF_STATE_BUCKET}" \
    --region "${AWS_DEFAULT_REGION}" \
    --server-side-encryption-configuration \
    '{"Rules":[{"ApplyServerSideEncryptionByDefault":{"SSEAlgorithm":"AES256"}}]}'

echo ""
echo "Blocking public access."

aws s3api put-public-access-block \
    --bucket "${TF_STATE_BUCKET}" \
    --region "${AWS_DEFAULT_REGION}" \
    --public-access-block-configuration \
    BlockPublicAcls=true,IgnorePublicAcls=true,BlockPublicPolicy=true,RestrictPublicBuckets=true

echo ""
echo "Checking DynamoDB table."

if aws dynamodb describe-table \
    --table-name "${TF_LOCK_TABLE}" \
    --region "${AWS_DEFAULT_REGION}" \
    > /dev/null 2>&1
then

    echo "DynamoDB lock table already exists."
    echo "REUSING existing DynamoDB table."

else

    echo "DynamoDB lock table does not exist."
    echo "Creating DynamoDB table."

    aws dynamodb create-table \
        --table-name "${TF_LOCK_TABLE}" \
        --attribute-definitions \
            AttributeName=LockID,AttributeType=S \
        --key-schema \
            AttributeName=LockID,KeyType=HASH \
        --billing-mode PAY_PER_REQUEST \
        --region "${AWS_DEFAULT_REGION}"

fi

echo ""
echo "Waiting for DynamoDB table."

aws dynamodb wait table-exists \
    --table-name "${TF_LOCK_TABLE}" \
    --region "${AWS_DEFAULT_REGION}"

TABLE_STATUS=$(aws dynamodb describe-table \
    --table-name "${TF_LOCK_TABLE}" \
    --region "${AWS_DEFAULT_REGION}" \
    --query 'Table.TableStatus' \
    --output text)

if [ "${TABLE_STATUS}" != "ACTIVE" ]; then

    echo "ERROR: DynamoDB table is not ACTIVE."

    exit 1

fi

echo "DynamoDB status: ${TABLE_STATUS}"

echo ""
echo "================================================"
echo "TERRAFORM BACKEND READY"
echo "================================================"
''',
                        label: 'Ensure Terraform S3 bucket and DynamoDB lock table'
                    )
                }
            }
        }


        // ============================================================
        // 33 - CORRECTED CHECKSUM REPAIR
        // ============================================================

        stage('33 - Repair Terraform Backend State Checksum') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh(
                            script: '''#!/usr/bin/env bash
set -euo pipefail

echo "================================================"
echo "TERRAFORM BACKEND STATE CHECKSUM CHECK"
echo "================================================"

echo "S3 Bucket      : ${TF_STATE_BUCKET}"
echo "S3 State Key   : ${TF_STATE_KEY}"
echo "DynamoDB Table : ${TF_LOCK_TABLE}"

LOCK_ID="${TF_STATE_BUCKET}/${TF_STATE_KEY}"

echo ""
echo "DynamoDB LockID:"
echo "${LOCK_ID}"

DDB_KEY_JSON=$(printf '{"LockID":{"S":"%s"}}' "${LOCK_ID}")

echo ""
echo "================================================"
echo "CHECKING TERRAFORM STATE"
echo "================================================"

if aws s3api head-object \
    --bucket "${TF_STATE_BUCKET}" \
    --key "${TF_STATE_KEY}" \
    --region "${AWS_DEFAULT_REGION}" \
    > /dev/null 2>&1
then

    echo "Terraform state exists in S3."

else

    echo "No Terraform state exists in S3."
    echo "This is the first deployment."
    echo "No checksum repair is required."

    exit 0

fi

echo ""
echo "================================================"
echo "CHECKING FOR ACTIVE TERRAFORM LOCK"
echo "================================================"

LOCK_INFO=$(aws dynamodb get-item \
    --table-name "${TF_LOCK_TABLE}" \
    --key "${DDB_KEY_JSON}" \
    --consistent-read \
    --region "${AWS_DEFAULT_REGION}" \
    --query 'Item.Info.S' \
    --output text 2>/dev/null || true)

if [ -z "${LOCK_INFO}" ] ||
   [ "${LOCK_INFO}" = "None" ] ||
   [ "${LOCK_INFO}" = "null" ]; then

    echo "No active Terraform lock detected."

else

    echo "================================================"
    echo "ACTIVE TERRAFORM LOCK DETECTED"
    echo "================================================"

    echo "Terraform lock information exists in DynamoDB."
    echo ""
    echo "The pipeline will NOT modify the DynamoDB item."
    echo "This protects an active Terraform operation."
    echo ""
    echo "Lock information:"
    echo "${LOCK_INFO}"

    exit 1

fi

echo ""
echo "================================================"
echo "DOWNLOADING TERRAFORM STATE"
echo "================================================"

TEMP_STATE=$(mktemp)

cleanup_state() {
    rm -f "${TEMP_STATE}"
}

trap cleanup_state EXIT

aws s3 cp \
    "s3://${TF_STATE_BUCKET}/${TF_STATE_KEY}" \
    "${TEMP_STATE}" \
    --region "${AWS_DEFAULT_REGION}"

if [ ! -s "${TEMP_STATE}" ]; then

    echo "ERROR: Downloaded Terraform state is empty."

    exit 1

fi

echo "Terraform state downloaded successfully."

echo ""
echo "================================================"
echo "CALCULATING ACTUAL STATE MD5"
echo "================================================"

ACTUAL_MD5=$(md5sum "${TEMP_STATE}" | awk '{print $1}')

if [ -z "${ACTUAL_MD5}" ]; then

    echo "ERROR: Could not calculate Terraform state MD5."

    exit 1

fi

echo "Actual S3 state MD5:"
echo "${ACTUAL_MD5}"

echo ""
echo "================================================"
echo "READING DYNAMODB CHECKSUM"
echo "================================================"

STORED_MD5=$(aws dynamodb get-item \
    --table-name "${TF_LOCK_TABLE}" \
    --key "${DDB_KEY_JSON}" \
    --consistent-read \
    --region "${AWS_DEFAULT_REGION}" \
    --query 'Item.Digest.S' \
    --output text 2>/dev/null || true)

if [ -z "${STORED_MD5}" ] ||
   [ "${STORED_MD5}" = "None" ] ||
   [ "${STORED_MD5}" = "null" ]; then

    STORED_MD5="NONE"

fi

echo "Stored DynamoDB MD5:"
echo "${STORED_MD5}"

echo ""
echo "================================================"
echo "COMPARING CHECKSUMS"
echo "================================================"

if [ "${STORED_MD5}" = "${ACTUAL_MD5}" ]; then

    echo "Checksum is already correct."
    echo "No DynamoDB modification is required."

else

    if [ "${STORED_MD5}" = "NONE" ]; then

        echo "DynamoDB checksum is missing."

    else

        echo "Checksum mismatch detected."
        echo "S3 contains the authoritative Terraform state."

    fi

    echo ""
    echo "Updating ONLY the DynamoDB Digest attribute."
    echo "Existing LockID and other attributes will be preserved."

    DIGEST_VALUE_JSON=$(printf '{"S":"%s"}' "${ACTUAL_MD5}")

    aws dynamodb update-item \
        --table-name "${TF_LOCK_TABLE}" \
        --key "${DDB_KEY_JSON}" \
        --update-expression 'SET Digest = :digest' \
        --expression-attribute-values \
            ":digest=${DIGEST_VALUE_JSON}" \
        --region "${AWS_DEFAULT_REGION}"

    echo "DynamoDB checksum updated successfully."

fi

echo ""
echo "================================================"
echo "FINAL CHECKSUM VERIFICATION"
echo "================================================"

FINAL_MD5=$(aws dynamodb get-item \
    --table-name "${TF_LOCK_TABLE}" \
    --key "${DDB_KEY_JSON}" \
    --consistent-read \
    --region "${AWS_DEFAULT_REGION}" \
    --query 'Item.Digest.S' \
    --output text 2>/dev/null || true)

if [ -z "${FINAL_MD5}" ] ||
   [ "${FINAL_MD5}" = "None" ] ||
   [ "${FINAL_MD5}" = "null" ]; then

    echo "ERROR: DynamoDB Digest is missing after repair."

    exit 1

fi

echo "S3 MD5       : ${ACTUAL_MD5}"
echo "DynamoDB MD5 : ${FINAL_MD5}"

if [ "${FINAL_MD5}" != "${ACTUAL_MD5}" ]; then

    echo "ERROR: DynamoDB checksum verification failed."

    exit 1

fi

echo ""
echo "================================================"
echo "CHECKSUM VERIFIED SUCCESSFULLY"
echo "================================================"

echo "S3 state has NOT been deleted."
echo "DynamoDB table has NOT been deleted."
echo "Existing Terraform state is preserved."
echo "DynamoDB Digest now matches the S3 state."

''',
                            label: 'Repair Terraform S3/DynamoDB state checksum'
                        )
                    }
                }
            }
        }


        // ============================================================
        // 34 - TERRAFORM INIT
        // ============================================================

        stage('34 - Terraform Init') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh(
                            script: '''#!/usr/bin/env bash
set -euo pipefail

echo "================================================"
echo "TERRAFORM INIT"
echo "================================================"

aws sts get-caller-identity \
    --region "${AWS_DEFAULT_REGION}"

terraform version

echo ""
echo "Initializing Terraform backend."

terraform init \
    -input=false \
    -reconfigure \
    -backend-config="bucket=${TF_STATE_BUCKET}" \
    -backend-config="key=${TF_STATE_KEY}" \
    -backend-config="region=${AWS_DEFAULT_REGION}" \
    -backend-config="dynamodb_table=${TF_LOCK_TABLE}" \
    -backend-config="encrypt=true"

echo ""
echo "================================================"
echo "TERRAFORM INIT SUCCESSFUL"
echo "================================================"
''',
                            label: 'Terraform init'
                        )
                    }
                }
            }
        }


        // ============================================================
        // 35 - ADOPT EXISTING RESOURCES
        // ============================================================

        stage('35 - Adopt Existing Terraform Resources') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh(
                            script: '''#!/usr/bin/env bash
set -euo pipefail

echo "================================================"
echo "ADOPTING EXISTING AWS RESOURCES"
echo "================================================"

echo ""
echo "Current Terraform state:"

terraform state list || true

resource_in_state() {

    local ADDRESS="$1"

    terraform state list 2>/dev/null |
        grep -Fxq "${ADDRESS}"
}

safe_import() {

    local ADDRESS="$1"
    local ID="$2"

    if resource_in_state "${ADDRESS}"; then

        echo "Already managed:"
        echo "${ADDRESS}"

        return 0

    fi

    echo "Terraform does not currently manage:"
    echo "${ADDRESS}"

    if terraform import \
        -input=false \
        "${ADDRESS}" \
        "${ID}"
    then

        echo "Successfully imported:"
        echo "${ADDRESS}"

    else

        echo "WARNING: Import failed for ${ADDRESS}."
        echo "Terraform may create or reconcile the resource during apply."

    fi
}

CLUSTER_ADDRESS="module.ecs.aws_ecs_cluster.this"

if aws ecs describe-clusters \
    --clusters "${ECS_CLUSTER}" \
    --region "${AWS_DEFAULT_REGION}" \
    --query 'clusters[0].status' \
    --output text 2>/dev/null |
    grep -Fxq "ACTIVE"
then

    echo "ECS cluster already exists."
    echo "Reusing/importing existing cluster."

    safe_import \
        "${CLUSTER_ADDRESS}" \
        "${ECS_CLUSTER}"

else

    echo "ECS cluster does not exist."
    echo "Terraform will create it."

fi

ECR_ADDRESS="module.ecr.aws_ecr_repository.this"

if aws ecr describe-repositories \
    --repository-names "${ECR_REPOSITORY}" \
    --region "${AWS_DEFAULT_REGION}" \
    > /dev/null 2>&1
then

    echo "ECR repository already exists."
    echo "Reusing/importing existing repository."

    safe_import \
        "${ECR_ADDRESS}" \
        "${ECR_REPOSITORY}"

else

    echo "ECR repository does not exist."
    echo "Terraform will create it."

fi

S3_ADDRESS="module.s3.aws_s3_bucket.this"

APP_BUCKET="practice1-${ENVIRONMENT}-001"

if aws s3api head-bucket \
    --bucket "${APP_BUCKET}" \
    --region "${AWS_DEFAULT_REGION}" \
    > /dev/null 2>&1
then

    echo "Application S3 bucket already exists."
    echo "Reusing/importing existing bucket."

    safe_import \
        "${S3_ADDRESS}" \
        "${APP_BUCKET}"

else

    echo "Application S3 bucket does not exist."
    echo "Terraform will create it."

fi

echo ""
echo "================================================"
echo "FINAL TERRAFORM STATE"
echo "================================================"

terraform state list || true

echo ""
echo "Existing resources have been reused where possible."
echo "Missing resources will be created by Terraform."

''',
                            label: 'Adopt existing AWS resources'
                        )
                    }
                }
            }
        }


        // ============================================================
        // 36 - VALIDATE
        // ============================================================

        stage('36 - Terraform Validate') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    sh(
                        script: '''#!/usr/bin/env bash
set -euo pipefail

terraform validate
''',
                        label: 'Terraform validate'
                    )
                }
            }
        }


        // ============================================================
        // 37 - PLAN
        // ============================================================

        stage('37 - Terraform Plan') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh(
                            script: '''#!/usr/bin/env bash
set -euo pipefail

echo "================================================"
echo "TERRAFORM PLAN"
echo "================================================"

terraform plan \
    -input=false \
    -var-file="environments/${ENVIRONMENT}/terraform.tfvars" \
    -out="tfplan"
''',
                            label: 'Terraform plan'
                        )
                    }
                }
            }
        }


        // ============================================================
        // 38 - APPLY
        // ============================================================

        stage('38 - Terraform Apply') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh(
                            script: '''#!/usr/bin/env bash
set -euo pipefail

if [ ! -f tfplan ]; then

    echo "ERROR: tfplan not found."

    exit 1

fi

terraform apply \
    -input=false \
    -auto-approve \
    tfplan
''',
                            label: 'Terraform apply'
                        )
                    }
                }
            }
        }


        // ============================================================
        // 39 - TERRAFORM VERIFICATION
        // ============================================================

        stage('39 - Terraform Deployment Verification') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh(
                            script: '''#!/usr/bin/env bash
set -euo pipefail

echo "Terraform state:"
terraform state list || true

echo ""
echo "Terraform outputs:"
terraform output || true

echo ""
echo "AWS identity:"

aws sts get-caller-identity \
    --region "${AWS_DEFAULT_REGION}"

echo ""
echo "Terraform deployment verification completed."
''',
                            label: 'Verify Terraform deployment'
                        )
                    }
                }
            }
        }


        // ============================================================
        // PART 6 - ECS / ALB
        // ============================================================

        stage('40 - Discover AWS Network') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        def vpcId = sh(
                            script: '''#!/usr/bin/env bash
set -euo pipefail

VPC_ID=$(aws ec2 describe-vpcs \
    --region "${AWS_DEFAULT_REGION}" \
    --filters \
        "Name=tag:Environment,Values=${ENVIRONMENT}" \
    --query 'Vpcs[0].VpcId' \
    --output text)

if [ "${VPC_ID}" = "None" ] ||
   [ -z "${VPC_ID}" ]; then

    VPC_ID=$(aws ec2 describe-vpcs \
        --region "${AWS_DEFAULT_REGION}" \
        --filters \
            "Name=is-default,Values=true" \
        --query 'Vpcs[0].VpcId' \
        --output text)

fi

if [ "${VPC_ID}" = "None" ] ||
   [ -z "${VPC_ID}" ]; then

    echo "ERROR: No VPC found."

    exit 1

fi

echo "${VPC_ID}"
''',
                            returnStdout: true
                        ).trim()

                        env.VPC_ID = vpcId

                        def subnetOutput = sh(
                            script: '''#!/usr/bin/env bash
set -euo pipefail

aws ec2 describe-subnets \
    --region "${AWS_DEFAULT_REGION}" \
    --filters \
        "Name=vpc-id,Values=${VPC_ID}" \
        "Name=map-public-ip-on-launch,Values=true" \
    --query 'Subnets[].SubnetId' \
    --output text
''',
                            returnStdout: true
                        ).trim()

                        if (!subnetOutput ||
                            subnetOutput == 'None') {

                            error('No public subnets found.')
                        }

                        def subnetList = subnetOutput.split("\\s+")

                        if (subnetList.size() < 2) {

                            error(
                                "At least 2 public subnets are required. " +
                                "Found: ${subnetOutput}"
                            )
                        }

                        env.SUBNET_1 = subnetList[0]
                        env.SUBNET_2 = subnetList[1]

                        echo "VPC ID  : ${env.VPC_ID}"
                        echo "Subnet 1: ${env.SUBNET_1}"
                        echo "Subnet 2: ${env.SUBNET_2}"
                    }
                }
            }
        }


        // ============================================================
        // 41 - IAM
        // ============================================================

        stage('41 - Create Or Reuse IAM Role') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh(
                        script: '''#!/usr/bin/env bash
set -euo pipefail

ROLE_NAME="practice1-ecsTaskExecutionRole"

cat > /tmp/ecs-trust-policy.json <<'EOF'
{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
            },
            "Action": "sts:AssumeRole"
        }
    ]
}
EOF

if aws iam get-role \
    --role-name "${ROLE_NAME}" \
    > /dev/null 2>&1
then

    echo "IAM role already exists."
    echo "REUSING existing IAM role."

else

    echo "IAM role does not exist."
    echo "Creating IAM role."

    aws iam create-role \
        --role-name "${ROLE_NAME}" \
        --assume-role-policy-document \
        file:///tmp/ecs-trust-policy.json

fi

aws iam attach-role-policy \
    --role-name "${ROLE_NAME}" \
    --policy-arn \
    arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy \
    || true

EXECUTION_ROLE_ARN=$(aws iam get-role \
    --role-name "${ROLE_NAME}" \
    --query 'Role.Arn' \
    --output text)

if [ -z "${EXECUTION_ROLE_ARN}" ] ||
   [ "${EXECUTION_ROLE_ARN}" = "None" ]; then

    echo "ERROR: IAM role ARN not available."

    exit 1

fi

echo "Execution Role:"
echo "${EXECUTION_ROLE_ARN}"
''',
                        label: 'Create or reuse ECS IAM role'
                    )
                }
            }
        }


        // ============================================================
        // 42 - SECURITY GROUPS
        // ============================================================

        stage('42 - Create Or Reuse Security Groups') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        def ids = sh(
                            script: '''#!/usr/bin/env bash
set -euo pipefail

ALB_SG_ID=$(aws ec2 describe-security-groups \
    --region "${AWS_DEFAULT_REGION}" \
    --filters \
        "Name=vpc-id,Values=${VPC_ID}" \
        "Name=group-name,Values=${ALB_SG_NAME}" \
    --query 'SecurityGroups[0].GroupId' \
    --output text)

if [ "${ALB_SG_ID}" = "None" ] ||
   [ -z "${ALB_SG_ID}" ]; then

    ALB_SG_ID=$(aws ec2 create-security-group \
        --region "${AWS_DEFAULT_REGION}" \
        --group-name "${ALB_SG_NAME}" \
        --description "ALB security group" \
        --vpc-id "${VPC_ID}" \
        --query 'GroupId' \
        --output text)

fi

ECS_SG_ID=$(aws ec2 describe-security-groups \
    --region "${AWS_DEFAULT_REGION}" \
    --filters \
        "Name=vpc-id,Values=${VPC_ID}" \
        "Name=group-name,Values=${ECS_SG_NAME}" \
    --query 'SecurityGroups[0].GroupId' \
    --output text)

if [ "${ECS_SG_ID}" = "None" ] ||
   [ -z "${ECS_SG_ID}" ]; then

    ECS_SG_ID=$(aws ec2 create-security-group \
        --region "${AWS_DEFAULT_REGION}" \
        --group-name "${ECS_SG_NAME}" \
        --description "ECS Fargate security group" \
        --vpc-id "${VPC_ID}" \
        --query 'GroupId' \
        --output text)

fi

aws ec2 authorize-security-group-ingress \
    --region "${AWS_DEFAULT_REGION}" \
    --group-id "${ALB_SG_ID}" \
    --protocol tcp \
    --port 80 \
    --cidr 0.0.0.0/0 \
    2>/dev/null || true

aws ec2 authorize-security-group-ingress \
    --region "${AWS_DEFAULT_REGION}" \
    --group-id "${ECS_SG_ID}" \
    --protocol tcp \
    --port "${CONTAINER_PORT}" \
    --source-group "${ALB_SG_ID}" \
    2>/dev/null || true

printf '%s|%s' \
    "${ALB_SG_ID}" \
    "${ECS_SG_ID}"
''',
                            returnStdout: true
                        ).trim()

                        def parts = ids.split("\\|")

                        if (parts.size() != 2) {

                            error(
                                "Unable to obtain security group IDs."
                            )
                        }

                        env.ALB_SG_ID = parts[0]
                        env.ECS_SG_ID = parts[1]

                        echo "ALB SG: ${env.ALB_SG_ID}"
                        echo "ECS SG: ${env.ECS_SG_ID}"
                    }
                }
            }
        }


        // ============================================================
        // 43 - ALB
        // ============================================================

        stage('43 - Create Or Reuse Application Load Balancer') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        def albArn = sh(
                            script: '''#!/usr/bin/env bash
set -euo pipefail

aws elbv2 describe-load-balancers \
    --region "${AWS_DEFAULT_REGION}" \
    --names "${ALB_NAME}" \
    --query 'LoadBalancers[0].LoadBalancerArn' \
    --output text \
    2>/dev/null || true
''',
                            returnStdout: true
                        ).trim()

                        if (!albArn ||
                            albArn == 'None') {

                            albArn = sh(
                                script: '''#!/usr/bin/env bash
set -euo pipefail

aws elbv2 create-load-balancer \
    --region "${AWS_DEFAULT_REGION}" \
    --name "${ALB_NAME}" \
    --subnets \
        "${SUBNET_1}" \
        "${SUBNET_2}" \
    --security-groups "${ALB_SG_ID}" \
    --scheme internet-facing \
    --type application \
    --ip-address-type ipv4 \
    --query 'LoadBalancers[0].LoadBalancerArn' \
    --output text
''',
                                returnStdout: true
                            ).trim()

                        } else {

                            echo "ALB already exists."
                            echo "REUSING existing ALB."

                        }

                        env.ALB_ARN = albArn

                        sh(
                            script: '''#!/usr/bin/env bash
set -euo pipefail

aws elbv2 wait load-balancer-available \
    --region "${AWS_DEFAULT_REGION}" \
    --load-balancer-arns "${ALB_ARN}"
''',
                            label: 'Wait for ALB'
                        )

                        env.ALB_DNS = sh(
                            script: '''#!/usr/bin/env bash
set -euo pipefail

aws elbv2 describe-load-balancers \
    --region "${AWS_DEFAULT_REGION}" \
    --load-balancer-arns "${ALB_ARN}" \
    --query 'LoadBalancers[0].DNSName' \
    --output text
''',
                            returnStdout: true
                        ).trim()

                        echo "ALB ARN: ${env.ALB_ARN}"
                        echo "ALB DNS: ${env.ALB_DNS}"
                    }
                }
            }
        }


        // ============================================================
        // 44 - TARGET GROUP
        // ============================================================

        stage('44 - Create Or Reuse Target Group') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        def targetGroupArn = sh(
                            script: '''#!/usr/bin/env bash
set -euo pipefail

aws elbv2 describe-target-groups \
    --region "${AWS_DEFAULT_REGION}" \
    --names "${TARGET_GROUP_NAME}" \
    --query 'TargetGroups[0].TargetGroupArn' \
    --output text \
    2>/dev/null || true
''',
                            returnStdout: true
                        ).trim()

                        if (!targetGroupArn ||
                            targetGroupArn == 'None') {

                            targetGroupArn = sh(
                                script: '''#!/usr/bin/env bash
set -euo pipefail

aws elbv2 create-target-group \
    --region "${AWS_DEFAULT_REGION}" \
    --name "${TARGET_GROUP_NAME}" \
    --protocol HTTP \
    --port "${CONTAINER_PORT}" \
    --target-type ip \
    --vpc-id "${VPC_ID}" \
    --health-check-protocol HTTP \
    --health-check-path "/" \
    --health-check-port traffic-port \
    --matcher HttpCode=200-399 \
    --query 'TargetGroups[0].TargetGroupArn' \
    --output text
''',
                                returnStdout: true
                            ).trim()

                        } else {

                            echo "Target group already exists."
                            echo "REUSING existing target group."

                        }

                        env.TARGET_GROUP_ARN = targetGroupArn

                        echo "Target Group:"
                        echo "${env.TARGET_GROUP_ARN}"
                    }
                }
            }
        }


        // ============================================================
        // 45 - LISTENER
        // ============================================================

        stage('45 - Create Or Reuse ALB Listener') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh(
                        script: '''#!/usr/bin/env bash
set -euo pipefail

LISTENER_ARN=$(aws elbv2 describe-listeners \
    --region "${AWS_DEFAULT_REGION}" \
    --load-balancer-arn "${ALB_ARN}" \
    --query 'Listeners[?Port==`80`].ListenerArn | [0]' \
    --output text)

if [ "${LISTENER_ARN}" = "None" ] ||
   [ -z "${LISTENER_ARN}" ]; then

    echo "Creating HTTP listener."

    aws elbv2 create-listener \
        --region "${AWS_DEFAULT_REGION}" \
        --load-balancer-arn "${ALB_ARN}" \
        --protocol HTTP \
        --port 80 \
        --default-actions \
            "Type=forward,TargetGroupArn=${TARGET_GROUP_ARN}"

else

    echo "HTTP listener already exists."
    echo "REUSING existing listener."

    aws elbv2 modify-listener \
        --region "${AWS_DEFAULT_REGION}" \
        --listener-arn "${LISTENER_ARN}" \
        --default-actions \
            "Type=forward,TargetGroupArn=${TARGET_GROUP_ARN}"

fi
''',
                        label: 'Create or reuse ALB listener'
                    )
                }
            }
        }


        // ============================================================
        // 46 - ECS CLUSTER
        // ============================================================

        stage('46 - Create Or Reuse ECS Cluster') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh(
                        script: '''#!/usr/bin/env bash
set -euo pipefail

STATUS=$(aws ecs describe-clusters \
    --region "${AWS_DEFAULT_REGION}" \
    --clusters "${ECS_CLUSTER}" \
    --query 'clusters[0].status' \
    --output text \
    2>/dev/null || true)

if [ "${STATUS}" = "ACTIVE" ]; then

    echo "ECS cluster already exists."
    echo "REUSING existing cluster."

else

    echo "Creating ECS cluster."

    aws ecs create-cluster \
        --region "${AWS_DEFAULT_REGION}" \
        --cluster-name "${ECS_CLUSTER}"

fi

STATUS=$(aws ecs describe-clusters \
    --region "${AWS_DEFAULT_REGION}" \
    --clusters "${ECS_CLUSTER}" \
    --query 'clusters[0].status' \
    --output text)

if [ "${STATUS}" != "ACTIVE" ]; then

    echo "ERROR: ECS cluster is not ACTIVE."

    exit 1

fi

echo "ECS cluster is ACTIVE."
''',
                        label: 'Create or reuse ECS cluster'
                    )
                }
            }
        }


        // ============================================================
        // 47 - TASK DEFINITION
        // ============================================================

        stage('47 - Register ECS Fargate Task Definition') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        def taskArn = sh(
                            script: '''#!/usr/bin/env bash
set -euo pipefail

EXECUTION_ROLE_ARN=$(aws iam get-role \
    --role-name "practice1-ecsTaskExecutionRole" \
    --query 'Role.Arn' \
    --output text)

if [ -z "${EXECUTION_ROLE_ARN}" ] ||
   [ "${EXECUTION_ROLE_ARN}" = "None" ]; then

    echo "ERROR: ECS execution role was not found."

    exit 1

fi

cat > task-definition.json <<EOF
{
    "family": "${ECS_TASK_FAMILY}",
    "networkMode": "awsvpc",
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "${FARGATE_CPU}",
    "memory": "${FARGATE_MEMORY}",
    "executionRoleArn": "${EXECUTION_ROLE_ARN}",
    "containerDefinitions": [
        {
            "name": "${ECS_CONTAINER_NAME}",
            "image": "${ECR_IMAGE}",
            "essential": true,
            "portMappings": [
                {
                    "containerPort": ${CONTAINER_PORT},
                    "hostPort": ${CONTAINER_PORT},
                    "protocol": "tcp"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/${ECS_TASK_FAMILY}",
                    "awslogs-region": "${AWS_DEFAULT_REGION}",
                    "awslogs-stream-prefix": "ecs"
                }
            }
        }
    ]
}
EOF

if aws logs describe-log-groups \
    --log-group-name-prefix "/ecs/${ECS_TASK_FAMILY}" \
    --region "${AWS_DEFAULT_REGION}" \
    --query "logGroups[?logGroupName=='/ecs/${ECS_TASK_FAMILY}'].logGroupName | [0]" \
    --output text |
    grep -Fxq "/ecs/${ECS_TASK_FAMILY}"
then

    echo "CloudWatch log group already exists."
    echo "REUSING existing log group."

else

    echo "Creating CloudWatch log group."

    aws logs create-log-group \
        --log-group-name "/ecs/${ECS_TASK_FAMILY}" \
        --region "${AWS_DEFAULT_REGION}"

fi

aws ecs register-task-definition \
    --region "${AWS_DEFAULT_REGION}" \
    --cli-input-json file://task-definition.json \
    --query 'taskDefinition.taskDefinitionArn' \
    --output text
''',
                            returnStdout: true
                        ).trim()

                        if (!taskArn ||
                            taskArn == 'None') {

                            error(
                                'Could not register ECS task definition.'
                            )
                        }

                        env.TASK_DEFINITION_ARN = taskArn

                        echo "Task Definition:"
                        echo "${env.TASK_DEFINITION_ARN}"
                    }
                }
            }
        }


        // ============================================================
        // 48 - ECS SERVICE
        // ============================================================

        stage('48 - Create Or Update ECS Fargate Service') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh(
                        script: '''#!/usr/bin/env bash
set -euo pipefail

SERVICE_STATUS=$(aws ecs describe-services \
    --region "${AWS_DEFAULT_REGION}" \
    --cluster "${ECS_CLUSTER}" \
    --services "${ECS_SERVICE}" \
    --query 'services[0].status' \
    --output text \
    2>/dev/null || true)

if [ "${SERVICE_STATUS}" = "ACTIVE" ]; then

    echo "ECS service already exists."
    echo "UPDATING existing ECS service."

    aws ecs update-service \
        --region "${AWS_DEFAULT_REGION}" \
        --cluster "${ECS_CLUSTER}" \
        --service "${ECS_SERVICE}" \
        --task-definition "${TASK_DEFINITION_ARN}" \
        --desired-count 1 \
        --force-new-deployment

else

    echo "ECS service does not exist."
    echo "Creating ECS service."

    aws ecs create-service \
        --region "${AWS_DEFAULT_REGION}" \
        --cluster "${ECS_CLUSTER}" \
        --service-name "${ECS_SERVICE}" \
        --task-definition "${TASK_DEFINITION_ARN}" \
        --desired-count 1 \
        --launch-type FARGATE \
        --platform-version LATEST \
        --network-configuration \
            "awsvpcConfiguration={subnets=[${SUBNET_1},${SUBNET_2}],securityGroups=[${ECS_SG_ID}],assignPublicIp=ENABLED}" \
        --load-balancers \
            "targetGroupArn=${TARGET_GROUP_ARN},containerName=${ECS_CONTAINER_NAME},containerPort=${CONTAINER_PORT}"

fi

echo "Waiting for ECS service."

aws ecs wait services-stable \
    --region "${AWS_DEFAULT_REGION}" \
    --cluster "${ECS_CLUSTER}" \
    --services "${ECS_SERVICE}"

echo "ECS service is stable."
''',
                        label: 'Create or update ECS service'
                    )
                }
            }
        }


        // ============================================================
        // 49 - RUNNING TASK
        // ============================================================

        stage('49 - Verify ECS Running Task') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh(
                        script: '''#!/usr/bin/env bash
set -euo pipefail

RUNNING_COUNT=$(aws ecs describe-services \
    --region "${AWS_DEFAULT_REGION}" \
    --cluster "${ECS_CLUSTER}" \
    --services "${ECS_SERVICE}" \
    --query 'services[0].runningCount' \
    --output text)

DESIRED_COUNT=$(aws ecs describe-services \
    --region "${AWS_DEFAULT_REGION}" \
    --cluster "${ECS_CLUSTER}" \
    --services "${ECS_SERVICE}" \
    --query 'services[0].desiredCount' \
    --output text)

echo "Desired tasks : ${DESIRED_COUNT}"
echo "Running tasks : ${RUNNING_COUNT}"

if [ "${RUNNING_COUNT}" -lt 1 ]; then

    echo "ERROR: No running ECS task."

    aws ecs describe-services \
        --region "${AWS_DEFAULT_REGION}" \
        --cluster "${ECS_CLUSTER}" \
        --services "${ECS_SERVICE}" \
        --query 'services[0].events[0:10]' \
        --output table || true

    exit 1

fi

TASK_ARN=$(aws ecs list-tasks \
    --region "${AWS_DEFAULT_REGION}" \
    --cluster "${ECS_CLUSTER}" \
    --service-name "${ECS_SERVICE}" \
    --desired-status RUNNING \
    --query 'taskArns[0]' \
    --output text)

if [ -z "${TASK_ARN}" ] ||
   [ "${TASK_ARN}" = "None" ]; then

    echo "ERROR: Running task not found."

    exit 1

fi

echo "Running Task:"
echo "${TASK_ARN}"

aws ecs describe-tasks \
    --region "${AWS_DEFAULT_REGION}" \
    --cluster "${ECS_CLUSTER}" \
    --tasks "${TASK_ARN}" \
    --query 'tasks[0].{TaskArn:taskArn,LastStatus:lastStatus}' \
    --output table
''',
                        label: 'Verify ECS running task'
                    )
                }
            }
        }


        // ============================================================
        // 50 - ALB HEALTH
        // ============================================================

        stage('50 - Verify ALB Target Health') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh(
                        script: '''#!/usr/bin/env bash
set -euo pipefail

echo "================================================"
echo "CHECKING ALB TARGET HEALTH"
echo "================================================"

HEALTHY=false

for i in $(seq 1 30); do

    echo ""
    echo "Health check attempt ${i}/30"

    HEALTH=$(aws elbv2 describe-target-health \
        --region "${AWS_DEFAULT_REGION}" \
        --target-group-arn "${TARGET_GROUP_ARN}" \
        --query 'TargetHealthDescriptions[?TargetHealth.State==`healthy`].Target.Id' \
        --output text)

    if [ -n "${HEALTH}" ] &&
       [ "${HEALTH}" != "None" ]; then

        echo "ALB target is HEALTHY."

        HEALTHY=true

        break

    fi

    echo "Target is not healthy yet."

    sleep 10

done

echo ""
echo "Detailed target health:"

aws elbv2 describe-target-health \
    --region "${AWS_DEFAULT_REGION}" \
    --target-group-arn "${TARGET_GROUP_ARN}" \
    --output table

if [ "${HEALTHY}" != "true" ]; then

    echo "ERROR: ALB target did not become healthy."

    exit 1

fi
''',
                        label: 'Verify ALB target health'
                    )
                }
            }
        }


        // ============================================================
        // 51 - FINAL
        // ============================================================

        stage('51 - Final Deployment Verification') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        def albDns = sh(
                            script: '''#!/usr/bin/env bash
set -euo pipefail

aws elbv2 describe-load-balancers \
    --region "${AWS_DEFAULT_REGION}" \
    --load-balancer-arns "${ALB_ARN}" \
    --query 'LoadBalancers[0].DNSName' \
    --output text
''',
                            returnStdout: true
                        ).trim()

                        if (!albDns ||
                            albDns == 'None') {

                            error('Could not retrieve ALB DNS.')
                        }

                        env.ALB_DNS = albDns

                        env.APPLICATION_URL =
                            "http://${albDns}"

                        echo ""
                        echo "================================================"
                        echo "FINAL DEPLOYMENT REPORT"
                        echo "================================================"

                        echo "Environment       : ${env.ENVIRONMENT}"
                        echo "AWS Region        : ${env.AWS_DEFAULT_REGION}"
                        echo "ECR Image         : ${env.ECR_IMAGE}"
                        echo "ECS Cluster       : ${env.ECS_CLUSTER}"
                        echo "ECS Service       : ${env.ECS_SERVICE}"
                        echo "Task Definition   : ${env.TASK_DEFINITION_ARN}"
                        echo "ALB               : ${env.ALB_NAME}"
                        echo "Target Group      : ${env.TARGET_GROUP_NAME}"
                        echo "ALB DNS           : ${env.ALB_DNS}"
                        echo "Application URL   : ${env.APPLICATION_URL}"
                        echo "Terraform Bucket  : ${env.TF_STATE_BUCKET}"
                        echo "Terraform State   : ${env.TF_STATE_KEY}"
                        echo "DynamoDB Lock     : ${env.TF_LOCK_TABLE}"

                        echo ""
                        echo "================================================"
                        echo "APPLICATION URL"
                        echo "================================================"

                        echo "${env.APPLICATION_URL}"

                        echo ""
                        echo "================================================"
                        echo "DEPLOYMENT COMPLETE"
                        echo "================================================"
                    }
                }
            }
        }
    }


    // ================================================================
    // POST ACTIONS
    // ================================================================

    post {

        success {

            echo ''
            echo '================================================'
            echo '       COMPLETE CI/CD PIPELINE SUCCESS'
            echo '================================================'
            echo ''

            echo 'PART 1 - CODE QUALITY : PASSED'
            echo 'PART 2 - TESTING      : PASSED'
            echo 'PART 3 - DOCKER       : PASSED'
            echo 'PART 4 - ECR          : PASSED'
            echo 'PART 5 - TERRAFORM    : PASSED'
            echo 'PART 6 - ECS FARGATE  : PASSED'
            echo 'PART 6 - ALB          : PASSED'

            echo ''
            echo '================================================'
            echo '          TERRAFORM BACKEND'
            echo '================================================'

            echo "S3 Bucket      : ${env.TF_STATE_BUCKET}"
            echo "State Key      : ${env.TF_STATE_KEY}"
            echo "DynamoDB Table : ${env.TF_LOCK_TABLE}"

            echo ''
            echo '================================================'
            echo '          FINAL APPLICATION URL'
            echo '================================================'

            echo "${env.APPLICATION_URL}"

            echo ''
            echo '================================================'
            echo '          DEPLOYMENT COMPLETE'
            echo '================================================'
        }


        failure {

            echo ''
            echo '================================================'
            echo '          CI/CD PIPELINE FAILED'
            echo '================================================'
            echo ''

            echo 'The pipeline stopped because a stage failed.'

            echo ''
            echo 'Check the Jenkins console output above.'

            echo ''
            echo '================================================'
        }


        always {

            echo ''
            echo '================================================'
            echo 'CLEANING JENKINS WORKSPACE'
            echo '================================================'

            cleanWs(
                deleteDirs: true,
                disableDeferredWipeout: true
            )
        }
    }
}
