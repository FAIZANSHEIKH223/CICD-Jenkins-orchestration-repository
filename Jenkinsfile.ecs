pipeline {

    agent any

    // ================================================================
    // PIPELINE OPTIONS
    // ================================================================

    options {

        timestamps()

        ansiColor('xterm')

        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                daysToKeepStr: '30',
                numToKeepStr: '50'
            )
        )

        timeout(
            time: 120,
            unit: 'MINUTES'
        )
    }


    // ================================================================
    // PARAMETERS
    // ================================================================

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: [
                'dev',
                'qa',
                'stage',
                'prod'
            ],
            description: 'Terraform environment to deploy'
        )
    }


    // ================================================================
    // ENVIRONMENT
    // ================================================================

    environment {

        // ------------------------------------------------------------
        // APPLICATION REPOSITORY
        // ------------------------------------------------------------

        APP_REPO =
            'https://github.com/FAIZANSHEIKH223/practice1.git'

        APP_BRANCH = 'main'


        // ------------------------------------------------------------
        // QUALITY REPOSITORY
        // ------------------------------------------------------------

        QUALITY_REPO =
            'https://github.com/FAIZANSHEIKH223/pylint_flake8_int_jenkins.git'

        QUALITY_BRANCH = 'main'


        // ------------------------------------------------------------
        // TERRAFORM REPOSITORY
        // ------------------------------------------------------------

        TERRAFORM_REPO =
            'https://github.com/FAIZANSHEIKH223/terraform-aws-infra.git'

        TERRAFORM_BRANCH = 'main'


        // ------------------------------------------------------------
        // GITHUB
        // ------------------------------------------------------------

        GITHUB_CREDENTIALS = 'github-creds'


        // ------------------------------------------------------------
        // PYTHON
        // ------------------------------------------------------------

        PYTHON = 'python3.12'


        // ------------------------------------------------------------
        // DIRECTORIES
        // ------------------------------------------------------------

        APP_DIR = 'practice1'

        QUALITY_DIR = 'quality-tools'

        TERRAFORM_DIR = 'terraform-infra'

        VENV_DIR = 'venv'

        REPORT_DIR = 'reports'


        // ------------------------------------------------------------
        // DOCKER
        // ------------------------------------------------------------

        DOCKER_IMAGE_NAME = 'practice1'

        DOCKER_IMAGE_TAG = "${BUILD_NUMBER}"

        DOCKER_IMAGE =
            "${DOCKER_IMAGE_NAME}:${DOCKER_IMAGE_TAG}"


        // ------------------------------------------------------------
        // AWS
        // ------------------------------------------------------------

        AWS_DEFAULT_REGION = 'us-east-1'

        AWS_REGION = 'us-east-1'

        AWS_CREDENTIALS = 'aws-creds'


        // ------------------------------------------------------------
        // ECR
        // ------------------------------------------------------------

        ECR_REPOSITORY = 'practice1'

        ECR_IMAGE_TAG = "${BUILD_NUMBER}"


        // ------------------------------------------------------------
        // TERRAFORM BACKEND
        // ------------------------------------------------------------

        TF_STATE_BUCKET =
            'terraform-state-faizan-001'

        TF_LOCK_TABLE =
            'terraform-locks'


        // ------------------------------------------------------------
        // TERRAFORM
        // ------------------------------------------------------------

        TF_IN_AUTOMATION = 'true'

        TF_INPUT = 'false'


        // ------------------------------------------------------------
        // DEPLOYMENT
        // ------------------------------------------------------------

        DEPLOY_SSH_CREDENTIALS = 'deploy-ssh-key'

        DEPLOY_USER = 'ubuntu'

        CONTAINER_NAME = 'practice1'

        CONTAINER_PORT = '8501'

        HOST_PORT = '8501'


        // ------------------------------------------------------------
        // DEPLOYMENT EC2
        // ------------------------------------------------------------

        DEPLOY_INSTANCE_ROLE = 'application'
    }


    // ================================================================
    // STAGES
    // ================================================================

    stages {


        // ============================================================
        // PART 1 - CODE QUALITY
        // ============================================================

        stage('1 - Checkout Application') {

            steps {

                echo '================================================'
                echo 'CHECKOUT APPLICATION'
                echo '================================================'

                dir("${APP_DIR}") {

                    git(
                        branch: "${APP_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${APP_REPO}"
                    )
                }
            }
        }


        stage('2 - Checkout Quality Repository') {

            steps {

                echo '================================================'
                echo 'CHECKOUT QUALITY REPOSITORY'
                echo '================================================'

                dir("${QUALITY_DIR}") {

                    git(
                        branch: "${QUALITY_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${QUALITY_REPO}"
                    )
                }
            }
        }


        stage('3 - Verify Python') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        command -v "${PYTHON}"

                        "${PYTHON}" --version

                        "${PYTHON}" -m pip --version
                    '''
                }
            }
        }


        stage('4 - Create Python Virtual Environment') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        rm -rf "${VENV_DIR}"

                        "${PYTHON}" -m venv "${VENV_DIR}"

                        "${VENV_DIR}/bin/python" --version
                    '''
                }
            }
        }


        stage('5 - Install Application Dependencies') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        "${VENV_DIR}/bin/python" \
                            -m pip install --upgrade pip

                        if [ -f requirements.txt ]; then

                            "${VENV_DIR}/bin/pip" \
                                install -r requirements.txt

                        else

                            echo "No requirements.txt found."

                        fi
                    '''
                }
            }
        }


        stage('6 - Install Quality Tools') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        "${VENV_DIR}/bin/pip" install \
                            flake8 \
                            pylint

                        "${VENV_DIR}/bin/flake8" --version

                        "${VENV_DIR}/bin/pylint" --version
                    '''
                }
            }
        }


        stage('7 - Flake8 Code Quality') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        mkdir -p "${REPORT_DIR}"

                        "${VENV_DIR}/bin/flake8" \
                            . \
                            --exclude="${VENV_DIR},.git,${REPORT_DIR},__pycache__" \
                            --count \
                            --statistics \
                            --tee \
                            --output-file="${REPORT_DIR}/flake8-report.txt"
                    '''
                }
            }
        }


        stage('8 - Pylint Code Quality') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        mkdir -p "${REPORT_DIR}"

                        PYTHON_FILES=$(find . \
                            -type f \
                            -name "*.py" \
                            ! -path "./${VENV_DIR}/*" \
                            ! -path "./.git/*" \
                            ! -path "./${REPORT_DIR}/*" \
                            ! -path "*/__pycache__/*")

                        if [ -z "${PYTHON_FILES}" ]; then
                            echo "ERROR: No Python files found."
                            exit 1
                        fi

                        "${VENV_DIR}/bin/pylint" \
                            ${PYTHON_FILES} \
                            --output-format=text \
                            > "${REPORT_DIR}/pylint-report.txt"
                    '''
                }
            }
        }


        stage('9 - Part 1 Success') {

            steps {

                echo '================================================'
                echo 'PART 1 CI SUCCESS'
                echo '================================================'

                echo 'Flake8 : PASSED'
                echo 'Pylint : PASSED'

                echo 'STARTING PART 2 - TESTING'
            }
        }


        // ============================================================
        // PART 2 - TESTING
        // ============================================================

        stage('10 - Install Pytest') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        "${VENV_DIR}/bin/pip" install pytest

                        "${VENV_DIR}/bin/pytest" --version
                    '''
                }
            }
        }


        stage('11 - Verify Tests') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        if [ ! -d "tests" ]; then
                            echo "ERROR: tests/ directory does not exist."
                            exit 1
                        fi

                        TEST_FILES=$(find tests \
                            -type f \
                            \\( \
                                -name "test_*.py" \
                                -o \
                                -name "*_test.py" \
                            \\))

                        if [ -z "${TEST_FILES}" ]; then
                            echo "ERROR: No pytest test files found."
                            exit 1
                        fi

                        echo "Test files:"
                        echo "${TEST_FILES}"
                    '''
                }
            }
        }


        stage('12 - Run Automated Tests') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        mkdir -p "${REPORT_DIR}"

                        "${VENV_DIR}/bin/pytest" \
                            tests/ \
                            -v \
                            --junitxml="${REPORT_DIR}/pytest-results.xml"
                    '''
                }
            }
        }


        stage('13 - Publish Test Results') {

            steps {

                junit(
                    testResults:
                        "${APP_DIR}/${REPORT_DIR}/pytest-results.xml",
                    allowEmptyResults: false
                )

                archiveArtifacts(
                    artifacts:
                        "${APP_DIR}/${REPORT_DIR}/pytest-results.xml," +
                        "${APP_DIR}/${REPORT_DIR}/flake8-report.txt," +
                        "${APP_DIR}/${REPORT_DIR}/pylint-report.txt",
                    allowEmptyArchive: false,
                    fingerprint: true
                )
            }
        }


        stage('14 - Part 2 Success') {

            steps {

                echo '================================================'
                echo 'PART 2 CI SUCCESS'
                echo '================================================'

                echo 'Pytest : PASSED'
                echo 'Tests  : PASSED'

                echo 'STARTING PART 3 - DOCKER'
            }
        }


        // ============================================================
        // PART 3 - DOCKER
        // ============================================================

        stage('15 - Verify Docker') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        command -v docker

                        docker --version

                        if ! docker info > /dev/null 2>&1; then

                            echo "ERROR: Jenkins cannot access Docker daemon."

                            sudo systemctl status docker \
                                --no-pager \
                                || true

                            exit 1

                        fi

                        echo "Docker daemon is accessible."
                    '''
                }
            }
        }


        stage('16 - Verify Dockerfile') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        if [ ! -f "Dockerfile" ]; then

                            echo "ERROR: Dockerfile was not found."

                            exit 1

                        fi

                        echo "Dockerfile found."

                        cat Dockerfile
                    '''
                }
            }
        }


        stage('17 - Build Docker Image') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "Building ${DOCKER_IMAGE}"

                        docker build \
                            --tag "${DOCKER_IMAGE}" \
                            .

                        docker image inspect \
                            "${DOCKER_IMAGE}" \
                            > /dev/null

                        echo "Docker image created successfully."
                    '''
                }
            }
        }


        stage('18 - Part 3 Success') {

            steps {

                echo '================================================'
                echo 'PART 3 DOCKER SUCCESS'
                echo '================================================'

                echo "Docker Image : ${DOCKER_IMAGE}"

                echo 'STARTING PART 4 - AWS ECR'
            }
        }


        // ============================================================
        // PART 4 - AWS ECR
        // ============================================================

        stage('19 - Verify AWS CLI') {

            steps {

                sh '''
                    set -e

                    command -v aws

                    aws --version
                '''
            }
        }


        stage('20 - Verify AWS Credentials') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        aws sts get-caller-identity \
                            --region "${AWS_DEFAULT_REGION}"
                    '''
                }
            }
        }


        stage('21 - Create ECR Repository If Required') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        if aws ecr describe-repositories \
                            --repository-names "${ECR_REPOSITORY}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            > /dev/null 2>&1
                        then

                            echo "ECR repository already exists."

                        else

                            aws ecr create-repository \
                                --repository-name "${ECR_REPOSITORY}" \
                                --region "${AWS_DEFAULT_REGION}"

                        fi
                    '''
                }
            }
        }


        stage('22 - Get ECR Registry') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        def accountId = sh(
                            script: '''
                                aws sts get-caller-identity \
                                    --query Account \
                                    --output text \
                                    --region "${AWS_DEFAULT_REGION}"
                            ''',
                            returnStdout: true
                        ).trim()

                        env.AWS_ACCOUNT_ID = accountId

                        env.ECR_REGISTRY =
                            "${accountId}.dkr.ecr.${AWS_DEFAULT_REGION}.amazonaws.com"

                        env.ECR_IMAGE =
                            "${env.ECR_REGISTRY}/${env.ECR_REPOSITORY}:${env.ECR_IMAGE_TAG}"

                        echo "AWS Account ID : ${env.AWS_ACCOUNT_ID}"
                        echo "ECR Registry   : ${env.ECR_REGISTRY}"
                        echo "ECR Image      : ${env.ECR_IMAGE}"
                    }
                }
            }
        }


        stage('23 - Login Docker to ECR') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        aws ecr get-login-password \
                            --region "${AWS_DEFAULT_REGION}" |
                        docker login \
                            --username AWS \
                            --password-stdin "${ECR_REGISTRY}"
                    '''
                }
            }
        }


        stage('24 - Tag Docker Image for ECR') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        docker tag \
                            "${DOCKER_IMAGE}" \
                            "${ECR_IMAGE}"

                        docker image inspect \
                            "${ECR_IMAGE}" \
                            > /dev/null
                    '''
                }
            }
        }


        stage('25 - Push Docker Image to ECR') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        docker push "${ECR_IMAGE}"
                    '''
                }
            }
        }


        stage('26 - Verify Image in ECR') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        aws ecr describe-images \
                            --repository-name "${ECR_REPOSITORY}" \
                            --image-ids imageTag="${ECR_IMAGE_TAG}" \
                            --region "${AWS_DEFAULT_REGION}"
                    '''
                }
            }
        }


        stage('27 - Part 4 Success') {

            steps {

                echo '================================================'
                echo 'PART 4 AWS ECR SUCCESS'
                echo '================================================'

                echo "ECR Image : ${ECR_IMAGE}"

                echo 'STARTING PART 5 - TERRAFORM'
            }
        }


        // ============================================================
        // PART 5 - TERRAFORM
        // ============================================================

        stage('28 - Checkout Terraform Repository') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    git(
                        branch: "${TERRAFORM_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${TERRAFORM_REPO}"
                    )
                }
            }
        }


        stage('29 - Bootstrap Terraform Backend') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        aws sts get-caller-identity \
                            --region "${AWS_DEFAULT_REGION}"

                        if ! aws s3api head-bucket \
                            --bucket "${TF_STATE_BUCKET}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            > /dev/null 2>&1
                        then

                            aws s3api create-bucket \
                                --bucket "${TF_STATE_BUCKET}" \
                                --region "${AWS_DEFAULT_REGION}"

                        fi

                        aws s3api put-bucket-versioning \
                            --bucket "${TF_STATE_BUCKET}" \
                            --versioning-configuration Status=Enabled \
                            --region "${AWS_DEFAULT_REGION}"

                        aws s3api put-bucket-encryption \
                            --bucket "${TF_STATE_BUCKET}" \
                            --server-side-encryption-configuration '{
                                "Rules": [
                                    {
                                        "ApplyServerSideEncryptionByDefault": {
                                            "SSEAlgorithm": "AES256"
                                        }
                                    }
                                ]
                            }' \
                            --region "${AWS_DEFAULT_REGION}"

                        aws s3api put-public-access-block \
                            --bucket "${TF_STATE_BUCKET}" \
                            --public-access-block-configuration \
                            BlockPublicAcls=true,IgnorePublicAcls=true,BlockPublicPolicy=true,RestrictPublicBuckets=true \
                            --region "${AWS_DEFAULT_REGION}"

                        if ! aws dynamodb describe-table \
                            --table-name "${TF_LOCK_TABLE}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            > /dev/null 2>&1
                        then

                            aws dynamodb create-table \
                                --table-name "${TF_LOCK_TABLE}" \
                                --attribute-definitions \
                                AttributeName=LockID,AttributeType=S \
                                --key-schema \
                                AttributeName=LockID,KeyType=HASH \
                                --billing-mode PAY_PER_REQUEST \
                                --region "${AWS_DEFAULT_REGION}"

                            aws dynamodb wait table-exists \
                                --table-name "${TF_LOCK_TABLE}" \
                                --region "${AWS_DEFAULT_REGION}"

                        fi

                        echo "Terraform backend ready."
                    '''
                }
            }
        }


        stage('30 - Verify Terraform') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    sh '''
                        set -e

                        command -v terraform

                        terraform version

                        find . \
                            -maxdepth 1 \
                            -type f \
                            -name "*.tf" \
                            -print
                    '''
                }
            }
        }


        stage('31 - Verify Terraform AWS Credentials') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        aws sts get-caller-identity \
                            --region "${AWS_DEFAULT_REGION}"
                    '''
                }
            }
        }


        stage('32 - Verify Terraform Environment') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    sh '''
                        set -e

                        if [ ! -d "environments/${ENVIRONMENT}" ]; then
                            echo "ERROR: Environment directory does not exist."
                            exit 1
                        fi

                        if [ ! -f "environments/${ENVIRONMENT}/terraform.tfvars" ]; then
                            echo "ERROR: terraform.tfvars not found."
                            exit 1
                        fi

                        echo "Terraform environment verified."
                    '''
                }
            }
        }


        stage('33 - Terraform Init') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    sh '''
                        set -e

                        terraform init \
                            -input=false
                    '''
                }
            }
        }


        stage('34 - Terraform Validate') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    sh '''
                        set -e

                        terraform validate
                    '''
                }
            }
        }


        stage('35 - Terraform Plan') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh '''
                            set -e

                            terraform plan \
                                -input=false \
                                -var-file="environments/${ENVIRONMENT}/terraform.tfvars" \
                                -out="tfplan"
                        '''
                    }
                }
            }
        }


        stage('36 - Terraform Apply') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh '''
                            set -e

                            test -f tfplan

                            terraform apply \
                                -input=false \
                                -auto-approve \
                                tfplan
                        '''
                    }
                }
            }
        }


        stage('37 - Verify Terraform Deployment') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh '''
                            set -e

                            terraform state list || true

                            terraform output || true

                            aws s3api head-bucket \
                                --bucket "${TF_STATE_BUCKET}" \
                                --region "${AWS_DEFAULT_REGION}"

                            aws dynamodb describe-table \
                                --table-name "${TF_LOCK_TABLE}" \
                                --region "${AWS_DEFAULT_REGION}" \
                                --query 'Table.TableStatus' \
                                --output text
                        '''
                    }
                }
            }
        }


        stage('38 - Part 5 Success') {

            steps {

                echo '================================================'
                echo 'PART 5 TERRAFORM SUCCESS'
                echo '================================================'

                echo "Environment : ${params.ENVIRONMENT}"

                echo 'Backend S3          : READY'
                echo 'DynamoDB Lock Table : READY'
                echo 'Terraform Init       : PASSED'
                echo 'Terraform Validate   : PASSED'
                echo 'Terraform Plan       : PASSED'
                echo 'Terraform Apply      : PASSED'
                echo 'Deployment Verify    : PASSED'

                echo 'STARTING PART 6 - APPLICATION DEPLOYMENT'
            }
        }


        // ============================================================
        // PART 6 - APPLICATION DEPLOYMENT
        // ============================================================

        stage('39 - Locate Deployment EC2') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        def instanceId = sh(
                            script: '''
                                aws ec2 describe-instances \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --filters \
                                        "Name=instance-state-name,Values=running" \
                                        "Name=tag:Role,Values=${DEPLOY_INSTANCE_ROLE}" \
                                        "Name=tag:Environment,Values=${ENVIRONMENT}" \
                                    --query 'Reservations[].Instances[].InstanceId' \
                                    --output text
                            ''',
                            returnStdout: true
                        ).trim()

                        if (!instanceId ||
                            instanceId == 'None') {

                            error(
                                "No running EC2 found with " +
                                "Role=${env.DEPLOY_INSTANCE_ROLE} " +
                                "Environment=${params.ENVIRONMENT}"
                            )
                        }

                        def instances =
                            instanceId.split("\\s+")

                        if (instances.size() != 1) {

                            error(
                                "Expected exactly one deployment EC2. " +
                                "Found ${instances.size()}"
                            )
                        }

                        env.DEPLOY_INSTANCE_ID =
                            instances[0]

                        def publicIp = sh(
                            script: """
                                aws ec2 describe-instances \
                                    --region "${env.AWS_DEFAULT_REGION}" \
                                    --instance-ids "${env.DEPLOY_INSTANCE_ID}" \
                                    --query 'Reservations[0].Instances[0].PublicIpAddress' \
                                    --output text
                            """,
                            returnStdout: true
                        ).trim()

                        if (!publicIp ||
                            publicIp == 'None') {

                            error(
                                "Deployment EC2 has no public IP."
                            )
                        }

                        env.DEPLOY_HOST = publicIp

                        echo "Deployment Instance : ${env.DEPLOY_INSTANCE_ID}"
                        echo "Deployment Host     : ${env.DEPLOY_HOST}"
                        echo "Environment         : ${params.ENVIRONMENT}"
                    }
                }
            }
        }


        stage('40 - Verify Deployment EC2 SSH') {

            steps {

                sshagent(
                    credentials: ["${DEPLOY_SSH_CREDENTIALS}"]
                ) {

                    sh '''
                        set -e

                        mkdir -p ~/.ssh

                        chmod 700 ~/.ssh

                        ssh-keyscan \
                            -H \
                            "${DEPLOY_HOST}" \
                            >> ~/.ssh/known_hosts 2>/dev/null || true

                        ssh \
                            -o StrictHostKeyChecking=yes \
                            -o ConnectTimeout=20 \
                            "${DEPLOY_USER}@${DEPLOY_HOST}" \
                            "echo 'SSH connection successful'"
                    '''
                }
            }
        }


        stage('41 - Prepare Deployment EC2') {

            steps {

                sshagent(
                    credentials: ["${DEPLOY_SSH_CREDENTIALS}"]
                ) {

                    sh '''
                        set -e

                        ssh \
                            -o StrictHostKeyChecking=yes \
                            "${DEPLOY_USER}@${DEPLOY_HOST}" \
                            'bash -s' <<'REMOTE_SCRIPT'

set -e

echo "================================================"
echo "REMOTE EC2 PREPARATION"
echo "================================================"

echo "Operating system:"
cat /etc/os-release | head -5

echo ""
echo "Docker:"

command -v docker

docker --version

if ! sudo docker info > /dev/null 2>&1; then

    echo "ERROR: Docker daemon is not accessible."

    sudo systemctl status docker \
        --no-pager \
        || true

    exit 1

fi

echo "Docker daemon is ready."

echo ""
echo "AWS CLI:"

if ! command -v aws > /dev/null 2>&1; then

    echo "Installing AWS CLI v2..."

    sudo apt-get update -y

    sudo apt-get install -y \
        curl \
        unzip

    cd /tmp

    rm -f awscliv2.zip

    curl \
        -fsSL \
        "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" \
        -o awscliv2.zip

    rm -rf aws

    unzip -q awscliv2.zip

    sudo ./aws/install \
        --update

fi

/usr/local/bin/aws --version

echo ""
echo "Checking EC2 IAM role..."

if ! aws sts get-caller-identity \
    --region "${AWS_DEFAULT_REGION}" \
    > /dev/null 2>&1
then

    echo ""
    echo "ERROR: Deployment EC2 has no usable IAM role."
    echo ""
    echo "The EC2 instance requires an IAM instance profile"
    echo "with permission to pull the ECR image."
    echo ""

    exit 1

fi

aws sts get-caller-identity \
    --region "${AWS_DEFAULT_REGION}"

echo ""
echo "REMOTE EC2 PREPARATION PASSED"

REMOTE_SCRIPT
                    '''
                }
            }
        }


        stage('42 - Deploy ECR Image to EC2') {

            steps {

                sshagent(
                    credentials: ["${DEPLOY_SSH_CREDENTIALS}"]
                ) {

                    sh '''
                        set -e

                        ssh \
                            -o StrictHostKeyChecking=yes \
                            "${DEPLOY_USER}@${DEPLOY_HOST}" \
                            "AWS_DEFAULT_REGION='${AWS_DEFAULT_REGION}' ECR_REGISTRY='${ECR_REGISTRY}' ECR_IMAGE='${ECR_IMAGE}' CONTAINER_NAME='${CONTAINER_NAME}' HOST_PORT='${HOST_PORT}' CONTAINER_PORT='${CONTAINER_PORT}' bash -s" <<'REMOTE_SCRIPT'

set -e

echo "================================================"
echo "REMOTE APPLICATION DEPLOYMENT"
echo "================================================"

echo ""
echo "AWS identity:"

aws sts get-caller-identity \
    --region "${AWS_DEFAULT_REGION}"

echo ""
echo "Testing ECR access..."

aws ecr describe-repositories \
    --repository-names "$(echo "${ECR_IMAGE}" | cut -d/ -f2 | cut -d: -f1)" \
    --region "${AWS_DEFAULT_REGION}" \
    > /dev/null

echo ""
echo "Logging Docker into ECR..."

aws ecr get-login-password \
    --region "${AWS_DEFAULT_REGION}" |
sudo docker login \
    --username AWS \
    --password-stdin "${ECR_REGISTRY}"

echo ""
echo "Pulling ECR image..."

sudo docker pull \
    "${ECR_IMAGE}"

echo ""
echo "Stopping previous container..."

if sudo docker ps -a \
    --format '{{.Names}}' |
    grep -Fxq "${CONTAINER_NAME}"
then

    sudo docker stop \
        "${CONTAINER_NAME}" \
        || true

    sudo docker rm \
        "${CONTAINER_NAME}" \
        || true

fi

echo ""
echo "Starting new container..."

sudo docker run \
    -d \
    --restart unless-stopped \
    --name "${CONTAINER_NAME}" \
    -p "${HOST_PORT}:${CONTAINER_PORT}" \
    "${ECR_IMAGE}"

echo ""
echo "Waiting for startup..."

sleep 10

echo ""
echo "Container status:"

sudo docker ps \
    --filter "name=${CONTAINER_NAME}"

echo ""
echo "Deployment completed."

REMOTE_SCRIPT
                    '''
                }
            }
        }


        stage('43 - Verify Running Container') {

            steps {

                sshagent(
                    credentials: ["${DEPLOY_SSH_CREDENTIALS}"]
                ) {

                    sh '''
                        set -e

                        ssh \
                            -o StrictHostKeyChecking=yes \
                            "${DEPLOY_USER}@${DEPLOY_HOST}" \
                            "CONTAINER_NAME='${CONTAINER_NAME}' ECR_IMAGE='${ECR_IMAGE}' bash -s" <<'REMOTE_SCRIPT'

set -e

echo "================================================"
echo "VERIFYING RUNNING CONTAINER"
echo "================================================"

echo ""
echo "Docker containers:"

sudo docker ps

echo ""
echo "Checking container..."

if ! sudo docker ps \
    --format '{{.Names}}' |
    grep -Fxq "${CONTAINER_NAME}"
then

    echo "ERROR: Container is not running."

    sudo docker logs \
        "${CONTAINER_NAME}" \
        || true

    exit 1

fi

echo "Container is RUNNING."

echo ""
echo "Checking image..."

RUNNING_IMAGE=$(sudo docker inspect \
    "${CONTAINER_NAME}" \
    --format='{{.Config.Image}}')

echo "Expected : ${ECR_IMAGE}"
echo "Running  : ${RUNNING_IMAGE}"

if [ "${RUNNING_IMAGE}" != "${ECR_IMAGE}" ]; then

    echo "ERROR: Running image does not match expected ECR image."

    exit 1

fi

echo ""
echo "Checking restart policy..."

RESTART_POLICY=$(sudo docker inspect \
    "${CONTAINER_NAME}" \
    --format='{{.HostConfig.RestartPolicy.Name}}')

echo "Restart policy: ${RESTART_POLICY}"

if [ "${RESTART_POLICY}" != "unless-stopped" ]; then

    echo "ERROR: Incorrect restart policy."

    exit 1

fi

echo ""
echo "Recent application logs:"

sudo docker logs \
    --tail 30 \
    "${CONTAINER_NAME}" \
    || true

echo ""
echo "Container verification PASSED."

REMOTE_SCRIPT
                    '''
                }
            }
        }


        // ============================================================
        // PART 7 - HEALTH CHECK + DEPLOYMENT VERIFICATION
        // ============================================================

        stage('44 - Part 7 EC2 Health Check') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "PART 7 - EC2 HEALTH CHECK"
                        echo "================================================"

                        INSTANCE_STATE=$(aws ec2 describe-instances \
                            --region "${AWS_DEFAULT_REGION}" \
                            --instance-ids "${DEPLOY_INSTANCE_ID}" \
                            --query 'Reservations[0].Instances[0].State.Name' \
                            --output text)

                        echo "EC2 state: ${INSTANCE_STATE}"

                        if [ "${INSTANCE_STATE}" != "running" ]; then

                            echo "ERROR: Deployment EC2 is not running."

                            exit 1

                        fi

                        echo "EC2 health check PASSED."
                    '''
                }
            }
        }


        stage('45 - Part 7 Verify EC2 Tags') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "VERIFYING DEPLOYMENT EC2 TAGS"
                        echo "================================================"

                        ROLE=$(aws ec2 describe-instances \
                            --region "${AWS_DEFAULT_REGION}" \
                            --instance-ids "${DEPLOY_INSTANCE_ID}" \
                            --query 'Reservations[0].Instances[0].Tags[?Key==`Role`]|[0].Value' \
                            --output text)

                        ENV_TAG=$(aws ec2 describe-instances \
                            --region "${AWS_DEFAULT_REGION}" \
                            --instance-ids "${DEPLOY_INSTANCE_ID}" \
                            --query 'Reservations[0].Instances[0].Tags[?Key==`Environment`]|[0].Value' \
                            --output text)

                        echo "Role        : ${ROLE}"
                        echo "Environment : ${ENV_TAG}"

                        if [ "${ROLE}" != "${DEPLOY_INSTANCE_ROLE}" ]; then

                            echo "ERROR: Role tag mismatch."

                            exit 1

                        fi

                        if [ "${ENV_TAG}" != "${ENVIRONMENT}" ]; then

                            echo "ERROR: Environment tag mismatch."

                            exit 1

                        fi

                        echo "EC2 tags verified."
                    '''
                }
            }
        }


        stage('46 - Part 7 Docker Health Check') {

            steps {

                sshagent(
                    credentials: ["${DEPLOY_SSH_CREDENTIALS}"]
                ) {

                    sh '''
                        set -e

                        ssh \
                            -o StrictHostKeyChecking=yes \
                            "${DEPLOY_USER}@${DEPLOY_HOST}" \
                            "CONTAINER_NAME='${CONTAINER_NAME}' bash -s" <<'REMOTE_SCRIPT'

set -e

echo "================================================"
echo "DOCKER HEALTH CHECK"
echo "================================================"

DOCKER_STATUS=$(sudo docker inspect \
    "${CONTAINER_NAME}" \
    --format='{{.State.Status}}')

echo "Container status: ${DOCKER_STATUS}"

if [ "${DOCKER_STATUS}" != "running" ]; then

    echo "ERROR: Container is not running."

    sudo docker logs \
        "${CONTAINER_NAME}" \
        || true

    exit 1

fi

RUNNING=$(sudo docker inspect \
    "${CONTAINER_NAME}" \
    --format='{{.State.Running}}')

echo "Running: ${RUNNING}"

if [ "${RUNNING}" != "true" ]; then

    echo "ERROR: Container State.Running is not true."

    exit 1

fi

echo ""
echo "Docker health check PASSED."

REMOTE_SCRIPT
                    '''
                }
            }
        }


        stage('47 - Part 7 Port Check') {

            steps {

                sshagent(
                    credentials: ["${DEPLOY_SSH_CREDENTIALS}"]
                ) {

                    sh '''
                        set -e

                        ssh \
                            -o StrictHostKeyChecking=yes \
                            "${DEPLOY_USER}@${DEPLOY_HOST}" \
                            "HOST_PORT='${HOST_PORT}' bash -s" <<'REMOTE_SCRIPT'

set -e

echo "================================================"
echo "CHECKING APPLICATION PORT"
echo "================================================"

if ! command -v ss > /dev/null 2>&1; then

    echo "ss command not found."

    exit 1

fi

echo "Listening ports:"

sudo ss -lntp || true

echo ""
echo "Checking port ${HOST_PORT}..."

if sudo ss -lnt \
    | awk '{print $4}' \
    | grep -Eq "[:.]${HOST_PORT}$"
then

    echo "Port ${HOST_PORT} is listening."

else

    echo "ERROR: Port ${HOST_PORT} is not listening."

    exit 1

fi

echo ""
echo "Application port check PASSED."

REMOTE_SCRIPT
                    '''
                }
            }
        }


        stage('48 - Part 7 HTTP Health Check') {

            steps {

                sh '''
                    set -e

                    echo "================================================"
                    echo "APPLICATION HTTP HEALTH CHECK"
                    echo "================================================"

                    SUCCESS=false

                    for i in $(seq 1 12)
                    do

                        echo "HTTP health check ${i}/12..."

                        if curl \
                            --fail \
                            --silent \
                            --show-error \
                            --max-time 5 \
                            "http://${DEPLOY_HOST}:${HOST_PORT}/" \
                            > /tmp/application-health-response.txt
                        then

                            SUCCESS=true

                            echo ""
                            echo "HTTP response received."

                            cat /tmp/application-health-response.txt \
                                | head -c 500

                            echo ""

                            break

                        fi

                        sleep 5

                    done

                    rm -f /tmp/application-health-response.txt

                    if [ "${SUCCESS}" != "true" ]; then

                        echo ""
                        echo "ERROR: Application HTTP health check FAILED."

                        exit 1

                    fi

                    echo ""
                    echo "HTTP health check PASSED."
                '''
            }
        }


        stage('49 - Part 7 Final Deployment Verification') {

            steps {

                sshagent(
                    credentials: ["${DEPLOY_SSH_CREDENTIALS}"]
                ) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "FINAL DEPLOYMENT VERIFICATION"
                        echo "================================================"

                        ssh \
                            -o StrictHostKeyChecking=yes \
                            "${DEPLOY_USER}@${DEPLOY_HOST}" \
                            "CONTAINER_NAME='${CONTAINER_NAME}' bash -s" <<'REMOTE_SCRIPT'

set -e

echo ""
echo "Docker version:"
docker --version

echo ""
echo "Running containers:"
sudo docker ps

echo ""
echo "Container details:"

sudo docker inspect \
    "${CONTAINER_NAME}" \
    --format='
Name={{.Name}}
Image={{.Config.Image}}
Status={{.State.Status}}
Running={{.State.Running}}
RestartPolicy={{.HostConfig.RestartPolicy.Name}}
StartedAt={{.State.StartedAt}}
'

echo ""
echo "Recent logs:"

sudo docker logs \
    --tail 20 \
    "${CONTAINER_NAME}" \
    || true

echo ""
echo "FINAL EC2 DEPLOYMENT VERIFICATION PASSED."

REMOTE_SCRIPT
                    '''
                }
            }
        }


        stage('50 - Part 7 Success') {

            steps {

                echo ''
                echo '================================================'
                echo '          PART 7 SUCCESS'
                echo '================================================'

                echo "Environment       : ${params.ENVIRONMENT}"
                echo "EC2 Instance      : ${env.DEPLOY_INSTANCE_ID}"
                echo "EC2 Host          : ${env.DEPLOY_HOST}"
                echo "ECR Image         : ${env.ECR_IMAGE}"
                echo "Container         : ${env.CONTAINER_NAME}"
                echo "Host Port         : ${env.HOST_PORT}"

                echo ''
                echo 'EC2 Health        : PASSED'
                echo 'EC2 Tags          : PASSED'
                echo 'Docker Health     : PASSED'
                echo 'Container Image   : PASSED'
                echo 'Restart Policy    : PASSED'
                echo 'Port Check        : PASSED'
                echo 'HTTP Health       : PASSED'
                echo 'Final Verification: PASSED'

                echo ''
                echo '================================================'
                echo '          PART 7 HEALTH CHECK SUCCESS'
                echo '================================================'
            }
        }
    }


    // ================================================================
    // POST ACTIONS
    // ================================================================

    post {

        success {

            echo ''
            echo '================================================'
            echo ' PART 1 + PART 2 + PART 3 + PART 4 + PART 5'
            echo '                 + PART 6 + PART 7'
            echo '                 SUCCESS'
            echo '================================================'

            echo ''
            echo 'Part 1 - Code Quality       : PASSED'
            echo 'Part 2 - Automated Testing  : PASSED'
            echo 'Part 3 - Docker             : PASSED'
            echo 'Part 4 - AWS ECR            : PASSED'
            echo 'Part 5 - Terraform          : PASSED'
            echo 'Part 6 - Deployment         : PASSED'
            echo 'Part 7 - Health Check       : PASSED'

            echo ''
            echo "Environment : ${params.ENVIRONMENT}"

            echo ''
            echo 'Terraform infrastructure successfully deployed.'
            echo 'Application successfully deployed to EC2.'
            echo 'Application health verification successfully completed.'

            echo '================================================'
        }


        failure {

            echo ''
            echo '================================================'
            echo ' PART 1 + PART 2 + PART 3 + PART 4 + PART 5'
            echo '                 + PART 6 + PART 7'
            echo '                 FAILED'
            echo '================================================'

            echo ''
            echo 'The pipeline stopped at the failed stage.'

            echo ''
            echo 'Check the Jenkins console output above'
            echo 'for the exact failing command.'

            echo '================================================'
        }


        always {

            echo ''
            echo '================================================'
            echo 'CLEANING JENKINS WORKSPACE'
            echo '================================================'

            cleanWs(
                deleteDirs: true,
                disableDeferredWipeout: true
            )
        }
    }
}
