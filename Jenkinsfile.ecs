pipeline {

    agent any

    // ================================================================
    // PIPELINE OPTIONS
    // ================================================================

    options {

        timestamps()

        ansiColor('xterm')

        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                daysToKeepStr: '30',
                numToKeepStr: '50'
            )
        )

        timeout(
            time: 90,
            unit: 'MINUTES'
        )
    }


    // ================================================================
    // PARAMETERS
    // ================================================================

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: [
                'dev',
                'qa',
                'stage',
                'prod'
            ],
            description: 'Terraform environment to deploy'
        )
    }


    // ================================================================
    // ENVIRONMENT
    // ================================================================

    environment {

        // ------------------------------------------------------------
        // REPOSITORIES
        // ------------------------------------------------------------

        APP_REPO = 'https://github.com/FAIZANSHEIKH223/practice1.git'
        APP_BRANCH = 'main'

        QUALITY_REPO = 'https://github.com/FAIZANSHEIKH223/pylint_flake8_int_jenkins.git'
        QUALITY_BRANCH = 'main'

        TERRAFORM_REPO = 'https://github.com/FAIZANSHEIKH223/terraform-aws-infra.git'
        TERRAFORM_BRANCH = 'main'


        // ------------------------------------------------------------
        // JENKINS CREDENTIALS
        // ------------------------------------------------------------

        GITHUB_CREDENTIALS = 'github-creds'
        AWS_CREDENTIALS = 'aws-creds'


        // ------------------------------------------------------------
        // DIRECTORIES
        // ------------------------------------------------------------

        APP_DIR = 'practice1'
        QUALITY_DIR = 'quality-tools'
        TERRAFORM_DIR = 'terraform-infra'
        VENV_DIR = 'venv'
        REPORT_DIR = 'reports'


        // ------------------------------------------------------------
        // PYTHON
        // ------------------------------------------------------------

        PYTHON = 'python3.12'


        // ------------------------------------------------------------
        // AWS
        // ------------------------------------------------------------

        AWS_DEFAULT_REGION = 'us-east-1'


        // ------------------------------------------------------------
        // APPLICATION
        // ------------------------------------------------------------

        APP_NAME = 'practice1'
        CONTAINER_NAME = 'practice1'
        CONTAINER_PORT = '8501'


        // ------------------------------------------------------------
        // DOCKER
        // ------------------------------------------------------------

        DOCKER_IMAGE_NAME = 'practice1'
        DOCKER_IMAGE_TAG = "${BUILD_NUMBER}"
        DOCKER_IMAGE = "${DOCKER_IMAGE_NAME}:${DOCKER_IMAGE_TAG}"


        // ------------------------------------------------------------
        // ECR
        // ------------------------------------------------------------

        ECR_REPOSITORY = 'practice1'
        ECR_IMAGE_TAG = "${BUILD_NUMBER}"


        // ------------------------------------------------------------
        // ECS
        // ------------------------------------------------------------

        ECS_CLUSTER = "practice1-${ENVIRONMENT}-cluster"
        ECS_SERVICE = "practice1-${ENVIRONMENT}-service"
        ECS_TASK_FAMILY = "practice1-${ENVIRONMENT}-task"
        ECS_CONTAINER_NAME = 'practice1'


        // ------------------------------------------------------------
        // FARGATE
        // ------------------------------------------------------------

        FARGATE_CPU = '256'
        FARGATE_MEMORY = '512'


        // ------------------------------------------------------------
        // LOAD BALANCER
        // ------------------------------------------------------------

        ALB_NAME = "practice1-${ENVIRONMENT}-alb"
        TARGET_GROUP_NAME = "practice1-${ENVIRONMENT}-tg"
        ALB_SG_NAME = "practice1-${ENVIRONMENT}-alb-sg"
        ECS_SG_NAME = "practice1-${ENVIRONMENT}-ecs-sg"


        // ------------------------------------------------------------
        // TERRAFORM
        // ------------------------------------------------------------

        TF_STATE_BUCKET = 'terraform-state-faizan-001'
        TF_LOCK_TABLE = 'terraform-locks'
        TF_IN_AUTOMATION = 'true'
        TF_INPUT = 'false'


        // ------------------------------------------------------------
        // ECS HEALTH
        // ------------------------------------------------------------

        HEALTH_PATH = '/'


        // ------------------------------------------------------------
        // DNS
        // ------------------------------------------------------------

        DNS_NAME = ''
    }


    // ================================================================
    // STAGES
    // ================================================================

    stages {


        // ============================================================
        // PART 1 - CODE QUALITY
        // ============================================================

        stage('1 - Checkout Application') {

            steps {

                echo '================================================'
                echo 'CHECKOUT APPLICATION'
                echo '================================================'

                dir("${APP_DIR}") {

                    deleteDir()

                    git(
                        branch: "${APP_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${APP_REPO}"
                    )
                }
            }
        }


        stage('2 - Checkout Quality Repository') {

            steps {

                echo '================================================'
                echo 'CHECKOUT QUALITY REPOSITORY'
                echo '================================================'

                dir("${QUALITY_DIR}") {

                    deleteDir()

                    git(
                        branch: "${QUALITY_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${QUALITY_REPO}"
                    )
                }
            }
        }


        stage('3 - Verify Python') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "VERIFYING PYTHON"
                        echo "================================================"

                        command -v "${PYTHON}"

                        "${PYTHON}" --version

                        "${PYTHON}" -m pip --version
                    '''
                }
            }
        }


        stage('4 - Create Python Virtual Environment') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "CREATING PYTHON VIRTUAL ENVIRONMENT"
                        echo "================================================"

                        rm -rf "${VENV_DIR}"

                        "${PYTHON}" -m venv "${VENV_DIR}"

                        "${VENV_DIR}/bin/python" --version
                    '''
                }
            }
        }


        stage('5 - Install Application Dependencies') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "INSTALLING APPLICATION DEPENDENCIES"
                        echo "================================================"

                        "${VENV_DIR}/bin/python" \
                            -m pip install --upgrade pip

                        if [ -f requirements.txt ]; then

                            "${VENV_DIR}/bin/pip" \
                                install \
                                -r requirements.txt

                        else

                            echo "WARNING: requirements.txt not found."

                        fi
                    '''
                }
            }
        }


        stage('6 - Install Quality Tools') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "INSTALLING QUALITY TOOLS"
                        echo "================================================"

                        "${VENV_DIR}/bin/pip" \
                            install \
                            flake8 \
                            pylint

                        "${VENV_DIR}/bin/flake8" --version

                        "${VENV_DIR}/bin/pylint" --version
                    '''
                }
            }
        }


        stage('7 - Flake8 Code Quality') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "RUNNING FLAKE8"
                        echo "================================================"

                        mkdir -p "${REPORT_DIR}"

                        "${VENV_DIR}/bin/flake8" \
                            . \
                            --exclude="${VENV_DIR},.git,${REPORT_DIR},__pycache__" \
                            --count \
                            --statistics \
                            --tee \
                            --output-file="${REPORT_DIR}/flake8-report.txt"
                    '''
                }
            }
        }


        stage('8 - Pylint Code Quality') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "RUNNING PYLINT"
                        echo "================================================"

                        mkdir -p "${REPORT_DIR}"

                        PYTHON_FILES=$(find . \
                            -type f \
                            -name "*.py" \
                            ! -path "./${VENV_DIR}/*" \
                            ! -path "./.git/*" \
                            ! -path "./${REPORT_DIR}/*" \
                            ! -path "*/__pycache__/*")

                        if [ -z "${PYTHON_FILES}" ]; then

                            echo "ERROR: No Python files found."

                            exit 1

                        fi

                        "${VENV_DIR}/bin/pylint" \
                            ${PYTHON_FILES} \
                            --output-format=text \
                            > "${REPORT_DIR}/pylint-report.txt"
                    '''
                }
            }
        }


        stage('9 - Part 1 Success') {

            steps {

                echo '================================================'
                echo 'PART 1 - CODE QUALITY SUCCESS'
                echo '================================================'

                echo 'Flake8 : PASSED'
                echo 'Pylint : PASSED'
            }
        }


        // ============================================================
        // PART 2 - TESTING
        // ============================================================

        stage('10 - Install Pytest') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "INSTALLING PYTEST"
                        echo "================================================"

                        "${VENV_DIR}/bin/pip" install pytest

                        "${VENV_DIR}/bin/pytest" --version
                    '''
                }
            }
        }


        stage('11 - Verify Tests') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "VERIFYING TESTS"
                        echo "================================================"

                        if [ ! -d "tests" ]; then

                            echo "ERROR: tests/ directory does not exist."

                            exit 1

                        fi

                        TEST_FILES=$(find tests \
                            -type f \
                            \\( \
                                -name "test_*.py" \
                                -o \
                                -name "*_test.py" \
                            \\))

                        if [ -z "${TEST_FILES}" ]; then

                            echo "ERROR: No pytest test files found."

                            exit 1

                        fi

                        echo "Test files:"
                        echo "${TEST_FILES}"
                    '''
                }
            }
        }


        stage('12 - Run Automated Tests') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "RUNNING AUTOMATED TESTS"
                        echo "================================================"

                        mkdir -p "${REPORT_DIR}"

                        "${VENV_DIR}/bin/pytest" \
                            tests/ \
                            -v \
                            --junitxml="${REPORT_DIR}/pytest-results.xml"
                    '''
                }
            }
        }


        stage('13 - Publish Test Results') {

            steps {

                junit(
                    testResults:
                        "${APP_DIR}/${REPORT_DIR}/pytest-results.xml",
                    allowEmptyResults: false
                )

                archiveArtifacts(
                    artifacts:
                        "${APP_DIR}/${REPORT_DIR}/pytest-results.xml," +
                        "${APP_DIR}/${REPORT_DIR}/flake8-report.txt," +
                        "${APP_DIR}/${REPORT_DIR}/pylint-report.txt",
                    allowEmptyArchive: false,
                    fingerprint: true
                )
            }
        }


        stage('14 - Part 2 Success') {

            steps {

                echo '================================================'
                echo 'PART 2 - TESTING SUCCESS'
                echo '================================================'

                echo 'Pytest : PASSED'
            }
        }


        // ============================================================
        // PART 3 - DOCKER
        // ============================================================

        stage('15 - Verify Docker') {

            steps {

                sh '''
                    set -e

                    echo "================================================"
                    echo "VERIFYING DOCKER"
                    echo "================================================"

                    command -v docker

                    docker --version

                    docker info > /dev/null

                    echo "Docker daemon is accessible."
                '''
            }
        }


        stage('16 - Prepare Docker Build Context') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "PREPARING DOCKER BUILD CONTEXT"
                        echo "================================================"

                        if [ ! -f Dockerfile ]; then

                            echo "ERROR: Dockerfile not found."

                            exit 1

                        fi

                        cat > .dockerignore <<'EOF'
venv/
.venv/
.git/
.gitignore
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
reports/
*.log
.DS_Store
EOF

                        echo ""
                        echo "Docker ignore file:"
                        cat .dockerignore

                        echo ""
                        echo "Dockerfile:"
                        cat Dockerfile
                    '''
                }
            }
        }


        stage('17 - Build Docker Image') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "BUILDING DOCKER IMAGE"
                        echo "================================================"

                        echo "Image: ${DOCKER_IMAGE}"

                        docker build \
                            --pull \
                            --tag "${DOCKER_IMAGE}" \
                            .

                        docker image inspect \
                            "${DOCKER_IMAGE}" \
                            > /dev/null

                        echo "Docker image created successfully."
                    '''
                }
            }
        }


        stage('18 - Docker Image Verification') {

            steps {

                sh '''
                    set -e

                    echo "================================================"
                    echo "VERIFYING DOCKER IMAGE"
                    echo "================================================"

                    docker image inspect \
                        "${DOCKER_IMAGE}" \
                        --format='Image={{.RepoTags}} Size={{.Size}}'

                    echo ""
                    docker images "${DOCKER_IMAGE_NAME}"
                '''
            }
        }


        stage('19 - Part 3 Success') {

            steps {

                echo '================================================'
                echo 'PART 3 - DOCKER SUCCESS'
                echo '================================================'

                echo "Docker Image: ${DOCKER_IMAGE}"
            }
        }


        // ============================================================
        // PART 4 - AWS ECR
        // ============================================================

        stage('20 - Verify AWS CLI') {

            steps {

                sh '''
                    set -e

                    echo "================================================"
                    echo "VERIFYING AWS CLI"
                    echo "================================================"

                    command -v aws

                    aws --version
                '''
            }
        }


        stage('21 - Verify AWS Credentials') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        aws sts get-caller-identity \
                            --region "${AWS_DEFAULT_REGION}"
                    '''
                }
            }
        }


        stage('22 - Create ECR Repository') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        if aws ecr describe-repositories \
                            --repository-names "${ECR_REPOSITORY}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            > /dev/null 2>&1
                        then

                            echo "ECR repository already exists."

                        else

                            echo "Creating ECR repository..."

                            aws ecr create-repository \
                                --repository-name "${ECR_REPOSITORY}" \
                                --region "${AWS_DEFAULT_REGION}"

                        fi
                    '''
                }
            }
        }


        stage('23 - Get ECR Image URI') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        def accountId = sh(
                            script: '''
                                aws sts get-caller-identity \
                                    --query Account \
                                    --output text \
                                    --region "${AWS_DEFAULT_REGION}"
                            ''',
                            returnStdout: true
                        ).trim()

                        env.AWS_ACCOUNT_ID = accountId

                        env.ECR_REGISTRY =
                            "${accountId}.dkr.ecr.${AWS_DEFAULT_REGION}.amazonaws.com"

                        env.ECR_IMAGE =
                            "${env.ECR_REGISTRY}/${env.ECR_REPOSITORY}:${env.ECR_IMAGE_TAG}"

                        echo "AWS Account ID : ${env.AWS_ACCOUNT_ID}"
                        echo "ECR Registry   : ${env.ECR_REGISTRY}"
                        echo "ECR Image URI  : ${env.ECR_IMAGE}"
                    }
                }
            }
        }


        stage('24 - Login Docker to ECR') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        aws ecr get-login-password \
                            --region "${AWS_DEFAULT_REGION}" \
                        | docker login \
                            --username AWS \
                            --password-stdin \
                            "${ECR_REGISTRY}"
                    '''
                }
            }
        }


        stage('25 - Tag Image with ECR URI') {

            steps {

                sh '''
                    set -e

                    docker tag \
                        "${DOCKER_IMAGE}" \
                        "${ECR_IMAGE}"

                    docker image inspect \
                        "${ECR_IMAGE}" \
                        > /dev/null

                    echo "ECR image:"
                    echo "${ECR_IMAGE}"
                '''
            }
        }


        stage('26 - Push Image to ECR') {

            steps {

                sh '''
                    set -e

                    docker push "${ECR_IMAGE}"
                '''
            }
        }


        stage('27 - Verify ECR Image') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        aws ecr describe-images \
                            --repository-name "${ECR_REPOSITORY}" \
                            --image-ids imageTag="${ECR_IMAGE_TAG}" \
                            --region "${AWS_DEFAULT_REGION}"

                        echo ""
                        echo "ECR IMAGE VERIFIED:"
                        echo "${ECR_IMAGE}"
                    '''
                }
            }
        }


        stage('28 - Part 4 Success') {

            steps {

                echo '================================================'
                echo 'PART 4 - ECR SUCCESS'
                echo '================================================'

                echo "ECR Image URI: ${env.ECR_IMAGE}"
            }
        }


        // ============================================================
        // PART 5 - TERRAFORM
        // ============================================================

        stage('29 - Checkout Terraform Repository') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    deleteDir()

                    git(
                        branch: "${TERRAFORM_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${TERRAFORM_REPO}"
                    )
                }
            }
        }


        stage('30 - Verify Terraform') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    sh '''
                        set -e

                        command -v terraform

                        terraform version

                        echo ""
                        echo "Terraform files:"

                        find . \
                            -maxdepth 3 \
                            -type f \
                            -name "*.tf" \
                            -print
                    '''
                }
            }
        }


        stage('31 - Terraform Environment Verification') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    sh '''
                        set -e

                        echo "Environment: ${ENVIRONMENT}"

                        if [ ! -d "environments/${ENVIRONMENT}" ]; then

                            echo "ERROR: Terraform environment does not exist:"
                            echo "environments/${ENVIRONMENT}"

                            exit 1

                        fi

                        if [ ! -f "environments/${ENVIRONMENT}/terraform.tfvars" ]; then

                            echo "ERROR: terraform.tfvars not found."

                            exit 1

                        fi

                        echo "Terraform environment verified."
                    '''
                }
            }
        }


        stage('32 - Terraform Init') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh '''
                            set -e

                            terraform init \
                                -input=false
                        '''
                    }
                }
            }
        }


        stage('33 - Terraform Validate') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    sh '''
                        set -e

                        terraform validate
                    '''
                }
            }
        }


        stage('34 - Terraform Plan') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh '''
                            set -e

                            terraform plan \
                                -input=false \
                                -var-file="environments/${ENVIRONMENT}/terraform.tfvars" \
                                -out="tfplan"
                        '''
                    }
                }
            }
        }


        stage('35 - Terraform Apply') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh '''
                            set -e

                            if [ ! -f tfplan ]; then

                                echo "ERROR: tfplan not found."

                                exit 1

                            fi

                            terraform apply \
                                -input=false \
                                -auto-approve \
                                tfplan
                        '''
                    }
                }
            }
        }


        stage('36 - Terraform Deployment Verification') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh '''
                            set -e

                            echo "Terraform state:"
                            terraform state list || true

                            echo ""
                            echo "Terraform outputs:"
                            terraform output || true

                            echo ""
                            echo "AWS identity:"

                            aws sts get-caller-identity \
                                --region "${AWS_DEFAULT_REGION}"

                            echo ""
                            echo "Terraform deployment verification completed."
                        '''
                    }
                }
            }
        }


        // ============================================================
        // PART 6 - ECS FARGATE + ALB
        // ============================================================

        stage('37 - Discover AWS Network') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        echo '================================================'
                        echo 'DISCOVERING AWS NETWORK'
                        echo '================================================'


                        def vpcId = sh(
                            script: '''
                                set -e

                                VPC_ID=$(aws ec2 describe-vpcs \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --filters \
                                        "Name=tag:Environment,Values=${ENVIRONMENT}" \
                                    --query 'Vpcs[0].VpcId' \
                                    --output text)

                                if [ "${VPC_ID}" = "None" ] || [ -z "${VPC_ID}" ]; then

                                    VPC_ID=$(aws ec2 describe-vpcs \
                                        --region "${AWS_DEFAULT_REGION}" \
                                        --filters \
                                            "Name=is-default,Values=true" \
                                        --query 'Vpcs[0].VpcId' \
                                        --output text)

                                fi

                                if [ "${VPC_ID}" = "None" ] || [ -z "${VPC_ID}" ]; then

                                    echo "ERROR: No VPC found."

                                    exit 1

                                fi

                                echo "${VPC_ID}"
                            ''',
                            returnStdout: true
                        ).trim()


                        env.VPC_ID = vpcId


                        def subnetOutput = sh(
                            script: '''
                                set -e

                                aws ec2 describe-subnets \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --filters \
                                        "Name=vpc-id,Values=${VPC_ID}" \
                                        "Name=map-public-ip-on-launch,Values=true" \
                                    --query 'Subnets[].SubnetId' \
                                    --output text
                            ''',
                            returnStdout: true
                        ).trim()


                        if (
                            !subnetOutput ||
                            subnetOutput == 'None'
                        ) {

                            error(
                                "No public subnets found in VPC ${env.VPC_ID}."
                            )
                        }


                        def subnetList = subnetOutput.split("\\s+")


                        if (subnetList.size() < 2) {

                            error(
                                "At least 2 public subnets are required. " +
                                "Found: ${subnetOutput}"
                            )
                        }


                        env.SUBNET_1 = subnetList[0]
                        env.SUBNET_2 = subnetList[1]


                        echo "VPC ID  : ${env.VPC_ID}"
                        echo "Subnet 1: ${env.SUBNET_1}"
                        echo "Subnet 2: ${env.SUBNET_2}"
                    }
                }
            }
        }


        stage('38 - Create IAM Roles for ECS') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "CREATING ECS IAM ROLES"
                        echo "================================================"

                        EXECUTION_ROLE_NAME="practice1-ecsTaskExecutionRole"

                        if aws iam get-role \
                            --role-name "${EXECUTION_ROLE_NAME}" \
                            > /dev/null 2>&1
                        then

                            echo "ECS execution role already exists."

                        else

                            cat > /tmp/ecs-trust-policy.json <<'EOF'
{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
            },
            "Action": "sts:AssumeRole"
        }
    ]
}
EOF

                            aws iam create-role \
                                --role-name "${EXECUTION_ROLE_NAME}" \
                                --assume-role-policy-document \
                                file:///tmp/ecs-trust-policy.json

                        fi


                        aws iam attach-role-policy \
                            --role-name "${EXECUTION_ROLE_NAME}" \
                            --policy-arn \
                            arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy \
                            || true


                        EXECUTION_ROLE_ARN=$(aws iam get-role \
                            --role-name "${EXECUTION_ROLE_NAME}" \
                            --query 'Role.Arn' \
                            --output text)


                        echo "ECS Execution Role:"
                        echo "${EXECUTION_ROLE_ARN}"

                        echo "${EXECUTION_ROLE_ARN}" > ecs_execution_role_arn.txt
                    '''
                }
            }
        }


        stage('39 - Create Security Groups') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        def albSgId = sh(
                            script: '''
                                set -e

                                ALB_SG_ID=$(aws ec2 describe-security-groups \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --filters \
                                        "Name=vpc-id,Values=${VPC_ID}" \
                                        "Name=group-name,Values=${ALB_SG_NAME}" \
                                    --query 'SecurityGroups[0].GroupId' \
                                    --output text)

                                if [ "${ALB_SG_ID}" = "None" ] || [ -z "${ALB_SG_ID}" ]; then

                                    ALB_SG_ID=$(aws ec2 create-security-group \
                                        --region "${AWS_DEFAULT_REGION}" \
                                        --group-name "${ALB_SG_NAME}" \
                                        --description "ALB security group for ${APP_NAME}" \
                                        --vpc-id "${VPC_ID}" \
                                        --query 'GroupId' \
                                        --output text)

                                fi

                                echo "${ALB_SG_ID}"
                            ''',
                            returnStdout: true
                        ).trim()


                        def ecsSgId = sh(
                            script: '''
                                set -e

                                ECS_SG_ID=$(aws ec2 describe-security-groups \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --filters \
                                        "Name=vpc-id,Values=${VPC_ID}" \
                                        "Name=group-name,Values=${ECS_SG_NAME}" \
                                    --query 'SecurityGroups[0].GroupId' \
                                    --output text)

                                if [ "${ECS_SG_ID}" = "None" ] || [ -z "${ECS_SG_ID}" ]; then

                                    ECS_SG_ID=$(aws ec2 create-security-group \
                                        --region "${AWS_DEFAULT_REGION}" \
                                        --group-name "${ECS_SG_NAME}" \
                                        --description "ECS Fargate security group for ${APP_NAME}" \
                                        --vpc-id "${VPC_ID}" \
                                        --query 'GroupId' \
                                        --output text)

                                fi

                                echo "${ECS_SG_ID}"
                            ''',
                            returnStdout: true
                        ).trim()


                        env.ALB_SG_ID = albSgId
                        env.ECS_SG_ID = ecsSgId


                        sh '''
                            set -e

                            echo "ALB SG: ${ALB_SG_ID}"
                            echo "ECS SG: ${ECS_SG_ID}"

                            aws ec2 authorize-security-group-ingress \
                                --region "${AWS_DEFAULT_REGION}" \
                                --group-id "${ALB_SG_ID}" \
                                --ip-permissions \
                                    'IpProtocol=tcp,FromPort=80,ToPort=80,IpRanges=[{CidrIp=0.0.0.0/0}]' \
                                2>/dev/null || true


                            aws ec2 authorize-security-group-ingress \
                                --region "${AWS_DEFAULT_REGION}" \
                                --group-id "${ECS_SG_ID}" \
                                --ip-permissions \
                                    "IpProtocol=tcp,FromPort=${CONTAINER_PORT},ToPort=${CONTAINER_PORT},UserIdGroupPairs=[{GroupId=${ALB_SG_ID}}]" \
                                2>/dev/null || true


                            aws ec2 authorize-security-group-egress \
                                --region "${AWS_DEFAULT_REGION}" \
                                --group-id "${ECS_SG_ID}" \
                                --ip-permissions \
                                    'IpProtocol=-1,IpRanges=[{CidrIp=0.0.0.0/0}]' \
                                2>/dev/null || true


                            echo "Security groups ready."
                        '''
                    }
                }
            }
        }


        stage('40 - Create Application Load Balancer') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        def albArn = sh(
                            script: '''
                                aws elbv2 describe-load-balancers \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --names "${ALB_NAME}" \
                                    --query 'LoadBalancers[0].LoadBalancerArn' \
                                    --output text 2>/dev/null || true
                            ''',
                            returnStdout: true
                        ).trim()


                        if (!albArn || albArn == 'None') {

                            albArn = sh(
                                script: '''
                                    aws elbv2 create-load-balancer \
                                        --region "${AWS_DEFAULT_REGION}" \
                                        --name "${ALB_NAME}" \
                                        --subnets "${SUBNET_1}" "${SUBNET_2}" \
                                        --security-groups "${ALB_SG_ID}" \
                                        --scheme internet-facing \
                                        --type application \
                                        --ip-address-type ipv4 \
                                        --query 'LoadBalancers[0].LoadBalancerArn' \
                                        --output text
                                ''',
                                returnStdout: true
                            ).trim()
                        }


                        env.ALB_ARN = albArn


                        sh '''
                            set -e

                            aws elbv2 wait load-balancer-available \
                                --region "${AWS_DEFAULT_REGION}" \
                                --load-balancer-arns "${ALB_ARN}"
                        '''


                        def albDns = sh(
                            script: '''
                                aws elbv2 describe-load-balancers \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --load-balancer-arns "${ALB_ARN}" \
                                    --query 'LoadBalancers[0].DNSName' \
                                    --output text
                            ''',
                            returnStdout: true
                        ).trim()


                        env.ALB_DNS = albDns


                        echo "ALB ARN : ${env.ALB_ARN}"
                        echo "ALB DNS : ${env.ALB_DNS}"
                    }
                }
            }
        }


        stage('41 - Create Target Group') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        def targetGroupArn = sh(
                            script: '''
                                aws elbv2 describe-target-groups \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --names "${TARGET_GROUP_NAME}" \
                                    --query 'TargetGroups[0].TargetGroupArn' \
                                    --output text 2>/dev/null || true
                            ''',
                            returnStdout: true
                        ).trim()


                        if (!targetGroupArn || targetGroupArn == 'None') {

                            targetGroupArn = sh(
                                script: '''
                                    aws elbv2 create-target-group \
                                        --region "${AWS_DEFAULT_REGION}" \
                                        --name "${TARGET_GROUP_NAME}" \
                                        --protocol HTTP \
                                        --port "${CONTAINER_PORT}" \
                                        --target-type ip \
                                        --vpc-id "${VPC_ID}" \
                                        --health-check-protocol HTTP \
                                        --health-check-path "${HEALTH_PATH}" \
                                        --health-check-port traffic-port \
                                        --matcher HttpCode=200-399 \
                                        --query 'TargetGroups[0].TargetGroupArn' \
                                        --output text
                                ''',
                                returnStdout: true
                            ).trim()
                        }


                        env.TARGET_GROUP_ARN = targetGroupArn


                        echo "Target Group ARN:"
                        echo "${env.TARGET_GROUP_ARN}"
                    }
                }
            }
        }


        stage('42 - Create ALB Listener') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        LISTENER_ARN=$(aws elbv2 describe-listeners \
                            --region "${AWS_DEFAULT_REGION}" \
                            --load-balancer-arn "${ALB_ARN}" \
                            --query 'Listeners[?Port==`80`].ListenerArn | [0]' \
                            --output text)


                        if [ "${LISTENER_ARN}" = "None" ] || [ -z "${LISTENER_ARN}" ]; then

                            echo "Creating HTTP listener..."

                            aws elbv2 create-listener \
                                --region "${AWS_DEFAULT_REGION}" \
                                --load-balancer-arn "${ALB_ARN}" \
                                --protocol HTTP \
                                --port 80 \
                                --default-actions \
                                    Type=forward,TargetGroupArn="${TARGET_GROUP_ARN}"

                        else

                            echo "HTTP listener already exists."

                            aws elbv2 modify-listener \
                                --region "${AWS_DEFAULT_REGION}" \
                                --listener-arn "${LISTENER_ARN}" \
                                --default-actions \
                                    Type=forward,TargetGroupArn="${TARGET_GROUP_ARN}"

                        fi
                    '''
                }
            }
        }


        // ============================================================
        // IMPORTANT ECS CLUSTER CORRECTION
        // ============================================================

        stage('43 - Ensure ECS Cluster Exists and Is ACTIVE') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "ENSURING ECS CLUSTER"
                        echo "================================================"

                        echo "Cluster: ${ECS_CLUSTER}"
                        echo "Region : ${AWS_DEFAULT_REGION}"


                        CLUSTER_STATUS=$(aws ecs describe-clusters \
                            --region "${AWS_DEFAULT_REGION}" \
                            --clusters "${ECS_CLUSTER}" \
                            --query 'clusters[0].status' \
                            --output text 2>/dev/null || true)


                        echo "Current cluster status: ${CLUSTER_STATUS}"


                        if [ "${CLUSTER_STATUS}" = "ACTIVE" ]; then

                            echo "ECS cluster already exists and is ACTIVE."

                        else

                            echo "ECS cluster is missing or inactive."
                            echo "Creating ECS cluster..."


                            aws ecs create-cluster \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster-name "${ECS_CLUSTER}" \
                                --settings name=containerInsights,value=enabled \
                                2>/dev/null || true

                        fi


                        echo ""
                        echo "Waiting for ECS cluster to become ACTIVE..."


                        CLUSTER_READY=false


                        for i in $(seq 1 30)
                        do

                            STATUS=$(aws ecs describe-clusters \
                                --region "${AWS_DEFAULT_REGION}" \
                                --clusters "${ECS_CLUSTER}" \
                                --query 'clusters[0].status' \
                                --output text 2>/dev/null || true)


                            echo "Attempt ${i}/30 - Cluster status: ${STATUS}"


                            if [ "${STATUS}" = "ACTIVE" ]; then

                                CLUSTER_READY=true

                                break

                            fi


                            sleep 5

                        done


                        if [ "${CLUSTER_READY}" != "true" ]; then

                            echo ""
                            echo "ERROR: ECS cluster did not become ACTIVE."

                            exit 1

                        fi


                        echo ""
                        echo "ECS cluster is ACTIVE."


                        aws ecs describe-clusters \
                            --region "${AWS_DEFAULT_REGION}" \
                            --clusters "${ECS_CLUSTER}" \
                            --query 'clusters[0].{Name:clusterName,Status:status,Arn:clusterArn,Running:runningTasksCount,Pending:pendingTasksCount,Services:activeServicesCount}' \
                            --output table


                        echo "${ECS_CLUSTER}" > ecs_cluster_name.txt
                    '''
                }
            }
        }


        // ============================================================
        // TASK DEFINITION
        // ============================================================

        stage('44 - Register ECS Fargate Task Definition') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        sh '''
                            set -e

                            echo "================================================"
                            echo "REGISTERING ECS FARGATE TASK DEFINITION"
                            echo "================================================"


                            EXECUTION_ROLE_ARN=$(cat ecs_execution_role_arn.txt)


                            if [ -z "${EXECUTION_ROLE_ARN}" ]; then

                                echo "ERROR: ECS execution role ARN is empty."

                                exit 1

                            fi


                            echo "Execution role:"
                            echo "${EXECUTION_ROLE_ARN}"


                            cat > task-definition.json <<EOF
{
    "family": "${ECS_TASK_FAMILY}",
    "networkMode": "awsvpc",
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "${FARGATE_CPU}",
    "memory": "${FARGATE_MEMORY}",
    "executionRoleArn": "${EXECUTION_ROLE_ARN}",
    "containerDefinitions": [
        {
            "name": "${ECS_CONTAINER_NAME}",
            "image": "${ECR_IMAGE}",
            "essential": true,
            "portMappings": [
                {
                    "containerPort": ${CONTAINER_PORT},
                    "hostPort": ${CONTAINER_PORT},
                    "protocol": "tcp"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/${ECS_TASK_FAMILY}",
                    "awslogs-region": "${AWS_DEFAULT_REGION}",
                    "awslogs-stream-prefix": "ecs"
                }
            }
        }
    ]
}
EOF


                            python3 -m json.tool task-definition.json > /dev/null


                            aws logs create-log-group \
                                --log-group-name "/ecs/${ECS_TASK_FAMILY}" \
                                --region "${AWS_DEFAULT_REGION}" \
                                2>/dev/null || true


                            aws ecs register-task-definition \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cli-input-json file://task-definition.json \
                                > task-definition-registration.json


                            TASK_DEFINITION_ARN=$(aws ecs describe-task-definition \
                                --region "${AWS_DEFAULT_REGION}" \
                                --task-definition "${ECS_TASK_FAMILY}" \
                                --query 'taskDefinition.taskDefinitionArn' \
                                --output text)


                            if [ -z "${TASK_DEFINITION_ARN}" ] || [ "${TASK_DEFINITION_ARN}" = "None" ]; then

                                echo "ERROR: Task definition ARN was not returned."

                                exit 1

                            fi


                            echo "Task Definition:"
                            echo "${TASK_DEFINITION_ARN}"


                            echo "${TASK_DEFINITION_ARN}" > task_definition_arn.txt
                        '''


                        env.TASK_DEFINITION_ARN =
                            readFile(
                                file: 'task_definition_arn.txt'
                            ).trim()


                        echo "TASK_DEFINITION_ARN=${env.TASK_DEFINITION_ARN}"
                    }
                }
            }
        }


        // ============================================================
        // SECURITY GROUP VALIDATION
        // ============================================================

        stage('45 - Validate ECS Security Group') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "VALIDATING ECS SECURITY GROUP"
                        echo "================================================"


                        if [ -z "${ECS_SG_ID}" ] || [ "${ECS_SG_ID}" = "None" ]; then

                            echo "ERROR: ECS_SG_ID is empty."

                            exit 1

                        fi


                        SG_EXISTS=$(aws ec2 describe-security-groups \
                            --region "${AWS_DEFAULT_REGION}" \
                            --group-ids "${ECS_SG_ID}" \
                            --query 'SecurityGroups[0].GroupId' \
                            --output text 2>/dev/null || true)


                        if [ -z "${SG_EXISTS}" ] || [ "${SG_EXISTS}" = "None" ]; then

                            echo "ERROR: ECS security group does not exist:"
                            echo "${ECS_SG_ID}"

                            exit 1

                        fi


                        SG_VPC_ID=$(aws ec2 describe-security-groups \
                            --region "${AWS_DEFAULT_REGION}" \
                            --group-ids "${ECS_SG_ID}" \
                            --query 'SecurityGroups[0].VpcId' \
                            --output text)


                        if [ "${SG_VPC_ID}" != "${VPC_ID}" ]; then

                            echo "ERROR: ECS security group is in wrong VPC."
                            echo "Expected: ${VPC_ID}"
                            echo "Actual  : ${SG_VPC_ID}"

                            exit 1

                        fi


                        SG_NAME=$(aws ec2 describe-security-groups \
                            --region "${AWS_DEFAULT_REGION}" \
                            --group-ids "${ECS_SG_ID}" \
                            --query 'SecurityGroups[0].GroupName' \
                            --output text)


                        echo ""
                        echo "ECS Security Group:"
                        echo "ID   : ${ECS_SG_ID}"
                        echo "Name : ${SG_NAME}"
                        echo "VPC  : ${SG_VPC_ID}"


                        echo "${ECS_SG_ID}" > ecs_security_group_id.txt


                        echo ""
                        echo "ECS security group validation PASSED."
                    '''
                }
            }
        }


        // ============================================================
        // CREATE / UPDATE ECS SERVICE
        // ============================================================

        stage('46 - Create or Update ECS Fargate Service') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "DEPLOYING ECS FARGATE SERVICE"
                        echo "================================================"


                        ECS_SECURITY_GROUP_ID=$(cat ecs_security_group_id.txt)

                        TASK_DEFINITION_ARN=$(cat task_definition_arn.txt)


                        echo "Cluster          : ${ECS_CLUSTER}"
                        echo "Service          : ${ECS_SERVICE}"
                        echo "Task Definition  : ${TASK_DEFINITION_ARN}"
                        echo "Security Group   : ${ECS_SECURITY_GROUP_ID}"
                        echo "Subnet 1         : ${SUBNET_1}"
                        echo "Subnet 2         : ${SUBNET_2}"
                        echo "Target Group     : ${TARGET_GROUP_ARN}"


                        # ------------------------------------------------
                        # Verify cluster
                        # ------------------------------------------------

                        CLUSTER_STATUS=$(aws ecs describe-clusters \
                            --region "${AWS_DEFAULT_REGION}" \
                            --clusters "${ECS_CLUSTER}" \
                            --query 'clusters[0].status' \
                            --output text)


                        if [ "${CLUSTER_STATUS}" != "ACTIVE" ]; then

                            echo "ERROR: ECS cluster is not ACTIVE."

                            exit 1

                        fi


                        # ------------------------------------------------
                        # Verify security group
                        # ------------------------------------------------

                        aws ec2 describe-security-groups \
                            --region "${AWS_DEFAULT_REGION}" \
                            --group-ids "${ECS_SECURITY_GROUP_ID}" \
                            > /dev/null


                        # ------------------------------------------------
                        # Verify subnets
                        # ------------------------------------------------

                        for SUBNET in "${SUBNET_1}" "${SUBNET_2}"
                        do

                            SUBNET_STATE=$(aws ec2 describe-subnets \
                                --region "${AWS_DEFAULT_REGION}" \
                                --subnet-ids "${SUBNET}" \
                                --query 'Subnets[0].State' \
                                --output text)


                            echo "Subnet ${SUBNET}: ${SUBNET_STATE}"


                            if [ "${SUBNET_STATE}" != "available" ]; then

                                echo "ERROR: Subnet ${SUBNET} is not available."

                                exit 1

                            fi

                        done


                        # ------------------------------------------------
                        # Verify target group
                        # ------------------------------------------------

                        aws elbv2 describe-target-groups \
                            --region "${AWS_DEFAULT_REGION}" \
                            --target-group-arns "${TARGET_GROUP_ARN}" \
                            > /dev/null


                        # ------------------------------------------------
                        # Verify task definition
                        # ------------------------------------------------

                        TASK_STATUS=$(aws ecs describe-task-definition \
                            --region "${AWS_DEFAULT_REGION}" \
                            --task-definition "${TASK_DEFINITION_ARN}" \
                            --query 'taskDefinition.status' \
                            --output text)


                        if [ "${TASK_STATUS}" != "ACTIVE" ]; then

                            echo "ERROR: Task definition is not ACTIVE."

                            exit 1

                        fi


                        # ------------------------------------------------
                        # Check existing service
                        # ------------------------------------------------

                        SERVICE_STATUS=$(aws ecs describe-services \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}" \
                            --query 'services[0].status' \
                            --output text 2>/dev/null || true)


                        echo ""
                        echo "Existing service status: ${SERVICE_STATUS}"


                        if [ "${SERVICE_STATUS}" = "ACTIVE" ]; then

                            echo ""
                            echo "Existing ECS service found."
                            echo "Updating service..."


                            aws ecs update-service \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --service "${ECS_SERVICE}" \
                                --task-definition "${TASK_DEFINITION_ARN}" \
                                --desired-count 1 \
                                --force-new-deployment


                            echo "ECS service update submitted."

                        else

                            echo ""
                            echo "ECS service does not exist."
                            echo "Creating ECS service..."


                            aws ecs create-service \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --service-name "${ECS_SERVICE}" \
                                --task-definition "${TASK_DEFINITION_ARN}" \
                                --desired-count 1 \
                                --launch-type FARGATE \
                                --platform-version LATEST \
                                --network-configuration \
                                    "awsvpcConfiguration={subnets=[${SUBNET_1},${SUBNET_2}],securityGroups=[${ECS_SECURITY_GROUP_ID}],assignPublicIp=ENABLED}" \
                                --load-balancers \
                                    "targetGroupArn=${TARGET_GROUP_ARN},containerName=${ECS_CONTAINER_NAME},containerPort=${CONTAINER_PORT}"


                            echo "ECS service creation submitted."

                        fi
                    '''
                }
            }
        }


        // ============================================================
        // WAIT FOR SERVICE
        // ============================================================

        stage('47 - Wait for ECS Service Stability') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "WAITING FOR ECS SERVICE STABILITY"
                        echo "================================================"


                        aws ecs wait services-stable \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}"


                        echo ""
                        echo "ECS service reached stable state."


                        aws ecs describe-services \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}" \
                            --query 'services[0].{Service:serviceName,Status:status,Desired:desiredCount,Running:runningCount,Pending:pendingCount,TaskDefinition:taskDefinition}' \
                            --output table
                    '''
                }
            }
        }


        // ============================================================
        // VERIFY RUNNING TASK
        // ============================================================

        stage('48 - Verify ECS Running Task') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "VERIFYING ECS FARGATE TASK"
                        echo "================================================"


                        TASK_ARN=""


                        for i in $(seq 1 30)
                        do

                            TASK_ARN=$(aws ecs list-tasks \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --service-name "${ECS_SERVICE}" \
                                --desired-status RUNNING \
                                --query 'taskArns[0]' \
                                --output text)


                            echo "Attempt ${i}/30: ${TASK_ARN}"


                            if [ -n "${TASK_ARN}" ] && [ "${TASK_ARN}" != "None" ]; then

                                break

                            fi


                            sleep 10

                        done


                        if [ -z "${TASK_ARN}" ] || [ "${TASK_ARN}" = "None" ]; then

                            echo "ERROR: No RUNNING ECS task found."

                            exit 1

                        fi


                        echo ""
                        echo "Running Task:"
                        echo "${TASK_ARN}"


                        echo "${TASK_ARN}" > running_task_arn.txt


                        TASK_STATUS=$(aws ecs describe-tasks \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --tasks "${TASK_ARN}" \
                            --query 'tasks[0].lastStatus' \
                            --output text)


                        if [ "${TASK_STATUS}" != "RUNNING" ]; then

                            echo "ERROR: ECS task is not RUNNING."

                            exit 1

                        fi


                        CONTAINER_STATUS=$(aws ecs describe-tasks \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --tasks "${TASK_ARN}" \
                            --query "tasks[0].containers[?name=='${ECS_CONTAINER_NAME}'].lastStatus | [0]" \
                            --output text)


                        if [ "${CONTAINER_STATUS}" != "RUNNING" ]; then

                            echo "ERROR: Container is not RUNNING."

                            exit 1

                        fi


                        aws ecs describe-tasks \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --tasks "${TASK_ARN}" \
                            --query 'tasks[0].{TaskArn:taskArn,LastStatus:lastStatus,DesiredStatus:desiredStatus,Health:healthStatus}' \
                            --output table


                        echo ""
                        echo "ECS TASK: RUNNING"
                        echo "CONTAINER: RUNNING"
                    '''
                }
            }
        }


        // ============================================================
        // GET TASK IP + ALB HEALTH
        // ============================================================

        stage('49 - Wait for ALB Target Health') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "WAITING FOR ALB TARGET HEALTH"
                        echo "================================================"


                        TASK_ARN=$(cat running_task_arn.txt)


                        TASK_IP=""


                        for i in $(seq 1 30)
                        do

                            TASK_IP=$(aws ecs describe-tasks \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --tasks "${TASK_ARN}" \
                                --query 'tasks[0].attachments[0].details[?name==`privateIPv4Address`].value' \
                                --output text)


                            echo "Task IP attempt ${i}/30: ${TASK_IP}"


                            if [ -n "${TASK_IP}" ] && [ "${TASK_IP}" != "None" ]; then

                                break

                            fi


                            sleep 5

                        done


                        if [ -z "${TASK_IP}" ] || [ "${TASK_IP}" = "None" ]; then

                            echo "ERROR: Could not determine Fargate task IP."

                            exit 1

                        fi


                        echo ""
                        echo "Fargate Task IP:"
                        echo "${TASK_IP}"


                        echo "${TASK_IP}" > running_task_ip.txt


                        TARGET_HEALTHY=false


                        for i in $(seq 1 36)
                        do

                            echo ""
                            echo "ALB health attempt ${i}/36"


                            HEALTH=$(aws elbv2 describe-target-health \
                                --region "${AWS_DEFAULT_REGION}" \
                                --target-group-arn "${TARGET_GROUP_ARN}" \
                                --targets Id="${TASK_IP}" \
                                --query 'TargetHealthDescriptions[0].TargetHealth.State' \
                                --output text \
                                2>/dev/null || true)


                            echo "Target health: ${HEALTH}"


                            if [ "${HEALTH}" = "healthy" ]; then

                                TARGET_HEALTHY=true

                                break

                            fi


                            aws elbv2 describe-target-health \
                                --region "${AWS_DEFAULT_REGION}" \
                                --target-group-arn "${TARGET_GROUP_ARN}" \
                                --targets Id="${TASK_IP}" \
                                --query 'TargetHealthDescriptions[0].{Target:Target.Id,Port:Target.Port,State:TargetHealth.State,Reason:TargetHealth.Reason,Description:TargetHealth.Description}' \
                                --output table \
                                2>/dev/null || true


                            sleep 10

                        done


                        if [ "${TARGET_HEALTHY}" != "true" ]; then

                            echo ""
                            echo "ERROR: ALB target did not become healthy."


                            echo ""
                            echo "Detailed target health:"


                            aws elbv2 describe-target-health \
                                --region "${AWS_DEFAULT_REGION}" \
                                --target-group-arn "${TARGET_GROUP_ARN}" \
                                --output table \
                                || true


                            exit 1

                        fi


                        echo ""
                        echo "ALB TARGET: HEALTHY"
                    '''
                }
            }
        }


        // ============================================================
        // ALB DNS
        // ============================================================

        stage('50 - Verify ALB DNS') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        def albDns = sh(
                            script: '''
                                aws elbv2 describe-load-balancers \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --load-balancer-arns "${ALB_ARN}" \
                                    --query 'LoadBalancers[0].DNSName' \
                                    --output text
                            ''',
                            returnStdout: true
                        ).trim()


                        if (!albDns || albDns == 'None') {

                            error(
                                "Could not retrieve ALB DNS name."
                            )
                        }


                        env.ALB_DNS = albDns

                        env.APPLICATION_URL =
                            "http://${albDns}"


                        echo "ALB DNS:"
                        echo "${env.ALB_DNS}"


                        echo ""
                        echo "Application URL:"
                        echo "${env.APPLICATION_URL}"
                    }
                }
            }
        }


        // ============================================================
        // HTTP HEALTH CHECK
        // ============================================================

        stage('51 - HTTP Application Health Check') {

            steps {

                sh '''
                    set -e

                    echo "================================================"
                    echo "FINAL HTTP APPLICATION HEALTH CHECK"
                    echo "================================================"


                    APPLICATION_URL="${APPLICATION_URL}${HEALTH_PATH}"


                    echo ""
                    echo "URL:"
                    echo "${APPLICATION_URL}"


                    HTTP_OK=false


                    for i in $(seq 1 30)
                    do

                        echo ""
                        echo "HTTP check ${i}/30"


                        HTTP_CODE=$(curl \
                            --connect-timeout 10 \
                            --max-time 20 \
                            --silent \
                            --show-error \
                            --output /tmp/application_response.txt \
                            --write-out "%{http_code}" \
                            "${APPLICATION_URL}" \
                            || true)


                        echo "HTTP status: ${HTTP_CODE}"


                        case "${HTTP_CODE}" in

                            2??|3??)

                                HTTP_OK=true

                                break
                                ;;

                            *)

                                echo "Application not healthy yet."

                                sleep 10
                                ;;

                        esac

                    done


                    if [ "${HTTP_OK}" != "true" ]; then

                        echo ""
                        echo "ERROR: Application HTTP health check failed."


                        echo ""
                        echo "Response body:"


                        cat /tmp/application_response.txt \
                            2>/dev/null \
                            || true


                        exit 1

                    fi


                    echo ""
                    echo "APPLICATION HTTP HEALTH CHECK: PASSED"
                '''
            }
        }


        // ============================================================
        // FINAL DEPLOYMENT VERIFICATION
        // ============================================================

        stage('52 - Final Deployment Verification') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo ""
                        echo "================================================"
                        echo "        FINAL DEPLOYMENT VERIFICATION"
                        echo "================================================"


                        TASK_ARN=$(cat running_task_arn.txt)
                        TASK_IP=$(cat running_task_ip.txt)
                        ECS_SECURITY_GROUP_ID=$(cat ecs_security_group_id.txt)
                        TASK_DEFINITION_ARN=$(cat task_definition_arn.txt)


                        SERVICE_STATUS=$(aws ecs describe-services \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}" \
                            --query 'services[0].status' \
                            --output text)


                        RUNNING_COUNT=$(aws ecs describe-services \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}" \
                            --query 'services[0].runningCount' \
                            --output text)


                        DESIRED_COUNT=$(aws ecs describe-services \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}" \
                            --query 'services[0].desiredCount' \
                            --output text)


                        CLUSTER_STATUS=$(aws ecs describe-clusters \
                            --region "${AWS_DEFAULT_REGION}" \
                            --clusters "${ECS_CLUSTER}" \
                            --query 'clusters[0].status' \
                            --output text)


                        TARGET_HEALTH=$(aws elbv2 describe-target-health \
                            --region "${AWS_DEFAULT_REGION}" \
                            --target-group-arn "${TARGET_GROUP_ARN}" \
                            --targets Id="${TASK_IP}" \
                            --query 'TargetHealthDescriptions[0].TargetHealth.State' \
                            --output text \
                            2>/dev/null || true)


                        echo ""
                        echo "AWS Region:"
                        echo "${AWS_DEFAULT_REGION}"


                        echo ""
                        echo "ECR Image:"
                        echo "${ECR_IMAGE}"


                        echo ""
                        echo "ECS Cluster:"
                        echo "${ECS_CLUSTER}"


                        echo ""
                        echo "Cluster Status:"
                        echo "${CLUSTER_STATUS}"


                        echo ""
                        echo "ECS Service:"
                        echo "${ECS_SERVICE}"


                        echo ""
                        echo "Service Status:"
                        echo "${SERVICE_STATUS}"


                        echo ""
                        echo "Desired Count:"
                        echo "${DESIRED_COUNT}"


                        echo ""
                        echo "Running Count:"
                        echo "${RUNNING_COUNT}"


                        echo ""
                        echo "Task Definition:"
                        echo "${TASK_DEFINITION_ARN}"


                        echo ""
                        echo "Running Task:"
                        echo "${TASK_ARN}"


                        echo ""
                        echo "Task IP:"
                        echo "${TASK_IP}"


                        echo ""
                        echo "ECS Security Group:"
                        echo "${ECS_SECURITY_GROUP_ID}"


                        echo ""
                        echo "ALB:"
                        echo "${ALB_NAME}"


                        echo ""
                        echo "Target Group:"
                        echo "${TARGET_GROUP_NAME}"


                        echo ""
                        echo "Target Health:"
                        echo "${TARGET_HEALTH}"


                        echo ""
                        echo "Application URL:"
                        echo "${APPLICATION_URL}"


                        if [ "${CLUSTER_STATUS}" != "ACTIVE" ]; then
                            echo "ERROR: Cluster verification failed."
                            exit 1
                        fi


                        if [ "${SERVICE_STATUS}" != "ACTIVE" ]; then
                            echo "ERROR: Service verification failed."
                            exit 1
                        fi


                        if [ "${RUNNING_COUNT}" -lt 1 ]; then
                            echo "ERROR: No running task."
                            exit 1
                        fi


                        if [ "${TARGET_HEALTH}" != "healthy" ]; then
                            echo "ERROR: ALB target is not healthy."
                            exit 1
                        fi


                        echo ""
                        echo "================================================"
                        echo "       DEPLOYMENT VERIFICATION PASSED"
                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // PART 7 - POST DEPLOYMENT HEALTH CHECK
        // ============================================================

        stage('53 - Part 7 - Wait for Application Startup') {

            steps {

                echo '================================================'
                echo 'PART 7 - POST DEPLOYMENT HEALTH CHECK'
                echo '================================================'

                echo 'Giving the application additional startup time...'

                sleep(
                    time: 20,
                    unit: 'SECONDS'
                )
            }
        }


        stage('54 - Part 7 - Verify ECS Service') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "PART 7 - VERIFYING ECS SERVICE"
                        echo "================================================"


                        SERVICE_STATUS=$(aws ecs describe-services \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}" \
                            --query 'services[0].status' \
                            --output text)


                        RUNNING_COUNT=$(aws ecs describe-services \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}" \
                            --query 'services[0].runningCount' \
                            --output text)


                        DESIRED_COUNT=$(aws ecs describe-services \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}" \
                            --query 'services[0].desiredCount' \
                            --output text)


                        echo ""
                        echo "ECS Service Status : ${SERVICE_STATUS}"
                        echo "Desired Count      : ${DESIRED_COUNT}"
                        echo "Running Count      : ${RUNNING_COUNT}"


                        if [ "${SERVICE_STATUS}" != "ACTIVE" ]; then

                            echo "ERROR: ECS service is not ACTIVE."

                            exit 1

                        fi


                        if [ "${RUNNING_COUNT}" -lt 1 ]; then

                            echo "ERROR: ECS service has no running task."

                            exit 1

                        fi


                        if [ "${RUNNING_COUNT}" -lt "${DESIRED_COUNT}" ]; then

                            echo "ERROR: Running task count is lower than desired count."

                            exit 1

                        fi


                        echo ""
                        echo "ECS SERVICE CHECK: PASSED"
                    '''
                }
            }
        }


        stage('55 - Part 7 - Verify Running Task and Container') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "PART 7 - VERIFYING TASK AND CONTAINER"
                        echo "================================================"


                        TASK_ARN=$(aws ecs list-tasks \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --service-name "${ECS_SERVICE}" \
                            --desired-status RUNNING \
                            --query 'taskArns[0]' \
                            --output text)


                        if [ -z "${TASK_ARN}" ] || [ "${TASK_ARN}" = "None" ]; then

                            echo "ERROR: No RUNNING ECS task found."

                            exit 1

                        fi


                        TASK_STATUS=$(aws ecs describe-tasks \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --tasks "${TASK_ARN}" \
                            --query 'tasks[0].lastStatus' \
                            --output text)


                        CONTAINER_STATUS=$(aws ecs describe-tasks \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --tasks "${TASK_ARN}" \
                            --query "tasks[0].containers[?name=='${ECS_CONTAINER_NAME}'].lastStatus | [0]" \
                            --output text)


                        echo ""
                        echo "Task ARN:"
                        echo "${TASK_ARN}"


                        echo ""
                        echo "Task Status:"
                        echo "${TASK_STATUS}"


                        echo ""
                        echo "Container Name:"
                        echo "${ECS_CONTAINER_NAME}"


                        echo ""
                        echo "Container Status:"
                        echo "${CONTAINER_STATUS}"


                        if [ "${TASK_STATUS}" != "RUNNING" ]; then

                            echo "ERROR: ECS task is not RUNNING."

                            exit 1

                        fi


                        if [ "${CONTAINER_STATUS}" != "RUNNING" ]; then

                            echo "ERROR: Application container is not RUNNING."

                            exit 1

                        fi


                        echo ""
                        echo "TASK CHECK      : PASSED"
                        echo "CONTAINER CHECK : PASSED"
                    '''
                }
            }
        }


        stage('56 - Part 7 - Verify ALB Target Health') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "PART 7 - VERIFYING LOAD BALANCER HEALTH"
                        echo "================================================"


                        TASK_IP=$(cat running_task_ip.txt)


                        HEALTH=""


                        for i in $(seq 1 30)
                        do

                            HEALTH=$(aws elbv2 describe-target-health \
                                --region "${AWS_DEFAULT_REGION}" \
                                --target-group-arn "${TARGET_GROUP_ARN}" \
                                --targets Id="${TASK_IP}" \
                                --query 'TargetHealthDescriptions[0].TargetHealth.State' \
                                --output text \
                                2>/dev/null || true)


                            echo ""
                            echo "ALB health attempt ${i}/30: ${HEALTH}"


                            if [ "${HEALTH}" = "healthy" ]; then

                                echo ""
                                echo "ALB TARGET HEALTH: PASSED"

                                break

                            fi


                            sleep 10

                        done


                        if [ "${HEALTH}" != "healthy" ]; then

                            echo ""
                            echo "ERROR: ALB target did not become healthy."


                            aws elbv2 describe-target-health \
                                --region "${AWS_DEFAULT_REGION}" \
                                --target-group-arn "${TARGET_GROUP_ARN}" \
                                --targets Id="${TASK_IP}" \
                                --output table \
                                || true


                            exit 1

                        fi
                    '''
                }
            }
        }


        stage('57 - Part 7 - Verify Application URL') {

            steps {

                sh '''
                    set -e

                    echo "================================================"
                    echo "PART 7 - APPLICATION HEALTH CHECK"
                    echo "================================================"


                    if [ -z "${APPLICATION_URL}" ]; then

                        echo "ERROR: APPLICATION_URL is empty."

                        exit 1

                    fi


                    URL="${APPLICATION_URL}${HEALTH_PATH}"


                    echo ""
                    echo "Application URL:"
                    echo "${URL}"


                    SUCCESS=false


                    for i in $(seq 1 30)
                    do

                        echo ""
                        echo "Application health attempt ${i}/30"


                        HTTP_CODE=$(curl \
                            --connect-timeout 10 \
                            --max-time 20 \
                            --silent \
                            --show-error \
                            --output /dev/null \
                            --write-out "%{http_code}" \
                            "${URL}" \
                            || true)


                        echo "HTTP response code: ${HTTP_CODE}"


                        case "${HTTP_CODE}" in

                            2??|3??)

                                SUCCESS=true

                                break
                                ;;

                            *)

                                echo "Application is not healthy yet."

                                sleep 10
                                ;;

                        esac

                    done


                    if [ "${SUCCESS}" != "true" ]; then

                        echo ""
                        echo "================================================"
                        echo "APPLICATION HEALTH CHECK FAILED"
                        echo "================================================"


                        echo ""
                        echo "URL:"
                        echo "${URL}"


                        echo ""
                        echo "HTTP response:"
                        echo "${HTTP_CODE}"


                        exit 1

                    fi


                    echo ""
                    echo "APPLICATION HTTP HEALTH CHECK: PASSED"
                '''
            }
        }


        // ============================================================
        // COMPLETE DEPLOYMENT REPORT
        // ============================================================

        stage('58 - Complete Deployment Report') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        REPORT_FILE="deployment-report-${BUILD_NUMBER}.txt"


                        TASK_ARN=$(cat running_task_arn.txt 2>/dev/null || echo "N/A")
                        TASK_IP=$(cat running_task_ip.txt 2>/dev/null || echo "N/A")
                        ECS_SECURITY_GROUP_ID=$(cat ecs_security_group_id.txt 2>/dev/null || echo "N/A")
                        TASK_DEFINITION_ARN=$(cat task_definition_arn.txt 2>/dev/null || echo "N/A")


                        CLUSTER_STATUS=$(aws ecs describe-clusters \
                            --region "${AWS_DEFAULT_REGION}" \
                            --clusters "${ECS_CLUSTER}" \
                            --query 'clusters[0].status' \
                            --output text \
                            2>/dev/null || echo "UNKNOWN")


                        SERVICE_STATUS=$(aws ecs describe-services \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}" \
                            --query 'services[0].status' \
                            --output text \
                            2>/dev/null || echo "UNKNOWN")


                        RUNNING_COUNT=$(aws ecs describe-services \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}" \
                            --query 'services[0].runningCount' \
                            --output text \
                            2>/dev/null || echo "UNKNOWN")


                        DESIRED_COUNT=$(aws ecs describe-services \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}" \
                            --query 'services[0].desiredCount' \
                            --output text \
                            2>/dev/null || echo "UNKNOWN")


                        TARGET_HEALTH=$(aws elbv2 describe-target-health \
                            --region "${AWS_DEFAULT_REGION}" \
                            --target-group-arn "${TARGET_GROUP_ARN}" \
                            --targets Id="${TASK_IP}" \
                            --query 'TargetHealthDescriptions[0].TargetHealth.State' \
                            --output text \
                            2>/dev/null || echo "UNKNOWN")


                        cat > "${REPORT_FILE}" <<EOF
============================================================
                 CI/CD DEPLOYMENT REPORT
============================================================

Build Number       : ${BUILD_NUMBER}
Application        : ${APP_NAME}
Environment        : ${ENVIRONMENT}
AWS Region         : ${AWS_DEFAULT_REGION}
AWS Account        : ${AWS_ACCOUNT_ID}

------------------------------------------------------------
                    SOURCE
------------------------------------------------------------

Application Repo   : ${APP_REPO}
Application Branch : ${APP_BRANCH}

Terraform Repo     : ${TERRAFORM_REPO}
Terraform Branch   : ${TERRAFORM_BRANCH}

Quality Repo       : ${QUALITY_REPO}
Quality Branch     : ${QUALITY_BRANCH}

------------------------------------------------------------
                    DOCKER / ECR
------------------------------------------------------------

Docker Image       : ${DOCKER_IMAGE}
ECR Repository     : ${ECR_REPOSITORY}
ECR Image          : ${ECR_IMAGE}

------------------------------------------------------------
                    ECS
------------------------------------------------------------

ECS Cluster        : ${ECS_CLUSTER}
Cluster Status     : ${CLUSTER_STATUS}

ECS Service        : ${ECS_SERVICE}
Service Status     : ${SERVICE_STATUS}

Desired Count      : ${DESIRED_COUNT}
Running Count      : ${RUNNING_COUNT}

Task Family        : ${ECS_TASK_FAMILY}
Task Definition    : ${TASK_DEFINITION_ARN}

Running Task ARN   : ${TASK_ARN}
Running Task IP    : ${TASK_IP}

ECS Security Group : ${ECS_SECURITY_GROUP_ID}

------------------------------------------------------------
                    NETWORK
------------------------------------------------------------

VPC ID             : ${VPC_ID}
Subnet 1           : ${SUBNET_1}
Subnet 2           : ${SUBNET_2}

------------------------------------------------------------
                    LOAD BALANCER
------------------------------------------------------------

ALB Name           : ${ALB_NAME}
ALB ARN            : ${ALB_ARN}
ALB DNS            : ${ALB_DNS}

Target Group       : ${TARGET_GROUP_NAME}
Target Group ARN   : ${TARGET_GROUP_ARN}

Target Health      : ${TARGET_HEALTH}

------------------------------------------------------------
                    APPLICATION
------------------------------------------------------------

Container Name     : ${ECS_CONTAINER_NAME}
Container Port     : ${CONTAINER_PORT}
Health Path        : ${HEALTH_PATH}

Application URL    : ${APPLICATION_URL}${HEALTH_PATH}

------------------------------------------------------------
                    PIPELINE CHECKS
------------------------------------------------------------

Code Quality       : PASSED
Flake8             : PASSED
Pylint             : PASSED
Pytest             : PASSED
Docker Build       : PASSED
ECR Push           : PASSED
Terraform          : PASSED
ECS Cluster        : ACTIVE
ECS Service        : ${SERVICE_STATUS}
Fargate Task       : RUNNING
Container          : RUNNING
ALB Target         : ${TARGET_HEALTH}
HTTP Health        : PASSED

------------------------------------------------------------
                    FINAL RESULT
------------------------------------------------------------

DEPLOYMENT STATUS  : SUCCESS

============================================================
EOF


                        echo ""
                        echo "================================================"
                        echo "COMPLETE DEPLOYMENT REPORT"
                        echo "================================================"


                        cat "${REPORT_FILE}"


                        echo ""
                        echo "Report file:"
                        echo "${REPORT_FILE}"
                    '''
                }
            }

            post {

                always {

                    archiveArtifacts(
                        artifacts: 'deployment-report-*.txt',
                        allowEmptyArchive: true,
                        fingerprint: true
                    )
                }
            }
        }
    }


    // ================================================================
    // POST ACTIONS
    // ================================================================

    post {

        success {

            echo ''
            echo '================================================'
            echo '       COMPLETE CI/CD PIPELINE SUCCESS'
            echo '================================================'

            echo ''
            echo 'PART 1 - CODE QUALITY      : PASSED'
            echo 'PART 2 - TESTING           : PASSED'
            echo 'PART 3 - DOCKER            : PASSED'
            echo 'PART 4 - ECR               : PASSED'
            echo 'PART 5 - TERRAFORM         : PASSED'
            echo 'PART 6 - ECS FARGATE       : PASSED'
            echo 'PART 6 - ALB               : PASSED'
            echo 'PART 6 - HTTP CHECK        : PASSED'
            echo 'PART 7 - HEALTH CHECK      : PASSED'

            echo ''
            echo '================================================'
            echo '          FINAL APPLICATION URL'
            echo '================================================'

            echo "${env.APPLICATION_URL}"

            echo ''
            echo '================================================'
            echo '          DEPLOYMENT COMPLETE'
            echo '================================================'
        }


        failure {

            echo ''
            echo '================================================'
            echo '          CI/CD PIPELINE FAILED'
            echo '================================================'

            echo ''
            echo 'The pipeline stopped because a deployment or health check failed.'

            echo ''
            echo 'Possible areas to inspect:'
            echo '1. ECS cluster'
            echo '2. ECS service'
            echo '3. Fargate task'
            echo '4. ECS security group'
            echo '5. Target group'
            echo '6. ALB target health'
            echo '7. Application HTTP endpoint'

            echo ''
            echo 'Check the Jenkins console output above.'

            echo '================================================'
        }


        always {

            echo ''
            echo '================================================'
            echo 'CLEANING JENKINS WORKSPACE'
            echo '================================================'

            cleanWs(
                deleteDirs: true,
                disableDeferredWipeout: true
            )
        }
    }
}
