pipeline {

    agent any

    // ================================================================
    // PIPELINE OPTIONS
    // ================================================================

    options {

        timestamps()

        ansiColor('xterm')

        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                daysToKeepStr: '30',
                numToKeepStr: '50'
            )
        )

        timeout(
            time: 120,
            unit: 'MINUTES'
        )
    }


    // ================================================================
    // PARAMETERS
    // ================================================================

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: [
                'dev',
                'qa',
                'prod'
            ],
            description: 'AWS/Terraform environment to deploy'
        )
    }


    // ================================================================
    // GLOBAL ENVIRONMENT
    // ================================================================

    environment {

        // ------------------------------------------------------------
        // REPOSITORIES
        // ------------------------------------------------------------

        APP_REPO = 'https://github.com/FAIZANSHEIKH223/practice1.git'

        APP_BRANCH = 'main'

        QUALITY_REPO = 'https://github.com/FAIZANSHEIKH223/pylint_flake8_int_jenkins.git'

        QUALITY_BRANCH = 'main'

        TERRAFORM_REPO = 'https://github.com/FAIZANSHEIKH223/terraform-aws-infra.git'

        TERRAFORM_BRANCH = 'main'


        // ------------------------------------------------------------
        // JENKINS CREDENTIALS
        // ------------------------------------------------------------

        GITHUB_CREDENTIALS = 'github-creds'

        AWS_CREDENTIALS = 'aws-creds'


        // ------------------------------------------------------------
        // DIRECTORIES
        // ------------------------------------------------------------

        APP_DIR = 'practice1'

        QUALITY_DIR = 'quality-tools'

        TERRAFORM_DIR = 'terraform-infra'

        VENV_DIR = 'venv'

        REPORT_DIR = 'reports'


        // ------------------------------------------------------------
        // PYTHON
        // ------------------------------------------------------------

        PYTHON = 'python3.12'


        // ------------------------------------------------------------
        // AWS
        // ------------------------------------------------------------

        AWS_DEFAULT_REGION = 'us-east-1'


        // ------------------------------------------------------------
        // APPLICATION
        // ------------------------------------------------------------

        APP_NAME = 'practice1'

        CONTAINER_NAME = 'practice1'

        CONTAINER_PORT = '8501'


        // ------------------------------------------------------------
        // DOCKER
        // ------------------------------------------------------------

        DOCKER_IMAGE_NAME = 'practice1'


        // ------------------------------------------------------------
        // TERRAFORM BACKEND
        // ------------------------------------------------------------

        TF_STATE_BUCKET = 'terraform-state-faizan-001'

        TF_LOCK_TABLE = 'terraform-locks'


        // ------------------------------------------------------------
        // FARGATE
        // ------------------------------------------------------------

        FARGATE_CPU = '256'

        FARGATE_MEMORY = '512'


        // ------------------------------------------------------------
        // ECS
        // ------------------------------------------------------------

        ECS_CLUSTER = "practice1-${ENVIRONMENT}-cluster"

        ECS_SERVICE = "practice1-${ENVIRONMENT}-service"

        ECS_TASK_FAMILY = "practice1-${ENVIRONMENT}-task"

        ECS_CONTAINER_NAME = 'practice1'


        // ------------------------------------------------------------
        // ALB
        // ------------------------------------------------------------

        ALB_NAME = "practice1-${ENVIRONMENT}-alb"

        TARGET_GROUP_NAME = "practice1-${ENVIRONMENT}-tg"

        ALB_SG_NAME = "practice1-${ENVIRONMENT}-alb-sg"

        ECS_SG_NAME = "practice1-${ENVIRONMENT}-ecs-sg"


        // ------------------------------------------------------------
        // CLOUDWATCH
        // ------------------------------------------------------------

        LOG_GROUP = "/ecs/practice1-${ENVIRONMENT}"


        // ------------------------------------------------------------
        // HEALTH
        // ------------------------------------------------------------

        HEALTH_PATH = '/'


        // ------------------------------------------------------------
        // VALUES DISCOVERED DURING PIPELINE
        // ------------------------------------------------------------

        AWS_ACCOUNT_ID = ''

        ECR_REGISTRY = ''

        ECR_REPOSITORY = ''

        ECR_IMAGE = ''

        ECR_IMAGE_DIGEST = ''

        VPC_ID = ''

        SUBNET_1 = ''

        SUBNET_2 = ''

        ALB_SG_ID = ''

        ECS_SG_ID = ''

        ALB_ARN = ''

        ALB_DNS = ''

        TARGET_GROUP_ARN = ''

        EXECUTION_ROLE_ARN = ''

        TASK_DEFINITION_ARN = ''

        APPLICATION_URL = ''
    }


    // ================================================================
    // STAGES
    // ================================================================

    stages {


        // ============================================================
        // PART 1 - CODE QUALITY
        // ============================================================

        stage('1 - Checkout Application') {

            steps {

                echo '================================================'
                echo 'PART 1 - CHECKOUT APPLICATION'
                echo '================================================'

                dir("${APP_DIR}") {

                    deleteDir()

                    git(
                        branch: "${APP_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${APP_REPO}"
                    )
                }
            }
        }


        stage('2 - Checkout Quality Repository') {

            steps {

                echo '================================================'
                echo 'PART 1 - CHECKOUT QUALITY REPOSITORY'
                echo '================================================'

                dir("${QUALITY_DIR}") {

                    deleteDir()

                    git(
                        branch: "${QUALITY_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${QUALITY_REPO}"
                    )
                }
            }
        }


        stage('3 - Verify Python') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "VERIFYING PYTHON"
                        echo "================================================"

                        command -v "${PYTHON}"

                        "${PYTHON}" --version

                        "${PYTHON}" -m pip --version
                    '''
                }
            }
        }


        stage('4 - Create Python Virtual Environment') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "CREATING PYTHON VIRTUAL ENVIRONMENT"
                        echo "================================================"

                        rm -rf "${VENV_DIR}"

                        "${PYTHON}" -m venv "${VENV_DIR}"

                        "${VENV_DIR}/bin/python" --version
                    '''
                }
            }
        }


        stage('5 - Install Application Dependencies') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "INSTALLING APPLICATION DEPENDENCIES"
                        echo "================================================"

                        "${VENV_DIR}/bin/python" \
                            -m pip install --upgrade pip

                        if [ -f requirements.txt ]; then

                            "${VENV_DIR}/bin/pip" \
                                install \
                                -r requirements.txt

                        else

                            echo "ERROR: requirements.txt not found."

                            exit 1

                        fi
                    '''
                }
            }
        }


        stage('6 - Install Quality Tools') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "INSTALLING QUALITY TOOLS"
                        echo "================================================"

                        "${VENV_DIR}/bin/pip" \
                            install \
                            flake8 \
                            pylint

                        "${VENV_DIR}/bin/flake8" --version

                        "${VENV_DIR}/bin/pylint" --version
                    '''
                }
            }
        }


        stage('7 - Flake8 Code Quality') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "RUNNING FLAKE8"
                        echo "================================================"

                        mkdir -p "${REPORT_DIR}"

                        "${VENV_DIR}/bin/flake8" \
                            . \
                            --exclude="${VENV_DIR},.git,${REPORT_DIR},__pycache__" \
                            --count \
                            --statistics \
                            --tee \
                            --output-file="${REPORT_DIR}/flake8-report.txt"
                    '''
                }
            }
        }


        stage('8 - Pylint Code Quality') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "RUNNING PYLINT"
                        echo "================================================"

                        mkdir -p "${REPORT_DIR}"

                        PYTHON_FILES=$(find . \
                            -type f \
                            -name "*.py" \
                            ! -path "./${VENV_DIR}/*" \
                            ! -path "./.git/*" \
                            ! -path "./${REPORT_DIR}/*" \
                            ! -path "*/__pycache__/*")

                        if [ -z "${PYTHON_FILES}" ]; then

                            echo "ERROR: No Python files found."

                            exit 1

                        fi

                        "${VENV_DIR}/bin/pylint" \
                            ${PYTHON_FILES} \
                            --output-format=text \
                            > "${REPORT_DIR}/pylint-report.txt"
                    '''
                }
            }
        }


        stage('9 - Part 1 Success') {

            steps {

                echo '================================================'
                echo 'PART 1 - CODE QUALITY PASSED'
                echo '================================================'

                echo 'Flake8 : PASSED'

                echo 'Pylint : PASSED'
            }
        }


        // ============================================================
        // PART 2 - TESTING
        // ============================================================

        stage('10 - Install Pytest') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "INSTALLING PYTEST"
                        echo "================================================"

                        "${VENV_DIR}/bin/pip" install pytest

                        "${VENV_DIR}/bin/pytest" --version
                    '''
                }
            }
        }


        stage('11 - Verify Tests') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "VERIFYING TESTS"
                        echo "================================================"

                        if [ ! -d "tests" ]; then

                            echo "ERROR: tests/ directory does not exist."

                            exit 1

                        fi

                        TEST_FILES=$(find tests \
                            -type f \
                            \\( \
                                -name "test_*.py" \
                                -o \
                                -name "*_test.py" \
                            \\))

                        if [ -z "${TEST_FILES}" ]; then

                            echo "ERROR: No pytest test files found."

                            exit 1

                        fi

                        echo "Test files:"
                        echo "${TEST_FILES}"
                    '''
                }
            }
        }


        stage('12 - Run Automated Tests') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "RUNNING AUTOMATED TESTS"
                        echo "================================================"

                        mkdir -p "${REPORT_DIR}"

                        "${VENV_DIR}/bin/pytest" \
                            tests/ \
                            -v \
                            --junitxml="${REPORT_DIR}/pytest-results.xml"
                    '''
                }
            }
        }


        stage('13 - Publish Test Results') {

            steps {

                junit(
                    testResults:
                        "${APP_DIR}/${REPORT_DIR}/pytest-results.xml",
                    allowEmptyResults: false
                )

                archiveArtifacts(
                    artifacts:
                        "${APP_DIR}/${REPORT_DIR}/pytest-results.xml," +
                        "${APP_DIR}/${REPORT_DIR}/flake8-report.txt," +
                        "${APP_DIR}/${REPORT_DIR}/pylint-report.txt",
                    allowEmptyArchive: false,
                    fingerprint: true
                )
            }
        }


        stage('14 - Part 2 Success') {

            steps {

                echo '================================================'
                echo 'PART 2 - AUTOMATED TESTING PASSED'
                echo '================================================'

                echo 'Pytest : PASSED'
            }
        }


        // ============================================================
        // PART 3 - DOCKER
        // ============================================================

        stage('15 - Verify Docker') {

            steps {

                sh '''
                    set -e

                    echo "================================================"
                    echo "VERIFYING DOCKER"
                    echo "================================================"

                    command -v docker

                    docker --version

                    docker info > /dev/null

                    echo "Docker daemon is accessible."
                '''
            }
        }


        stage('16 - Verify Dockerfile') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "VERIFYING DOCKERFILE"
                        echo "================================================"

                        if [ ! -f Dockerfile ]; then

                            echo "ERROR: Dockerfile not found."

                            exit 1

                        fi

                        cat Dockerfile

                        cat > .dockerignore <<'EOF'
venv/
.venv/
.git/
.gitignore
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
reports/
*.log
.DS_Store
EOF

                        echo ""
                        echo "Docker context prepared."
                    '''
                }
            }
        }


        stage('17 - Build Docker Image') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "BUILDING DOCKER IMAGE"
                        echo "================================================"

                        DOCKER_BUILD_TAG="${DOCKER_IMAGE_NAME}:${BUILD_NUMBER}"

                        echo "Docker image:"
                        echo "${DOCKER_BUILD_TAG}"

                        docker build \
                            --pull \
                            --tag "${DOCKER_BUILD_TAG}" \
                            .

                        docker image inspect \
                            "${DOCKER_BUILD_TAG}" \
                            > /dev/null

                        echo "Docker image created successfully."
                    '''
                }
            }
        }


        stage('18 - Verify Docker Image') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        DOCKER_BUILD_TAG="${DOCKER_IMAGE_NAME}:${BUILD_NUMBER}"

                        echo "================================================"
                        echo "VERIFYING DOCKER IMAGE"
                        echo "================================================"

                        docker image inspect \
                            "${DOCKER_BUILD_TAG}" \
                            --format='Repository={{.RepoTags}} Size={{.Size}} Id={{.Id}}'

                        echo ""

                        docker images "${DOCKER_IMAGE_NAME}"
                    '''
                }
            }
        }


        stage('19 - Part 3 Success') {

            steps {

                echo '================================================'

                echo 'PART 3 - DOCKER PASSED'

                echo '================================================'

                echo "Docker image: ${DOCKER_IMAGE_NAME}:${BUILD_NUMBER}"
            }
        }


        // ============================================================
        // PART 4 - AWS / ECR
        // ============================================================

        stage('20 - Verify AWS CLI') {

            steps {

                sh '''
                    set -e

                    echo "================================================"
                    echo "VERIFYING AWS CLI"
                    echo "================================================"

                    command -v aws

                    aws --version
                '''
            }
        }


        stage('21 - Verify AWS Credentials') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "VERIFYING AWS CREDENTIALS"
                        echo "================================================"

                        aws sts get-caller-identity \
                            --region "${AWS_DEFAULT_REGION}"
                    '''
                }
            }
        }


        // ============================================================
        // PART 4.1 - BOOTSTRAP TERRAFORM BACKEND
        // ============================================================

        stage('22 - Create Terraform State S3 Bucket') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "ENSURING TERRAFORM STATE BUCKET"
                        echo "================================================"

                        if aws s3api head-bucket \
                            --bucket "${TF_STATE_BUCKET}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            2>/dev/null
                        then

                            echo "Terraform state bucket already exists."

                        else

                            echo "Creating Terraform state bucket..."

                            aws s3api create-bucket \
                                --bucket "${TF_STATE_BUCKET}" \
                                --region "${AWS_DEFAULT_REGION}"

                        fi


                        echo "Waiting for S3 bucket..."

                        for i in $(seq 1 30)
                        do

                            if aws s3api head-bucket \
                                --bucket "${TF_STATE_BUCKET}" \
                                --region "${AWS_DEFAULT_REGION}" \
                                2>/dev/null
                            then

                                echo "Terraform state bucket is READY."

                                break

                            fi

                            echo "Bucket not ready. Attempt ${i}/30"

                            sleep 2

                        done


                        aws s3api put-bucket-versioning \
                            --bucket "${TF_STATE_BUCKET}" \
                            --versioning-configuration Status=Enabled \
                            --region "${AWS_DEFAULT_REGION}"


                        aws s3api put-public-access-block \
                            --bucket "${TF_STATE_BUCKET}" \
                            --public-access-block-configuration \
                                BlockPublicAcls=true,IgnorePublicAcls=true,BlockPublicPolicy=true,RestrictPublicBuckets=true \
                            --region "${AWS_DEFAULT_REGION}"


                        aws s3api put-bucket-encryption \
                            --bucket "${TF_STATE_BUCKET}" \
                            --server-side-encryption-configuration \
                                '{"Rules":[{"ApplyServerSideEncryptionByDefault":{"SSEAlgorithm":"AES256"}}]}' \
                            --region "${AWS_DEFAULT_REGION}"


                        echo "Terraform state bucket is completely ready."
                    '''
                }
            }
        }


        stage('23 - Create Terraform DynamoDB Lock Table') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "ENSURING TERRAFORM LOCK TABLE"
                        echo "================================================"

                        TABLE_STATUS=$(aws dynamodb describe-table \
                            --table-name "${TF_LOCK_TABLE}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            --query 'Table.TableStatus' \
                            --output text \
                            2>/dev/null || true)


                        if [ "${TABLE_STATUS}" = "ACTIVE" ]; then

                            echo "DynamoDB lock table already exists."

                        else

                            echo "Creating DynamoDB lock table..."

                            aws dynamodb create-table \
                                --table-name "${TF_LOCK_TABLE}" \
                                --attribute-definitions \
                                    AttributeName=LockID,AttributeType=S \
                                --key-schema \
                                    AttributeName=LockID,KeyType=HASH \
                                --billing-mode PAY_PER_REQUEST \
                                --region "${AWS_DEFAULT_REGION}"

                        fi


                        echo "Waiting for DynamoDB table..."

                        aws dynamodb wait table-exists \
                            --table-name "${TF_LOCK_TABLE}" \
                            --region "${AWS_DEFAULT_REGION}"


                        TABLE_STATUS=$(aws dynamodb describe-table \
                            --table-name "${TF_LOCK_TABLE}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            --query 'Table.TableStatus' \
                            --output text)


                        if [ "${TABLE_STATUS}" != "ACTIVE" ]; then

                            echo "ERROR: DynamoDB lock table is not ACTIVE."

                            exit 1

                        fi


                        echo "DynamoDB lock table is READY."
                    '''
                }
            }
        }


        // ============================================================
        // PART 5 - TERRAFORM
        // ============================================================

        stage('24 - Checkout Terraform Repository') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    deleteDir()

                    git(
                        branch: "${TERRAFORM_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${TERRAFORM_REPO}"
                    )
                }
            }
        }


        stage('25 - Verify Terraform') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "VERIFYING TERRAFORM"
                        echo "================================================"

                        command -v terraform

                        terraform version

                        if [ ! -d "environments/${ENVIRONMENT}" ]; then

                            echo "ERROR: Environment directory does not exist:"
                            echo "environments/${ENVIRONMENT}"

                            exit 1

                        fi

                        if [ ! -f "environments/${ENVIRONMENT}/terraform.tfvars" ]; then

                            echo "ERROR: terraform.tfvars does not exist."

                            exit 1

                        fi
                    '''
                }
            }
        }


        stage('26 - Terraform Init') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh '''
                            set -e

                            echo "================================================"
                            echo "TERRAFORM INIT"
                            echo "================================================"

                            terraform init \
                                -reconfigure \
                                -input=false \
                                -backend-config="bucket=${TF_STATE_BUCKET}" \
                                -backend-config="key=practice1/${ENVIRONMENT}/terraform.tfstate" \
                                -backend-config="region=${AWS_DEFAULT_REGION}" \
                                -backend-config="dynamodb_table=${TF_LOCK_TABLE}" \
                                -backend-config="encrypt=true"
                        '''
                    }
                }
            }
        }


        stage('27 - Terraform Validate') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "TERRAFORM VALIDATE"
                        echo "================================================"

                        terraform validate
                    '''
                }
            }
        }


        stage('28 - Discover AWS Network') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        script {

                            def networkOutput = sh(
                                script: '''
                                    set -e

                                    VPC_FROM_TFVARS=$(awk -F'"' '/^[[:space:]]*vpc_id[[:space:]]*=/{print $2; exit}' \
                                        "environments/${ENVIRONMENT}/terraform.tfvars" || true)


                                    if [ -n "${VPC_FROM_TFVARS}" ]; then

                                        VPC_ID="${VPC_FROM_TFVARS}"

                                    else

                                        VPC_ID=$(aws ec2 describe-vpcs \
                                            --region "${AWS_DEFAULT_REGION}" \
                                            --filters \
                                                "Name=is-default,Values=true" \
                                            --query 'Vpcs[0].VpcId' \
                                            --output text)

                                    fi


                                    if [ -z "${VPC_ID}" ] || [ "${VPC_ID}" = "None" ]; then

                                        echo "ERROR: No VPC available."

                                        exit 1

                                    fi


                                    SUBNET_1_FROM_TFVARS=$(awk '
                                        /alb_subnet_ids[[:space:]]*=[[:space:]]*\\[/ {
                                            found=1
                                            next
                                        }

                                        found && /"/ {
                                            gsub(/"/, "", $0)
                                            gsub(/^[[:space:]]+|[[:space:]]+$/, "", $0)
                                            print
                                        }

                                        found && /]/ {
                                            exit
                                        }
                                    ' "environments/${ENVIRONMENT}/terraform.tfvars" | sed -n '1p')


                                    SUBNET_2_FROM_TFVARS=$(awk '
                                        /alb_subnet_ids[[:space:]]*=[[:space:]]*\\[/ {
                                            found=1
                                            next
                                        }

                                        found && /"/ {
                                            gsub(/"/, "", $0)
                                            gsub(/^[[:space:]]+|[[:space:]]+$/, "", $0)
                                            print
                                        }

                                        found && /]/ {
                                            exit
                                        }
                                    ' "environments/${ENVIRONMENT}/terraform.tfvars" | sed -n '2p')


                                    if [ -n "${SUBNET_1_FROM_TFVARS}" ] && \
                                       [ -n "${SUBNET_2_FROM_TFVARS}" ]; then

                                        SUBNET_1="${SUBNET_1_FROM_TFVARS}"
                                        SUBNET_2="${SUBNET_2_FROM_TFVARS}"

                                    else

                                        PUBLIC_SUBNETS=$(aws ec2 describe-subnets \
                                            --region "${AWS_DEFAULT_REGION}" \
                                            --filters \
                                                "Name=vpc-id,Values=${VPC_ID}" \
                                                "Name=map-public-ip-on-launch,Values=true" \
                                            --query 'Subnets[].SubnetId' \
                                            --output text)


                                        if [ -z "${PUBLIC_SUBNETS}" ] || \
                                           [ "${PUBLIC_SUBNETS}" = "None" ]; then

                                            echo "ERROR: No public subnets found."

                                            exit 1

                                        fi


                                        SUBNET_1=$(echo "${PUBLIC_SUBNETS}" | awk '{print $1}')

                                        SUBNET_2=$(echo "${PUBLIC_SUBNETS}" | awk '{print $2}')

                                    fi


                                    if [ -z "${SUBNET_1}" ] || \
                                       [ -z "${SUBNET_2}" ] || \
                                       [ "${SUBNET_2}" = "${SUBNET_1}" ]; then

                                        echo "ERROR: Two public subnets are required."

                                        exit 1

                                    fi


                                    echo "${VPC_ID}|${SUBNET_1}|${SUBNET_2}"
                                ''',
                                returnStdout: true
                            ).trim()


                            def networkParts = networkOutput.split('\\|')


                            if (networkParts.size() != 3) {

                                error(
                                    "Could not determine VPC and two public subnets."
                                )
                            }


                            env.VPC_ID = networkParts[0]

                            env.SUBNET_1 = networkParts[1]

                            env.SUBNET_2 = networkParts[2]


                            echo "VPC     : ${env.VPC_ID}"

                            echo "Subnet 1: ${env.SUBNET_1}"

                            echo "Subnet 2: ${env.SUBNET_2}"
                        }
                    }
                }
            }
        }


        stage('29 - Terraform Apply Base Infrastructure') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh '''
                            set -e

                            echo "================================================"
                            echo "TERRAFORM BASE INFRASTRUCTURE"
                            echo "================================================"

                            echo "Creating/ensuring:"
                            echo "  - S3 application bucket"
                            echo "  - ECR repository"
                            echo "  - ECS task execution IAM role"

                            terraform plan \
                                -input=false \
                                -var-file="environments/${ENVIRONMENT}/terraform.tfvars" \
                                -var="container_image=bootstrap.invalid/practice1:bootstrap" \
                                -target=module.s3 \
                                -target=module.ecr \
                                -target=module.iam \
                                -out="base.tfplan"


                            terraform apply \
                                -input=false \
                                -auto-approve \
                                "base.tfplan"


                            echo ""
                            echo "Waiting for AWS resources to become available..."

                            sleep 15
                        '''
                    }
                }
            }
        }


        stage('30 - Verify ECR Repository') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        script {

                            def repositoryUrl = sh(
                                script: '''
                                    set -e

                                    terraform output -raw ecr_repository_url
                                ''',
                                returnStdout: true
                            ).trim()


                            if (!repositoryUrl ||
                                repositoryUrl == 'null' ||
                                repositoryUrl == '""') {

                                error(
                                    "Terraform did not return a valid ECR repository URL."
                                )
                            }


                            env.ECR_REPOSITORY =
                                repositoryUrl.substring(
                                    repositoryUrl.lastIndexOf('/') + 1
                                )


                            env.ECR_REGISTRY =
                                repositoryUrl.substring(
                                    0,
                                    repositoryUrl.lastIndexOf('/')
                                )


                            echo "ECR repository: ${env.ECR_REPOSITORY}"

                            echo "ECR registry  : ${env.ECR_REGISTRY}"


                            sh '''
                                set -e

                                aws ecr describe-repositories \
                                    --repository-names "${ECR_REPOSITORY}" \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    > /dev/null

                                echo "ECR repository is READY."
                            '''
                        }
                    }
                }
            }
        }


        stage('31 - Build Final ECR Image URI') {

            steps {

                script {

                    env.ECR_IMAGE =
                        "${env.ECR_REGISTRY}/${env.ECR_REPOSITORY}:${env.BUILD_NUMBER}"


                    echo "================================================"

                    echo "FINAL IMAGE SELECTED"

                    echo "================================================"

                    echo "${env.ECR_IMAGE}"
                }
            }
        }


        stage('32 - Login Docker to ECR') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "DOCKER LOGIN TO ECR"
                        echo "================================================"

                        aws ecr get-login-password \
                            --region "${AWS_DEFAULT_REGION}" \
                        | docker login \
                            --username AWS \
                            --password-stdin \
                            "${ECR_REGISTRY}"
                    '''
                }
            }
        }


        stage('33 - Tag Exact Image') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        LOCAL_IMAGE="${DOCKER_IMAGE_NAME}:${BUILD_NUMBER}"

                        echo "Local image:"
                        echo "${LOCAL_IMAGE}"

                        echo "ECR image:"
                        echo "${ECR_IMAGE}"


                        docker image inspect \
                            "${LOCAL_IMAGE}" \
                            > /dev/null


                        docker tag \
                            "${LOCAL_IMAGE}" \
                            "${ECR_IMAGE}"


                        docker image inspect \
                            "${ECR_IMAGE}" \
                            > /dev/null


                        echo "Exact image tag created successfully."
                    '''
                }
            }
        }


        stage('34 - Push Exact Image to ECR') {

            steps {

                sh '''
                    set -e

                    echo "================================================"
                    echo "PUSHING EXACT IMAGE TO ECR"
                    echo "================================================"

                    docker push "${ECR_IMAGE}"

                    echo "Image push completed."
                '''
            }
        }


        stage('35 - Verify Exact ECR Image') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        def imageDigest = sh(
                            script: '''
                                set -e

                                aws ecr describe-images \
                                    --repository-name "${ECR_REPOSITORY}" \
                                    --image-ids imageTag="${BUILD_NUMBER}" \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --query 'imageDetails[0].imageDigest' \
                                    --output text
                            ''',
                            returnStdout: true
                        ).trim()


                        if (!imageDigest ||
                            imageDigest == 'None') {

                            error(
                                "Exact ECR image was not found after push: ${env.ECR_IMAGE}"
                            )
                        }


                        env.ECR_IMAGE_DIGEST = imageDigest


                        echo "================================================"

                        echo "EXACT ECR IMAGE VERIFIED"

                        echo "================================================"

                        echo "Image : ${env.ECR_IMAGE}"

                        echo "Digest: ${env.ECR_IMAGE_DIGEST}"
                    }
                }
            }
        }


        stage('36 - Part 4 Success') {

            steps {

                echo '================================================'

                echo 'PART 4 - ECR PASSED'

                echo '================================================'

                echo "ECR image: ${env.ECR_IMAGE}"

                echo "ECR digest: ${env.ECR_IMAGE_DIGEST}"
            }
        }


        // ============================================================
        // PART 5 CONTINUED
        // ============================================================

        stage('37 - Verify Terraform Base State') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh '''
                            set -e

                            echo "================================================"
                            echo "VERIFYING TERRAFORM BASE STATE"
                            echo "================================================"

                            terraform state list

                            echo ""

                            terraform output || true
                        '''
                    }
                }
            }
        }


        stage('38 - Verify Task Execution Role') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        script {

                            def roleArn = sh(
                                script: '''
                                    set -e

                                    terraform output -raw ecs_instance_profile 2>/dev/null || true
                                ''',
                                returnStdout: true
                            ).trim()


                            def executionRoleArn = sh(
                                script: '''
                                    set -e

                                    aws iam get-role \
                                        --role-name "${APP_NAME}-${ENVIRONMENT}-ecs-task-execution-role" \
                                        --query 'Role.Arn' \
                                        --output text
                                ''',
                                returnStdout: true
                            ).trim()


                            if (!executionRoleArn ||
                                executionRoleArn == 'None') {

                                error(
                                    "ECS task execution IAM role was not found."
                                )
                            }


                            env.EXECUTION_ROLE_ARN = executionRoleArn


                            echo "ECS task execution role:"

                            echo "${env.EXECUTION_ROLE_ARN}"


                            echo "Waiting for IAM propagation..."

                            sleep 15
                        }
                    }
                }
            }
        }


        stage('39 - Part 5 Success') {

            steps {

                echo '================================================'

                echo 'PART 5 - TERRAFORM BASE INFRASTRUCTURE PASSED'

                echo '================================================'

                echo "S3 backend : READY"

                echo "DynamoDB    : READY"

                echo "ECR         : READY"

                echo "IAM role    : READY"
            }
        }


        // ============================================================
        // PART 6 - FARGATE DEPLOYMENT
        // ============================================================

        stage('40 - Create ALB Security Group') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "CREATING ALB SECURITY GROUP"
                        echo "================================================"


                        ALB_SG_ID=$(aws ec2 describe-security-groups \
                            --region "${AWS_DEFAULT_REGION}" \
                            --filters \
                                "Name=vpc-id,Values=${VPC_ID}" \
                                "Name=group-name,Values=${ALB_SG_NAME}" \
                            --query 'SecurityGroups[0].GroupId' \
                            --output text)


                        if [ "${ALB_SG_ID}" = "None" ] || \
                           [ -z "${ALB_SG_ID}" ]; then

                            ALB_SG_ID=$(aws ec2 create-security-group \
                                --region "${AWS_DEFAULT_REGION}" \
                                --group-name "${ALB_SG_NAME}" \
                                --description "ALB security group for ${APP_NAME}" \
                                --vpc-id "${VPC_ID}" \
                                --query 'GroupId' \
                                --output text)

                        fi


                        aws ec2 authorize-security-group-ingress \
                            --region "${AWS_DEFAULT_REGION}" \
                            --group-id "${ALB_SG_ID}" \
                            --protocol tcp \
                            --port 80 \
                            --cidr 0.0.0.0/0 \
                            2>/dev/null || true


                        env ALB_SG_ID="${ALB_SG_ID}"


                        echo "ALB security group: ${ALB_SG_ID}"
                    '''
                }
            }
        }


        stage('41 - Create Fargate Security Group') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "CREATING FARGATE SECURITY GROUP"
                        echo "================================================"


                        ECS_SG_ID=$(aws ec2 describe-security-groups \
                            --region "${AWS_DEFAULT_REGION}" \
                            --filters \
                                "Name=vpc-id,Values=${VPC_ID}" \
                                "Name=group-name,Values=${ECS_SG_NAME}" \
                            --query 'SecurityGroups[0].GroupId' \
                            --output text)


                        if [ "${ECS_SG_ID}" = "None" ] || \
                           [ -z "${ECS_SG_ID}" ]; then

                            ECS_SG_ID=$(aws ec2 create-security-group \
                                --region "${AWS_DEFAULT_REGION}" \
                                --group-name "${ECS_SG_NAME}" \
                                --description "Fargate security group for ${APP_NAME}" \
                                --vpc-id "${VPC_ID}" \
                                --query 'GroupId' \
                                --output text)

                        fi


                        aws ec2 authorize-security-group-ingress \
                            --region "${AWS_DEFAULT_REGION}" \
                            --group-id "${ECS_SG_ID}" \
                            --protocol tcp \
                            --port "${CONTAINER_PORT}" \
                            --source-group "${ALB_SG_ID}" \
                            2>/dev/null || true


                        aws ec2 authorize-security-group-egress \
                            --region "${AWS_DEFAULT_REGION}" \
                            --group-id "${ECS_SG_ID}" \
                            --protocol -1 \
                            --cidr 0.0.0.0/0 \
                            2>/dev/null || true


                        env ECS_SG_ID="${ECS_SG_ID}"


                        echo "Fargate security group: ${ECS_SG_ID}"
                    '''
                }
            }
        }


        stage('42 - Create Application Load Balancer') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        def albArn = sh(
                            script: '''
                                aws elbv2 describe-load-balancers \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --names "${ALB_NAME}" \
                                    --query 'LoadBalancers[0].LoadBalancerArn' \
                                    --output text \
                                    2>/dev/null || true
                            ''',
                            returnStdout: true
                        ).trim()


                        if (!albArn || albArn == 'None') {

                            albArn = sh(
                                script: '''
                                    aws elbv2 create-load-balancer \
                                        --region "${AWS_DEFAULT_REGION}" \
                                        --name "${ALB_NAME}" \
                                        --subnets "${SUBNET_1}" "${SUBNET_2}" \
                                        --security-groups "${ALB_SG_ID}" \
                                        --scheme internet-facing \
                                        --type application \
                                        --ip-address-type ipv4 \
                                        --query 'LoadBalancers[0].LoadBalancerArn' \
                                        --output text
                                ''',
                                returnStdout: true
                            ).trim()
                        }


                        env.ALB_ARN = albArn


                        sh '''
                            set -e

                            echo "Waiting for ALB to become active..."

                            aws elbv2 wait load-balancer-available \
                                --region "${AWS_DEFAULT_REGION}" \
                                --load-balancer-arns "${ALB_ARN}"


                            ALB_STATE=$(aws elbv2 describe-load-balancers \
                                --region "${AWS_DEFAULT_REGION}" \
                                --load-balancer-arns "${ALB_ARN}" \
                                --query 'LoadBalancers[0].State.Code' \
                                --output text)


                            if [ "${ALB_STATE}" != "active" ]; then

                                echo "ERROR: ALB is not active."

                                exit 1

                            fi
                        '''


                        def albDns = sh(
                            script: '''
                                aws elbv2 describe-load-balancers \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --load-balancer-arns "${ALB_ARN}" \
                                    --query 'LoadBalancers[0].DNSName' \
                                    --output text
                            ''',
                            returnStdout: true
                        ).trim()


                        if (!albDns || albDns == 'None') {

                            error(
                                "ALB DNS name was not returned."
                            )
                        }


                        env.ALB_DNS = albDns


                        echo "ALB ARN: ${env.ALB_ARN}"

                        echo "ALB DNS: ${env.ALB_DNS}"
                    }
                }
            }
        }


        stage('43 - Create IP Target Group') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        def targetGroupArn = sh(
                            script: '''
                                aws elbv2 describe-target-groups \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --names "${TARGET_GROUP_NAME}" \
                                    --query 'TargetGroups[0].TargetGroupArn' \
                                    --output text \
                                    2>/dev/null || true
                            ''',
                            returnStdout: true
                        ).trim()


                        if (!targetGroupArn || targetGroupArn == 'None') {

                            targetGroupArn = sh(
                                script: '''
                                    aws elbv2 create-target-group \
                                        --region "${AWS_DEFAULT_REGION}" \
                                        --name "${TARGET_GROUP_NAME}" \
                                        --protocol HTTP \
                                        --port "${CONTAINER_PORT}" \
                                        --target-type ip \
                                        --vpc-id "${VPC_ID}" \
                                        --health-check-protocol HTTP \
                                        --health-check-path "${HEALTH_PATH}" \
                                        --health-check-port traffic-port \
                                        --health-check-interval-seconds 15 \
                                        --health-check-timeout-seconds 5 \
                                        --healthy-threshold-count 2 \
                                        --unhealthy-threshold-count 3 \
                                        --matcher HttpCode=200-399 \
                                        --query 'TargetGroups[0].TargetGroupArn' \
                                        --output text
                                ''',
                                returnStdout: true
                            ).trim()
                        }


                        env.TARGET_GROUP_ARN = targetGroupArn


                        echo "Target group: ${env.TARGET_GROUP_ARN}"


                        def targetType = sh(
                            script: '''
                                aws elbv2 describe-target-groups \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --target-group-arns "${TARGET_GROUP_ARN}" \
                                    --query 'TargetGroups[0].TargetType' \
                                    --output text
                            ''',
                            returnStdout: true
                        ).trim()


                        if (targetType != 'ip') {

                            error(
                                "Target group is not IP based. Fargate requires target-type ip."
                            )
                        }


                        echo "Target group type: ${targetType}"
                    }
                }
            }
        }


        stage('44 - Create ALB Listener') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "CREATING ALB HTTP LISTENER"
                        echo "================================================"


                        LISTENER_ARN=$(aws elbv2 describe-listeners \
                            --region "${AWS_DEFAULT_REGION}" \
                            --load-balancer-arn "${ALB_ARN}" \
                            --query 'Listeners[?Port==`80`].ListenerArn | [0]' \
                            --output text)


                        if [ "${LISTENER_ARN}" = "None" ] || \
                           [ -z "${LISTENER_ARN}" ]; then

                            aws elbv2 create-listener \
                                --region "${AWS_DEFAULT_REGION}" \
                                --load-balancer-arn "${ALB_ARN}" \
                                --protocol HTTP \
                                --port 80 \
                                --default-actions \
                                    Type=forward,TargetGroupArn="${TARGET_GROUP_ARN}"

                        else

                            aws elbv2 modify-listener \
                                --region "${AWS_DEFAULT_REGION}" \
                                --listener-arn "${LISTENER_ARN}" \
                                --default-actions \
                                    Type=forward,TargetGroupArn="${TARGET_GROUP_ARN}"

                        fi


                        echo "ALB listener is ready."
                    '''
                }
            }
        }


        stage('45 - Create ECS Fargate Cluster') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "ENSURING ECS FARGATE CLUSTER"
                        echo "================================================"


                        CLUSTER_STATUS=$(aws ecs describe-clusters \
                            --region "${AWS_DEFAULT_REGION}" \
                            --clusters "${ECS_CLUSTER}" \
                            --query 'clusters[0].status' \
                            --output text \
                            2>/dev/null || true)


                        if [ "${CLUSTER_STATUS}" != "ACTIVE" ]; then

                            aws ecs create-cluster \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster-name "${ECS_CLUSTER}" \
                                --settings name=containerInsights,value=enabled

                        fi


                        for i in $(seq 1 30)
                        do

                            CLUSTER_STATUS=$(aws ecs describe-clusters \
                                --region "${AWS_DEFAULT_REGION}" \
                                --clusters "${ECS_CLUSTER}" \
                                --query 'clusters[0].status' \
                                --output text \
                                2>/dev/null || true)


                            if [ "${CLUSTER_STATUS}" = "ACTIVE" ]; then

                                echo "ECS cluster is READY."

                                break

                            fi


                            echo "Waiting for ECS cluster. Attempt ${i}/30"

                            sleep 2

                        done


                        if [ "${CLUSTER_STATUS}" != "ACTIVE" ]; then

                            echo "ERROR: ECS cluster did not become ACTIVE."

                            exit 1

                        fi
                    '''
                }
            }
        }


        stage('46 - Create CloudWatch Log Group') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "ENSURING CLOUDWATCH LOG GROUP"
                        echo "================================================"


                        if aws logs describe-log-groups \
                            --log-group-name-prefix "${LOG_GROUP}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            --query "logGroups[?logGroupName=='${LOG_GROUP}'].logGroupName | [0]" \
                            --output text \
                            | grep -q "${LOG_GROUP}"
                        then

                            echo "CloudWatch log group already exists."

                        else

                            aws logs create-log-group \
                                --log-group-name "${LOG_GROUP}" \
                                --region "${AWS_DEFAULT_REGION}"

                        fi


                        for i in $(seq 1 30)
                        do

                            if aws logs describe-log-groups \
                                --log-group-name-prefix "${LOG_GROUP}" \
                                --region "${AWS_DEFAULT_REGION}" \
                                --query "logGroups[?logGroupName=='${LOG_GROUP}'].logGroupName | [0]" \
                                --output text \
                                | grep -q "${LOG_GROUP}"
                            then

                                echo "CloudWatch log group is READY."

                                break

                            fi

                            sleep 2

                        done
                    '''
                }
            }
        }


        stage('47 - Register Exact Fargate Task Definition') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        sh '''
                            set -e

                            echo "================================================"
                            echo "REGISTERING FARGATE TASK DEFINITION"
                            echo "================================================"


                            echo "Image selected for task:"
                            echo "${ECR_IMAGE}"


                            aws ecr describe-images \
                                --repository-name "${ECR_REPOSITORY}" \
                                --image-ids imageTag="${BUILD_NUMBER}" \
                                --region "${AWS_DEFAULT_REGION}" \
                                --query 'imageDetails[0].{Tag:imageTags[0],Digest:imageDigest,Size:imageSizeInBytes}' \
                                --output table


                            cat > fargate-task-definition.json <<EOF
{
    "family": "${ECS_TASK_FAMILY}",
    "networkMode": "awsvpc",
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "${FARGATE_CPU}",
    "memory": "${FARGATE_MEMORY}",
    "executionRoleArn": "${EXECUTION_ROLE_ARN}",
    "containerDefinitions": [
        {
            "name": "${ECS_CONTAINER_NAME}",
            "image": "${ECR_IMAGE}",
            "essential": true,
            "cpu": 256,
            "memory": 512,
            "portMappings": [
                {
                    "containerPort": ${CONTAINER_PORT},
                    "hostPort": ${CONTAINER_PORT},
                    "protocol": "tcp"
                }
            ],
            "healthCheck": {
                "command": [
                    "CMD-SHELL",
                    "python -c \\"import urllib.request; urllib.request.urlopen('http://127.0.0.1:${CONTAINER_PORT}/', timeout=5)\\""
                ],
                "interval": 30,
                "timeout": 10,
                "retries": 3,
                "startPeriod": 60
            },
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "${LOG_GROUP}",
                    "awslogs-region": "${AWS_DEFAULT_REGION}",
                    "awslogs-stream-prefix": "ecs"
                }
            }
        }
    ]
}
EOF


                            python3 -m json.tool \
                                fargate-task-definition.json \
                                > /dev/null


                            REGISTERED_TASK=$(aws ecs register-task-definition \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cli-input-json file://fargate-task-definition.json \
                                --query 'taskDefinition.taskDefinitionArn' \
                                --output text)


                            if [ -z "${REGISTERED_TASK}" ] || \
                               [ "${REGISTERED_TASK}" = "None" ]; then

                                echo "ERROR: Task definition registration failed."

                                exit 1

                            fi


                            echo "Registered task definition:"
                            echo "${REGISTERED_TASK}"
                        '''


                        def taskArn = sh(
                            script: '''
                                aws ecs describe-task-definition \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --task-definition "${ECS_TASK_FAMILY}" \
                                    --query 'taskDefinition.taskDefinitionArn' \
                                    --output text
                            ''',
                            returnStdout: true
                        ).trim()


                        if (!taskArn || taskArn == 'None') {

                            error(
                                "Could not retrieve registered task definition."
                            )
                        }


                        env.TASK_DEFINITION_ARN = taskArn


                        echo "Task definition ARN: ${env.TASK_DEFINITION_ARN}"
                    }
                }
            }
        }


        stage('48 - Verify Task Definition Image') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        def taskImage = sh(
                            script: '''
                                aws ecs describe-task-definition \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --task-definition "${TASK_DEFINITION_ARN}" \
                                    --query 'taskDefinition.containerDefinitions[?name==`'${ECS_CONTAINER_NAME}'`].image | [0]' \
                                    --output text
                            ''',
                            returnStdout: true
                        ).trim()


                        echo "ECR image expected:"
                        echo "${env.ECR_IMAGE}"

                        echo "ECS task image:"
                        echo "${taskImage}"


                        if (taskImage != env.ECR_IMAGE) {

                            error(
                                "IMAGE MISMATCH: ECS task is not using the exact pushed ECR image."
                            )
                        }


                        echo "Exact image verified inside ECS task definition."
                    }
                }
            }
        }


        stage('49 - Create Or Replace Fargate Service') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "DEPLOYING FARGATE SERVICE"
                        echo "================================================"


                        SERVICE_STATUS=$(aws ecs describe-services \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}" \
                            --query 'services[0].status' \
                            --output text \
                            2>/dev/null || true)


                        EXISTING_LAUNCH_TYPE=$(aws ecs describe-services \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}" \
                            --query 'services[0].launchType' \
                            --output text \
                            2>/dev/null || true)


                        echo "Existing service status:"
                        echo "${SERVICE_STATUS}"

                        echo "Existing launch type:"
                        echo "${EXISTING_LAUNCH_TYPE}"


                        if [ "${SERVICE_STATUS}" = "ACTIVE" ] && \
                           [ "${EXISTING_LAUNCH_TYPE}" != "FARGATE" ]; then

                            echo "Existing service is not Fargate."

                            echo "Removing old ECS service so Fargate can be created."

                            aws ecs update-service \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --service "${ECS_SERVICE}" \
                                --desired-count 0 \
                                --force-new-deployment


                            aws ecs wait services-stable \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --services "${ECS_SERVICE}"


                            aws ecs delete-service \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --service "${ECS_SERVICE}" \
                                --force


                            echo "Waiting for old service to disappear..."


                            for i in $(seq 1 60)
                            do

                                CHECK_STATUS=$(aws ecs describe-services \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --cluster "${ECS_CLUSTER}" \
                                    --services "${ECS_SERVICE}" \
                                    --query 'services[0].status' \
                                    --output text \
                                    2>/dev/null || true)


                                if [ "${CHECK_STATUS}" = "None" ] || \
                                   [ -z "${CHECK_STATUS}" ]; then

                                    break

                                fi


                                sleep 5

                            done

                        fi


                        SERVICE_STATUS=$(aws ecs describe-services \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}" \
                            --query 'services[0].status' \
                            --output text \
                            2>/dev/null || true)


                        if [ "${SERVICE_STATUS}" = "ACTIVE" ]; then

                            echo "Updating existing Fargate service..."


                            aws ecs update-service \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --service "${ECS_SERVICE}" \
                                --task-definition "${TASK_DEFINITION_ARN}" \
                                --desired-count 1 \
                                --force-new-deployment


                        else

                            echo "Creating new Fargate service..."


                            aws ecs create-service \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --service-name "${ECS_SERVICE}" \
                                --task-definition "${TASK_DEFINITION_ARN}" \
                                --desired-count 1 \
                                --launch-type FARGATE \
                                --platform-version LATEST \
                                --deployment-configuration \
                                    maximumPercent=200,minimumHealthyPercent=100 \
                                --network-configuration \
                                    "awsvpcConfiguration={subnets=[${SUBNET_1},${SUBNET_2}],securityGroups=[${ECS_SG_ID}],assignPublicIp=ENABLED}" \
                                --load-balancers \
                                    "targetGroupArn=${TARGET_GROUP_ARN},containerName=${ECS_CONTAINER_NAME},containerPort=${CONTAINER_PORT}"

                        fi


                        echo ""
                        echo "Waiting for Fargate service to become stable..."


                        aws ecs wait services-stable \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}"


                        echo "Fargate service is STABLE."
                    '''
                }
            }
        }


        stage('50 - Verify Running Fargate Task') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "VERIFYING RUNNING FARGATE TASK"
                        echo "================================================"


                        RUNNING_COUNT=$(aws ecs describe-services \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}" \
                            --query 'services[0].runningCount' \
                            --output text)


                        DESIRED_COUNT=$(aws ecs describe-services \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}" \
                            --query 'services[0].desiredCount' \
                            --output text)


                        echo "Desired tasks: ${DESIRED_COUNT}"

                        echo "Running tasks: ${RUNNING_COUNT}"


                        if [ "${RUNNING_COUNT}" -lt 1 ]; then

                            echo "ERROR: No Fargate task is running."

                            aws ecs describe-services \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --services "${ECS_SERVICE}" \
                                --query 'services[0].events[0:10]' \
                                --output table \
                                || true

                            exit 1

                        fi


                        TASK_ARN=$(aws ecs list-tasks \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --service-name "${ECS_SERVICE}" \
                            --desired-status RUNNING \
                            --query 'taskArns[0]' \
                            --output text)


                        if [ -z "${TASK_ARN}" ] || \
                           [ "${TASK_ARN}" = "None" ]; then

                            echo "ERROR: Running task ARN was not found."

                            exit 1

                        fi


                        echo "Running task:"
                        echo "${TASK_ARN}"


                        TASK_LAUNCH_TYPE=$(aws ecs describe-tasks \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --tasks "${TASK_ARN}" \
                            --query 'tasks[0].launchType' \
                            --output text)


                        if [ "${TASK_LAUNCH_TYPE}" != "FARGATE" ]; then

                            echo "ERROR: Task launch type is not FARGATE."

                            exit 1

                        fi


                        echo "Task launch type: FARGATE"


                        TASK_IMAGE=$(aws ecs describe-task-definition \
                            --region "${AWS_DEFAULT_REGION}" \
                            --task-definition "${TASK_DEFINITION_ARN}" \
                            --query 'taskDefinition.containerDefinitions[0].image' \
                            --output text)


                        if [ "${TASK_IMAGE}" != "${ECR_IMAGE}" ]; then

                            echo "ERROR: Running task definition image mismatch."

                            echo "Expected: ${ECR_IMAGE}"

                            echo "Actual  : ${TASK_IMAGE}"

                            exit 1

                        fi


                        echo "Running task is using the exact ECR image."
                    '''
                }
            }
        }


        stage('51 - Verify ALB Target Health') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "WAITING FOR ALB TARGET TO BECOME HEALTHY"
                        echo "================================================"


                        HEALTHY=false


                        for i in $(seq 1 60)
                        do

                            TARGET_STATE=$(aws elbv2 describe-target-health \
                                --region "${AWS_DEFAULT_REGION}" \
                                --target-group-arn "${TARGET_GROUP_ARN}" \
                                --query 'TargetHealthDescriptions[0].TargetHealth.State' \
                                --output text \
                                2>/dev/null || true)


                            echo "Health attempt ${i}/60: ${TARGET_STATE}"


                            if [ "${TARGET_STATE}" = "healthy" ]; then

                                HEALTHY=true

                                echo "ALB target is HEALTHY."

                                break

                            fi


                            if [ "${TARGET_STATE}" = "unhealthy" ]; then

                                REASON=$(aws elbv2 describe-target-health \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --target-group-arn "${TARGET_GROUP_ARN}" \
                                    --query 'TargetHealthDescriptions[0].TargetHealth.Reason' \
                                    --output text \
                                    2>/dev/null || true)


                                echo "Current unhealthy reason: ${REASON}"

                            fi


                            sleep 10

                        done


                        if [ "${HEALTHY}" != "true" ]; then

                            echo "ERROR: ALB target did not become healthy."


                            aws elbv2 describe-target-health \
                                --region "${AWS_DEFAULT_REGION}" \
                                --target-group-arn "${TARGET_GROUP_ARN}" \
                                --output table \
                                || true


                            aws ecs describe-services \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --services "${ECS_SERVICE}" \
                                --query 'services[0].events[0:15]' \
                                --output table \
                                || true


                            exit 1

                        fi
                    '''
                }
            }
        }


        stage('52 - Create Final Application URL') {

            steps {

                script {

                    if (!env.ALB_DNS ||
                        env.ALB_DNS.trim() == '') {

                        error(
                            "ALB DNS name is empty."
                        )
                    }


                    env.APPLICATION_URL =
                        "http://${env.ALB_DNS}"


                    echo "================================================"

                    echo "APPLICATION URL"

                    echo "================================================"

                    echo "${env.APPLICATION_URL}"
                }
            }
        }


        stage('53 - Final HTTP Application Check') {

            steps {

                sh '''
                    set -e

                    echo "================================================"
                    echo "FINAL APPLICATION HTTP CHECK"
                    echo "================================================"

                    echo "URL:"
                    echo "${APPLICATION_URL}"


                    HTTP_SUCCESS=false


                    for i in $(seq 1 30)
                    do

                        HTTP_CODE=$(curl \
                            --connect-timeout 10 \
                            --max-time 20 \
                            --silent \
                            --show-error \
                            --output /dev/null \
                            --write-out "%{http_code}" \
                            "${APPLICATION_URL}/" \
                            || true)


                        echo "HTTP attempt ${i}/30: ${HTTP_CODE}"


                        case "${HTTP_CODE}" in

                            2??|3??)

                                HTTP_SUCCESS=true

                                echo "HTTP application check PASSED."

                                break

                                ;;

                        esac


                        sleep 10

                    done


                    if [ "${HTTP_SUCCESS}" != "true" ]; then

                        echo "ERROR: Application HTTP check failed."

                        exit 1

                    fi
                '''
            }
        }


        stage('54 - Final Deployment Verification') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo ""
                        echo "================================================"
                        echo "        FINAL DEPLOYMENT VERIFICATION"
                        echo "================================================"

                        echo ""

                        echo "AWS Region:"
                        echo "${AWS_DEFAULT_REGION}"

                        echo ""

                        echo "ECR Image:"
                        echo "${ECR_IMAGE}"

                        echo ""

                        echo "ECR Digest:"
                        echo "${ECR_IMAGE_DIGEST}"

                        echo ""

                        echo "ECS Cluster:"
                        echo "${ECS_CLUSTER}"

                        echo ""

                        echo "ECS Service:"
                        echo "${ECS_SERVICE}"

                        echo ""

                        echo "Task Definition:"
                        echo "${TASK_DEFINITION_ARN}"

                        echo ""

                        echo "Launch Type:"
                        echo "FARGATE"

                        echo ""

                        echo "ALB:"
                        echo "${ALB_NAME}"

                        echo ""

                        echo "ALB DNS:"
                        echo "${ALB_DNS}"

                        echo ""

                        echo "================================================"
                        echo "        FINAL APPLICATION URL"
                        echo "================================================"

                        echo "${APPLICATION_URL}"

                        echo ""

                        echo "================================================"
                        echo "          APPLICATION IS LIVE"
                        echo "================================================"
                    '''
                }
            }
        }
    }


    // ================================================================
    // POST ACTIONS
    // ================================================================

    post {

        success {

            echo ''

            echo '================================================'

            echo '       COMPLETE CI/CD PIPELINE SUCCESS'

            echo '================================================'

            echo ''

            echo 'PART 1 - CODE QUALITY      : PASSED'

            echo 'PART 2 - TESTING           : PASSED'

            echo 'PART 3 - DOCKER            : PASSED'

            echo 'PART 4 - ECR               : PASSED'

            echo 'PART 5 - TERRAFORM         : PASSED'

            echo 'PART 6 - ECS FARGATE       : PASSED'

            echo 'PART 6 - ALB               : PASSED'

            echo 'PART 6 - TARGET HEALTH     : PASSED'

            echo 'PART 6 - HTTP CHECK        : PASSED'

            echo ''

            echo '================================================'

            echo '          APPLICATION URL'

            echo '================================================'

            echo "${env.APPLICATION_URL}"

            echo ''

            echo '================================================'

            echo '          DEPLOYMENT COMPLETE'

            echo '================================================'
        }


        failure {

            echo ''

            echo '================================================'

            echo '          CI/CD PIPELINE FAILED'

            echo '================================================'

            echo ''

            echo 'The pipeline stopped at the failed stage.'

            echo ''

            echo 'Review the Jenkins console output above.'

            echo ''

            echo '================================================'
        }


        always {

            echo ''

            echo '================================================'

            echo '       CLEANING JENKINS WORKSPACE'

            echo '================================================'

            cleanWs(
                deleteDirs: true,
                disableDeferredWipeout: true
            )
        }
    }
}
