pipeline {

    agent any

    options {
        timestamps()
        ansiColor('xterm')
        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                daysToKeepStr: '30',
                numToKeepStr: '50'
            )
        )

        timeout(
            time: 90,
            unit: 'MINUTES'
        )
    }

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: [
                'dev',
                'qa',
                'prod'
            ],
            description: 'Select Terraform environment'
        )

        choice(
            name: 'ACTION',
            choices: [
                'DEPLOY',
                'DESTROY'
            ],
            description: 'Select infrastructure action'
        )
    }

    environment {

        AWS_DEFAULT_REGION = 'us-east-1'

        TERRAFORM_REPO =
            'https://github.com/FAIZANSHEIKH223/terraform-aws-infra.git'

        APPLICATION_REPO =
            'https://github.com/FAIZANSHEIKH223/practice1.git'

        QUALITY_REPO =
            'https://github.com/FAIZANSHEIKH223/pylint_flake8_int_jenkins.git'

        ORCHESTRATION_REPO =
            'https://github.com/FAIZANSHEIKH223/CICD-Jenkins-orchestration-repository.git'

        GITHUB_CREDENTIALS = 'github-creds'
        AWS_CREDENTIALS = 'aws-creds'

        TERRAFORM_DIR = 'terraform-aws-infra'
        APPLICATION_DIR = 'application'
        QUALITY_DIR = 'quality-tools'
        ORCHESTRATION_DIR = 'orchestration'

        PROJECT_NAME = 'terraform-demo'

        ECR_REPOSITORY = "terraform-demo-${ENVIRONMENT}"

        ECS_CLUSTER = "terraform-demo-${ENVIRONMENT}-cluster"

        ECS_SERVICE = 'terraform-demo-service'

        ECS_TASK_FAMILY = "terraform-demo-${ENVIRONMENT}-task"

        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages {

        /*
         * ============================================================
         * CHECK TOOLS
         * ============================================================
         */

        stage('Check Required Tools') {

            steps {

                sh '''
                    set -eu

                    echo "=========================================="
                    echo "Checking Required Tools"
                    echo "=========================================="

                    terraform version
                    aws --version
                    docker --version
                    python3.12 --version
                    jq --version
                    curl --version | head -n 1
                    git --version

                    echo ""
                    echo "All required tools are available."
                '''
            }
        }


        /*
         * ============================================================
         * PIPELINE INFORMATION
         * ============================================================
         */

        stage('Pipeline Information') {

            steps {

                echo """
                ==========================================
                Jenkins CI/CD Pipeline
                ==========================================

                Environment : ${params.ENVIRONMENT}
                Action      : ${params.ACTION}
                Build       : ${BUILD_NUMBER}

                Terraform Repository:
                ${env.TERRAFORM_REPO}

                Application Repository:
                ${env.APPLICATION_REPO}

                Quality Repository:
                ${env.QUALITY_REPO}

                Orchestration Repository:
                ${env.ORCHESTRATION_REPO}

                ==========================================
                """
            }
        }


        /*
         * ============================================================
         * CHECKOUT ORCHESTRATION REPOSITORY
         * ============================================================
         */

        stage('Checkout Orchestration Repository') {

            steps {

                dir("${env.ORCHESTRATION_DIR}") {

                    deleteDir()

                    git(
                        branch: 'main',
                        credentialsId: "${env.GITHUB_CREDENTIALS}",
                        url: "${env.ORCHESTRATION_REPO}"
                    )
                }
            }
        }


        /*
         * ============================================================
         * CHECKOUT APPLICATION
         * ============================================================
         */

        stage('Checkout Application Repository') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    deleteDir()

                    git(
                        branch: 'main',
                        credentialsId: "${env.GITHUB_CREDENTIALS}",
                        url: "${env.APPLICATION_REPO}"
                    )
                }
            }
        }


        /*
         * ============================================================
         * CHECKOUT QUALITY TOOLS
         * ============================================================
         */

        stage('Checkout Quality Repository') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.QUALITY_DIR}") {

                    deleteDir()

                    git(
                        branch: 'main',
                        credentialsId: "${env.GITHUB_CREDENTIALS}",
                        url: "${env.QUALITY_REPO}"
                    )
                }
            }
        }


        /*
         * ============================================================
         * CHECKOUT TERRAFORM
         * ============================================================
         */

        stage('Checkout Terraform Repository') {

            when {
                expression {
                    params.ACTION == 'DEPLOY' ||
                    params.ACTION == 'DESTROY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    deleteDir()

                    git(
                        branch: 'main',
                        credentialsId: "${env.GITHUB_CREDENTIALS}",
                        url: "${env.TERRAFORM_REPO}"
                    )
                }
            }
        }


        /*
         * ============================================================
         * PYTHON ENVIRONMENT
         * ============================================================
         */

        stage('Create Python Environment') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    sh '''
                        set -eu

                        rm -rf venv

                        python3.12 -m venv venv

                        ./venv/bin/python --version
                        ./venv/bin/pip --version
                    '''
                }
            }
        }


        /*
         * ============================================================
         * INSTALL APPLICATION DEPENDENCIES
         * ============================================================
         */

        stage('Install Application Dependencies') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    sh '''
                        set -eu

                        ./venv/bin/pip install --upgrade pip

                        if [ -f requirements.txt ]; then
                            ./venv/bin/pip install -r requirements.txt
                        fi

                        ./venv/bin/pip install \
                            pytest \
                            pytest-cov \
                            pylint \
                            flake8 \
                            coverage
                    '''
                }
            }
        }


        /*
         * ============================================================
         * PYTEST
         * ============================================================
         */

        stage('Run Pytest') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    sh '''
                        set -eu

                        mkdir -p reports

                        ./venv/bin/pytest \
                            -v \
                            --junitxml=reports/pytest-results.xml
                    '''
                }
            }
        }


        /*
         * ============================================================
         * COVERAGE
         * ============================================================
         */

        stage('Coverage') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    sh '''
                        set -eu

                        ./venv/bin/coverage run -m pytest

                        ./venv/bin/coverage report

                        ./venv/bin/coverage html \
                            -d reports/coverage
                    '''
                }
            }
        }


        /*
         * ============================================================
         * PYLINT
         * ============================================================
         */

        stage('Pylint') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    sh '''
                        set -eu

                        ./venv/bin/pylint . \
                            --ignore=venv,.git,reports,__pycache__ \
                            --output-format=text \
                            > reports/pylint-report.txt

                        cat reports/pylint-report.txt
                    '''
                }
            }
        }


        /*
         * ============================================================
         * FLAKE8
         * ============================================================
         */

        stage('Flake8') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    sh '''
                        set -eu

                        ./venv/bin/flake8 . \
                            --exclude=venv,.git,reports,__pycache__ \
                            --statistics \
                            --count \
                            --tee \
                            --output-file=reports/flake8-report.txt
                    '''
                }
            }
        }


        /*
         * ============================================================
         * ARCHIVE QUALITY REPORTS
         * ============================================================
         */

        stage('Archive Quality Reports') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                archiveArtifacts(
                    artifacts: 'application/reports/**/*',
                    allowEmptyArchive: true,
                    fingerprint: true
                )

                junit(
                    testResults: 'application/reports/pytest-results.xml',
                    allowEmptyResults: true
                )
            }
        }


        /*
         * ============================================================
         * TERRAFORM BACKEND
         * ============================================================
         */

        stage('Create Terraform Backend') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -eu

                        BUCKET="terraform-state-faizan-001"
                        TABLE="terraform-locks"
                        REGION="$AWS_DEFAULT_REGION"

                        echo "Checking S3 backend..."

                        if aws s3api head-bucket \
                            --bucket "$BUCKET" \
                            --region "$REGION" \
                            >/dev/null 2>&1
                        then

                            echo "S3 bucket already exists."

                        else

                            echo "Creating S3 bucket..."

                            if [ "$REGION" = "us-east-1" ]; then

                                aws s3api create-bucket \
                                    --bucket "$BUCKET" \
                                    --region "$REGION"

                            else

                                aws s3api create-bucket \
                                    --bucket "$BUCKET" \
                                    --region "$REGION" \
                                    --create-bucket-configuration \
                                    LocationConstraint="$REGION"

                            fi

                        fi

                        aws s3api put-bucket-versioning \
                            --bucket "$BUCKET" \
                            --versioning-configuration Status=Enabled

                        echo "Checking DynamoDB lock table..."

                        if aws dynamodb describe-table \
                            --table-name "$TABLE" \
                            --region "$REGION" \
                            >/dev/null 2>&1
                        then

                            echo "DynamoDB table already exists."

                        else

                            aws dynamodb create-table \
                                --table-name "$TABLE" \
                                --attribute-definitions \
                                    AttributeName=LockID,AttributeType=S \
                                --key-schema \
                                    AttributeName=LockID,KeyType=HASH \
                                --billing-mode PAY_PER_REQUEST \
                                --region "$REGION"

                            aws dynamodb wait table-exists \
                                --table-name "$TABLE" \
                                --region "$REGION"

                        fi

                        echo "Terraform backend ready."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * TERRAFORM INIT
         * ============================================================
         */

        stage('Terraform Init') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    withCredentials([
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${env.AWS_CREDENTIALS}"
                        ]
                    ]) {

                        sh '''
                            set -eu

                            BACKEND_CONFIG="backend-${ENVIRONMENT}.conf"

                            if [ ! -f "$BACKEND_CONFIG" ]; then
                                echo "ERROR: $BACKEND_CONFIG not found."
                                exit 1
                            fi

                            terraform init \
                                -reconfigure \
                                -backend-config="$BACKEND_CONFIG"
                        '''
                    }
                }
            }
        }


        /*
         * ============================================================
         * TERRAFORM AUTOMATIC IAM IMPORT
         *
         * IMPORTANT:
         *
         * - Uses environment tfvars.
         * - Never asks Jenkins for variables.
         * - If role exists, imports it.
         * - If role does not exist, does nothing.
         * ============================================================
         */

        stage('Automatic Terraform Resource Import') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    withCredentials([
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${env.AWS_CREDENTIALS}"
                        ]
                    ]) {

                        sh '''
                            set -eu

                            TF_VARS="environments/${ENVIRONMENT}/terraform.tfvars"

                            if [ ! -f "$TF_VARS" ]; then
                                echo "ERROR: Terraform variables file not found:"
                                echo "$TF_VARS"
                                exit 1
                            fi

                            ROLE_NAME="terraform-demo-${ENVIRONMENT}-ecs-instance-role"

                            echo "=========================================="
                            echo "Automatic Terraform Resource Check"
                            echo "=========================================="

                            echo "Environment : $ENVIRONMENT"
                            echo "Role        : $ROLE_NAME"
                            echo "Variables   : $TF_VARS"

                            echo ""
                            echo "Checking IAM role..."

                            if aws iam get-role \
                                --role-name "$ROLE_NAME" \
                                >/dev/null 2>&1
                            then

                                echo "IAM role exists in AWS."

                                if terraform state list \
                                    2>/dev/null \
                                    | grep -Fxq 'module.iam.aws_iam_role.ecs_instance_role'
                                then

                                    echo "IAM role already exists in Terraform state."
                                    echo "No import required."

                                else

                                    echo "IAM role is NOT in Terraform state."
                                    echo "Importing automatically..."

                                    terraform import \
                                        -var-file="$TF_VARS" \
                                        module.iam.aws_iam_role.ecs_instance_role \
                                        "$ROLE_NAME"

                                    echo "IAM role imported successfully."

                                fi

                            else

                                echo "IAM role does not exist."
                                echo "Terraform will create it."
                            fi

                            echo ""
                            echo "Automatic resource check completed."
                        '''
                    }
                }
            }
        }


        /*
         * ============================================================
         * TERRAFORM FORMAT
         * ============================================================
         */

        stage('Terraform Format') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    sh '''
                        set -eu

                        terraform fmt -check -recursive
                    '''
                }
            }
        }


        /*
         * ============================================================
         * TERRAFORM VALIDATE
         * ============================================================
         */

        stage('Terraform Validate') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    sh '''
                        set -eu

                        TF_VARS="environments/${ENVIRONMENT}/terraform.tfvars"

                        terraform validate

                        echo "Terraform validation successful."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * TERRAFORM PLAN
         *
         * container_image is supplied automatically.
         * This prevents Terraform from asking for it.
         * ============================================================
         */

        stage('Terraform Plan') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    withCredentials([
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${env.AWS_CREDENTIALS}"
                        ]
                    ]) {

                        sh '''
                            set -eu

                            TF_VARS="environments/${ENVIRONMENT}/terraform.tfvars"

                            AWS_ACCOUNT_ID=$(aws sts get-caller-identity \
                                --query Account \
                                --output text)

                            ECR_IMAGE="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_DEFAULT_REGION}.amazonaws.com/${ECR_REPOSITORY}:${IMAGE_TAG}"

                            echo "=========================================="
                            echo "Terraform Plan"
                            echo "=========================================="

                            echo "Environment : $ENVIRONMENT"
                            echo "Variables   : $TF_VARS"
                            echo "Image       : $ECR_IMAGE"

                            terraform plan \
                                -var-file="$TF_VARS" \
                                -var="container_image=$ECR_IMAGE" \
                                -out=tfplan

                            echo "Terraform plan completed."
                        '''
                    }
                }
            }
        }


        /*
         * ============================================================
         * TERRAFORM APPROVAL
         * ============================================================
         */

        stage('Terraform Approval') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                input(
                    message: "Terraform plan completed. Deploy ${params.ENVIRONMENT}?",
                    ok: "Deploy"
                )
            }
        }


        /*
         * ============================================================
         * TERRAFORM APPLY
         * ============================================================
         */

        stage('Terraform Apply') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    withCredentials([
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${env.AWS_CREDENTIALS}"
                        ]
                    ]) {

                        sh '''
                            set -eu

                            terraform apply \
                                -auto-approve \
                                tfplan

                            echo "Terraform apply completed successfully."
                        '''
                    }
                }
            }
        }


        /*
         * ============================================================
         * WAIT FOR AWS
         * ============================================================
         */

        stage('Wait For Infrastructure') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                sh '''
                    set -eu

                    echo "Waiting for AWS infrastructure..."
                    sleep 20
                '''
            }
        }


        /*
         * ============================================================
         * PREPARE ECR
         * ============================================================
         */

        stage('Prepare ECR Repository') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -eu

                        if aws ecr describe-repositories \
                            --repository-names "$ECR_REPOSITORY" \
                            --region "$AWS_DEFAULT_REGION" \
                            >/dev/null 2>&1
                        then

                            echo "ECR repository already exists."

                        else

                            echo "Creating ECR repository..."

                            aws ecr create-repository \
                                --repository-name "$ECR_REPOSITORY" \
                                --region "$AWS_DEFAULT_REGION"

                        fi
                    '''
                }
            }
        }


        /*
         * ============================================================
         * DOCKER BUILD
         * ============================================================
         */

        stage('Docker Build') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    withCredentials([
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${env.AWS_CREDENTIALS}"
                        ]
                    ]) {

                        sh '''
                            set -eu

                            if [ ! -f Dockerfile ]; then
                                echo "ERROR: Dockerfile not found."
                                exit 1
                            fi

                            AWS_ACCOUNT_ID=$(aws sts get-caller-identity \
                                --query Account \
                                --output text)

                            ECR_REGISTRY="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_DEFAULT_REGION}.amazonaws.com"

                            IMAGE="${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}"

                            LATEST_IMAGE="${ECR_REGISTRY}/${ECR_REPOSITORY}:latest"

                            docker build \
                                -t "$IMAGE" \
                                -t "$LATEST_IMAGE" \
                                .

                            echo "$IMAGE" > ../docker-image.txt
                        '''
                    }
                }
            }
        }


        /*
         * ============================================================
         * ECR LOGIN
         * ============================================================
         */

        stage('Login To ECR') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -eu

                        AWS_ACCOUNT_ID=$(aws sts get-caller-identity \
                            --query Account \
                            --output text)

                        ECR_REGISTRY="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_DEFAULT_REGION}.amazonaws.com"

                        aws ecr get-login-password \
                            --region "$AWS_DEFAULT_REGION" \
                        | docker login \
                            --username AWS \
                            --password-stdin "$ECR_REGISTRY"
                    '''
                }
            }
        }


        /*
         * ============================================================
         * PUSH IMAGE
         * ============================================================
         */

        stage('Push Docker Image') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                sh '''
                    set -eu

                    IMAGE=$(cat docker-image.txt)

                    AWS_ACCOUNT_ID=$(aws sts get-caller-identity \
                        --query Account \
                        --output text)

                    ECR_REGISTRY="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_DEFAULT_REGION}.amazonaws.com"

                    LATEST_IMAGE="${ECR_REGISTRY}/${ECR_REPOSITORY}:latest"

                    docker push "$IMAGE"
                    docker push "$LATEST_IMAGE"

                    echo "Docker images pushed successfully."
                '''
            }
        }


        /*
         * ============================================================
         * VERIFY ECR
         * ============================================================
         */

        stage('Verify ECR') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -eu

                        aws ecr describe-images \
                            --repository-name "$ECR_REPOSITORY" \
                            --region "$AWS_DEFAULT_REGION"

                        echo "ECR verification successful."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * ECS CLUSTER
         * ============================================================
         */

        stage('Verify ECS Cluster') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -eu

                        aws ecs describe-clusters \
                            --clusters "$ECS_CLUSTER" \
                            --region "$AWS_DEFAULT_REGION"

                        echo "ECS cluster verified."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * REGISTER ECS TASK
         * ============================================================
         */

        stage('Register ECS Task Definition') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -eu

                        AWS_ACCOUNT_ID=$(aws sts get-caller-identity \
                            --query Account \
                            --output text)

                        ECR_IMAGE="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_DEFAULT_REGION}.amazonaws.com/${ECR_REPOSITORY}:${IMAGE_TAG}"

                        EXECUTION_ROLE="arn:aws:iam::${AWS_ACCOUNT_ID}:role/terraform-demo-${ENVIRONMENT}-ecs-task-execution-role"

                        cat > ecs-task-definition.json <<EOF
{
    "family": "${ECS_TASK_FAMILY}",
    "networkMode": "bridge",
    "requiresCompatibilities": [
        "EC2"
    ],
    "cpu": "256",
    "memory": "512",
    "executionRoleArn": "${EXECUTION_ROLE}",
    "containerDefinitions": [
        {
            "name": "app",
            "image": "${ECR_IMAGE}",
            "essential": true,
            "cpu": 256,
            "memory": 512,
            "portMappings": [
                {
                    "containerPort": 8501,
                    "hostPort": 8501,
                    "protocol": "tcp"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/terraform-demo",
                    "awslogs-region": "${AWS_DEFAULT_REGION}",
                    "awslogs-stream-prefix": "ecs"
                }
            }
        }
    ]
}
EOF

                        aws ecs register-task-definition \
                            --cli-input-json file://ecs-task-definition.json \
                            --region "$AWS_DEFAULT_REGION"

                        echo "ECS task definition registered."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * GET ECS REVISION
         * ============================================================
         */

        stage('Get ECS Revision') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -eu

                        REVISION=$(aws ecs describe-task-definition \
                            --task-definition "$ECS_TASK_FAMILY" \
                            --region "$AWS_DEFAULT_REGION" \
                            --query 'taskDefinition.revision' \
                            --output text)

                        echo "$REVISION" > ecs-revision.txt

                        echo "ECS revision: $REVISION"
                    '''
                }
            }
        }


        /*
         * ============================================================
         * DEPLOY ECS
         * ============================================================
         */

        stage('Deploy ECS Service') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -eu

                        REVISION=$(cat ecs-revision.txt)

                        aws ecs update-service \
                            --cluster "$ECS_CLUSTER" \
                            --service "$ECS_SERVICE" \
                            --task-definition "${ECS_TASK_FAMILY}:${REVISION}" \
                            --force-new-deployment \
                            --region "$AWS_DEFAULT_REGION"

                        echo "ECS deployment started."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * WAIT ECS
         * ============================================================
         */

        stage('Wait For ECS Deployment') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -eu

                        aws ecs wait services-stable \
                            --cluster "$ECS_CLUSTER" \
                            --services "$ECS_SERVICE" \
                            --region "$AWS_DEFAULT_REGION"

                        echo "ECS service is stable."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * HEALTH CHECK
         * ============================================================
         */

        stage('Health Check') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    sh '''
                        set -eu

                        ALB_DNS=$(terraform output \
                            -raw alb_dns_name)

                        echo "ALB DNS:"
                        echo "$ALB_DNS"

                        echo "Waiting for ALB..."

                        sleep 30

                        curl \
                            --fail \
                            --max-time 15 \
                            "http://${ALB_DNS}/"

                        echo ""
                        echo "Application health check successful."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * DEPLOY SUCCESS
         * ============================================================
         */

        stage('Deployment Successful') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                echo """
                ==========================================
                DEPLOYMENT SUCCESSFUL
                ==========================================

                Environment : ${params.ENVIRONMENT}
                Build       : ${BUILD_NUMBER}

                Application : SUCCESS
                Pytest      : SUCCESS
                Coverage    : SUCCESS
                Pylint      : SUCCESS
                Flake8      : SUCCESS

                Terraform   : SUCCESS
                Docker      : SUCCESS
                ECR         : SUCCESS
                ECS         : SUCCESS
                Health      : SUCCESS

                ==========================================
                """
            }
        }


        /*
         * ============================================================
         * DESTROY - INIT
         * ============================================================
         */

        stage('Destroy - Terraform Init') {

            when {
                expression {
                    params.ACTION == 'DESTROY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    withCredentials([
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${env.AWS_CREDENTIALS}"
                        ]
                    ]) {

                        sh '''
                            set -eu

                            BACKEND_CONFIG="backend-${ENVIRONMENT}.conf"

                            terraform init \
                                -reconfigure \
                                -backend-config="$BACKEND_CONFIG"
                        '''
                    }
                }
            }
        }


        /*
         * ============================================================
         * DESTROY
         * ============================================================
         */

        stage('Terraform Destroy') {

            when {
                expression {
                    params.ACTION == 'DESTROY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    withCredentials([
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${env.AWS_CREDENTIALS}"
                        ]
                    ]) {

                        sh '''
                            set -eu

                            TF_VARS="environments/${ENVIRONMENT}/terraform.tfvars"

                            echo "=========================================="
                            echo "Terraform Destroy"
                            echo "=========================================="

                            terraform destroy \
                                -var-file="$TF_VARS" \
                                -auto-approve

                            echo "Terraform destroy completed."
                        '''
                    }
                }
            }
        }


        /*
         * ============================================================
         * DESTROY SUCCESS
         * ============================================================
         */

        stage('Destroy Successful') {

            when {
                expression {
                    params.ACTION == 'DESTROY'
                }
            }

            steps {

                echo """
                ==========================================
                DESTROY SUCCESSFUL
                ==========================================

                Environment : ${params.ENVIRONMENT}
                Build       : ${BUILD_NUMBER}

                Terraform infrastructure removed.

                ==========================================
                """
            }
        }
    }


    /*
     * ================================================================
     * POST
     * ================================================================
     */

    post {

        always {

            echo "Cleaning Jenkins workspace..."

            cleanWs(
                deleteDirs: true,
                disableDeferredWipeout: true
            )
        }

        success {

            echo """
            ==========================================
            PIPELINE SUCCESS
            ==========================================
            """
        }

        failure {

            echo """
            ==========================================
            PIPELINE FAILED
            ==========================================

            Check the failed stage above.
            ==========================================
            """
        }
    }
}
