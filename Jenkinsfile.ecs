pipeline {

    agent any

    // ================================================================
    // PIPELINE OPTIONS
    // ================================================================

    options {

        timestamps()

        ansiColor('xterm')

        // Prevent two builds from changing the same workspace
        // at the same time.
        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                daysToKeepStr: '30',
                numToKeepStr: '50'
            )
        )

        timeout(
            time: 30,
            unit: 'MINUTES'
        )
    }


    // ================================================================
    // ENVIRONMENT
    // ================================================================

    environment {

        // ------------------------------------------------------------
        // APPLICATION REPOSITORY
        // ------------------------------------------------------------

        APP_REPO =
            'https://github.com/FAIZANSHEIKH223/practice1.git'

        APP_BRANCH = 'main'


        // ------------------------------------------------------------
        // QUALITY REPOSITORY
        // ------------------------------------------------------------

        QUALITY_REPO =
            'https://github.com/FAIZANSHEIKH223/pylint_flake8_int_jenkins.git'

        QUALITY_BRANCH = 'main'


        // ------------------------------------------------------------
        // JENKINS GITHUB CREDENTIAL
        // ------------------------------------------------------------

        GITHUB_CREDENTIALS = 'github-creds'


        // ------------------------------------------------------------
        // PYTHON
        // ------------------------------------------------------------

        PYTHON = 'python3.12'


        // ------------------------------------------------------------
        // WORKSPACE DIRECTORIES
        // ------------------------------------------------------------

        APP_DIR = 'practice1'

        QUALITY_DIR = 'quality-tools'

        VENV_DIR = 'venv'

        REPORT_DIR = 'reports'
    }


    // ================================================================
    // STAGES
    // ================================================================

    stages {


        // ============================================================
        // STAGE 1
        // CHECKOUT APPLICATION
        // ============================================================

        stage('1 - Checkout Application') {

            steps {

                echo ''
                echo '================================================'
                echo 'CHECKOUT APPLICATION'
                echo '================================================'
                echo "Repository : ${APP_REPO}"
                echo "Branch     : ${APP_BRANCH}"
                echo '================================================'

                dir("${APP_DIR}") {

                    git(
                        branch: "${APP_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${APP_REPO}"
                    )
                }
            }
        }


        // ============================================================
        // STAGE 2
        // CHECKOUT QUALITY REPOSITORY
        // ============================================================

        stage('2 - Checkout Quality Repository') {

            steps {

                echo ''
                echo '================================================'
                echo 'CHECKOUT QUALITY REPOSITORY'
                echo '================================================'
                echo "Repository : ${QUALITY_REPO}"
                echo "Branch     : ${QUALITY_BRANCH}"
                echo '================================================'

                dir("${QUALITY_DIR}") {

                    git(
                        branch: "${QUALITY_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${QUALITY_REPO}"
                    )
                }
            }
        }


        // ============================================================
        // STAGE 3
        // VERIFY PYTHON
        // ============================================================

        stage('3 - Verify Python') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo ""
                        echo "================================================"
                        echo "VERIFYING PYTHON"
                        echo "================================================"

                        command -v ${PYTHON}

                        ${PYTHON} --version

                        echo ""
                        echo "================================================"
                        echo "VERIFYING PIP"
                        echo "================================================"

                        ${PYTHON} -m pip --version

                        echo ""
                        echo "Python environment verification completed."
                    '''
                }
            }
        }


        // ============================================================
        // STAGE 4
        // CREATE VIRTUAL ENVIRONMENT
        // ============================================================

        stage('4 - Create Python Virtual Environment') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo ""
                        echo "================================================"
                        echo "CREATING VIRTUAL ENVIRONMENT"
                        echo "================================================"

                        # Remove only the previous CI virtual
                        # environment.
                        #
                        # This makes repeated builds clean and
                        # predictable.

                        rm -rf "${VENV_DIR}"

                        ${PYTHON} -m venv "${VENV_DIR}"

                        echo ""
                        echo "Virtual environment created."

                        "${VENV_DIR}/bin/python" --version
                    '''
                }
            }
        }


        // ============================================================
        // STAGE 5
        // INSTALL APPLICATION DEPENDENCIES
        // ============================================================

        stage('5 - Install Application Dependencies') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo ""
                        echo "================================================"
                        echo "INSTALLING APPLICATION DEPENDENCIES"
                        echo "================================================"

                        "${VENV_DIR}/bin/python" \
                            -m pip install --upgrade pip

                        if [ -f requirements.txt ]; then

                            echo ""
                            echo "requirements.txt found."

                            "${VENV_DIR}/bin/pip" \
                                install \
                                -r requirements.txt

                        else

                            echo ""
                            echo "No requirements.txt found."

                            echo "No application dependencies to install."

                        fi

                        echo ""
                        echo "Application dependency installation completed."
                    '''
                }
            }
        }


        // ============================================================
        // STAGE 6
        // INSTALL FLAKE8 + PYLINT
        // ============================================================

        stage('6 - Install Quality Tools') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo ""
                        echo "================================================"
                        echo "INSTALLING QUALITY TOOLS"
                        echo "================================================"

                        "${VENV_DIR}/bin/pip" install \
                            flake8 \
                            pylint

                        echo ""
                        echo "================================================"
                        echo "FLAKE8 VERSION"
                        echo "================================================"

                        "${VENV_DIR}/bin/flake8" --version

                        echo ""
                        echo "================================================"
                        echo "PYLINT VERSION"
                        echo "================================================"

                        "${VENV_DIR}/bin/pylint" --version

                        echo ""
                        echo "Quality tools installed successfully."
                    '''
                }
            }
        }


        // ============================================================
        // STAGE 7
        // FLAKE8
        // ============================================================

        stage('7 - Flake8 Code Quality') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo ""
                        echo "================================================"
                        echo "RUNNING FLAKE8"
                        echo "================================================"

                        mkdir -p "${REPORT_DIR}"

                        "${VENV_DIR}/bin/flake8" \
                            . \
                            --exclude="${VENV_DIR},.git,${REPORT_DIR},__pycache__" \
                            --count \
                            --statistics \
                            --tee \
                            --output-file="${REPORT_DIR}/flake8-report.txt"

                        echo ""
                        echo "================================================"
                        echo "FLAKE8 PASSED"
                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // STAGE 8
        // PYLINT
        // ============================================================


        stage('8 - Pylint Code Quality') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo ""
                        echo "================================================"
                        echo "RUNNING PYLINT"
                        echo "================================================"

                        mkdir -p "${REPORT_DIR}"

                        echo ""
                        echo "Python files to analyze:"
                        find . \
                            -type f \
                            -name "*.py" \
                            ! -path "./${VENV_DIR}/*" \
                            ! -path "./.git/*" \
                            ! -path "./${REPORT_DIR}/*" \
                            ! -path "*/__pycache__/*"

                        echo ""
                        echo "Starting Pylint..."

                        PYTHON_FILES=$(find . \
                            -type f \
                            -name "*.py" \
                            ! -path "./${VENV_DIR}/*" \
                            ! -path "./.git/*" \
                            ! -path "./${REPORT_DIR}/*" \
                            ! -path "*/__pycache__/*")

                        if [ -z "${PYTHON_FILES}" ]; then
                            echo "No Python files found for Pylint."
                            exit 1
                        fi

                        "${VENV_DIR}/bin/pylint" \
                            ${PYTHON_FILES} \
                            --output-format=text \
                            > "${REPORT_DIR}/pylint-report.txt"

                        echo ""
                        echo "================================================"
                        echo "PYLINT PASSED"
                        echo "================================================"
                    '''
                }
            }
        }



                // ============================================================
                // STAGE 9
                // PART 1 SUCCESS
                // ============================================================

                stage('9 - Part 1 Success') {

                    steps {

                        echo ''
                        echo '================================================'
                        echo '           PART 1 CI SUCCESS'
                        echo '================================================'
                        echo ''
                        echo 'Application Repository : practice1'
                        echo 'Quality Repository     : pylint_flake8_int_jenkins'
                        echo 'Python                 : 3.12'
                        echo ''
                        echo 'Checkout               : PASSED'
                        echo 'Python Environment     : PASSED'
                        echo 'Dependencies           : PASSED'
                        echo 'Flake8                 : PASSED'
                        echo 'Pylint                 : PASSED'
                        echo ''
                        echo '================================================'
                        echo '       READY FOR PART 2'
                        echo '================================================'
                    }
                }
            }


    // ================================================================
    // POST ACTIONS
    // ================================================================

    post {

        success {

            echo ''
            echo '================================================'
            echo '          PART 1 PIPELINE SUCCESS'
            echo '================================================'
            echo ''
            echo 'All Part 1 stages completed successfully.'
            echo ''
            echo 'Do NOT add Docker/ECR/Terraform yet.'
            echo 'Part 1 is complete.'
            echo '================================================'
        }


        failure {

            echo ''
            echo '================================================'
            echo '          PART 1 PIPELINE FAILED'
            echo '================================================'
            echo ''
            echo 'The pipeline stopped at the failed stage.'
            echo ''
            echo 'Fix Part 1 before continuing to Part 2.'
            echo '================================================'
        }


        always {

            echo ''
            echo '================================================'
            echo 'CLEANING JENKINS WORKSPACE'
            echo '================================================'

            cleanWs(
                deleteDirs: true,
                disableDeferredWipeout: true
            )
        }
    }
}

pipeline {

    agent any

    options {
        timestamps()
        ansiColor('xterm')
        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                daysToKeepStr: '30',
                numToKeepStr: '50'
            )
        )

        timeout(
            time: 30,
            unit: 'MINUTES'
        )
    }

    environment {

        // ============================================================
        // APPLICATION REPOSITORY
        // ============================================================

        APP_REPO =
            'https://github.com/FAIZANSHEIKH223/practice1.git'

        APP_BRANCH = 'main'


        // ============================================================
        // QUALITY REPOSITORY
        // ============================================================

        QUALITY_REPO =
            'https://github.com/FAIZANSHEIKH223/pylint_flake8_int_jenkins.git'

        QUALITY_BRANCH = 'main'


        // ============================================================
        // JENKINS CREDENTIAL
        // ============================================================

        GITHUB_CREDENTIALS = 'github-creds'


        // ============================================================
        // PYTHON
        // ============================================================

        PYTHON = 'python3.12'


        // ============================================================
        // DIRECTORIES
        // ============================================================

        APP_DIR = 'practice1'

        QUALITY_DIR = 'quality-tools'

        VENV_DIR = 'venv'

        REPORT_DIR = 'reports'
    }


    stages {


        // ============================================================
        // PART 1
        // 1. CHECKOUT APPLICATION
        // ============================================================

        stage('1 - Checkout Application') {

            steps {

                dir("${APP_DIR}") {

                    git(
                        branch: "${APP_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${APP_REPO}"
                    )
                }
            }
        }


        // ============================================================
        // PART 1
        // 2. CHECKOUT QUALITY REPOSITORY
        // ============================================================

        stage('2 - Checkout Quality Repository') {

            steps {

                dir("${QUALITY_DIR}") {

                    git(
                        branch: "${QUALITY_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${QUALITY_REPO}"
                    )
                }
            }
        }


        // ============================================================
        // PART 1
        // 3. VERIFY PYTHON
        // ============================================================

        stage('3 - Verify Python') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "========================================"
                        echo "Python version"
                        echo "========================================"

                        command -v ${PYTHON}

                        ${PYTHON} --version

                        echo ""
                        echo "========================================"
                        echo "Pip version"
                        echo "========================================"

                        ${PYTHON} -m pip --version
                    '''
                }
            }
        }


        // ============================================================
        // PART 1
        // 4. CREATE VIRTUAL ENVIRONMENT
        // ============================================================

        stage('4 - Create Python Virtual Environment') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "Creating Python virtual environment..."

                        rm -rf "${VENV_DIR}"

                        ${PYTHON} -m venv "${VENV_DIR}"

                        "${VENV_DIR}/bin/python" --version

                        echo "Virtual environment created successfully."
                    '''
                }
            }
        }


        // ============================================================
        // PART 1
        // 5. INSTALL APPLICATION DEPENDENCIES
        // ============================================================

        stage('5 - Install Application Dependencies') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "Installing application dependencies..."

                        "${VENV_DIR}/bin/python" \
                            -m pip install --upgrade pip

                        if [ -f requirements.txt ]; then

                            echo "requirements.txt found."

                            "${VENV_DIR}/bin/pip" \
                                install \
                                -r requirements.txt

                        else

                            echo "No requirements.txt found."

                        fi

                        echo "Application dependencies installed."
                    '''
                }
            }
        }


        // ============================================================
        // PART 1
        // 6. INSTALL FLAKE8 AND PYLINT
        // ============================================================

        stage('6 - Install Quality Tools') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "Installing Flake8 and Pylint..."

                        "${VENV_DIR}/bin/pip" install \
                            flake8 \
                            pylint

                        echo ""
                        echo "Flake8:"
                        "${VENV_DIR}/bin/flake8" --version

                        echo ""
                        echo "Pylint:"
                        "${VENV_DIR}/bin/pylint" --version
                    '''
                }
            }
        }


        // ============================================================
        // PART 1
        // 7. FLAKE8
        // ============================================================

        stage('7 - Flake8 Code Quality') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "Running Flake8..."

                        mkdir -p "${REPORT_DIR}"

                        "${VENV_DIR}/bin/flake8" \
                            . \
                            --exclude="${VENV_DIR},.git,${REPORT_DIR},__pycache__" \
                            --count \
                            --statistics \
                            --tee \
                            --output-file="${REPORT_DIR}/flake8-report.txt"

                        echo "Flake8 PASSED."
                    '''
                }
            }
        }


        // ============================================================
        // PART 1
        // 8. PYLINT
        // ============================================================

        stage('8 - Pylint Code Quality') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "Running Pylint..."

                        mkdir -p "${REPORT_DIR}"

                        PYTHON_FILES=$(find . \
                            -type f \
                            -name "*.py" \
                            ! -path "./${VENV_DIR}/*" \
                            ! -path "./.git/*" \
                            ! -path "./${REPORT_DIR}/*" \
                            ! -path "*/__pycache__/*")

                        if [ -z "${PYTHON_FILES}" ]; then

                            echo "ERROR: No Python files found."

                            exit 1

                        fi

                        "${VENV_DIR}/bin/pylint" \
                            ${PYTHON_FILES} \
                            --output-format=text \
                            > "${REPORT_DIR}/pylint-report.txt"

                        echo "Pylint PASSED."
                    '''
                }
            }
        }


        // ============================================================
        // PART 1 COMPLETE
        // ============================================================

        stage('9 - Part 1 Complete') {

            steps {

                echo ""
                echo "================================================"
                echo "             PART 1 COMPLETE"
                echo "================================================"
                echo ""
                echo "Flake8 : PASSED"
                echo "Pylint : PASSED"
                echo ""
                echo "Starting Part 2..."
                echo "================================================"
            }
        }


        // ============================================================
        // PART 2
        // 10. INSTALL PYTEST
        // ============================================================

        stage('10 - Install Pytest') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo ""
                        echo "================================================"
                        echo "INSTALLING PYTEST"
                        echo "================================================"

                        "${VENV_DIR}/bin/pip" install pytest

                        echo ""
                        echo "Pytest version:"

                        "${VENV_DIR}/bin/pytest" --version

                        echo ""
                        echo "Pytest installed successfully."
                    '''
                }
            }
        }


        // ============================================================
        // PART 2
        // 11. CHECK TEST DIRECTORY
        // ============================================================

        stage('11 - Verify Tests') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo ""
                        echo "================================================"
                        echo "VERIFYING TESTS"
                        echo "================================================"

                        if [ ! -d "tests" ]; then

                            echo "ERROR: tests/ directory does not exist."

                            echo ""
                            echo "Expected:"
                            echo "tests/"
                            echo "└── test_app.py"

                            exit 1
                        fi

                        TEST_FILES=$(find tests \
                            -type f \
                            \\( \
                                -name "test_*.py" \
                                -o \
                                -name "*_test.py" \
                            \\))

                        if [ -z "${TEST_FILES}" ]; then

                            echo "ERROR: No pytest test files found."

                            exit 1
                        fi

                        echo ""
                        echo "Test files found:"
                        echo "${TEST_FILES}"

                        echo ""
                        echo "Test verification PASSED."
                    '''
                }
            }
        }


        // ============================================================
        // PART 2
        // 12. RUN PYTEST
        // ============================================================

        stage('12 - Run Automated Tests') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo ""
                        echo "================================================"
                        echo "RUNNING AUTOMATED TESTS"
                        echo "================================================"

                        mkdir -p "${REPORT_DIR}"

                        "${VENV_DIR}/bin/pytest" \
                            tests/ \
                            -v \
                            --junitxml="${REPORT_DIR}/pytest-results.xml"

                        echo ""
                        echo "================================================"
                        echo "ALL TESTS PASSED"
                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // PART 2
        // 13. PUBLISH TEST RESULTS
        // ============================================================

        stage('13 - Publish Test Results') {

            steps {

                junit(
                    testResults:
                        "${APP_DIR}/${REPORT_DIR}/pytest-results.xml",
                    allowEmptyResults: false
                )

                archiveArtifacts(
                    artifacts:
                        "${APP_DIR}/${REPORT_DIR}/pytest-results.xml," +
                        "${APP_DIR}/${REPORT_DIR}/flake8-report.txt," +
                        "${APP_DIR}/${REPORT_DIR}/pylint-report.txt",

                    allowEmptyArchive: false,

                    fingerprint: true
                )
            }
        }


        // ============================================================
        // PART 2 COMPLETE
        // ============================================================

        stage('14 - Part 2 Complete') {

            steps {

                echo ""
                echo "================================================"
                echo "             PART 2 COMPLETE"
                echo "================================================"
                echo ""
                echo "PART 1"
                echo "Flake8 : PASSED"
                echo "Pylint : PASSED"
                echo ""
                echo "PART 2"
                echo "Pytest : PASSED"
                echo "Reports: GENERATED"
                echo ""
                echo "================================================"
                echo "       READY FOR PART 3 - DOCKER"
                echo "================================================"
            }
        }
    }


    // ================================================================
    // POST ACTIONS
    // ================================================================

    post {

        success {

            echo ""
            echo "================================================"
            echo "          PIPELINE SUCCESS"
            echo "================================================"
            echo ""
            echo "Part 1 : PASSED"
            echo "Part 2 : PASSED"
            echo ""
            echo "Part 2 is complete."
            echo "================================================"
        }


        failure {

            echo ""
            echo "================================================"
            echo "          PIPELINE FAILED"
            echo "================================================"
            echo ""
            echo "Check the failed stage above."
            echo ""
            echo "DO NOT MOVE TO PART 3."
            echo "Fix Part 2 first."
            echo "================================================"
        }


        always {

            echo ""
            echo "================================================"
            echo "          CLEANING WORKSPACE"
            echo "================================================"

            cleanWs(
                deleteDirs: true,
                disableDeferredWipeout: true
            )
        }
    }
}
