pipeline {

    agent any

    options {
        timestamps()
        ansiColor('xterm')
        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                daysToKeepStr: '30',
                numToKeepStr: '50'
            )
        )

        timeout(
            time: 90,
            unit: 'MINUTES'
        )
    }

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: [
                'dev',
                'qa',
                'prod'
            ],
            description: 'Select Terraform environment'
        )

        choice(
            name: 'ACTION',
            choices: [
                'DEPLOY',
                'DESTROY'
            ],
            description: 'Select infrastructure action'
        )
    }

    environment {

        AWS_DEFAULT_REGION = 'us-east-1'

        TERRAFORM_REPO =
            'https://github.com/FAIZANSHEIKH223/terraform-aws-infra.git'

        APPLICATION_REPO =
            'https://github.com/FAIZANSHEIKH223/practice1.git'

        QUALITY_REPO =
            'https://github.com/FAIZANSHEIKH223/pylint_flake8_int_jenkins.git'

        ORCHESTRATION_REPO =
            'https://github.com/FAIZANSHEIKH223/CICD-Jenkins-orchestration-repository.git'

        GITHUB_CREDENTIALS = 'github-creds'

        AWS_CREDENTIALS = 'aws-creds'

        TERRAFORM_DIR = 'terraform-aws-infra'

        APPLICATION_DIR = 'application'

        QUALITY_DIR = 'quality-tools'

        PROJECT_NAME = 'terraform-demo'

        ECR_REPOSITORY = 'terraform-demo-dev'

        ECS_CLUSTER = 'terraform-demo-dev-cluster'

        ECS_SERVICE = 'terraform-demo-service'

        ECS_TASK_FAMILY = 'terraform-demo-task'

        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages {

        /*
         * ============================================================
         * CHECK REQUIRED TOOLS
         * ============================================================
         */

        stage('Check Required Tools') {

            steps {

                sh '''
                    set -e

                    echo "=========================================="
                    echo "Checking Required Tools"
                    echo "=========================================="

                    echo ""
                    echo "Terraform:"
                    terraform version

                    echo ""
                    echo "AWS CLI:"
                    aws --version

                    echo ""
                    echo "Docker:"
                    docker --version

                    echo ""
                    echo "Python:"
                    python3.12 --version

                    echo ""
                    echo "JQ:"
                    jq --version

                    echo ""
                    echo "Curl:"
                    curl --version | head -n 1

                    echo ""
                    echo "Git:"
                    git --version

                    echo ""
                    echo "=========================================="
                    echo "All Required Tools Found"
                    echo "=========================================="
                '''
            }
        }


        /*
         * ============================================================
         * CHECK ACTION
         * ============================================================
         */

        stage('Check Pipeline Action') {

            steps {

                echo """
                ==========================================
                Pipeline Action
                ==========================================

                Environment : ${params.ENVIRONMENT}
                Action      : ${params.ACTION}
                Build       : ${BUILD_NUMBER}

                ==========================================
                """
            }
        }


        /*
         * ============================================================
         * CHECKOUT TERRAFORM REPOSITORY
         * ============================================================
         */

        stage('Checkout Terraform Repository') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    deleteDir()

                    git(
                        branch: 'main',
                        credentialsId: "${env.GITHUB_CREDENTIALS}",
                        url: "${env.TERRAFORM_REPO}"
                    )
                }
            }
        }


        /*
         * ============================================================
         * FIX STALE TERRAFORM IMPORT AUTOMATICALLY
         *
         * IMPORTANT:
         *
         * Your current failure is caused by an import block referring
         * to an IAM role which does not exist.
         *
         * Jenkins removes that stale import block automatically.
         *
         * No manual Terraform modification is required.
         * ============================================================
         */

        stage('Fix Terraform Import Configuration') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    sh '''
                        set -e

                        echo "=========================================="
                        echo "Checking Terraform Import Blocks"
                        echo "=========================================="

                        FOUND_IMPORT="false"

                        while IFS= read -r -d '' FILE
                        do
                            if grep -q \
                              'module\\.ec2\\.aws_iam_role\\.ecs_instance_role' \
                              "$FILE"
                            then

                                echo ""
                                echo "Found EC2 ECS IAM role import in:"
                                echo "$FILE"

                                cp "$FILE" "${FILE}.jenkins-backup"

                                python3.12 - "$FILE" <<'PYTHON'
import sys
import re

file_path = sys.argv[1]

with open(file_path, "r", encoding="utf-8") as f:
    content = f.read()

pattern = re.compile(
    r'import\\s*\\{'
    r'(?=[^}]*module\\.ec2\\.aws_iam_role\\.ecs_instance_role)'
    r'[^}]*\\}',
    re.DOTALL
)

new_content, count = pattern.subn("", content)

if count:
    with open(file_path, "w", encoding="utf-8") as f:
        f.write(new_content)

    print(
        f"Removed {count} stale Terraform import block(s) "
        f"from {file_path}"
    )
else:
    print(
        f"No matching import block found in {file_path}"
    )
PYTHON

                                FOUND_IMPORT="true"
                            fi

                        done < <(
                            find . \
                                -type f \
                                -name "*.tf" \
                                -print0
                        )

                        if [ "$FOUND_IMPORT" = "true" ]; then
                            echo ""
                            echo "Stale import configuration removed."
                        else
                            echo ""
                            echo "No stale import configuration found."
                        fi

                        echo ""
                        echo "Terraform import configuration check completed."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * TERRAFORM FORMAT
         * ============================================================
         */

        stage('Terraform Format') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    sh '''
                        set -e

                        echo "Running Terraform format check..."

                        terraform fmt -check -recursive

                        echo "Terraform format check passed."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * CREATE TERRAFORM BACKEND
         * ============================================================
         */

        stage('Create Terraform Backend') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -e

                        BUCKET="terraform-state-faizan-001"
                        TABLE="terraform-locks"
                        REGION="${AWS_DEFAULT_REGION}"

                        echo "=========================================="
                        echo "Checking Terraform Backend Resources"
                        echo "=========================================="

                        if aws s3api head-bucket \
                            --bucket "$BUCKET" \
                            --region "$REGION" \
                            2>/dev/null
                        then
                            echo "S3 bucket already exists: $BUCKET"
                        else
                            echo "Creating S3 bucket: $BUCKET"

                            if [ "$REGION" = "us-east-1" ]; then

                                aws s3api create-bucket \
                                    --bucket "$BUCKET" \
                                    --region "$REGION"

                            else

                                aws s3api create-bucket \
                                    --bucket "$BUCKET" \
                                    --region "$REGION" \
                                    --create-bucket-configuration \
                                    LocationConstraint="$REGION"

                            fi

                            aws s3api put-bucket-versioning \
                                --bucket "$BUCKET" \
                                --versioning-configuration \
                                Status=Enabled

                            aws s3api put-bucket-encryption \
                                --bucket "$BUCKET" \
                                --server-side-encryption-configuration \
                                '{
                                    "Rules": [
                                        {
                                            "ApplyServerSideEncryptionByDefault": {
                                                "SSEAlgorithm": "AES256"
                                            }
                                        }
                                    ]
                                }'
                        fi


                        if aws dynamodb describe-table \
                            --table-name "$TABLE" \
                            --region "$REGION" \
                            >/dev/null 2>&1
                        then

                            echo "DynamoDB table already exists: $TABLE"

                        else

                            echo "Creating DynamoDB table: $TABLE"

                            aws dynamodb create-table \
                                --table-name "$TABLE" \
                                --attribute-definitions \
                                    AttributeName=LockID,AttributeType=S \
                                --key-schema \
                                    AttributeName=LockID,KeyType=HASH \
                                --billing-mode PAY_PER_REQUEST \
                                --region "$REGION"

                            aws dynamodb wait table-exists \
                                --table-name "$TABLE" \
                                --region "$REGION"

                        fi

                        echo ""
                        echo "Terraform backend is ready."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * TERRAFORM INIT
         * ============================================================
         */

        stage('Terraform Init') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    withCredentials([
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${env.AWS_CREDENTIALS}"
                        ]
                    ]) {

                        sh '''
                            set -e

                            BACKEND_CONFIG="backend-${ENVIRONMENT}.conf"

                            if [ ! -f "$BACKEND_CONFIG" ]; then

                                echo "Backend configuration not found:"
                                echo "$BACKEND_CONFIG"

                                exit 1
                            fi

                            echo "Using backend:"
                            cat "$BACKEND_CONFIG"

                            terraform init \
                                -reconfigure \
                                -backend-config="$BACKEND_CONFIG"
                        '''
                    }
                }
            }
        }


        /*
         * ============================================================
         * TERRAFORM VALIDATE
         * ============================================================
         */

        stage('Terraform Validate') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    sh '''
                        set -e

                        terraform validate

                        echo "Terraform validation successful."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * TERRAFORM PLAN
         * ============================================================
         */

        stage('Terraform Plan') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    withCredentials([
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${env.AWS_CREDENTIALS}"
                        ]
                    ]) {

                        sh '''
                            set -e

                            TF_VARS="environments/${ENVIRONMENT}/terraform.tfvars"

                            if [ ! -f "$TF_VARS" ]; then

                                echo "Terraform variables file not found:"
                                echo "$TF_VARS"

                                exit 1
                            fi

                            echo "=========================================="
                            echo "Terraform Plan"
                            echo "=========================================="

                            echo "Environment: $ENVIRONMENT"
                            echo "Variables:   $TF_VARS"

                            terraform plan \
                                -var-file="$TF_VARS" \
                                -out=tfplan

                            echo ""
                            echo "Terraform plan completed successfully."
                        '''
                    }
                }
            }
        }


        /*
         * ============================================================
         * TERRAFORM APPROVAL
         * ============================================================
         */

        stage('Terraform Approval') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                input(
                    message: "Terraform plan completed. Deploy ${params.ENVIRONMENT}?",
                    ok: "Deploy"
                )
            }
        }


        /*
         * ============================================================
         * TERRAFORM APPLY
         * ============================================================
         */

        stage('Terraform Apply') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    withCredentials([
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${env.AWS_CREDENTIALS}"
                        ]
                    ]) {

                        sh '''
                            set -e

                            terraform apply \
                                -auto-approve \
                                tfplan

                            echo "Terraform apply completed."
                        '''
                    }
                }
            }
        }


        /*
         * ============================================================
         * WAIT FOR INFRASTRUCTURE
         * ============================================================
         */

        stage('Wait For Infrastructure') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                sh '''
                    set -e

                    echo "Waiting for AWS infrastructure..."

                    sleep 20

                    echo "Infrastructure wait completed."
                '''
            }
        }


        /*
         * ============================================================
         * CHECKOUT APPLICATION REPOSITORY
         * ============================================================
         */

        stage('Checkout Application Repository') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    deleteDir()

                    git(
                        branch: 'main',
                        credentialsId: "${env.GITHUB_CREDENTIALS}",
                        url: "${env.APPLICATION_REPO}"
                    )
                }
            }
        }


        /*
         * ============================================================
         * CHECKOUT QUALITY REPOSITORY
         * ============================================================
         */

        stage('Checkout Quality Repository') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.QUALITY_DIR}") {

                    deleteDir()

                    git(
                        branch: 'main',
                        credentialsId: "${env.GITHUB_CREDENTIALS}",
                        url: "${env.QUALITY_REPO}"
                    )
                }
            }
        }


        /*
         * ============================================================
         * PYTHON VERSION
         * ============================================================
         */

        stage('Python Version') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    sh '''
                        set -e

                        python3.12 --version
                        python3.12 -m pip --version
                    '''
                }
            }
        }


        /*
         * ============================================================
         * CREATE VIRTUAL ENVIRONMENT
         * ============================================================
         */

        stage('Create Virtual Environment') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    sh '''
                        set -e

                        rm -rf venv

                        python3.12 -m venv venv

                        ./venv/bin/python --version
                        ./venv/bin/pip --version
                    '''
                }
            }
        }


        /*
         * ============================================================
         * INSTALL DEPENDENCIES
         * ============================================================
         */

        stage('Install Dependencies') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    sh '''
                        set -e

                        ./venv/bin/pip install \
                            --upgrade pip

                        if [ -f requirements.txt ]; then

                            ./venv/bin/pip install \
                                -r requirements.txt

                        fi

                        ./venv/bin/pip install \
                            pytest \
                            pytest-cov \
                            pylint \
                            flake8
                    '''
                }
            }
        }


        /*
         * ============================================================
         * PYTEST
         * ============================================================
         */

        stage('Run Pytest') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    sh '''
                        set -e

                        mkdir -p reports

                        ./venv/bin/pytest \
                            -v \
                            --junitxml=reports/pytest-results.xml
                    '''
                }
            }
        }


        /*
         * ============================================================
         * COVERAGE
         * ============================================================
         */

        stage('Coverage') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    sh '''
                        set -e

                        ./venv/bin/pip install coverage

                        ./venv/bin/coverage run \
                            -m pytest

                        ./venv/bin/coverage report

                        ./venv/bin/coverage html \
                            -d reports/coverage
                    '''
                }
            }
        }


        /*
         * ============================================================
         * PYLINT
         * ============================================================
         */

        stage('Pylint') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    sh '''
                        set -e

                        ./venv/bin/pylint . \
                            --ignore=venv,.git,reports,__pycache__ \
                            --output-format=text \
                            > reports/pylint-report.txt

                        cat reports/pylint-report.txt
                    '''
                }
            }
        }


        /*
         * ============================================================
         * FLAKE8
         * ============================================================
         */

        stage('Flake8') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    sh '''
                        set -e

                        ./venv/bin/flake8 . \
                            --exclude=venv,.git,reports,__pycache__ \
                            --statistics \
                            --count \
                            --tee \
                            --output-file=reports/flake8-report.txt
                    '''
                }
            }
        }


        /*
         * ============================================================
         * ARCHIVE REPORTS
         * ============================================================
         */

        stage('Archive Reports') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                archiveArtifacts(
                    artifacts: 'application/reports/**/*',
                    allowEmptyArchive: true,
                    fingerprint: true
                )

                junit(
                    testResults: 'application/reports/pytest-results.xml',
                    allowEmptyResults: true
                )
            }
        }


        /*
         * ============================================================
         * PREPARE ECR
         * ============================================================
         */

        stage('Prepare ECR Repository') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    withCredentials([
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${env.AWS_CREDENTIALS}"
                        ]
                    ]) {

                        sh '''
                            set -e

                            echo "Checking ECR repository..."

                            aws ecr describe-repositories \
                                --repository-names "$ECR_REPOSITORY" \
                                --region "$AWS_DEFAULT_REGION" \
                                >/dev/null

                            echo "ECR repository exists:"
                            echo "$ECR_REPOSITORY"
                        '''
                    }
                }
            }
        }


        /*
         * ============================================================
         * DOCKER BUILD
         * ============================================================
         */

        stage('Docker Build') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    sh '''
                        set -e

                        if [ ! -f Dockerfile ]; then

                            echo "Dockerfile not found."

                            exit 1
                        fi

                        AWS_ACCOUNT_ID=$(
                            aws sts get-caller-identity \
                                --query Account \
                                --output text
                        )

                        ECR_REGISTRY="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_DEFAULT_REGION}.amazonaws.com"

                        IMAGE="${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}"

                        LATEST_IMAGE="${ECR_REGISTRY}/${ECR_REPOSITORY}:latest"

                        echo "Building:"
                        echo "$IMAGE"

                        docker build \
                            -t "$IMAGE" \
                            -t "$LATEST_IMAGE" \
                            .

                        echo "$IMAGE" > ../docker-image.txt
                    '''
                }
            }
        }


        /*
         * ============================================================
         * LOGIN TO ECR
         * ============================================================
         */

        stage('Login to Amazon ECR') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -e

                        AWS_ACCOUNT_ID=$(
                            aws sts get-caller-identity \
                                --query Account \
                                --output text
                        )

                        ECR_REGISTRY="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_DEFAULT_REGION}.amazonaws.com"

                        aws ecr get-login-password \
                            --region "$AWS_DEFAULT_REGION" \
                        | docker login \
                            --username AWS \
                            --password-stdin "$ECR_REGISTRY"
                    '''
                }
            }
        }


        /*
         * ============================================================
         * PUSH DOCKER IMAGE
         * ============================================================
         */

        stage('Push Docker Image') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                sh '''
                    set -e

                    AWS_ACCOUNT_ID=$(
                        aws sts get-caller-identity \
                            --query Account \
                            --output text
                    )

                    ECR_REGISTRY="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_DEFAULT_REGION}.amazonaws.com"

                    IMAGE="${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}"

                    LATEST_IMAGE="${ECR_REGISTRY}/${ECR_REPOSITORY}:latest"

                    docker push "$IMAGE"

                    docker push "$LATEST_IMAGE"

                    echo "$IMAGE" > docker-image.txt

                    echo "Docker image pushed successfully:"
                    echo "$IMAGE"
                '''
            }
        }


        /*
         * ============================================================
         * VERIFY ECR
         * ============================================================
         */

        stage('Verify ECR Repository') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -e

                        aws ecr describe-images \
                            --repository-name "$ECR_REPOSITORY" \
                            --region "$AWS_DEFAULT_REGION"

                        echo "ECR image verification successful."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * DOCKER CLEANUP
         * ============================================================
         */

        stage('Docker Cleanup') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                sh '''
                    set +e

                    docker image prune -af

                    echo "Docker cleanup completed."
                '''
            }
        }


        /*
         * ============================================================
         * GET ECS INFORMATION
         * ============================================================
         */

        stage('Verify ECS Cluster') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -e

                        aws ecs describe-clusters \
                            --clusters "$ECS_CLUSTER" \
                            --region "$AWS_DEFAULT_REGION"

                        echo "ECS cluster verified."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * REGISTER NEW TASK DEFINITION
         * ============================================================
         */

        stage('Register New Task Definition') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -e

                        AWS_ACCOUNT_ID=$(
                            aws sts get-caller-identity \
                                --query Account \
                                --output text
                        )

                        ECR_IMAGE="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_DEFAULT_REGION}.amazonaws.com/${ECR_REPOSITORY}:${IMAGE_TAG}"

                        cat > ecs-task-definition.json <<EOF
{
    "family": "${ECS_TASK_FAMILY}",
    "networkMode": "bridge",
    "requiresCompatibilities": [
        "EC2"
    ],
    "cpu": "256",
    "memory": "512",
    "executionRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/terraform-demo-${ENVIRONMENT}-ecs-task-execution-role",
    "containerDefinitions": [
        {
            "name": "app",
            "image": "${ECR_IMAGE}",
            "essential": true,
            "cpu": 256,
            "memory": 512,
            "portMappings": [
                {
                    "containerPort": 8501,
                    "hostPort": 8501,
                    "protocol": "tcp"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/terraform-demo",
                    "awslogs-region": "${AWS_DEFAULT_REGION}",
                    "awslogs-stream-prefix": "ecs"
                }
            }
        }
    ]
}
EOF

                        aws ecs register-task-definition \
                            --cli-input-json file://ecs-task-definition.json \
                            --region "$AWS_DEFAULT_REGION"

                        echo "New ECS task definition registered."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * GET LATEST REVISION
         * ============================================================
         */

        stage('Get Latest Revision') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -e

                        REVISION=$(
                            aws ecs describe-task-definition \
                                --task-definition "$ECS_TASK_FAMILY" \
                                --region "$AWS_DEFAULT_REGION" \
                                --query 'taskDefinition.revision' \
                                --output text
                        )

                        echo "$REVISION" > ecs-revision.txt

                        echo "Latest ECS revision:"
                        echo "$REVISION"
                    '''
                }
            }
        }


        /*
         * ============================================================
         * DEPLOY ECS SERVICE
         * ============================================================
         */

        stage('Deploy ECS Service') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -e

                        REVISION=$(cat ecs-revision.txt)

                        aws ecs update-service \
                            --cluster "$ECS_CLUSTER" \
                            --service "$ECS_SERVICE" \
                            --task-definition "${ECS_TASK_FAMILY}:${REVISION}" \
                            --force-new-deployment \
                            --region "$AWS_DEFAULT_REGION"

                        echo "ECS service deployment started."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * WAIT FOR ECS DEPLOYMENT
         * ============================================================
         */

        stage('Wait For ECS Deployment') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -e

                        aws ecs wait services-stable \
                            --cluster "$ECS_CLUSTER" \
                            --services "$ECS_SERVICE" \
                            --region "$AWS_DEFAULT_REGION"

                        echo "ECS service is stable."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * HEALTH CHECK
         * ============================================================
         */

        stage('Health Check') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    withCredentials([
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${env.AWS_CREDENTIALS}"
                        ]
                    ]) {

                        sh '''
                            set -e

                            ALB_DNS=$(
                                terraform output \
                                    -raw alb_dns_name
                            )

                            echo "ALB DNS:"
                            echo "$ALB_DNS"

                            echo "Waiting for ALB..."

                            sleep 30

                            echo "Checking application..."

                            curl \
                                --fail \
                                --max-time 15 \
                                "http://${ALB_DNS}/"

                            echo ""
                            echo "Health check successful."
                        '''
                    }
                }
            }
        }


        /*
         * ============================================================
         * DEPLOYMENT SUCCESSFUL
         * ============================================================
         */

        stage('Deployment Successful') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                echo """
                ==========================================
                DEPLOYMENT SUCCESSFUL
                ==========================================

                Environment : ${params.ENVIRONMENT}
                Build       : ${BUILD_NUMBER}

                Terraform   : SUCCESS
                Tests       : SUCCESS
                Pylint      : SUCCESS
                Flake8      : SUCCESS
                Docker      : SUCCESS
                ECR         : SUCCESS
                ECS         : SUCCESS
                Health      : SUCCESS

                ==========================================
                """
            }
        }


        /*
         * ============================================================
         * DESTROY
         * ============================================================
         */

        stage('Terraform Destroy') {

            when {
                expression {
                    params.ACTION == 'DESTROY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    deleteDir()

                    git(
                        branch: 'main',
                        credentialsId: "${env.GITHUB_CREDENTIALS}",
                        url: "${env.TERRAFORM_REPO}"
                    )

                    withCredentials([
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${env.AWS_CREDENTIALS}"
                        ]
                    ]) {

                        sh '''
                            set -e

                            BACKEND_CONFIG="backend-${ENVIRONMENT}.conf"
                            TF_VARS="environments/${ENVIRONMENT}/terraform.tfvars"

                            echo "=========================================="
                            echo "Terraform Destroy"
                            echo "=========================================="

                            terraform init \
                                -reconfigure \
                                -backend-config="$BACKEND_CONFIG"

                            terraform destroy \
                                -var-file="$TF_VARS" \
                                -auto-approve

                            echo ""
                            echo "Terraform destroy completed."
                        '''
                    }
                }
            }
        }

    }


    /*
     * ================================================================
     * POST ACTIONS
     * ================================================================
     */

    post {

        always {

            echo "=========================================="
            echo "Cleaning Jenkins workspace..."
            echo "=========================================="

            cleanWs(
                deleteDirs: true,
                disableDeferredWipeout: true
            )
        }

        success {

            echo "=========================================="
            echo "Pipeline SUCCESS"
            echo "=========================================="
        }

        failure {

            echo "=========================================="
            echo "Pipeline FAILED"
            echo "=========================================="

            echo "Check the failed stage above."
        }
    }
}
