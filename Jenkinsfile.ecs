pipeline {

    agent any

    options {
        timestamps()
        ansiColor('xterm')
        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                daysToKeepStr: '30',
                numToKeepStr: '50'
            )
        )

        timeout(
            time: 90,
            unit: 'MINUTES'
        )
    }

    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: [
                'dev',
                'qa',
                'stage',
                'prod'
            ],
            description: 'Terraform environment to deploy'
        )
    }

    environment {

        // ============================================================
        // GITHUB
        // ============================================================

        APP_REPO = 'https://github.com/FAIZANSHEIKH223/practice1.git'
        APP_BRANCH = 'main'

        QUALITY_REPO = 'https://github.com/FAIZANSHEIKH223/pylint_flake8_int_jenkins.git'
        QUALITY_BRANCH = 'main'

        TERRAFORM_REPO = 'https://github.com/FAIZANSHEIKH223/terraform-aws-infra.git'
        TERRAFORM_BRANCH = 'main'

        GITHUB_CREDENTIALS = 'github-creds'
        AWS_CREDENTIALS = 'aws-creds'

        // ============================================================
        // DIRECTORIES
        // ============================================================

        APP_DIR = 'practice1'
        QUALITY_DIR = 'quality-tools'
        TERRAFORM_DIR = 'terraform-infra'

        VENV_DIR = 'venv'
        REPORT_DIR = 'reports'

        PYTHON = 'python3.12'

        // ============================================================
        // AWS
        // ============================================================

        AWS_DEFAULT_REGION = 'us-east-1'

        // ============================================================
        // APPLICATION
        // ============================================================

        APP_NAME = 'practice1'
        CONTAINER_NAME = 'practice1'
        CONTAINER_PORT = '8501'

        // ============================================================
        // DOCKER
        // ============================================================

        DOCKER_IMAGE_NAME = 'practice1'
        DOCKER_IMAGE_TAG = "${BUILD_NUMBER}"
        DOCKER_IMAGE = "practice1:${BUILD_NUMBER}"

        // ============================================================
        // ECR
        // ============================================================

        ECR_REPOSITORY = 'practice1'
        ECR_IMAGE_TAG = "${BUILD_NUMBER}"

        // ============================================================
        // ECS
        // ============================================================

        ECS_CLUSTER = "practice1-${ENVIRONMENT}-cluster"
        ECS_SERVICE = "practice1-${ENVIRONMENT}-service"
        ECS_TASK_FAMILY = "practice1-${ENVIRONMENT}-task"
        ECS_CONTAINER_NAME = 'practice1'

        FARGATE_CPU = '256'
        FARGATE_MEMORY = '512'

        // ============================================================
        // LOAD BALANCER
        // ============================================================

        ALB_NAME = "practice1-${ENVIRONMENT}-alb"
        TARGET_GROUP_NAME = "practice1-${ENVIRONMENT}-tg"

        ALB_SG_NAME = "practice1-${ENVIRONMENT}-alb-sg"
        ECS_SG_NAME = "practice1-${ENVIRONMENT}-ecs-sg"

        // ============================================================
        // TERRAFORM
        // ============================================================

        TF_STATE_BUCKET = 'terraform-state-faizan-001'
        TF_LOCK_TABLE = 'terraform-locks'

        TF_IN_AUTOMATION = 'true'
        TF_INPUT = 'false'

        // ============================================================
        // APPLICATION
        // ============================================================

        HEALTH_PATH = '/'

        DNS_NAME = ''
    }

    stages {

        // ============================================================
        // PART 1
        // APPLICATION + QUALITY + TESTING
        // ============================================================

        stage('1 - Application Checkout') {

            steps {

                echo '================================================'
                echo 'CHECKOUT APPLICATION'
                echo '================================================'

                dir("${APP_DIR}") {

                    deleteDir()

                    git(
                        branch: "${APP_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${APP_REPO}"
                    )
                }
            }
        }

        stage('2 - Quality Repository Checkout') {

            steps {

                echo '================================================'
                echo 'CHECKOUT QUALITY REPOSITORY'
                echo '================================================'

                dir("${QUALITY_DIR}") {

                    deleteDir()

                    git(
                        branch: "${QUALITY_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${QUALITY_REPO}"
                    )
                }
            }
        }

        stage('3 - Python Environment') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "PYTHON ENVIRONMENT"
                        echo "================================================"

                        command -v "${PYTHON}"
                        "${PYTHON}" --version

                        rm -rf "${VENV_DIR}"

                        "${PYTHON}" -m venv "${VENV_DIR}"

                        "${VENV_DIR}/bin/python" --version

                        "${VENV_DIR}/bin/python" -m pip install --upgrade pip
                    '''
                }
            }
        }

        stage('4 - Install Dependencies and Quality Tools') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "INSTALLING DEPENDENCIES"
                        echo "================================================"

                        if [ -f requirements.txt ]; then
                            "${VENV_DIR}/bin/pip" install -r requirements.txt
                        else
                            echo "WARNING: requirements.txt not found."
                        fi

                        "${VENV_DIR}/bin/pip" install flake8 pylint pytest

                        "${VENV_DIR}/bin/flake8" --version
                        "${VENV_DIR}/bin/pylint" --version
                        "${VENV_DIR}/bin/pytest" --version
                    '''
                }
            }
        }

        stage('5 - Code Quality') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "CODE QUALITY"
                        echo "================================================"

                        mkdir -p "${REPORT_DIR}"

                        echo ""
                        echo "Running Flake8..."

                        "${VENV_DIR}/bin/flake8" \
                            . \
                            --exclude="${VENV_DIR},.git,${REPORT_DIR},__pycache__" \
                            --count \
                            --statistics \
                            --tee \
                            --output-file="${REPORT_DIR}/flake8-report.txt"

                        echo ""
                        echo "Running Pylint..."

                        PYTHON_FILES=$(find . \
                            -type f \
                            -name "*.py" \
                            ! -path "./${VENV_DIR}/*" \
                            ! -path "./.git/*" \
                            ! -path "./${REPORT_DIR}/*" \
                            ! -path "*/__pycache__/*")

                        if [ -z "${PYTHON_FILES}" ]; then
                            echo "ERROR: No Python files found."
                            exit 1
                        fi

                        "${VENV_DIR}/bin/pylint" \
                            ${PYTHON_FILES} \
                            --output-format=text \
                            > "${REPORT_DIR}/pylint-report.txt"

                        echo ""
                        echo "Flake8 and Pylint completed."
                    '''
                }
            }
        }

        stage('6 - Automated Tests') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "AUTOMATED TESTS"
                        echo "================================================"

                        mkdir -p "${REPORT_DIR}"

                        if [ ! -d tests ]; then
                            echo "ERROR: tests/ directory does not exist."
                            exit 1
                        fi

                        TEST_FILES=$(find tests \
                            -type f \
                            \\( \
                                -name "test_*.py" \
                                -o \
                                -name "*_test.py" \
                            \\))

                        if [ -z "${TEST_FILES}" ]; then
                            echo "ERROR: No pytest test files found."
                            exit 1
                        fi

                        echo "Test files:"
                        echo "${TEST_FILES}"

                        "${VENV_DIR}/bin/pytest" \
                            tests/ \
                            -v \
                            --junitxml="${REPORT_DIR}/pytest-results.xml"
                    '''
                }
            }
        }

        stage('7 - Publish Test Reports') {

            steps {

                junit(
                    testResults: "${APP_DIR}/${REPORT_DIR}/pytest-results.xml",
                    allowEmptyResults: false
                )

                archiveArtifacts(
                    artifacts:
                        "${APP_DIR}/${REPORT_DIR}/pytest-results.xml," +
                        "${APP_DIR}/${REPORT_DIR}/flake8-report.txt," +
                        "${APP_DIR}/${REPORT_DIR}/pylint-report.txt",
                    allowEmptyArchive: false,
                    fingerprint: true
                )
            }
        }

        // ============================================================
        // PART 2
        // DOCKER
        // ============================================================

        stage('8 - Docker Build') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "DOCKER BUILD"
                        echo "================================================"

                        command -v docker
                        docker --version

                        docker info > /dev/null

                        if [ ! -f Dockerfile ]; then
                            echo "ERROR: Dockerfile not found."
                            exit 1
                        fi

                        cat > .dockerignore <<'EOF'
venv/
.venv/
.git/
.gitignore
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
reports/
*.log
.DS_Store
EOF

                        echo ""
                        echo ".dockerignore:"
                        cat .dockerignore

                        echo ""
                        echo "Building Docker image..."

                        docker build \
                            --pull \
                            --tag "${DOCKER_IMAGE}" \
                            .

                        docker image inspect "${DOCKER_IMAGE}" > /dev/null

                        echo ""
                        echo "Docker image successfully created:"
                        echo "${DOCKER_IMAGE}"
                    '''
                }
            }
        }

        // ============================================================
        // PART 3
        // ECR
        // ============================================================

        stage('9 - ECR Deployment') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        sh '''
                            set -eu

                            echo "================================================"
                            echo "AWS VERIFICATION"
                            echo "================================================"

                            command -v aws
                            aws --version

                            aws sts get-caller-identity \
                                --region "${AWS_DEFAULT_REGION}"
                        '''

                        sh '''
                            set -eu

                            echo "================================================"
                            echo "ECR REPOSITORY"
                            echo "================================================"

                            if aws ecr describe-repositories \
                                --repository-names "${ECR_REPOSITORY}" \
                                --region "${AWS_DEFAULT_REGION}" \
                                > /dev/null 2>&1
                            then
                                echo "ECR repository already exists."
                            else
                                aws ecr create-repository \
                                    --repository-name "${ECR_REPOSITORY}" \
                                    --region "${AWS_DEFAULT_REGION}"
                            fi
                        '''

                        def accountId = sh(
                            script: '''
                                aws sts get-caller-identity \
                                    --query Account \
                                    --output text \
                                    --region "${AWS_DEFAULT_REGION}"
                            ''',
                            returnStdout: true
                        ).trim()

                        env.AWS_ACCOUNT_ID = accountId

                        env.ECR_REGISTRY =
                            "${accountId}.dkr.ecr.${env.AWS_DEFAULT_REGION}.amazonaws.com"

                        env.ECR_IMAGE =
                            "${env.ECR_REGISTRY}/${env.ECR_REPOSITORY}:${env.ECR_IMAGE_TAG}"

                        echo "AWS Account : ${env.AWS_ACCOUNT_ID}"
                        echo "ECR Registry: ${env.ECR_REGISTRY}"
                        echo "ECR Image   : ${env.ECR_IMAGE}"

                        sh '''
                            set -eu

                            echo "================================================"
                            echo "LOGIN TO ECR"
                            echo "================================================"

                            aws ecr get-login-password \
                                --region "${AWS_DEFAULT_REGION}" |
                            docker login \
                                --username AWS \
                                --password-stdin \
                                "${ECR_REGISTRY}"
                        '''

                        sh '''
                            set -eu

                            echo "================================================"
                            echo "TAGGING IMAGE"
                            echo "================================================"

                            docker tag \
                                "${DOCKER_IMAGE}" \
                                "${ECR_IMAGE}"

                            docker image inspect \
                                "${ECR_IMAGE}" > /dev/null
                        '''

                        sh '''
                            set -eu

                            echo "================================================"
                            echo "PUSHING IMAGE TO ECR"
                            echo "================================================"

                            docker push "${ECR_IMAGE}"
                        '''

                        sh '''
                            set -eu

                            echo "================================================"
                            echo "VERIFYING ECR IMAGE"
                            echo "================================================"

                            aws ecr describe-images \
                                --repository-name "${ECR_REPOSITORY}" \
                                --image-ids imageTag="${ECR_IMAGE_TAG}" \
                                --region "${AWS_DEFAULT_REGION}"
                        '''
                    }
                }
            }
        }

        // ============================================================
        // PART 4
        // TERRAFORM
        // ============================================================

        stage('10 - Terraform Deployment') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    deleteDir()

                    git(
                        branch: "${TERRAFORM_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${TERRAFORM_REPO}"
                    )
                }

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh '''
                            set -eu

                            echo "================================================"
                            echo "TERRAFORM VERIFICATION"
                            echo "================================================"

                            command -v terraform
                            terraform version

                            if [ ! -d "environments/${ENVIRONMENT}" ]; then
                                echo "ERROR: Terraform environment does not exist:"
                                echo "environments/${ENVIRONMENT}"
                                exit 1
                            fi

                            if [ ! -f "environments/${ENVIRONMENT}/terraform.tfvars" ]; then
                                echo "ERROR: terraform.tfvars not found:"
                                echo "environments/${ENVIRONMENT}/terraform.tfvars"
                                exit 1
                            fi

                            echo ""
                            echo "Terraform environment:"
                            echo "${ENVIRONMENT}"

                            echo ""
                            echo "Terraform files:"
                            find . \
                                -maxdepth 4 \
                                -type f \
                                -name "*.tf" \
                                -print

                            echo ""
                            echo "================================================"
                            echo "TERRAFORM INIT"
                            echo "================================================"

                            terraform init \
                                -input=false

                            echo ""
                            echo "================================================"
                            echo "TERRAFORM VALIDATE"
                            echo "================================================"

                            terraform validate

                            echo ""
                            echo "================================================"
                            echo "TERRAFORM PLAN"
                            echo "================================================"

                            terraform plan \
                                -input=false \
                                -var-file="environments/${ENVIRONMENT}/terraform.tfvars" \
                                -out="tfplan"

                            test -f tfplan

                            echo ""
                            echo "================================================"
                            echo "TERRAFORM APPLY"
                            echo "================================================"

                            terraform apply \
                                -input=false \
                                -auto-approve \
                                tfplan

                            echo ""
                            echo "================================================"
                            echo "TERRAFORM DEPLOYMENT COMPLETE"
                            echo "================================================"

                            terraform state list || true
                            terraform output || true
                        '''
                    }
                }
            }
        }

        // ============================================================
        // PART 5
        // AWS NETWORK DISCOVERY
        // ============================================================

        stage('11 - Discover AWS Network') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        env.VPC_ID = sh(
                            script: '''
                                set -eu

                                VPC_ID=$(aws ec2 describe-vpcs \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --filters \
                                        "Name=tag:Environment,Values=${ENVIRONMENT}" \
                                    --query 'Vpcs[0].VpcId' \
                                    --output text)

                                if [ "${VPC_ID}" = "None" ] ||
                                   [ -z "${VPC_ID}" ]; then

                                    VPC_ID=$(aws ec2 describe-vpcs \
                                        --region "${AWS_DEFAULT_REGION}" \
                                        --filters \
                                            "Name=is-default,Values=true" \
                                        --query 'Vpcs[0].VpcId' \
                                        --output text)
                                fi

                                if [ "${VPC_ID}" = "None" ] ||
                                   [ -z "${VPC_ID}" ]; then

                                    echo "ERROR: No VPC found."
                                    exit 1
                                fi

                                echo "${VPC_ID}"
                            ''',
                            returnStdout: true
                        ).trim()

                        echo "VPC ID: ${env.VPC_ID}"

                        def subnetOutput = sh(
                            script: '''
                                set -eu

                                aws ec2 describe-subnets \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --filters \
                                        "Name=vpc-id,Values=${VPC_ID}" \
                                        "Name=map-public-ip-on-launch,Values=true" \
                                    --query 'Subnets[].{Id:SubnetId,AZ:AvailabilityZone}' \
                                    --output text
                            ''',
                            returnStdout: true
                        ).trim()

                        if (!subnetOutput ||
                            subnetOutput == 'None') {

                            error(
                                'No public subnets were found in the selected VPC.'
                            )
                        }

                        def selectedSubnets = []
                        def usedAzs = []

                        subnetOutput.readLines().each { line ->

                            def parts = line.trim().split(/\s+/)

                            if (parts.size() >= 2) {

                                def subnetId = parts[0]
                                def az = parts[1]

                                if (!usedAzs.contains(az)) {

                                    selectedSubnets.add(subnetId)
                                    usedAzs.add(az)
                                }
                            }
                        }

                        if (selectedSubnets.size() < 2) {

                            error(
                                "At least two public subnets in different AZs are required. " +
                                "Found: ${subnetOutput}"
                            )
                        }

                        env.SUBNET_1 = selectedSubnets[0]
                        env.SUBNET_2 = selectedSubnets[1]

                        echo "VPC     : ${env.VPC_ID}"
                        echo "Subnet 1: ${env.SUBNET_1}"
                        echo "Subnet 2: ${env.SUBNET_2}"
                    }
                }
            }
        }

        // ============================================================
        // PART 6
        // IAM + SECURITY GROUPS
        // ============================================================

        stage('12 - Prepare ECS IAM and Security Groups') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        sh '''
                            set -eu

                            echo "================================================"
                            echo "CREATING ECS EXECUTION ROLE"
                            echo "================================================"

                            EXECUTION_ROLE_NAME="practice1-ecsTaskExecutionRole"

                            if ! aws iam get-role \
                                --role-name "${EXECUTION_ROLE_NAME}" \
                                > /dev/null 2>&1
                            then

                                cat > /tmp/ecs-trust-policy.json <<'EOF'
{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "Service": "ecs-tasks.amazonaws.com"
      },
      "Action": "sts:AssumeRole"
    }
  ]
}
EOF

                                aws iam create-role \
                                    --role-name "${EXECUTION_ROLE_NAME}" \
                                    --assume-role-policy-document \
                                    file:///tmp/ecs-trust-policy.json
                            fi

                            aws iam attach-role-policy \
                                --role-name "${EXECUTION_ROLE_NAME}" \
                                --policy-arn \
                                arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy \
                                || true

                            sleep 10

                            aws iam get-role \
                                --role-name "${EXECUTION_ROLE_NAME}" \
                                --query 'Role.Arn' \
                                --output text
                        '''

                        sh '''
                            set -eu

                            echo "================================================"
                            echo "CREATING SECURITY GROUPS"
                            echo "================================================"

                            ALB_SG_ID=$(aws ec2 describe-security-groups \
                                --region "${AWS_DEFAULT_REGION}" \
                                --filters \
                                    "Name=vpc-id,Values=${VPC_ID}" \
                                    "Name=group-name,Values=${ALB_SG_NAME}" \
                                --query 'SecurityGroups[0].GroupId' \
                                --output text)

                            if [ "${ALB_SG_ID}" = "None" ] ||
                               [ -z "${ALB_SG_ID}" ]; then

                                ALB_SG_ID=$(aws ec2 create-security-group \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --group-name "${ALB_SG_NAME}" \
                                    --description "ALB security group for practice1" \
                                    --vpc-id "${VPC_ID}" \
                                    --query 'GroupId' \
                                    --output text)
                            fi

                            ECS_SG_ID=$(aws ec2 describe-security-groups \
                                --region "${AWS_DEFAULT_REGION}" \
                                --filters \
                                    "Name=vpc-id,Values=${VPC_ID}" \
                                    "Name=group-name,Values=${ECS_SG_NAME}" \
                                --query 'SecurityGroups[0].GroupId' \
                                --output text)

                            if [ "${ECS_SG_ID}" = "None" ] ||
                               [ -z "${ECS_SG_ID}" ]; then

                                ECS_SG_ID=$(aws ec2 create-security-group \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --group-name "${ECS_SG_NAME}" \
                                    --description "ECS Fargate security group for practice1" \
                                    --vpc-id "${VPC_ID}" \
                                    --query 'GroupId' \
                                    --output text)
                            fi

                            echo "ALB SG: ${ALB_SG_ID}"
                            echo "ECS SG: ${ECS_SG_ID}"

                            aws ec2 authorize-security-group-ingress \
                                --region "${AWS_DEFAULT_REGION}" \
                                --group-id "${ALB_SG_ID}" \
                                --protocol tcp \
                                --port 80 \
                                --cidr 0.0.0.0/0 \
                                2>/dev/null || true

                            aws ec2 authorize-security-group-ingress \
                                --region "${AWS_DEFAULT_REGION}" \
                                --group-id "${ECS_SG_ID}" \
                                --protocol tcp \
                                --port "${CONTAINER_PORT}" \
                                --source-group "${ALB_SG_ID}" \
                                2>/dev/null || true

                            aws ec2 authorize-security-group-egress \
                                --region "${AWS_DEFAULT_REGION}" \
                                --group-id "${ALB_SG_ID}" \
                                --protocol -1 \
                                --cidr 0.0.0.0/0 \
                                2>/dev/null || true

                            aws ec2 authorize-security-group-egress \
                                --region "${AWS_DEFAULT_REGION}" \
                                --group-id "${ECS_SG_ID}" \
                                --protocol -1 \
                                --cidr 0.0.0.0/0 \
                                2>/dev/null || true
                        '''

                        env.ALB_SG_ID = sh(
                            script: '''
                                aws ec2 describe-security-groups \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --filters \
                                        "Name=vpc-id,Values=${VPC_ID}" \
                                        "Name=group-name,Values=${ALB_SG_NAME}" \
                                    --query 'SecurityGroups[0].GroupId' \
                                    --output text
                            ''',
                            returnStdout: true
                        ).trim()

                        env.ECS_SG_ID = sh(
                            script: '''
                                aws ec2 describe-security-groups \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --filters \
                                        "Name=vpc-id,Values=${VPC_ID}" \
                                        "Name=group-name,Values=${ECS_SG_NAME}" \
                                    --query 'SecurityGroups[0].GroupId' \
                                    --output text
                            ''',
                            returnStdout: true
                        ).trim()

                        if (!env.ALB_SG_ID ||
                            env.ALB_SG_ID == 'None') {

                            error('ALB security group ID could not be determined.')
                        }

                        if (!env.ECS_SG_ID ||
                            env.ECS_SG_ID == 'None') {

                            error('ECS security group ID could not be determined.')
                        }

                        echo "ALB SG ID: ${env.ALB_SG_ID}"
                        echo "ECS SG ID: ${env.ECS_SG_ID}"
                    }
                }
            }
        }

        // ============================================================
        // PART 7
        // ALB
        // ============================================================

        stage('13 - Create ALB and Target Group') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        env.ALB_ARN = sh(
                            script: '''
                                aws elbv2 describe-load-balancers \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --names "${ALB_NAME}" \
                                    --query 'LoadBalancers[0].LoadBalancerArn' \
                                    --output text \
                                    2>/dev/null || true
                            ''',
                            returnStdout: true
                        ).trim()

                        if (!env.ALB_ARN ||
                            env.ALB_ARN == 'None') {

                            env.ALB_ARN = sh(
                                script: '''
                                    aws elbv2 create-load-balancer \
                                        --region "${AWS_DEFAULT_REGION}" \
                                        --name "${ALB_NAME}" \
                                        --subnets "${SUBNET_1}" "${SUBNET_2}" \
                                        --security-groups "${ALB_SG_ID}" \
                                        --scheme internet-facing \
                                        --type application \
                                        --ip-address-type ipv4 \
                                        --query 'LoadBalancers[0].LoadBalancerArn' \
                                        --output text
                                ''',
                                returnStdout: true
                            ).trim()
                        }

                        sh '''
                            set -eu

                            aws elbv2 wait load-balancer-available \
                                --region "${AWS_DEFAULT_REGION}" \
                                --load-balancer-arns "${ALB_ARN}"
                        '''

                        env.ALB_DNS = sh(
                            script: '''
                                aws elbv2 describe-load-balancers \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --load-balancer-arns "${ALB_ARN}" \
                                    --query 'LoadBalancers[0].DNSName' \
                                    --output text
                            ''',
                            returnStdout: true
                        ).trim()

                        env.TARGET_GROUP_ARN = sh(
                            script: '''
                                aws elbv2 describe-target-groups \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --names "${TARGET_GROUP_NAME}" \
                                    --query 'TargetGroups[0].TargetGroupArn' \
                                    --output text \
                                    2>/dev/null || true
                            ''',
                            returnStdout: true
                        ).trim()

                        if (!env.TARGET_GROUP_ARN ||
                            env.TARGET_GROUP_ARN == 'None') {

                            env.TARGET_GROUP_ARN = sh(
                                script: '''
                                    aws elbv2 create-target-group \
                                        --region "${AWS_DEFAULT_REGION}" \
                                        --name "${TARGET_GROUP_NAME}" \
                                        --protocol HTTP \
                                        --port "${CONTAINER_PORT}" \
                                        --target-type ip \
                                        --vpc-id "${VPC_ID}" \
                                        --health-check-protocol HTTP \
                                        --health-check-path "${HEALTH_PATH}" \
                                        --health-check-port traffic-port \
                                        --matcher HttpCode=200-399 \
                                        --query 'TargetGroups[0].TargetGroupArn' \
                                        --output text
                                ''',
                                returnStdout: true
                            ).trim()
                        }

                        echo "ALB ARN       : ${env.ALB_ARN}"
                        echo "ALB DNS       : ${env.ALB_DNS}"
                        echo "Target Group  : ${env.TARGET_GROUP_ARN}"

                        sh '''
                            set -eu

                            LISTENER_ARN=$(aws elbv2 describe-listeners \
                                --region "${AWS_DEFAULT_REGION}" \
                                --load-balancer-arn "${ALB_ARN}" \
                                --query 'Listeners[?Port==`80`].ListenerArn | [0]' \
                                --output text)

                            if [ "${LISTENER_ARN}" = "None" ] ||
                               [ -z "${LISTENER_ARN}" ]; then

                                aws elbv2 create-listener \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --load-balancer-arn "${ALB_ARN}" \
                                    --protocol HTTP \
                                    --port 80 \
                                    --default-actions \
                                    Type=forward,TargetGroupArn="${TARGET_GROUP_ARN}"

                            else

                                aws elbv2 modify-listener \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --listener-arn "${LISTENER_ARN}" \
                                    --default-actions \
                                    Type=forward,TargetGroupArn="${TARGET_GROUP_ARN}"

                            fi
                        '''
                    }
                }
            }
        }

        // ============================================================
        // PART 8
        // ECS CLUSTER
        // ============================================================

        stage('14 - Create ECS Cluster') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "ECS CLUSTER"
                        echo "================================================"

                        CLUSTER_STATUS=$(aws ecs describe-clusters \
                            --region "${AWS_DEFAULT_REGION}" \
                            --clusters "${ECS_CLUSTER}" \
                            --query 'clusters[0].status' \
                            --output text \
                            2>/dev/null || true)

                        echo "Current cluster status: ${CLUSTER_STATUS}"

                        if [ "${CLUSTER_STATUS}" != "ACTIVE" ]; then

                            aws ecs create-cluster \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster-name "${ECS_CLUSTER}" \
                                > /dev/null 2>&1 || true
                        fi

                        for i in $(seq 1 20)
                        do

                            STATUS=$(aws ecs describe-clusters \
                                --region "${AWS_DEFAULT_REGION}" \
                                --clusters "${ECS_CLUSTER}" \
                                --query 'clusters[0].status' \
                                --output text \
                                2>/dev/null || true)

                            echo "Cluster check ${i}/20: ${STATUS}"

                            if [ "${STATUS}" = "ACTIVE" ]; then
                                break
                            fi

                            sleep 3
                        done

                        FINAL_STATUS=$(aws ecs describe-clusters \
                            --region "${AWS_DEFAULT_REGION}" \
                            --clusters "${ECS_CLUSTER}" \
                            --query 'clusters[0].status' \
                            --output text)

                        if [ "${FINAL_STATUS}" != "ACTIVE" ]; then
                            echo "ERROR: ECS cluster is not ACTIVE."
                            exit 1
                        fi

                        echo "ECS cluster is ACTIVE."
                    '''
                }
            }
        }

        // ============================================================
        // PART 9
        // ECS TASK DEFINITION
        // ============================================================

        stage('15 - Register ECS Task Definition') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        env.EXECUTION_ROLE_ARN = sh(
                            script: '''
                                aws iam get-role \
                                    --role-name "practice1-ecsTaskExecutionRole" \
                                    --query 'Role.Arn' \
                                    --output text
                            ''',
                            returnStdout: true
                        ).trim()

                        if (!env.EXECUTION_ROLE_ARN ||
                            env.EXECUTION_ROLE_ARN == 'None') {

                            error(
                                'ECS execution role ARN could not be determined.'
                            )
                        }

                        sh '''
                            set -eu

                            echo "================================================"
                            echo "ECS TASK DEFINITION"
                            echo "================================================"

                            cat > task-definition.json <<EOF
{
  "family": "${ECS_TASK_FAMILY}",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "${FARGATE_CPU}",
  "memory": "${FARGATE_MEMORY}",
  "executionRoleArn": "${EXECUTION_ROLE_ARN}",
  "containerDefinitions": [
    {
      "name": "${ECS_CONTAINER_NAME}",
      "image": "${ECR_IMAGE}",
      "essential": true,
      "portMappings": [
        {
          "containerPort": ${CONTAINER_PORT},
          "hostPort": ${CONTAINER_PORT},
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "STREAMLIT_SERVER_ADDRESS",
          "value": "0.0.0.0"
        },
        {
          "name": "STREAMLIT_SERVER_PORT",
          "value": "${CONTAINER_PORT}"
        },
        {
          "name": "STREAMLIT_SERVER_HEADLESS",
          "value": "true"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/${ECS_TASK_FAMILY}",
          "awslogs-region": "${AWS_DEFAULT_REGION}",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
EOF

                            echo "Validating JSON..."

                            python3 -m json.tool \
                                task-definition.json \
                                > /dev/null

                            echo "Creating CloudWatch log group..."

                            aws logs create-log-group \
                                --log-group-name "/ecs/${ECS_TASK_FAMILY}" \
                                --region "${AWS_DEFAULT_REGION}" \
                                2>/dev/null || true

                            echo "Registering task definition..."

                            aws ecs register-task-definition \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cli-input-json file://task-definition.json

                            TASK_DEFINITION_ARN=$(aws ecs describe-task-definition \
                                --region "${AWS_DEFAULT_REGION}" \
                                --task-definition "${ECS_TASK_FAMILY}" \
                                --query 'taskDefinition.taskDefinitionArn' \
                                --output text)

                            if [ -z "${TASK_DEFINITION_ARN}" ] ||
                               [ "${TASK_DEFINITION_ARN}" = "None" ]; then

                                echo "ERROR: Task definition ARN not found."
                                exit 1
                            fi

                            echo ""
                            echo "Task Definition:"
                            echo "${TASK_DEFINITION_ARN}"
                        '''
                    }
                }
            }
        }

        // ============================================================
        // PART 10
        // ECS SERVICE
        // ============================================================

        stage('16 - Deploy ECS Fargate Service') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "ECS FARGATE SERVICE"
                        echo "================================================"

                        SERVICE_STATUS=$(aws ecs describe-services \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}" \
                            --query 'services[0].status' \
                            --output text \
                            2>/dev/null || true)

                        echo "Existing service status: ${SERVICE_STATUS}"

                        if [ "${SERVICE_STATUS}" = "ACTIVE" ]; then

                            echo "Updating existing ECS service..."

                            aws ecs update-service \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --service "${ECS_SERVICE}" \
                                --task-definition "${ECS_TASK_FAMILY}" \
                                --desired-count 1 \
                                --force-new-deployment

                        else

                            echo "Creating ECS service..."

                            aws ecs create-service \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --service-name "${ECS_SERVICE}" \
                                --task-definition "${ECS_TASK_FAMILY}" \
                                --desired-count 1 \
                                --launch-type FARGATE \
                                --platform-version LATEST \
                                --network-configuration \
                                    "awsvpcConfiguration={subnets=[${SUBNET_1},${SUBNET_2}],securityGroups=[${ECS_SG_ID}],assignPublicIp=ENABLED}" \
                                --load-balancers \
                                    "targetGroupArn=${TARGET_GROUP_ARN},containerName=${ECS_CONTAINER_NAME},containerPort=${CONTAINER_PORT}"
                        fi

                        echo ""
                        echo "Waiting for ECS task..."

                        RUNNING_COUNT=0

                        for i in $(seq 1 60)
                        do

                            SERVICE_INFO=$(aws ecs describe-services \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --services "${ECS_SERVICE}" \
                                --query 'services[0].[status,desiredCount,runningCount,pendingCount]' \
                                --output text \
                                2>/dev/null || true)

                            STATUS=$(echo "${SERVICE_INFO}" | awk '{print $1}')
                            DESIRED=$(echo "${SERVICE_INFO}" | awk '{print $2}')
                            RUNNING=$(echo "${SERVICE_INFO}" | awk '{print $3}')
                            PENDING=$(echo "${SERVICE_INFO}" | awk '{print $4}')

                            echo "Check ${i}/60: status=${STATUS} desired=${DESIRED} running=${RUNNING} pending=${PENDING}"

                            if [ "${STATUS}" = "ACTIVE" ] &&
                               [ "${RUNNING:-0}" -ge 1 ]; then

                                RUNNING_COUNT="${RUNNING}"
                                break
                            fi

                            sleep 5
                        done

                        if [ "${RUNNING_COUNT}" -lt 1 ]; then

                            echo ""
                            echo "ERROR: ECS service has no running task."

                            echo ""
                            echo "ECS service details:"

                            aws ecs describe-services \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --services "${ECS_SERVICE}" \
                                --query 'services[0].{Status:status,Desired:desiredCount,Running:runningCount,Pending:pendingCount,Events:events[0:15]}' \
                                --output json || true

                            exit 1
                        fi

                        echo ""
                        echo "ECS service has a running task."
                    '''
                }
            }
        }

        // ============================================================
        // PART 11
        // ECS TASK VERIFICATION
        // ============================================================

        stage('17 - Verify Running ECS Task') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "VERIFYING ECS TASK"
                        echo "================================================"

                        TASK_ARN=""

                        for i in $(seq 1 36)
                        do

                            TASK_ARN=$(aws ecs list-tasks \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --service-name "${ECS_SERVICE}" \
                                --desired-status RUNNING \
                                --query 'taskArns[0]' \
                                --output text \
                                2>/dev/null || true)

                            echo "Task lookup ${i}/36: ${TASK_ARN}"

                            if [ -n "${TASK_ARN}" ] &&
                               [ "${TASK_ARN}" != "None" ]; then

                                break
                            fi

                            sleep 5
                        done

                        if [ -z "${TASK_ARN}" ] ||
                           [ "${TASK_ARN}" = "None" ]; then

                            echo "ERROR: Running ECS task could not be found."
                            exit 1
                        fi

                        TASK_STATUS=$(aws ecs describe-tasks \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --tasks "${TASK_ARN}" \
                            --query 'tasks[0].lastStatus' \
                            --output text)

                        CONTAINER_STATUS=$(aws ecs describe-tasks \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --tasks "${TASK_ARN}" \
                            --query "tasks[0].containers[?name=='${ECS_CONTAINER_NAME}'].lastStatus | [0]" \
                            --output text)

                        TASK_IP=$(aws ecs describe-tasks \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --tasks "${TASK_ARN}" \
                            --query 'tasks[0].networkInterfaces[0].privateIpv4Address' \
                            --output text)

                        echo ""
                        echo "Task ARN        : ${TASK_ARN}"
                        echo "Task Status     : ${TASK_STATUS}"
                        echo "Task Private IP : ${TASK_IP}"
                        echo "Container       : ${ECS_CONTAINER_NAME}"
                        echo "Container State : ${CONTAINER_STATUS}"

                        if [ "${TASK_STATUS}" != "RUNNING" ]; then

                            echo ""
                            echo "ERROR: ECS task is not RUNNING."

                            aws ecs describe-tasks \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --tasks "${TASK_ARN}" \
                                --query 'tasks[0].{LastStatus:lastStatus,DesiredStatus:desiredStatus,StoppedReason:stoppedReason,StopCode:stopCode,Containers:containers}' \
                                --output json || true

                            exit 1
                        fi

                        if [ "${CONTAINER_STATUS}" != "RUNNING" ]; then

                            echo ""
                            echo "ERROR: Application container is not RUNNING."

                            aws ecs describe-tasks \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --tasks "${TASK_ARN}" \
                                --query 'tasks[0].containers' \
                                --output json || true

                            exit 1
                        fi

                        echo ""
                        echo "================================================"
                        echo "ECS TASK: RUNNING"
                        echo "CONTAINER: RUNNING"
                        echo "================================================"
                    '''
                }
            }
        }

        // ============================================================
        // PART 12
        // FINAL DEPLOYMENT INFORMATION
        // ============================================================

        stage('18 - Final Deployment Summary') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        env.ALB_DNS = sh(
                            script: '''
                                aws elbv2 describe-load-balancers \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --load-balancer-arns "${ALB_ARN}" \
                                    --query 'LoadBalancers[0].DNSName' \
                                    --output text
                            ''',
                            returnStdout: true
                        ).trim()

                        env.APPLICATION_URL =
                            "http://${env.ALB_DNS}"

                        echo ''
                        echo '================================================'
                        echo '       DEPLOYMENT SUMMARY'
                        echo '================================================'

                        echo ''
                        echo "Environment      : ${env.ENVIRONMENT}"
                        echo "ECR Image        : ${env.ECR_IMAGE}"
                        echo "ECS Cluster      : ${env.ECS_CLUSTER}"
                        echo "ECS Service      : ${env.ECS_SERVICE}"
                        echo "Task Definition  : ${env.ECS_TASK_FAMILY}"
                        echo "ALB Name         : ${env.ALB_NAME}"
                        echo "ALB DNS          : ${env.ALB_DNS}"
                        echo "Application URL  : ${env.APPLICATION_URL}"

                        echo ''
                        echo '================================================'
                        echo ' ECS SERVICE       : RUNNING'
                        echo ' FARGATE TASK      : RUNNING'
                        echo ' CONTAINER         : RUNNING'
                        echo ' ALB               : CREATED'
                        echo '================================================'

                        echo ''
                        echo 'NOTE: Part 7 health checks have been removed.'
                        echo 'The pipeline does not wait for ALB target health'
                        echo 'and does not perform an HTTP application check.'

                        echo ''
                        echo 'APPLICATION URL:'
                        echo "${env.APPLICATION_URL}"

                        echo ''
                        echo '================================================'
                    }
                }
            }
        }
    }

    // ================================================================
    // POST ACTIONS
    // ================================================================

    post {

        success {

            echo ''
            echo '================================================'
            echo '       COMPLETE CI/CD PIPELINE SUCCESS'
            echo '================================================'

            echo ''
            echo 'APPLICATION CODE      : PASSED'
            echo 'CODE QUALITY          : PASSED'
            echo 'AUTOMATED TESTS       : PASSED'
            echo 'DOCKER BUILD          : PASSED'
            echo 'ECR PUSH              : PASSED'
            echo 'TERRAFORM             : PASSED'
            echo 'ALB                   : CREATED'
            echo 'ECS FARGATE           : PASSED'
            echo 'ECS TASK              : RUNNING'
            echo 'CONTAINER             : RUNNING'

            echo ''
            echo '================================================'
            echo '          APPLICATION URL'
            echo '================================================'

            echo "${env.APPLICATION_URL}"

            echo ''
            echo '================================================'
            echo '          DEPLOYMENT COMPLETE'
            echo '================================================'
        }

        failure {

            echo ''
            echo '================================================'
            echo '          CI/CD PIPELINE FAILED'
            echo '================================================'

            echo ''
            echo 'The pipeline stopped because a deployment step failed.'

            echo ''
            echo 'Check the Jenkins console output for the exact failing stage.'

            echo ''
            echo 'Important areas:'
            echo '1. Python / tests'
            echo '2. Docker'
            echo '3. ECR'
            echo '4. Terraform'
            echo '5. VPC / subnets'
            echo '6. Security groups'
            echo '7. IAM role'
            echo '8. ALB'
            echo '9. ECS cluster'
            echo '10. ECS task'

            echo ''
            echo '================================================'
        }

        always {

            echo ''
            echo '================================================'
            echo 'CLEANING JENKINS WORKSPACE'
            echo '================================================'

            cleanWs(
                deleteDirs: true,
                disableDeferredWipeout: true
            )
        }
    }
}
