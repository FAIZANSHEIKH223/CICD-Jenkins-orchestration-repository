pipeline {

    agent any

    // ================================================================
    // PIPELINE OPTIONS
    // ================================================================

    options {

        timestamps()

        ansiColor('xterm')

        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                daysToKeepStr: '30',
                numToKeepStr: '50'
            )
        )

        timeout(
            time: 120,
            unit: 'MINUTES'
        )
    }


    // ================================================================
    // PARAMETERS
    // ================================================================

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: [
                'dev',
                'qa',
                'stage',
                'prod'
            ],
            description: 'Terraform environment'
        )

        string(
            name: 'DESIRED_COUNT',
            defaultValue: '1',
            description: 'Number of Fargate tasks'
        )

        string(
            name: 'ALB_NAME',
            defaultValue: 'terraform-demo-dev-alb',
            description: 'Existing ALB name. Change if your Terraform ALB has another name.'
        )

        string(
            name: 'DOMAIN_NAME',
            defaultValue: '',
            description: 'Optional Route53 DNS name, e.g. app.example.com. Leave empty to use ALB DNS.'
        )

        string(
            name: 'HOSTED_ZONE_ID',
            defaultValue: '',
            description: 'Optional Route53 hosted zone ID. Required only when DOMAIN_NAME is supplied.'
        )
    }


    // ================================================================
    // ENVIRONMENT
    // ================================================================

    environment {

        // ------------------------------------------------------------
        // APPLICATION
        // ------------------------------------------------------------

        APP_REPO =
            'https://github.com/FAIZANSHEIKH223/practice1.git'

        APP_BRANCH = 'main'


        // ------------------------------------------------------------
        // QUALITY
        // ------------------------------------------------------------

        QUALITY_REPO =
            'https://github.com/FAIZANSHEIKH223/pylint_flake8_int_jenkins.git'

        QUALITY_BRANCH = 'main'


        // ------------------------------------------------------------
        // TERRAFORM
        // ------------------------------------------------------------

        TERRAFORM_REPO =
            'https://github.com/FAIZANSHEIKH223/terraform-aws-infra.git'

        TERRAFORM_BRANCH = 'main'


        // ------------------------------------------------------------
        // JENKINS CREDENTIALS
        // ------------------------------------------------------------

        GITHUB_CREDENTIALS = 'github-creds'

        AWS_CREDENTIALS = 'aws-creds'


        // ------------------------------------------------------------
        // DIRECTORIES
        // ------------------------------------------------------------

        APP_DIR = 'practice1'

        QUALITY_DIR = 'quality-tools'

        TERRAFORM_DIR = 'terraform-infra'

        VENV_DIR = 'venv'

        REPORT_DIR = 'reports'


        // ------------------------------------------------------------
        // PYTHON
        // ------------------------------------------------------------

        PYTHON = 'python3.12'


        // ------------------------------------------------------------
        // DOCKER
        // ------------------------------------------------------------

        DOCKER_IMAGE_NAME = 'practice1'

        DOCKER_IMAGE_TAG = "${BUILD_NUMBER}"

        DOCKER_IMAGE =
            "${DOCKER_IMAGE_NAME}:${DOCKER_IMAGE_TAG}"


        // ------------------------------------------------------------
        // AWS
        // ------------------------------------------------------------

        AWS_DEFAULT_REGION = 'us-east-1'

        AWS_REGION = 'us-east-1'


        // ------------------------------------------------------------
        // ECR
        // ------------------------------------------------------------

        ECR_REPOSITORY = 'practice1'

        ECR_IMAGE_TAG = "${BUILD_NUMBER}"


        // ------------------------------------------------------------
        // TERRAFORM BACKEND
        // ------------------------------------------------------------

        TF_STATE_BUCKET =
            'terraform-state-faizan-001'

        TF_LOCK_TABLE =
            'terraform-locks'


        TF_IN_AUTOMATION = 'true'

        TF_INPUT = 'false'


        // ============================================================
        // ECS FARGATE
        // ============================================================

        ECS_CLUSTER = 'practice1-fargate-cluster'

        ECS_SERVICE = 'practice1-fargate-service'

        ECS_TASK_FAMILY = 'practice1-fargate-task'

        ECS_CONTAINER_NAME = 'practice1'

        ECS_CPU = '256'

        ECS_MEMORY = '512'

        ECS_PLATFORM_VERSION = 'LATEST'

        ECS_DESIRED_COUNT = "${params.DESIRED_COUNT}"


        // ------------------------------------------------------------
        // APPLICATION PORT
        // ------------------------------------------------------------

        CONTAINER_PORT = '8501'


        // ------------------------------------------------------------
        // ALB
        // ------------------------------------------------------------

        TARGET_GROUP_NAME =
            'practice1-fargate-tg'

        ALB_LISTENER_PORT = '80'

        ALB_HEALTH_PATH = '/'


        // ------------------------------------------------------------
        // IAM
        // ------------------------------------------------------------

        ECS_EXECUTION_ROLE_NAME =
            'practice1-ecsTaskExecutionRole'


        // ------------------------------------------------------------
        // SECURITY GROUP
        // ------------------------------------------------------------

        ECS_SECURITY_GROUP_NAME =
            'practice1-fargate-sg'
    }


    // ================================================================
    // STAGES
    // ================================================================

    stages {


        // ============================================================
        // PART 1 - CODE QUALITY
        // ============================================================

        stage('1 - Checkout Application') {

            steps {

                echo '================================================'
                echo 'CHECKOUT APPLICATION'
                echo '================================================'

                dir("${APP_DIR}") {

                    deleteDir()

                    git(
                        branch: "${APP_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${APP_REPO}"
                    )
                }
            }
        }


        stage('2 - Checkout Quality Repository') {

            steps {

                echo '================================================'
                echo 'CHECKOUT QUALITY REPOSITORY'
                echo '================================================'

                dir("${QUALITY_DIR}") {

                    deleteDir()

                    git(
                        branch: "${QUALITY_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${QUALITY_REPO}"
                    )
                }
            }
        }


        stage('3 - Verify Python') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "VERIFYING PYTHON"
                        echo "================================================"

                        command -v "${PYTHON}"

                        "${PYTHON}" --version

                        "${PYTHON}" -m pip --version
                    '''
                }
            }
        }


        stage('4 - Create Python Virtual Environment') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "CREATING VIRTUAL ENVIRONMENT"
                        echo "================================================"

                        rm -rf "${VENV_DIR}"

                        "${PYTHON}" -m venv "${VENV_DIR}"

                        "${VENV_DIR}/bin/python" --version
                    '''
                }
            }
        }


        stage('5 - Install Application Dependencies') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "INSTALLING APPLICATION DEPENDENCIES"
                        echo "================================================"

                        "${VENV_DIR}/bin/python" \
                            -m pip install --upgrade pip

                        if [ -f requirements.txt ]; then

                            "${VENV_DIR}/bin/pip" \
                                install \
                                -r requirements.txt

                        else

                            echo "No requirements.txt found."

                        fi
                    '''
                }
            }
        }


        stage('6 - Install Quality Tools') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "INSTALLING QUALITY TOOLS"
                        echo "================================================"

                        "${VENV_DIR}/bin/pip" install \
                            flake8 \
                            pylint

                        "${VENV_DIR}/bin/flake8" --version

                        "${VENV_DIR}/bin/pylint" --version
                    '''
                }
            }
        }


        stage('7 - Flake8 Code Quality') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "RUNNING FLAKE8"
                        echo "================================================"

                        mkdir -p "${REPORT_DIR}"

                        "${VENV_DIR}/bin/flake8" \
                            . \
                            --exclude="${VENV_DIR},.git,${REPORT_DIR},__pycache__" \
                            --count \
                            --statistics \
                            --tee \
                            --output-file="${REPORT_DIR}/flake8-report.txt"
                    '''
                }
            }
        }


        stage('8 - Pylint Code Quality') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "RUNNING PYLINT"
                        echo "================================================"

                        mkdir -p "${REPORT_DIR}"

                        PYTHON_FILES=$(find . \
                            -type f \
                            -name "*.py" \
                            ! -path "./${VENV_DIR}/*" \
                            ! -path "./.git/*" \
                            ! -path "./${REPORT_DIR}/*" \
                            ! -path "*/__pycache__/*")

                        if [ -z "${PYTHON_FILES}" ]; then

                            echo "ERROR: No Python files found."

                            exit 1

                        fi

                        "${VENV_DIR}/bin/pylint" \
                            ${PYTHON_FILES} \
                            --output-format=text \
                            > "${REPORT_DIR}/pylint-report.txt"
                    '''
                }
            }
        }


        stage('9 - Part 1 Success') {

            steps {

                echo '================================================'
                echo 'PART 1 CI SUCCESS'
                echo '================================================'

                echo 'Flake8 : PASSED'
                echo 'Pylint : PASSED'
            }
        }


        // ============================================================
        // PART 2 - TESTING
        // ============================================================

        stage('10 - Install Pytest') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "INSTALLING PYTEST"
                        echo "================================================"

                        "${VENV_DIR}/bin/pip" install pytest

                        "${VENV_DIR}/bin/pytest" --version
                    '''
                }
            }
        }


        stage('11 - Verify Tests') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "VERIFYING TESTS"
                        echo "================================================"

                        if [ ! -d "tests" ]; then

                            echo "ERROR: tests/ directory does not exist."

                            exit 1

                        fi

                        TEST_FILES=$(find tests \
                            -type f \
                            \\( \
                                -name "test_*.py" \
                                -o \
                                -name "*_test.py" \
                            \\))

                        if [ -z "${TEST_FILES}" ]; then

                            echo "ERROR: No pytest test files found."

                            exit 1

                        fi

                        echo "Test files:"
                        echo "${TEST_FILES}"
                    '''
                }
            }
        }


        stage('12 - Run Automated Tests') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "RUNNING AUTOMATED TESTS"
                        echo "================================================"

                        mkdir -p "${REPORT_DIR}"

                        "${VENV_DIR}/bin/pytest" \
                            tests/ \
                            -v \
                            --junitxml="${REPORT_DIR}/pytest-results.xml"
                    '''
                }
            }
        }


        stage('13 - Publish Test Results') {

            steps {

                junit(
                    testResults:
                        "${APP_DIR}/${REPORT_DIR}/pytest-results.xml",
                    allowEmptyResults: false
                )

                archiveArtifacts(
                    artifacts:
                        "${APP_DIR}/${REPORT_DIR}/pytest-results.xml," +
                        "${APP_DIR}/${REPORT_DIR}/flake8-report.txt," +
                        "${APP_DIR}/${REPORT_DIR}/pylint-report.txt",
                    allowEmptyArchive: false,
                    fingerprint: true
                )
            }
        }


        stage('14 - Part 2 Success') {

            steps {

                echo '================================================'
                echo 'PART 2 TESTING SUCCESS'
                echo '================================================'

                echo 'Pytest : PASSED'
                echo 'Tests  : PASSED'
            }
        }


        // ============================================================
        // PART 3 - DOCKER
        // ============================================================

        stage('15 - Verify Docker') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "VERIFYING DOCKER"
                        echo "================================================"

                        command -v docker

                        docker --version

                        docker info > /dev/null 2>&1

                        echo "Docker daemon is accessible."
                    '''
                }
            }
        }


        stage('16 - Prepare Docker Build Context') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "PREPARING DOCKER BUILD CONTEXT"
                        echo "================================================"

                        if [ ! -f Dockerfile ]; then

                            echo "ERROR: Dockerfile not found."

                            exit 1

                        fi


                        # IMPORTANT:
                        # The previous build copied the Jenkins-created
                        # Python virtual environment into Docker.
                        #
                        # That caused:
                        #
                        # no space left on device
                        #
                        # Therefore venv is explicitly excluded.


                        cat > .dockerignore <<'EOF'
.git
.git/**
venv
venv/**
.venv
.venv/**
__pycache__
**/__pycache__
*.pyc
*.pyo
*.pyd
.pytest_cache
.mypy_cache
.coverage
htmlcov
reports
*.log
.DS_Store
Jenkinsfile
EOF


                        echo ""
                        echo "Docker ignore file:"
                        echo ""

                        cat .dockerignore


                        echo ""
                        echo "Build context size:"
                        du -sh . || true


                        echo ""
                        echo "Docker disk usage before build:"
                        docker system df || true
                    '''
                }
            }
        }


        stage('17 - Build Docker Image') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "BUILDING DOCKER IMAGE"
                        echo "================================================"

                        echo "Image : ${DOCKER_IMAGE}"

                        docker build \
                            --pull \
                            --tag "${DOCKER_IMAGE}" \
                            .


                        docker image inspect \
                            "${DOCKER_IMAGE}" \
                            > /dev/null


                        echo ""
                        echo "Docker image created successfully."


                        docker image ls \
                            "${DOCKER_IMAGE_NAME}" \
                            --no-trunc
                    '''
                }
            }
        }


        stage('18 - Part 3 Success') {

            steps {

                echo '================================================'
                echo 'PART 3 DOCKER SUCCESS'
                echo '================================================'

                echo "Docker Image : ${DOCKER_IMAGE}"
            }
        }


        // ============================================================
        // PART 4 - AWS ECR
        // ============================================================

        stage('19 - Verify AWS CLI') {

            steps {

                sh '''
                    set -e

                    echo "================================================"
                    echo "VERIFYING AWS CLI"
                    echo "================================================"

                    command -v aws

                    aws --version
                '''
            }
        }


        stage('20 - Verify AWS Credentials') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        aws sts get-caller-identity \
                            --region "${AWS_DEFAULT_REGION}"
                    '''
                }
            }
        }


        stage('21 - Create ECR Repository If Required') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        if aws ecr describe-repositories \
                            --repository-names "${ECR_REPOSITORY}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            > /dev/null 2>&1
                        then

                            echo "ECR repository already exists."

                        else

                            echo "Creating ECR repository..."

                            aws ecr create-repository \
                                --repository-name "${ECR_REPOSITORY}" \
                                --region "${AWS_DEFAULT_REGION}"

                        fi
                    '''
                }
            }
        }


        stage('22 - Get ECR Image URI') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        def accountId = sh(
                            script: '''
                                aws sts get-caller-identity \
                                    --query Account \
                                    --output text \
                                    --region "${AWS_DEFAULT_REGION}"
                            ''',
                            returnStdout: true
                        ).trim()


                        env.AWS_ACCOUNT_ID =
                            accountId


                        env.ECR_REGISTRY =
                            "${accountId}.dkr.ecr.${AWS_DEFAULT_REGION}.amazonaws.com"


                        env.ECR_IMAGE =
                            "${env.ECR_REGISTRY}/${env.ECR_REPOSITORY}:${env.ECR_IMAGE_TAG}"


                        echo ""
                        echo "AWS Account ID : ${env.AWS_ACCOUNT_ID}"
                        echo "ECR Registry   : ${env.ECR_REGISTRY}"
                        echo "ECR Image URI  : ${env.ECR_IMAGE}"
                    }
                }
            }
        }


        stage('23 - Login Docker to ECR') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        aws ecr get-login-password \
                            --region "${AWS_DEFAULT_REGION}" \
                        | docker login \
                            --username AWS \
                            --password-stdin \
                            "${ECR_REGISTRY}"
                    '''
                }
            }
        }


        stage('24 - Tag Docker Image for ECR') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        docker tag \
                            "${DOCKER_IMAGE}" \
                            "${ECR_IMAGE}"


                        docker image inspect \
                            "${ECR_IMAGE}" \
                            > /dev/null


                        echo "Image tagged successfully:"
                        echo "${ECR_IMAGE}"
                    '''
                }
            }
        }


        stage('25 - Push Docker Image to ECR') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        docker push "${ECR_IMAGE}"
                    '''
                }
            }
        }


        stage('26 - Verify Image in ECR') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        aws ecr describe-images \
                            --repository-name "${ECR_REPOSITORY}" \
                            --image-ids imageTag="${ECR_IMAGE_TAG}" \
                            --region "${AWS_DEFAULT_REGION}"
                    '''
                }
            }
        }


        stage('27 - Part 4 Success') {

            steps {

                echo '================================================'
                echo 'PART 4 AWS ECR SUCCESS'
                echo '================================================'

                echo "ECR IMAGE URI : ${env.ECR_IMAGE}"
            }
        }


        // ============================================================
        // PART 5 - TERRAFORM
        // ============================================================

        stage('28 - Checkout Terraform Repository') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    deleteDir()

                    git(
                        branch: "${TERRAFORM_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${TERRAFORM_REPO}"
                    )
                }
            }
        }


        stage('29 - Bootstrap Terraform Backend') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "BOOTSTRAPPING TERRAFORM BACKEND"
                        echo "================================================"

                        aws sts get-caller-identity \
                            --region "${AWS_DEFAULT_REGION}"


                        if aws s3api head-bucket \
                            --bucket "${TF_STATE_BUCKET}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            > /dev/null 2>&1
                        then

                            echo "S3 state bucket already exists."

                        else

                            aws s3api create-bucket \
                                --bucket "${TF_STATE_BUCKET}" \
                                --region "${AWS_DEFAULT_REGION}"

                        fi


                        aws s3api put-bucket-versioning \
                            --bucket "${TF_STATE_BUCKET}" \
                            --versioning-configuration Status=Enabled \
                            --region "${AWS_DEFAULT_REGION}"


                        aws s3api put-bucket-encryption \
                            --bucket "${TF_STATE_BUCKET}" \
                            --server-side-encryption-configuration '{
                                "Rules": [
                                    {
                                        "ApplyServerSideEncryptionByDefault": {
                                            "SSEAlgorithm": "AES256"
                                        }
                                    }
                                ]
                            }' \
                            --region "${AWS_DEFAULT_REGION}"


                        aws s3api put-public-access-block \
                            --bucket "${TF_STATE_BUCKET}" \
                            --public-access-block-configuration \
                            BlockPublicAcls=true,IgnorePublicAcls=true,BlockPublicPolicy=true,RestrictPublicBuckets=true \
                            --region "${AWS_DEFAULT_REGION}"


                        if aws dynamodb describe-table \
                            --table-name "${TF_LOCK_TABLE}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            > /dev/null 2>&1
                        then

                            echo "DynamoDB lock table already exists."

                        else

                            aws dynamodb create-table \
                                --table-name "${TF_LOCK_TABLE}" \
                                --attribute-definitions \
                                AttributeName=LockID,AttributeType=S \
                                --key-schema \
                                AttributeName=LockID,KeyType=HASH \
                                --billing-mode PAY_PER_REQUEST \
                                --region "${AWS_DEFAULT_REGION}"


                            aws dynamodb wait table-exists \
                                --table-name "${TF_LOCK_TABLE}" \
                                --region "${AWS_DEFAULT_REGION}"

                        fi


                        echo "Terraform backend ready."
                    '''
                }
            }
        }


        stage('30 - Verify Terraform') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    sh '''
                        set -e

                        command -v terraform

                        terraform version

                        find . \
                            -maxdepth 1 \
                            -type f \
                            -name "*.tf" \
                            -print
                    '''
                }
            }
        }


        stage('31 - Verify Terraform AWS Credentials') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh '''
                            set -e

                            aws sts get-caller-identity \
                                --region "${AWS_DEFAULT_REGION}"
                        '''
                    }
                }
            }
        }


        stage('32 - Verify Terraform Environment') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    sh '''
                        set -e

                        echo "Selected Environment : ${ENVIRONMENT}"


                        if [ ! -d "environments/${ENVIRONMENT}" ]; then

                            echo "ERROR: Environment directory does not exist."

                            exit 1

                        fi


                        if [ ! -f "environments/${ENVIRONMENT}/terraform.tfvars" ]; then

                            echo "ERROR: terraform.tfvars not found."

                            exit 1

                        fi


                        echo "Terraform environment verified."
                    '''
                }
            }
        }


        stage('33 - Terraform Init') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh '''
                            set -e

                            terraform init \
                                -input=false
                        '''
                    }
                }
            }
        }


        stage('34 - Terraform Validate') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    sh '''
                        set -e

                        terraform validate
                    '''
                }
            }
        }


        stage('35 - Terraform Plan') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh '''
                            set -e

                            terraform plan \
                                -input=false \
                                -var-file="environments/${ENVIRONMENT}/terraform.tfvars" \
                                -out="tfplan"
                        '''
                    }
                }
            }
        }


        stage('36 - Terraform Apply') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh '''
                            set -e

                            terraform apply \
                                -input=false \
                                -auto-approve \
                                "tfplan"
                        '''
                    }
                }
            }
        }


        stage('37 - Verify Terraform Deployment') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh '''
                            set -e

                            terraform state list || true

                            terraform output || true

                            aws sts get-caller-identity \
                                --region "${AWS_DEFAULT_REGION}"


                            aws s3api head-bucket \
                                --bucket "${TF_STATE_BUCKET}" \
                                --region "${AWS_DEFAULT_REGION}"


                            aws dynamodb describe-table \
                                --table-name "${TF_LOCK_TABLE}" \
                                --region "${AWS_DEFAULT_REGION}" \
                                --query 'Table.TableStatus' \
                                --output text


                            echo "Terraform deployment verification PASSED."
                        '''
                    }
                }
            }
        }


        stage('38 - Part 5 Success') {

            steps {

                echo '================================================'
                echo 'PART 5 TERRAFORM SUCCESS'
                echo '================================================'

                echo "Environment : ${params.ENVIRONMENT}"
            }
        }


        // ============================================================
        // PART 6 - ECS FARGATE DEPLOYMENT
        // ============================================================

        stage('39 - Discover VPC and Subnets') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        echo '================================================'
                        echo 'DISCOVERING NETWORK'
                        echo '================================================'


                        def vpcId = ''


                        dir("${TERRAFORM_DIR}") {

                            vpcId = sh(
                                script: '''
                                    terraform output -raw vpc_id 2>/dev/null || true
                                ''',
                                returnStdout: true
                            ).trim()
                        }


                        if (!vpcId) {

                            vpcId = sh(
                                script: '''
                                    aws ec2 describe-vpcs \
                                        --region "${AWS_DEFAULT_REGION}" \
                                        --filters \
                                            Name=tag:Name,Values=*${ENVIRONMENT}* \
                                        --query 'Vpcs[0].VpcId' \
                                        --output text 2>/dev/null || true
                                ''',
                                returnStdout: true
                            ).trim()
                        }


                        if (!vpcId || vpcId == 'None') {

                            vpcId = sh(
                                script: '''
                                    aws ec2 describe-vpcs \
                                        --region "${AWS_DEFAULT_REGION}" \
                                        --filters \
                                            Name=is-default,Values=true \
                                        --query 'Vpcs[0].VpcId' \
                                        --output text
                                ''',
                                returnStdout: true
                            ).trim()
                        }


                        if (!vpcId || vpcId == 'None') {

                            error(
                                'Unable to determine VPC. ' +
                                'Provide vpc_id as a Terraform output.'
                            )
                        }


                        env.VPC_ID = vpcId


                        def subnetIds = sh(
                            script: '''
                                aws ec2 describe-subnets \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --filters \
                                        "Name=vpc-id,Values=${VPC_ID}" \
                                        "Name=map-public-ip-on-launch,Values=true" \
                                    --query 'Subnets | sort_by(@, &AvailabilityZone)[].SubnetId' \
                                    --output text
                            ''',
                            returnStdout: true
                        ).trim()


                        if (!subnetIds || subnetIds == 'None') {

                            subnetIds = sh(
                                script: '''
                                    aws ec2 describe-subnets \
                                        --region "${AWS_DEFAULT_REGION}" \
                                        --filters \
                                            "Name=vpc-id,Values=${VPC_ID}" \
                                    --query 'Subnets | sort_by(@, &AvailabilityZone)[].SubnetId' \
                                    --output text
                                ''',
                                returnStdout: true
                            ).trim()
                        }


                        if (!subnetIds || subnetIds == 'None') {

                            error(
                                "No subnets found in VPC ${vpcId}"
                            )
                        }


                        def subnetList =
                            subnetIds.split("\\s+")


                        if (subnetList.size() < 2) {

                            error(
                                "At least two subnets in different AZs " +
                                "are required for an Application Load Balancer."
                            )
                        }


                        env.SUBNET_1 =
                            subnetList[0]

                        env.SUBNET_2 =
                            subnetList[1]


                        echo "VPC      : ${env.VPC_ID}"
                        echo "Subnet 1 : ${env.SUBNET_1}"
                        echo "Subnet 2 : ${env.SUBNET_2}"
                    }
                }
            }
        }


        stage('40 - Create ECS Cluster') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "CREATING / VERIFYING ECS FARGATE CLUSTER"
                        echo "================================================"


                        if aws ecs describe-clusters \
                            --clusters "${ECS_CLUSTER}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            --query 'clusters[0].status' \
                            --output text 2>/dev/null \
                            | grep -q ACTIVE
                        then

                            echo "ECS cluster already exists."

                        else

                            aws ecs create-cluster \
                                --cluster-name "${ECS_CLUSTER}" \
                                --region "${AWS_DEFAULT_REGION}" \
                                --tags \
                                    key=Application,value=practice1 \
                                    key=Environment,value="${ENVIRONMENT}"

                        fi


                        aws ecs describe-clusters \
                            --clusters "${ECS_CLUSTER}" \
                            --region "${AWS_DEFAULT_REGION}"
                    '''
                }
            }
        }


        stage('41 - Create ECS Execution IAM Role') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "VERIFYING ECS TASK EXECUTION ROLE"
                        echo "================================================"


                        if aws iam get-role \
                            --role-name "${ECS_EXECUTION_ROLE_NAME}" \
                            > /dev/null 2>&1
                        then

                            echo "Execution role already exists."

                        else

                            cat > ecs-trust-policy.json <<'EOF'
{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
            },
            "Action": "sts:AssumeRole"
        }
    ]
}
EOF


                            aws iam create-role \
                                --role-name "${ECS_EXECUTION_ROLE_NAME}" \
                                --assume-role-policy-document \
                                file://ecs-trust-policy.json


                            aws iam attach-role-policy \
                                --role-name "${ECS_EXECUTION_ROLE_NAME}" \
                                --policy-arn \
                                arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy


                            sleep 10

                        fi


                        export ECS_EXECUTION_ROLE_ARN=$(aws iam get-role \
                            --role-name "${ECS_EXECUTION_ROLE_NAME}" \
                            --query 'Role.Arn' \
                            --output text)


                        echo "Execution Role:"
                        echo "${ECS_EXECUTION_ROLE_ARN}"
                    '''
                }
            }
        }


        stage('42 - Create ALB Security Group') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        def sgId = sh(
                            script: '''
                                aws ec2 describe-security-groups \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --filters \
                                        "Name=vpc-id,Values=${VPC_ID}" \
                                        "Name=group-name,Values=${ECS_SECURITY_GROUP_NAME}" \
                                    --query 'SecurityGroups[0].GroupId' \
                                    --output text
                            ''',
                            returnStdout: true
                        ).trim()


                        if (!sgId || sgId == 'None') {

                            sgId = sh(
                                script: '''
                                    aws ec2 create-security-group \
                                        --group-name "${ECS_SECURITY_GROUP_NAME}" \
                                        --description "Security group for practice1 Fargate" \
                                        --vpc-id "${VPC_ID}" \
                                        --region "${AWS_DEFAULT_REGION}" \
                                        --query 'GroupId' \
                                        --output text
                                ''',
                                returnStdout: true
                            ).trim()
                        }


                        env.ECS_SECURITY_GROUP_ID =
                            sgId


                        echo "ECS Security Group : ${env.ECS_SECURITY_GROUP_ID}"
                    }
                }
            }
        }


        stage('43 - Configure ECS Security Group') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "CONFIGURING ECS SECURITY GROUP"
                        echo "================================================"


                        aws ec2 authorize-security-group-ingress \
                            --group-id "${ECS_SECURITY_GROUP_ID}" \
                            --protocol tcp \
                            --port "${CONTAINER_PORT}" \
                            --cidr 0.0.0.0/0 \
                            --region "${AWS_DEFAULT_REGION}" \
                            2>/dev/null || true


                        echo "Port ${CONTAINER_PORT} enabled."
                    '''
                }
            }
        }


        stage('44 - Discover or Create ALB') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        def albArn = sh(
                            script: '''
                                aws elbv2 describe-load-balancers \
                                    --names "${ALB_NAME}" \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --query 'LoadBalancers[0].LoadBalancerArn' \
                                    --output text 2>/dev/null || true
                            ''',
                            returnStdout: true
                        ).trim()


                        if (!albArn || albArn == 'None') {

                            echo "ALB does not exist. Creating ALB."


                            def albSg = sh(
                                script: '''
                                    aws ec2 describe-security-groups \
                                        --region "${AWS_DEFAULT_REGION}" \
                                        --filters \
                                            "Name=vpc-id,Values=${VPC_ID}" \
                                            "Name=group-name,Values=practice1-alb-sg" \
                                        --query 'SecurityGroups[0].GroupId' \
                                        --output text
                                ''',
                                returnStdout: true
                            ).trim()


                            if (!albSg || albSg == 'None') {

                                albSg = sh(
                                    script: '''
                                        aws ec2 create-security-group \
                                            --group-name practice1-alb-sg \
                                            --description "ALB security group for practice1" \
                                            --vpc-id "${VPC_ID}" \
                                            --region "${AWS_DEFAULT_REGION}" \
                                            --query 'GroupId' \
                                            --output text
                                    ''',
                                    returnStdout: true
                                ).trim()
                            }


                            env.ALB_SECURITY_GROUP_ID =
                                albSg


                            aws ec2 authorize-security-group-ingress \
                                --group-id "${ALB_SECURITY_GROUP_ID}" \
                                --protocol tcp \
                                --port 80 \
                                --cidr 0.0.0.0/0 \
                                --region "${AWS_DEFAULT_REGION}" \
                                2>/dev/null || true


                            albArn = sh(
                                script: '''
                                    aws elbv2 create-load-balancer \
                                        --name "${ALB_NAME}" \
                                        --subnets "${SUBNET_1}" "${SUBNET_2}" \
                                        --security-groups "${ALB_SECURITY_GROUP_ID}" \
                                        --scheme internet-facing \
                                        --type application \
                                        --ip-address-type ipv4 \
                                        --region "${AWS_DEFAULT_REGION}" \
                                        --query 'LoadBalancers[0].LoadBalancerArn' \
                                        --output text
                                ''',
                                returnStdout: true
                            ).trim()


                            sh '''
                                aws elbv2 wait load-balancer-available \
                                    --load-balancer-arns "${ALB_ARN}" \
                                    --region "${AWS_DEFAULT_REGION}"
                            '''

                        }


                        env.ALB_ARN =
                            albArn


                        env.ALB_DNS =
                            sh(
                                script: '''
                                    aws elbv2 describe-load-balancers \
                                        --load-balancer-arns "${ALB_ARN}" \
                                        --region "${AWS_DEFAULT_REGION}" \
                                        --query 'LoadBalancers[0].DNSName' \
                                        --output text
                                ''',
                                returnStdout: true
                            ).trim()


                        env.VPC_ID =
                            sh(
                                script: '''
                                    aws elbv2 describe-load-balancers \
                                        --load-balancer-arns "${ALB_ARN}" \
                                        --region "${AWS_DEFAULT_REGION}" \
                                        --query 'LoadBalancers[0].VpcId' \
                                        --output text
                                ''',
                                returnStdout: true
                            ).trim()


                        echo "ALB ARN : ${env.ALB_ARN}"
                        echo "ALB DNS : ${env.ALB_DNS}"
                    }
                }
            }
        }


        stage('45 - Configure Fargate Target Group') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        def targetArn = sh(
                            script: '''
                                aws elbv2 describe-target-groups \
                                    --names "${TARGET_GROUP_NAME}" \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --query 'TargetGroups[0].TargetGroupArn' \
                                    --output text 2>/dev/null || true
                            ''',
                            returnStdout: true
                        ).trim()


                        if (!targetArn || targetArn == 'None') {

                            targetArn = sh(
                                script: '''
                                    aws elbv2 create-target-group \
                                        --name "${TARGET_GROUP_NAME}" \
                                        --protocol HTTP \
                                        --port "${CONTAINER_PORT}" \
                                        --target-type ip \
                                        --vpc-id "${VPC_ID}" \
                                        --health-check-protocol HTTP \
                                        --health-check-path "${ALB_HEALTH_PATH}" \
                                        --health-check-port traffic-port \
                                        --health-check-interval-seconds 30 \
                                        --health-check-timeout-seconds 10 \
                                        --healthy-threshold-count 2 \
                                        --unhealthy-threshold-count 5 \
                                        --region "${AWS_DEFAULT_REGION}" \
                                        --query 'TargetGroups[0].TargetGroupArn' \
                                        --output text
                                ''',
                                returnStdout: true
                            ).trim()

                        }


                        def targetType = sh(
                            script: '''
                                aws elbv2 describe-target-groups \
                                    --target-group-arns "${TARGET_GROUP_ARN}" \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --query 'TargetGroups[0].TargetType' \
                                    --output text
                            ''',
                            returnStdout: true
                        ).trim()


                        if (targetType != 'ip') {

                            error(
                                "Target group ${TARGET_GROUP_NAME} exists " +
                                "but target type is ${targetType}. " +
                                "Fargate requires target type 'ip'. " +
                                "Use a different TARGET_GROUP_NAME or recreate it."
                            )
                        }


                        env.TARGET_GROUP_ARN =
                            targetArn


                        echo "Target Group : ${env.TARGET_GROUP_ARN}"
                    }
                }
            }
        }


        stage('46 - Configure ALB Listener') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "CONFIGURING ALB LISTENER"
                        echo "================================================"


                        LISTENER_ARN=$(aws elbv2 describe-listeners \
                            --load-balancer-arn "${ALB_ARN}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            --query \
                            "Listeners[?Port==\`${ALB_LISTENER_PORT}\`].ListenerArn | [0]" \
                            --output text)


                        if [ -z "${LISTENER_ARN}" ] ||
                           [ "${LISTENER_ARN}" = "None" ]; then


                            echo "Creating HTTP listener..."


                            aws elbv2 create-listener \
                                --load-balancer-arn "${ALB_ARN}" \
                                --protocol HTTP \
                                --port "${ALB_LISTENER_PORT}" \
                                --default-actions \
                                    Type=forward,TargetGroupArn="${TARGET_GROUP_ARN}" \
                                --region "${AWS_DEFAULT_REGION}"


                        else


                            echo "HTTP listener already exists."


                            aws elbv2 modify-listener \
                                --listener-arn "${LISTENER_ARN}" \
                                --default-actions \
                                    Type=forward,TargetGroupArn="${TARGET_GROUP_ARN}" \
                                --region "${AWS_DEFAULT_REGION}"


                        fi
                    '''
                }
            }
        }


        stage('47 - Register ECS Task Definition') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        def executionRoleArn = sh(
                            script: '''
                                aws iam get-role \
                                    --role-name "${ECS_EXECUTION_ROLE_NAME}" \
                                    --query 'Role.Arn' \
                                    --output text
                            ''',
                            returnStdout: true
                        ).trim()


                        env.ECS_EXECUTION_ROLE_ARN =
                            executionRoleArn


                        writeFile(
                            file: 'ecs-task-definition.json',
                            text: """{
  "family": "${env.ECS_TASK_FAMILY}",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "${env.ECS_CPU}",
  "memory": "${env.ECS_MEMORY}",
  "executionRoleArn": "${executionRoleArn}",
  "containerDefinitions": [
    {
      "name": "${env.ECS_CONTAINER_NAME}",
      "image": "${env.ECR_IMAGE}",
      "essential": true,
      "portMappings": [
        {
          "containerPort": ${env.CONTAINER_PORT},
          "hostPort": ${env.CONTAINER_PORT},
          "protocol": "tcp"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "python -c \\"import urllib.request; urllib.request.urlopen('http://127.0.0.1:${env.CONTAINER_PORT}/', timeout=5)\\" || exit 1"
        ],
        "interval": 30,
        "timeout": 10,
        "retries": 3,
        "startPeriod": 60
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/${env.ECS_TASK_FAMILY}",
          "awslogs-region": "${env.AWS_DEFAULT_REGION}",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}"""
                        )


                        sh '''
                            set -e

                            echo "================================================"
                            echo "CREATING CLOUDWATCH LOG GROUP"
                            echo "================================================"


                            aws logs create-log-group \
                                --log-group-name "/ecs/${ECS_TASK_FAMILY}" \
                                --region "${AWS_DEFAULT_REGION}" \
                                2>/dev/null || true


                            aws logs put-retention-policy \
                                --log-group-name "/ecs/${ECS_TASK_FAMILY}" \
                                --retention-in-days 7 \
                                --region "${AWS_DEFAULT_REGION}"


                            echo ""
                            echo "================================================"
                            echo "REGISTERING FARGATE TASK DEFINITION"
                            echo "================================================"


                            aws ecs register-task-definition \
                                --cli-input-json file://ecs-task-definition.json \
                                --region "${AWS_DEFAULT_REGION}"


                            TASK_DEFINITION_ARN=$(aws ecs describe-task-definition \
                                --task-definition "${ECS_TASK_FAMILY}" \
                                --region "${AWS_DEFAULT_REGION}" \
                                --query 'taskDefinition.taskDefinitionArn' \
                                --output text)


                            echo ""
                            echo "Task Definition:"
                            echo "${TASK_DEFINITION_ARN}"


                            echo "${TASK_DEFINITION_ARN}" \
                                > task-definition-arn.txt
                        '''
                    }
                }
            }
        }


        stage('48 - Deploy Fargate Service') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "DEPLOYING ECS FARGATE SERVICE"
                        echo "================================================"


                        TASK_DEFINITION_ARN=$(cat task-definition-arn.txt)


                        if aws ecs describe-services \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            --query 'services[0].status' \
                            --output text 2>/dev/null \
                            | grep -q ACTIVE
                        then

                            echo "Updating existing ECS service..."


                            aws ecs update-service \
                                --cluster "${ECS_CLUSTER}" \
                                --service "${ECS_SERVICE}" \
                                --task-definition "${TASK_DEFINITION_ARN}" \
                                --desired-count "${ECS_DESIRED_COUNT}" \
                                --force-new-deployment \
                                --region "${AWS_DEFAULT_REGION}"


                        else

                            echo "Creating ECS Fargate service..."


                            aws ecs create-service \
                                --cluster "${ECS_CLUSTER}" \
                                --service-name "${ECS_SERVICE}" \
                                --task-definition "${TASK_DEFINITION_ARN}" \
                                --desired-count "${ECS_DESIRED_COUNT}" \
                                --launch-type FARGATE \
                                --platform-version "${ECS_PLATFORM_VERSION}" \
                                --network-configuration \
                                    "awsvpcConfiguration={subnets=[${SUBNET_1},${SUBNET_2}],securityGroups=[${ECS_SECURITY_GROUP_ID}],assignPublicIp=ENABLED}" \
                                --load-balancers \
                                    "targetGroupArn=${TARGET_GROUP_ARN},containerName=${ECS_CONTAINER_NAME},containerPort=${CONTAINER_PORT}" \
                                --deployment-configuration \
                                    "maximumPercent=200,minimumHealthyPercent=100,deploymentCircuitBreaker={enable=true,rollback=true}" \
                                --health-check-grace-period-seconds 120 \
                                --enable-execute-command \
                                --region "${AWS_DEFAULT_REGION}"

                        fi


                        echo ""
                        echo "Waiting for ECS service to become stable..."


                        aws ecs wait services-stable \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}" \
                            --region "${AWS_DEFAULT_REGION}"


                        echo ""
                        echo "ECS service is stable."
                    '''
                }
            }
        }


        stage('49 - Verify Fargate Tasks') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "VERIFYING FARGATE TASKS"
                        echo "================================================"


                        aws ecs describe-services \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            --query \
                            'services[0].{Status:status,Desired:desiredCount,Running:runningCount,Pending:pendingCount}' \
                            --output table


                        RUNNING=$(aws ecs describe-services \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            --query 'services[0].runningCount' \
                            --output text)


                        if [ "${RUNNING}" -lt "${ECS_DESIRED_COUNT}" ]; then

                            echo "ERROR: Desired Fargate tasks are not running."

                            echo ""
                            echo "Recent ECS events:"


                            aws ecs describe-services \
                                --cluster "${ECS_CLUSTER}" \
                                --services "${ECS_SERVICE}" \
                                --region "${AWS_DEFAULT_REGION}" \
                                --query 'services[0].events[0:10]' \
                                --output table


                            exit 1

                        fi


                        echo ""
                        echo "Fargate tasks are RUNNING."
                    '''
                }
            }
        }


        stage('50 - Verify ALB Target Health') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "VERIFYING ALB TARGET HEALTH"
                        echo "================================================"


                        for i in $(seq 1 20)
                        do

                            echo ""
                            echo "Target health attempt ${i}/20"


                            HEALTH=$(aws elbv2 describe-target-health \
                                --target-group-arn "${TARGET_GROUP_ARN}" \
                                --region "${AWS_DEFAULT_REGION}" \
                                --query \
                                'TargetHealthDescriptions[].TargetHealth.State' \
                                --output text)


                            echo "Target health: ${HEALTH}"


                            if echo "${HEALTH}" | grep -qw healthy; then

                                echo ""
                                echo "ALB target is HEALTHY."

                                break

                            fi


                            if [ "${i}" -eq 20 ]; then

                                echo ""
                                echo "ERROR: ALB target did not become healthy."

                                echo ""
                                echo "Detailed target health:"


                                aws elbv2 describe-target-health \
                                    --target-group-arn "${TARGET_GROUP_ARN}" \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --output table


                                exit 1

                            fi


                            sleep 15

                        done
                    '''
                }
            }
        }


        stage('51 - Configure Route53 DNS') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        if (
                            params.DOMAIN_NAME?.trim() &&
                            params.HOSTED_ZONE_ID?.trim()
                        ) {

                            sh '''
                                set -e

                                echo "================================================"
                                echo "CONFIGURING ROUTE53 DNS"
                                echo "================================================"


                                cat > route53-change.json <<EOF
{
  "Comment": "Practice1 Fargate application DNS",
  "Changes": [
    {
      "Action": "UPSERT",
      "ResourceRecordSet": {
        "Name": "${DOMAIN_NAME}",
        "Type": "A",
        "AliasTarget": {
          "HostedZoneId": "Z35SXDOTRQ7X7K",
          "DNSName": "dualstack.${ALB_DNS}",
          "EvaluateTargetHealth": true
        }
      }
    }
  ]
}
EOF


                                aws route53 change-resource-record-sets \
                                    --hosted-zone-id "${HOSTED_ZONE_ID}" \
                                    --change-batch file://route53-change.json


                                echo ""
                                echo "Route53 record configured:"
                                echo "${DOMAIN_NAME}"
                            '''


                            env.FINAL_APPLICATION_URL =
                                "http://${params.DOMAIN_NAME}"

                        } else {

                            echo ""
                            echo "Route53 DNS not configured."
                            echo "Using ALB DNS instead."


                            env.FINAL_APPLICATION_URL =
                                "http://${env.ALB_DNS}"
                        }
                    }
                }
            }
        }


        stage('52 - HTTP Application Health Check') {

            steps {

                sh '''
                    set -e

                    echo "================================================"
                    echo "CHECKING FINAL APPLICATION"
                    echo "================================================"


                    echo ""
                    echo "Application URL:"
                    echo "${FINAL_APPLICATION_URL}"


                    for i in $(seq 1 20)
                    do

                        echo ""
                        echo "HTTP check ${i}/20"


                        if curl \
                            --fail \
                            --silent \
                            --show-error \
                            --max-time 10 \
                            "${FINAL_APPLICATION_URL}/" \
                            > /tmp/practice1-response.html
                        then

                            echo ""
                            echo "================================================"
                            echo "APPLICATION HTTP CHECK PASSED"
                            echo "================================================"


                            echo ""
                            echo "Response received from application."


                            exit 0

                        fi


                        sleep 10

                    done


                    echo ""
                    echo "ERROR: Application HTTP check failed."


                    echo ""
                    echo "ALB target health:"


                    aws elbv2 describe-target-health \
                        --target-group-arn "${TARGET_GROUP_ARN}" \
                        --region "${AWS_DEFAULT_REGION}" \
                        --output table \
                        || true


                    exit 1
                '''
            }
        }


        stage('53 - Final Deployment Verification') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo ""
                        echo "================================================"
                        echo "FINAL FARGATE DEPLOYMENT VERIFICATION"
                        echo "================================================"


                        echo ""
                        echo "ECR IMAGE:"
                        echo "${ECR_IMAGE}"


                        echo ""
                        echo "ECS CLUSTER:"
                        echo "${ECS_CLUSTER}"


                        echo ""
                        echo "ECS SERVICE:"
                        echo "${ECS_SERVICE}"


                        echo ""
                        echo "TASK DEFINITION:"
                        cat task-definition-arn.txt


                        echo ""
                        echo "ALB:"
                        echo "${ALB_DNS}"


                        echo ""
                        echo "Target Group:"
                        echo "${TARGET_GROUP_ARN}"


                        echo ""
                        echo "Fargate Service:"


                        aws ecs describe-services \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            --query \
                            'services[0].{Status:status,Desired:desiredCount,Running:runningCount,Pending:pendingCount}' \
                            --output table


                        echo ""
                        echo "Target Health:"


                        aws elbv2 describe-target-health \
                            --target-group-arn "${TARGET_GROUP_ARN}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            --output table


                        echo ""
                        echo "================================================"
                        echo "FARGATE DEPLOYMENT VERIFICATION PASSED"
                        echo "================================================"
                    '''
                }
            }
        }


        stage('54 - FINAL APPLICATION URL') {

            steps {

                echo ''
                echo '################################################################'
                echo '#                                                              #'
                echo '#              APPLICATION DEPLOYMENT SUCCESS                 #'
                echo '#                                                              #'
                echo '################################################################'
                echo ''

                echo "ECR IMAGE URI:"
                echo "${env.ECR_IMAGE}"

                echo ''

                echo "ECS CLUSTER:"
                echo "${env.ECS_CLUSTER}"

                echo ''

                echo "ECS SERVICE:"
                echo "${env.ECS_SERVICE}"

                echo ''

                echo "FARGATE TASK COUNT:"
                echo "${params.DESIRED_COUNT}"

                echo ''

                echo "ALB DNS:"
                echo "${env.ALB_DNS}"

                echo ''

                echo "==============================================================="
                echo "FINAL WORKING APPLICATION URL"
                echo "==============================================================="

                echo "${env.FINAL_APPLICATION_URL}"

                echo "==============================================================="

                echo ''

                echo 'Open the URL above in your browser.'
            }
        }
    }


    // ================================================================
    // POST ACTIONS
    // ================================================================

    post {

        success {

            echo ''
            echo '################################################################'
            echo '#                                                              #'
            echo '#                 COMPLETE PIPELINE SUCCESS                   #'
            echo '#                                                              #'
            echo '################################################################'
            echo ''

            echo 'Part 1 - Code Quality       : PASSED'
            echo 'Part 2 - Automated Testing  : PASSED'
            echo 'Part 3 - Docker             : PASSED'
            echo 'Part 4 - AWS ECR            : PASSED'
            echo 'Part 5 - Terraform          : PASSED'
            echo 'Part 6 - ECS Fargate        : PASSED'
            echo 'ALB Target Health           : PASSED'
            echo 'Application HTTP Check      : PASSED'

            echo ''

            echo '==============================================================='
            echo 'FINAL APPLICATION URL'
            echo '==============================================================='

            echo "${env.FINAL_APPLICATION_URL}"

            echo '==============================================================='
        }


        failure {

            echo ''
            echo '################################################################'
            echo '#                                                              #'
            echo '#                    PIPELINE FAILED                          #'
            echo '#                                                              #'
            echo '################################################################'
            echo ''

            echo 'The pipeline stopped at the failed stage.'

            echo ''

            echo 'If the failure is in ECS/Fargate, check:'
            echo '1. ECS service events'
            echo '2. Fargate task stopped reason'
            echo '3. ALB target health'
            echo '4. Security groups'
            echo '5. ECR image URI'
            echo '6. ECS task execution role'
            echo '7. Subnet internet/NAT connectivity'

            echo ''
            echo '==============================================================='
        }


        always {

            echo ''
            echo '==============================================================='
            echo 'CLEANING JENKINS WORKSPACE'
            echo '==============================================================='

            cleanWs(
                deleteDirs: true,
                disableDeferredWipeout: true
            )
        }
    }
}
