pipeline {

    agent any

    options {
        timestamps()
        ansiColor('xterm')
        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                daysToKeepStr: '30',
                numToKeepStr: '50'
            )
        )

        timeout(
            time: 120,
            unit: 'MINUTES'
        )
    }

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: [
                'dev',
                'qa',
                'prod'
            ],
            description: 'Select Terraform environment'
        )

        choice(
            name: 'ACTION',
            choices: [
                'DEPLOY',
                'DESTROY'
            ],
            description: 'Select infrastructure action'
        )
    }

    environment {

        AWS_DEFAULT_REGION = 'us-east-1'

        /*
         * ========================================================
         * FOUR GITHUB REPOSITORIES
         * ========================================================
         */

        TERRAFORM_REPO =
            'https://github.com/FAIZANSHEIKH223/terraform-aws-infra.git'

        APPLICATION_REPO =
            'https://github.com/FAIZANSHEIKH223/practice1.git'

        QUALITY_REPO =
            'https://github.com/FAIZANSHEIKH223/pylint_flake8_int_jenkins.git'

        ORCHESTRATION_REPO =
            'https://github.com/FAIZANSHEIKH223/CICD-Jenkins-orchestration-repository.git'


        /*
         * ========================================================
         * JENKINS CREDENTIALS
         * ========================================================
         */

        GITHUB_CREDENTIALS = 'github-creds'

        AWS_CREDENTIALS = 'aws-creds'


        /*
         * ========================================================
         * WORKSPACE DIRECTORIES
         * ========================================================
         */

        TERRAFORM_DIR = 'terraform-aws-infra'

        APPLICATION_DIR = 'application'

        QUALITY_DIR = 'quality-tools'

        ORCHESTRATION_DIR = 'orchestration'


        /*
         * ========================================================
         * APPLICATION / AWS SETTINGS
         * ========================================================
         */

        PROJECT_NAME = 'terraform-demo'

        ECR_REPOSITORY = 'terraform-demo-dev'

        ECS_CLUSTER = 'terraform-demo-dev-cluster'

        ECS_SERVICE = 'terraform-demo-service'

        ECS_TASK_FAMILY = 'terraform-demo-task'

        IMAGE_TAG = "${BUILD_NUMBER}"
    }


    stages {


        /*
         * ========================================================
         * CHECK REQUIRED TOOLS
         * ========================================================
         */

        stage('Check Required Tools') {

            steps {

                sh '''
                    #!/bin/bash
                    set -e

                    echo "=========================================="
                    echo "Checking Required Tools"
                    echo "=========================================="

                    echo ""
                    echo "Terraform:"
                    terraform version

                    echo ""
                    echo "AWS CLI:"
                    aws --version

                    echo ""
                    echo "Docker:"
                    docker --version

                    echo ""
                    echo "Python:"
                    python3.12 --version

                    echo ""
                    echo "JQ:"
                    jq --version

                    echo ""
                    echo "Curl:"
                    curl --version | head -n 1

                    echo ""
                    echo "Git:"
                    git --version

                    echo ""
                    echo "=========================================="
                    echo "All Required Tools Found"
                    echo "=========================================="
                '''
            }
        }


        /*
         * ========================================================
         * PIPELINE ACTION
         * ========================================================
         */

        stage('Check Pipeline Action') {

            steps {

                echo """
                ==========================================
                PIPELINE CONFIGURATION
                ==========================================

                Environment : ${params.ENVIRONMENT}
                Action      : ${params.ACTION}
                Build       : ${BUILD_NUMBER}

                ==========================================
                """
            }
        }


        /*
         * ========================================================
         * CHECKOUT TERRAFORM REPOSITORY
         * ========================================================
         */

        stage('Checkout Terraform Repository') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    deleteDir()

                    git(
                        branch: 'main',
                        credentialsId: "${env.GITHUB_CREDENTIALS}",
                        url: "${env.TERRAFORM_REPO}"
                    )
                }
            }
        }


        /*
         * ========================================================
         * CHECKOUT APPLICATION REPOSITORY
         * ========================================================
         */

        stage('Checkout Application Repository') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    deleteDir()

                    git(
                        branch: 'main',
                        credentialsId: "${env.GITHUB_CREDENTIALS}",
                        url: "${env.APPLICATION_REPO}"
                    )
                }
            }
        }


        /*
         * ========================================================
         * CHECKOUT QUALITY REPOSITORY
         * ========================================================
         */

        stage('Checkout Quality Repository') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.QUALITY_DIR}") {

                    deleteDir()

                    git(
                        branch: 'main',
                        credentialsId: "${env.GITHUB_CREDENTIALS}",
                        url: "${env.QUALITY_REPO}"
                    )
                }
            }
        }


        /*
         * ========================================================
         * CHECKOUT ORCHESTRATION REPOSITORY
         * ========================================================
         */

        stage('Checkout Orchestration Repository') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.ORCHESTRATION_DIR}") {

                    deleteDir()

                    git(
                        branch: 'main',
                        credentialsId: "${env.GITHUB_CREDENTIALS}",
                        url: "${env.ORCHESTRATION_REPO}"
                    )

                    sh '''
                        #!/bin/bash
                        set -e

                        echo "=========================================="
                        echo "Orchestration Repository"
                        echo "=========================================="

                        find . \
                            -maxdepth 2 \
                            -type f \
                            | sort \
                            | head -100

                        echo ""
                        echo "Orchestration repository checkout successful."
                    '''
                }
            }
        }


        /*
         * ========================================================
         * FIX / IMPORT EXISTING IAM ROLE
         *
         * This stage:
         *
         * 1. Checks whether IAM role exists.
         * 2. If it exists and is already in Terraform state:
         *      do nothing.
         *
         * 3. If it exists in AWS but not Terraform state:
         *      automatically import it.
         *
         * 4. Terraform variables are supplied automatically.
         *
         * No "Enter a value" prompt.
         * ========================================================
         */

        stage('Fix Existing AWS Resources') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    withCredentials([
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${env.AWS_CREDENTIALS}"
                        ]
                    ]) {

                        sh '''
                            #!/bin/bash
                            set -e

                            echo "=========================================="
                            echo "Checking Existing AWS IAM Resources"
                            echo "=========================================="

                            TF_VARS="environments/${ENVIRONMENT}/terraform.tfvars"

                            if [ ! -f "$TF_VARS" ]; then

                                echo "ERROR:"
                                echo "Terraform variable file not found:"
                                echo "$TF_VARS"

                                exit 1

                            fi

                            echo "Using Terraform variables:"
                            echo "$TF_VARS"

                            /*
                             * ------------------------------------------------
                             * Initialize Terraform first.
                             * ------------------------------------------------
                             */

                            BACKEND_CONFIG="backend-${ENVIRONMENT}.conf"

                            if [ ! -f "$BACKEND_CONFIG" ]; then

                                echo "ERROR:"
                                echo "Backend configuration not found:"
                                echo "$BACKEND_CONFIG"

                                exit 1

                            fi

                            terraform init \
                                -reconfigure \
                                -backend-config="$BACKEND_CONFIG"


                            /*
                             * ------------------------------------------------
                             * IAM ROLE
                             * ------------------------------------------------
                             */

                            IAM_ROLE="terraform-demo-${ENVIRONMENT}-ecs-instance-role"

                            echo ""
                            echo "Checking IAM role:"
                            echo "$IAM_ROLE"


                            /*
                             * Check Terraform state.
                             */

                            if terraform state list 2>/dev/null \
                                | grep -Fxq "module.iam.aws_iam_role.ecs_instance_role"
                            then

                                echo ""
                                echo "IAM role already exists in Terraform state."
                                echo "No import required."

                            else

                                /*
                                 * Check AWS.
                                 */

                                if aws iam get-role \
                                    --role-name "$IAM_ROLE" \
                                    >/dev/null 2>&1
                                then

                                    echo ""
                                    echo "IAM role already exists in AWS."
                                    echo "Importing automatically into Terraform..."

                                    terraform import \
                                        -var-file="$TF_VARS" \
                                        module.iam.aws_iam_role.ecs_instance_role \
                                        "$IAM_ROLE"

                                    echo ""
                                    echo "IAM role imported successfully."

                                else

                                    echo ""
                                    echo "IAM role does not exist in AWS."
                                    echo "Terraform will create it."

                                fi

                            fi


                            /*
                             * ------------------------------------------------
                             * CLEAN STALE IMPORT BLOCKS
                             * ------------------------------------------------
                             *
                             * Use bash because process substitution
                             * (< <(...)) is not supported by /bin/sh.
                             * ------------------------------------------------
                             */

                            echo ""
                            echo "Checking Terraform import blocks..."

                            while IFS= read -r -d '' FILE
                            do

                                if grep -q \
                                    'module\\.ec2\\.aws_iam_role\\.ecs_instance_role' \
                                    "$FILE" 2>/dev/null
                                then

                                    echo ""
                                    echo "Found stale import block:"
                                    echo "$FILE"

                                    cp "$FILE" "${FILE}.jenkins-backup"

                                    python3.12 - "$FILE" <<'PYTHON'
import sys
import re

file_path = sys.argv[1]

with open(file_path, "r", encoding="utf-8") as f:
    content = f.read()

pattern = re.compile(
    r'import\\s*\\{'
    r'(?=[^}]*module\\.ec2\\.aws_iam_role\\.ecs_instance_role)'
    r'[^}]*\\}',
    re.DOTALL
)

new_content, count = pattern.subn("", content)

if count:

    with open(file_path, "w", encoding="utf-8") as f:
        f.write(new_content)

    print(
        f"Removed {count} stale import block(s) "
        f"from {file_path}"
    )

else:

    print(
        f"No matching stale import block found in {file_path}"
    )
PYTHON

                                fi

                            done < <(
                                find . \
                                    -type f \
                                    -name "*.tf" \
                                    -print0
                            )

                            echo ""
                            echo "AWS resource check completed."
                        '''
                    }
                }
            }
        }


        /*
         * ========================================================
         * TERRAFORM FORMAT
         * ========================================================
         */

        stage('Terraform Format') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    sh '''
                        #!/bin/bash
                        set -e

                        terraform fmt -check -recursive

                        echo "Terraform format check passed."
                    '''
                }
            }
        }


        /*
         * ========================================================
         * CREATE TERRAFORM BACKEND
         * ========================================================
         */

        stage('Create Terraform Backend') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        #!/bin/bash
                        set -e

                        BUCKET="terraform-state-faizan-001"
                        TABLE="terraform-locks"
                        REGION="$AWS_DEFAULT_REGION"

                        echo "=========================================="
                        echo "Checking Terraform Backend"
                        echo "=========================================="


                        /*
                         * S3
                         */

                        if aws s3api head-bucket \
                            --bucket "$BUCKET" \
                            --region "$REGION" \
                            2>/dev/null
                        then

                            echo "S3 bucket already exists:"
                            echo "$BUCKET"

                        else

                            echo "Creating S3 bucket:"
                            echo "$BUCKET"

                            if [ "$REGION" = "us-east-1" ]; then

                                aws s3api create-bucket \
                                    --bucket "$BUCKET" \
                                    --region "$REGION"

                            else

                                aws s3api create-bucket \
                                    --bucket "$BUCKET" \
                                    --region "$REGION" \
                                    --create-bucket-configuration \
                                    LocationConstraint="$REGION"

                            fi

                            aws s3api put-bucket-versioning \
                                --bucket "$BUCKET" \
                                --versioning-configuration \
                                Status=Enabled

                            aws s3api put-bucket-encryption \
                                --bucket "$BUCKET" \
                                --server-side-encryption-configuration \
                                '{
                                    "Rules": [
                                        {
                                            "ApplyServerSideEncryptionByDefault": {
                                                "SSEAlgorithm": "AES256"
                                            }
                                        }
                                    ]
                                }'

                        fi


                        /*
                         * DynamoDB
                         */

                        if aws dynamodb describe-table \
                            --table-name "$TABLE" \
                            --region "$REGION" \
                            >/dev/null 2>&1
                        then

                            echo "DynamoDB table already exists:"
                            echo "$TABLE"

                        else

                            echo "Creating DynamoDB table:"
                            echo "$TABLE"

                            aws dynamodb create-table \
                                --table-name "$TABLE" \
                                --attribute-definitions \
                                    AttributeName=LockID,AttributeType=S \
                                --key-schema \
                                    AttributeName=LockID,KeyType=HASH \
                                --billing-mode PAY_PER_REQUEST \
                                --region "$REGION"

                            aws dynamodb wait table-exists \
                                --table-name "$TABLE" \
                                --region "$REGION"

                        fi

                        echo ""
                        echo "Terraform backend is ready."
                    '''
                }
            }
        }


        /*
         * ========================================================
         * TERRAFORM INIT
         * ========================================================
         */

        stage('Terraform Init') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    withCredentials([
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${env.AWS_CREDENTIALS}"
                        ]
                    ]) {

                        sh '''
                            #!/bin/bash
                            set -e

                            BACKEND_CONFIG="backend-${ENVIRONMENT}.conf"

                            terraform init \
                                -reconfigure \
                                -backend-config="$BACKEND_CONFIG"
                        '''
                    }
                }
            }
        }


        /*
         * ========================================================
         * TERRAFORM VALIDATE
         * ========================================================
         */

        stage('Terraform Validate') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    withCredentials([
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${env.AWS_CREDENTIALS}"
                        ]
                    ]) {

                        sh '''
                            #!/bin/bash
                            set -e

                            TF_VARS="environments/${ENVIRONMENT}/terraform.tfvars"

                            terraform validate

                            echo ""
                            echo "Terraform validation successful."
                        '''
                    }
                }
            }
        }


        /*
         * ========================================================
         * TERRAFORM PLAN
         * ========================================================
         */

        stage('Terraform Plan') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    withCredentials([
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${env.AWS_CREDENTIALS}"
                        ]
                    ]) {

                        sh '''
                            #!/bin/bash
                            set -e

                            TF_VARS="environments/${ENVIRONMENT}/terraform.tfvars"

                            if [ ! -f "$TF_VARS" ]; then

                                echo "ERROR:"
                                echo "Terraform variables file not found:"
                                echo "$TF_VARS"

                                exit 1

                            fi

                            terraform plan \
                                -var-file="$TF_VARS" \
                                -out=tfplan

                            echo ""
                            echo "Terraform plan completed successfully."
                        '''
                    }
                }
            }
        }


        /*
         * ========================================================
         * TERRAFORM APPROVAL
         * ========================================================
         */

        stage('Terraform Approval') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                input(
                    message: "Terraform plan completed. Deploy ${params.ENVIRONMENT}?",
                    ok: "Deploy"
                )
            }
        }


        /*
         * ========================================================
         * TERRAFORM APPLY
         * ========================================================
         */

        stage('Terraform Apply') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    withCredentials([
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${env.AWS_CREDENTIALS}"
                        ]
                    ]) {

                        sh '''
                            #!/bin/bash
                            set -e

                            terraform apply \
                                -auto-approve \
                                tfplan

                            echo "Terraform apply completed successfully."
                        '''
                    }
                }
            }
        }


        /*
         * ========================================================
         * WAIT FOR INFRASTRUCTURE
         * ========================================================
         */

        stage('Wait For Infrastructure') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                sh '''
                    #!/bin/bash
                    set -e

                    echo "Waiting for AWS infrastructure..."

                    sleep 20

                    echo "Infrastructure wait completed."
                '''
            }
        }


        /*
         * ========================================================
         * PYTHON VERSION
         * ========================================================
         */

        stage('Python Version') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    sh '''
                        #!/bin/bash
                        set -e

                        python3.12 --version

                        python3.12 -m pip --version
                    '''
                }
            }
        }


        /*
         * ========================================================
         * CREATE VIRTUAL ENVIRONMENT
         * ========================================================
         */

        stage('Create Virtual Environment') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    sh '''
                        #!/bin/bash
                        set -e

                        rm -rf venv

                        python3.12 -m venv venv

                        ./venv/bin/python --version

                        ./venv/bin/pip --version
                    '''
                }
            }
        }


        /*
         * ========================================================
         * INSTALL APPLICATION DEPENDENCIES
         * ========================================================
         */

        stage('Install Application Dependencies') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    sh '''
                        #!/bin/bash
                        set -e

                        ./venv/bin/pip install --upgrade pip

                        if [ -f requirements.txt ]; then

                            ./venv/bin/pip install \
                                -r requirements.txt

                        fi

                        ./venv/bin/pip install \
                            pytest \
                            pytest-cov \
                            pylint \
                            flake8 \
                            coverage
                    '''
                }
            }
        }


        /*
         * ========================================================
         * RUN PYTEST
         *
         * IMPORTANT:
         *
         * If there are no tests, the pipeline DOES NOT FAIL.
         * ========================================================
         */

        stage('Run Pytest') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    sh '''
                        #!/bin/bash
                        set -eu

                        echo "=========================================="
                        echo "Running Pytest"
                        echo "=========================================="

                        mkdir -p reports

                        TEST_COUNT=$(
                            find . \
                                -type f \
                                \\( \
                                    -name "test_*.py" \
                                    -o \
                                    -name "*_test.py" \
                                \\) \
                                -not -path "./venv/*" \
                                -not -path "./.git/*" \
                                -not -path "./reports/*" \
                                | wc -l
                        )

                        echo "Test files found: $TEST_COUNT"

                        if [ "$TEST_COUNT" -eq 0 ]; then

                            echo ""
                            echo "WARNING: No pytest test files found."
                            echo "Pytest will be skipped."
                            echo "Pipeline will continue automatically."

                            echo "NO_TESTS" \
                                > reports/pytest-status.txt

                            cat > reports/pytest-results.xml <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<testsuite
    name="pytest"
    tests="0"
    failures="0"
    errors="0"
    skipped="0">
</testsuite>
EOF

                            exit 0
                        fi

                        ./venv/bin/pytest \
                            -v \
                            --junitxml=reports/pytest-results.xml

                        echo "PYTEST_SUCCESS" \
                            > reports/pytest-status.txt

                        echo ""
                        echo "Pytest completed successfully."
                    '''
                }
            }
        }


        /*
         * ========================================================
         * COVERAGE
         * ========================================================
         */

        stage('Coverage') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    sh '''
                        #!/bin/bash
                        set -eu

                        mkdir -p reports

                        if [ -f reports/pytest-status.txt ] &&
                           grep -q "^NO_TESTS$" reports/pytest-status.txt
                        then

                            echo "No tests were found."
                            echo "Coverage will be skipped."

                            echo "NO_TESTS" \
                                > reports/coverage-status.txt

                            exit 0

                        fi

                        ./venv/bin/coverage erase || true

                        ./venv/bin/coverage run \
                            -m pytest

                        ./venv/bin/coverage report

                        ./venv/bin/coverage html \
                            -d reports/coverage

                        ./venv/bin/coverage xml \
                            -o reports/coverage.xml

                        echo "COVERAGE_SUCCESS" \
                            > reports/coverage-status.txt
                    '''
                }
            }
        }


        /*
         * ========================================================
         * PYLINT
         * ========================================================
         */

        stage('Pylint') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    sh '''
                        #!/bin/bash
                        set -eu

                        mkdir -p reports

                        set +e

                        ./venv/bin/pylint . \
                            --ignore=venv,.git,reports,__pycache__ \
                            --output-format=text \
                            > reports/pylint-report.txt 2>&1

                        PYLINT_EXIT=$?

                        set -e

                        cat reports/pylint-report.txt

                        echo ""
                        echo "Pylint exit code: $PYLINT_EXIT"

                        if [ "$PYLINT_EXIT" -ne 0 ]; then

                            echo "PYLINT_WARNINGS" \
                                > reports/pylint-status.txt

                            echo ""
                            echo "WARNING: Pylint found issues."
                            echo "Pipeline will continue."

                        else

                            echo "PYLINT_SUCCESS" \
                                > reports/pylint-status.txt

                        fi
                    '''
                }
            }
        }


        /*
         * ========================================================
         * FLAKE8
         * ========================================================
         */

        stage('Flake8') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    sh '''
                        #!/bin/bash
                        set -eu

                        mkdir -p reports

                        set +e

                        ./venv/bin/flake8 . \
                            --exclude=venv,.git,reports,__pycache__ \
                            --statistics \
                            --count \
                            --tee \
                            --output-file=reports/flake8-report.txt

                        FLAKE8_EXIT=$?

                        set -e

                        echo ""
                        echo "Flake8 exit code: $FLAKE8_EXIT"

                        if [ "$FLAKE8_EXIT" -ne 0 ]; then

                            echo "FLAKE8_WARNINGS" \
                                > reports/flake8-status.txt

                            echo ""
                            echo "WARNING: Flake8 found issues."
                            echo "Pipeline will continue."

                        else

                            echo "FLAKE8_SUCCESS" \
                                > reports/flake8-status.txt

                        fi
                    '''
                }
            }
        }


        /*
         * ========================================================
         * ARCHIVE QUALITY REPORTS
         * ========================================================
         */

        stage('Archive Quality Reports') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                archiveArtifacts(
                    artifacts: 'application/reports/**/*',
                    allowEmptyArchive: true,
                    fingerprint: true
                )

                junit(
                    testResults:
                        'application/reports/pytest-results.xml',
                    allowEmptyResults: true
                )

                echo """
                ==========================================
                QUALITY REPORTS ARCHIVED
                ==========================================

                Pytest:
                application/reports/pytest-results.xml

                Coverage:
                application/reports/coverage/

                Pylint:
                application/reports/pylint-report.txt

                Flake8:
                application/reports/flake8-report.txt

                ==========================================
                """
            }
        }


        /*
         * ========================================================
         * PREPARE ECR
         * ========================================================
         */

        stage('Prepare ECR Repository') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        #!/bin/bash
                        set -e

                        echo "Checking ECR repository..."

                        if aws ecr describe-repositories \
                            --repository-names "$ECR_REPOSITORY" \
                            --region "$AWS_DEFAULT_REGION" \
                            >/dev/null 2>&1
                        then

                            echo "ECR repository already exists:"
                            echo "$ECR_REPOSITORY"

                        else

                            echo "ECR repository does not exist."
                            echo "Creating automatically..."

                            aws ecr create-repository \
                                --repository-name "$ECR_REPOSITORY" \
                                --region "$AWS_DEFAULT_REGION"

                            echo "ECR repository created."

                        fi
                    '''
                }
            }
        }


        /*
         * ========================================================
         * DOCKER BUILD
         * ========================================================
         */

        stage('Docker Build') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    withCredentials([
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${env.AWS_CREDENTIALS}"
                        ]
                    ]) {

                        sh '''
                            #!/bin/bash
                            set -e

                            if [ ! -f Dockerfile ]; then

                                echo "ERROR:"
                                echo "Dockerfile not found."

                                exit 1

                            fi

                            AWS_ACCOUNT_ID=$(
                                aws sts get-caller-identity \
                                    --query Account \
                                    --output text
                            )

                            ECR_REGISTRY="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_DEFAULT_REGION}.amazonaws.com"

                            IMAGE="${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}"

                            LATEST_IMAGE="${ECR_REGISTRY}/${ECR_REPOSITORY}:latest"

                            docker build \
                                -t "$IMAGE" \
                                -t "$LATEST_IMAGE" \
                                .

                            echo "$IMAGE" \
                                > ../docker-image.txt
                        '''
                    }
                }
            }
        }


        /*
         * ========================================================
         * LOGIN TO ECR
         * ========================================================
         */

        stage('Login to Amazon ECR') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        #!/bin/bash
                        set -e

                        AWS_ACCOUNT_ID=$(
                            aws sts get-caller-identity \
                                --query Account \
                                --output text
                        )

                        ECR_REGISTRY="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_DEFAULT_REGION}.amazonaws.com"

                        aws ecr get-login-password \
                            --region "$AWS_DEFAULT_REGION" \
                        | docker login \
                            --username AWS \
                            --password-stdin "$ECR_REGISTRY"
                    '''
                }
            }
        }


        /*
         * ========================================================
         * PUSH DOCKER IMAGE
         * ========================================================
         */

        stage('Push Docker Image') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        #!/bin/bash
                        set -e

                        AWS_ACCOUNT_ID=$(
                            aws sts get-caller-identity \
                                --query Account \
                                --output text
                        )

                        ECR_REGISTRY="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_DEFAULT_REGION}.amazonaws.com"

                        IMAGE="${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}"

                        LATEST_IMAGE="${ECR_REGISTRY}/${ECR_REPOSITORY}:latest"

                        docker push "$IMAGE"

                        docker push "$LATEST_IMAGE"

                        echo "$IMAGE" > docker-image.txt

                        echo ""
                        echo "Docker image pushed successfully:"
                        echo "$IMAGE"
                    '''
                }
            }
        }


        /*
         * ========================================================
         * VERIFY ECR
         * ========================================================
         */

        stage('Verify ECR Repository') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        #!/bin/bash
                        set -e

                        aws ecr describe-images \
                            --repository-name "$ECR_REPOSITORY" \
                            --region "$AWS_DEFAULT_REGION"

                        echo "ECR verification successful."
                    '''
                }
            }
        }


        /*
         * ========================================================
         * DOCKER CLEANUP
         * ========================================================
         */

        stage('Docker Cleanup') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                sh '''
                    #!/bin/bash

                    set +e

                    docker image prune -af

                    echo "Docker cleanup completed."
                '''
            }
        }


        /*
         * ========================================================
         * VERIFY ECS CLUSTER
         * ========================================================
         */

        stage('Verify ECS Cluster') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        #!/bin/bash
                        set -e

                        aws ecs describe-clusters \
                            --clusters "$ECS_CLUSTER" \
                            --region "$AWS_DEFAULT_REGION"

                        echo "ECS cluster verified."
                    '''
                }
            }
        }


        /*
         * ========================================================
         * REGISTER ECS TASK DEFINITION
         * ========================================================
         */

        stage('Register New Task Definition') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        #!/bin/bash
                        set -e

                        AWS_ACCOUNT_ID=$(
                            aws sts get-caller-identity \
                                --query Account \
                                --output text
                        )

                        ECR_IMAGE="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_DEFAULT_REGION}.amazonaws.com/${ECR_REPOSITORY}:${IMAGE_TAG}"

                        EXECUTION_ROLE="arn:aws:iam::${AWS_ACCOUNT_ID}:role/terraform-demo-${ENVIRONMENT}-ecs-task-execution-role"

                        cat > ecs-task-definition.json <<EOF
{
    "family": "${ECS_TASK_FAMILY}",
    "networkMode": "bridge",
    "requiresCompatibilities": [
        "EC2"
    ],
    "cpu": "256",
    "memory": "512",
    "executionRoleArn": "${EXECUTION_ROLE}",
    "containerDefinitions": [
        {
            "name": "app",
            "image": "${ECR_IMAGE}",
            "essential": true,
            "cpu": 256,
            "memory": 512,
            "portMappings": [
                {
                    "containerPort": 8501,
                    "hostPort": 8501,
                    "protocol": "tcp"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/terraform-demo",
                    "awslogs-region": "${AWS_DEFAULT_REGION}",
                    "awslogs-stream-prefix": "ecs"
                }
            }
        }
    ]
}
EOF

                        aws ecs register-task-definition \
                            --cli-input-json file://ecs-task-definition.json \
                            --region "$AWS_DEFAULT_REGION"

                        echo "New ECS task definition registered."
                    '''
                }
            }
        }


        /*
         * ========================================================
         * GET LATEST ECS REVISION
         * ========================================================
         */

        stage('Get Latest Revision') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        #!/bin/bash
                        set -e

                        REVISION=$(
                            aws ecs describe-task-definition \
                                --task-definition "$ECS_TASK_FAMILY" \
                                --region "$AWS_DEFAULT_REGION" \
                                --query 'taskDefinition.revision' \
                                --output text
                        )

                        echo "$REVISION" > ecs-revision.txt

                        echo "Latest ECS revision:"
                        echo "$REVISION"
                    '''
                }
            }
        }


        /*
         * ========================================================
         * DEPLOY ECS SERVICE
         * ========================================================
         */

        stage('Deploy ECS Service') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        #!/bin/bash
                        set -e

                        REVISION=$(cat ecs-revision.txt)

                        aws ecs update-service \
                            --cluster "$ECS_CLUSTER" \
                            --service "$ECS_SERVICE" \
                            --task-definition "${ECS_TASK_FAMILY}:${REVISION}" \
                            --force-new-deployment \
                            --region "$AWS_DEFAULT_REGION"

                        echo "ECS service deployment started."
                    '''
                }
            }
        }


        /*
         * ========================================================
         * WAIT FOR ECS
         * ========================================================
         */

        stage('Wait For ECS Deployment') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        #!/bin/bash
                        set -e

                        aws ecs wait services-stable \
                            --cluster "$ECS_CLUSTER" \
                            --services "$ECS_SERVICE" \
                            --region "$AWS_DEFAULT_REGION"

                        echo "ECS service is stable."
                    '''
                }
            }
        }


        /*
         * ========================================================
         * HEALTH CHECK
         * ========================================================
         */

        stage('Health Check') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    withCredentials([
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${env.AWS_CREDENTIALS}"
                        ]
                    ]) {

                        sh '''
                            #!/bin/bash
                            set -e

                            ALB_DNS=$(
                                terraform output \
                                    -raw alb_dns_name
                            )

                            echo "ALB DNS:"
                            echo "$ALB_DNS"

                            echo ""
                            echo "Waiting for ALB..."
                            sleep 30

                            echo ""
                            echo "Checking application..."

                            curl \
                                --fail \
                                --max-time 15 \
                                "http://${ALB_DNS}/"

                            echo ""
                            echo "Health check successful."
                        '''
                    }
                }
            }
        }


        /*
         * ========================================================
         * DEPLOYMENT SUCCESS
         * ========================================================
         */

        stage('Deployment Successful') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                echo """
                ==========================================
                DEPLOYMENT SUCCESSFUL
                ==========================================

                Environment : ${params.ENVIRONMENT}
                Build       : ${BUILD_NUMBER}

                Terraform   : SUCCESS
                Application : SUCCESS
                Tests       : COMPLETED / SKIPPED
                Coverage    : COMPLETED / SKIPPED
                Pylint      : COMPLETED
                Flake8      : COMPLETED
                Docker      : SUCCESS
                ECR         : SUCCESS
                ECS         : SUCCESS
                Health      : SUCCESS

                ==========================================
                """
            }
        }


        /*
         * ========================================================
         * TERRAFORM DESTROY
         * ========================================================
         */

        stage('Terraform Destroy') {

            when {
                expression {
                    params.ACTION == 'DESTROY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    deleteDir()

                    git(
                        branch: 'main',
                        credentialsId: "${env.GITHUB_CREDENTIALS}",
                        url: "${env.TERRAFORM_REPO}"
                    )

                    withCredentials([
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${env.AWS_CREDENTIALS}"
                        ]
                    ]) {

                        sh '''
                            #!/bin/bash
                            set -e

                            BACKEND_CONFIG="backend-${ENVIRONMENT}.conf"

                            TF_VARS="environments/${ENVIRONMENT}/terraform.tfvars"

                            echo "=========================================="
                            echo "TERRAFORM DESTROY"
                            echo "=========================================="

                            terraform init \
                                -reconfigure \
                                -backend-config="$BACKEND_CONFIG"

                            terraform destroy \
                                -var-file="$TF_VARS" \
                                -auto-approve

                            echo ""
                            echo "Terraform destroy completed."
                        '''
                    }
                }
            }
        }
    }


    /*
     * ============================================================
     * POST ACTIONS
     * ============================================================
     */

    post {

        always {

            echo "=========================================="
            echo "Cleaning Jenkins workspace..."
            echo "=========================================="

            cleanWs(
                deleteDirs: true,
                disableDeferredWipeout: true
            )
        }

        success {

            echo "=========================================="
            echo "PIPELINE SUCCESS"
            echo "=========================================="
        }

        failure {

            echo "=========================================="
            echo "PIPELINE FAILED"
            echo "=========================================="

            echo "Check the failed stage above."
        }
    }
}
