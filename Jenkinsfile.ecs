pipeline {

    agent any

    // ================================================================
    // PIPELINE OPTIONS
    // ================================================================

    options {

        timestamps()

        ansiColor('xterm')

        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                daysToKeepStr: '30',
                numToKeepStr: '50'
            )
        )

        timeout(
            time: 60,
            unit: 'MINUTES'
        )
    }


    // ================================================================
    // PARAMETERS
    // ================================================================

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: [
                'dev',
                'qa',
                'prod'
            ],
            description: 'Terraform environment to deploy'
        )
    }


    // ================================================================
    // ENVIRONMENT
    // ================================================================

    environment {

        // ------------------------------------------------------------
        // APPLICATION REPOSITORY
        // ------------------------------------------------------------

        APP_REPO =
            'https://github.com/FAIZANSHEIKH223/practice1.git'

        APP_BRANCH = 'main'


        // ------------------------------------------------------------
        // QUALITY REPOSITORY
        // ------------------------------------------------------------

        QUALITY_REPO =
            'https://github.com/FAIZANSHEIKH223/pylint_flake8_int_jenkins.git'

        QUALITY_BRANCH = 'main'


        // ------------------------------------------------------------
        // TERRAFORM REPOSITORY
        // ------------------------------------------------------------

        TERRAFORM_REPO =
            'https://github.com/FAIZANSHEIKH223/terraform-aws-infra.git'

        TERRAFORM_BRANCH = 'main'


        // ------------------------------------------------------------
        // GITHUB CREDENTIAL
        // ------------------------------------------------------------

        GITHUB_CREDENTIALS = 'github-creds'


        // ------------------------------------------------------------
        // PYTHON
        // ------------------------------------------------------------

        PYTHON = 'python3.12'


        // ------------------------------------------------------------
        // WORKSPACE DIRECTORIES
        // ------------------------------------------------------------

        APP_DIR = 'practice1'

        QUALITY_DIR = 'quality-tools'

        TERRAFORM_DIR = 'terraform-aws-infra'

        VENV_DIR = 'venv'

        REPORT_DIR = 'reports'


        // ------------------------------------------------------------
        // DOCKER
        // ------------------------------------------------------------

        DOCKER_IMAGE_NAME = 'practice1'

        DOCKER_IMAGE_TAG = "${BUILD_NUMBER}"

        DOCKER_IMAGE =
            "${DOCKER_IMAGE_NAME}:${DOCKER_IMAGE_TAG}"


        // ------------------------------------------------------------
        // AWS
        // ------------------------------------------------------------

        AWS_DEFAULT_REGION = 'us-east-1'

        AWS_REGION = 'us-east-1'

        AWS_CREDENTIALS = 'aws-creds'


        // ------------------------------------------------------------
        // ECR
        // ------------------------------------------------------------

        ECR_REPOSITORY = 'practice1'

        ECR_IMAGE_TAG = "${BUILD_NUMBER}"
    }


    // ================================================================
    // STAGES
    // ================================================================

    stages {


        // ============================================================
        // PART 1
        // STAGE 1
        // CHECKOUT APPLICATION
        // ============================================================

        stage('1 - Checkout Application') {

            steps {

                echo ''
                echo '================================================'
                echo 'CHECKOUT APPLICATION'
                echo '================================================'
                echo "Repository : ${APP_REPO}"
                echo "Branch     : ${APP_BRANCH}"
                echo '================================================'

                dir("${APP_DIR}") {

                    git(
                        branch: "${APP_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${APP_REPO}"
                    )
                }
            }
        }


        // ============================================================
        // PART 1
        // STAGE 2
        // CHECKOUT QUALITY REPOSITORY
        // ============================================================

        stage('2 - Checkout Quality Repository') {

            steps {

                echo ''
                echo '================================================'
                echo 'CHECKOUT QUALITY REPOSITORY'
                echo '================================================'
                echo "Repository : ${QUALITY_REPO}"
                echo "Branch     : ${QUALITY_BRANCH}"
                echo '================================================'

                dir("${QUALITY_DIR}") {

                    git(
                        branch: "${QUALITY_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${QUALITY_REPO}"
                    )
                }
            }
        }


        // ============================================================
        // PART 1
        // STAGE 3
        // VERIFY PYTHON
        // ============================================================

        stage('3 - Verify Python') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo ""
                        echo "================================================"
                        echo "VERIFYING PYTHON"
                        echo "================================================"

                        command -v ${PYTHON}

                        ${PYTHON} --version

                        echo ""
                        echo "================================================"
                        echo "VERIFYING PIP"
                        echo "================================================"

                        ${PYTHON} -m pip --version

                        echo ""
                        echo "Python environment verification completed."
                    '''
                }
            }
        }


        // ============================================================
        // PART 1
        // STAGE 4
        // CREATE VIRTUAL ENVIRONMENT
        // ============================================================

        stage('4 - Create Python Virtual Environment') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo ""
                        echo "================================================"
                        echo "CREATING VIRTUAL ENVIRONMENT"
                        echo "================================================"

                        rm -rf "${VENV_DIR}"

                        ${PYTHON} -m venv "${VENV_DIR}"

                        echo ""
                        echo "Virtual environment created."

                        "${VENV_DIR}/bin/python" --version
                    '''
                }
            }
        }


        // ============================================================
        // PART 1
        // STAGE 5
        // INSTALL APPLICATION DEPENDENCIES
        // ============================================================

        stage('5 - Install Application Dependencies') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo ""
                        echo "================================================"
                        echo "INSTALLING APPLICATION DEPENDENCIES"
                        echo "================================================"

                        "${VENV_DIR}/bin/python" \
                            -m pip install --upgrade pip

                        if [ -f requirements.txt ]; then

                            echo ""
                            echo "requirements.txt found."

                            "${VENV_DIR}/bin/pip" \
                                install \
                                -r requirements.txt

                        else

                            echo ""
                            echo "No requirements.txt found."

                            echo "No application dependencies to install."

                        fi

                        echo ""
                        echo "Application dependency installation completed."
                    '''
                }
            }
        }


        // ============================================================
        // PART 1
        // STAGE 6
        // INSTALL FLAKE8 + PYLINT
        // ============================================================

        stage('6 - Install Quality Tools') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo ""
                        echo "================================================"
                        echo "INSTALLING QUALITY TOOLS"
                        echo "================================================"

                        "${VENV_DIR}/bin/pip" install \
                            flake8 \
                            pylint

                        echo ""
                        echo "================================================"
                        echo "FLAKE8 VERSION"
                        echo "================================================"

                        "${VENV_DIR}/bin/flake8" --version

                        echo ""
                        echo "================================================"
                        echo "PYLINT VERSION"
                        echo "================================================"

                        "${VENV_DIR}/bin/pylint" --version

                        echo ""
                        echo "Quality tools installed successfully."
                    '''
                }
            }
        }


        // ============================================================
        // PART 1
        // STAGE 7
        // FLAKE8
        // ============================================================

        stage('7 - Flake8 Code Quality') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo ""
                        echo "================================================"
                        echo "RUNNING FLAKE8"
                        echo "================================================"

                        mkdir -p "${REPORT_DIR}"

                        "${VENV_DIR}/bin/flake8" \
                            . \
                            --exclude="${VENV_DIR},.git,${REPORT_DIR},__pycache__" \
                            --count \
                            --statistics \
                            --tee \
                            --output-file="${REPORT_DIR}/flake8-report.txt"

                        echo ""
                        echo "================================================"
                        echo "FLAKE8 PASSED"
                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // PART 1
        // STAGE 8
        // PYLINT
        // ============================================================

        stage('8 - Pylint Code Quality') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo ""
                        echo "================================================"
                        echo "RUNNING PYLINT"
                        echo "================================================"

                        mkdir -p "${REPORT_DIR}"

                        echo ""
                        echo "Python files to analyze:"

                        find . \
                            -type f \
                            -name "*.py" \
                            ! -path "./${VENV_DIR}/*" \
                            ! -path "./.git/*" \
                            ! -path "./${REPORT_DIR}/*" \
                            ! -path "*/__pycache__/*"

                        echo ""
                        echo "Starting Pylint..."

                        PYTHON_FILES=$(find . \
                            -type f \
                            -name "*.py" \
                            ! -path "./${VENV_DIR}/*" \
                            ! -path "./.git/*" \
                            ! -path "./${REPORT_DIR}/*" \
                            ! -path "*/__pycache__/*")

                        if [ -z "${PYTHON_FILES}" ]; then

                            echo "No Python files found for Pylint."

                            exit 1

                        fi

                        "${VENV_DIR}/bin/pylint" \
                            ${PYTHON_FILES} \
                            --output-format=text \
                            > "${REPORT_DIR}/pylint-report.txt"

                        echo ""
                        echo "================================================"
                        echo "PYLINT PASSED"
                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // PART 1 COMPLETE
        // STAGE 9
        // ============================================================

        stage('9 - Part 1 Success') {

            steps {

                echo ''
                echo '================================================'
                echo '           PART 1 CI SUCCESS'
                echo '================================================'
                echo ''
                echo 'Application Repository : practice1'
                echo 'Quality Repository     : pylint_flake8_int_jenkins'
                echo 'Python                 : 3.12'
                echo ''
                echo 'Checkout               : PASSED'
                echo 'Python Environment     : PASSED'
                echo 'Dependencies           : PASSED'
                echo 'Flake8                 : PASSED'
                echo 'Pylint                 : PASSED'
                echo ''
                echo '================================================'
                echo '       STARTING PART 2 - TESTING'
                echo '================================================'
            }
        }


        // ============================================================
        // PART 2
        // STAGE 10
        // INSTALL PYTEST
        // ============================================================

        stage('10 - Install Pytest') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo ""
                        echo "================================================"
                        echo "INSTALLING PYTEST"
                        echo "================================================"

                        "${VENV_DIR}/bin/pip" install pytest

                        echo ""
                        echo "================================================"
                        echo "PYTEST VERSION"
                        echo "================================================"

                        "${VENV_DIR}/bin/pytest" --version

                        echo ""
                        echo "Pytest installed successfully."
                    '''
                }
            }
        }


        // ============================================================
        // PART 2
        // STAGE 11
        // VERIFY TEST DIRECTORY
        // ============================================================

        stage('11 - Verify Tests') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo ""
                        echo "================================================"
                        echo "VERIFYING TEST DIRECTORY"
                        echo "================================================"

                        if [ ! -d "tests" ]; then

                            echo ""
                            echo "ERROR: tests/ directory does not exist."
                            echo ""
                            echo "Expected structure:"
                            echo ""
                            echo "tests/"
                            echo "└── test_app.py"
                            echo ""

                            exit 1
                        fi

                        echo ""
                        echo "tests/ directory found."

                        TEST_FILES=$(find tests \
                            -type f \
                            \\( \
                                -name "test_*.py" \
                                -o \
                                -name "*_test.py" \
                            \\))

                        if [ -z "${TEST_FILES}" ]; then

                            echo ""
                            echo "ERROR: No pytest test files found."
                            echo ""
                            echo "Expected files such as:"
                            echo "tests/test_app.py"
                            echo ""

                            exit 1
                        fi

                        echo ""
                        echo "Test files found:"
                        echo "${TEST_FILES}"

                        echo ""
                        echo "Test verification PASSED."
                    '''
                }
            }
        }


        // ============================================================
        // PART 2
        // STAGE 12
        // RUN AUTOMATED TESTS
        // ============================================================

        stage('12 - Run Automated Tests') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo ""
                        echo "================================================"
                        echo "RUNNING AUTOMATED TESTS"
                        echo "================================================"

                        mkdir -p "${REPORT_DIR}"

                        "${VENV_DIR}/bin/pytest" \
                            tests/ \
                            -v \
                            --junitxml="${REPORT_DIR}/pytest-results.xml"

                        echo ""
                        echo "================================================"
                        echo "ALL AUTOMATED TESTS PASSED"
                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // PART 2
        // STAGE 13
        // PUBLISH TEST RESULTS
        // ============================================================

        stage('13 - Publish Test Results') {

            steps {

                junit(
                    testResults:
                        "${APP_DIR}/${REPORT_DIR}/pytest-results.xml",
                    allowEmptyResults: false
                )

                archiveArtifacts(
                    artifacts:
                        "${APP_DIR}/${REPORT_DIR}/pytest-results.xml," +
                        "${APP_DIR}/${REPORT_DIR}/flake8-report.txt," +
                        "${APP_DIR}/${REPORT_DIR}/pylint-report.txt",

                    allowEmptyArchive: false,

                    fingerprint: true
                )
            }
        }


        // ============================================================
        // PART 2 COMPLETE
        // STAGE 14
        // ============================================================

        stage('14 - Part 2 Success') {

            steps {

                echo ''
                echo '================================================'
                echo '           PART 2 CI SUCCESS'
                echo '================================================'
                echo ''
                echo 'PART 1'
                echo 'Flake8                 : PASSED'
                echo 'Pylint                 : PASSED'
                echo ''
                echo 'PART 2'
                echo 'Pytest                 : PASSED'
                echo 'Test Results           : GENERATED'
                echo ''
                echo '================================================'
                echo '       READY FOR PART 3 - DOCKER'
                echo '================================================'
            }
        }


        // ============================================================
        // PART 3
        // STAGE 15
        // VERIFY DOCKER
        // ============================================================

        stage('15 - Verify Docker') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo ""
                        echo "================================================"
                        echo "VERIFYING DOCKER"
                        echo "================================================"

                        echo ""
                        echo "Docker executable:"
                        command -v docker

                        echo ""
                        echo "Docker version:"
                        docker --version

                        echo ""
                        echo "Checking Docker daemon access..."

                        docker info > /dev/null

                        echo ""
                        echo "Docker daemon is accessible."

                        echo ""
                        echo "================================================"
                        echo "DOCKER VERIFICATION PASSED"
                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // PART 3
        // STAGE 16
        // VERIFY DOCKERFILE
        // ============================================================

        stage('16 - Verify Dockerfile') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo ""
                        echo "================================================"
                        echo "VERIFYING DOCKERFILE"
                        echo "================================================"

                        if [ ! -f "Dockerfile" ]; then

                            echo ""
                            echo "ERROR: Dockerfile was not found."
                            echo ""

                            echo "Current directory:"
                            pwd

                            echo ""
                            echo "Available files:"

                            find . \
                                -maxdepth 2 \
                                -type f \
                                ! -path "./venv/*" \
                                ! -path "./.git/*" \
                                -print

                            exit 1
                        fi

                        echo ""
                        echo "Dockerfile found."

                        echo ""
                        echo "Dockerfile contents:"
                        echo "------------------------------------------------"

                        cat Dockerfile

                        echo "------------------------------------------------"

                        echo ""
                        echo "Dockerfile verification PASSED."
                    '''
                }
            }
        }


        // ============================================================
        // PART 3
        // STAGE 17
        // BUILD DOCKER IMAGE
        // ============================================================

        stage('17 - Build Docker Image') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo ""
                        echo "================================================"
                        echo "BUILDING DOCKER IMAGE"
                        echo "================================================"

                        echo ""
                        echo "Docker Image Name : ${DOCKER_IMAGE_NAME}"
                        echo "Docker Image Tag  : ${DOCKER_IMAGE_TAG}"
                        echo "Docker Image      : ${DOCKER_IMAGE}"

                        echo ""
                        echo "Starting Docker build..."

                        docker build \
                            --tag "${DOCKER_IMAGE}" \
                            .

                        echo ""
                        echo "================================================"
                        echo "DOCKER BUILD COMPLETED"
                        echo "================================================"

                        echo ""
                        echo "Verifying Docker image..."

                        docker image inspect \
                            "${DOCKER_IMAGE}" \
                            > /dev/null

                        echo ""
                        echo "Docker image verified successfully."

                        echo ""
                        echo "Docker image details:"
                        docker image ls "${DOCKER_IMAGE_NAME}"

                        echo ""
                        echo "================================================"
                        echo "PART 3 DOCKER BUILD PASSED"
                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // PART 3 COMPLETE
        // STAGE 18
        // ============================================================

        stage('18 - Part 3 Success') {

            steps {

                echo ''
                echo '================================================'
                echo '           PART 3 DOCKER SUCCESS'
                echo '================================================'
                echo ''
                echo 'PART 1'
                echo 'Flake8                 : PASSED'
                echo 'Pylint                 : PASSED'
                echo ''
                echo 'PART 2'
                echo 'Pytest                 : PASSED'
                echo 'Automated Tests        : PASSED'
                echo ''
                echo 'PART 3'
                echo 'Docker Verification    : PASSED'
                echo 'Dockerfile             : PASSED'
                echo 'Docker Build           : PASSED'
                echo 'Docker Image           : CREATED'
                echo ''
                echo "Docker Image           : ${DOCKER_IMAGE}"
                echo ''
                echo '================================================'
                echo '       STARTING PART 4 - AWS ECR'
                echo '================================================'
            }
        }


        // ============================================================
        // PART 4
        // STAGE 19
        // VERIFY AWS CLI
        // ============================================================

        stage('19 - Verify AWS CLI') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo ""
                        echo "================================================"
                        echo "VERIFYING AWS CLI"
                        echo "================================================"

                        echo ""
                        echo "AWS executable:"
                        command -v aws

                        echo ""
                        echo "AWS CLI version:"
                        aws --version

                        echo ""
                        echo "AWS CLI verification PASSED."
                    '''
                }
            }
        }


        // ============================================================
        // PART 4
        // STAGE 20
        // VERIFY AWS CREDENTIALS
        // ============================================================

        stage('20 - Verify AWS Credentials') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo ""
                        echo "================================================"
                        echo "VERIFYING AWS CREDENTIALS"
                        echo "================================================"

                        echo ""
                        echo "AWS Region:"
                        echo "${AWS_DEFAULT_REGION}"

                        echo ""
                        echo "Checking AWS identity..."

                        aws sts get-caller-identity \
                            --region "${AWS_DEFAULT_REGION}"

                        echo ""
                        echo "AWS credentials are valid."

                        echo ""
                        echo "================================================"
                        echo "AWS CREDENTIAL VERIFICATION PASSED"
                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // PART 4
        // STAGE 21
        // CREATE ECR REPOSITORY IF REQUIRED
        // ============================================================

        stage('21 - Create ECR Repository If Required') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo ""
                        echo "================================================"
                        echo "VERIFYING ECR REPOSITORY"
                        echo "================================================"

                        echo ""
                        echo "AWS Region       : ${AWS_DEFAULT_REGION}"
                        echo "ECR Repository   : ${ECR_REPOSITORY}"

                        echo ""
                        echo "Checking whether ECR repository already exists..."

                        if aws ecr describe-repositories \
                            --repository-names "${ECR_REPOSITORY}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            > /dev/null 2>&1
                        then

                            echo ""
                            echo "ECR repository already exists."
                            echo "No duplicate repository will be created."

                        else

                            echo ""
                            echo "ECR repository does not exist."
                            echo "Creating ECR repository..."

                            aws ecr create-repository \
                                --repository-name "${ECR_REPOSITORY}" \
                                --region "${AWS_DEFAULT_REGION}"

                            echo ""
                            echo "ECR repository created successfully."

                        fi

                        echo ""
                        echo "================================================"
                        echo "ECR REPOSITORY VERIFICATION PASSED"
                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // PART 4
        // STAGE 22
        // GET ECR REGISTRY
        // ============================================================

        stage('22 - Get ECR Registry') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        def accountId = sh(
                            script: '''
                                aws sts get-caller-identity \
                                    --query Account \
                                    --output text \
                                    --region "${AWS_DEFAULT_REGION}"
                            ''',
                            returnStdout: true
                        ).trim()

                        env.AWS_ACCOUNT_ID = accountId

                        env.ECR_REGISTRY =
                            "${accountId}.dkr.ecr.${AWS_DEFAULT_REGION}.amazonaws.com"

                        env.ECR_IMAGE =
                            "${env.ECR_REGISTRY}/${env.ECR_REPOSITORY}:${env.ECR_IMAGE_TAG}"

                        echo ''
                        echo '================================================'
                        echo 'ECR REGISTRY INFORMATION'
                        echo '================================================'
                        echo ''
                        echo "AWS Account ID : ${env.AWS_ACCOUNT_ID}"
                        echo "AWS Region     : ${AWS_DEFAULT_REGION}"
                        echo "ECR Registry   : ${env.ECR_REGISTRY}"
                        echo "ECR Repository : ${env.ECR_REPOSITORY}"
                        echo "ECR Image      : ${env.ECR_IMAGE}"
                        echo ''
                        echo '================================================'
                    }
                }
            }
        }


        // ============================================================
        // PART 4
        // STAGE 23
        // LOGIN TO ECR
        // ============================================================

        stage('23 - Login Docker to ECR') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo ""
                        echo "================================================"
                        echo "AUTHENTICATING DOCKER WITH AWS ECR"
                        echo "================================================"

                        echo ""
                        echo "ECR Registry:"
                        echo "${ECR_REGISTRY}"

                        aws ecr get-login-password \
                            --region "${AWS_DEFAULT_REGION}" \
                        | docker login \
                            --username AWS \
                            --password-stdin "${ECR_REGISTRY}"

                        echo ""
                        echo "Docker successfully authenticated with ECR."

                        echo ""
                        echo "================================================"
                        echo "ECR LOGIN PASSED"
                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // PART 4
        // STAGE 24
        // TAG DOCKER IMAGE FOR ECR
        // ============================================================

        stage('24 - Tag Docker Image for ECR') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo ""
                        echo "================================================"
                        echo "TAGGING DOCKER IMAGE FOR ECR"
                        echo "================================================"

                        echo ""
                        echo "Local Docker Image:"
                        echo "${DOCKER_IMAGE}"

                        echo ""
                        echo "ECR Image:"
                        echo "${ECR_IMAGE}"

                        echo ""
                        echo "Creating ECR tag..."

                        docker tag \
                            "${DOCKER_IMAGE}" \
                            "${ECR_IMAGE}"

                        echo ""
                        echo "Verifying ECR tag..."

                        docker image inspect \
                            "${ECR_IMAGE}" \
                            > /dev/null

                        echo ""
                        echo "ECR Docker tag created successfully."

                        echo ""
                        echo "================================================"
                        echo "DOCKER ECR TAGGING PASSED"
                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // PART 4
        // STAGE 25
        // PUSH IMAGE TO ECR
        // ============================================================

        stage('25 - Push Docker Image to ECR') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo ""
                        echo "================================================"
                        echo "PUSHING DOCKER IMAGE TO AWS ECR"
                        echo "================================================"

                        echo ""
                        echo "Image:"
                        echo "${ECR_IMAGE}"

                        echo ""
                        echo "Starting Docker push..."

                        docker push "${ECR_IMAGE}"

                        echo ""
                        echo "================================================"
                        echo "DOCKER IMAGE PUSH COMPLETED"
                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // PART 4
        // STAGE 26
        // VERIFY IMAGE IN ECR
        // ============================================================

        stage('26 - Verify Image in ECR') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo ""
                        echo "================================================"
                        echo "VERIFYING IMAGE IN AWS ECR"
                        echo "================================================"

                        echo ""
                        echo "Repository:"
                        echo "${ECR_REPOSITORY}"

                        echo ""
                        echo "Image Tag:"
                        echo "${ECR_IMAGE_TAG}"

                        echo ""
                        echo "Checking ECR image..."

                        aws ecr describe-images \
                            --repository-name "${ECR_REPOSITORY}" \
                            --image-ids imageTag="${ECR_IMAGE_TAG}" \
                            --region "${AWS_DEFAULT_REGION}"

                        echo ""
                        echo "================================================"
                        echo "ECR IMAGE VERIFICATION PASSED"
                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // PART 4 COMPLETE
        // STAGE 27
        // ============================================================

        stage('27 - Part 4 Success') {

            steps {

                echo ''
                echo '================================================'
                echo '        PART 4 AWS ECR SUCCESS'
                echo '================================================'
                echo ''
                echo 'PART 1'
                echo 'Flake8                 : PASSED'
                echo 'Pylint                 : PASSED'
                echo ''
                echo 'PART 2'
                echo 'Pytest                 : PASSED'
                echo 'Automated Tests        : PASSED'
                echo ''
                echo 'PART 3'
                echo 'Docker Verification    : PASSED'
                echo 'Dockerfile             : PASSED'
                echo 'Docker Build           : PASSED'
                echo 'Docker Image           : CREATED'
                echo ''
                echo 'PART 4'
                echo 'AWS CLI                : PASSED'
                echo 'AWS Credentials        : PASSED'
                echo 'ECR Repository         : READY'
                echo 'ECR Authentication     : PASSED'
                echo 'Docker Tag             : PASSED'
                echo 'Docker Push            : PASSED'
                echo 'ECR Image Verification : PASSED'
                echo ''
                echo "ECR Image:"
                echo "${ECR_IMAGE}"
                echo ''
                echo '================================================'
                echo '       STARTING PART 5 - TERRAFORM'
                echo '================================================'
            }
        }


        // ============================================================
        // PART 5
        // STAGE 28
        // CHECKOUT TERRAFORM REPOSITORY
        // ============================================================

        stage('28 - Checkout Terraform Repository') {

            steps {

                echo ''
                echo '================================================'
                echo 'CHECKOUT TERRAFORM INFRASTRUCTURE'
                echo '================================================'
                echo "Repository : ${TERRAFORM_REPO}"
                echo "Branch     : ${TERRAFORM_BRANCH}"
                echo "Environment: ${ENVIRONMENT}"
                echo '================================================'

                dir("${TERRAFORM_DIR}") {

                    git(
                        branch: "${TERRAFORM_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${TERRAFORM_REPO}"
                    )
                }

                echo ''
                echo 'Terraform repository checkout PASSED.'
            }
        }


        // ============================================================
        // PART 5
        // STAGE 29
        // VERIFY TERRAFORM
        // ============================================================

        stage('29 - Verify Terraform') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    sh '''
                        set -e

                        echo ""
                        echo "================================================"
                        echo "VERIFYING TERRAFORM"
                        echo "================================================"

                        echo ""
                        echo "Terraform executable:"
                        command -v terraform

                        echo ""
                        echo "Terraform version:"
                        terraform version

                        echo ""
                        echo "Terraform verification PASSED."

                        echo ""
                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // PART 5
        // STAGE 30
        // VERIFY AWS CREDENTIALS FOR TERRAFORM
        // ============================================================

        stage('30 - Verify Terraform AWS Credentials') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo ""
                        echo "================================================"
                        echo "VERIFYING TERRAFORM AWS ACCESS"
                        echo "================================================"

                        echo ""
                        echo "AWS Region:"
                        echo "${AWS_DEFAULT_REGION}"

                        echo ""
                        echo "AWS Identity:"

                        aws sts get-caller-identity \
                            --region "${AWS_DEFAULT_REGION}"

                        echo ""
                        echo "Terraform AWS credentials are valid."

                        echo ""
                        echo "================================================"
                        echo "TERRAFORM AWS ACCESS PASSED"
                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // PART 5
        // STAGE 31
        // VERIFY TERRAFORM ENVIRONMENT
        // ============================================================

        stage('31 - Verify Terraform Environment') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    sh '''
                        set -e

                        echo ""
                        echo "================================================"
                        echo "VERIFYING TERRAFORM ENVIRONMENT"
                        echo "================================================"

                        echo ""
                        echo "Selected Environment:"
                        echo "${ENVIRONMENT}"

                        echo ""
                        echo "Expected Terraform variable file:"
                        echo "environments/${ENVIRONMENT}/terraform.tfvars"

                        if [ ! -d "environments/${ENVIRONMENT}" ]; then

                            echo ""
                            echo "ERROR: Terraform environment directory does not exist:"
                            echo "environments/${ENVIRONMENT}"
                            echo ""

                            echo "Available environments:"

                            if [ -d "environments" ]; then
                                find environments \
                                    -maxdepth 1 \
                                    -mindepth 1 \
                                    -type d \
                                    -print
                            fi

                            exit 1
                        fi

                        if [ ! -f "environments/${ENVIRONMENT}/terraform.tfvars" ]; then

                            echo ""
                            echo "ERROR: Terraform variable file not found:"
                            echo "environments/${ENVIRONMENT}/terraform.tfvars"
                            echo ""

                            exit 1
                        fi

                        echo ""
                        echo "Terraform environment directory found."

                        echo ""
                        echo "Terraform variable file found."

                        echo ""
                        echo "Terraform files:"

                        find . \
                            -maxdepth 3 \
                            -type f \
                            \\( \
                                -name "*.tf" \
                                -o \
                                -name "*.tfvars" \
                            \\) \
                            -print

                        echo ""
                        echo "Terraform environment verification PASSED."

                        echo ""
                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // PART 5
        // STAGE 32
        // TERRAFORM INIT
        // ============================================================

        stage('32 - Terraform Init') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                         credentialsId: "${AWS_CREDENTIALS}"]
                    ]) {

                        sh '''
                            set -e

                            echo ""
                            echo "================================================"
                            echo "INITIALIZING TERRAFORM"
                            echo "================================================"

                            echo ""
                            echo "Environment : ${ENVIRONMENT}"
                            echo "AWS Region  : ${AWS_DEFAULT_REGION}"

                            echo ""
                            echo "Running Terraform init..."

                            terraform init \
                                -input=false \
                                -upgrade

                            echo ""
                            echo "================================================"
                            echo "TERRAFORM INIT PASSED"
                            echo "================================================"
                        '''
                    }
                }
            }
        }


        // ============================================================
        // PART 5
        // STAGE 33
        // TERRAFORM VALIDATE
        // ============================================================

        stage('33 - Terraform Validate') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    sh '''
                        set -e

                        echo ""
                        echo "================================================"
                        echo "VALIDATING TERRAFORM CONFIGURATION"
                        echo "================================================"

                        terraform validate

                        echo ""
                        echo "================================================"
                        echo "TERRAFORM VALIDATION PASSED"
                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // PART 5
        // STAGE 34
        // TERRAFORM PLAN
        // ============================================================

        stage('34 - Terraform Plan') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                         credentialsId: "${AWS_CREDENTIALS}"]
                    ]) {

                        sh '''
                            set -e

                            echo ""
                            echo "================================================"
                            echo "CREATING TERRAFORM PLAN"
                            echo "================================================"

                            echo ""
                            echo "Environment : ${ENVIRONMENT}"
                            echo "Region      : ${AWS_DEFAULT_REGION}"

                            echo ""
                            echo "Variable file:"
                            echo "environments/${ENVIRONMENT}/terraform.tfvars"

                            echo ""
                            echo "Running terraform plan..."

                            terraform plan \
                                -input=false \
                                -var-file="environments/${ENVIRONMENT}/terraform.tfvars" \
                                -out="terraform-${ENVIRONMENT}.tfplan"

                            echo ""
                            echo "================================================"
                            echo "TERRAFORM PLAN PASSED"
                            echo "================================================"

                            echo ""
                            echo "Terraform plan file created:"
                            ls -lh "terraform-${ENVIRONMENT}.tfplan"
                        '''
                    }
                }
            }
        }


        // ============================================================
        // PART 5
        // STAGE 35
        // TERRAFORM APPLY
        // ============================================================

        stage('35 - Terraform Apply') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                         credentialsId: "${AWS_CREDENTIALS}"]
                    ]) {

                        sh '''
                            set -e

                            echo ""
                            echo "================================================"
                            echo "APPLYING TERRAFORM INFRASTRUCTURE"
                            echo "================================================"

                            echo ""
                            echo "Environment : ${ENVIRONMENT}"
                            echo "AWS Region  : ${AWS_DEFAULT_REGION}"

                            echo ""
                            echo "Applying saved Terraform plan..."

                            terraform apply \
                                -input=false \
                                -auto-approve \
                                "terraform-${ENVIRONMENT}.tfplan"

                            echo ""
                            echo "================================================"
                            echo "TERRAFORM APPLY PASSED"
                            echo "================================================"
                        '''
                    }
                }
            }
        }


        // ============================================================
        // PART 5
        // STAGE 36
        // VERIFY TERRAFORM STATE
        // ============================================================

        stage('36 - Verify Terraform Deployment') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                         credentialsId: "${AWS_CREDENTIALS}"]
                    ]) {

                        sh '''
                            set -e

                            echo ""
                            echo "================================================"
                            echo "VERIFYING TERRAFORM DEPLOYMENT"
                            echo "================================================"

                            echo ""
                            echo "Terraform state list:"
                            terraform state list

                            echo ""
                            echo "Terraform outputs:"
                            terraform output || true

                            echo ""
                            echo "Checking Terraform state..."

                            terraform state pull > /tmp/terraform-state.json

                            if [ ! -s /tmp/terraform-state.json ]; then

                                echo ""
                                echo "ERROR: Terraform state is empty."
                                exit 1

                            fi

                            echo ""
                            echo "Terraform state is available."

                            echo ""
                            echo "================================================"
                            echo "TERRAFORM DEPLOYMENT VERIFICATION PASSED"
                            echo "================================================"
                        '''
                    }
                }
            }
        }


        // ============================================================
        // PART 5 COMPLETE
        // STAGE 37
        // ============================================================

        stage('37 - Part 5 Success') {

            steps {

                echo ''
                echo '================================================'
                echo '       PART 5 TERRAFORM SUCCESS'
                echo '================================================'
                echo ''

                echo 'PART 1'
                echo 'Flake8                 : PASSED'
                echo 'Pylint                 : PASSED'
                echo ''

                echo 'PART 2'
                echo 'Pytest                 : PASSED'
                echo 'Automated Tests        : PASSED'
                echo ''

                echo 'PART 3'
                echo 'Docker Verification    : PASSED'
                echo 'Dockerfile             : PASSED'
                echo 'Docker Build           : PASSED'
                echo 'Docker Image           : CREATED'
                echo ''

                echo 'PART 4'
                echo 'AWS CLI                : PASSED'
                echo 'AWS Credentials        : PASSED'
                echo 'ECR Repository         : READY'
                echo 'ECR Authentication     : PASSED'
                echo 'Docker Tag             : PASSED'
                echo 'Docker Push            : PASSED'
                echo 'ECR Image Verification : PASSED'
                echo ''

                echo 'PART 5'
                echo 'Terraform Verification : PASSED'
                echo 'Terraform Init         : PASSED'
                echo 'Terraform Validate     : PASSED'
                echo 'Terraform Plan         : PASSED'
                echo 'Terraform Apply        : PASSED'
                echo 'Terraform State        : PASSED'
                echo 'Infrastructure         : DEPLOYED'
                echo ''

                echo "Environment            : ${ENVIRONMENT}"
                echo "AWS Region             : ${AWS_DEFAULT_REGION}"
                echo ''

                echo '================================================'
                echo '       READY FOR PART 6 - DEPLOYMENT'
                echo '================================================'
            }
        }
    }


    // ================================================================
    // POST ACTIONS
    // ================================================================

    post {

        success {

            echo ''
            echo '================================================'
            echo 'PART 1 + PART 2 + PART 3 + PART 4 + PART 5 SUCCESS'
            echo '================================================'
            echo ''

            echo 'Part 1 : PASSED'
            echo 'Part 2 : PASSED'
            echo 'Part 3 : PASSED'
            echo 'Part 4 : PASSED'
            echo 'Part 5 : PASSED'
            echo ''

            echo 'Code Quality       : PASSED'
            echo 'Automated Tests    : PASSED'
            echo 'Docker Build       : PASSED'
            echo 'Docker Image       : CREATED'
            echo 'AWS ECR Push       : PASSED'
            echo 'Terraform          : PASSED'
            echo 'Infrastructure     : DEPLOYED'
            echo ''

            echo "Environment        : ${ENVIRONMENT}"
            echo "AWS Region         : ${AWS_DEFAULT_REGION}"
            echo ''

            echo 'Ready for Part 6 - Deployment.'
            echo '================================================'
        }


        failure {

            echo ''
            echo '================================================'
            echo 'PART 1 + PART 2 + PART 3 + PART 4 + PART 5 FAILED'
            echo '================================================'
            echo ''

            echo 'The pipeline stopped at the failed stage.'
            echo ''

            echo 'Possible failed areas:'
            echo '  - Code Quality'
            echo '  - Automated Tests'
            echo '  - Docker Build'
            echo '  - AWS ECR'
            echo '  - Terraform'
            echo '  - AWS Infrastructure'
            echo ''

            echo 'Check the Jenkins console output for the exact failure.'
            echo ''

            echo '================================================'
        }


        always {

            echo ''
            echo '================================================'
            echo 'CLEANING JENKINS WORKSPACE'
            echo '================================================'

            cleanWs(
                deleteDirs: true,
                disableDeferredWipeout: true
            )
        }
    }
}
