pipeline {

    agent any

    // ================================================================
    // PIPELINE OPTIONS
    // ================================================================

    options {

        timestamps()

        ansiColor('xterm')

        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                daysToKeepStr: '30',
                numToKeepStr: '50'
            )
        )

        timeout(
            time: 90,
            unit: 'MINUTES'
        )
    }


    // ================================================================
    // PARAMETERS
    // ================================================================

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: [
                'dev',
                'qa',
                'stage',
                'prod'
            ],
            description: 'Terraform environment to deploy'
        )
    }


    // ================================================================
    // ENVIRONMENT
    // ================================================================

    environment {

        // ------------------------------------------------------------
        // REPOSITORIES
        // ------------------------------------------------------------

        APP_REPO = 'https://github.com/FAIZANSHEIKH223/practice1.git'
        APP_BRANCH = 'main'

        QUALITY_REPO = 'https://github.com/FAIZANSHEIKH223/pylint_flake8_int_jenkins.git'
        QUALITY_BRANCH = 'main'

        TERRAFORM_REPO = 'https://github.com/FAIZANSHEIKH223/terraform-aws-infra.git'
        TERRAFORM_BRANCH = 'main'


        // ------------------------------------------------------------
        // JENKINS CREDENTIALS
        // ------------------------------------------------------------

        GITHUB_CREDENTIALS = 'github-creds'

        AWS_CREDENTIALS = 'aws-creds'


        // ------------------------------------------------------------
        // DIRECTORIES
        // ------------------------------------------------------------

        APP_DIR = 'practice1'

        QUALITY_DIR = 'quality-tools'

        TERRAFORM_DIR = 'terraform-infra'

        VENV_DIR = 'venv'

        REPORT_DIR = 'reports'


        // ------------------------------------------------------------
        // PYTHON
        // ------------------------------------------------------------

        PYTHON = 'python3.12'


        // ------------------------------------------------------------
        // AWS
        // ------------------------------------------------------------

        AWS_DEFAULT_REGION = 'us-east-1'


        // ------------------------------------------------------------
        // APPLICATION
        // ------------------------------------------------------------

        APP_NAME = 'practice1'

        CONTAINER_NAME = 'practice1'

        CONTAINER_PORT = '8501'


        // ------------------------------------------------------------
        // DOCKER
        // ------------------------------------------------------------

        DOCKER_IMAGE_NAME = 'practice1'

        DOCKER_IMAGE_TAG = "${BUILD_NUMBER}"

        DOCKER_IMAGE = "${DOCKER_IMAGE_NAME}:${DOCKER_IMAGE_TAG}"


        // ------------------------------------------------------------
        // ECR
        // ------------------------------------------------------------

        ECR_REPOSITORY = 'practice1'

        ECR_IMAGE_TAG = "${BUILD_NUMBER}"


        // ------------------------------------------------------------
        // ECS
        // ------------------------------------------------------------

        ECS_CLUSTER = "practice1-${ENVIRONMENT}-cluster"

        ECS_SERVICE = "practice1-${ENVIRONMENT}-service"

        ECS_TASK_FAMILY = "practice1-${ENVIRONMENT}-task"

        ECS_CONTAINER_NAME = 'practice1'


        // ------------------------------------------------------------
        // FARGATE
        // ------------------------------------------------------------

        FARGATE_CPU = '256'

        FARGATE_MEMORY = '512'


        // ------------------------------------------------------------
        // LOAD BALANCER
        // ------------------------------------------------------------

        ALB_NAME = "practice1-${ENVIRONMENT}-alb"

        TARGET_GROUP_NAME = "practice1-${ENVIRONMENT}-tg"

        ALB_SG_NAME = "practice1-${ENVIRONMENT}-alb-sg"

        ECS_SG_NAME = "practice1-${ENVIRONMENT}-ecs-sg"


        // ------------------------------------------------------------
        // TERRAFORM
        // ------------------------------------------------------------

        TF_STATE_BUCKET = 'terraform-state-faizan-001'

        TF_LOCK_TABLE = 'terraform-locks'

        TF_IN_AUTOMATION = 'true'

        TF_INPUT = 'false'


        // ------------------------------------------------------------
        // ECS HEALTH
        // ------------------------------------------------------------

        HEALTH_PATH = '/'


        // ------------------------------------------------------------
        // DNS
        // ------------------------------------------------------------

        DNS_NAME = ''
    }


    // ================================================================
    // STAGES
    // ================================================================

    stages {


        // ============================================================
        // PART 1 - CODE QUALITY
        // ============================================================

        stage('1 - Checkout Application') {

            steps {

                echo '================================================'
                echo 'CHECKOUT APPLICATION'
                echo '================================================'

                dir("${APP_DIR}") {

                    deleteDir()

                    git(
                        branch: "${APP_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${APP_REPO}"
                    )
                }
            }
        }


        stage('2 - Checkout Quality Repository') {

            steps {

                echo '================================================'
                echo 'CHECKOUT QUALITY REPOSITORY'
                echo '================================================'

                dir("${QUALITY_DIR}") {

                    deleteDir()

                    git(
                        branch: "${QUALITY_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${QUALITY_REPO}"
                    )
                }
            }
        }


        stage('3 - Verify Python') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "VERIFYING PYTHON"
                        echo "================================================"

                        command -v "${PYTHON}"

                        "${PYTHON}" --version

                        "${PYTHON}" -m pip --version
                    '''
                }
            }
        }


        stage('4 - Create Python Virtual Environment') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "CREATING PYTHON VIRTUAL ENVIRONMENT"
                        echo "================================================"

                        rm -rf "${VENV_DIR}"

                        "${PYTHON}" -m venv "${VENV_DIR}"

                        "${VENV_DIR}/bin/python" --version
                    '''
                }
            }
        }


        stage('5 - Install Application Dependencies') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "INSTALLING APPLICATION DEPENDENCIES"
                        echo "================================================"

                        "${VENV_DIR}/bin/python" \
                            -m pip install --upgrade pip

                        if [ -f requirements.txt ]; then

                            "${VENV_DIR}/bin/pip" \
                                install \
                                -r requirements.txt

                        else

                            echo "WARNING: requirements.txt not found."

                        fi
                    '''
                }
            }
        }


        stage('6 - Install Quality Tools') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "INSTALLING QUALITY TOOLS"
                        echo "================================================"

                        "${VENV_DIR}/bin/pip" \
                            install \
                            flake8 \
                            pylint

                        "${VENV_DIR}/bin/flake8" --version

                        "${VENV_DIR}/bin/pylint" --version
                    '''
                }
            }
        }


        stage('7 - Flake8 Code Quality') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "RUNNING FLAKE8"
                        echo "================================================"

                        mkdir -p "${REPORT_DIR}"

                        "${VENV_DIR}/bin/flake8" \
                            . \
                            --exclude="${VENV_DIR},.git,${REPORT_DIR},__pycache__" \
                            --count \
                            --statistics \
                            --tee \
                            --output-file="${REPORT_DIR}/flake8-report.txt"
                    '''
                }
            }
        }


        stage('8 - Pylint Code Quality') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "RUNNING PYLINT"
                        echo "================================================"

                        mkdir -p "${REPORT_DIR}"

                        PYTHON_FILES=$(find . \
                            -type f \
                            -name "*.py" \
                            ! -path "./${VENV_DIR}/*" \
                            ! -path "./.git/*" \
                            ! -path "./${REPORT_DIR}/*" \
                            ! -path "*/__pycache__/*")

                        if [ -z "${PYTHON_FILES}" ]; then

                            echo "ERROR: No Python files found."

                            exit 1

                        fi

                        "${VENV_DIR}/bin/pylint" \
                            ${PYTHON_FILES} \
                            --output-format=text \
                            > "${REPORT_DIR}/pylint-report.txt"
                    '''
                }
            }
        }


        stage('9 - Part 1 Success') {

            steps {

                echo '================================================'
                echo 'PART 1 - CODE QUALITY SUCCESS'
                echo '================================================'

                echo 'Flake8 : PASSED'
                echo 'Pylint : PASSED'
            }
        }


        // ============================================================
        // PART 2 - TESTING
        // ============================================================

        stage('10 - Install Pytest') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "INSTALLING PYTEST"
                        echo "================================================"

                        "${VENV_DIR}/bin/pip" install pytest

                        "${VENV_DIR}/bin/pytest" --version
                    '''
                }
            }
        }


        stage('11 - Verify Tests') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "VERIFYING TESTS"
                        echo "================================================"

                        if [ ! -d "tests" ]; then

                            echo "ERROR: tests/ directory does not exist."

                            exit 1

                        fi

                        TEST_FILES=$(find tests \
                            -type f \
                            \\( \
                                -name "test_*.py" \
                                -o \
                                -name "*_test.py" \
                            \\))

                        if [ -z "${TEST_FILES}" ]; then

                            echo "ERROR: No pytest test files found."

                            exit 1

                        fi

                        echo "Test files:"
                        echo "${TEST_FILES}"
                    '''
                }
            }
        }


        stage('12 - Run Automated Tests') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "RUNNING AUTOMATED TESTS"
                        echo "================================================"

                        mkdir -p "${REPORT_DIR}"

                        "${VENV_DIR}/bin/pytest" \
                            tests/ \
                            -v \
                            --junitxml="${REPORT_DIR}/pytest-results.xml"
                    '''
                }
            }
        }


        stage('13 - Publish Test Results') {

            steps {

                junit(
                    testResults:
                        "${APP_DIR}/${REPORT_DIR}/pytest-results.xml",
                    allowEmptyResults: false
                )

                archiveArtifacts(
                    artifacts:
                        "${APP_DIR}/${REPORT_DIR}/pytest-results.xml," +
                        "${APP_DIR}/${REPORT_DIR}/flake8-report.txt," +
                        "${APP_DIR}/${REPORT_DIR}/pylint-report.txt",
                    allowEmptyArchive: false,
                    fingerprint: true
                )
            }
        }


        stage('14 - Part 2 Success') {

            steps {

                echo '================================================'
                echo 'PART 2 - TESTING SUCCESS'
                echo '================================================'

                echo 'Pytest : PASSED'
            }
        }


        // ============================================================
        // PART 3 - DOCKER
        // ============================================================

        stage('15 - Verify Docker') {

            steps {

                sh '''
                    set -e

                    echo "================================================"
                    echo "VERIFYING DOCKER"
                    echo "================================================"

                    command -v docker

                    docker --version

                    docker info > /dev/null

                    echo "Docker daemon is accessible."
                '''
            }
        }


        stage('16 - Prepare Docker Build Context') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "PREPARING DOCKER BUILD CONTEXT"
                        echo "================================================"

                        if [ ! -f Dockerfile ]; then

                            echo "ERROR: Dockerfile not found."

                            exit 1

                        fi

                        cat > .dockerignore <<'EOF'
venv/
.venv/
.git/
.gitignore
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
reports/
*.log
.DS_Store
EOF

                        echo ""
                        echo "Docker ignore file:"
                        cat .dockerignore

                        echo ""
                        echo "Dockerfile:"
                        cat Dockerfile
                    '''
                }
            }
        }


        stage('17 - Build Docker Image') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "BUILDING DOCKER IMAGE"
                        echo "================================================"

                        echo "Image: ${DOCKER_IMAGE}"

                        docker build \
                            --pull \
                            --tag "${DOCKER_IMAGE}" \
                            .

                        docker image inspect \
                            "${DOCKER_IMAGE}" \
                            > /dev/null

                        echo "Docker image created successfully."
                    '''
                }
            }
        }


        stage('18 - Docker Image Verification') {

            steps {

                sh '''
                    set -e

                    echo "================================================"
                    echo "VERIFYING DOCKER IMAGE"
                    echo "================================================"

                    docker image inspect \
                        "${DOCKER_IMAGE}" \
                        --format='Image={{.RepoTags}} Size={{.Size}}'

                    echo ""
                    docker images "${DOCKER_IMAGE_NAME}"
                '''
            }
        }


        stage('19 - Part 3 Success') {

            steps {

                echo '================================================'
                echo 'PART 3 - DOCKER SUCCESS'
                echo '================================================'

                echo "Docker Image: ${DOCKER_IMAGE}"
            }
        }


        // ============================================================
        // PART 4 - AWS ECR
        // ============================================================

        stage('20 - Verify AWS CLI') {

            steps {

                sh '''
                    set -e

                    echo "================================================"
                    echo "VERIFYING AWS CLI"
                    echo "================================================"

                    command -v aws

                    aws --version
                '''
            }
        }


        stage('21 - Verify AWS Credentials') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        aws sts get-caller-identity \
                            --region "${AWS_DEFAULT_REGION}"
                    '''
                }
            }
        }


        stage('22 - Create ECR Repository') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        if aws ecr describe-repositories \
                            --repository-names "${ECR_REPOSITORY}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            > /dev/null 2>&1
                        then

                            echo "ECR repository already exists."

                        else

                            echo "Creating ECR repository..."

                            aws ecr create-repository \
                                --repository-name "${ECR_REPOSITORY}" \
                                --region "${AWS_DEFAULT_REGION}"

                        fi
                    '''
                }
            }
        }


        stage('23 - Get ECR Image URI') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        def accountId = sh(
                            script: '''
                                aws sts get-caller-identity \
                                    --query Account \
                                    --output text \
                                    --region "${AWS_DEFAULT_REGION}"
                            ''',
                            returnStdout: true
                        ).trim()

                        env.AWS_ACCOUNT_ID = accountId

                        env.ECR_REGISTRY =
                            "${accountId}.dkr.ecr.${AWS_DEFAULT_REGION}.amazonaws.com"

                        env.ECR_IMAGE =
                            "${env.ECR_REGISTRY}/${env.ECR_REPOSITORY}:${env.ECR_IMAGE_TAG}"

                        echo "AWS Account ID : ${env.AWS_ACCOUNT_ID}"
                        echo "ECR Registry   : ${env.ECR_REGISTRY}"
                        echo "ECR Image URI  : ${env.ECR_IMAGE}"
                    }
                }
            }
        }


        stage('24 - Login Docker to ECR') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        aws ecr get-login-password \
                            --region "${AWS_DEFAULT_REGION}" \
                        | docker login \
                            --username AWS \
                            --password-stdin \
                            "${ECR_REGISTRY}"
                    '''
                }
            }
        }


        stage('25 - Tag Image with ECR URI') {

            steps {

                sh '''
                    set -e

                    docker tag \
                        "${DOCKER_IMAGE}" \
                        "${ECR_IMAGE}"

                    docker image inspect \
                        "${ECR_IMAGE}" \
                        > /dev/null

                    echo "ECR image:"
                    echo "${ECR_IMAGE}"
                '''
            }
        }


        stage('26 - Push Image to ECR') {

            steps {

                sh '''
                    set -e

                    docker push "${ECR_IMAGE}"
                '''
            }
        }


        stage('27 - Verify ECR Image') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        aws ecr describe-images \
                            --repository-name "${ECR_REPOSITORY}" \
                            --image-ids imageTag="${ECR_IMAGE_TAG}" \
                            --region "${AWS_DEFAULT_REGION}"

                        echo ""
                        echo "ECR IMAGE VERIFIED:"
                        echo "${ECR_IMAGE}"
                    '''
                }
            }
        }


        stage('28 - Part 4 Success') {

            steps {

                echo '================================================'
                echo 'PART 4 - ECR SUCCESS'
                echo '================================================'

                echo "ECR Image URI: ${env.ECR_IMAGE}"
            }
        }


        // ============================================================
        // PART 5 - TERRAFORM
        // ============================================================

        stage('29 - Checkout Terraform Repository') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    deleteDir()

                    git(
                        branch: "${TERRAFORM_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${TERRAFORM_REPO}"
                    )
                }
            }
        }


        stage('30 - Verify Terraform') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    sh '''
                        set -e

                        command -v terraform

                        terraform version

                        echo ""
                        echo "Terraform files:"
                        find . \
                            -maxdepth 3 \
                            -type f \
                            -name "*.tf" \
                            -print
                    '''
                }
            }
        }


        stage('31 - Terraform Environment Verification') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    sh '''
                        set -e

                        echo "Environment: ${ENVIRONMENT}"

                        if [ ! -d "environments/${ENVIRONMENT}" ]; then

                            echo "ERROR: Terraform environment does not exist:"
                            echo "environments/${ENVIRONMENT}"

                            exit 1

                        fi

                        if [ ! -f "environments/${ENVIRONMENT}/terraform.tfvars" ]; then

                            echo "ERROR: terraform.tfvars not found."

                            exit 1

                        fi

                        echo "Terraform environment verified."
                    '''
                }
            }
        }


        stage('32 - Terraform Init') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh '''
                            set -e

                            terraform init \
                                -input=false
                        '''
                    }
                }
            }
        }


        stage('33 - Terraform Validate') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    sh '''
                        set -e

                        terraform validate
                    '''
                }
            }
        }


        stage('34 - Terraform Plan') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh '''
                            set -e

                            terraform plan \
                                -input=false \
                                -var-file="environments/${ENVIRONMENT}/terraform.tfvars" \
                                -out="tfplan"
                        '''
                    }
                }
            }
        }


        stage('35 - Terraform Apply') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh '''
                            set -e

                            if [ ! -f tfplan ]; then

                                echo "ERROR: tfplan not found."

                                exit 1

                            fi

                            terraform apply \
                                -input=false \
                                -auto-approve \
                                tfplan
                        '''
                    }
                }
            }
        }


        stage('36 - Terraform Deployment Verification') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh '''
                            set -e

                            echo "Terraform state:"
                            terraform state list || true

                            echo ""
                            echo "Terraform outputs:"
                            terraform output || true

                            echo ""
                            echo "AWS identity:"
                            aws sts get-caller-identity \
                                --region "${AWS_DEFAULT_REGION}"

                            echo ""
                            echo "Terraform deployment verification completed."
                        '''
                    }
                }
            }
        }


        // ============================================================
        // PART 6 - ECS FARGATE + ALB
        // ============================================================

        stage('37 - Discover AWS Network') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        echo '================================================'
                        echo 'DISCOVERING AWS NETWORK'
                        echo '================================================'


                        def vpcId = sh(
                            script: '''
                                set -e

                                VPC_ID=$(aws ec2 describe-vpcs \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --filters \
                                        "Name=tag:Environment,Values=${ENVIRONMENT}" \
                                    --query 'Vpcs[0].VpcId' \
                                    --output text)

                                if [ "${VPC_ID}" = "None" ] || [ -z "${VPC_ID}" ]; then

                                    VPC_ID=$(aws ec2 describe-vpcs \
                                        --region "${AWS_DEFAULT_REGION}" \
                                        --filters \
                                            "Name=is-default,Values=true" \
                                        --query 'Vpcs[0].VpcId' \
                                        --output text)

                                fi

                                if [ "${VPC_ID}" = "None" ] || [ -z "${VPC_ID}" ]; then

                                    echo "ERROR: No VPC found."

                                    exit 1

                                fi

                                echo "${VPC_ID}"
                            ''',
                            returnStdout: true
                        ).trim()


                        env.VPC_ID = vpcId


                        def subnetOutput = sh(
                            script: '''
                                set -e

                                SUBNETS=$(aws ec2 describe-subnets \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --filters \
                                        "Name=vpc-id,Values=${VPC_ID}" \
                                        "Name=map-public-ip-on-launch,Values=true" \
                                    --query 'Subnets[].SubnetId' \
                                    --output text)

                                if [ -z "${SUBNETS}" ] || [ "${SUBNETS}" = "None" ]; then

                                    echo "ERROR: No public subnets found."

                                    exit 1

                                fi

                                echo "${SUBNETS}"
                            ''',
                            returnStdout: true
                        ).trim()


                        def subnetList = subnetOutput.split("\\s+")


                        if (subnetList.size() < 2) {

                            error(
                                "At least 2 public subnets in different AZs are required for the ALB. " +
                                "Found: ${subnetOutput}"
                            )
                        }


                        env.SUBNET_1 = subnetList[0]

                        env.SUBNET_2 = subnetList[1]


                        echo "VPC ID  : ${env.VPC_ID}"

                        echo "Subnet 1: ${env.SUBNET_1}"

                        echo "Subnet 2: ${env.SUBNET_2}"
                    }
                }
            }
        }


        stage('38 - Create IAM Roles for ECS') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "CREATING ECS IAM ROLES"
                        echo "================================================"

                        EXECUTION_ROLE_NAME="practice1-ecsTaskExecutionRole"

                        if aws iam get-role \
                            --role-name "${EXECUTION_ROLE_NAME}" \
                            > /dev/null 2>&1
                        then

                            echo "ECS execution role already exists."

                        else

                            cat > /tmp/ecs-trust-policy.json <<'EOF'
{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
            },
            "Action": "sts:AssumeRole"
        }
    ]
}
EOF

                            aws iam create-role \
                                --role-name "${EXECUTION_ROLE_NAME}" \
                                --assume-role-policy-document \
                                file:///tmp/ecs-trust-policy.json

                        fi


                        aws iam attach-role-policy \
                            --role-name "${EXECUTION_ROLE_NAME}" \
                            --policy-arn \
                            arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy \
                            || true


                        EXECUTION_ROLE_ARN=$(aws iam get-role \
                            --role-name "${EXECUTION_ROLE_NAME}" \
                            --query 'Role.Arn' \
                            --output text)


                        echo "ECS Execution Role:"
                        echo "${EXECUTION_ROLE_ARN}"
                    '''
                }
            }
        }


        stage('39 - Create Security Groups') {

            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {
                    script {
                        sh '''
                            set -e
                            echo "================================================"
                            echo "CREATING / REPAIRING SECURITY GROUPS"
                            echo "================================================"

                            ALB_SG_ID=$(aws ec2 describe-security-groups \
                                --region "${AWS_DEFAULT_REGION}" \
                                --filters "Name=vpc-id,Values=${VPC_ID}" "Name=group-name,Values=${ALB_SG_NAME}" \
                                --query 'SecurityGroups[0].GroupId' --output text)

                            if [ "${ALB_SG_ID}" = "None" ] || [ -z "${ALB_SG_ID}" ]; then
                                ALB_SG_ID=$(aws ec2 create-security-group \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --group-name "${ALB_SG_NAME}" \
                                    --description "ALB security group for ${APP_NAME}" \
                                    --vpc-id "${VPC_ID}" --query 'GroupId' --output text)
                            fi

                            ECS_SG_ID=$(aws ec2 describe-security-groups \
                                --region "${AWS_DEFAULT_REGION}" \
                                --filters "Name=vpc-id,Values=${VPC_ID}" "Name=group-name,Values=${ECS_SG_NAME}" \
                                --query 'SecurityGroups[0].GroupId' --output text)

                            if [ "${ECS_SG_ID}" = "None" ] || [ -z "${ECS_SG_ID}" ]; then
                                ECS_SG_ID=$(aws ec2 create-security-group \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --group-name "${ECS_SG_NAME}" \
                                    --description "ECS Fargate security group for ${APP_NAME}" \
                                    --vpc-id "${VPC_ID}" --query 'GroupId' --output text)
                            fi

                            echo "ALB SG: ${ALB_SG_ID}"
                            echo "ECS SG: ${ECS_SG_ID}"

                            # ALB: public HTTP ingress.
                            aws ec2 authorize-security-group-ingress \
                                --region "${AWS_DEFAULT_REGION}" --group-id "${ALB_SG_ID}" \
                                --protocol tcp --port 80 --cidr 0.0.0.0/0 2>/dev/null || true

                            # ALB: explicit outbound access to the Fargate ENIs.
                            aws ec2 authorize-security-group-egress \
                                --region "${AWS_DEFAULT_REGION}" --group-id "${ALB_SG_ID}" \
                                --protocol -1 --cidr 0.0.0.0/0 2>/dev/null || true

                            # Fargate: only the ALB security group may reach 8501.
                            aws ec2 authorize-security-group-ingress \
                                --region "${AWS_DEFAULT_REGION}" --group-id "${ECS_SG_ID}" \
                                --protocol tcp --port "${CONTAINER_PORT}" \
                                --source-group "${ALB_SG_ID}" 2>/dev/null || true

                            # Fargate: outbound access for application startup/ECR/logging.
                            aws ec2 authorize-security-group-egress \
                                --region "${AWS_DEFAULT_REGION}" --group-id "${ECS_SG_ID}" \
                                --protocol -1 --cidr 0.0.0.0/0 2>/dev/null || true

                            echo ""
                            echo "ALB security-group rules:"
                            aws ec2 describe-security-groups --region "${AWS_DEFAULT_REGION}" \
                                --group-ids "${ALB_SG_ID}" \
                                --query 'SecurityGroups[0].{GroupId:GroupId,Ingress:IpPermissions,Egress:IpPermissionsEgress}' --output json

                            echo ""
                            echo "ECS security-group rules:"
                            aws ec2 describe-security-groups --region "${AWS_DEFAULT_REGION}" \
                                --group-ids "${ECS_SG_ID}" \
                                --query 'SecurityGroups[0].{GroupId:GroupId,Ingress:IpPermissions,Egress:IpPermissionsEgress}' --output json
                        '''

                        env.ALB_SG_ID = sh(
                            script: "aws ec2 describe-security-groups --region '${env.AWS_DEFAULT_REGION}' --filters Name=vpc-id,Values=${env.VPC_ID} Name=group-name,Values=${env.ALB_SG_NAME} --query 'SecurityGroups[0].GroupId' --output text",
                            returnStdout: true
                        ).trim()

                        env.ECS_SG_ID = sh(
                            script: "aws ec2 describe-security-groups --region '${env.AWS_DEFAULT_REGION}' --filters Name=vpc-id,Values=${env.VPC_ID} Name=group-name,Values=${env.ECS_SG_NAME} --query 'SecurityGroups[0].GroupId' --output text",
                            returnStdout: true
                        ).trim()

                        if (!env.ALB_SG_ID || env.ALB_SG_ID == 'None') {
                            error('ALB security group ID could not be determined.')
                        }
                        if (!env.ECS_SG_ID || env.ECS_SG_ID == 'None') {
                            error('ECS security group ID could not be determined.')
                        }

                        echo "ALB SG ID: ${env.ALB_SG_ID}"
                        echo "ECS SG ID: ${env.ECS_SG_ID}"
                    }
                }
            }
        }


        stage('40 - Create Application Load Balancer') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        def albArn = sh(
                            script: '''
                                aws elbv2 describe-load-balancers \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --names "${ALB_NAME}" \
                                    --query 'LoadBalancers[0].LoadBalancerArn' \
                                    --output text 2>/dev/null || true
                            ''',
                            returnStdout: true
                        ).trim()


                        if (!albArn || albArn == 'None') {

                            albArn = sh(
                                script: '''
                                    aws elbv2 create-load-balancer \
                                        --region "${AWS_DEFAULT_REGION}" \
                                        --name "${ALB_NAME}" \
                                        --subnets "${SUBNET_1}" "${SUBNET_2}" \
                                        --security-groups "${ALB_SG_ID}" \
                                        --scheme internet-facing \
                                        --type application \
                                        --ip-address-type ipv4 \
                                        --query 'LoadBalancers[0].LoadBalancerArn' \
                                        --output text
                                ''',
                                returnStdout: true
                            ).trim()
                        }


                        env.ALB_ARN = albArn


                        def albDns = sh(
                            script: '''
                                aws elbv2 describe-load-balancers \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --load-balancer-arns "${ALB_ARN}" \
                                    --query 'LoadBalancers[0].DNSName' \
                                    --output text
                            ''',
                            returnStdout: true
                        ).trim()


                        env.ALB_DNS = albDns


                        echo "ALB ARN : ${env.ALB_ARN}"

                        echo "ALB DNS : ${env.ALB_DNS}"
                    }
                }
            }
        }


        stage('41 - Create Target Group') {

            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {
                    script {
                        def targetGroupArn = sh(
                            script: '''
                                aws elbv2 describe-target-groups \
                                    --region "${AWS_DEFAULT_REGION}" --names "${TARGET_GROUP_NAME}" \
                                    --query 'TargetGroups[0].TargetGroupArn' --output text 2>/dev/null || true
                            ''',
                            returnStdout: true
                        ).trim()

                        if (!targetGroupArn || targetGroupArn == 'None') {
                            targetGroupArn = sh(
                                script: '''
                                    aws elbv2 create-target-group \
                                        --region "${AWS_DEFAULT_REGION}" --name "${TARGET_GROUP_NAME}" \
                                        --protocol HTTP --port "${CONTAINER_PORT}" --target-type ip \
                                        --vpc-id "${VPC_ID}" --health-check-protocol HTTP \
                                        --health-check-path "${HEALTH_PATH}" --health-check-port traffic-port \
                                        --health-check-interval-seconds 15 --health-check-timeout-seconds 10 \
                                        --healthy-threshold-count 2 --unhealthy-threshold-count 5 \
                                        --matcher HttpCode=200-399 --query 'TargetGroups[0].TargetGroupArn' --output text
                                ''',
                                returnStdout: true
                            ).trim()
                        }

                        env.TARGET_GROUP_ARN = targetGroupArn
                        if (!env.TARGET_GROUP_ARN || env.TARGET_GROUP_ARN == 'None') {
                            error('Target group ARN could not be determined.')
                        }

                        // Repair an existing target group too.
                        sh '''
                            set -e
                            aws elbv2 modify-target-group \
                                --region "${AWS_DEFAULT_REGION}" --target-group-arn "${TARGET_GROUP_ARN}" \
                                --health-check-protocol HTTP --health-check-port traffic-port \
                                --health-check-path "${HEALTH_PATH}" --health-check-interval-seconds 15 \
                                --health-check-timeout-seconds 10 --healthy-threshold-count 2 \
                                --unhealthy-threshold-count 5 --matcher HttpCode=200-399

                            aws elbv2 modify-target-group-attributes \
                                --region "${AWS_DEFAULT_REGION}" --target-group-arn "${TARGET_GROUP_ARN}" \
                                --attributes Key=deregistration_delay.timeout_seconds,Value=20 >/dev/null
                        '''

                        echo "Target Group ARN: ${env.TARGET_GROUP_ARN}"
                        sh '''
                            aws elbv2 describe-target-groups \
                                --region "${AWS_DEFAULT_REGION}" --target-group-arns "${TARGET_GROUP_ARN}" \
                                --query 'TargetGroups[0].{TargetType:TargetType,Port:Port,HealthPath:HealthCheckPath,HealthPort:HealthCheckPort,Interval:HealthCheckIntervalSeconds,Timeout:HealthCheckTimeoutSeconds,HealthyThreshold:HealthyThresholdCount,UnhealthyThreshold:UnhealthyThresholdCount}' \
                                --output table
                        '''
                    }
                }
            }
        }


        stage('42 - Create ALB Listener') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        LISTENER_ARN=$(aws elbv2 describe-listeners \
                            --region "${AWS_DEFAULT_REGION}" \
                            --load-balancer-arn "${ALB_ARN}" \
                            --query 'Listeners[?Port==`80`].ListenerArn | [0]' \
                            --output text)


                        if [ "${LISTENER_ARN}" = "None" ] || [ -z "${LISTENER_ARN}" ]; then

                            echo "Creating HTTP listener..."

                            aws elbv2 create-listener \
                                --region "${AWS_DEFAULT_REGION}" \
                                --load-balancer-arn "${ALB_ARN}" \
                                --protocol HTTP \
                                --port 80 \
                                --default-actions \
                                    Type=forward,TargetGroupArn="${TARGET_GROUP_ARN}"

                        else

                            echo "HTTP listener already exists."

                            aws elbv2 modify-listener \
                                --region "${AWS_DEFAULT_REGION}" \
                                --listener-arn "${LISTENER_ARN}" \
                                --default-actions \
                                    Type=forward,TargetGroupArn="${TARGET_GROUP_ARN}"

                        fi
                    '''
                }
            }
        }


        stage('43 - Create ECS Cluster') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "ENSURING ECS FARGATE CLUSTER IS ACTIVE"
                        echo "================================================"

                        CLUSTER_STATUS=$(aws ecs describe-clusters \
                            --region "${AWS_DEFAULT_REGION}" \
                            --clusters "${ECS_CLUSTER}" \
                            --query 'clusters[0].status' \
                            --output text 2>/dev/null || true)

                        echo "Current ECS cluster status: ${CLUSTER_STATUS}"

                        if [ "${CLUSTER_STATUS}" = "ACTIVE" ]; then
                            echo "ECS cluster is already ACTIVE."
                        else
                            if [ "${CLUSTER_STATUS}" = "INACTIVE" ]; then
                                echo "ECS cluster is INACTIVE."
                                echo "Deleting inactive cluster so it can be recreated cleanly..."

                                aws ecs delete-cluster \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --cluster "${ECS_CLUSTER}" \
                                    >/dev/null

                                sleep 2
                            else
                                echo "ECS cluster does not exist."
                            fi

                            echo "Creating fresh ECS cluster..."

                            CREATED=false

                            for attempt in $(seq 1 10)
                            do
                                echo "Create attempt ${attempt}/10..."

                                if aws ecs create-cluster \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --cluster-name "${ECS_CLUSTER}" \
                                    >/tmp/ecs-create-cluster.json 2>/tmp/ecs-create-cluster-error.txt
                                then
                                    CREATED=true
                                    cat /tmp/ecs-create-cluster.json
                                    break
                                fi

                                echo "Cluster creation is not ready yet."
                                cat /tmp/ecs-create-cluster-error.txt || true
                                sleep 3
                            done

                            if [ "${CREATED}" != "true" ]; then
                                echo "ERROR: Could not create an ACTIVE ECS cluster."
                                exit 1
                            fi
                        fi

                        FINAL_CLUSTER_STATUS=$(aws ecs describe-clusters \
                            --region "${AWS_DEFAULT_REGION}" \
                            --clusters "${ECS_CLUSTER}" \
                            --query 'clusters[0].status' \
                            --output text)

                        echo "Final ECS cluster status: ${FINAL_CLUSTER_STATUS}"

                        if [ "${FINAL_CLUSTER_STATUS}" != "ACTIVE" ]; then
                            echo "ERROR: ECS cluster is not ACTIVE."
                            exit 1
                        fi

                        echo "ECS cluster is ACTIVE and ready for deployment."
                    '''
                }
            }
        }


        stage('44 - Register ECS Fargate Task Definition') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "REGISTERING ECS FARGATE TASK DEFINITION"
                        echo "================================================"

                        EXECUTION_ROLE_ARN=$(aws iam get-role \
                            --role-name "practice1-ecsTaskExecutionRole" \
                            --query 'Role.Arn' \
                            --output text)


                        cat > task-definition.json <<EOF
{
    "family": "${ECS_TASK_FAMILY}",
    "networkMode": "awsvpc",
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "${FARGATE_CPU}",
    "memory": "${FARGATE_MEMORY}",
    "executionRoleArn": "${EXECUTION_ROLE_ARN}",
    "containerDefinitions": [
        {
            "name": "${ECS_CONTAINER_NAME}",
            "image": "${ECR_IMAGE}",
            "essential": true,
            "portMappings": [
                {
                    "containerPort": ${CONTAINER_PORT},
                    "hostPort": ${CONTAINER_PORT},
                    "protocol": "tcp"
                }
            ],
            "environment": [
                {
                    "name": "STREAMLIT_SERVER_ADDRESS",
                    "value": "0.0.0.0"
                },
                {
                    "name": "STREAMLIT_SERVER_PORT",
                    "value": "${CONTAINER_PORT}"
                },
                {
                    "name": "STREAMLIT_SERVER_HEADLESS",
                    "value": "true"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/${ECS_TASK_FAMILY}",
                    "awslogs-region": "${AWS_DEFAULT_REGION}",
                    "awslogs-stream-prefix": "ecs"
                }
            }
        }
    ]
}
EOF


                        aws logs create-log-group \
                            --log-group-name "/ecs/${ECS_TASK_FAMILY}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            2>/dev/null || true


                        aws ecs register-task-definition \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cli-input-json file://task-definition.json


                        TASK_DEFINITION_ARN=$(aws ecs describe-task-definition \
                            --region "${AWS_DEFAULT_REGION}" \
                            --task-definition "${ECS_TASK_FAMILY}" \
                            --query 'taskDefinition.taskDefinitionArn' \
                            --output text)


                        echo "Task Definition:"
                        echo "${TASK_DEFINITION_ARN}"

                        env TASK_DEFINITION_ARN="${TASK_DEFINITION_ARN}"
                    '''
                }
            }
        }


        stage('45 - Create or Update ECS Fargate Service') {

            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {
                    sh '''
                        set -e

                        echo "================================================"
                        echo "DEPLOYING ECS FARGATE SERVICE"
                        echo "================================================"

                        SERVICE_STATUS=$(aws ecs describe-services --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" --services "${ECS_SERVICE}" \
                            --query 'services[0].status' --output text 2>/dev/null || true)

                        CURRENT_ECS_SG=$(aws ecs describe-services --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" --services "${ECS_SERVICE}" \
                            --query 'services[0].networkConfiguration.awsvpcConfiguration.securityGroups[0]' \
                            --output text 2>/dev/null || true)

                        CURRENT_TG=$(aws ecs describe-services --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" --services "${ECS_SERVICE}" \
                            --query 'services[0].loadBalancers[0].targetGroupArn' \
                            --output text 2>/dev/null || true)

                        echo "Service status        : ${SERVICE_STATUS}"
                        echo "Current ECS SG       : ${CURRENT_ECS_SG}"
                        echo "Required ECS SG      : ${ECS_SG_ID}"
                        echo "Current target group : ${CURRENT_TG}"
                        echo "Required target group: ${TARGET_GROUP_ARN}"

                        RECREATE_SERVICE=false

                        # The old working pipeline could leave an ACTIVE service with
                        # securityGroups=[] or a stale target group. update-service does
                        # not repair that old network configuration, so recreate it.
                        if [ "${SERVICE_STATUS}" = "ACTIVE" ]; then
                            if [ "${CURRENT_ECS_SG}" != "${ECS_SG_ID}" ] || [ "${CURRENT_TG}" != "${TARGET_GROUP_ARN}" ]; then
                                RECREATE_SERVICE=true
                                echo "Existing service has stale network/LB configuration."
                            fi
                        fi

                        if [ "${RECREATE_SERVICE}" = "true" ]; then
                            echo "Deleting stale ECS service..."
                            aws ecs delete-service --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" --service "${ECS_SERVICE}" --force >/dev/null

                            SERVICE_DELETED=false
                            for i in $(seq 1 40)
                            do
                                CHECK_STATUS=$(aws ecs describe-services --region "${AWS_DEFAULT_REGION}" \
                                    --cluster "${ECS_CLUSTER}" --services "${ECS_SERVICE}" \
                                    --query 'services[0].status' --output text 2>/dev/null || true)
                                echo "Delete check ${i}/40: ${CHECK_STATUS}"
                                if [ -z "${CHECK_STATUS}" ] || [ "${CHECK_STATUS}" = "None" ] || [ "${CHECK_STATUS}" = "INACTIVE" ]; then
                                    SERVICE_DELETED=true
                                    break
                                fi
                                sleep 5
                            done

                            if [ "${SERVICE_DELETED}" != "true" ]; then
                                echo "ERROR: Existing ECS service did not become INACTIVE."
                                exit 1
                            fi

                            # Wait for old ALB registrations to drain before adding the new task.
                            sleep 25
                        fi

                        if [ "${SERVICE_STATUS}" != "ACTIVE" ] || [ "${RECREATE_SERVICE}" = "true" ]; then
                            echo "Creating ECS service with corrected networking..."
                            aws ecs create-service \
                                --region "${AWS_DEFAULT_REGION}" --cluster "${ECS_CLUSTER}" \
                                --service-name "${ECS_SERVICE}" --task-definition "${ECS_TASK_FAMILY}" \
                                --desired-count 1 --launch-type FARGATE --platform-version LATEST \
                                --health-check-grace-period-seconds 120 \
                                --network-configuration "awsvpcConfiguration={subnets=[${SUBNET_1},${SUBNET_2}],securityGroups=[${ECS_SG_ID}],assignPublicIp=ENABLED}" \
                                --load-balancers "targetGroupArn=${TARGET_GROUP_ARN},containerName=${ECS_CONTAINER_NAME},containerPort=${CONTAINER_PORT}"
                        else
                            echo "Updating existing ECS service..."
                            aws ecs update-service \
                                --region "${AWS_DEFAULT_REGION}" --cluster "${ECS_CLUSTER}" \
                                --service "${ECS_SERVICE}" --task-definition "${ECS_TASK_FAMILY}" \
                                --desired-count 1 --health-check-grace-period-seconds 120 \
                                --force-new-deployment
                        fi

                        echo "Waiting for ECS service to reach a running task..."

                        SERVICE_READY=false
                        for i in $(seq 1 60)
                        do
                            SERVICE_INFO=$(aws ecs describe-services \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --services "${ECS_SERVICE}" \
                                --query 'services[0].[status,desiredCount,runningCount,pendingCount]' \
                                --output text 2>/dev/null || true)

                            STATUS=$(echo "${SERVICE_INFO}" | awk '{print $1}')
                            DESIRED=$(echo "${SERVICE_INFO}" | awk '{print $2}')
                            RUNNING=$(echo "${SERVICE_INFO}" | awk '{print $3}')
                            PENDING=$(echo "${SERVICE_INFO}" | awk '{print $4}')

                            echo "ECS readiness check ${i}/60: status=${STATUS}, desired=${DESIRED}, running=${RUNNING}, pending=${PENDING}"

                            if [ "${STATUS}" = "ACTIVE" ] && [ "${DESIRED:-0}" -ge 1 ] && [ "${RUNNING:-0}" -ge "${DESIRED:-1}" ] && [ "${PENDING:-0}" -eq 0 ]; then
                                SERVICE_READY=true
                                echo "ECS service has a running task and no pending tasks."
                                break
                            fi

                            sleep 5
                        done

                        if [ "${SERVICE_READY}" != "true" ]; then
                            echo "ERROR: ECS service did not become ready within the bounded wait period."
                            echo "Detailed ECS service state:"
                            aws ecs describe-services --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" --services "${ECS_SERVICE}" \
                                --query 'services[0].{Status:status,Desired:desiredCount,Running:runningCount,Pending:pendingCount,Deployments:deployments,Events:events[0:10],TargetGroup:loadBalancers[0].targetGroupArn,SecurityGroups:networkConfiguration.awsvpcConfiguration.securityGroups}' \
                                --output json || true
                            exit 1
                        fi

                        aws ecs describe-services --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" --services "${ECS_SERVICE}" \
                            --query 'services[0].{Status:status,Desired:desiredCount,Running:runningCount,Pending:pendingCount,SecurityGroups:networkConfiguration.awsvpcConfiguration.securityGroups,Subnets:networkConfiguration.awsvpcConfiguration.subnets,TargetGroup:loadBalancers[0].targetGroupArn}' \
                            --output table
                    '''
                }
            }
        }


        stage('46 - Verify ECS Running Task') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "VERIFYING ECS FARGATE TASK"
                        echo "================================================"


                        RUNNING_COUNT=$(aws ecs describe-services \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}" \
                            --query 'services[0].runningCount' \
                            --output text)


                        DESIRED_COUNT=$(aws ecs describe-services \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}" \
                            --query 'services[0].desiredCount' \
                            --output text)


                        echo "Desired tasks : ${DESIRED_COUNT}"
                        echo "Running tasks : ${RUNNING_COUNT}"


                        if [ "${RUNNING_COUNT}" -lt 1 ]; then

                            echo "ERROR: No running Fargate task."

                            exit 1

                        fi


                        TASK_ARN=$(aws ecs list-tasks \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --service-name "${ECS_SERVICE}" \
                            --desired-status RUNNING \
                            --query 'taskArns[0]' \
                            --output text)


                        echo ""
                        echo "Running Task:"
                        echo "${TASK_ARN}"


                        aws ecs describe-tasks \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --tasks "${TASK_ARN}" \
                            --query 'tasks[0].{TaskArn:taskArn,LastStatus:lastStatus,Health:healthStatus}' \
                            --output table
                    '''
                }
            }
        }


        stage('47 - Verify ALB Target Health') {

            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {
                    sh '''
                        set -e

                        echo "================================================"
                        echo "VERIFYING CURRENT ALB TARGET HEALTH"
                        echo "================================================"

                        TASK_ARN=$(aws ecs list-tasks --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" --service-name "${ECS_SERVICE}" \
                            --desired-status RUNNING --query 'taskArns[0]' --output text)

                        if [ -z "${TASK_ARN}" ] || [ "${TASK_ARN}" = "None" ]; then
                            echo "ERROR: No RUNNING ECS task exists."
                            exit 1
                        fi

                        TASK_IP=$(aws ecs describe-tasks --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" --tasks "${TASK_ARN}" \
                            --query "tasks[0].attachments[?type=='ElasticNetworkInterface'].details[?name=='privateIPv4Address'].value | [0]" \
                            --output text)

                        TASK_ENI=$(aws ecs describe-tasks --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" --tasks "${TASK_ARN}" \
                            --query "tasks[0].attachments[?type=='ElasticNetworkInterface'].details[?name=='networkInterfaceId'].value | [0]" \
                            --output text)

                        echo "Running task : ${TASK_ARN}"
                        echo "Task IP      : ${TASK_IP}"
                        echo "Task ENI     : ${TASK_ENI}"

                        echo ""
                        echo "ECS task/container state:"
                        aws ecs describe-tasks --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" --tasks "${TASK_ARN}" \
                            --query 'tasks[0].{LastStatus:lastStatus,Health:healthStatus,StoppedReason:stoppedReason,Containers:containers[*].{Name:name,LastStatus:lastStatus,ExitCode:exitCode,Reason:reason}}' \
                            --output table

                        echo ""
                        echo "Task ENI security groups:"
                        aws ec2 describe-network-interfaces --region "${AWS_DEFAULT_REGION}" \
                            --network-interface-ids "${TASK_ENI}" \
                            --query 'NetworkInterfaces[0].Groups[*].{GroupId:GroupId,Name:GroupName}' \
                            --output table

                        if [ -z "${TASK_IP}" ] || [ "${TASK_IP}" = "None" ]; then
                            echo "ERROR: Could not determine task private IP."
                            exit 1
                        fi

                        HEALTH=""
                        for i in $(seq 1 40)
                        do
                            TARGET_JSON=$(aws elbv2 describe-target-health --region "${AWS_DEFAULT_REGION}" \
                                --target-group-arn "${TARGET_GROUP_ARN}" \
                                --query "TargetHealthDescriptions[?Target.Id=='${TASK_IP}'].[TargetHealth.State,TargetHealth.Reason,TargetHealth.Description] | [0]" \
                                --output text 2>/dev/null || true)

                            HEALTH=$(echo "${TARGET_JSON}" | awk '{print $1}')
                            REASON=$(echo "${TARGET_JSON}" | awk '{print $2}')
                            DESCRIPTION=$(echo "${TARGET_JSON}" | cut -d' ' -f3-)

                            if [ -z "${HEALTH}" ] || [ "${HEALTH}" = "None" ]; then
                                HEALTH="not-registered"
                            fi

                            echo "Health attempt ${i}/40: ${HEALTH} | Reason: ${REASON} | ${DESCRIPTION}"

                            if [ "${HEALTH}" = "healthy" ]; then
                                echo "CURRENT FARGATE TARGET IS HEALTHY."
                                break
                            fi

                            sleep 10
                        done

                        if [ "${HEALTH}" != "healthy" ]; then
                            echo ""
                            echo "ERROR: CURRENT Fargate task target did not become healthy."
                            echo ""
                            echo "All target registrations:"
                            aws elbv2 describe-target-health --region "${AWS_DEFAULT_REGION}" \
                                --target-group-arn "${TARGET_GROUP_ARN}" --output table || true
                            echo ""
                            echo "Most likely causes:"
                            echo "1. ALB SG -> ECS SG port 8501 rule is missing."
                            echo "2. ALB SG egress is blocked."
                            echo "3. Streamlit is not listening on 0.0.0.0:8501."
                            echo "4. The task/container is not actually ready."
                            echo "5. Subnet routing/NACL/networking is blocking the connection."
                            exit 1
                        fi
                    '''
                }
            }
        }


        stage('48 - Verify ALB DNS') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        def albDns = sh(
                            script: '''
                                aws elbv2 describe-load-balancers \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --load-balancer-arns "${ALB_ARN}" \
                                    --query 'LoadBalancers[0].DNSName' \
                                    --output text
                            ''',
                            returnStdout: true
                        ).trim()


                        if (!albDns || albDns == 'None') {

                            error("Could not retrieve ALB DNS name.")
                        }


                        env.ALB_DNS = albDns

                        env.APPLICATION_URL =
                            "http://${albDns}"


                        echo "ALB DNS:"
                        echo "${env.ALB_DNS}"

                        echo ""
                        echo "Application URL:"
                        echo "${env.APPLICATION_URL}"
                    }
                }
            }
        }


        stage('49 - HTTP Application Health Check') {

            steps {

                sh '''
                    set -e

                    echo "================================================"
                    echo "CHECKING FINAL APPLICATION URL"
                    echo "================================================"

                    echo ""
                    echo "URL:"
                    echo "${APPLICATION_URL}"


                    for i in $(seq 1 30)
                    do

                        echo ""
                        echo "HTTP check ${i}/30..."


                        HTTP_CODE=$(curl \
                            --connect-timeout 10 \
                            --max-time 20 \
                            --silent \
                            --output /dev/null \
                            --write-out "%{http_code}" \
                            "${APPLICATION_URL}/" \
                            || true)


                        echo "HTTP status: ${HTTP_CODE}"


                        case "${HTTP_CODE}" in

                            2??|3??)

                                echo ""
                                echo "APPLICATION HTTP CHECK PASSED."

                                exit 0
                                ;;

                        esac


                        sleep 10

                    done


                    echo ""
                    echo "ERROR: Application did not respond successfully."


                    exit 1
                '''
            }
        }


        stage('50 - Final Deployment Verification') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo ""
                        echo "================================================"
                        echo "        FINAL DEPLOYMENT VERIFICATION"
                        echo "================================================"

                        echo ""
                        echo "AWS Region:"
                        echo "${AWS_DEFAULT_REGION}"

                        echo ""
                        echo "ECR Image URI:"
                        echo "${ECR_IMAGE}"

                        echo ""
                        echo "ECS Cluster:"
                        echo "${ECS_CLUSTER}"

                        echo ""
                        echo "ECS Service:"
                        echo "${ECS_SERVICE}"

                        echo ""
                        echo "Task Definition:"
                        echo "${ECS_TASK_FAMILY}"

                        echo ""
                        echo "ALB:"
                        echo "${ALB_NAME}"

                        echo ""
                        echo "ALB DNS:"
                        echo "${ALB_DNS}"

                        echo ""
                        echo "FINAL APPLICATION URL:"
                        echo "${APPLICATION_URL}"

                        echo ""
                        echo "================================================"
                        echo "       APPLICATION IS LIVE"
                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // PART 7 - POST DEPLOYMENT HEALTH CHECK
        // ============================================================

        stage('51 - Part 7 - Wait for Application Startup') {

            steps {

                echo '================================================'
                echo 'PART 7 - POST DEPLOYMENT HEALTH CHECK'
                echo '================================================'

                echo 'Waiting for the Fargate application to fully start...'

                sleep(
                    time: 20,
                    unit: 'SECONDS'
                )
            }
        }


        stage('52 - Part 7 - Verify ECS Service') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "PART 7 - VERIFYING ECS SERVICE"
                        echo "================================================"


                        SERVICE_STATUS=$(aws ecs describe-services \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}" \
                            --query 'services[0].status' \
                            --output text)


                        RUNNING_COUNT=$(aws ecs describe-services \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}" \
                            --query 'services[0].runningCount' \
                            --output text)


                        DESIRED_COUNT=$(aws ecs describe-services \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}" \
                            --query 'services[0].desiredCount' \
                            --output text)


                        echo ""
                        echo "ECS Service Status : ${SERVICE_STATUS}"
                        echo "Desired Count      : ${DESIRED_COUNT}"
                        echo "Running Count      : ${RUNNING_COUNT}"


                        if [ "${SERVICE_STATUS}" != "ACTIVE" ]; then

                            echo ""
                            echo "ERROR: ECS service is not ACTIVE."

                            exit 1

                        fi


                        if [ "${RUNNING_COUNT}" -lt 1 ]; then

                            echo ""
                            echo "ERROR: ECS service has no running task."

                            exit 1

                        fi


                        if [ "${RUNNING_COUNT}" -lt "${DESIRED_COUNT}" ]; then

                            echo ""
                            echo "ERROR: Running task count is lower than desired count."

                            exit 1

                        fi


                        echo ""
                        echo "ECS SERVICE CHECK: PASSED"
                    '''
                }
            }
        }


        stage('53 - Part 7 - Verify Running Task and Container') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "PART 7 - VERIFYING TASK AND CONTAINER"
                        echo "================================================"


                        TASK_ARN=$(aws ecs list-tasks \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --service-name "${ECS_SERVICE}" \
                            --desired-status RUNNING \
                            --query 'taskArns[0]' \
                            --output text)


                        if [ -z "${TASK_ARN}" ] || [ "${TASK_ARN}" = "None" ]; then

                            echo "ERROR: No RUNNING ECS task found."

                            exit 1

                        fi


                        echo ""
                        echo "Task ARN:"
                        echo "${TASK_ARN}"


                        TASK_STATUS=$(aws ecs describe-tasks \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --tasks "${TASK_ARN}" \
                            --query 'tasks[0].lastStatus' \
                            --output text)


                        echo ""
                        echo "Task Status:"
                        echo "${TASK_STATUS}"


                        if [ "${TASK_STATUS}" != "RUNNING" ]; then

                            echo ""
                            echo "ERROR: ECS task is not RUNNING."

                            exit 1

                        fi


                        CONTAINER_STATUS=$(aws ecs describe-tasks \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --tasks "${TASK_ARN}" \
                            --query "tasks[0].containers[?name=='${ECS_CONTAINER_NAME}'].lastStatus | [0]" \
                            --output text)


                        echo ""
                        echo "Container Name:"
                        echo "${ECS_CONTAINER_NAME}"

                        echo ""
                        echo "Container Status:"
                        echo "${CONTAINER_STATUS}"


                        if [ "${CONTAINER_STATUS}" != "RUNNING" ]; then

                            echo ""
                            echo "ERROR: Application container is not RUNNING."

                            exit 1

                        fi


                        echo ""
                        echo "TASK CHECK: PASSED"

                        echo "CONTAINER CHECK: PASSED"
                    '''
                }
            }
        }


        stage('54 - Part 7 - Verify ALB Target Health') {

            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {
                    sh '''
                        set -e

                        echo "================================================"
                        echo "PART 7 - VERIFYING CURRENT LOAD BALANCER TARGET"
                        echo "================================================"

                        TASK_ARN=$(aws ecs list-tasks --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" --service-name "${ECS_SERVICE}" \
                            --desired-status RUNNING --query 'taskArns[0]' --output text)

                        TASK_IP=$(aws ecs describe-tasks --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" --tasks "${TASK_ARN}" \
                            --query "tasks[0].attachments[?type=='ElasticNetworkInterface'].details[?name=='privateIPv4Address'].value | [0]" \
                            --output text)

                        echo "Task IP: ${TASK_IP}"
                        echo "Target Group: ${TARGET_GROUP_NAME}"

                        HEALTH=""
                        for i in $(seq 1 20)
                        do
                            HEALTH=$(aws elbv2 describe-target-health --region "${AWS_DEFAULT_REGION}" \
                                --target-group-arn "${TARGET_GROUP_ARN}" \
                                --query "TargetHealthDescriptions[?Target.Id=='${TASK_IP}'].TargetHealth.State | [0]" \
                                --output text 2>/dev/null || true)

                            echo "ALB health attempt ${i}/20 for ${TASK_IP}: ${HEALTH}"
                            if [ "${HEALTH}" = "healthy" ]; then
                                echo "ALB TARGET HEALTH: PASSED"
                                break
                            fi
                            sleep 10
                        done

                        if [ "${HEALTH}" != "healthy" ]; then
                            echo "ERROR: Current ECS task target is not healthy."
                            aws elbv2 describe-target-health --region "${AWS_DEFAULT_REGION}" \
                                --target-group-arn "${TARGET_GROUP_ARN}" --output table || true
                            exit 1
                        fi
                    '''
                }
            }
        }


        stage('55 - Part 7 - Verify Application URL') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "PART 7 - APPLICATION HEALTH CHECK"
                        echo "================================================"


                        if [ -z "${APPLICATION_URL}" ]; then

                            echo "ERROR: APPLICATION_URL is empty."

                            exit 1

                        fi


                        echo ""
                        echo "Application URL:"
                        echo "${APPLICATION_URL}"


                        SUCCESS=false


                        for i in $(seq 1 30)
                        do

                            echo ""
                            echo "Application health attempt ${i}/30"


                            HTTP_CODE=$(curl \
                                --connect-timeout 10 \
                                --max-time 20 \
                                --silent \
                                --show-error \
                                --output /dev/null \
                                --write-out "%{http_code}" \
                                "${APPLICATION_URL}${HEALTH_PATH}" \
                                || true)


                            echo "HTTP response code: ${HTTP_CODE}"


                            case "${HTTP_CODE}" in

                                200|201|202|203|204|205|206|300|301|302|303|304|307|308)

                                    echo ""
                                    echo "APPLICATION HTTP HEALTH CHECK: PASSED"

                                    SUCCESS=true

                                    break
                                    ;;

                                *)

                                    echo "Application is not healthy yet."

                                    sleep 10
                                    ;;

                            esac

                        done


                        if [ "${SUCCESS}" != "true" ]; then

                            echo ""
                            echo "================================================"
                            echo "APPLICATION HEALTH CHECK FAILED"
                            echo "================================================"

                            echo ""
                            echo "URL:"
                            echo "${APPLICATION_URL}${HEALTH_PATH}"

                            echo ""
                            echo "HTTP response:"
                            echo "${HTTP_CODE}"

                            echo ""
                            echo "The deployed application is not responding successfully."

                            exit 1

                        fi


                        echo ""
                        echo "Application responded successfully."
                    '''
                }
            }
        }


        stage('56 - Part 7 - Final Health Summary') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo ""
                        echo "================================================"
                        echo "        PART 7 HEALTH CHECK SUMMARY"
                        echo "================================================"

                        echo ""
                        echo "Environment:"
                        echo "${ENVIRONMENT}"

                        echo ""
                        echo "ECS Cluster:"
                        echo "${ECS_CLUSTER}"

                        echo ""
                        echo "ECS Service:"
                        echo "${ECS_SERVICE}"

                        echo ""
                        echo "Container:"
                        echo "${ECS_CONTAINER_NAME}"

                        echo ""
                        echo "ALB:"
                        echo "${ALB_NAME}"

                        echo ""
                        echo "Target Group:"
                        echo "${TARGET_GROUP_NAME}"

                        echo ""
                        echo "Application URL:"
                        echo "${APPLICATION_URL}"

                        echo ""
                        echo "------------------------------------------------"
                        echo "ECS SERVICE        : HEALTHY"
                        echo "FARGATE TASK       : RUNNING"
                        echo "CONTAINER          : RUNNING"
                        echo "ALB TARGET         : HEALTHY"
                        echo "APPLICATION HTTP   : HEALTHY"
                        echo "------------------------------------------------"

                        echo ""
                        echo "PART 7 - HEALTH CHECK: PASSED"

                        echo ""
                        echo "================================================"
                        echo "       DEPLOYMENT IS GENUINELY HEALTHY"
                        echo "================================================"
                    '''
                }
            }
        }
    }


    // ================================================================
    // POST ACTIONS
    // ================================================================

    post {

        success {

            echo ''
            echo '================================================'
            echo '       COMPLETE CI/CD PIPELINE SUCCESS'
            echo '================================================'

            echo ''
            echo 'PART 1 - CODE QUALITY      : PASSED'
            echo 'PART 2 - TESTING           : PASSED'
            echo 'PART 3 - DOCKER            : PASSED'
            echo 'PART 4 - ECR               : PASSED'
            echo 'PART 5 - TERRAFORM         : PASSED'
            echo 'PART 6 - ECS FARGATE       : PASSED'
            echo 'PART 6 - ALB               : PASSED'
            echo 'PART 6 - HTTP CHECK        : PASSED'
            echo 'PART 7 - HEALTH CHECK      : PASSED'

            echo ''
            echo '================================================'
            echo '          FINAL APPLICATION URL'
            echo '================================================'

            echo "${env.APPLICATION_URL}"

            echo ''
            echo '================================================'
            echo '          DEPLOYMENT COMPLETE'
            echo '================================================'
        }


        failure {

            echo ''
            echo '================================================'
            echo '          CI/CD PIPELINE FAILED'
            echo '================================================'

            echo ''
            echo 'The pipeline stopped because a deployment or health check failed.'

            echo ''
            echo 'Possible areas to inspect:'
            echo '1. ECS service'
            echo '2. Fargate task'
            echo '3. Container'
            echo '4. ALB target group'
            echo '5. Application HTTP endpoint'

            echo ''
            echo 'Check the Jenkins console output above.'

            echo '================================================'
        }


        always {

            echo ''
            echo '================================================'
            echo 'CLEANING JENKINS WORKSPACE'
            echo '================================================'

            cleanWs(
                deleteDirs: true,
                disableDeferredWipeout: true
            )
        }
    }
}
