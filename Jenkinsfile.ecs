pipeline {

    agent any

    // ================================================================
    // PIPELINE OPTIONS
    // ================================================================

    options {

        timestamps()

        ansiColor('xterm')

        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                daysToKeepStr: '30',
                numToKeepStr: '50'
            )
        )

        timeout(
            time: 90,
            unit: 'MINUTES'
        )
    }


    // ================================================================
    // PARAMETERS
    // ================================================================

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: [
                'dev',
                'qa',
                'stage',
                'prod'
            ],
            description: 'Terraform environment to deploy'
        )
    }


    // ================================================================
    // ENVIRONMENT
    // ================================================================

    environment {

        // ------------------------------------------------------------
        // REPOSITORIES
        // ------------------------------------------------------------

        APP_REPO = 'https://github.com/FAIZANSHEIKH223/practice1.git'
        APP_BRANCH = 'main'

        QUALITY_REPO = 'https://github.com/FAIZANSHEIKH223/pylint_flake8_int_jenkins.git'
        QUALITY_BRANCH = 'main'

        TERRAFORM_REPO = 'https://github.com/FAIZANSHEIKH223/terraform-aws-infra.git'
        TERRAFORM_BRANCH = 'main'


        // ------------------------------------------------------------
        // JENKINS CREDENTIALS
        // ------------------------------------------------------------

        GITHUB_CREDENTIALS = 'github-creds'

        AWS_CREDENTIALS = 'aws-creds'


        // ------------------------------------------------------------
        // DIRECTORIES
        // ------------------------------------------------------------

        APP_DIR = 'practice1'

        QUALITY_DIR = 'quality-tools'

        TERRAFORM_DIR = 'terraform-infra'

        VENV_DIR = 'venv'

        REPORT_DIR = 'reports'


        // ------------------------------------------------------------
        // PYTHON
        // ------------------------------------------------------------

        PYTHON = 'python3.12'


        // ------------------------------------------------------------
        // AWS
        // ------------------------------------------------------------

        AWS_DEFAULT_REGION = 'us-east-1'


        // ------------------------------------------------------------
        // APPLICATION
        // ------------------------------------------------------------

        APP_NAME = 'practice1'

        CONTAINER_NAME = 'practice1'

        CONTAINER_PORT = '8501'


        // ------------------------------------------------------------
        // DOCKER
        // ------------------------------------------------------------

        DOCKER_IMAGE_NAME = 'practice1'

        DOCKER_IMAGE_TAG = "${BUILD_NUMBER}"

        DOCKER_IMAGE = "${DOCKER_IMAGE_NAME}:${DOCKER_IMAGE_TAG}"


        // ------------------------------------------------------------
        // ECR
        // ------------------------------------------------------------

        ECR_REPOSITORY = 'practice1'

        ECR_IMAGE_TAG = "${BUILD_NUMBER}"


        // ------------------------------------------------------------
        // ECS FARGATE
        // ------------------------------------------------------------

        ECS_CLUSTER = "practice1-${ENVIRONMENT}-cluster"

        ECS_SERVICE = "practice1-${ENVIRONMENT}-service"

        ECS_TASK_FAMILY = "practice1-${ENVIRONMENT}-task"

        ECS_CONTAINER_NAME = 'practice1'


        // ------------------------------------------------------------
        // FARGATE
        // ------------------------------------------------------------

        FARGATE_CPU = '256'

        FARGATE_MEMORY = '512'


        // ------------------------------------------------------------
        // LOAD BALANCER
        // ------------------------------------------------------------

        ALB_NAME = "practice1-${ENVIRONMENT}-alb"

        TARGET_GROUP_NAME = "practice1-${ENVIRONMENT}-tg"

        ALB_SG_NAME = "practice1-${ENVIRONMENT}-alb-sg"

        ECS_SG_NAME = "practice1-${ENVIRONMENT}-ecs-sg"


        // ------------------------------------------------------------
        // TERRAFORM BACKEND
        // ------------------------------------------------------------

        TF_STATE_BUCKET = 'terraform-state-faizan-001'

        TF_LOCK_TABLE = 'terraform-locks'

        TF_STATE_KEY = 'terraform.tfstate'

        TF_IN_AUTOMATION = 'true'

        TF_INPUT = 'false'
    }


    // ================================================================
    // STAGES
    // ================================================================

    stages {


        // ============================================================
        // PART 1 - CODE QUALITY
        // ============================================================

        stage('1 - Checkout Application') {

            steps {

                echo '================================================'
                echo 'CHECKOUT APPLICATION'
                echo '================================================'

                dir("${APP_DIR}") {

                    deleteDir()

                    git(
                        branch: "${APP_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${APP_REPO}"
                    )
                }
            }
        }


        stage('2 - Checkout Quality Repository') {

            steps {

                echo '================================================'
                echo 'CHECKOUT QUALITY REPOSITORY'
                echo '================================================'

                dir("${QUALITY_DIR}") {

                    deleteDir()

                    git(
                        branch: "${QUALITY_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${QUALITY_REPO}"
                    )
                }
            }
        }


        stage('3 - Verify Python') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "VERIFYING PYTHON"
                        echo "================================================"

                        command -v "${PYTHON}"

                        "${PYTHON}" --version

                        "${PYTHON}" -m pip --version
                    '''
                }
            }
        }


        stage('4 - Create Python Virtual Environment') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "CREATING PYTHON VIRTUAL ENVIRONMENT"
                        echo "================================================"

                        rm -rf "${VENV_DIR}"

                        "${PYTHON}" -m venv "${VENV_DIR}"

                        "${VENV_DIR}/bin/python" --version
                    '''
                }
            }
        }


        stage('5 - Install Application Dependencies') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "INSTALLING APPLICATION DEPENDENCIES"
                        echo "================================================"

                        "${VENV_DIR}/bin/python" \
                            -m pip install --upgrade pip

                        if [ -f requirements.txt ]; then

                            "${VENV_DIR}/bin/pip" \
                                install \
                                -r requirements.txt

                        else

                            echo "WARNING: requirements.txt not found."

                        fi
                    '''
                }
            }
        }


        stage('6 - Install Quality Tools') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "INSTALLING QUALITY TOOLS"
                        echo "================================================"

                        "${VENV_DIR}/bin/pip" \
                            install \
                            flake8 \
                            pylint

                        "${VENV_DIR}/bin/flake8" --version

                        "${VENV_DIR}/bin/pylint" --version
                    '''
                }
            }
        }


        stage('7 - Flake8 Code Quality') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "RUNNING FLAKE8"
                        echo "================================================"

                        mkdir -p "${REPORT_DIR}"

                        "${VENV_DIR}/bin/flake8" \
                            . \
                            --exclude="${VENV_DIR},.git,${REPORT_DIR},__pycache__" \
                            --count \
                            --statistics \
                            --tee \
                            --output-file="${REPORT_DIR}/flake8-report.txt"
                    '''
                }
            }
        }


        stage('8 - Pylint Code Quality') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "RUNNING PYLINT"
                        echo "================================================"

                        mkdir -p "${REPORT_DIR}"

                        PYTHON_FILES=$(find . \
                            -type f \
                            -name "*.py" \
                            ! -path "./${VENV_DIR}/*" \
                            ! -path "./.git/*" \
                            ! -path "./${REPORT_DIR}/*" \
                            ! -path "*/__pycache__/*")

                        if [ -z "${PYTHON_FILES}" ]; then

                            echo "ERROR: No Python files found."

                            exit 1

                        fi

                        "${VENV_DIR}/bin/pylint" \
                            ${PYTHON_FILES} \
                            --output-format=text \
                            > "${REPORT_DIR}/pylint-report.txt"
                    '''
                }
            }
        }


        stage('9 - Part 1 Success') {

            steps {

                echo '================================================'
                echo 'PART 1 - CODE QUALITY SUCCESS'
                echo '================================================'

                echo 'Flake8 : PASSED'

                echo 'Pylint : PASSED'
            }
        }


        // ============================================================
        // PART 2 - TESTING
        // ============================================================

        stage('10 - Install Pytest') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "INSTALLING PYTEST"
                        echo "================================================"

                        "${VENV_DIR}/bin/pip" install pytest

                        "${VENV_DIR}/bin/pytest" --version
                    '''
                }
            }
        }


        stage('11 - Verify Tests') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "VERIFYING TESTS"
                        echo "================================================"

                        if [ ! -d "tests" ]; then

                            echo "ERROR: tests/ directory does not exist."

                            exit 1

                        fi

                        TEST_FILES=$(find tests \
                            -type f \
                            \\( \
                                -name "test_*.py" \
                                -o \
                                -name "*_test.py" \
                            \\))

                        if [ -z "${TEST_FILES}" ]; then

                            echo "ERROR: No pytest test files found."

                            exit 1

                        fi

                        echo "Test files:"
                        echo "${TEST_FILES}"
                    '''
                }
            }
        }


        stage('12 - Run Automated Tests') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "RUNNING AUTOMATED TESTS"
                        echo "================================================"

                        mkdir -p "${REPORT_DIR}"

                        "${VENV_DIR}/bin/pytest" \
                            tests/ \
                            -v \
                            --junitxml="${REPORT_DIR}/pytest-results.xml"
                    '''
                }
            }
        }


        stage('13 - Publish Test Results') {

            steps {

                junit(
                    testResults:
                        "${APP_DIR}/${REPORT_DIR}/pytest-results.xml",
                    allowEmptyResults: false
                )

                archiveArtifacts(
                    artifacts:
                        "${APP_DIR}/${REPORT_DIR}/pytest-results.xml," +
                        "${APP_DIR}/${REPORT_DIR}/flake8-report.txt," +
                        "${APP_DIR}/${REPORT_DIR}/pylint-report.txt",
                    allowEmptyArchive: false,
                    fingerprint: true
                )
            }
        }


        stage('14 - Part 2 Success') {

            steps {

                echo '================================================'
                echo 'PART 2 - TESTING SUCCESS'
                echo '================================================'

                echo 'Pytest : PASSED'
            }
        }


        // ============================================================
        // PART 3 - DOCKER
        // ============================================================

        stage('15 - Verify Docker') {

            steps {

                sh '''
                    set -e

                    echo "================================================"
                    echo "VERIFYING DOCKER"
                    echo "================================================"

                    command -v docker

                    docker --version

                    docker info > /dev/null

                    echo "Docker daemon is accessible."
                '''
            }
        }


        stage('16 - Prepare Docker Build Context') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "PREPARING DOCKER BUILD CONTEXT"
                        echo "================================================"

                        if [ ! -f Dockerfile ]; then

                            echo "ERROR: Dockerfile not found."

                            exit 1

                        fi

                        cat > .dockerignore <<'EOF'
venv/
.venv/
.git/
.gitignore
**/__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
reports/
*.log
.DS_Store
EOF

                        echo ""
                        echo "Docker ignore file:"
                        cat .dockerignore

                        echo ""
                        echo "Dockerfile:"
                        cat Dockerfile
                    '''
                }
            }
        }


        stage('17 - Build Docker Image') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "BUILDING DOCKER IMAGE"
                        echo "================================================"

                        echo "Image: ${DOCKER_IMAGE}"

                        docker build \
                            --pull \
                            --tag "${DOCKER_IMAGE}" \
                            .

                        docker image inspect \
                            "${DOCKER_IMAGE}" \
                            > /dev/null

                        echo "Docker image created successfully."
                    '''
                }
            }
        }


        stage('18 - Docker Image Verification') {

            steps {

                sh '''
                    set -e

                    echo "================================================"
                    echo "VERIFYING DOCKER IMAGE"
                    echo "================================================"

                    docker image inspect \
                        "${DOCKER_IMAGE}" \
                        --format='Image={{.RepoTags}} Size={{.Size}}'

                    echo ""

                    docker images "${DOCKER_IMAGE_NAME}"
                '''
            }
        }


        stage('19 - Part 3 Success') {

            steps {

                echo '================================================'
                echo 'PART 3 - DOCKER SUCCESS'
                echo '================================================'

                echo "Docker Image: ${DOCKER_IMAGE}"
            }
        }


        // ============================================================
        // PART 4 - AWS ECR
        // ============================================================

        stage('20 - Verify AWS CLI') {

            steps {

                sh '''
                    set -e

                    echo "================================================"
                    echo "VERIFYING AWS CLI"
                    echo "================================================"

                    command -v aws

                    aws --version
                '''
            }
        }


        stage('21 - Verify AWS Credentials') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "VERIFYING AWS CREDENTIALS"
                        echo "================================================"

                        aws sts get-caller-identity \
                            --region "${AWS_DEFAULT_REGION}"
                    '''
                }
            }
        }


        stage('22 - Create ECR Repository') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "VERIFYING ECR REPOSITORY"
                        echo "================================================"

                        echo "Repository : ${ECR_REPOSITORY}"
                        echo "Region     : ${AWS_DEFAULT_REGION}"

                        if aws ecr describe-repositories \
                            --repository-names "${ECR_REPOSITORY}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            > /dev/null 2>&1
                        then

                            echo "ECR repository already exists."

                        else

                            echo "ECR repository does not exist."
                            echo "Creating ECR repository..."

                            aws ecr create-repository \
                                --repository-name "${ECR_REPOSITORY}" \
                                --region "${AWS_DEFAULT_REGION}"

                            echo "ECR create-repository completed."

                        fi

                        REPOSITORY_URI=$(aws ecr describe-repositories \
                            --repository-names "${ECR_REPOSITORY}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            --query 'repositories[0].repositoryUri' \
                            --output text)

                        if [ -z "${REPOSITORY_URI}" ] || \
                           [ "${REPOSITORY_URI}" = "None" ]; then

                            echo "ERROR: ECR repository could not be verified."

                            exit 1

                        fi

                        echo ""
                        echo "================================================"
                        echo "ECR REPOSITORY READY"
                        echo "================================================"

                        echo "Repository Name : ${ECR_REPOSITORY}"
                        echo "Repository URI  : ${REPOSITORY_URI}"
                        echo "Region          : ${AWS_DEFAULT_REGION}"
                    '''
                }
            }
        }


        stage('23 - Get ECR Image URI') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        def accountId = sh(
                            script: '''
                                aws sts get-caller-identity \
                                    --query Account \
                                    --output text \
                                    --region "${AWS_DEFAULT_REGION}"
                            ''',
                            returnStdout: true
                        ).trim()

                        if (!accountId || accountId == 'None') {

                            error(
                                'Unable to determine AWS account ID.'
                            )
                        }

                        env.AWS_ACCOUNT_ID = accountId

                        env.ECR_REGISTRY =
                            "${accountId}.dkr.ecr.${AWS_DEFAULT_REGION}.amazonaws.com"

                        env.ECR_IMAGE =
                            "${env.ECR_REGISTRY}/${env.ECR_REPOSITORY}:${env.ECR_IMAGE_TAG}"

                        echo "AWS Account ID : ${env.AWS_ACCOUNT_ID}"

                        echo "ECR Registry   : ${env.ECR_REGISTRY}"

                        echo "ECR Image URI  : ${env.ECR_IMAGE}"
                    }
                }
            }
        }


        stage('24 - Login Docker to ECR') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "LOGGING DOCKER INTO ECR"
                        echo "================================================"

                        aws ecr get-login-password \
                            --region "${AWS_DEFAULT_REGION}" |
                        docker login \
                            --username AWS \
                            --password-stdin \
                            "${ECR_REGISTRY}"

                        echo "Docker login to ECR successful."
                    '''
                }
            }
        }


        stage('25 - Tag Image with ECR URI') {

            steps {

                sh '''
                    set -e

                    docker tag \
                        "${DOCKER_IMAGE}" \
                        "${ECR_IMAGE}"

                    docker image inspect \
                        "${ECR_IMAGE}" \
                        > /dev/null

                    echo "ECR image:"
                    echo "${ECR_IMAGE}"
                '''
            }
        }


        stage('26 - Push Image to ECR') {

            steps {

                sh '''
                    set -e

                    echo "================================================"
                    echo "PUSHING IMAGE TO ECR"
                    echo "================================================"

                    docker push "${ECR_IMAGE}"

                    echo ""
                    echo "Docker image pushed successfully."
                '''
            }
        }


        stage('27 - Verify ECR Image') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "VERIFYING PUSHED ECR IMAGE"
                        echo "================================================"

                        aws ecr describe-images \
                            --repository-name "${ECR_REPOSITORY}" \
                            --image-ids imageTag="${ECR_IMAGE_TAG}" \
                            --region "${AWS_DEFAULT_REGION}"

                        echo ""
                        echo "ECR IMAGE VERIFIED:"
                        echo "${ECR_IMAGE}"
                    '''
                }
            }
        }


        stage('28 - Part 4 Success') {

            steps {

                echo '================================================'
                echo 'PART 4 - ECR SUCCESS'
                echo '================================================'

                echo "ECR Image URI: ${env.ECR_IMAGE}"
            }
        }


        // ============================================================
        // PART 5 - TERRAFORM
        // ============================================================

        stage('29 - Checkout Terraform Repository') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    deleteDir()

                    git(
                        branch: "${TERRAFORM_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${TERRAFORM_REPO}"
                    )
                }
            }
        }


        stage('30 - Verify Terraform') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    sh '''
                        set -e

                        command -v terraform

                        terraform version

                        echo ""
                        echo "Terraform files:"

                        find . \
                            -maxdepth 3 \
                            -type f \
                            -name "*.tf" \
                            -print
                    '''
                }
            }
        }


        stage('31 - Terraform Environment Verification') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    sh '''
                        set -e

                        echo "Environment: ${ENVIRONMENT}"

                        if [ ! -d "environments/${ENVIRONMENT}" ]; then

                            echo "ERROR: Terraform environment does not exist:"
                            echo "environments/${ENVIRONMENT}"

                            exit 1

                        fi

                        if [ ! -f "environments/${ENVIRONMENT}/terraform.tfvars" ]; then

                            echo "ERROR: terraform.tfvars not found."

                            exit 1

                        fi

                        echo "Terraform environment verified."
                    '''
                }
            }
        }


        // ============================================================
        // NEW CORRECTION
        //
        // CREATE TERRAFORM S3 BUCKET AND DYNAMODB TABLE IF MISSING
        // ============================================================

        stage('32 - Ensure Terraform Backend Exists') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh(
                        script: '''#!/usr/bin/env bash

                        set -euo pipefail

                        echo "================================================"
                        echo "ENSURING TERRAFORM BACKEND EXISTS"
                        echo "================================================"

                        echo ""
                        echo "AWS Region       : ${AWS_DEFAULT_REGION}"
                        echo "S3 State Bucket  : ${TF_STATE_BUCKET}"
                        echo "DynamoDB Table   : ${TF_LOCK_TABLE}"
                        echo "State Key        : ${TF_STATE_KEY}"


                        // ------------------------------------------------
                        // AWS IDENTITY
                        // ------------------------------------------------

                        echo ""
                        echo "================================================"
                        echo "VERIFYING AWS IDENTITY"
                        echo "================================================"

                        aws sts get-caller-identity \
                            --region "${AWS_DEFAULT_REGION}"


                        // ------------------------------------------------
                        // S3 BUCKET
                        // ------------------------------------------------

                        echo ""
                        echo "================================================"
                        echo "CHECKING TERRAFORM S3 STATE BUCKET"
                        echo "================================================"

                        if aws s3api head-bucket \
                            --bucket "${TF_STATE_BUCKET}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            > /dev/null 2>&1
                        then

                            echo "S3 state bucket already exists."

                        else

                            echo "S3 state bucket does not exist."
                            echo "Creating S3 state bucket..."

                            if [ "${AWS_DEFAULT_REGION}" = "us-east-1" ]; then

                                aws s3api create-bucket \
                                    --bucket "${TF_STATE_BUCKET}" \
                                    --region "${AWS_DEFAULT_REGION}"

                            else

                                aws s3api create-bucket \
                                    --bucket "${TF_STATE_BUCKET}" \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --create-bucket-configuration \
                                    LocationConstraint="${AWS_DEFAULT_REGION}"

                            fi

                            echo "S3 bucket creation completed."

                        fi


                        // ------------------------------------------------
                        // WAIT FOR S3 BUCKET
                        // ------------------------------------------------

                        echo ""
                        echo "Waiting for S3 bucket to become available..."

                        for i in $(seq 1 30); do

                            if aws s3api head-bucket \
                                --bucket "${TF_STATE_BUCKET}" \
                                --region "${AWS_DEFAULT_REGION}" \
                                > /dev/null 2>&1
                            then

                                echo "S3 bucket is available."

                                break

                            fi

                            if [ "${i}" -eq 30 ]; then

                                echo "ERROR: S3 bucket did not become available."

                                exit 1

                            fi

                            echo "Waiting for S3 bucket... attempt ${i}/30"

                            sleep 2

                        done


                        // ------------------------------------------------
                        // ENABLE S3 VERSIONING
                        // ------------------------------------------------

                        echo ""
                        echo "================================================"
                        echo "ENABLING S3 VERSIONING"
                        echo "================================================"

                        aws s3api put-bucket-versioning \
                            --bucket "${TF_STATE_BUCKET}" \
                            --versioning-configuration Status=Enabled \
                            --region "${AWS_DEFAULT_REGION}"

                        echo "S3 versioning enabled."


                        // ------------------------------------------------
                        // ENABLE S3 SERVER-SIDE ENCRYPTION
                        // ------------------------------------------------

                        echo ""
                        echo "================================================"
                        echo "ENABLING S3 ENCRYPTION"
                        echo "================================================"

                        aws s3api put-bucket-encryption \
                            --bucket "${TF_STATE_BUCKET}" \
                            --server-side-encryption-configuration \
                            '{
                                "Rules": [
                                    {
                                        "ApplyServerSideEncryptionByDefault": {
                                            "SSEAlgorithm": "AES256"
                                        }
                                    }
                                ]
                            }' \
                            --region "${AWS_DEFAULT_REGION}"

                        echo "S3 server-side encryption enabled."


                        // ------------------------------------------------
                        // ENABLE S3 PUBLIC ACCESS BLOCK
                        // ------------------------------------------------

                        echo ""
                        echo "================================================"
                        echo "PROTECTING S3 STATE BUCKET"
                        echo "================================================"

                        aws s3api put-public-access-block \
                            --bucket "${TF_STATE_BUCKET}" \
                            --public-access-block-configuration \
                            BlockPublicAcls=true,IgnorePublicAcls=true,BlockPublicPolicy=true,RestrictPublicBuckets=true \
                            --region "${AWS_DEFAULT_REGION}"

                        echo "S3 public access blocked."


                        // ------------------------------------------------
                        // VERIFY S3 BUCKET
                        // ------------------------------------------------

                        echo ""
                        echo "================================================"
                        echo "VERIFYING S3 STATE BUCKET"
                        echo "================================================"

                        aws s3api head-bucket \
                            --bucket "${TF_STATE_BUCKET}" \
                            --region "${AWS_DEFAULT_REGION}"

                        VERSIONING_STATUS=$(aws s3api get-bucket-versioning \
                            --bucket "${TF_STATE_BUCKET}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            --query 'Status' \
                            --output text)

                        if [ "${VERSIONING_STATUS}" != "Enabled" ]; then

                            echo "ERROR: S3 versioning is not enabled."

                            exit 1

                        fi

                        echo "S3 state bucket verified."


                        // ------------------------------------------------
                        // DYNAMODB LOCK TABLE
                        // ------------------------------------------------

                        echo ""
                        echo "================================================"
                        echo "CHECKING TERRAFORM DYNAMODB LOCK TABLE"
                        echo "================================================"

                        TABLE_EXISTS="false"

                        if aws dynamodb describe-table \
                            --table-name "${TF_LOCK_TABLE}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            > /dev/null 2>&1
                        then

                            TABLE_EXISTS="true"

                            echo "DynamoDB lock table already exists."

                        else

                            echo "DynamoDB lock table does not exist."
                            echo "Creating DynamoDB lock table..."

                            aws dynamodb create-table \
                                --table-name "${TF_LOCK_TABLE}" \
                                --attribute-definitions \
                                    AttributeName=LockID,AttributeType=S \
                                --key-schema \
                                    AttributeName=LockID,KeyType=HASH \
                                --billing-mode PAY_PER_REQUEST \
                                --region "${AWS_DEFAULT_REGION}"

                            echo "DynamoDB create-table request submitted."

                        fi


                        // ------------------------------------------------
                        // WAIT FOR DYNAMODB
                        // ------------------------------------------------

                        echo ""
                        echo "================================================"
                        echo "WAITING FOR DYNAMODB TABLE"
                        echo "================================================"

                        aws dynamodb wait table-exists \
                            --table-name "${TF_LOCK_TABLE}" \
                            --region "${AWS_DEFAULT_REGION}"

                        echo "DynamoDB table exists."


                        // ------------------------------------------------
                        // WAIT UNTIL ACTIVE
                        // ------------------------------------------------

                        for i in $(seq 1 30); do

                            TABLE_STATUS=$(aws dynamodb describe-table \
                                --table-name "${TF_LOCK_TABLE}" \
                                --region "${AWS_DEFAULT_REGION}" \
                                --query 'Table.TableStatus' \
                                --output text)

                            echo "DynamoDB status: ${TABLE_STATUS}"

                            if [ "${TABLE_STATUS}" = "ACTIVE" ]; then

                                break

                            fi

                            if [ "${i}" -eq 30 ]; then

                                echo "ERROR: DynamoDB table did not become ACTIVE."

                                exit 1

                            fi

                            sleep 2

                        done


                        // ------------------------------------------------
                        // FINAL DYNAMODB VERIFICATION
                        // ------------------------------------------------

                        echo ""
                        echo "================================================"
                        echo "VERIFYING DYNAMODB LOCK TABLE"
                        echo "================================================"

                        FINAL_TABLE_STATUS=$(aws dynamodb describe-table \
                            --table-name "${TF_LOCK_TABLE}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            --query 'Table.TableStatus' \
                            --output text)

                        if [ "${FINAL_TABLE_STATUS}" != "ACTIVE" ]; then

                            echo "ERROR: DynamoDB table is not ACTIVE."

                            exit 1

                        fi

                        echo "DynamoDB table is ACTIVE."


                        // ------------------------------------------------
                        // FINAL BACKEND REPORT
                        // ------------------------------------------------

                        echo ""
                        echo "================================================"
                        echo "TERRAFORM BACKEND READY"
                        echo "================================================"

                        echo ""
                        echo "S3 Bucket:"
                        echo "${TF_STATE_BUCKET}"

                        echo ""
                        echo "S3 State Key:"
                        echo "${TF_STATE_KEY}"

                        echo ""
                        echo "DynamoDB Lock Table:"
                        echo "${TF_LOCK_TABLE}"

                        echo ""
                        echo "AWS Region:"
                        echo "${AWS_DEFAULT_REGION}"

                        echo ""
                        echo "================================================"
                        echo "S3 + DYNAMODB BACKEND CHECK PASSED"
                        echo "================================================"
                        ''',
                        label: 'Create Terraform S3 bucket and DynamoDB lock table if missing'
                    )
                }
            }
        }


        // ============================================================
        // TERRAFORM INIT
        // ============================================================

        stage('33 - Terraform Init') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh(
                            script: '''#!/usr/bin/env bash

                            set -euo pipefail

                            echo "================================================"
                            echo "TERRAFORM INIT"
                            echo "================================================"

                            echo "Terraform directory : ${PWD}"
                            echo "AWS region           : ${AWS_DEFAULT_REGION}"
                            echo "State bucket         : ${TF_STATE_BUCKET}"
                            echo "State key            : ${TF_STATE_KEY}"
                            echo "Lock table           : ${TF_LOCK_TABLE}"


                            echo ""
                            echo "Checking AWS identity..."

                            aws sts get-caller-identity \
                                --region "${AWS_DEFAULT_REGION}"


                            echo ""
                            echo "Checking Terraform..."

                            terraform version


                            // ------------------------------------------------
                            // VERIFY S3 STATE OBJECT
                            // ------------------------------------------------

                            echo ""
                            echo "================================================"
                            echo "CHECKING REMOTE TERRAFORM STATE"
                            echo "================================================"

                            S3_STATE_EXISTS="false"

                            if aws s3api head-object \
                                --bucket "${TF_STATE_BUCKET}" \
                                --key "${TF_STATE_KEY}" \
                                --region "${AWS_DEFAULT_REGION}" \
                                > /dev/null 2>&1
                            then

                                S3_STATE_EXISTS="true"

                                echo "S3 Terraform state exists."

                            else

                                echo "S3 Terraform state does not exist yet."

                            fi


                            // ------------------------------------------------
                            // TERRAFORM INIT
                            // ------------------------------------------------

                            echo ""
                            echo "================================================"
                            echo "RUNNING TERRAFORM INIT"
                            echo "================================================"

                            INIT_LOG="$(mktemp)"

                            INIT_STATUS=0

                            set +e

                            terraform init \
                                -input=false \
                                2>&1 | tee "${INIT_LOG}"

                            INIT_STATUS=${PIPESTATUS[0]}

                            set -e


                            if [ "${INIT_STATUS}" -eq 0 ]; then

                                echo ""
                                echo "================================================"
                                echo "TERRAFORM INIT SUCCESSFUL"
                                echo "================================================"

                                rm -f "${INIT_LOG}"

                                exit 0

                            fi


                            echo ""
                            echo "Terraform init failed with exit code ${INIT_STATUS}."


                            // ------------------------------------------------
                            // CHECK CHECKSUM ERROR
                            // ------------------------------------------------

                            echo ""
                            echo "================================================"
                            echo "CHECKING FOR S3/DYNAMODB CHECKSUM MISMATCH"
                            echo "================================================"

                            if grep -qi \
                                "checksum calculated for the state stored in S3 does not match the checksum" \
                                "${INIT_LOG}"
                            then

                                echo "Detected Terraform S3/DynamoDB state checksum mismatch."

                            else

                                echo "The Terraform init failure is NOT the known"
                                echo "S3/DynamoDB checksum mismatch."

                                echo ""
                                echo "Terraform init output:"
                                cat "${INIT_LOG}"

                                rm -f "${INIT_LOG}"

                                exit "${INIT_STATUS}"

                            fi


                            // ------------------------------------------------
                            // STATE SAFETY CHECK
                            // ------------------------------------------------

                            echo ""
                            echo "================================================"
                            echo "REMOTE STATE SAFETY CHECK"
                            echo "================================================"

                            if [ "${S3_STATE_EXISTS}" != "true" ]; then

                                echo "ERROR: Terraform state object does not exist in S3."

                                echo "The pipeline will NOT modify DynamoDB."

                                echo ""
                                echo "S3 bucket : ${TF_STATE_BUCKET}"
                                echo "S3 key    : ${TF_STATE_KEY}"

                                rm -f "${INIT_LOG}"

                                exit 1

                            fi


                            echo "Confirmed that the Terraform state exists in S3."


                            echo ""
                            echo "S3 state object details:"

                            aws s3api head-object \
                                --bucket "${TF_STATE_BUCKET}" \
                                --key "${TF_STATE_KEY}" \
                                --region "${AWS_DEFAULT_REGION}"


                            // ------------------------------------------------
                            // CHECK DYNAMODB TABLE
                            // ------------------------------------------------

                            echo ""
                            echo "================================================"
                            echo "CHECKING DYNAMODB LOCK TABLE"
                            echo "================================================"

                            TABLE_STATUS="$(aws dynamodb describe-table \
                                --table-name "${TF_LOCK_TABLE}" \
                                --region "${AWS_DEFAULT_REGION}" \
                                --query 'Table.TableStatus' \
                                --output text \
                                2>/dev/null || true)"


                            if [ -z "${TABLE_STATUS}" ] || \
                               [ "${TABLE_STATUS}" = "None" ]; then

                                echo "ERROR: DynamoDB lock table was not found."

                                echo "Table: ${TF_LOCK_TABLE}"

                                rm -f "${INIT_LOG}"

                                exit 1

                            fi


                            echo "DynamoDB table status: ${TABLE_STATUS}"


                            if [ "${TABLE_STATUS}" != "ACTIVE" ]; then

                                echo "ERROR: DynamoDB lock table is not ACTIVE."

                                rm -f "${INIT_LOG}"

                                exit 1

                            fi


                            // ------------------------------------------------
                            // CHECK TERRAFORM DIGEST
                            // ------------------------------------------------

                            echo ""
                            echo "================================================"
                            echo "CHECKING TERRAFORM DIGEST"
                            echo "================================================"

                            DIGEST_KEY="${TF_STATE_BUCKET}/${TF_STATE_KEY}-md5"


                            DIGEST_ITEM="$(aws dynamodb get-item \
                                --table-name "${TF_LOCK_TABLE}" \
                                --key '{"LockID":{"S":"'"${DIGEST_KEY}"'"}}' \
                                --region "${AWS_DEFAULT_REGION}" \
                                --consistent-read \
                                --output json \
                                2>/dev/null || true)"


                            if [ -z "${DIGEST_ITEM}" ]; then

                                echo "ERROR: Could not read DynamoDB digest item."

                                rm -f "${INIT_LOG}"

                                exit 1

                            fi


                            echo "DynamoDB digest lookup completed."


                            if echo "${DIGEST_ITEM}" | grep -q '"Item"'; then

                                echo "A Terraform digest entry exists."

                            else

                                echo "No Terraform digest entry was found."

                            fi


                            // ------------------------------------------------
                            // REMOVE ONLY STALE DIGEST
                            // ------------------------------------------------

                            echo ""
                            echo "================================================"
                            echo "REMOVING STALE TERRAFORM DIGEST"
                            echo "================================================"

                            echo "IMPORTANT:"
                            echo "The S3 Terraform state will NOT be deleted."
                            echo "The DynamoDB table will NOT be deleted."
                            echo "Only the Terraform S3-state digest item will be removed."


                            aws dynamodb delete-item \
                                --table-name "${TF_LOCK_TABLE}" \
                                --key '{"LockID":{"S":"'"${DIGEST_KEY}"'"}}' \
                                --region "${AWS_DEFAULT_REGION}"


                            echo ""
                            echo "Stale Terraform digest removed."


                            // ------------------------------------------------
                            // WAIT FOR AWS CONSISTENCY
                            // ------------------------------------------------

                            echo ""
                            echo "================================================"
                            echo "WAITING FOR AWS STATE CONSISTENCY"
                            echo "================================================"

                            sleep 10


                            // ------------------------------------------------
                            // RETRY TERRAFORM INIT
                            // ------------------------------------------------

                            echo ""
                            echo "================================================"
                            echo "RETRYING TERRAFORM INIT"
                            echo "================================================"

                            rm -f "${INIT_LOG}"


                            terraform init \
                                -input=false


                            echo ""
                            echo "================================================"
                            echo "TERRAFORM INIT RECOVERY SUCCESSFUL"
                            echo "================================================"

                            echo "The Terraform backend is now initialized."

                            echo "S3 state bucket : ${TF_STATE_BUCKET}"
                            echo "S3 state key    : ${TF_STATE_KEY}"
                            echo "DynamoDB table  : ${TF_LOCK_TABLE}"

                            echo ""
                            echo "Terraform init completed successfully."


                            rm -f "${INIT_LOG}"
                            ''',
                            label: 'Terraform init with automatic S3/DynamoDB checksum recovery'
                        )
                    }
                }
            }
        }


        stage('34 - Terraform Validate') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "TERRAFORM VALIDATE"
                        echo "================================================"

                        terraform validate
                    '''
                }
            }
        }


        stage('35 - Terraform Plan') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh '''
                            set -e

                            echo "================================================"
                            echo "TERRAFORM PLAN"
                            echo "================================================"

                            terraform plan \
                                -input=false \
                                -var-file="environments/${ENVIRONMENT}/terraform.tfvars" \
                                -out="tfplan"
                        '''
                    }
                }
            }
        }


        stage('36 - Terraform Apply') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh '''
                            set -e

                            echo "================================================"
                            echo "TERRAFORM APPLY"
                            echo "================================================"

                            if [ ! -f tfplan ]; then

                                echo "ERROR: tfplan not found."

                                exit 1

                            fi

                            terraform apply \
                                -input=false \
                                -auto-approve \
                                tfplan
                        '''
                    }
                }
            }
        }


        stage('37 - Terraform Deployment Verification') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh '''
                            set -e

                            echo "Terraform state:"

                            terraform state list || true

                            echo ""

                            echo "Terraform outputs:"

                            terraform output || true

                            echo ""

                            echo "AWS identity:"

                            aws sts get-caller-identity \
                                --region "${AWS_DEFAULT_REGION}"

                            echo ""

                            echo "Terraform deployment verification completed."
                        '''
                    }
                }
            }
        }


        // ============================================================
        // PART 6 - ECS FARGATE + ALB
        // ============================================================

        stage('38 - Discover AWS Network') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        echo '================================================'
                        echo 'DISCOVERING AWS NETWORK'
                        echo '================================================'


                        def vpcId = sh(
                            script: '''
                                set -e

                                VPC_ID=$(aws ec2 describe-vpcs \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --filters \
                                        "Name=tag:Environment,Values=${ENVIRONMENT}" \
                                    --query 'Vpcs[0].VpcId' \
                                    --output text)

                                if [ "${VPC_ID}" = "None" ] || \
                                   [ -z "${VPC_ID}" ]; then

                                    VPC_ID=$(aws ec2 describe-vpcs \
                                        --region "${AWS_DEFAULT_REGION}" \
                                        --filters \
                                            "Name=is-default,Values=true" \
                                        --query 'Vpcs[0].VpcId' \
                                        --output text)

                                fi

                                if [ "${VPC_ID}" = "None" ] || \
                                   [ -z "${VPC_ID}" ]; then

                                    echo "ERROR: No VPC found."

                                    exit 1

                                fi

                                echo "${VPC_ID}"
                            ''',
                            returnStdout: true
                        ).trim()


                        if (!vpcId || vpcId == 'None') {

                            error(
                                'Unable to discover VPC.'
                            )
                        }


                        env.VPC_ID = vpcId


                        def subnetOutput = sh(
                            script: '''
                                set -e

                                SUBNETS=$(aws ec2 describe-subnets \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --filters \
                                        "Name=vpc-id,Values=${VPC_ID}" \
                                        "Name=map-public-ip-on-launch,Values=true" \
                                    --query 'Subnets[].SubnetId' \
                                    --output text)

                                if [ -z "${SUBNETS}" ] || \
                                   [ "${SUBNETS}" = "None" ]; then

                                    echo "ERROR: No public subnets found."

                                    exit 1

                                fi

                                echo "${SUBNETS}"
                            ''',
                            returnStdout: true
                        ).trim()


                        def subnetList = subnetOutput.split("\\s+")


                        if (subnetList.size() < 2) {

                            error(
                                "At least 2 public subnets are required for the ALB. " +
                                "Found: ${subnetOutput}"
                            )
                        }


                        env.SUBNET_1 = subnetList[0]

                        env.SUBNET_2 = subnetList[1]


                        echo "VPC ID  : ${env.VPC_ID}"

                        echo "Subnet 1: ${env.SUBNET_1}"

                        echo "Subnet 2: ${env.SUBNET_2}"
                    }
                }
            }
        }


        stage('39 - Create IAM Roles for ECS') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "CREATING ECS IAM ROLE"
                        echo "================================================"

                        EXECUTION_ROLE_NAME="practice1-ecsTaskExecutionRole"


                        if aws iam get-role \
                            --role-name "${EXECUTION_ROLE_NAME}" \
                            > /dev/null 2>&1
                        then

                            echo "ECS execution role already exists."

                        else

                            cat > /tmp/ecs-trust-policy.json <<'EOF'
{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
            },
            "Action": "sts:AssumeRole"
        }
    ]
}
EOF

                            aws iam create-role \
                                --role-name "${EXECUTION_ROLE_NAME}" \
                                --assume-role-policy-document \
                                file:///tmp/ecs-trust-policy.json

                        fi


                        aws iam attach-role-policy \
                            --role-name "${EXECUTION_ROLE_NAME}" \
                            --policy-arn \
                            arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy \
                            || true


                        EXECUTION_ROLE_ARN=$(aws iam get-role \
                            --role-name "${EXECUTION_ROLE_NAME}" \
                            --query 'Role.Arn' \
                            --output text)


                        if [ -z "${EXECUTION_ROLE_ARN}" ] || \
                           [ "${EXECUTION_ROLE_ARN}" = "None" ]; then

                            echo "ERROR: Could not retrieve ECS execution role ARN."

                            exit 1

                        fi


                        echo "ECS Execution Role:"
                        echo "${EXECUTION_ROLE_ARN}"


                        echo ""
                        echo "IAM role is available."
                    '''
                }
            }
        }


        stage('40 - Create Security Groups') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        def securityGroupIds = sh(
                            script: '''
                                set -e

                                echo "================================================"
                                echo "CREATING SECURITY GROUPS"
                                echo "================================================"


                                ALB_SG_ID=$(aws ec2 describe-security-groups \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --filters \
                                        "Name=vpc-id,Values=${VPC_ID}" \
                                        "Name=group-name,Values=${ALB_SG_NAME}" \
                                    --query 'SecurityGroups[0].GroupId' \
                                    --output text)


                                if [ "${ALB_SG_ID}" = "None" ] || \
                                   [ -z "${ALB_SG_ID}" ]; then

                                    ALB_SG_ID=$(aws ec2 create-security-group \
                                        --region "${AWS_DEFAULT_REGION}" \
                                        --group-name "${ALB_SG_NAME}" \
                                        --description "ALB security group for ${APP_NAME}" \
                                        --vpc-id "${VPC_ID}" \
                                        --query 'GroupId' \
                                        --output text)

                                fi


                                ECS_SG_ID=$(aws ec2 describe-security-groups \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --filters \
                                        "Name=vpc-id,Values=${VPC_ID}" \
                                        "Name=group-name,Values=${ECS_SG_NAME}" \
                                    --query 'SecurityGroups[0].GroupId' \
                                    --output text)


                                if [ "${ECS_SG_ID}" = "None" ] || \
                                   [ -z "${ECS_SG_ID}" ]; then

                                    ECS_SG_ID=$(aws ec2 create-security-group \
                                        --region "${AWS_DEFAULT_REGION}" \
                                        --group-name "${ECS_SG_NAME}" \
                                        --description "ECS Fargate security group for ${APP_NAME}" \
                                        --vpc-id "${VPC_ID}" \
                                        --query 'GroupId' \
                                        --output text)

                                fi


                                echo "ALB SG: ${ALB_SG_ID}"

                                echo "ECS SG: ${ECS_SG_ID}"


                                aws ec2 authorize-security-group-ingress \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --group-id "${ALB_SG_ID}" \
                                    --ip-permissions \
                                    'IpProtocol=tcp,FromPort=80,ToPort=80,IpRanges=[{CidrIp=0.0.0.0/0}]' \
                                    2>/dev/null || true


                                aws ec2 authorize-security-group-ingress \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --group-id "${ECS_SG_ID}" \
                                    --ip-permissions \
                                    "IpProtocol=tcp,FromPort=${CONTAINER_PORT},ToPort=${CONTAINER_PORT},UserIdGroupPairs=[{GroupId=${ALB_SG_ID}}]" \
                                    2>/dev/null || true


                                echo "${ALB_SG_ID}|${ECS_SG_ID}"
                            ''',
                            returnStdout: true
                        ).trim()


                        def ids = securityGroupIds.split("\\|")


                        if (ids.size() != 2) {

                            error(
                                "Could not correctly obtain ALB and ECS security group IDs."
                            )
                        }


                        env.ALB_SG_ID = ids[0].trim()

                        env.ECS_SG_ID = ids[1].trim()


                        if (!env.ALB_SG_ID || !env.ECS_SG_ID) {

                            error(
                                "ALB_SG_ID or ECS_SG_ID is empty."
                            )
                        }


                        echo "ALB SG: ${env.ALB_SG_ID}"

                        echo "ECS SG: ${env.ECS_SG_ID}"

                        echo "Security groups ready."
                    }
                }
            }
        }


        stage('41 - Create Application Load Balancer') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        def albArn = sh(
                            script: '''
                                aws elbv2 describe-load-balancers \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --names "${ALB_NAME}" \
                                    --query 'LoadBalancers[0].LoadBalancerArn' \
                                    --output text \
                                    2>/dev/null || true
                            ''',
                            returnStdout: true
                        ).trim()


                        if (!albArn || albArn == 'None') {

                            albArn = sh(
                                script: '''
                                    aws elbv2 create-load-balancer \
                                        --region "${AWS_DEFAULT_REGION}" \
                                        --name "${ALB_NAME}" \
                                        --subnets "${SUBNET_1}" "${SUBNET_2}" \
                                        --security-groups "${ALB_SG_ID}" \
                                        --scheme internet-facing \
                                        --type application \
                                        --ip-address-type ipv4 \
                                        --query 'LoadBalancers[0].LoadBalancerArn' \
                                        --output text
                                ''',
                                returnStdout: true
                            ).trim()
                        }


                        if (!albArn || albArn == 'None') {

                            error(
                                'Could not create or find the Application Load Balancer.'
                            )
                        }


                        env.ALB_ARN = albArn


                        echo "Waiting for ALB to become available..."


                        sh '''
                            set -e

                            aws elbv2 wait load-balancer-available \
                                --region "${AWS_DEFAULT_REGION}" \
                                --load-balancer-arns "${ALB_ARN}"

                            echo "ALB is available."
                        '''


                        def albDns = sh(
                            script: '''
                                aws elbv2 describe-load-balancers \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --load-balancer-arns "${ALB_ARN}" \
                                    --query 'LoadBalancers[0].DNSName' \
                                    --output text
                            ''',
                            returnStdout: true
                        ).trim()


                        if (!albDns || albDns == 'None') {

                            error(
                                'Could not retrieve ALB DNS name.'
                            )
                        }


                        env.ALB_DNS = albDns


                        echo "ALB ARN : ${env.ALB_ARN}"

                        echo "ALB DNS : ${env.ALB_DNS}"
                    }
                }
            }
        }


        stage('42 - Create Target Group') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        def targetGroupArn = sh(
                            script: '''
                                aws elbv2 describe-target-groups \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --names "${TARGET_GROUP_NAME}" \
                                    --query 'TargetGroups[0].TargetGroupArn' \
                                    --output text \
                                    2>/dev/null || true
                            ''',
                            returnStdout: true
                        ).trim()


                        if (!targetGroupArn || targetGroupArn == 'None') {

                            targetGroupArn = sh(
                                script: '''
                                    aws elbv2 create-target-group \
                                        --region "${AWS_DEFAULT_REGION}" \
                                        --name "${TARGET_GROUP_NAME}" \
                                        --protocol HTTP \
                                        --port "${CONTAINER_PORT}" \
                                        --target-type ip \
                                        --vpc-id "${VPC_ID}" \
                                        --health-check-protocol HTTP \
                                        --health-check-path "/" \
                                        --health-check-port traffic-port \
                                        --matcher HttpCode=200-399 \
                                        --query 'TargetGroups[0].TargetGroupArn' \
                                        --output text
                                ''',
                                returnStdout: true
                            ).trim()
                        }


                        if (!targetGroupArn || targetGroupArn == 'None') {

                            error(
                                'Could not create or find the target group.'
                            )
                        }


                        env.TARGET_GROUP_ARN = targetGroupArn


                        echo "Target Group ARN:"
                        echo "${env.TARGET_GROUP_ARN}"
                    }
                }
            }
        }


        stage('43 - Create ALB Listener') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        LISTENER_ARN=$(aws elbv2 describe-listeners \
                            --region "${AWS_DEFAULT_REGION}" \
                            --load-balancer-arn "${ALB_ARN}" \
                            --query 'Listeners[?Port==`80`].ListenerArn | [0]' \
                            --output text)


                        if [ "${LISTENER_ARN}" = "None" ] || \
                           [ -z "${LISTENER_ARN}" ]; then

                            echo "Creating HTTP listener..."

                            aws elbv2 create-listener \
                                --region "${AWS_DEFAULT_REGION}" \
                                --load-balancer-arn "${ALB_ARN}" \
                                --protocol HTTP \
                                --port 80 \
                                --default-actions \
                                "Type=forward,TargetGroupArn=${TARGET_GROUP_ARN}"

                        else

                            echo "HTTP listener already exists."

                            aws elbv2 modify-listener \
                                --region "${AWS_DEFAULT_REGION}" \
                                --listener-arn "${LISTENER_ARN}" \
                                --default-actions \
                                "Type=forward,TargetGroupArn=${TARGET_GROUP_ARN}"

                        fi
                    '''
                }
            }
        }


        stage('44 - Create ECS Cluster') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "CREATING ECS FARGATE CLUSTER"
                        echo "================================================"

                        CLUSTER_STATUS=$(aws ecs describe-clusters \
                            --region "${AWS_DEFAULT_REGION}" \
                            --clusters "${ECS_CLUSTER}" \
                            --query 'clusters[0].status' \
                            --output text \
                            2>/dev/null || true)


                        if [ "${CLUSTER_STATUS}" = "ACTIVE" ]; then

                            echo "ECS cluster already exists."

                        else

                            aws ecs create-cluster \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster-name "${ECS_CLUSTER}"

                        fi


                        STATUS=$(aws ecs describe-clusters \
                            --region "${AWS_DEFAULT_REGION}" \
                            --clusters "${ECS_CLUSTER}" \
                            --query 'clusters[0].status' \
                            --output text)


                        if [ "${STATUS}" != "ACTIVE" ]; then

                            echo "ERROR: ECS cluster is not ACTIVE."

                            exit 1

                        fi


                        echo "ECS cluster is ACTIVE."
                    '''
                }
            }
        }


        stage('45 - Register ECS Fargate Task Definition') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        def taskDefinitionArn = sh(
                            script: '''
                                set -e

                                EXECUTION_ROLE_ARN=$(aws iam get-role \
                                    --role-name "practice1-ecsTaskExecutionRole" \
                                    --query 'Role.Arn' \
                                    --output text)


                                if [ -z "${EXECUTION_ROLE_ARN}" ] || \
                                   [ "${EXECUTION_ROLE_ARN}" = "None" ]; then

                                    echo "ERROR: ECS execution role ARN not found."

                                    exit 1

                                fi


                                cat > task-definition.json <<EOF
{
    "family": "${ECS_TASK_FAMILY}",
    "networkMode": "awsvpc",
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "${FARGATE_CPU}",
    "memory": "${FARGATE_MEMORY}",
    "executionRoleArn": "${EXECUTION_ROLE_ARN}",
    "containerDefinitions": [
        {
            "name": "${ECS_CONTAINER_NAME}",
            "image": "${ECR_IMAGE}",
            "essential": true,
            "portMappings": [
                {
                    "containerPort": ${CONTAINER_PORT},
                    "hostPort": ${CONTAINER_PORT},
                    "protocol": "tcp"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/${ECS_TASK_FAMILY}",
                    "awslogs-region": "${AWS_DEFAULT_REGION}",
                    "awslogs-stream-prefix": "ecs"
                }
            }
        }
    ]
}
EOF


                                echo "Task definition JSON:"
                                cat task-definition.json


                                aws logs create-log-group \
                                    --log-group-name "/ecs/${ECS_TASK_FAMILY}" \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    2>/dev/null || true


                                aws ecs register-task-definition \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --cli-input-json file://task-definition.json \
                                    --query 'taskDefinition.taskDefinitionArn' \
                                    --output text
                            ''',
                            returnStdout: true
                        ).trim()


                        if (!taskDefinitionArn ||
                            taskDefinitionArn == 'None') {

                            error(
                                'Could not register ECS Fargate task definition.'
                            )
                        }


                        env.TASK_DEFINITION_ARN = taskDefinitionArn


                        echo "Task Definition:"
                        echo "${env.TASK_DEFINITION_ARN}"
                    }
                }
            }
        }


        stage('46 - Create or Update ECS Fargate Service') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "DEPLOYING ECS FARGATE SERVICE"
                        echo "================================================"

                        SERVICE_STATUS=$(aws ecs describe-services \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}" \
                            --query 'services[0].status' \
                            --output text \
                            2>/dev/null || true)


                        if [ "${SERVICE_STATUS}" = "ACTIVE" ]; then

                            echo "Updating ECS service..."

                            aws ecs update-service \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --service "${ECS_SERVICE}" \
                                --task-definition "${TASK_DEFINITION_ARN}" \
                                --desired-count 1 \
                                --force-new-deployment

                        else

                            echo "Creating ECS service..."

                            aws ecs create-service \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --service-name "${ECS_SERVICE}" \
                                --task-definition "${TASK_DEFINITION_ARN}" \
                                --desired-count 1 \
                                --launch-type FARGATE \
                                --platform-version LATEST \
                                --network-configuration \
                                "awsvpcConfiguration={subnets=[${SUBNET_1},${SUBNET_2}],securityGroups=[${ECS_SG_ID}],assignPublicIp=ENABLED}" \
                                --load-balancers \
                                "targetGroupArn=${TARGET_GROUP_ARN},containerName=${ECS_CONTAINER_NAME},containerPort=${CONTAINER_PORT}"

                        fi


                        echo ""
                        echo "Waiting for ECS service deployment..."


                        aws ecs wait services-stable \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}"


                        echo ""
                        echo "ECS service deployment completed."
                    '''
                }
            }
        }


        stage('47 - Verify ECS Running Task') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "VERIFYING ECS FARGATE TASK"
                        echo "================================================"


                        RUNNING_COUNT=$(aws ecs describe-services \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}" \
                            --query 'services[0].runningCount' \
                            --output text)


                        DESIRED_COUNT=$(aws ecs describe-services \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}" \
                            --query 'services[0].desiredCount' \
                            --output text)


                        echo "Desired tasks : ${DESIRED_COUNT}"

                        echo "Running tasks : ${RUNNING_COUNT}"


                        if [ "${RUNNING_COUNT}" -lt 1 ]; then

                            echo "ERROR: No running Fargate task."

                            exit 1

                        fi


                        TASK_ARN=$(aws ecs list-tasks \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --service-name "${ECS_SERVICE}" \
                            --desired-status RUNNING \
                            --query 'taskArns[0]' \
                            --output text)


                        if [ -z "${TASK_ARN}" ] || \
                           [ "${TASK_ARN}" = "None" ]; then

                            echo "ERROR: Could not find running ECS task."

                            exit 1

                        fi


                        echo ""
                        echo "Running Task:"
                        echo "${TASK_ARN}"


                        aws ecs describe-tasks \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --tasks "${TASK_ARN}" \
                            --query 'tasks[0].{TaskArn:taskArn,LastStatus:lastStatus}' \
                            --output table
                    '''
                }
            }
        }


        stage('48 - Verify ALB DNS') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        def albDns = sh(
                            script: '''
                                aws elbv2 describe-load-balancers \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --load-balancer-arns "${ALB_ARN}" \
                                    --query 'LoadBalancers[0].DNSName' \
                                    --output text
                            ''',
                            returnStdout: true
                        ).trim()


                        if (!albDns || albDns == 'None') {

                            error(
                                'Could not retrieve ALB DNS name.'
                            )
                        }


                        env.ALB_DNS = albDns

                        env.APPLICATION_URL =
                            "http://${albDns}"


                        echo ""
                        echo "================================================"
                        echo "APPLICATION DEPLOYMENT URL"
                        echo "================================================"

                        echo "${env.APPLICATION_URL}"
                    }
                }
            }
        }


        stage('49 - Final Deployment Verification') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo ""
                        echo "================================================"
                        echo "        FINAL DEPLOYMENT VERIFICATION"
                        echo "================================================"


                        echo ""
                        echo "AWS Region:"
                        echo "${AWS_DEFAULT_REGION}"


                        echo ""
                        echo "Terraform State Bucket:"
                        echo "${TF_STATE_BUCKET}"


                        echo ""
                        echo "Terraform State Key:"
                        echo "${TF_STATE_KEY}"


                        echo ""
                        echo "Terraform Lock Table:"
                        echo "${TF_LOCK_TABLE}"


                        echo ""
                        echo "ECR Image URI:"
                        echo "${ECR_IMAGE}"


                        echo ""
                        echo "ECS Cluster:"
                        echo "${ECS_CLUSTER}"


                        echo ""
                        echo "ECS Service:"
                        echo "${ECS_SERVICE}"


                        echo ""
                        echo "Task Definition:"
                        echo "${TASK_DEFINITION_ARN}"


                        echo ""
                        echo "ALB:"
                        echo "${ALB_NAME}"


                        echo ""
                        echo "ALB DNS:"
                        echo "${ALB_DNS}"


                        echo ""
                        echo "================================================"
                        echo "          APPLICATION URL"
                        echo "================================================"


                        echo "${APPLICATION_URL}"


                        echo ""
                        echo "================================================"
                        echo "       PART 6 DEPLOYMENT COMPLETE"
                        echo "================================================"
                    '''
                }
            }
        }
    }


    // ================================================================
    // POST ACTIONS
    // ================================================================

    post {

        success {

            echo ''

            echo '================================================'

            echo '       COMPLETE CI/CD PIPELINE SUCCESS'

            echo '================================================'


            echo ''

            echo 'PART 1 - CODE QUALITY : PASSED'

            echo 'PART 2 - TESTING      : PASSED'

            echo 'PART 3 - DOCKER       : PASSED'

            echo 'PART 4 - ECR          : PASSED'

            echo 'PART 5 - TERRAFORM    : PASSED'

            echo 'PART 6 - ECS FARGATE  : PASSED'

            echo 'PART 6 - ALB          : PASSED'


            echo ''

            echo '================================================'

            echo '          TERRAFORM BACKEND'

            echo '================================================'


            echo ''

            echo "S3 Bucket     : ${env.TF_STATE_BUCKET}"

            echo "S3 State Key  : ${env.TF_STATE_KEY}"

            echo "DynamoDB Table: ${env.TF_LOCK_TABLE}"


            echo ''

            echo '================================================'

            echo '          FINAL APPLICATION URL'

            echo '================================================'


            echo "${env.APPLICATION_URL}"


            echo ''

            echo '================================================'

            echo '          DEPLOYMENT COMPLETE'

            echo '================================================'
        }


        failure {

            echo ''

            echo '================================================'

            echo '          CI/CD PIPELINE FAILED'

            echo '================================================'


            echo ''

            echo 'The pipeline stopped because a deployment stage failed.'


            echo ''

            echo 'Check the Jenkins console output above.'


            echo ''

            echo '================================================'
        }


        always {

            echo ''

            echo '================================================'

            echo 'CLEANING JENKINS WORKSPACE'

            echo '================================================'


            cleanWs(
                deleteDirs: true,
                disableDeferredWipeout: true
            )
        }
    }
}
