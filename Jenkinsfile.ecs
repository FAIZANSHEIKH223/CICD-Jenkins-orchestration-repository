pipeline {

    agent any

    options {
        timestamps()
        ansiColor('xterm')
        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                daysToKeepStr: '30',
                numToKeepStr: '50'
            )
        )

        timeout(
            time: 90,
            unit: 'MINUTES'
        )
    }

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: [
                'dev',
                'qa',
                'prod'
            ],
            description: 'Select Terraform Environment'
        )

        booleanParam(
            name: 'AUTO_APPLY',
            defaultValue: false,
            description: 'Automatically Apply Terraform without manual approval'
        )
    }

    environment {

        //==========================================================
        // AWS
        //==========================================================

        AWS_REGION = 'us-east-1'
        AWS_DEFAULT_REGION = 'us-east-1'
        AWS_ACCOUNT_ID = '103282536465'

        AWS_CREDENTIALS = 'aws-creds'

        //==========================================================
        // GitHub
        //==========================================================

        GITHUB_CREDENTIALS = 'github-creds'

        TERRAFORM_REPO = 'https://github.com/FAIZANSHEIKH223/terraform-aws-infra.git'
        APP_REPO = 'https://github.com/FAIZANSHEIKH223/practice1.git'

        TERRAFORM_BRANCH = 'main'
        APP_BRANCH = 'main'

        //==========================================================
        // Docker / ECR
        //==========================================================

        IMAGE_NAME = 'terraform-demo-dev'
        IMAGE_TAG = "${BUILD_NUMBER}"

        ECR_URI = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"

        //==========================================================
        // ECS
        //==========================================================

        ECS_CLUSTER_NAME = 'terraform-demo-dev-cluster'
        ECS_TASK_FAMILY = 'terraform-demo-task'
        ECS_SERVICE_NAME = 'terraform-demo-service'

        APP_HEALTH_URL = 'http://terraform-demo-dev-alb-466450201.us-east-1.elb.amazonaws.com'

        //==========================================================
        // Terraform
        //==========================================================

        TF_DIR = 'terraform-aws-infra'
    }

    stages {

        //==========================================================
        // Pipeline Tools Check
        //==========================================================

        stage('Check Required Tools') {

            steps {

                sh '''
                    set -e

                    echo "=========================================="
                    echo "Checking Required Tools"
                    echo "=========================================="

                    echo ""
                    echo "Terraform:"
                    terraform version

                    echo ""
                    echo "AWS CLI:"
                    aws --version

                    echo ""
                    echo "Docker:"
                    docker --version

                    echo ""
                    echo "Python:"
                    python3.12 --version

                    echo ""
                    echo "JQ:"
                    jq --version

                    echo ""
                    echo "Curl:"
                    curl --version | head -n 1

                    echo ""
                    echo "=========================================="
                    echo "All Required Tools Found"
                    echo "=========================================="
                '''
            }
        }

        //==========================================================
        // Checkout Terraform Repository
        //==========================================================

        stage('Checkout Terraform Repository') {

            steps {

                dir("${TF_DIR}") {

                    deleteDir()

                    git(
                        branch: "${TERRAFORM_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${TERRAFORM_REPO}"
                    )
                }
            }
        }

        //==========================================================
        // Terraform Format
        //==========================================================

        stage('Terraform Format') {

            steps {

                dir("${TF_DIR}") {

                    sh '''
                        set -e

                        echo "Running Terraform format check..."

                        terraform fmt -check -recursive
                    '''
                }
            }
        }

        //==========================================================
        // Create Terraform Backend
        //==========================================================

        stage('Create Terraform Backend') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -e

                        BUCKET="terraform-state-faizan-001"
                        TABLE="terraform-locks"
                        REGION="${AWS_REGION}"

                        echo "=========================================="
                        echo "Checking Terraform Backend Resources"
                        echo "=========================================="

                        #==================================================
                        # S3 Bucket
                        #==================================================

                        if aws s3api head-bucket \
                            --bucket "$BUCKET" \
                            --region "$REGION" \
                            >/dev/null 2>&1
                        then

                            echo "S3 bucket already exists: $BUCKET"

                        else

                            echo "Creating S3 bucket: $BUCKET"

                            aws s3 mb \
                                "s3://${BUCKET}" \
                                --region "$REGION"

                            aws s3api put-bucket-versioning \
                                --bucket "$BUCKET" \
                                --versioning-configuration Status=Enabled \
                                --region "$REGION"

                            echo "S3 bucket created."

                        fi

                        #==================================================
                        # DynamoDB Lock Table
                        #==================================================

                        if aws dynamodb describe-table \
                            --table-name "$TABLE" \
                            --region "$REGION" \
                            >/dev/null 2>&1
                        then

                            echo "DynamoDB table already exists: $TABLE"

                        else

                            echo "Creating DynamoDB table: $TABLE"

                            aws dynamodb create-table \
                                --table-name "$TABLE" \
                                --attribute-definitions AttributeName=LockID,AttributeType=S \
                                --key-schema AttributeName=LockID,KeyType=HASH \
                                --billing-mode PAY_PER_REQUEST \
                                --region "$REGION"

                            echo "Waiting for DynamoDB table..."

                            aws dynamodb wait table-exists \
                                --table-name "$TABLE" \
                                --region "$REGION"

                            echo "DynamoDB table created."

                        fi

                        echo "=========================================="
                        echo "Terraform Backend Ready"
                        echo "=========================================="
                    '''
                }
            }
        }

        //==========================================================
        // Terraform Init
        //==========================================================

        stage('Terraform Init') {

            steps {

                dir("${TF_DIR}") {

                    withCredentials([
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${AWS_CREDENTIALS}"
                        ]
                    ]) {

                        sh '''
                            set -e

                            BACKEND_CONFIG="backend-${ENVIRONMENT}.conf"

                            if [ ! -f "$BACKEND_CONFIG" ]; then
                                echo "ERROR: Backend configuration file not found:"
                                echo "$BACKEND_CONFIG"
                                exit 1
                            fi

                            echo "Using backend configuration:"
                            echo "$BACKEND_CONFIG"

                            terraform init \
                                -reconfigure \
                                -backend-config="$BACKEND_CONFIG"
                        '''
                    }
                }
            }
        }

        //==========================================================
        // Terraform Validate
        //==========================================================

        stage('Terraform Validate') {

            steps {

                dir("${TF_DIR}") {

                    sh '''
                        set -e

                        terraform validate
                    '''
                }
            }
        }

        //==========================================================
        // Terraform Plan
        //==========================================================

        stage('Terraform Plan') {

            steps {

                dir("${TF_DIR}") {

                    withCredentials([
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${AWS_CREDENTIALS}"
                        ]
                    ]) {

                        sh '''
                            set -e

                            TF_VARS="environments/${ENVIRONMENT}/terraform.tfvars"

                            if [ ! -f "$TF_VARS" ]; then
                                echo "ERROR: Terraform variables file not found:"
                                echo "$TF_VARS"
                                exit 1
                            fi

                            echo "=========================================="
                            echo "Terraform Plan"
                            echo "Environment: ${ENVIRONMENT}"
                            echo "Variables: ${TF_VARS}"
                            echo "=========================================="

                            terraform plan \
                                -var-file="$TF_VARS" \
                                -out=tfplan
                        '''
                    }
                }
            }
        }

        //==========================================================
        // Terraform Approval
        //==========================================================

        stage('Terraform Approval') {

            when {

                expression {
                    return params.AUTO_APPLY == false
                }
            }

            steps {

                input(
                    message: "Apply Terraform infrastructure for ${params.ENVIRONMENT}?",
                    ok: "Deploy"
                )
            }
        }

        //==========================================================
        // Terraform Apply
        //==========================================================

        stage('Terraform Apply') {

            steps {

                dir("${TF_DIR}") {

                    withCredentials([
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${AWS_CREDENTIALS}"
                        ]
                    ]) {

                        sh '''
                            set -e

                            if [ ! -f tfplan ]; then
                                echo "ERROR: tfplan was not created."
                                exit 1
                            fi

                            terraform apply \
                                -auto-approve \
                                tfplan
                        '''
                    }
                }
            }
        }

        //==========================================================
        // Wait for Infrastructure
        //==========================================================

        stage('Wait For Infrastructure') {

            steps {

                echo 'Waiting for AWS resources to become ready...'

                sleep(
                    time: 90,
                    unit: 'SECONDS'
                )
            }
        }

        //==========================================================
        // Checkout Application Repository
        //==========================================================

        stage('Checkout Application Repository') {

            steps {

                dir('practice1') {

                    deleteDir()

                    git(
                        branch: "${APP_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${APP_REPO}"
                    )
                }
            }
        }

        //==========================================================
        // Python Version
        //==========================================================

        stage('Python Version') {

            steps {

                sh '''
                    set -e

                    python3.12 --version
                    python3.12 -m pip --version
                '''
            }
        }

        //==========================================================
        // Create Python Virtual Environment
        //==========================================================

        stage('Create Virtual Environment') {

            steps {

                dir('practice1') {

                    sh '''
                        set -e

                        rm -rf venv

                        python3.12 -m venv venv

                        . venv/bin/activate

                        python --version
                        pip --version
                    '''
                }
            }
        }

        //==========================================================
        // Install Dependencies
        //==========================================================

        stage('Install Dependencies') {

            steps {

                dir('practice1') {

                    sh '''
                        set -e

                        . venv/bin/activate

                        python -m pip install --upgrade pip

                        if [ -f requirements.txt ]; then

                            echo "Installing application requirements..."

                            pip install -r requirements.txt

                        else

                            echo "requirements.txt not found."

                        fi

                        echo "Installing CI/CD tools..."

                        pip install \
                            pytest \
                            pytest-html \
                            pylint \
                            flake8 \
                            coverage
                    '''
                }
            }
        }

        //==========================================================
        // Run Unit Tests
        //==========================================================

        stage('Run Pytest') {

            steps {

                dir('practice1') {

                    sh '''
                        set -e

                        . venv/bin/activate

                        mkdir -p reports

                        pytest \
                            --html=reports/pytest-report.html \
                            --self-contained-html \
                            --junitxml=reports/pytest.xml
                    '''
                }
            }
        }

        //==========================================================
        // Publish Test Results
        //==========================================================

        stage('Publish Test Report') {

            steps {

                junit(
                    allowEmptyResults: true,
                    testResults: 'practice1/reports/pytest.xml'
                )

                publishHTML(
                    target: [
                        allowMissing: true,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: 'practice1/reports',
                        reportFiles: 'pytest-report.html',
                        reportName: 'Pytest HTML Report'
                    ]
                )
            }
        }

        //==========================================================
        // Run Coverage
        //==========================================================

        stage('Coverage') {

            steps {

                dir('practice1') {

                    sh '''
                        set -e

                        . venv/bin/activate

                        coverage run -m pytest

                        coverage xml

                        coverage report
                    '''
                }
            }
        }

        //==========================================================
        // Run Pylint
        //==========================================================

        stage('Pylint') {

            steps {

                dir('practice1') {

                    sh '''
                        set +e

                        . venv/bin/activate

                        pylint \
                            --output-format=text \
                            --ignore=venv \
                            --ignore=tests \
                            *.py \
                            > pylint-report.txt

                        PYLINT_EXIT=$?

                        echo "Pylint exit code: $PYLINT_EXIT"

                        exit 0
                    '''
                }
            }
        }

        //==========================================================
        // Run Flake8
        //==========================================================

        stage('Flake8') {

            steps {

                dir('practice1') {

                    sh '''
                        set +e

                        . venv/bin/activate

                        flake8 . \
                            --exclude=venv,.git,reports,__pycache__ \
                            --statistics \
                            --count \
                            --tee \
                            --output-file=flake8-report.txt

                        FLAKE8_EXIT=$?

                        echo "Flake8 exit code: $FLAKE8_EXIT"

                        exit 0
                    '''
                }
            }
        }

        //==========================================================
        // Archive Reports
        //==========================================================

        stage('Archive Reports') {

            steps {

                archiveArtifacts(
                    artifacts: '''
                        practice1/pylint-report.txt,
                        practice1/flake8-report.txt,
                        practice1/coverage.xml
                    ''',
                    allowEmptyArchive: true,
                    fingerprint: true
                )
            }
        }

        //==========================================================
        // Check ECR Repository
        //==========================================================

        stage('Prepare ECR Repository') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -e

                        echo "Checking ECR repository..."

                        if aws ecr describe-repositories \
                            --repository-names "${IMAGE_NAME}" \
                            --region "${AWS_REGION}" \
                            >/dev/null 2>&1
                        then

                            echo "ECR repository already exists."

                        else

                            echo "ECR repository does not exist."
                            echo "Creating ECR repository..."

                            aws ecr create-repository \
                                --repository-name "${IMAGE_NAME}" \
                                --region "${AWS_REGION}"

                            echo "ECR repository created."

                        fi
                    '''
                }
            }
        }

        //==========================================================
        // Docker Build
        //==========================================================

        stage('Docker Build') {

            steps {

                dir('practice1') {

                    sh '''
                        set -e

                        echo "Building Docker image..."

                        docker build \
                            -t "${IMAGE_NAME}:${IMAGE_TAG}" .

                        docker tag \
                            "${IMAGE_NAME}:${IMAGE_TAG}" \
                            "${ECR_URI}/${IMAGE_NAME}:${IMAGE_TAG}"

                        docker tag \
                            "${IMAGE_NAME}:${IMAGE_TAG}" \
                            "${ECR_URI}/${IMAGE_NAME}:latest"

                        echo "Docker image built successfully."
                    '''
                }
            }
        }

        //==========================================================
        // Login to Amazon ECR
        //==========================================================

        stage('Login to Amazon ECR') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -e

                        aws ecr get-login-password \
                            --region "${AWS_REGION}" | \
                        docker login \
                            --username AWS \
                            --password-stdin \
                            "${ECR_URI}"
                    '''
                }
            }
        }

        //==========================================================
        // Push Docker Image
        //==========================================================

        stage('Push Docker Image') {

            steps {

                sh '''
                    set -e

                    docker push \
                        "${ECR_URI}/${IMAGE_NAME}:${IMAGE_TAG}"

                    docker push \
                        "${ECR_URI}/${IMAGE_NAME}:latest"
                '''
            }
        }

        //==========================================================
        // Verify ECR Repository
        //==========================================================

        stage('Verify ECR Repository') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -e

                        aws ecr describe-repositories \
                            --repository-names "${IMAGE_NAME}" \
                            --region "${AWS_REGION}"

                        echo "ECR repository verified."
                    '''
                }
            }
        }

        //==========================================================
        // Docker Cleanup
        //==========================================================

        stage('Docker Cleanup') {

            steps {

                sh '''
                    docker rmi \
                        "${IMAGE_NAME}:${IMAGE_TAG}" \
                        || true

                    docker rmi \
                        "${ECR_URI}/${IMAGE_NAME}:${IMAGE_TAG}" \
                        || true

                    docker rmi \
                        "${ECR_URI}/${IMAGE_NAME}:latest" \
                        || true
                '''
            }
        }

        //==========================================================
        // Verify ECS Cluster
        //==========================================================

        stage('Verify ECS Cluster') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -e

                        aws ecs describe-clusters \
                            --clusters "${ECS_CLUSTER_NAME}" \
                            --region "${AWS_REGION}"

                        echo "ECS cluster verified."
                    '''
                }
            }
        }

        //==========================================================
        // Get Current Task Definition
        //==========================================================

        stage('Get Task Definition') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -e

                        aws ecs describe-task-definition \
                            --task-definition "${ECS_TASK_FAMILY}" \
                            --region "${AWS_REGION}" \
                            --query taskDefinition \
                            --output json \
                            > task-definition.json

                        test -s task-definition.json

                        echo "Current ECS task definition downloaded."
                    '''
                }
            }
        }

        //==========================================================
        // Create New Task Definition
        //==========================================================

        stage('Register New Task Definition') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -e

                        echo "Updating container image..."

                        jq \
                            --arg IMAGE "${ECR_URI}/${IMAGE_NAME}:${IMAGE_TAG}" \
                            '
                            del(
                                .taskDefinitionArn,
                                .revision,
                                .status,
                                .requiresAttributes,
                                .compatibilities,
                                .registeredBy,
                                .registeredAt
                            )
                            |
                            .containerDefinitions[0].image = $IMAGE
                            ' \
                            task-definition.json \
                            > new-task.json

                        echo "Registering new ECS task definition..."

                        aws ecs register-task-definition \
                            --cli-input-json file://new-task.json \
                            --region "${AWS_REGION}"

                        echo "New ECS task definition registered."
                    '''
                }
            }
        }

        //==========================================================
        // Get Latest Revision
        //==========================================================

        stage('Get Latest Revision') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    script {

                        env.NEW_REVISION = sh(
                            script: '''
                                aws ecs describe-task-definition \
                                    --task-definition "${ECS_TASK_FAMILY}" \
                                    --region "${AWS_REGION}" \
                                    --query taskDefinition.revision \
                                    --output text
                            ''',
                            returnStdout: true
                        ).trim()

                        echo "New ECS revision: ${env.NEW_REVISION}"
                    }
                }
            }
        }

        //==========================================================
        // Deploy ECS Service
        //==========================================================

        stage('Deploy ECS Service') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -e

                        echo "Deploying ECS service..."

                        aws ecs update-service \
                            --cluster "${ECS_CLUSTER_NAME}" \
                            --service "${ECS_SERVICE_NAME}" \
                            --task-definition "${ECS_TASK_FAMILY}:${NEW_REVISION}" \
                            --force-new-deployment \
                            --region "${AWS_REGION}"

                        echo "ECS deployment started."
                    '''
                }
            }
        }

        //==========================================================
        // Wait For ECS Deployment
        //==========================================================

        stage('Wait For ECS Deployment') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -e

                        echo "Waiting for ECS service to become stable..."

                        aws ecs wait services-stable \
                            --cluster "${ECS_CLUSTER_NAME}" \
                            --services "${ECS_SERVICE_NAME}" \
                            --region "${AWS_REGION}"

                        echo "ECS service is stable."
                    '''
                }
            }
        }

        //==========================================================
        // Health Check
        //==========================================================

        stage('Health Check') {

            steps {

                sh '''
                    set -e

                    echo "Checking application health..."

                    curl \
                        --retry 15 \
                        --retry-delay 10 \
                        --retry-connrefused \
                        --fail \
                        --show-error \
                        --silent \
                        "${APP_HEALTH_URL}"

                    echo ""
                    echo "Application health check passed."
                '''
            }
        }

        //==========================================================
        // Deployment Successful
        //==========================================================

        stage('Deployment Successful') {

            steps {

                echo '=========================================='
                echo 'Application Successfully Deployed'
                echo '=========================================='
                echo "Environment: ${params.ENVIRONMENT}"
                echo "Docker Image: ${IMAGE_NAME}:${IMAGE_TAG}"
                echo "ECS Cluster: ${ECS_CLUSTER_NAME}"
                echo "ECS Service: ${ECS_SERVICE_NAME}"
                echo "Health URL: ${APP_HEALTH_URL}"
                echo '=========================================='
            }
        }
    }

    //==============================================================
    // POST ACTIONS
    //==============================================================

    post {

        always {

            echo 'Cleaning Jenkins workspace...'

            cleanWs()
        }

        success {

            echo '=========================================='
            echo 'Pipeline Completed Successfully'
            echo '=========================================='
        }

        failure {

            echo '=========================================='
            echo 'Pipeline Failed'
            echo '=========================================='
        }

        unstable {

            echo '=========================================='
            echo 'Pipeline Unstable'
            echo '=========================================='
        }
    }
}
