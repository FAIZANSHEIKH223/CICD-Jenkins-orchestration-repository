pipeline {

    agent any

    options {
        timestamps()
        ansiColor('xterm')
        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                daysToKeepStr: '30',
                numToKeepStr: '50'
            )
        )

        timeout(
            time: 30,
            unit: 'MINUTES'
        )
    }

    environment {

        // ============================================================
        // GitHub
        // ============================================================

        APP_REPO = 'https://github.com/FAIZANSHEIKH223/practice2.git'
        APP_BRANCH = 'main'

        // Jenkins GitHub credential
        GITHUB_CREDENTIALS = 'github-creds'

        // ============================================================
        // Python
        // ============================================================

        PYTHON = 'python3.12'

        APP_DIR = 'practice2'

        VENV_DIR = 'venv'

        // ============================================================
        // Reports
        // ============================================================

        REPORT_DIR = 'reports'

    }

    stages {

        // ============================================================
        // 1. Checkout Application
        // ============================================================

        stage('Checkout Application') {

            steps {

                echo '=============================================='
                echo 'CHECKOUT APPLICATION'
                echo '=============================================='

                dir("${APP_DIR}") {

                    git(
                        branch: "${APP_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${APP_REPO}"
                    )

                }

            }

        }


        // ============================================================
        // 2. Verify Python
        // ============================================================

        stage('Verify Python Environment') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "=============================================="
                        echo "PYTHON VERSION"
                        echo "=============================================="

                        python3.12 --version

                        echo "=============================================="
                        echo "PIP VERSION"
                        echo "=============================================="

                        python3.12 -m pip --version
                    '''

                }

            }

        }


        // ============================================================
        // 3. Create Virtual Environment
        // ============================================================

        stage('Create Python Virtual Environment') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "=============================================="
                        echo "CREATING PYTHON VIRTUAL ENVIRONMENT"
                        echo "=============================================="

                        rm -rf "${VENV_DIR}"

                        ${PYTHON} -m venv "${VENV_DIR}"

                        echo "Virtual environment created successfully."

                        "${VENV_DIR}/bin/python" --version
                    '''

                }

            }

        }


        // ============================================================
        // 4. Install Dependencies
        // ============================================================

        stage('Install Python Dependencies') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "=============================================="
                        echo "INSTALLING PYTHON DEPENDENCIES"
                        echo "=============================================="

                        "${VENV_DIR}/bin/python" -m pip install --upgrade pip

                        if [ -f requirements.txt ]; then

                            echo "requirements.txt found."

                            "${VENV_DIR}/bin/pip" install -r requirements.txt

                        else

                            echo "requirements.txt not found."
                            echo "Continuing with CI tools."

                        fi

                        echo "Installing CI tools..."

                        "${VENV_DIR}/bin/pip" install \
                            flake8 \
                            pylint \
                            pytest \
                            pytest-html

                        echo "=============================================="
                        echo "DEPENDENCIES INSTALLED"
                        echo "=============================================="
                    '''

                }

            }

        }


        // ============================================================
        // 5. Flake8
        // ============================================================

        stage('Flake8 Code Quality') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "=============================================="
                        echo "RUNNING FLAKE8"
                        echo "=============================================="

                        mkdir -p "${REPORT_DIR}"

                        "${VENV_DIR}/bin/flake8" \
                            . \
                            --exclude="${VENV_DIR},.git,${REPORT_DIR},__pycache__" \
                            --count \
                            --statistics \
                            --tee \
                            --output-file="${REPORT_DIR}/flake8-report.txt"

                        echo "=============================================="
                        echo "FLAKE8 PASSED"
                        echo "=============================================="
                    '''

                }

            }

        }


        // ============================================================
        // 6. Pylint
        // ============================================================

        stage('Pylint Code Quality') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "=============================================="
                        echo "RUNNING PYLINT"
                        echo "=============================================="

                        mkdir -p "${REPORT_DIR}"

                        "${VENV_DIR}/bin/pylint" \
                            . \
                            --output-format=text \
                            > "${REPORT_DIR}/pylint-report.txt"

                        echo "=============================================="
                        echo "PYLINT PASSED"
                        echo "=============================================="
                    '''

                }

            }

        }


        // ============================================================
        // 7. Run Unit Tests
        // ============================================================

        stage('Run Unit Tests') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "=============================================="
                        echo "RUNNING PYTEST"
                        echo "=============================================="

                        mkdir -p "${REPORT_DIR}"

                        "${VENV_DIR}/bin/pytest" \
                            --html="${REPORT_DIR}/pytest-report.html" \
                            --self-contained-html \
                            --junitxml="${REPORT_DIR}/pytest.xml"

                        echo "=============================================="
                        echo "PYTEST PASSED"
                        echo "=============================================="
                    '''

                }

            }

        }


        // ============================================================
        // 8. Publish Test Results
        // ============================================================

        stage('Publish Test Results') {

            steps {

                junit(
                    allowEmptyResults: false,
                    testResults: "${APP_DIR}/${REPORT_DIR}/pytest.xml"
                )

            }

        }


        // ============================================================
        // 9. Archive Quality Reports
        // ============================================================

        stage('Archive Quality Reports') {

            steps {

                archiveArtifacts(
                    artifacts: "${APP_DIR}/${REPORT_DIR}/flake8-report.txt," +
                               "${APP_DIR}/${REPORT_DIR}/pylint-report.txt," +
                               "${APP_DIR}/${REPORT_DIR}/pytest-report.html",
                    allowEmptyArchive: false,
                    fingerprint: true
                )

            }

        }


        // ============================================================
        // 10. CI Passed
        // ============================================================

        stage('Part 1 CI Passed') {

            steps {

                echo ''
                echo '================================================'
                echo '        PART 1 CI PIPELINE PASSED'
                echo '================================================'
                echo ''
                echo 'GitHub Checkout       : PASSED'
                echo 'Python Environment    : PASSED'
                echo 'Dependencies          : PASSED'
                echo 'Flake8                : PASSED'
                echo 'Pylint                : PASSED'
                echo 'Pytest                : PASSED'
                echo 'Reports               : ARCHIVED'
                echo ''
                echo 'Ready for Part 2.'
                echo '================================================'

            }

        }

    }


    // ================================================================
    // POST ACTIONS
    // ================================================================

    post {

        success {

            echo ''
            echo '================================================'
            echo '       JENKINS PIPELINE SUCCESS'
            echo '================================================'
            echo ''
            echo 'Part 1 CI completed successfully.'
            echo '================================================'

        }

        failure {

            echo ''
            echo '================================================'
            echo '        JENKINS PIPELINE FAILED'
            echo '================================================'
            echo ''
            echo 'Check the failed stage above.'
            echo '================================================'

        }

        always {

            echo ''
            echo 'Cleaning Jenkins workspace...'

            cleanWs(
                deleteDirs: true,
                disableDeferredWipeout: true
            )

        }

    }

}
