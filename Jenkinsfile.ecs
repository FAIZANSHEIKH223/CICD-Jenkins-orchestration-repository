pipeline {

    agent any

    options {
        timestamps()
        ansiColor('xterm')
        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                daysToKeepStr: '30',
                numToKeepStr: '50'
            )
        )

        timeout(
            time: 120,
            unit: 'MINUTES'
        )
    }

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: [
                'dev',
                'qa',
                'prod'
            ],
            description: 'Select Terraform environment'
        )

        choice(
            name: 'ACTION',
            choices: [
                'DEPLOY',
                'DESTROY'
            ],
            description: 'Select infrastructure action'
        )
    }

    environment {

        AWS_DEFAULT_REGION = 'us-east-1'

        /*
         * ============================================================
         * FOUR GITHUB REPOSITORIES
         * ============================================================
         */

        TERRAFORM_REPO =
            'https://github.com/FAIZANSHEIKH223/terraform-aws-infra.git'

        APPLICATION_REPO =
            'https://github.com/FAIZANSHEIKH223/practice1.git'

        QUALITY_REPO =
            'https://github.com/FAIZANSHEIKH223/pylint_flake8_int_jenkins.git'

        ORCHESTRATION_REPO =
            'https://github.com/FAIZANSHEIKH223/CICD-Jenkins-orchestration-repository.git'


        /*
         * ============================================================
         * JENKINS CREDENTIALS
         * ============================================================
         */

        GITHUB_CREDENTIALS = 'github-creds'

        AWS_CREDENTIALS = 'aws-creds'


        /*
         * ============================================================
         * WORKSPACE DIRECTORIES
         * ============================================================
         */

        TERRAFORM_DIR = 'terraform-aws-infra'

        APPLICATION_DIR = 'application'

        QUALITY_DIR = 'quality-tools'

        ORCHESTRATION_DIR = 'orchestration'


        /*
         * ============================================================
         * APPLICATION
         * ============================================================
         */

        PROJECT_NAME = 'terraform-demo'


        /*
         * ============================================================
         * ECR
         * ============================================================
         */

        ECR_REPOSITORY = 'terraform-demo-dev'


        /*
         * ============================================================
         * ECS
         * ============================================================
         */

        ECS_CLUSTER = 'terraform-demo-dev-cluster'

        ECS_SERVICE = 'terraform-demo-service'

        ECS_TASK_FAMILY = 'terraform-demo-task'


        /*
         * ============================================================
         * DOCKER
         * ============================================================
         */

        IMAGE_TAG = "${BUILD_NUMBER}"
    }


    stages {


        /*
         * ============================================================
         * 1. CHECK REQUIRED TOOLS
         * ============================================================
         */

        stage('Check Required Tools') {

            steps {

                sh '''
                    #!/usr/bin/env bash

                    set -e

                    echo "=========================================="
                    echo "Checking Required Tools"
                    echo "=========================================="

                    echo ""
                    echo "Terraform:"
                    terraform version

                    echo ""
                    echo "AWS CLI:"
                    aws --version

                    echo ""
                    echo "Docker:"
                    docker --version

                    echo ""
                    echo "Python:"
                    python3.12 --version

                    echo ""
                    echo "Git:"
                    git --version

                    echo ""
                    echo "JQ:"
                    jq --version

                    echo ""
                    echo "Curl:"
                    curl --version | head -n 1

                    echo ""
                    echo "=========================================="
                    echo "All Required Tools Found"
                    echo "=========================================="
                '''
            }
        }


        /*
         * ============================================================
         * 2. PIPELINE INFORMATION
         * ============================================================
         */

        stage('Pipeline Information') {

            steps {

                echo """
============================================================
JENKINS CI/CD PIPELINE
============================================================

Environment : ${params.ENVIRONMENT}
Action      : ${params.ACTION}
Build       : ${BUILD_NUMBER}

Terraform Repository:
${env.TERRAFORM_REPO}

Application Repository:
${env.APPLICATION_REPO}

Quality Repository:
${env.QUALITY_REPO}

Orchestration Repository:
${env.ORCHESTRATION_REPO}

AWS Region:
${env.AWS_DEFAULT_REGION}

============================================================
"""
            }
        }


        /*
         * ============================================================
         * 3. CHECKOUT ORCHESTRATION REPOSITORY
         * ============================================================
         */

        stage('Checkout Orchestration Repository') {

            steps {

                dir("${env.ORCHESTRATION_DIR}") {

                    deleteDir()

                    git(
                        branch: 'main',
                        credentialsId: "${env.GITHUB_CREDENTIALS}",
                        url: "${env.ORCHESTRATION_REPO}"
                    )
                }
            }
        }


        /*
         * ============================================================
         * 4. CHECKOUT TERRAFORM REPOSITORY
         * ============================================================
         */

        stage('Checkout Terraform Repository') {

            when {
                expression {
                    params.ACTION == 'DEPLOY' ||
                    params.ACTION == 'DESTROY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    deleteDir()

                    git(
                        branch: 'main',
                        credentialsId: "${env.GITHUB_CREDENTIALS}",
                        url: "${env.TERRAFORM_REPO}"
                    )
                }
            }
        }


        /*
         * ============================================================
         * 5. CREATE TERRAFORM BACKEND
         * ============================================================
         */

        stage('Create Terraform Backend') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        #!/usr/bin/env bash

                        set -e

                        BUCKET="terraform-state-faizan-001"
                        TABLE="terraform-locks"
                        REGION="$AWS_DEFAULT_REGION"

                        echo "=========================================="
                        echo "Terraform Backend"
                        echo "=========================================="

                        if aws s3api head-bucket \
                            --bucket "$BUCKET" \
                            --region "$REGION" \
                            >/dev/null 2>&1
                        then

                            echo "S3 bucket already exists:"
                            echo "$BUCKET"

                        else

                            echo "Creating S3 bucket:"
                            echo "$BUCKET"

                            if [ "$REGION" = "us-east-1" ]; then

                                aws s3api create-bucket \
                                    --bucket "$BUCKET" \
                                    --region "$REGION"

                            else

                                aws s3api create-bucket \
                                    --bucket "$BUCKET" \
                                    --region "$REGION" \
                                    --create-bucket-configuration \
                                    LocationConstraint="$REGION"

                            fi

                            aws s3api put-bucket-versioning \
                                --bucket "$BUCKET" \
                                --versioning-configuration \
                                Status=Enabled

                            aws s3api put-bucket-encryption \
                                --bucket "$BUCKET" \
                                --server-side-encryption-configuration \
                                '{
                                    "Rules": [
                                        {
                                            "ApplyServerSideEncryptionByDefault": {
                                                "SSEAlgorithm": "AES256"
                                            }
                                        }
                                    ]
                                }'

                        fi


                        if aws dynamodb describe-table \
                            --table-name "$TABLE" \
                            --region "$REGION" \
                            >/dev/null 2>&1
                        then

                            echo "DynamoDB table already exists:"
                            echo "$TABLE"

                        else

                            echo "Creating DynamoDB table:"
                            echo "$TABLE"

                            aws dynamodb create-table \
                                --table-name "$TABLE" \
                                --attribute-definitions \
                                    AttributeName=LockID,AttributeType=S \
                                --key-schema \
                                    AttributeName=LockID,KeyType=HASH \
                                --billing-mode PAY_PER_REQUEST \
                                --region "$REGION"

                            aws dynamodb wait table-exists \
                                --table-name "$TABLE" \
                                --region "$REGION"

                        fi

                        echo ""
                        echo "Terraform backend is ready."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * 6. TERRAFORM INIT
         * ============================================================
         */

        stage('Terraform Init') {

            when {
                expression {
                    params.ACTION == 'DEPLOY' ||
                    params.ACTION == 'DESTROY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    withCredentials([
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${env.AWS_CREDENTIALS}"
                        ]
                    ]) {

                        sh '''
                            #!/usr/bin/env bash

                            set -e

                            BACKEND_CONFIG="backend-${ENVIRONMENT}.conf"

                            if [ ! -f "$BACKEND_CONFIG" ]; then

                                echo "ERROR:"
                                echo "Backend configuration not found:"
                                echo "$BACKEND_CONFIG"

                                exit 1
                            fi

                            echo "Using backend:"
                            cat "$BACKEND_CONFIG"

                            terraform init \
                                -reconfigure \
                                -backend-config="$BACKEND_CONFIG"

                            echo ""
                            echo "Terraform initialization successful."
                        '''
                    }
                }
            }
        }


        /*
         * ============================================================
         * 7. AUTOMATIC IAM RESOURCE RECONCILIATION
         *
         * This fixes:
         *
         * EntityAlreadyExists:
         * Role terraform-demo-dev-ecs-instance-role already exists
         *
         * Existing AWS role:
         *     -> import into Terraform
         *
         * Already managed:
         *     -> do nothing
         *
         * Does not exist:
         *     -> Terraform creates it
         * ============================================================
         */

        stage('Automatic IAM Resource Reconciliation') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    withCredentials([
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${env.AWS_CREDENTIALS}"
                        ]
                    ]) {

                        sh '''
                            #!/usr/bin/env bash

                            set -e

                            echo "=========================================="
                            echo "Automatic IAM Resource Reconciliation"
                            echo "=========================================="

                            ROLE_NAME="terraform-demo-${ENVIRONMENT}-ecs-instance-role"

                            RESOURCE_ADDRESS="module.iam.aws_iam_role.ecs_instance_role"


                            echo ""
                            echo "Environment:"
                            echo "$ENVIRONMENT"

                            echo ""
                            echo "IAM Role:"
                            echo "$ROLE_NAME"

                            echo ""
                            echo "Terraform Resource:"
                            echo "$RESOURCE_ADDRESS"


                            # ==================================================
                            # CHECK TERRAFORM STATE
                            # ==================================================

                            if terraform state show \
                                "$RESOURCE_ADDRESS" \
                                >/dev/null 2>&1
                            then

                                echo ""
                                echo "IAM role is already managed by Terraform."
                                echo "No import required."

                            else

                                echo ""
                                echo "IAM role is not currently managed by Terraform."


                                # ==================================================
                                # CHECK AWS
                                # ==================================================

                                if aws iam get-role \
                                    --role-name "$ROLE_NAME" \
                                    >/dev/null 2>&1
                                then

                                    echo ""
                                    echo "IAM role already exists in AWS."
                                    echo "Automatically importing it into Terraform."

                                    terraform import \
                                        "$RESOURCE_ADDRESS" \
                                        "$ROLE_NAME"

                                    echo ""
                                    echo "IAM role imported successfully."

                                else

                                    echo ""
                                    echo "IAM role does not exist in AWS."
                                    echo "Terraform will create it."

                                fi

                            fi


                            echo ""
                            echo "=========================================="
                            echo "IAM Reconciliation Completed"
                            echo "=========================================="
                        '''
                    }
                }
            }
        }


        /*
         * ============================================================
         * 8. TERRAFORM FORMAT
         * ============================================================
         */

        stage('Terraform Format') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    sh '''
                        #!/usr/bin/env bash

                        set -e

                        terraform fmt -check -recursive

                        echo "Terraform format check passed."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * 9. TERRAFORM VALIDATE
         * ============================================================
         */

        stage('Terraform Validate') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    sh '''
                        #!/usr/bin/env bash

                        set -e

                        terraform validate

                        echo "Terraform validation successful."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * 10. TERRAFORM PLAN
         * ============================================================
         */

        stage('Terraform Plan') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    withCredentials([
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${env.AWS_CREDENTIALS}"
                        ]
                    ]) {

                        sh '''
                            #!/usr/bin/env bash

                            set -e

                            TF_VARS="environments/${ENVIRONMENT}/terraform.tfvars"

                            if [ ! -f "$TF_VARS" ]; then

                                echo "ERROR:"
                                echo "Terraform variables file not found:"
                                echo "$TF_VARS"

                                exit 1
                            fi

                            echo "=========================================="
                            echo "Terraform Plan"
                            echo "=========================================="

                            terraform plan \
                                -var-file="$TF_VARS" \
                                -out=tfplan

                            echo ""
                            echo "Terraform plan completed successfully."
                        '''
                    }
                }
            }
        }


        /*
         * ============================================================
         * 11. TERRAFORM APPLY
         * ============================================================
         *
         * No manual approval.
         *
         * This is fully automated CI/CD.
         * ============================================================
         */

        stage('Terraform Apply') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    withCredentials([
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${env.AWS_CREDENTIALS}"
                        ]
                    ]) {

                        sh '''
                            #!/usr/bin/env bash

                            set -e

                            terraform apply \
                                -auto-approve \
                                tfplan

                            echo "Terraform apply completed successfully."
                        '''
                    }
                }
            }
        }


        /*
         * ============================================================
         * 12. CHECK TERRAFORM OUTPUTS
         * ============================================================
         */

        stage('Check Terraform Outputs') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    sh '''
                        #!/usr/bin/env bash

                        set -e

                        echo "=========================================="
                        echo "Terraform Outputs"
                        echo "=========================================="

                        terraform output || true

                        echo ""
                        echo "Terraform infrastructure created."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * 13. CHECKOUT APPLICATION
         * ============================================================
         */

        stage('Checkout Application Repository') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    deleteDir()

                    git(
                        branch: 'main',
                        credentialsId: "${env.GITHUB_CREDENTIALS}",
                        url: "${env.APPLICATION_REPO}"
                    )
                }
            }
        }


        /*
         * ============================================================
         * 14. CHECKOUT QUALITY REPOSITORY
         * ============================================================
         */

        stage('Checkout Quality Repository') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.QUALITY_DIR}") {

                    deleteDir()

                    git(
                        branch: 'main',
                        credentialsId: "${env.GITHUB_CREDENTIALS}",
                        url: "${env.QUALITY_REPO}"
                    )
                }
            }
        }


        /*
         * ============================================================
         * 15. PREPARE QUALITY TOOLS
         * ============================================================
         */

        stage('Prepare Quality Tools') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    sh '''
                        #!/usr/bin/env bash

                        set -e

                        echo "Preparing Python environment."

                        rm -rf venv

                        python3.12 -m venv venv

                        ./venv/bin/python --version

                        ./venv/bin/pip install \
                            --upgrade pip

                        if [ -f requirements.txt ]; then

                            ./venv/bin/pip install \
                                -r requirements.txt

                        fi

                        ./venv/bin/pip install \
                            pytest \
                            pytest-cov \
                            pylint \
                            flake8 \
                            coverage

                        echo "Python environment ready."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * 16. PYTEST
         * ============================================================
         */

        stage('Run Pytest') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    sh '''
                        #!/usr/bin/env bash

                        set -e

                        mkdir -p reports

                        ./venv/bin/pytest \
                            -v \
                            --junitxml=reports/pytest-results.xml

                        echo "Pytest successful."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * 17. COVERAGE
         * ============================================================
         */

        stage('Coverage') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    sh '''
                        #!/usr/bin/env bash

                        set -e

                        mkdir -p reports

                        ./venv/bin/coverage run \
                            -m pytest

                        ./venv/bin/coverage report

                        ./venv/bin/coverage html \
                            -d reports/coverage

                        echo "Coverage completed."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * 18. PYLINT
         * ============================================================
         */

        stage('Pylint') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    sh '''
                        #!/usr/bin/env bash

                        set +e

                        mkdir -p reports

                        ./venv/bin/pylint . \
                            --ignore=venv,.git,reports,__pycache__ \
                            --output-format=text \
                            > reports/pylint-report.txt 2>&1

                        PYLINT_EXIT=$?

                        cat reports/pylint-report.txt

                        if [ "$PYLINT_EXIT" -ne 0 ]; then

                            echo ""
                            echo "Pylint found issues."

                            exit "$PYLINT_EXIT"

                        fi

                        echo "Pylint successful."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * 19. FLAKE8
         * ============================================================
         */

        stage('Flake8') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    sh '''
                        #!/usr/bin/env bash

                        set +e

                        mkdir -p reports

                        ./venv/bin/flake8 . \
                            --exclude=venv,.git,reports,__pycache__ \
                            --statistics \
                            --count \
                            --tee \
                            --output-file=reports/flake8-report.txt

                        FLAKE8_EXIT=$?

                        if [ "$FLAKE8_EXIT" -ne 0 ]; then

                            echo ""
                            echo "Flake8 found issues."

                            exit "$FLAKE8_EXIT"

                        fi

                        echo "Flake8 successful."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * 20. ARCHIVE QUALITY REPORTS
         * ============================================================
         */

        stage('Archive Reports') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                archiveArtifacts(
                    artifacts: 'application/reports/**/*',
                    allowEmptyArchive: true,
                    fingerprint: true
                )

                junit(
                    testResults: 'application/reports/pytest-results.xml',
                    allowEmptyResults: true
                )
            }
        }


        /*
         * ============================================================
         * 21. VERIFY ECR
         * ============================================================
         */

        stage('Prepare ECR Repository') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        #!/usr/bin/env bash

                        set -e

                        echo "Checking ECR repository."

                        if aws ecr describe-repositories \
                            --repository-names "$ECR_REPOSITORY" \
                            --region "$AWS_DEFAULT_REGION" \
                            >/dev/null 2>&1
                        then

                            echo "ECR repository already exists:"
                            echo "$ECR_REPOSITORY"

                        else

                            echo "Creating ECR repository:"
                            echo "$ECR_REPOSITORY"

                            aws ecr create-repository \
                                --repository-name "$ECR_REPOSITORY" \
                                --region "$AWS_DEFAULT_REGION"

                        fi

                        echo "ECR repository ready."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * 22. DOCKER BUILD
         * ============================================================
         */

        stage('Docker Build') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    withCredentials([
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${env.AWS_CREDENTIALS}"
                        ]
                    ]) {

                        sh '''
                            #!/usr/bin/env bash

                            set -e

                            if [ ! -f Dockerfile ]; then

                                echo "ERROR:"
                                echo "Dockerfile not found."

                                exit 1
                            fi

                            AWS_ACCOUNT_ID=$(
                                aws sts get-caller-identity \
                                    --query Account \
                                    --output text
                            )

                            ECR_REGISTRY="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_DEFAULT_REGION}.amazonaws.com"

                            IMAGE="${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}"

                            LATEST_IMAGE="${ECR_REGISTRY}/${ECR_REPOSITORY}:latest"

                            echo "Building Docker image:"
                            echo "$IMAGE"

                            docker build \
                                -t "$IMAGE" \
                                -t "$LATEST_IMAGE" \
                                .

                            echo "$IMAGE" > ../docker-image.txt

                            echo "Docker build successful."
                        '''
                    }
                }
            }
        }


        /*
         * ============================================================
         * 23. LOGIN ECR
         * ============================================================
         */

        stage('Login to Amazon ECR') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        #!/usr/bin/env bash

                        set -e

                        AWS_ACCOUNT_ID=$(
                            aws sts get-caller-identity \
                                --query Account \
                                --output text
                        )

                        ECR_REGISTRY="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_DEFAULT_REGION}.amazonaws.com"

                        aws ecr get-login-password \
                            --region "$AWS_DEFAULT_REGION" \
                        | docker login \
                            --username AWS \
                            --password-stdin "$ECR_REGISTRY"

                        echo "ECR login successful."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * 24. PUSH DOCKER IMAGE
         * ============================================================
         */

        stage('Push Docker Image') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        #!/usr/bin/env bash

                        set -e

                        AWS_ACCOUNT_ID=$(
                            aws sts get-caller-identity \
                                --query Account \
                                --output text
                        )

                        ECR_REGISTRY="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_DEFAULT_REGION}.amazonaws.com"

                        IMAGE="${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}"

                        LATEST_IMAGE="${ECR_REGISTRY}/${ECR_REPOSITORY}:latest"

                        docker push "$IMAGE"

                        docker push "$LATEST_IMAGE"

                        echo "$IMAGE" > docker-image.txt

                        echo "Docker image pushed successfully."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * 25. VERIFY ECR IMAGE
         * ============================================================
         */

        stage('Verify ECR Image') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        #!/usr/bin/env bash

                        set -e

                        aws ecr describe-images \
                            --repository-name "$ECR_REPOSITORY" \
                            --region "$AWS_DEFAULT_REGION"

                        echo "ECR image verification successful."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * 26. DOCKER CLEANUP
         * ============================================================
         */

        stage('Docker Cleanup') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                sh '''
                    #!/usr/bin/env bash

                    set +e

                    docker image prune -af

                    echo "Docker cleanup completed."
                '''
            }
        }


        /*
         * ============================================================
         * 27. VERIFY ECS CLUSTER
         * ============================================================
         */

        stage('Verify ECS Cluster') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        #!/usr/bin/env bash

                        set -e

                        aws ecs describe-clusters \
                            --clusters "$ECS_CLUSTER" \
                            --region "$AWS_DEFAULT_REGION"

                        echo "ECS cluster verified."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * 28. REGISTER ECS TASK DEFINITION
         * ============================================================
         */

        stage('Register ECS Task Definition') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        #!/usr/bin/env bash

                        set -e

                        AWS_ACCOUNT_ID=$(
                            aws sts get-caller-identity \
                                --query Account \
                                --output text
                        )

                        ECR_IMAGE="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_DEFAULT_REGION}.amazonaws.com/${ECR_REPOSITORY}:${IMAGE_TAG}"

                        EXECUTION_ROLE="arn:aws:iam::${AWS_ACCOUNT_ID}:role/terraform-demo-${ENVIRONMENT}-ecs-task-execution-role"

                        cat > ecs-task-definition.json <<EOF
{
    "family": "${ECS_TASK_FAMILY}",
    "networkMode": "bridge",
    "requiresCompatibilities": [
        "EC2"
    ],
    "cpu": "256",
    "memory": "512",
    "executionRoleArn": "${EXECUTION_ROLE}",
    "containerDefinitions": [
        {
            "name": "app",
            "image": "${ECR_IMAGE}",
            "essential": true,
            "cpu": 256,
            "memory": 512,
            "portMappings": [
                {
                    "containerPort": 8501,
                    "hostPort": 8501,
                    "protocol": "tcp"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/terraform-demo",
                    "awslogs-region": "${AWS_DEFAULT_REGION}",
                    "awslogs-stream-prefix": "ecs"
                }
            }
        }
    ]
}
EOF

                        echo "Registering ECS task definition."

                        aws ecs register-task-definition \
                            --cli-input-json file://ecs-task-definition.json \
                            --region "$AWS_DEFAULT_REGION"

                        echo "ECS task definition registered."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * 29. GET ECS REVISION
         * ============================================================
         */

        stage('Get ECS Revision') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        #!/usr/bin/env bash

                        set -e

                        REVISION=$(
                            aws ecs describe-task-definition \
                                --task-definition "$ECS_TASK_FAMILY" \
                                --region "$AWS_DEFAULT_REGION" \
                                --query 'taskDefinition.revision' \
                                --output text
                        )

                        echo "$REVISION" > ecs-revision.txt

                        echo "ECS revision:"
                        echo "$REVISION"
                    '''
                }
            }
        }


        /*
         * ============================================================
         * 30. UPDATE ECS SERVICE
         * ============================================================
         */

        stage('Deploy ECS Service') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        #!/usr/bin/env bash

                        set -e

                        REVISION=$(cat ecs-revision.txt)

                        aws ecs update-service \
                            --cluster "$ECS_CLUSTER" \
                            --service "$ECS_SERVICE" \
                            --task-definition "${ECS_TASK_FAMILY}:${REVISION}" \
                            --force-new-deployment \
                            --region "$AWS_DEFAULT_REGION"

                        echo "ECS deployment started."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * 31. WAIT ECS
         * ============================================================
         */

        stage('Wait For ECS Deployment') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        #!/usr/bin/env bash

                        set -e

                        echo "Waiting for ECS service to become stable."

                        aws ecs wait services-stable \
                            --cluster "$ECS_CLUSTER" \
                            --services "$ECS_SERVICE" \
                            --region "$AWS_DEFAULT_REGION"

                        echo "ECS service is stable."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * 32. HEALTH CHECK
         * ============================================================
         */

        stage('Health Check') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    sh '''
                        #!/usr/bin/env bash

                        set -e

                        ALB_DNS=$(terraform output -raw alb_dns_name)

                        if [ -z "$ALB_DNS" ]; then

                            echo "ALB DNS output is empty."

                            exit 1
                        fi

                        echo "ALB DNS:"
                        echo "$ALB_DNS"

                        echo ""
                        echo "Waiting for ALB."

                        sleep 30

                        echo ""
                        echo "Running application health check."

                        curl \
                            --fail \
                            --max-time 30 \
                            "http://${ALB_DNS}/"

                        echo ""
                        echo "Application health check successful."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * 33. DEPLOYMENT SUCCESS
         * ============================================================
         */

        stage('Deployment Successful') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                echo """
============================================================
DEPLOYMENT SUCCESSFUL
============================================================

Environment : ${params.ENVIRONMENT}
Build       : ${BUILD_NUMBER}

Terraform   : SUCCESS
Tests       : SUCCESS
Coverage    : SUCCESS
Pylint      : SUCCESS
Flake8      : SUCCESS
Docker      : SUCCESS
ECR         : SUCCESS
ECS         : SUCCESS
Health      : SUCCESS

============================================================
"""
            }
        }


        /*
         * ============================================================
         * 34. DESTROY
         * ============================================================
         */

        stage('Terraform Destroy') {

            when {
                expression {
                    params.ACTION == 'DESTROY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    withCredentials([
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${env.AWS_CREDENTIALS}"
                        ]
                    ]) {

                        sh '''
                            #!/usr/bin/env bash

                            set -e

                            BACKEND_CONFIG="backend-${ENVIRONMENT}.conf"

                            TF_VARS="environments/${ENVIRONMENT}/terraform.tfvars"

                            if [ ! -f "$BACKEND_CONFIG" ]; then

                                echo "Backend configuration not found:"
                                echo "$BACKEND_CONFIG"

                                exit 1
                            fi

                            if [ ! -f "$TF_VARS" ]; then

                                echo "Terraform variables file not found:"
                                echo "$TF_VARS"

                                exit 1
                            fi

                            echo "=========================================="
                            echo "Terraform Destroy"
                            echo "=========================================="

                            terraform init \
                                -reconfigure \
                                -backend-config="$BACKEND_CONFIG"

                            terraform destroy \
                                -var-file="$TF_VARS" \
                                -auto-approve

                            echo ""
                            echo "Terraform destroy completed successfully."
                        '''
                    }
                }
            }
        }


        /*
         * ============================================================
         * 35. DESTROY VERIFICATION
         * ============================================================
         */

        stage('Destroy Verification') {

            when {
                expression {
                    params.ACTION == 'DESTROY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        #!/usr/bin/env bash

                        set -e

                        echo "=========================================="
                        echo "Checking Destroyed Infrastructure"
                        echo "=========================================="

                        ROLE_NAME="terraform-demo-${ENVIRONMENT}-ecs-instance-role"

                        if aws iam get-role \
                            --role-name "$ROLE_NAME" \
                            >/dev/null 2>&1
                        then

                            echo "WARNING:"
                            echo "IAM role still exists:"
                            echo "$ROLE_NAME"

                            echo "Terraform destroy may have left an existing resource."

                        else

                            echo "IAM role removed successfully."

                        fi

                        echo ""
                        echo "Destroy verification completed."
                    '''
                }
            }
        }
    }


    /*
     * ================================================================
     * POST ACTIONS
     * ================================================================
     */

    post {

        always {

            echo "=========================================="
            echo "Cleaning Jenkins workspace"
            echo "=========================================="

            cleanWs(
                deleteDirs: true,
                disableDeferredWipeout: true
            )
        }

        success {

            echo """
==========================================
PIPELINE SUCCESS
==========================================

Environment : ${params.ENVIRONMENT}
Action      : ${params.ACTION}
Build       : ${BUILD_NUMBER}

==========================================
"""
        }

        failure {

            echo """
==========================================
PIPELINE FAILED
==========================================

Environment : ${params.ENVIRONMENT}
Action      : ${params.ACTION}
Build       : ${BUILD_NUMBER}

Check the failed stage above.

==========================================
"""
        }
    }
}
