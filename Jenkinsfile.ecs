pipeline {

    agent any

    options {
        timestamps()
        ansiColor('xterm')
        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                daysToKeepStr: '30',
                numToKeepStr: '50'
            )
        )

        timeout(
            time: 90,
            unit: 'MINUTES'
        )
    }

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: [
                'dev',
                'qa',
                'prod'
            ],
            description: 'Select Terraform environment'
        )

        choice(
            name: 'ACTION',
            choices: [
                'DEPLOY',
                'DESTROY'
            ],
            description: 'Select infrastructure action'
        )
    }

    environment {

        AWS_DEFAULT_REGION = 'us-east-1'

        /*
         * ========================================================
         * FOUR REPOSITORIES
         * ========================================================
         */

        TERRAFORM_REPO =
            'https://github.com/FAIZANSHEIKH223/terraform-aws-infra.git'

        APPLICATION_REPO =
            'https://github.com/FAIZANSHEIKH223/practice1.git'

        QUALITY_REPO =
            'https://github.com/FAIZANSHEIKH223/pylint_flake8_int_jenkins.git'

        ORCHESTRATION_REPO =
            'https://github.com/FAIZANSHEIKH223/CICD-Jenkins-orchestration-repository.git'


        /*
         * ========================================================
         * CREDENTIALS
         * ========================================================
         */

        GITHUB_CREDENTIALS = 'github-creds'
        AWS_CREDENTIALS = 'aws-creds'


        /*
         * ========================================================
         * WORKSPACE DIRECTORIES
         * ========================================================
         */

        TERRAFORM_DIR = 'terraform-aws-infra'
        APPLICATION_DIR = 'application'
        QUALITY_DIR = 'quality-tools'
        ORCHESTRATION_DIR = 'orchestration'


        /*
         * ========================================================
         * PROJECT
         * ========================================================
         */

        PROJECT_NAME = 'terraform-demo'

        ECR_REPOSITORY = 'terraform-demo-dev'

        ECS_CLUSTER = 'terraform-demo-dev-cluster'

        ECS_SERVICE = 'terraform-demo-service'

        ECS_TASK_FAMILY = 'terraform-demo-task'

        IMAGE_TAG = "${BUILD_NUMBER}"
    }


    stages {


        /*
         * ========================================================
         * 1. CHECK REQUIRED TOOLS
         * ========================================================
         */

        stage('Check Required Tools') {

            steps {

                sh '''
                    set -eu

                    echo "=========================================="
                    echo "Checking Required Tools"
                    echo "=========================================="

                    echo ""
                    echo "Terraform:"
                    terraform version

                    echo ""
                    echo "AWS CLI:"
                    aws --version

                    echo ""
                    echo "Docker:"
                    docker --version

                    echo ""
                    echo "Python:"
                    python3.12 --version

                    echo ""
                    echo "Git:"
                    git --version

                    echo ""
                    echo "JQ:"
                    jq --version

                    echo ""
                    echo "Curl:"
                    curl --version | head -n 1

                    echo ""
                    echo "=========================================="
                    echo "All Required Tools Found"
                    echo "=========================================="
                '''
            }
        }


        /*
         * ========================================================
         * 2. PIPELINE INFORMATION
         * ========================================================
         */

        stage('Pipeline Information') {

            steps {

                echo """
                ==========================================
                Jenkins CI/CD Pipeline
                ==========================================

                Environment  : ${params.ENVIRONMENT}
                Action       : ${params.ACTION}
                Build        : ${BUILD_NUMBER}

                Terraform    : ${env.TERRAFORM_REPO}
                Application  : ${env.APPLICATION_REPO}
                Quality      : ${env.QUALITY_REPO}
                Orchestration: ${env.ORCHESTRATION_REPO}

                ==========================================
                """
            }
        }


        /*
         * ========================================================
         * 3. CHECKOUT TERRAFORM REPOSITORY
         * ========================================================
         */

        stage('Checkout Terraform Repository') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    deleteDir()

                    git(
                        branch: 'main',
                        credentialsId: "${env.GITHUB_CREDENTIALS}",
                        url: "${env.TERRAFORM_REPO}"
                    )
                }
            }
        }


        /*
         * ========================================================
         * 4. CHECKOUT APPLICATION REPOSITORY
         * ========================================================
         */

        stage('Checkout Application Repository') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    deleteDir()

                    git(
                        branch: 'main',
                        credentialsId: "${env.GITHUB_CREDENTIALS}",
                        url: "${env.APPLICATION_REPO}"
                    )

                    sh '''
                        set -eu

                        echo "=========================================="
                        echo "Application Repository"
                        echo "=========================================="

                        find . -maxdepth 3 -type f \
                            -not -path './.git/*' \
                            -not -path './venv/*' \
                            | sort \
                            | head -100

                        echo ""
                        echo "Application repository checkout successful."
                    '''
                }
            }
        }


        /*
         * ========================================================
         * 5. CHECKOUT QUALITY REPOSITORY
         * ========================================================
         */

        stage('Checkout Quality Repository') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.QUALITY_DIR}") {

                    deleteDir()

                    git(
                        branch: 'main',
                        credentialsId: "${env.GITHUB_CREDENTIALS}",
                        url: "${env.QUALITY_REPO}"
                    )

                    sh '''
                        set -eu

                        echo "=========================================="
                        echo "Quality Repository"
                        echo "=========================================="

                        find . -maxdepth 3 -type f \
                            -not -path './.git/*' \
                            | sort \
                            | head -100

                        echo ""
                        echo "Quality repository checkout successful."
                    '''
                }
            }
        }


        /*
         * ========================================================
         * 6. CHECKOUT ORCHESTRATION REPOSITORY
         * ========================================================
         */

        stage('Checkout Orchestration Repository') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.ORCHESTRATION_DIR}") {

                    deleteDir()

                    git(
                        branch: 'main',
                        credentialsId: "${env.GITHUB_CREDENTIALS}",
                        url: "${env.ORCHESTRATION_REPO}"
                    )

                    sh '''
                        set -eu

                        echo "=========================================="
                        echo "Orchestration Repository"
                        echo "=========================================="

                        find . -maxdepth 3 -type f \
                            -not -path './.git/*' \
                            | sort \
                            | head -100

                        echo ""
                        echo "Orchestration repository checkout successful."
                    '''
                }
            }
        }


        /*
         * ========================================================
         * 7. PREPARE TERRAFORM VARIABLES
         * ========================================================
         */

        stage('Prepare Terraform Variables') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    sh '''
                        set -eu

                        TF_VARS="environments/${ENVIRONMENT}/terraform.tfvars"

                        echo "=========================================="
                        echo "Terraform Environment"
                        echo "=========================================="

                        echo "Environment:"
                        echo "$ENVIRONMENT"

                        echo ""
                        echo "Variables file:"
                        echo "$TF_VARS"

                        if [ ! -f "$TF_VARS" ]; then
                            echo ""
                            echo "ERROR: Terraform variables file does not exist:"
                            echo "$TF_VARS"
                            exit 1
                        fi

                        echo ""
                        echo "Terraform variables file found."

                        echo ""
                        echo "Backend configuration:"

                        BACKEND_CONFIG="backend-${ENVIRONMENT}.conf"

                        if [ ! -f "$BACKEND_CONFIG" ]; then
                            echo ""
                            echo "ERROR: Backend configuration does not exist:"
                            echo "$BACKEND_CONFIG"
                            exit 1
                        fi

                        echo "$BACKEND_CONFIG"

                        echo ""
                        echo "Terraform environment preparation completed."
                    '''
                }
            }
        }


        /*
         * ========================================================
         * 8. CREATE TERRAFORM BACKEND
         * ========================================================
         */

        stage('Create Terraform Backend') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -eu

                        BUCKET="terraform-state-faizan-001"
                        TABLE="terraform-locks"
                        REGION="${AWS_DEFAULT_REGION}"

                        echo "=========================================="
                        echo "Terraform Backend"
                        echo "=========================================="

                        if aws s3api head-bucket \
                            --bucket "$BUCKET" \
                            --region "$REGION" \
                            >/dev/null 2>&1
                        then

                            echo "S3 bucket already exists:"
                            echo "$BUCKET"

                        else

                            echo "Creating S3 bucket:"
                            echo "$BUCKET"

                            if [ "$REGION" = "us-east-1" ]; then

                                aws s3api create-bucket \
                                    --bucket "$BUCKET" \
                                    --region "$REGION"

                            else

                                aws s3api create-bucket \
                                    --bucket "$BUCKET" \
                                    --region "$REGION" \
                                    --create-bucket-configuration \
                                    LocationConstraint="$REGION"

                            fi

                            aws s3api put-bucket-versioning \
                                --bucket "$BUCKET" \
                                --versioning-configuration \
                                Status=Enabled

                            aws s3api put-bucket-encryption \
                                --bucket "$BUCKET" \
                                --server-side-encryption-configuration \
                                '{
                                    "Rules": [
                                        {
                                            "ApplyServerSideEncryptionByDefault": {
                                                "SSEAlgorithm": "AES256"
                                            }
                                        }
                                    ]
                                }'

                            echo "S3 backend bucket created."
                        fi


                        if aws dynamodb describe-table \
                            --table-name "$TABLE" \
                            --region "$REGION" \
                            >/dev/null 2>&1
                        then

                            echo "DynamoDB lock table already exists:"
                            echo "$TABLE"

                        else

                            echo "Creating DynamoDB lock table..."

                            aws dynamodb create-table \
                                --table-name "$TABLE" \
                                --attribute-definitions \
                                    AttributeName=LockID,AttributeType=S \
                                --key-schema \
                                    AttributeName=LockID,KeyType=HASH \
                                --billing-mode PAY_PER_REQUEST \
                                --region "$REGION"

                            aws dynamodb wait table-exists \
                                --table-name "$TABLE" \
                                --region "$REGION"

                            echo "DynamoDB lock table created."
                        fi

                        echo ""
                        echo "Terraform backend is ready."
                    '''
                }
            }
        }


        /*
         * ========================================================
         * 9. TERRAFORM INIT
         * ========================================================
         */

        stage('Terraform Init') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    withCredentials([
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${env.AWS_CREDENTIALS}"
                        ]
                    ]) {

                        sh '''
                            set -eu

                            BACKEND_CONFIG="backend-${ENVIRONMENT}.conf"

                            echo "Initializing Terraform..."

                            terraform init \
                                -reconfigure \
                                -backend-config="$BACKEND_CONFIG"

                            echo ""
                            echo "Terraform initialization successful."
                        '''
                    }
                }
            }
        }


        /*
         * ========================================================
         * 10. FIX EXISTING AWS RESOURCES
         *
         * IMPORTANT:
         *
         * Existing IAM roles are imported into Terraform.
         *
         * They are NOT deleted.
         *
         * IMPORTANT SHELL FIX:
         * All comments inside sh are '#' comments.
         * Do NOT use /* ... *\/ inside sh.
         * ========================================================
         */

        stage('Fix Existing AWS Resources') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    withCredentials([
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${env.AWS_CREDENTIALS}"
                        ]
                    ]) {

                        sh '''
                            set -eu

                            echo "=========================================="
                            echo "Checking Existing AWS Resources"
                            echo "=========================================="

                            TF_VARS="environments/${ENVIRONMENT}/terraform.tfvars"

                            if [ ! -f "$TF_VARS" ]; then
                                echo "ERROR: Variables file not found:"
                                echo "$TF_VARS"
                                exit 1
                            fi

                            echo "Using Terraform variables:"
                            echo "$TF_VARS"


                            # ==================================================
                            # IAM INSTANCE ROLE
                            # ==================================================

                            INSTANCE_ROLE="terraform-demo-${ENVIRONMENT}-ecs-instance-role"

                            echo ""
                            echo "Checking IAM role:"
                            echo "$INSTANCE_ROLE"

                            if aws iam get-role \
                                --role-name "$INSTANCE_ROLE" \
                                >/dev/null 2>&1
                            then

                                echo "IAM role already exists in AWS."

                                if terraform state list 2>/dev/null \
                                    | grep -Fxq 'module.iam.aws_iam_role.ecs_instance_role'
                                then

                                    echo "IAM role already exists in Terraform state."

                                else

                                    echo "Importing IAM role into Terraform..."

                                    terraform import \
                                        -var-file="$TF_VARS" \
                                        -input=false \
                                        module.iam.aws_iam_role.ecs_instance_role \
                                        "$INSTANCE_ROLE"

                                    echo "IAM role imported successfully."

                                fi

                            else

                                echo "IAM role does not exist."
                                echo "Terraform will create it."

                            fi


                            # ==================================================
                            # ECS TASK EXECUTION ROLE
                            # ==================================================

                            TASK_ROLE="terraform-demo-${ENVIRONMENT}-ecs-task-execution-role"

                            echo ""
                            echo "Checking ECS task execution role:"
                            echo "$TASK_ROLE"

                            if aws iam get-role \
                                --role-name "$TASK_ROLE" \
                                >/dev/null 2>&1
                            then

                                echo "ECS task execution role already exists."

                                if terraform state list 2>/dev/null \
                                    | grep -Fxq 'module.iam.aws_iam_role.ecs_task_execution_role'
                                then

                                    echo "Task execution role already exists in Terraform state."

                                else

                                    echo "Attempting automatic import..."

                                    terraform import \
                                        -var-file="$TF_VARS" \
                                        -input=false \
                                        module.iam.aws_iam_role.ecs_task_execution_role \
                                        "$TASK_ROLE" \
                                        || echo "Task execution role import skipped."

                                fi

                            else

                                echo "ECS task execution role does not exist."
                                echo "Terraform will create it."

                            fi


                            echo ""
                            echo "Existing AWS resource check completed."
                        '''
                    }
                }
            }
        }


        /*
         * ========================================================
         * 11. TERRAFORM FORMAT
         * ========================================================
         */

        stage('Terraform Format') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    sh '''
                        set -eu

                        echo "Running Terraform format..."

                        terraform fmt -recursive

                        echo "Terraform formatting completed."
                    '''
                }
            }
        }


        /*
         * ========================================================
         * 12. TERRAFORM VALIDATE
         * ========================================================
         */

        stage('Terraform Validate') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    sh '''
                        set -eu

                        terraform validate

                        echo "Terraform validation successful."
                    '''
                }
            }
        }


        /*
         * ========================================================
         * 13. TERRAFORM PLAN
         * ========================================================
         */

        stage('Terraform Plan') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    withCredentials([
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${env.AWS_CREDENTIALS}"
                        ]
                    ]) {

                        sh '''
                            set -eu

                            TF_VARS="environments/${ENVIRONMENT}/terraform.tfvars"

                            echo "=========================================="
                            echo "Terraform Plan"
                            echo "=========================================="

                            terraform plan \
                                -input=false \
                                -var-file="$TF_VARS" \
                                -out=tfplan

                            echo ""
                            echo "Terraform plan completed successfully."
                        '''
                    }
                }
            }
        }


        /*
         * ========================================================
         * 14. TERRAFORM APPROVAL
         * ========================================================
         */

        stage('Terraform Approval') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                input(
                    message: "Terraform plan completed. Deploy ${params.ENVIRONMENT}?",
                    ok: "Deploy"
                )
            }
        }


        /*
         * ========================================================
         * 15. TERRAFORM APPLY
         * ========================================================
         */

        stage('Terraform Apply') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    withCredentials([
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${env.AWS_CREDENTIALS}"
                        ]
                    ]) {

                        sh '''
                            set -eu

                            terraform apply \
                                -input=false \
                                -auto-approve \
                                tfplan

                            echo "Terraform apply completed successfully."
                        '''
                    }
                }
            }
        }


        /*
         * ========================================================
         * 16. PYTHON VERSION
         * ========================================================
         */

        stage('Python Version') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    sh '''
                        set -eu

                        python3.12 --version
                        python3.12 -m pip --version

                        echo "Python version verified."
                    '''
                }
            }
        }


        /*
         * ========================================================
         * 17. CREATE VIRTUAL ENVIRONMENT
         * ========================================================
         */

        stage('Create Virtual Environment') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    sh '''
                        set -eu

                        rm -rf venv

                        python3.12 -m venv venv

                        ./venv/bin/python --version
                        ./venv/bin/pip --version

                        echo "Virtual environment created."
                    '''
                }
            }
        }


        /*
         * ========================================================
         * 18. INSTALL APPLICATION DEPENDENCIES
         * ========================================================
         */

        stage('Install Application Dependencies') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    sh '''
                        set -eu

                        ./venv/bin/pip install --upgrade pip

                        if [ -f requirements.txt ]; then

                            echo "Installing application requirements..."

                            ./venv/bin/pip install \
                                -r requirements.txt

                        else

                            echo "No requirements.txt found."

                        fi

                        echo ""
                        echo "Installing CI/CD Python tools..."

                        ./venv/bin/pip install \
                            pytest \
                            pytest-cov \
                            pylint \
                            flake8 \
                            coverage

                        echo ""
                        echo "Python dependencies installed."
                    '''
                }
            }
        }


        /*
         * ========================================================
         * 19. VERIFY PYTHON TESTS
         * ========================================================
         */

        stage('Verify Python Tests') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    sh '''
                        set -eu

                        echo "=========================================="
                        echo "Checking Python Tests"
                        echo "=========================================="

                        TEST_COUNT=$(
                            find . \
                                -type f \
                                \\( \
                                    -name 'test_*.py' \
                                    -o \
                                    -name '*_test.py' \
                                \\) \
                                -not -path './venv/*' \
                                -not -path './.git/*' \
                                | wc -l
                        )

                        echo "Test files found: $TEST_COUNT"

                        if [ "$TEST_COUNT" -eq 0 ]; then

                            echo ""
                            echo "WARNING: No pytest test files found."
                            echo ""
                            echo "Pytest stage will be skipped."
                            echo "This is NOT treated as a pipeline failure."
                            echo ""
                            echo "When tests are added, Jenkins will automatically"
                            echo "detect and execute them."

                            touch .jenkins-no-tests

                        else

                            echo ""
                            echo "Python test files found:"

                            find . \
                                -type f \
                                \\( \
                                    -name 'test_*.py' \
                                    -o \
                                    -name '*_test.py' \
                                \\) \
                                -not -path './venv/*' \
                                -not -path './.git/*' \
                                | sort

                            echo ""
                            echo "Tests are available."

                            rm -f .jenkins-no-tests

                        fi
                    '''
                }
            }
        }


        /*
         * ========================================================
         * 20. RUN PYTEST
         * ========================================================
         */

        stage('Run Pytest') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    sh '''
                        set -eu

                        if [ -f .jenkins-no-tests ]; then

                            echo "No tests found."
                            echo "Skipping pytest."

                        else

                            mkdir -p reports

                            ./venv/bin/pytest \
                                -v \
                                --junitxml=reports/pytest-results.xml

                            echo ""
                            echo "Pytest completed successfully."

                        fi
                    '''
                }
            }
        }


        /*
         * ========================================================
         * 21. COVERAGE
         * ========================================================
         */

        stage('Coverage') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    sh '''
                        set -eu

                        if [ -f .jenkins-no-tests ]; then

                            echo "No tests found."
                            echo "Skipping coverage."

                        else

                            mkdir -p reports

                            ./venv/bin/coverage run \
                                -m pytest

                            ./venv/bin/coverage report

                            ./venv/bin/coverage html \
                                -d reports/coverage

                            echo ""
                            echo "Coverage completed successfully."

                        fi
                    '''
                }
            }
        }


        /*
         * ========================================================
         * 22. PYLINT
         * ========================================================
         */

        stage('Pylint') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    sh '''
                        set -eu

                        mkdir -p reports

                        echo "Running Pylint..."

                        ./venv/bin/pylint . \
                            --ignore=venv,.git,reports,__pycache__ \
                            --output-format=text \
                            > reports/pylint-report.txt \
                            || true

                        echo ""
                        echo "Pylint report:"
                        cat reports/pylint-report.txt || true

                        echo ""
                        echo "Pylint stage completed."
                    '''
                }
            }
        }


        /*
         * ========================================================
         * 23. FLAKE8
         * ========================================================
         */

        stage('Flake8') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    sh '''
                        set -eu

                        mkdir -p reports

                        echo "Running Flake8..."

                        ./venv/bin/flake8 . \
                            --exclude=venv,.git,reports,__pycache__ \
                            --statistics \
                            --count \
                            --tee \
                            --output-file=reports/flake8-report.txt \
                            || true

                        echo ""
                        echo "Flake8 report:"

                        cat reports/flake8-report.txt || true

                        echo ""
                        echo "Flake8 stage completed."
                    '''
                }
            }
        }


        /*
         * ========================================================
         * 24. ARCHIVE REPORTS
         * ========================================================
         */

        stage('Archive Quality Reports') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                archiveArtifacts(
                    artifacts: 'application/reports/**/*',
                    allowEmptyArchive: true,
                    fingerprint: true
                )

                junit(
                    testResults: 'application/reports/pytest-results.xml',
                    allowEmptyResults: true
                )
            }
        }


        /*
         * ========================================================
         * 25. PREPARE ECR
         * ========================================================
         */

        stage('Prepare ECR Repository') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -eu

                        echo "Checking ECR repository..."

                        if aws ecr describe-repositories \
                            --repository-names "$ECR_REPOSITORY" \
                            --region "$AWS_DEFAULT_REGION" \
                            >/dev/null 2>&1
                        then

                            echo "ECR repository already exists:"
                            echo "$ECR_REPOSITORY"

                        else

                            echo "ECR repository does not exist."
                            echo "Creating automatically..."

                            aws ecr create-repository \
                                --repository-name "$ECR_REPOSITORY" \
                                --region "$AWS_DEFAULT_REGION"

                            echo "ECR repository created."

                        fi
                    '''
                }
            }
        }


        /*
         * ========================================================
         * 26. DOCKER BUILD
         * ========================================================
         */

        stage('Docker Build') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.APPLICATION_DIR}") {

                    withCredentials([
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${env.AWS_CREDENTIALS}"
                        ]
                    ]) {

                        sh '''
                            set -eu

                            if [ ! -f Dockerfile ]; then

                                echo "ERROR: Dockerfile not found."

                                exit 1

                            fi

                            AWS_ACCOUNT_ID=$(
                                aws sts get-caller-identity \
                                    --query Account \
                                    --output text
                            )

                            ECR_REGISTRY="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_DEFAULT_REGION}.amazonaws.com"

                            IMAGE="${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}"

                            LATEST_IMAGE="${ECR_REGISTRY}/${ECR_REPOSITORY}:latest"

                            echo "Building Docker image:"
                            echo "$IMAGE"

                            docker build \
                                -t "$IMAGE" \
                                -t "$LATEST_IMAGE" \
                                .

                            echo "$IMAGE" > ../docker-image.txt

                            echo ""
                            echo "Docker build completed."
                        '''
                    }
                }
            }
        }


        /*
         * ========================================================
         * 27. LOGIN TO ECR
         * ========================================================
         */

        stage('Login to Amazon ECR') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -eu

                        AWS_ACCOUNT_ID=$(
                            aws sts get-caller-identity \
                                --query Account \
                                --output text
                        )

                        ECR_REGISTRY="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_DEFAULT_REGION}.amazonaws.com"

                        aws ecr get-login-password \
                            --region "$AWS_DEFAULT_REGION" \
                            | docker login \
                                --username AWS \
                                --password-stdin "$ECR_REGISTRY"

                        echo "ECR login successful."
                    '''
                }
            }
        }


        /*
         * ========================================================
         * 28. PUSH DOCKER IMAGE
         * ========================================================
         */

        stage('Push Docker Image') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -eu

                        AWS_ACCOUNT_ID=$(
                            aws sts get-caller-identity \
                                --query Account \
                                --output text
                        )

                        ECR_REGISTRY="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_DEFAULT_REGION}.amazonaws.com"

                        IMAGE="${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}"

                        LATEST_IMAGE="${ECR_REGISTRY}/${ECR_REPOSITORY}:latest"

                        docker push "$IMAGE"

                        docker push "$LATEST_IMAGE"

                        echo "$IMAGE" > docker-image.txt

                        echo ""
                        echo "Docker image pushed successfully:"
                        echo "$IMAGE"
                    '''
                }
            }
        }


        /*
         * ========================================================
         * 29. VERIFY ECR
         * ========================================================
         */

        stage('Verify ECR Image') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -eu

                        aws ecr describe-images \
                            --repository-name "$ECR_REPOSITORY" \
                            --region "$AWS_DEFAULT_REGION"

                        echo ""
                        echo "ECR image verification successful."
                    '''
                }
            }
        }


        /*
         * ========================================================
         * 30. VERIFY ECS CLUSTER
         * ========================================================
         */

        stage('Verify ECS Cluster') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -eu

                        if aws ecs describe-clusters \
                            --clusters "$ECS_CLUSTER" \
                            --region "$AWS_DEFAULT_REGION" \
                            >/dev/null 2>&1
                        then

                            echo "ECS cluster exists:"
                            echo "$ECS_CLUSTER"

                        else

                            echo "ERROR: ECS cluster does not exist:"
                            echo "$ECS_CLUSTER"

                            exit 1

                        fi
                    '''
                }
            }
        }


        /*
         * ========================================================
         * 31. REGISTER ECS TASK DEFINITION
         * ========================================================
         */

        stage('Register New Task Definition') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -eu

                        AWS_ACCOUNT_ID=$(
                            aws sts get-caller-identity \
                                --query Account \
                                --output text
                        )

                        ECR_IMAGE="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_DEFAULT_REGION}.amazonaws.com/${ECR_REPOSITORY}:${IMAGE_TAG}"

                        EXECUTION_ROLE="arn:aws:iam::${AWS_ACCOUNT_ID}:role/terraform-demo-${ENVIRONMENT}-ecs-task-execution-role"

                        cat > ecs-task-definition.json <<EOF
{
    "family": "${ECS_TASK_FAMILY}",
    "networkMode": "bridge",
    "requiresCompatibilities": [
        "EC2"
    ],
    "cpu": "256",
    "memory": "512",
    "executionRoleArn": "${EXECUTION_ROLE}",
    "containerDefinitions": [
        {
            "name": "app",
            "image": "${ECR_IMAGE}",
            "essential": true,
            "cpu": 256,
            "memory": 512,
            "portMappings": [
                {
                    "containerPort": 8501,
                    "hostPort": 8501,
                    "protocol": "tcp"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/terraform-demo",
                    "awslogs-region": "${AWS_DEFAULT_REGION}",
                    "awslogs-stream-prefix": "ecs"
                }
            }
        }
    ]
}
EOF

                        echo "Registering ECS task definition..."

                        aws ecs register-task-definition \
                            --cli-input-json file://ecs-task-definition.json \
                            --region "$AWS_DEFAULT_REGION"

                        echo ""
                        echo "New ECS task definition registered."
                    '''
                }
            }
        }


        /*
         * ========================================================
         * 32. GET LATEST ECS REVISION
         * ========================================================
         */

        stage('Get Latest ECS Revision') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -eu

                        REVISION=$(
                            aws ecs describe-task-definition \
                                --task-definition "$ECS_TASK_FAMILY" \
                                --region "$AWS_DEFAULT_REGION" \
                                --query 'taskDefinition.revision' \
                                --output text
                        )

                        echo "$REVISION" > ecs-revision.txt

                        echo "Latest ECS revision:"
                        echo "$REVISION"
                    '''
                }
            }
        }


        /*
         * ========================================================
         * 33. DEPLOY ECS SERVICE
         * ========================================================
         */

        stage('Deploy ECS Service') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -eu

                        REVISION=$(cat ecs-revision.txt)

                        echo "Updating ECS service..."

                        aws ecs update-service \
                            --cluster "$ECS_CLUSTER" \
                            --service "$ECS_SERVICE" \
                            --task-definition "${ECS_TASK_FAMILY}:${REVISION}" \
                            --force-new-deployment \
                            --region "$AWS_DEFAULT_REGION"

                        echo ""
                        echo "ECS deployment started."
                    '''
                }
            }
        }


        /*
         * ========================================================
         * 34. WAIT FOR ECS
         * ========================================================
         */

        stage('Wait For ECS Deployment') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: "${env.AWS_CREDENTIALS}"
                    ]
                ]) {

                    sh '''
                        set -eu

                        echo "Waiting for ECS service to become stable..."

                        aws ecs wait services-stable \
                            --cluster "$ECS_CLUSTER" \
                            --services "$ECS_SERVICE" \
                            --region "$AWS_DEFAULT_REGION"

                        echo ""
                        echo "ECS service is stable."
                    '''
                }
            }
        }


        /*
         * ========================================================
         * 35. HEALTH CHECK
         * ========================================================
         */

        stage('Health Check') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    sh '''
                        set -eu

                        echo "Getting ALB DNS..."

                        ALB_DNS=$(
                            terraform output \
                                -raw alb_dns_name
                        )

                        if [ -z "$ALB_DNS" ]; then

                            echo "ERROR: ALB DNS output is empty."

                            exit 1

                        fi

                        echo ""
                        echo "ALB DNS:"
                        echo "$ALB_DNS"

                        echo ""
                        echo "Waiting for ALB/application..."

                        sleep 30

                        echo ""
                        echo "Running application health check..."

                        curl \
                            --fail \
                            --max-time 20 \
                            "http://${ALB_DNS}/"

                        echo ""
                        echo "Health check successful."
                    '''
                }
            }
        }


        /*
         * ========================================================
         * 36. DOCKER CLEANUP
         * ========================================================
         */

        stage('Docker Cleanup') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                sh '''
                    set +e

                    docker image prune -af

                    echo "Docker cleanup completed."
                '''
            }
        }


        /*
         * ========================================================
         * 37. DEPLOYMENT SUCCESSFUL
         * ========================================================
         */

        stage('Deployment Successful') {

            when {
                expression {
                    params.ACTION == 'DEPLOY'
                }
            }

            steps {

                echo """
                ==========================================
                DEPLOYMENT SUCCESSFUL
                ==========================================

                Environment : ${params.ENVIRONMENT}
                Build       : ${BUILD_NUMBER}

                Terraform   : SUCCESS
                Python      : SUCCESS
                Tests       : COMPLETED
                Pylint      : COMPLETED
                Flake8      : COMPLETED
                Docker      : SUCCESS
                ECR         : SUCCESS
                ECS         : SUCCESS
                Health      : SUCCESS

                ==========================================
                """
            }
        }


        /*
         * ========================================================
         * 38. DESTROY INFRASTRUCTURE
         * ========================================================
         */

        stage('Terraform Destroy') {

            when {
                expression {
                    params.ACTION == 'DESTROY'
                }
            }

            steps {

                dir("${env.TERRAFORM_DIR}") {

                    deleteDir()

                    git(
                        branch: 'main',
                        credentialsId: "${env.GITHUB_CREDENTIALS}",
                        url: "${env.TERRAFORM_REPO}"
                    )

                    withCredentials([
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: "${env.AWS_CREDENTIALS}"
                        ]
                    ]) {

                        sh '''
                            set -eu

                            BACKEND_CONFIG="backend-${ENVIRONMENT}.conf"
                            TF_VARS="environments/${ENVIRONMENT}/terraform.tfvars"

                            echo "=========================================="
                            echo "Terraform Destroy"
                            echo "=========================================="

                            if [ ! -f "$BACKEND_CONFIG" ]; then
                                echo "ERROR: Backend config not found:"
                                echo "$BACKEND_CONFIG"
                                exit 1
                            fi

                            if [ ! -f "$TF_VARS" ]; then
                                echo "ERROR: Terraform variables not found:"
                                echo "$TF_VARS"
                                exit 1
                            fi

                            terraform init \
                                -reconfigure \
                                -backend-config="$BACKEND_CONFIG"

                            terraform destroy \
                                -input=false \
                                -var-file="$TF_VARS" \
                                -auto-approve

                            echo ""
                            echo "Terraform destroy completed successfully."
                        '''
                    }
                }
            }
        }


        /*
         * ========================================================
         * 39. DESTROY SUCCESSFUL
         * ========================================================
         */

        stage('Destroy Successful') {

            when {
                expression {
                    params.ACTION == 'DESTROY'
                }
            }

            steps {

                echo """
                ==========================================
                DESTROY SUCCESSFUL
                ==========================================

                Environment : ${params.ENVIRONMENT}
                Build       : ${BUILD_NUMBER}

                Terraform infrastructure has been
                destroyed successfully.

                ==========================================
                """
            }
        }
    }


    /*
     * ============================================================
     * POST ACTIONS
     * ============================================================
     */

    post {

        always {

            echo "=========================================="
            echo "Cleaning Jenkins workspace..."
            echo "=========================================="

            cleanWs(
                deleteDirs: true,
                disableDeferredWipeout: true
            )
        }

        success {

            echo "=========================================="
            echo "PIPELINE SUCCESS"
            echo "=========================================="

            echo "Environment: ${params.ENVIRONMENT}"
            echo "Action: ${params.ACTION}"
            echo "Build: ${BUILD_NUMBER}"
        }

        failure {

            echo "=========================================="
            echo "PIPELINE FAILED"
            echo "=========================================="

            echo "Environment: ${params.ENVIRONMENT}"
            echo "Action: ${params.ACTION}"
            echo "Build: ${BUILD_NUMBER}"

            echo ""
            echo "Check the failed stage above."
        }

        aborted {

            echo "=========================================="
            echo "PIPELINE ABORTED"
            echo "=========================================="
        }
    }
}
