pipeline {

    agent any

    // ================================================================
    // PIPELINE OPTIONS
    // ================================================================

    options {

        timestamps()

        ansiColor('xterm')

        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                daysToKeepStr: '30',
                numToKeepStr: '50'
            )
        )

        timeout(
            time: 120,
            unit: 'MINUTES'
        )
    }


    // ================================================================
    // PARAMETERS
    // ================================================================

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: [
                'dev',
                'qa',
                'stage',
                'prod'
            ],
            description: 'Terraform environment to deploy'
        )
    }


    // ================================================================
    // ENVIRONMENT
    // ================================================================

    environment {

        APP_REPO = 'https://github.com/FAIZANSHEIKH223/practice1.git'
        APP_BRANCH = 'main'

        QUALITY_REPO = 'https://github.com/FAIZANSHEIKH223/pylint_flake8_int_jenkins.git'
        QUALITY_BRANCH = 'main'

        TERRAFORM_REPO = 'https://github.com/FAIZANSHEIKH223/terraform-aws-infra.git'
        TERRAFORM_BRANCH = 'main'

        GITHUB_CREDENTIALS = 'github-creds'
        AWS_CREDENTIALS = 'aws-creds'

        APP_DIR = 'practice1'
        QUALITY_DIR = 'quality-tools'
        TERRAFORM_DIR = 'terraform-infra'

        VENV_DIR = 'venv'
        REPORT_DIR = 'reports'

        PYTHON = 'python3.12'

        AWS_DEFAULT_REGION = 'us-east-1'

        APP_NAME = 'practice1'
        CONTAINER_NAME = 'practice1'
        CONTAINER_PORT = '8501'

        DOCKER_IMAGE_NAME = 'practice1'
        DOCKER_IMAGE_TAG = "${BUILD_NUMBER}"
        DOCKER_IMAGE = "${DOCKER_IMAGE_NAME}:${DOCKER_IMAGE_TAG}"

        ECR_REPOSITORY = 'practice1'
        ECR_IMAGE_TAG = "${BUILD_NUMBER}"

        ECS_CLUSTER = "practice1-${ENVIRONMENT}-cluster"
        ECS_SERVICE = "practice1-${ENVIRONMENT}-service"
        ECS_TASK_FAMILY = "practice1-${ENVIRONMENT}-task"
        ECS_CONTAINER_NAME = 'practice1'

        FARGATE_CPU = '256'
        FARGATE_MEMORY = '512'

        ALB_NAME = "practice1-${ENVIRONMENT}-alb"
        TARGET_GROUP_NAME = "practice1-${ENVIRONMENT}-tg"
        ALB_SG_NAME = "practice1-${ENVIRONMENT}-alb-sg"
        ECS_SG_NAME = "practice1-${ENVIRONMENT}-ecs-sg"

        TF_STATE_BUCKET = 'terraform-state-faizan-001'
        TF_LOCK_TABLE = 'terraform-locks'
        TF_STATE_KEY = 'terraform.tfstate'

        TF_IN_AUTOMATION = 'true'
        TF_INPUT = 'false'
    }


    // ================================================================
    // STAGES
    // ================================================================

    stages {


        // ============================================================
        // PART 1 - CODE QUALITY
        // ============================================================

        stage('1 - Checkout Application') {

            steps {

                echo '================================================'
                echo 'CHECKOUT APPLICATION'
                echo '================================================'

                dir("${APP_DIR}") {

                    deleteDir()

                    git(
                        branch: "${APP_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${APP_REPO}"
                    )
                }
            }
        }


        stage('2 - Checkout Quality Repository') {

            steps {

                echo '================================================'
                echo 'CHECKOUT QUALITY REPOSITORY'
                echo '================================================'

                dir("${QUALITY_DIR}") {

                    deleteDir()

                    git(
                        branch: "${QUALITY_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${QUALITY_REPO}"
                    )
                }
            }
        }


        stage('3 - Verify Python') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "VERIFYING PYTHON"
                        echo "================================================"

                        command -v "${PYTHON}"

                        "${PYTHON}" --version

                        "${PYTHON}" -m pip --version
                    '''
                }
            }
        }


        stage('4 - Create Python Virtual Environment') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "CREATING PYTHON VIRTUAL ENVIRONMENT"
                        echo "================================================"

                        rm -rf "${VENV_DIR}"

                        "${PYTHON}" -m venv "${VENV_DIR}"

                        "${VENV_DIR}/bin/python" --version
                    '''
                }
            }
        }


        stage('5 - Install Application Dependencies') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "INSTALLING APPLICATION DEPENDENCIES"
                        echo "================================================"

                        "${VENV_DIR}/bin/python" -m pip install --upgrade pip

                        if [ -f requirements.txt ]; then

                            "${VENV_DIR}/bin/pip" install -r requirements.txt

                        else

                            echo "WARNING: requirements.txt not found."

                        fi
                    '''
                }
            }
        }


        stage('6 - Install Quality Tools') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "INSTALLING QUALITY TOOLS"
                        echo "================================================"

                        "${VENV_DIR}/bin/pip" install flake8 pylint

                        "${VENV_DIR}/bin/flake8" --version

                        "${VENV_DIR}/bin/pylint" --version
                    '''
                }
            }
        }


        stage('7 - Flake8 Code Quality') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "RUNNING FLAKE8"
                        echo "================================================"

                        mkdir -p "${REPORT_DIR}"

                        "${VENV_DIR}/bin/flake8" \
                            . \
                            --exclude="${VENV_DIR},.git,${REPORT_DIR},__pycache__" \
                            --count \
                            --statistics \
                            --tee \
                            --output-file="${REPORT_DIR}/flake8-report.txt"
                    '''
                }
            }
        }


        stage('8 - Pylint Code Quality') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "RUNNING PYLINT"
                        echo "================================================"

                        mkdir -p "${REPORT_DIR}"

                        PYTHON_FILES=$(find . \
                            -type f \
                            -name "*.py" \
                            ! -path "./${VENV_DIR}/*" \
                            ! -path "./.git/*" \
                            ! -path "./${REPORT_DIR}/*" \
                            ! -path "*/__pycache__/*")

                        if [ -z "${PYTHON_FILES}" ]; then

                            echo "ERROR: No Python files found."

                            exit 1

                        fi

                        "${VENV_DIR}/bin/pylint" \
                            ${PYTHON_FILES} \
                            --output-format=text \
                            > "${REPORT_DIR}/pylint-report.txt"
                    '''
                }
            }
        }


        stage('9 - Part 1 Success') {

            steps {

                echo '================================================'
                echo 'PART 1 - CODE QUALITY SUCCESS'
                echo '================================================'

                echo 'Flake8 : PASSED'
                echo 'Pylint : PASSED'
            }
        }


        // ============================================================
        // PART 2 - TESTING
        // ============================================================

        stage('10 - Install Pytest') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "INSTALLING PYTEST"
                        echo "================================================"

                        "${VENV_DIR}/bin/pip" install pytest

                        "${VENV_DIR}/bin/pytest" --version
                    '''
                }
            }
        }


        stage('11 - Verify Tests') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "VERIFYING TESTS"
                        echo "================================================"

                        if [ ! -d "tests" ]; then

                            echo "ERROR: tests/ directory does not exist."

                            exit 1

                        fi

                        TEST_FILES=$(find tests \
                            -type f \
                            \\( \
                                -name "test_*.py" \
                                -o \
                                -name "*_test.py" \
                            \\))

                        if [ -z "${TEST_FILES}" ]; then

                            echo "ERROR: No pytest test files found."

                            exit 1

                        fi

                        echo "Test files:"
                        echo "${TEST_FILES}"
                    '''
                }
            }
        }


        stage('12 - Run Automated Tests') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "RUNNING AUTOMATED TESTS"
                        echo "================================================"

                        mkdir -p "${REPORT_DIR}"

                        "${VENV_DIR}/bin/pytest" \
                            tests/ \
                            -v \
                            --junitxml="${REPORT_DIR}/pytest-results.xml"
                    '''
                }
            }
        }


        stage('13 - Publish Test Results') {

            steps {

                junit(
                    testResults:
                        "${APP_DIR}/${REPORT_DIR}/pytest-results.xml",
                    allowEmptyResults: false
                )

                archiveArtifacts(
                    artifacts:
                        "${APP_DIR}/${REPORT_DIR}/pytest-results.xml," +
                        "${APP_DIR}/${REPORT_DIR}/flake8-report.txt," +
                        "${APP_DIR}/${REPORT_DIR}/pylint-report.txt",
                    allowEmptyArchive: false,
                    fingerprint: true
                )
            }
        }


        stage('14 - Part 2 Success') {

            steps {

                echo '================================================'
                echo 'PART 2 - TESTING SUCCESS'
                echo '================================================'

                echo 'Pytest : PASSED'
            }
        }


        // ============================================================
        // PART 3 - DOCKER
        // ============================================================

        stage('15 - Verify Docker') {

            steps {

                sh '''
                    set -e

                    echo "================================================"
                    echo "VERIFYING DOCKER"
                    echo "================================================"

                    command -v docker

                    docker --version

                    docker info > /dev/null

                    echo "Docker daemon is accessible."
                '''
            }
        }


        stage('16 - Prepare Docker Build Context') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "PREPARING DOCKER BUILD CONTEXT"
                        echo "================================================"

                        if [ ! -f Dockerfile ]; then

                            echo "ERROR: Dockerfile not found."

                            exit 1

                        fi

                        cat > .dockerignore <<'EOF'
venv/
.venv/
.git/
.gitignore
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
reports/
*.log
.DS_Store
EOF

                        echo ""
                        echo "Docker ignore file:"
                        cat .dockerignore

                        echo ""
                        echo "Dockerfile:"
                        cat Dockerfile
                    '''
                }
            }
        }


        stage('17 - Build Docker Image') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "BUILDING DOCKER IMAGE"
                        echo "================================================"

                        echo "Image: ${DOCKER_IMAGE}"

                        docker build \
                            --pull \
                            --tag "${DOCKER_IMAGE}" \
                            .

                        docker image inspect "${DOCKER_IMAGE}" > /dev/null

                        echo "Docker image created successfully."
                    '''
                }
            }
        }


        stage('18 - Docker Image Verification') {

            steps {

                sh '''
                    set -e

                    echo "================================================"
                    echo "VERIFYING DOCKER IMAGE"
                    echo "================================================"

                    docker image inspect \
                        "${DOCKER_IMAGE}" \
                        --format='Image={{.RepoTags}} Size={{.Size}}'

                    echo ""

                    docker images "${DOCKER_IMAGE_NAME}"
                '''
            }
        }


        stage('19 - Part 3 Success') {

            steps {

                echo '================================================'
                echo 'PART 3 - DOCKER SUCCESS'
                echo '================================================'

                echo "Docker Image: ${DOCKER_IMAGE}"
            }
        }


        // ============================================================
        // PART 4 - AWS ECR
        // ============================================================

        stage('20 - Verify AWS CLI') {

            steps {

                sh '''
                    set -e

                    echo "================================================"
                    echo "VERIFYING AWS CLI"
                    echo "================================================"

                    command -v aws

                    aws --version
                '''
            }
        }


        stage('21 - Verify AWS Credentials') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "VERIFYING AWS CREDENTIALS"
                        echo "================================================"

                        aws sts get-caller-identity \
                            --region "${AWS_DEFAULT_REGION}"
                    '''
                }
            }
        }


        stage('22 - Create ECR Repository') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "VERIFYING ECR REPOSITORY"
                        echo "================================================"

                        if aws ecr describe-repositories \
                            --repository-names "${ECR_REPOSITORY}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            > /dev/null 2>&1
                        then

                            echo "ECR repository already exists."

                        else

                            echo "Creating ECR repository..."

                            aws ecr create-repository \
                                --repository-name "${ECR_REPOSITORY}" \
                                --region "${AWS_DEFAULT_REGION}"

                        fi

                        REPOSITORY_URI=$(aws ecr describe-repositories \
                            --repository-names "${ECR_REPOSITORY}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            --query 'repositories[0].repositoryUri' \
                            --output text)

                        if [ -z "${REPOSITORY_URI}" ] ||
                           [ "${REPOSITORY_URI}" = "None" ]; then

                            echo "ERROR: ECR repository could not be verified."

                            exit 1

                        fi

                        echo "Repository URI: ${REPOSITORY_URI}"
                    '''
                }
            }
        }


        stage('23 - Get ECR Image URI') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        def accountId = sh(
                            script: '''
                                aws sts get-caller-identity \
                                    --query Account \
                                    --output text \
                                    --region "${AWS_DEFAULT_REGION}"
                            ''',
                            returnStdout: true
                        ).trim()

                        if (!accountId || accountId == 'None') {

                            error(
                                'Unable to determine AWS account ID.'
                            )
                        }

                        env.AWS_ACCOUNT_ID = accountId

                        env.ECR_REGISTRY =
                            "${accountId}.dkr.ecr.${AWS_DEFAULT_REGION}.amazonaws.com"

                        env.ECR_IMAGE =
                            "${env.ECR_REGISTRY}/${env.ECR_REPOSITORY}:${env.ECR_IMAGE_TAG}"

                        echo "AWS Account ID : ${env.AWS_ACCOUNT_ID}"
                        echo "ECR Registry   : ${env.ECR_REGISTRY}"
                        echo "ECR Image URI  : ${env.ECR_IMAGE}"
                    }
                }
            }
        }


        stage('24 - Login Docker to ECR') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        aws ecr get-login-password \
                            --region "${AWS_DEFAULT_REGION}" |
                        docker login \
                            --username AWS \
                            --password-stdin \
                            "${ECR_REGISTRY}"
                    '''
                }
            }
        }


        stage('25 - Tag Image with ECR URI') {

            steps {

                sh '''
                    set -e

                    docker tag \
                        "${DOCKER_IMAGE}" \
                        "${ECR_IMAGE}"

                    docker image inspect \
                        "${ECR_IMAGE}" \
                        > /dev/null

                    echo "ECR image:"
                    echo "${ECR_IMAGE}"
                '''
            }
        }


        stage('26 - Push Image to ECR') {

            steps {

                sh '''
                    set -e

                    echo "================================================"
                    echo "PUSHING IMAGE TO ECR"
                    echo "================================================"

                    docker push "${ECR_IMAGE}"

                    echo "Docker image pushed successfully."
                '''
            }
        }


        stage('27 - Verify ECR Image') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        aws ecr describe-images \
                            --repository-name "${ECR_REPOSITORY}" \
                            --image-ids imageTag="${ECR_IMAGE_TAG}" \
                            --region "${AWS_DEFAULT_REGION}"

                        echo ""
                        echo "ECR IMAGE VERIFIED:"
                        echo "${ECR_IMAGE}"
                    '''
                }
            }
        }


        stage('28 - Part 4 Success') {

            steps {

                echo '================================================'
                echo 'PART 4 - ECR SUCCESS'
                echo '================================================'

                echo "ECR Image URI: ${env.ECR_IMAGE}"
            }
        }


        // ============================================================
        // PART 5 - TERRAFORM
        // ============================================================

        stage('29 - Checkout Terraform Repository') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    deleteDir()

                    git(
                        branch: "${TERRAFORM_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${TERRAFORM_REPO}"
                    )
                }
            }
        }


        stage('30 - Verify Terraform') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    sh '''
                        set -e

                        command -v terraform

                        terraform version

                        echo ""
                        echo "Terraform files:"

                        find . \
                            -maxdepth 3 \
                            -type f \
                            -name "*.tf" \
                            -print
                    '''
                }
            }
        }


        stage('31 - Terraform Environment Verification') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    sh '''
                        set -e

                        echo "Environment: ${ENVIRONMENT}"

                        if [ ! -d "environments/${ENVIRONMENT}" ]; then

                            echo "ERROR: Terraform environment does not exist."

                            exit 1

                        fi

                        if [ ! -f "environments/${ENVIRONMENT}/terraform.tfvars" ]; then

                            echo "ERROR: terraform.tfvars not found."

                            exit 1

                        fi

                        echo "Terraform environment verified."
                    '''
                }
            }
        }


        // ============================================================
        // TERRAFORM BACKEND
        // ============================================================

        stage('32 - Ensure Terraform Backend Exists') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh(
                        script: '''#!/usr/bin/env bash
set -euo pipefail

echo "================================================"
echo "ENSURING TERRAFORM BACKEND EXISTS"
echo "================================================"

echo "AWS Region      : ${AWS_DEFAULT_REGION}"
echo "S3 State Bucket : ${TF_STATE_BUCKET}"
echo "DynamoDB Table  : ${TF_LOCK_TABLE}"
echo "State Key       : ${TF_STATE_KEY}"

aws sts get-caller-identity \
    --region "${AWS_DEFAULT_REGION}"

# ------------------------------------------------
# S3
# ------------------------------------------------

echo ""
echo "================================================"
echo "CHECKING S3 STATE BUCKET"
echo "================================================"

if aws s3api head-bucket \
    --bucket "${TF_STATE_BUCKET}" \
    --region "${AWS_DEFAULT_REGION}" \
    > /dev/null 2>&1
then

    echo "S3 state bucket already exists."

else

    echo "S3 state bucket does not exist."
    echo "Creating bucket..."

    if [ "${AWS_DEFAULT_REGION}" = "us-east-1" ]; then

        aws s3api create-bucket \
            --bucket "${TF_STATE_BUCKET}" \
            --region "${AWS_DEFAULT_REGION}"

    else

        aws s3api create-bucket \
            --bucket "${TF_STATE_BUCKET}" \
            --region "${AWS_DEFAULT_REGION}" \
            --create-bucket-configuration \
            LocationConstraint="${AWS_DEFAULT_REGION}"

    fi

fi

aws s3api head-bucket \
    --bucket "${TF_STATE_BUCKET}" \
    --region "${AWS_DEFAULT_REGION}"

aws s3api put-bucket-versioning \
    --bucket "${TF_STATE_BUCKET}" \
    --versioning-configuration Status=Enabled \
    --region "${AWS_DEFAULT_REGION}"

aws s3api put-bucket-encryption \
    --bucket "${TF_STATE_BUCKET}" \
    --region "${AWS_DEFAULT_REGION}" \
    --server-side-encryption-configuration \
    '{"Rules":[{"ApplyServerSideEncryptionByDefault":{"SSEAlgorithm":"AES256"}}]}'

aws s3api put-public-access-block \
    --bucket "${TF_STATE_BUCKET}" \
    --region "${AWS_DEFAULT_REGION}" \
    --public-access-block-configuration \
    BlockPublicAcls=true,IgnorePublicAcls=true,BlockPublicPolicy=true,RestrictPublicBuckets=true

echo "S3 backend bucket is ready."

# ------------------------------------------------
# DYNAMODB
# ------------------------------------------------

echo ""
echo "================================================"
echo "CHECKING DYNAMODB LOCK TABLE"
echo "================================================"

if aws dynamodb describe-table \
    --table-name "${TF_LOCK_TABLE}" \
    --region "${AWS_DEFAULT_REGION}" \
    > /dev/null 2>&1
then

    echo "DynamoDB table already exists."

else

    echo "DynamoDB table does not exist."
    echo "Creating DynamoDB table..."

    aws dynamodb create-table \
        --table-name "${TF_LOCK_TABLE}" \
        --attribute-definitions \
            AttributeName=LockID,AttributeType=S \
        --key-schema \
            AttributeName=LockID,KeyType=HASH \
        --billing-mode PAY_PER_REQUEST \
        --region "${AWS_DEFAULT_REGION}"

fi

echo "Waiting for DynamoDB..."

aws dynamodb wait table-exists \
    --table-name "${TF_LOCK_TABLE}" \
    --region "${AWS_DEFAULT_REGION}"

TABLE_STATUS=$(aws dynamodb describe-table \
    --table-name "${TF_LOCK_TABLE}" \
    --region "${AWS_DEFAULT_REGION}" \
    --query 'Table.TableStatus' \
    --output text)

if [ "${TABLE_STATUS}" != "ACTIVE" ]; then

    echo "ERROR: DynamoDB table is not ACTIVE."

    exit 1

fi

echo "DynamoDB table is ACTIVE."

echo ""
echo "================================================"
echo "TERRAFORM BACKEND READY"
echo "================================================"
''',
                        label: 'Ensure Terraform S3 bucket and DynamoDB lock table'
                    )
                }
            }
        }


        // ============================================================
        // IMPORTANT FIX:
        // REPAIR TERRAFORM S3/DYNAMODB CHECKSUM
        // ============================================================

        stage('33 - Repair Terraform Backend State Checksum') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh(
                            script: '''#!/usr/bin/env bash
set -euo pipefail

echo "================================================"
echo "TERRAFORM BACKEND STATE CHECKSUM CHECK"
echo "================================================"

echo ""
echo "S3 Bucket      : ${TF_STATE_BUCKET}"
echo "S3 State Key   : ${TF_STATE_KEY}"
echo "DynamoDB Table : ${TF_LOCK_TABLE}"

# ------------------------------------------------
# Verify state exists
# ------------------------------------------------

echo ""
echo "================================================"
echo "VERIFYING STATE OBJECT"
echo "================================================"

if ! aws s3api head-object \
    --bucket "${TF_STATE_BUCKET}" \
    --key "${TF_STATE_KEY}" \
    --region "${AWS_DEFAULT_REGION}" \
    > /dev/null 2>&1
then

    echo "No Terraform state exists yet."

    echo "This is a new backend."

    echo "No checksum repair is required."

    exit 0

fi

echo "Terraform state exists in S3."

# ------------------------------------------------
# Check active Terraform lock
# ------------------------------------------------

echo ""
echo "================================================"
echo "CHECKING FOR ACTIVE TERRAFORM LOCK"
echo "================================================"

LOCK_ID="${TF_STATE_BUCKET}/${TF_STATE_KEY}"

LOCK_ITEM=$(aws dynamodb get-item \
    --table-name "${TF_LOCK_TABLE}" \
    --key "{\"LockID\":{\"S\":\"${LOCK_ID}\"}}" \
    --region "${AWS_DEFAULT_REGION}" \
    --consistent-read \
    --output json)

LOCK_EXISTS=$(printf '%s' "${LOCK_ITEM}" | \
    python3 -c '
import json
import sys

data = json.load(sys.stdin)
print("yes" if "Item" in data else "no")
')

if [ "${LOCK_EXISTS}" = "yes" ]; then

    echo ""
    echo "ERROR: Active Terraform lock detected."
    echo ""
    echo "Lock item:"
    echo "${LOCK_ITEM}"
    echo ""
    echo "The pipeline will NOT modify the checksum."
    echo "Wait for the active Terraform operation to finish."

    exit 1

fi

echo "No active Terraform lock detected."

# ------------------------------------------------
# Download actual state
# ------------------------------------------------

echo ""
echo "================================================"
echo "DOWNLOADING ACTUAL S3 STATE"
echo "================================================"

STATE_FILE=$(mktemp)

cleanup() {
    rm -f "${STATE_FILE}"
}

trap cleanup EXIT

aws s3 cp \
    "s3://${TF_STATE_BUCKET}/${TF_STATE_KEY}" \
    "${STATE_FILE}" \
    --region "${AWS_DEFAULT_REGION}"

if [ ! -s "${STATE_FILE}" ]; then

    echo "ERROR: Downloaded Terraform state is empty."

    exit 1

fi

echo "Terraform state downloaded."

# ------------------------------------------------
# Calculate MD5
# ------------------------------------------------

echo ""
echo "================================================"
echo "CALCULATING ACTUAL STATE MD5"
echo "================================================"

ACTUAL_MD5=$(md5sum "${STATE_FILE}" | awk '{print $1}')

if [ -z "${ACTUAL_MD5}" ]; then

    echo "ERROR: Could not calculate MD5."

    exit 1

fi

echo "Actual S3 state MD5:"
echo "${ACTUAL_MD5}"

# ------------------------------------------------
# Terraform DynamoDB checksum key
# ------------------------------------------------

DIGEST_KEY="${TF_STATE_BUCKET}/${TF_STATE_KEY}-md5"

echo ""
echo "Terraform checksum key:"
echo "${DIGEST_KEY}"

# ------------------------------------------------
# Read existing Digest correctly
# ------------------------------------------------

echo ""
echo "================================================"
echo "READING DYNAMODB CHECKSUM"
echo "================================================"

STORED_MD5=$(aws dynamodb get-item \
    --table-name "${TF_LOCK_TABLE}" \
    --key "{\"LockID\":{\"S\":\"${DIGEST_KEY}\"}}" \
    --region "${AWS_DEFAULT_REGION}" \
    --consistent-read \
    --query 'Item.Digest.S' \
    --output text 2>/dev/null || true)

if [ -z "${STORED_MD5}" ] || [ "${STORED_MD5}" = "None" ]; then

    STORED_MD5="NONE"

fi

echo "Stored DynamoDB MD5:"
echo "${STORED_MD5}"

# ------------------------------------------------
# Repair / create Digest
# ------------------------------------------------

echo ""
echo "================================================"
echo "REPAIRING TERRAFORM CHECKSUM"
echo "================================================"

if [ "${STORED_MD5}" = "${ACTUAL_MD5}" ]; then

    echo "DynamoDB checksum already matches S3 state."

else

    if [ "${STORED_MD5}" = "NONE" ]; then

        echo "No Terraform checksum exists."

    else

        echo "Existing DynamoDB checksum does not match S3 state."

    fi

    echo ""
    echo "Writing the correct Terraform Digest..."

    aws dynamodb put-item \
        --table-name "${TF_LOCK_TABLE}" \
        --region "${AWS_DEFAULT_REGION}" \
        --item "{
            \\"LockID\\": {\\"S\\": \\"${DIGEST_KEY}\\"
            },
            \\"Digest\\": {\\"S\\": \\"${ACTUAL_MD5}\\"
            }
        }"

    echo "DynamoDB checksum write completed."

fi

# ------------------------------------------------
# Consistent verification with retry
# ------------------------------------------------

echo ""
echo "================================================"
echo "FINAL CHECKSUM VERIFICATION"
echo "================================================"

VERIFIED="false"

for ATTEMPT in 1 2 3 4 5
do

    FINAL_MD5=$(aws dynamodb get-item \
        --table-name "${TF_LOCK_TABLE}" \
        --key "{\"LockID\":{\"S\":\"${DIGEST_KEY}\"}}" \
        --region "${AWS_DEFAULT_REGION}" \
        --consistent-read \
        --query 'Item.Digest.S' \
        --output text 2>/dev/null || true)

    echo "Attempt ${ATTEMPT}: DynamoDB Digest = ${FINAL_MD5}"

    if [ "${FINAL_MD5}" = "${ACTUAL_MD5}" ]; then

        VERIFIED="true"

        break

    fi

    sleep 2

done

if [ "${VERIFIED}" != "true" ]; then

    echo ""
    echo "ERROR: DynamoDB checksum verification failed."

    echo ""
    echo "Expected Digest:"
    echo "${ACTUAL_MD5}"

    echo ""
    echo "DynamoDB item:"
    aws dynamodb get-item \
        --table-name "${TF_LOCK_TABLE}" \
        --key "{\"LockID\":{\"S\":\"${DIGEST_KEY}\"}}" \
        --region "${AWS_DEFAULT_REGION}" \
        --consistent-read \
        --output json

    exit 1

fi

echo ""
echo "================================================"
echo "CHECKSUM REPAIR SUCCESSFUL"
echo "================================================"

echo "S3 MD5       : ${ACTUAL_MD5}"
echo "DynamoDB MD5 : ${FINAL_MD5}"

echo ""
echo "Terraform backend checksum is now correct."
''',
                            label: 'Repair Terraform S3/DynamoDB state checksum'
                        )
                    }
                }
            }
        }


        // ============================================================
        // TERRAFORM INIT
        // ============================================================

        stage('34 - Terraform Init') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh(
                            script: '''#!/usr/bin/env bash
set -euo pipefail

echo "================================================"
echo "TERRAFORM INIT"
echo "================================================"

echo "Terraform directory : ${PWD}"
echo "AWS region          : ${AWS_DEFAULT_REGION}"
echo "State bucket        : ${TF_STATE_BUCKET}"
echo "State key           : ${TF_STATE_KEY}"
echo "Lock table          : ${TF_LOCK_TABLE}"

echo ""
echo "Checking AWS identity..."

aws sts get-caller-identity \
    --region "${AWS_DEFAULT_REGION}"

echo ""
echo "Checking Terraform..."

terraform version

echo ""
echo "================================================"
echo "RUNNING TERRAFORM INIT"
echo "================================================"

terraform init \
    -input=false \
    -reconfigure

echo ""
echo "================================================"
echo "TERRAFORM INIT SUCCESSFUL"
echo "================================================"
''',
                            label: 'Terraform init'
                        )
                    }
                }
            }
        }


        // ============================================================
        // ADOPT EXISTING RESOURCES
        // ============================================================

        stage('35 - Adopt Existing Terraform Resources') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh(
                            script: '''#!/usr/bin/env bash
set -euo pipefail

echo "================================================"
echo "ADOPT EXISTING AWS RESOURCES"
echo "================================================"

echo ""
echo "Current Terraform state:"
terraform state list || true

resource_in_state() {

    local ADDRESS="$1"

    terraform state list 2>/dev/null |
        grep -Fxq "${ADDRESS}"
}


# ================================================================
# ECR
# ================================================================

echo ""
echo "================================================"
echo "CHECKING ECR REPOSITORY"
echo "================================================"

ECR_TF_ADDRESS="module.ecr.aws_ecr_repository.this"
ECR_REPOSITORY_NAME="terraform-demo-${ENVIRONMENT}"

if resource_in_state "${ECR_TF_ADDRESS}"; then

    echo "ECR repository already managed by Terraform."

else

    if aws ecr describe-repositories \
        --repository-names "${ECR_REPOSITORY_NAME}" \
        --region "${AWS_DEFAULT_REGION}" \
        > /dev/null 2>&1
    then

        echo "Existing ECR repository found."
        echo "Importing..."

        terraform import \
            -input=false \
            "${ECR_TF_ADDRESS}" \
            "${ECR_REPOSITORY_NAME}" || true

    else

        echo "ECR repository does not exist."

    fi

fi


# ================================================================
# IAM ECS INSTANCE ROLE
# ================================================================

echo ""
echo "================================================"
echo "CHECKING ECS INSTANCE IAM ROLE"
echo "================================================"

INSTANCE_ROLE_ADDRESS="module.iam.aws_iam_role.ecs_instance_role"
INSTANCE_ROLE_NAME="terraform-demo-${ENVIRONMENT}-ecs-instance-role"

if resource_in_state "${INSTANCE_ROLE_ADDRESS}"; then

    echo "IAM instance role already managed."

else

    if aws iam get-role \
        --role-name "${INSTANCE_ROLE_NAME}" \
        > /dev/null 2>&1
    then

        echo "Existing IAM role found."

        terraform import \
            -input=false \
            "${INSTANCE_ROLE_ADDRESS}" \
            "${INSTANCE_ROLE_NAME}" || true

    else

        echo "IAM role does not exist."

    fi

fi


# ================================================================
# ECS TASK EXECUTION ROLE
# ================================================================

echo ""
echo "================================================"
echo "CHECKING ECS TASK EXECUTION ROLE"
echo "================================================"

TASK_ROLE_ADDRESS="module.iam.aws_iam_role.ecs_task_execution_role"
TASK_ROLE_NAME="terraform-demo-${ENVIRONMENT}-ecs-task-execution-role"

if resource_in_state "${TASK_ROLE_ADDRESS}"; then

    echo "Task execution role already managed."

else

    if aws iam get-role \
        --role-name "${TASK_ROLE_NAME}" \
        > /dev/null 2>&1
    then

        echo "Existing task execution role found."

        terraform import \
            -input=false \
            "${TASK_ROLE_ADDRESS}" \
            "${TASK_ROLE_NAME}" || true

    else

        echo "Task execution role does not exist."

    fi

fi


# ================================================================
# CLOUDWATCH
# ================================================================

echo ""
echo "================================================"
echo "CHECKING CLOUDWATCH LOG GROUP"
echo "================================================"

LOG_GROUP_ADDRESS="module.ecs.aws_cloudwatch_log_group.ecs"
LOG_GROUP_NAME="/ecs/terraform-demo"

if resource_in_state "${LOG_GROUP_ADDRESS}"; then

    echo "CloudWatch log group already managed."

else

    LOG_EXISTS=$(aws logs describe-log-groups \
        --log-group-name-prefix "${LOG_GROUP_NAME}" \
        --region "${AWS_DEFAULT_REGION}" \
        --query "logGroups[?logGroupName=='${LOG_GROUP_NAME}'].logGroupName | [0]" \
        --output text)

    if [ "${LOG_EXISTS}" = "${LOG_GROUP_NAME}" ]; then

        terraform import \
            -input=false \
            "${LOG_GROUP_ADDRESS}" \
            "${LOG_GROUP_NAME}" || true

    else

        echo "CloudWatch log group does not exist."

    fi

fi


# ================================================================
# ECS CLUSTER
# ================================================================

echo ""
echo "================================================"
echo "CHECKING ECS CLUSTER"
echo "================================================"

CLUSTER_ADDRESS="module.ecs.aws_ecs_cluster.this"
CLUSTER_NAME="terraform-demo-${ENVIRONMENT}-cluster"

if resource_in_state "${CLUSTER_ADDRESS}"; then

    echo "ECS cluster already managed."

else

    CLUSTER_STATUS=$(aws ecs describe-clusters \
        --region "${AWS_DEFAULT_REGION}" \
        --clusters "${CLUSTER_NAME}" \
        --query 'clusters[0].status' \
        --output text 2>/dev/null || true)

    if [ "${CLUSTER_STATUS}" = "ACTIVE" ]; then

        terraform import \
            -input=false \
            "${CLUSTER_ADDRESS}" \
            "${CLUSTER_NAME}" || true

    else

        echo "ECS cluster does not exist."

    fi

fi


# ================================================================
# S3 APPLICATION BUCKET
# ================================================================

echo ""
echo "================================================"
echo "CHECKING APPLICATION S3 BUCKET"
echo "================================================"

S3_ADDRESS="module.s3.aws_s3_bucket.this"
S3_BUCKET_NAME="terraform-demo-${ENVIRONMENT}-001"

if resource_in_state "${S3_ADDRESS}"; then

    echo "Application S3 bucket already managed."

else

    if aws s3api head-bucket \
        --bucket "${S3_BUCKET_NAME}" \
        --region "${AWS_DEFAULT_REGION}" \
        > /dev/null 2>&1
    then

        terraform import \
            -input=false \
            "${S3_ADDRESS}" \
            "${S3_BUCKET_NAME}" || true

    else

        echo "Application S3 bucket does not exist."

    fi

fi


# ================================================================
# ALB
# ================================================================

echo ""
echo "================================================"
echo "CHECKING APPLICATION LOAD BALANCER"
echo "================================================"

ALB_ADDRESS="module.alb.aws_lb.this"
ALB_NAME_TF="terraform-demo-${ENVIRONMENT}-alb"

if resource_in_state "${ALB_ADDRESS}"; then

    echo "ALB already managed."

else

    ALB_ARN_TF=$(aws elbv2 describe-load-balancers \
        --region "${AWS_DEFAULT_REGION}" \
        --names "${ALB_NAME_TF}" \
        --query 'LoadBalancers[0].LoadBalancerArn' \
        --output text 2>/dev/null || true)

    if [ -n "${ALB_ARN_TF}" ] &&
       [ "${ALB_ARN_TF}" != "None" ]; then

        terraform import \
            -input=false \
            "${ALB_ADDRESS}" \
            "${ALB_ARN_TF}" || true

    else

        echo "ALB does not exist."

    fi

fi


# ================================================================
# TARGET GROUP
# ================================================================

echo ""
echo "================================================"
echo "CHECKING TARGET GROUP"
echo "================================================"

TG_ADDRESS="module.alb.aws_lb_target_group.this"
TG_NAME_TF="terraform-demo-${ENVIRONMENT}-tg"

if resource_in_state "${TG_ADDRESS}"; then

    echo "Target group already managed."

else

    TG_ARN_TF=$(aws elbv2 describe-target-groups \
        --region "${AWS_DEFAULT_REGION}" \
        --names "${TG_NAME_TF}" \
        --query 'TargetGroups[0].TargetGroupArn' \
        --output text 2>/dev/null || true)

    if [ -n "${TG_ARN_TF}" ] &&
       [ "${TG_ARN_TF}" != "None" ]; then

        terraform import \
            -input=false \
            "${TG_ADDRESS}" \
            "${TG_ARN_TF}" || true

    else

        echo "Target group does not exist."

    fi

fi


echo ""
echo "================================================"
echo "FINAL TERRAFORM STATE"
echo "================================================"

terraform state list || true

echo ""
echo "Existing resource adoption completed."
''',
                            label: 'Adopt existing AWS resources into Terraform state'
                        )
                    }
                }
            }
        }


        stage('36 - Terraform Validate') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "TERRAFORM VALIDATE"
                        echo "================================================"

                        terraform validate
                    '''
                }
            }
        }


        stage('37 - Terraform Plan') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh '''
                            set -e

                            echo "================================================"
                            echo "TERRAFORM PLAN"
                            echo "================================================"

                            terraform plan \
                                -input=false \
                                -var-file="environments/${ENVIRONMENT}/terraform.tfvars" \
                                -out="tfplan"
                        '''
                    }
                }
            }
        }


        stage('38 - Terraform Apply') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh '''
                            set -e

                            echo "================================================"
                            echo "TERRAFORM APPLY"
                            echo "================================================"

                            if [ ! -f tfplan ]; then

                                echo "ERROR: tfplan not found."

                                exit 1

                            fi

                            terraform apply \
                                -input=false \
                                -auto-approve \
                                tfplan
                        '''
                    }
                }
            }
        }


        stage('39 - Terraform Deployment Verification') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh '''
                            set -e

                            echo "Terraform state:"
                            terraform state list || true

                            echo ""
                            echo "Terraform outputs:"
                            terraform output || true

                            echo ""
                            echo "AWS identity:"

                            aws sts get-caller-identity \
                                --region "${AWS_DEFAULT_REGION}"

                            echo ""
                            echo "Terraform deployment verification completed."
                        '''
                    }
                }
            }
        }


        // ============================================================
        // PART 6 - ECS FARGATE + ALB
        // ============================================================

        stage('40 - Discover AWS Network') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        def vpcId = sh(
                            script: '''
                                set -e

                                VPC_ID=$(aws ec2 describe-vpcs \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --filters \
                                        "Name=tag:Environment,Values=${ENVIRONMENT}" \
                                    --query 'Vpcs[0].VpcId' \
                                    --output text)

                                if [ "${VPC_ID}" = "None" ] ||
                                   [ -z "${VPC_ID}" ]; then

                                    VPC_ID=$(aws ec2 describe-vpcs \
                                        --region "${AWS_DEFAULT_REGION}" \
                                        --filters \
                                            "Name=is-default,Values=true" \
                                        --query 'Vpcs[0].VpcId' \
                                        --output text)

                                fi

                                if [ "${VPC_ID}" = "None" ] ||
                                   [ -z "${VPC_ID}" ]; then

                                    echo "ERROR: No VPC found."

                                    exit 1

                                fi

                                echo "${VPC_ID}"
                            ''',
                            returnStdout: true
                        ).trim()

                        env.VPC_ID = vpcId

                        def subnetOutput = sh(
                            script: '''
                                set -e

                                SUBNETS=$(aws ec2 describe-subnets \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --filters \
                                        "Name=vpc-id,Values=${VPC_ID}" \
                                        "Name=map-public-ip-on-launch,Values=true" \
                                    --query 'Subnets[].SubnetId' \
                                    --output text)

                                if [ -z "${SUBNETS}" ] ||
                                   [ "${SUBNETS}" = "None" ]; then

                                    echo "ERROR: No public subnets found."

                                    exit 1

                                fi

                                echo "${SUBNETS}"
                            ''',
                            returnStdout: true
                        ).trim()

                        def subnetList = subnetOutput.split("\\s+")

                        if (subnetList.size() < 2) {

                            error(
                                "At least 2 public subnets are required. " +
                                "Found: ${subnetOutput}"
                            )
                        }

                        env.SUBNET_1 = subnetList[0]
                        env.SUBNET_2 = subnetList[1]

                        echo "VPC ID  : ${env.VPC_ID}"
                        echo "Subnet 1: ${env.SUBNET_1}"
                        echo "Subnet 2: ${env.SUBNET_2}"
                    }
                }
            }
        }


        stage('41 - Create IAM Roles for ECS') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "CREATING ECS IAM ROLE"
                        echo "================================================"

                        EXECUTION_ROLE_NAME="practice1-ecsTaskExecutionRole"

                        if aws iam get-role \
                            --role-name "${EXECUTION_ROLE_NAME}" \
                            > /dev/null 2>&1
                        then

                            echo "ECS execution role already exists."

                        else

                            cat > /tmp/ecs-trust-policy.json <<'EOF'
{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
            },
            "Action": "sts:AssumeRole"
        }
    ]
}
EOF

                            aws iam create-role \
                                --role-name "${EXECUTION_ROLE_NAME}" \
                                --assume-role-policy-document \
                                file:///tmp/ecs-trust-policy.json

                        fi

                        aws iam attach-role-policy \
                            --role-name "${EXECUTION_ROLE_NAME}" \
                            --policy-arn \
                            arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy \
                            || true

                        EXECUTION_ROLE_ARN=$(aws iam get-role \
                            --role-name "${EXECUTION_ROLE_NAME}" \
                            --query 'Role.Arn' \
                            --output text)

                        if [ -z "${EXECUTION_ROLE_ARN}" ] ||
                           [ "${EXECUTION_ROLE_ARN}" = "None" ]; then

                            echo "ERROR: Could not retrieve ECS execution role ARN."

                            exit 1

                        fi

                        echo "ECS Execution Role:"
                        echo "${EXECUTION_ROLE_ARN}"
                    '''
                }
            }
        }


        stage('42 - Create Security Groups') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        def securityGroupIds = sh(
                            script: '''
                                set -e

                                ALB_SG_ID=$(aws ec2 describe-security-groups \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --filters \
                                        "Name=vpc-id,Values=${VPC_ID}" \
                                        "Name=group-name,Values=${ALB_SG_NAME}" \
                                    --query 'SecurityGroups[0].GroupId' \
                                    --output text)

                                if [ "${ALB_SG_ID}" = "None" ] ||
                                   [ -z "${ALB_SG_ID}" ]; then

                                    ALB_SG_ID=$(aws ec2 create-security-group \
                                        --region "${AWS_DEFAULT_REGION}" \
                                        --group-name "${ALB_SG_NAME}" \
                                        --description "ALB security group for ${APP_NAME}" \
                                        --vpc-id "${VPC_ID}" \
                                        --query 'GroupId' \
                                        --output text)

                                fi

                                ECS_SG_ID=$(aws ec2 describe-security-groups \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --filters \
                                        "Name=vpc-id,Values=${VPC_ID}" \
                                        "Name=group-name,Values=${ECS_SG_NAME}" \
                                    --query 'SecurityGroups[0].GroupId' \
                                    --output text)

                                if [ "${ECS_SG_ID}" = "None" ] ||
                                   [ -z "${ECS_SG_ID}" ]; then

                                    ECS_SG_ID=$(aws ec2 create-security-group \
                                        --region "${AWS_DEFAULT_REGION}" \
                                        --group-name "${ECS_SG_NAME}" \
                                        --description "ECS Fargate security group for ${APP_NAME}" \
                                        --vpc-id "${VPC_ID}" \
                                        --query 'GroupId' \
                                        --output text)

                                fi

                                aws ec2 authorize-security-group-ingress \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --group-id "${ALB_SG_ID}" \
                                    --ip-permissions \
                                    'IpProtocol=tcp,FromPort=80,ToPort=80,IpRanges=[{CidrIp=0.0.0.0/0}]' \
                                    2>/dev/null || true

                                aws ec2 authorize-security-group-ingress \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --group-id "${ECS_SG_ID}" \
                                    --ip-permissions \
                                    "IpProtocol=tcp,FromPort=${CONTAINER_PORT},ToPort=${CONTAINER_PORT},UserIdGroupPairs=[{GroupId=${ALB_SG_ID}}]" \
                                    2>/dev/null || true

                                echo "${ALB_SG_ID}|${ECS_SG_ID}"
                            ''',
                            returnStdout: true
                        ).trim()

                        def ids = securityGroupIds.split("\\|")

                        if (ids.size() != 2) {

                            error(
                                "Could not obtain ALB and ECS security group IDs."
                            )
                        }

                        env.ALB_SG_ID = ids[0].trim()
                        env.ECS_SG_ID = ids[1].trim()

                        echo "ALB SG: ${env.ALB_SG_ID}"
                        echo "ECS SG: ${env.ECS_SG_ID}"
                    }
                }
            }
        }


        stage('43 - Create Application Load Balancer') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        def albArn = sh(
                            script: '''
                                aws elbv2 describe-load-balancers \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --names "${ALB_NAME}" \
                                    --query 'LoadBalancers[0].LoadBalancerArn' \
                                    --output text \
                                    2>/dev/null || true
                            ''',
                            returnStdout: true
                        ).trim()

                        if (!albArn || albArn == 'None') {

                            albArn = sh(
                                script: '''
                                    aws elbv2 create-load-balancer \
                                        --region "${AWS_DEFAULT_REGION}" \
                                        --name "${ALB_NAME}" \
                                        --subnets "${SUBNET_1}" "${SUBNET_2}" \
                                        --security-groups "${ALB_SG_ID}" \
                                        --scheme internet-facing \
                                        --type application \
                                        --ip-address-type ipv4 \
                                        --query 'LoadBalancers[0].LoadBalancerArn' \
                                        --output text
                                ''',
                                returnStdout: true
                            ).trim()
                        }

                        if (!albArn || albArn == 'None') {

                            error(
                                'Could not create or find ALB.'
                            )
                        }

                        env.ALB_ARN = albArn

                        sh '''
                            set -e

                            aws elbv2 wait load-balancer-available \
                                --region "${AWS_DEFAULT_REGION}" \
                                --load-balancer-arns "${ALB_ARN}"
                        '''

                        env.ALB_DNS = sh(
                            script: '''
                                aws elbv2 describe-load-balancers \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --load-balancer-arns "${ALB_ARN}" \
                                    --query 'LoadBalancers[0].DNSName' \
                                    --output text
                            ''',
                            returnStdout: true
                        ).trim()

                        echo "ALB ARN : ${env.ALB_ARN}"
                        echo "ALB DNS : ${env.ALB_DNS}"
                    }
                }
            }
        }


        stage('44 - Create Target Group') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        def targetGroupArn = sh(
                            script: '''
                                aws elbv2 describe-target-groups \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --names "${TARGET_GROUP_NAME}" \
                                    --query 'TargetGroups[0].TargetGroupArn' \
                                    --output text \
                                    2>/dev/null || true
                            ''',
                            returnStdout: true
                        ).trim()

                        if (!targetGroupArn || targetGroupArn == 'None') {

                            targetGroupArn = sh(
                                script: '''
                                    aws elbv2 create-target-group \
                                        --region "${AWS_DEFAULT_REGION}" \
                                        --name "${TARGET_GROUP_NAME}" \
                                        --protocol HTTP \
                                        --port "${CONTAINER_PORT}" \
                                        --target-type ip \
                                        --vpc-id "${VPC_ID}" \
                                        --health-check-protocol HTTP \
                                        --health-check-path "/" \
                                        --health-check-port traffic-port \
                                        --matcher HttpCode=200-399 \
                                        --query 'TargetGroups[0].TargetGroupArn' \
                                        --output text
                                ''',
                                returnStdout: true
                            ).trim()
                        }

                        if (!targetGroupArn ||
                            targetGroupArn == 'None') {

                            error(
                                'Could not create or find target group.'
                            )
                        }

                        env.TARGET_GROUP_ARN = targetGroupArn

                        echo "Target Group ARN:"
                        echo "${env.TARGET_GROUP_ARN}"
                    }
                }
            }
        }


        stage('45 - Create ALB Listener') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        LISTENER_ARN=$(aws elbv2 describe-listeners \
                            --region "${AWS_DEFAULT_REGION}" \
                            --load-balancer-arn "${ALB_ARN}" \
                            --query 'Listeners[?Port==`80`].ListenerArn | [0]' \
                            --output text)

                        if [ "${LISTENER_ARN}" = "None" ] ||
                           [ -z "${LISTENER_ARN}" ]; then

                            aws elbv2 create-listener \
                                --region "${AWS_DEFAULT_REGION}" \
                                --load-balancer-arn "${ALB_ARN}" \
                                --protocol HTTP \
                                --port 80 \
                                --default-actions \
                                "Type=forward,TargetGroupArn=${TARGET_GROUP_ARN}"

                        else

                            aws elbv2 modify-listener \
                                --region "${AWS_DEFAULT_REGION}" \
                                --listener-arn "${LISTENER_ARN}" \
                                --default-actions \
                                "Type=forward,TargetGroupArn=${TARGET_GROUP_ARN}"

                        fi
                    '''
                }
            }
        }


        stage('46 - Create ECS Cluster') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        CLUSTER_STATUS=$(aws ecs describe-clusters \
                            --region "${AWS_DEFAULT_REGION}" \
                            --clusters "${ECS_CLUSTER}" \
                            --query 'clusters[0].status' \
                            --output text \
                            2>/dev/null || true)

                        if [ "${CLUSTER_STATUS}" = "ACTIVE" ]; then

                            echo "ECS cluster already exists."

                        else

                            aws ecs create-cluster \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster-name "${ECS_CLUSTER}"

                        fi

                        STATUS=$(aws ecs describe-clusters \
                            --region "${AWS_DEFAULT_REGION}" \
                            --clusters "${ECS_CLUSTER}" \
                            --query 'clusters[0].status' \
                            --output text)

                        if [ "${STATUS}" != "ACTIVE" ]; then

                            echo "ERROR: ECS cluster is not ACTIVE."

                            exit 1

                        fi

                        echo "ECS cluster is ACTIVE."
                    '''
                }
            }
        }


        stage('47 - Register ECS Fargate Task Definition') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        def taskDefinitionArn = sh(
                            script: '''
                                set -e

                                EXECUTION_ROLE_ARN=$(aws iam get-role \
                                    --role-name "practice1-ecsTaskExecutionRole" \
                                    --query 'Role.Arn' \
                                    --output text)

                                if [ -z "${EXECUTION_ROLE_ARN}" ] ||
                                   [ "${EXECUTION_ROLE_ARN}" = "None" ]; then

                                    echo "ERROR: ECS execution role ARN not found."

                                    exit 1

                                fi

                                cat > task-definition.json <<EOF
{
    "family": "${ECS_TASK_FAMILY}",
    "networkMode": "awsvpc",
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "${FARGATE_CPU}",
    "memory": "${FARGATE_MEMORY}",
    "executionRoleArn": "${EXECUTION_ROLE_ARN}",
    "containerDefinitions": [
        {
            "name": "${ECS_CONTAINER_NAME}",
            "image": "${ECR_IMAGE}",
            "essential": true,
            "portMappings": [
                {
                    "containerPort": ${CONTAINER_PORT},
                    "hostPort": ${CONTAINER_PORT},
                    "protocol": "tcp"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/${ECS_TASK_FAMILY}",
                    "awslogs-region": "${AWS_DEFAULT_REGION}",
                    "awslogs-stream-prefix": "ecs"
                }
            }
        }
    ]
}
EOF

                                aws logs create-log-group \
                                    --log-group-name "/ecs/${ECS_TASK_FAMILY}" \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    2>/dev/null || true

                                aws ecs register-task-definition \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --cli-input-json file://task-definition.json \
                                    --query 'taskDefinition.taskDefinitionArn' \
                                    --output text
                            ''',
                            returnStdout: true
                        ).trim()

                        if (!taskDefinitionArn ||
                            taskDefinitionArn == 'None') {

                            error(
                                'Could not register ECS task definition.'
                            )
                        }

                        env.TASK_DEFINITION_ARN = taskDefinitionArn

                        echo "Task Definition:"
                        echo "${env.TASK_DEFINITION_ARN}"
                    }
                }
            }
        }


        stage('48 - Create or Update ECS Fargate Service') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        SERVICE_STATUS=$(aws ecs describe-services \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}" \
                            --query 'services[0].status' \
                            --output text \
                            2>/dev/null || true)

                        if [ "${SERVICE_STATUS}" = "ACTIVE" ]; then

                            echo "Updating existing ECS service..."

                            aws ecs update-service \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --service "${ECS_SERVICE}" \
                                --task-definition "${TASK_DEFINITION_ARN}" \
                                --desired-count 1 \
                                --force-new-deployment

                        else

                            echo "Creating ECS service..."

                            aws ecs create-service \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --service-name "${ECS_SERVICE}" \
                                --task-definition "${TASK_DEFINITION_ARN}" \
                                --desired-count 1 \
                                --launch-type FARGATE \
                                --platform-version LATEST \
                                --network-configuration \
                                "awsvpcConfiguration={subnets=[${SUBNET_1},${SUBNET_2}],securityGroups=[${ECS_SG_ID}],assignPublicIp=ENABLED}" \
                                --load-balancers \
                                "targetGroupArn=${TARGET_GROUP_ARN},containerName=${ECS_CONTAINER_NAME},containerPort=${CONTAINER_PORT}"

                        fi

                        echo ""
                        echo "Waiting for ECS service to become stable..."

                        aws ecs wait services-stable \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}"

                        echo "ECS service deployment completed."
                    '''
                }
            }
        }


        stage('49 - Verify ECS Running Task') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        RUNNING_COUNT=$(aws ecs describe-services \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}" \
                            --query 'services[0].runningCount' \
                            --output text)

                        DESIRED_COUNT=$(aws ecs describe-services \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}" \
                            --query 'services[0].desiredCount' \
                            --output text)

                        echo "Desired tasks : ${DESIRED_COUNT}"
                        echo "Running tasks : ${RUNNING_COUNT}"

                        if [ "${RUNNING_COUNT}" -lt 1 ]; then

                            echo "ERROR: No running Fargate task."

                            exit 1

                        fi

                        TASK_ARN=$(aws ecs list-tasks \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --service-name "${ECS_SERVICE}" \
                            --desired-status RUNNING \
                            --query 'taskArns[0]' \
                            --output text)

                        if [ -z "${TASK_ARN}" ] ||
                           [ "${TASK_ARN}" = "None" ]; then

                            echo "ERROR: Could not find running ECS task."

                            exit 1

                        fi

                        echo ""
                        echo "Running Task:"
                        echo "${TASK_ARN}"

                        aws ecs describe-tasks \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --tasks "${TASK_ARN}" \
                            --query 'tasks[0].{TaskArn:taskArn,LastStatus:lastStatus}' \
                            --output table
                    '''
                }
            }
        }


        stage('50 - Verify ALB DNS') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        def albDns = sh(
                            script: '''
                                aws elbv2 describe-load-balancers \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --load-balancer-arns "${ALB_ARN}" \
                                    --query 'LoadBalancers[0].DNSName' \
                                    --output text
                            ''',
                            returnStdout: true
                        ).trim()

                        if (!albDns || albDns == 'None') {

                            error(
                                'Could not retrieve ALB DNS name.'
                            )
                        }

                        env.ALB_DNS = albDns
                        env.APPLICATION_URL = "http://${albDns}"

                        echo ""
                        echo "================================================"
                        echo "APPLICATION DEPLOYMENT URL"
                        echo "================================================"

                        echo "${env.APPLICATION_URL}"
                    }
                }
            }
        }


        stage('51 - Final Deployment Verification') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo ""
                        echo "================================================"
                        echo "FINAL DEPLOYMENT VERIFICATION"
                        echo "================================================"

                        echo ""
                        echo "AWS Region:"
                        echo "${AWS_DEFAULT_REGION}"

                        echo ""
                        echo "Terraform State Bucket:"
                        echo "${TF_STATE_BUCKET}"

                        echo ""
                        echo "Terraform Lock Table:"
                        echo "${TF_LOCK_TABLE}"

                        echo ""
                        echo "ECR Image URI:"
                        echo "${ECR_IMAGE}"

                        echo ""
                        echo "ECS Cluster:"
                        echo "${ECS_CLUSTER}"

                        echo ""
                        echo "ECS Service:"
                        echo "${ECS_SERVICE}"

                        echo ""
                        echo "Task Definition:"
                        echo "${TASK_DEFINITION_ARN}"

                        echo ""
                        echo "ALB:"
                        echo "${ALB_NAME}"

                        echo ""
                        echo "ALB DNS:"
                        echo "${ALB_DNS}"

                        echo ""
                        echo "================================================"
                        echo "APPLICATION URL"
                        echo "================================================"

                        echo "${APPLICATION_URL}"

                        echo ""
                        echo "================================================"
                        echo "DEPLOYMENT COMPLETE"
                        echo "================================================"
                    '''
                }
            }
        }
    }


    // ================================================================
    // POST ACTIONS
    // ================================================================

    post {

        success {

            echo ''

            echo '================================================'
            echo '       COMPLETE CI/CD PIPELINE SUCCESS'
            echo '================================================'

            echo ''

            echo 'PART 1 - CODE QUALITY : PASSED'
            echo 'PART 2 - TESTING      : PASSED'
            echo 'PART 3 - DOCKER       : PASSED'
            echo 'PART 4 - ECR          : PASSED'
            echo 'PART 5 - TERRAFORM    : PASSED'
            echo 'PART 6 - ECS FARGATE  : PASSED'
            echo 'PART 6 - ALB          : PASSED'

            echo ''

            echo '================================================'
            echo '          TERRAFORM BACKEND'
            echo '================================================'

            echo "S3 Bucket     : ${env.TF_STATE_BUCKET}"
            echo "State Key     : ${env.TF_STATE_KEY}"
            echo "DynamoDB Table: ${env.TF_LOCK_TABLE}"

            echo ''

            echo '================================================'
            echo '          FINAL APPLICATION URL'
            echo '================================================'

            echo "${env.APPLICATION_URL}"

            echo ''

            echo '================================================'
            echo '          DEPLOYMENT COMPLETE'
            echo '================================================'
        }


        failure {

            echo ''

            echo '================================================'
            echo '          CI/CD PIPELINE FAILED'
            echo '================================================'

            echo ''

            echo 'The pipeline stopped because a deployment stage failed.'

            echo ''

            echo 'Check the Jenkins console output above.'

            echo ''

            echo '================================================'
        }


        always {

            echo ''

            echo '================================================'
            echo 'CLEANING JENKINS WORKSPACE'
            echo '================================================'

            cleanWs(
                deleteDirs: true,
                disableDeferredWipeout: true
            )
        }
    }
}
