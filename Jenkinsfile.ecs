pipeline {

    agent any

    // ================================================================
    // PIPELINE OPTIONS
    // ================================================================

    options {

        timestamps()

        ansiColor('xterm')

        // Prevent two builds from changing the same workspace
        // at the same time.
        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                daysToKeepStr: '30',
                numToKeepStr: '50'
            )
        )

        timeout(
            time: 30,
            unit: 'MINUTES'
        )
    }


    // ================================================================
    // ENVIRONMENT
    // ================================================================

    environment {

        // ------------------------------------------------------------
        // APPLICATION REPOSITORY
        // ------------------------------------------------------------

        APP_REPO =
            'https://github.com/FAIZANSHEIKH223/practice1.git'

        APP_BRANCH = 'main'


        // ------------------------------------------------------------
        // QUALITY REPOSITORY
        // ------------------------------------------------------------

        QUALITY_REPO =
            'https://github.com/FAIZANSHEIKH223/pylint_flake8_int_jenkins.git'

        QUALITY_BRANCH = 'main'


        // ------------------------------------------------------------
        // JENKINS GITHUB CREDENTIAL
        // ------------------------------------------------------------

        GITHUB_CREDENTIALS = 'github-creds'


        // ------------------------------------------------------------
        // PYTHON
        // ------------------------------------------------------------

        PYTHON = 'python3.12'


        // ------------------------------------------------------------
        // WORKSPACE DIRECTORIES
        // ------------------------------------------------------------

        APP_DIR = 'practice1'

        QUALITY_DIR = 'quality-tools'

        VENV_DIR = 'venv'

        REPORT_DIR = 'reports'
    }


    // ================================================================
    // STAGES
    // ================================================================

    stages {


        // ============================================================
        // STAGE 1
        // CHECKOUT APPLICATION
        // ============================================================

        stage('1 - Checkout Application') {

            steps {

                echo ''
                echo '================================================'
                echo 'CHECKOUT APPLICATION'
                echo '================================================'
                echo "Repository : ${APP_REPO}"
                echo "Branch     : ${APP_BRANCH}"
                echo '================================================'

                dir("${APP_DIR}") {

                    git(
                        branch: "${APP_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${APP_REPO}"
                    )
                }
            }
        }


        // ============================================================
        // STAGE 2
        // CHECKOUT QUALITY REPOSITORY
        // ============================================================

        stage('2 - Checkout Quality Repository') {

            steps {

                echo ''
                echo '================================================'
                echo 'CHECKOUT QUALITY REPOSITORY'
                echo '================================================'
                echo "Repository : ${QUALITY_REPO}"
                echo "Branch     : ${QUALITY_BRANCH}"
                echo '================================================'

                dir("${QUALITY_DIR}") {

                    git(
                        branch: "${QUALITY_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${QUALITY_REPO}"
                    )
                }
            }
        }


        // ============================================================
        // STAGE 3
        // VERIFY PYTHON
        // ============================================================

        stage('3 - Verify Python') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo ""
                        echo "================================================"
                        echo "VERIFYING PYTHON"
                        echo "================================================"

                        command -v ${PYTHON}

                        ${PYTHON} --version

                        echo ""
                        echo "================================================"
                        echo "VERIFYING PIP"
                        echo "================================================"

                        ${PYTHON} -m pip --version

                        echo ""
                        echo "Python environment verification completed."
                    '''
                }
            }
        }


        // ============================================================
        // STAGE 4
        // CREATE VIRTUAL ENVIRONMENT
        // ============================================================

        stage('4 - Create Python Virtual Environment') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo ""
                        echo "================================================"
                        echo "CREATING VIRTUAL ENVIRONMENT"
                        echo "================================================"

                        # Remove only the previous CI virtual
                        # environment.
                        #
                        # This makes repeated builds clean and
                        # predictable.

                        rm -rf "${VENV_DIR}"

                        ${PYTHON} -m venv "${VENV_DIR}"

                        echo ""
                        echo "Virtual environment created."

                        "${VENV_DIR}/bin/python" --version
                    '''
                }
            }
        }


        // ============================================================
        // STAGE 5
        // INSTALL APPLICATION DEPENDENCIES
        // ============================================================

        stage('5 - Install Application Dependencies') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo ""
                        echo "================================================"
                        echo "INSTALLING APPLICATION DEPENDENCIES"
                        echo "================================================"

                        "${VENV_DIR}/bin/python" \
                            -m pip install --upgrade pip

                        if [ -f requirements.txt ]; then

                            echo ""
                            echo "requirements.txt found."

                            "${VENV_DIR}/bin/pip" \
                                install \
                                -r requirements.txt

                        else

                            echo ""
                            echo "No requirements.txt found."

                            echo "No application dependencies to install."

                        fi

                        echo ""
                        echo "Application dependency installation completed."
                    '''
                }
            }
        }


        // ============================================================
        // STAGE 6
        // INSTALL FLAKE8 + PYLINT
        // ============================================================

        stage('6 - Install Quality Tools') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo ""
                        echo "================================================"
                        echo "INSTALLING QUALITY TOOLS"
                        echo "================================================"

                        "${VENV_DIR}/bin/pip" install \
                            flake8 \
                            pylint

                        echo ""
                        echo "================================================"
                        echo "FLAKE8 VERSION"
                        echo "================================================"

                        "${VENV_DIR}/bin/flake8" --version

                        echo ""
                        echo "================================================"
                        echo "PYLINT VERSION"
                        echo "================================================"

                        "${VENV_DIR}/bin/pylint" --version

                        echo ""
                        echo "Quality tools installed successfully."
                    '''
                }
            }
        }


        // ============================================================
        // STAGE 7
        // FLAKE8
        // ============================================================

        stage('7 - Flake8 Code Quality') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo ""
                        echo "================================================"
                        echo "RUNNING FLAKE8"
                        echo "================================================"

                        mkdir -p "${REPORT_DIR}"

                        "${VENV_DIR}/bin/flake8" \
                            . \
                            --exclude="${VENV_DIR},.git,${REPORT_DIR},__pycache__" \
                            --count \
                            --statistics \
                            --tee \
                            --output-file="${REPORT_DIR}/flake8-report.txt"

                        echo ""
                        echo "================================================"
                        echo "FLAKE8 PASSED"
                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // STAGE 8
        // PYLINT
        // ============================================================

        stage('8 - Pylint Code Quality') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo ""
                        echo "================================================"
                        echo "RUNNING PYLINT"
                        echo "================================================"

                        mkdir -p "${REPORT_DIR}"

                        "${VENV_DIR}/bin/pylint" \
                            . \
                            --output-format=text \
                            > "${REPORT_DIR}/pylint-report.txt"

                        echo ""
                        echo "================================================"
                        echo "PYLINT PASSED"
                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // STAGE 9
        // PART 1 SUCCESS
        // ============================================================

        stage('9 - Part 1 Success') {

            steps {

                echo ''
                echo '================================================'
                echo '           PART 1 CI SUCCESS'
                echo '================================================'
                echo ''
                echo 'Application Repository : practice1'
                echo 'Quality Repository     : pylint_flake8_int_jenkins'
                echo 'Python                 : 3.12'
                echo ''
                echo 'Checkout               : PASSED'
                echo 'Python Environment     : PASSED'
                echo 'Dependencies           : PASSED'
                echo 'Flake8                 : PASSED'
                echo 'Pylint                 : PASSED'
                echo ''
                echo '================================================'
                echo '       READY FOR PART 2'
                echo '================================================'
            }
        }
    }


    // ================================================================
    // POST ACTIONS
    // ================================================================

    post {

        success {

            echo ''
            echo '================================================'
            echo '          PART 1 PIPELINE SUCCESS'
            echo '================================================'
            echo ''
            echo 'All Part 1 stages completed successfully.'
            echo ''
            echo 'Do NOT add Docker/ECR/Terraform yet.'
            echo 'Part 1 is complete.'
            echo '================================================'
        }


        failure {

            echo ''
            echo '================================================'
            echo '          PART 1 PIPELINE FAILED'
            echo '================================================'
            echo ''
            echo 'The pipeline stopped at the failed stage.'
            echo ''
            echo 'Fix Part 1 before continuing to Part 2.'
            echo '================================================'
        }


        always {

            echo ''
            echo '================================================'
            echo 'CLEANING JENKINS WORKSPACE'
            echo '================================================'

            cleanWs(
                deleteDirs: true,
                disableDeferredWipeout: true
            )
        }
    }
}
