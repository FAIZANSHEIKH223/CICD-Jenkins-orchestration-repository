pipeline {

    agent any

    // ================================================================
    // PIPELINE OPTIONS
    // ================================================================

    options {

        timestamps()

        ansiColor('xterm')

        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                daysToKeepStr: '30',
                numToKeepStr: '50'
            )
        )

        timeout(
            time: 90,
            unit: 'MINUTES'
        )
    }


    // ================================================================
    // PARAMETERS
    // ================================================================

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: [
                'dev',
                'qa',
                'stage',
                'prod'
            ],
            description: 'Terraform environment to deploy'
        )
    }


    // ================================================================
    // ENVIRONMENT
    // ================================================================

    environment {

        // ------------------------------------------------------------
        // APPLICATION
        // ------------------------------------------------------------

        APP_REPO =
            'https://github.com/FAIZANSHEIKH223/practice1.git'

        APP_BRANCH = 'main'


        // ------------------------------------------------------------
        // QUALITY
        // ------------------------------------------------------------

        QUALITY_REPO =
            'https://github.com/FAIZANSHEIKH223/pylint_flake8_int_jenkins.git'

        QUALITY_BRANCH = 'main'


        // ------------------------------------------------------------
        // TERRAFORM
        // ------------------------------------------------------------

        TERRAFORM_REPO =
            'https://github.com/FAIZANSHEIKH223/terraform-aws-infra.git'

        TERRAFORM_BRANCH = 'main'


        // ------------------------------------------------------------
        // JENKINS CREDENTIALS
        // ------------------------------------------------------------

        GITHUB_CREDENTIALS = 'github-creds'

        AWS_CREDENTIALS = 'aws-creds'

        DEPLOY_SSH_CREDENTIALS = 'deploy-ssh-key'


        // ------------------------------------------------------------
        // DIRECTORIES
        // ------------------------------------------------------------

        APP_DIR = 'practice1'

        QUALITY_DIR = 'quality-tools'

        TERRAFORM_DIR = 'terraform-infra'

        VENV_DIR = 'venv'

        REPORT_DIR = 'reports'


        // ------------------------------------------------------------
        // PYTHON
        // ------------------------------------------------------------

        PYTHON = 'python3.12'


        // ------------------------------------------------------------
        // DOCKER
        // ------------------------------------------------------------

        DOCKER_IMAGE_NAME = 'practice1'

        DOCKER_IMAGE_TAG = "${BUILD_NUMBER}"

        DOCKER_IMAGE =
            "${DOCKER_IMAGE_NAME}:${DOCKER_IMAGE_TAG}"


        // ------------------------------------------------------------
        // AWS
        // ------------------------------------------------------------

        AWS_DEFAULT_REGION = 'us-east-1'

        AWS_REGION = 'us-east-1'


        // ------------------------------------------------------------
        // ECR
        // ------------------------------------------------------------

        ECR_REPOSITORY = 'practice1'

        ECR_IMAGE_TAG = "${BUILD_NUMBER}"


        // ------------------------------------------------------------
        // TERRAFORM BACKEND
        // ------------------------------------------------------------

        TF_STATE_BUCKET =
            'terraform-state-faizan-001'

        TF_LOCK_TABLE =
            'terraform-locks'


        // ------------------------------------------------------------
        // TERRAFORM
        // ------------------------------------------------------------

        TF_IN_AUTOMATION = 'true'

        TF_INPUT = 'false'


        // ------------------------------------------------------------
        // DEPLOYMENT
        // ------------------------------------------------------------

        DEPLOY_USER = 'ubuntu'

        CONTAINER_NAME = 'practice1'

        CONTAINER_PORT = '8501'

        HOST_PORT = '8501'


        // ------------------------------------------------------------
        // DEPLOYMENT EC2 TAG
        // ------------------------------------------------------------

        DEPLOY_INSTANCE_ROLE = 'application'
    }


    // ================================================================
    // STAGES
    // ================================================================

    stages {


        // ============================================================
        // PART 1 - CODE QUALITY
        // ============================================================

        stage('1 - Checkout Application') {

            steps {

                echo '================================================'
                echo 'CHECKOUT APPLICATION'
                echo '================================================'

                dir("${APP_DIR}") {

                    git(
                        branch: "${APP_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${APP_REPO}"
                    )
                }
            }
        }


        stage('2 - Checkout Quality Repository') {

            steps {

                echo '================================================'
                echo 'CHECKOUT QUALITY REPOSITORY'
                echo '================================================'

                dir("${QUALITY_DIR}") {

                    git(
                        branch: "${QUALITY_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${QUALITY_REPO}"
                    )
                }
            }
        }


        stage('3 - Verify Python') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "VERIFYING PYTHON"
                        echo "================================================"

                        command -v "${PYTHON}"

                        "${PYTHON}" --version

                        "${PYTHON}" -m pip --version
                    '''
                }
            }
        }


        stage('4 - Create Python Virtual Environment') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "CREATING VIRTUAL ENVIRONMENT"
                        echo "================================================"

                        rm -rf "${VENV_DIR}"

                        "${PYTHON}" -m venv "${VENV_DIR}"

                        "${VENV_DIR}/bin/python" --version
                    '''
                }
            }
        }


        stage('5 - Install Application Dependencies') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "INSTALLING APPLICATION DEPENDENCIES"
                        echo "================================================"

                        "${VENV_DIR}/bin/python" \
                            -m pip install --upgrade pip

                        if [ -f requirements.txt ]; then

                            "${VENV_DIR}/bin/pip" \
                                install \
                                -r requirements.txt

                        else

                            echo "No requirements.txt found."

                        fi
                    '''
                }
            }
        }


        stage('6 - Install Quality Tools') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "INSTALLING QUALITY TOOLS"
                        echo "================================================"

                        "${VENV_DIR}/bin/pip" install \
                            flake8 \
                            pylint

                        "${VENV_DIR}/bin/flake8" --version

                        "${VENV_DIR}/bin/pylint" --version
                    '''
                }
            }
        }


        stage('7 - Flake8 Code Quality') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "RUNNING FLAKE8"
                        echo "================================================"

                        mkdir -p "${REPORT_DIR}"

                        "${VENV_DIR}/bin/flake8" \
                            . \
                            --exclude="${VENV_DIR},.git,${REPORT_DIR},__pycache__" \
                            --count \
                            --statistics \
                            --tee \
                            --output-file="${REPORT_DIR}/flake8-report.txt"
                    '''
                }
            }
        }


        stage('8 - Pylint Code Quality') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "RUNNING PYLINT"
                        echo "================================================"

                        mkdir -p "${REPORT_DIR}"

                        PYTHON_FILES=$(find . \
                            -type f \
                            -name "*.py" \
                            ! -path "./${VENV_DIR}/*" \
                            ! -path "./.git/*" \
                            ! -path "./${REPORT_DIR}/*" \
                            ! -path "*/__pycache__/*")

                        if [ -z "${PYTHON_FILES}" ]; then

                            echo "ERROR: No Python files found."

                            exit 1

                        fi

                        "${VENV_DIR}/bin/pylint" \
                            ${PYTHON_FILES} \
                            --output-format=text \
                            > "${REPORT_DIR}/pylint-report.txt"
                    '''
                }
            }
        }


        stage('9 - Part 1 Success') {

            steps {

                echo '================================================'
                echo 'PART 1 CI SUCCESS'
                echo '================================================'

                echo 'Flake8 : PASSED'
                echo 'Pylint : PASSED'

                echo 'STARTING PART 2 - TESTING'
            }
        }


        // ============================================================
        // PART 2 - TESTING
        // ============================================================

        stage('10 - Install Pytest') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "INSTALLING PYTEST"
                        echo "================================================"

                        "${VENV_DIR}/bin/pip" install pytest

                        "${VENV_DIR}/bin/pytest" --version
                    '''
                }
            }
        }


        stage('11 - Verify Tests') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "VERIFYING TESTS"
                        echo "================================================"

                        if [ ! -d "tests" ]; then

                            echo "ERROR: tests/ directory does not exist."

                            exit 1

                        fi

                        TEST_FILES=$(find tests \
                            -type f \
                            \\( \
                                -name "test_*.py" \
                                -o \
                                -name "*_test.py" \
                            \\))

                        if [ -z "${TEST_FILES}" ]; then

                            echo "ERROR: No pytest test files found."

                            exit 1

                        fi

                        echo "Test files:"
                        echo "${TEST_FILES}"
                    '''
                }
            }
        }


        stage('12 - Run Automated Tests') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "RUNNING AUTOMATED TESTS"
                        echo "================================================"

                        mkdir -p "${REPORT_DIR}"

                        "${VENV_DIR}/bin/pytest" \
                            tests/ \
                            -v \
                            --junitxml="${REPORT_DIR}/pytest-results.xml"
                    '''
                }
            }
        }


        stage('13 - Publish Test Results') {

            steps {

                junit(
                    testResults:
                        "${APP_DIR}/${REPORT_DIR}/pytest-results.xml",
                    allowEmptyResults: false
                )

                archiveArtifacts(
                    artifacts:
                        "${APP_DIR}/${REPORT_DIR}/pytest-results.xml," +
                        "${APP_DIR}/${REPORT_DIR}/flake8-report.txt," +
                        "${APP_DIR}/${REPORT_DIR}/pylint-report.txt",
                    allowEmptyArchive: false,
                    fingerprint: true
                )
            }
        }


        stage('14 - Part 2 Success') {

            steps {

                echo '================================================'
                echo 'PART 2 CI SUCCESS'
                echo '================================================'

                echo 'Pytest : PASSED'
                echo 'Tests  : PASSED'

                echo 'STARTING PART 3 - DOCKER'
            }
        }


        // ============================================================
        // PART 3 - DOCKER
        // ============================================================

        stage('15 - Verify Docker') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "VERIFYING DOCKER"
                        echo "================================================"

                        command -v docker

                        docker --version

                        if ! docker info > /dev/null 2>&1; then

                            echo "ERROR: Jenkins cannot access Docker daemon."

                            sudo systemctl status docker \
                                --no-pager \
                                || true

                            exit 1

                        fi

                        echo "Docker daemon is accessible."

                        echo ""
                        echo "Docker disk usage:"
                        docker system df || true

                        echo ""
                        echo "Filesystem usage:"
                        df -h
                    '''
                }
            }
        }


        stage('16 - Verify Dockerfile') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "VERIFYING DOCKERFILE"
                        echo "================================================"

                        if [ ! -f "Dockerfile" ]; then

                            echo "ERROR: Dockerfile was not found."

                            exit 1

                        fi

                        echo "Dockerfile found."

                        cat Dockerfile
                    '''
                }
            }
        }


        // ------------------------------------------------------------
        // CRITICAL FIX
        //
        // The Jenkins venv contains hundreds of MB of packages.
        // Docker must NEVER receive this directory as build context.
        // ------------------------------------------------------------

        stage('17 - Prepare Docker Build Context') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "PREPARING DOCKER BUILD CONTEXT"
                        echo "================================================"

                        echo ""
                        echo "Creating .dockerignore..."

                        cat > .dockerignore <<'EOF'
venv/
.venv/
env/
ENV/

.git/
.gitignore/

reports/
.pytest_cache/
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd

.pytest_cache/
.mypy_cache/
.ruff_cache/

*.log
*.tmp
*.temp

.DS_Store

node_modules/

terraform/
terraform-infra/

coverage/
htmlcov/
.coverage
.coverage.*

*.egg-info/
dist/
build/

Jenkinsfile
EOF

                        echo ""
                        echo "Generated .dockerignore:"
                        cat .dockerignore

                        echo ""
                        echo "Checking application size BEFORE Docker build..."

                        du -sh . || true

                        echo ""
                        echo "Largest directories:"
                        du -sh ./* 2>/dev/null | sort -hr | head -20 || true

                        echo ""
                        echo "Checking Docker build context..."

                        CONTEXT_SIZE=$(tar \
                            -cf - \
                            --exclude-from=.dockerignore \
                            . 2>/dev/null \
                            | wc -c)

                        echo "Approximate Docker context size:"
                        echo "${CONTEXT_SIZE} bytes"

                        echo ""
                        echo "Docker build context prepared successfully."
                    '''
                }
            }
        }


        // ------------------------------------------------------------
        // Docker cleanup is intentionally AFTER Parts 1 and 2.
        // Therefore it cannot affect your quality/test stages.
        // ------------------------------------------------------------

        stage('18 - Clean Docker Build Cache') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "CLEANING DOCKER BUILD CACHE"
                        echo "================================================"

                        echo ""
                        echo "Docker disk usage BEFORE cleanup:"
                        docker system df || true

                        echo ""
                        echo "Removing unused build cache..."

                        docker builder prune \
                            --all \
                            --force \
                            || true

                        echo ""
                        echo "Removing dangling images..."

                        docker image prune \
                            --force \
                            || true

                        echo ""
                        echo "Docker disk usage AFTER cleanup:"
                        docker system df || true

                        echo ""
                        echo "Filesystem usage:"
                        df -h

                        echo ""
                        echo "Docker cache cleanup completed."
                    '''
                }
            }
        }


        stage('19 - Build Docker Image') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "BUILDING DOCKER IMAGE"
                        echo "================================================"

                        echo "Image : ${DOCKER_IMAGE}"

                        echo ""
                        echo "Filesystem BEFORE Docker build:"
                        df -h

                        echo ""
                        echo "Docker disk usage BEFORE Docker build:"
                        docker system df || true

                        echo ""
                        echo "Building Docker image..."

                        docker build \
                            --tag "${DOCKER_IMAGE}" \
                            .

                        echo ""
                        echo "Docker image inspect..."

                        docker image inspect \
                            "${DOCKER_IMAGE}" \
                            > /dev/null

                        echo ""
                        echo "Docker image created successfully."

                        echo ""
                        echo "Docker image:"
                        docker images "${DOCKER_IMAGE_NAME}"

                        echo ""
                        echo "Filesystem AFTER Docker build:"
                        df -h
                    '''
                }
            }
        }


        stage('20 - Part 3 Success') {

            steps {

                echo '================================================'
                echo 'PART 3 DOCKER SUCCESS'
                echo '================================================'

                echo "Docker Image : ${DOCKER_IMAGE}"

                echo 'STARTING PART 4 - AWS ECR'
            }
        }


        // ============================================================
        // PART 4 - AWS ECR
        // ============================================================

        stage('21 - Verify AWS CLI') {

            steps {

                sh '''
                    set -e

                    echo "================================================"
                    echo "VERIFYING AWS CLI"
                    echo "================================================"

                    command -v aws

                    aws --version
                '''
            }
        }


        stage('22 - Verify AWS Credentials') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        aws sts get-caller-identity \
                            --region "${AWS_DEFAULT_REGION}"
                    '''
                }
            }
        }


        stage('23 - Create ECR Repository If Required') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        if aws ecr describe-repositories \
                            --repository-names "${ECR_REPOSITORY}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            > /dev/null 2>&1
                        then

                            echo "ECR repository already exists."

                        else

                            echo "Creating ECR repository..."

                            aws ecr create-repository \
                                --repository-name "${ECR_REPOSITORY}" \
                                --region "${AWS_DEFAULT_REGION}"

                        fi
                    '''
                }
            }
        }


        stage('24 - Get ECR Registry') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        def accountId = sh(
                            script: '''
                                aws sts get-caller-identity \
                                    --query Account \
                                    --output text \
                                    --region "${AWS_DEFAULT_REGION}"
                            ''',
                            returnStdout: true
                        ).trim()

                        env.AWS_ACCOUNT_ID = accountId

                        env.ECR_REGISTRY =
                            "${accountId}.dkr.ecr.${AWS_DEFAULT_REGION}.amazonaws.com"

                        env.ECR_IMAGE =
                            "${env.ECR_REGISTRY}/${env.ECR_REPOSITORY}:${env.ECR_IMAGE_TAG}"

                        echo "AWS Account ID : ${env.AWS_ACCOUNT_ID}"
                        echo "ECR Registry   : ${env.ECR_REGISTRY}"
                        echo "ECR Image      : ${env.ECR_IMAGE}"
                    }
                }
            }
        }


        stage('25 - Login Docker to ECR') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        aws ecr get-login-password \
                            --region "${AWS_DEFAULT_REGION}" \
                        | docker login \
                            --username AWS \
                            --password-stdin "${ECR_REGISTRY}"
                    '''
                }
            }
        }


        stage('26 - Tag Docker Image for ECR') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        docker tag \
                            "${DOCKER_IMAGE}" \
                            "${ECR_IMAGE}"

                        docker image inspect \
                            "${ECR_IMAGE}" \
                            > /dev/null
                    '''
                }
            }
        }


        stage('27 - Push Docker Image to ECR') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        docker push "${ECR_IMAGE}"
                    '''
                }
            }
        }


        stage('28 - Verify Image in ECR') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        aws ecr describe-images \
                            --repository-name "${ECR_REPOSITORY}" \
                            --image-ids imageTag="${ECR_IMAGE_TAG}" \
                            --region "${AWS_DEFAULT_REGION}"
                    '''
                }
            }
        }


        stage('29 - Part 4 Success') {

            steps {

                echo '================================================'
                echo 'PART 4 AWS ECR SUCCESS'
                echo '================================================'

                echo "ECR Image : ${ECR_IMAGE}"

                echo 'STARTING PART 5 - TERRAFORM'
            }
        }


        // ============================================================
        // PART 5 - TERRAFORM
        // ============================================================

        stage('30 - Checkout Terraform Repository') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    git(
                        branch: "${TERRAFORM_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${TERRAFORM_REPO}"
                    )
                }
            }
        }


        stage('31 - Bootstrap Terraform Backend') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "BOOTSTRAPPING TERRAFORM BACKEND"
                        echo "================================================"

                        aws sts get-caller-identity \
                            --region "${AWS_DEFAULT_REGION}"


                        if aws s3api head-bucket \
                            --bucket "${TF_STATE_BUCKET}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            > /dev/null 2>&1
                        then

                            echo "S3 state bucket already exists."

                        else

                            aws s3api create-bucket \
                                --bucket "${TF_STATE_BUCKET}" \
                                --region "${AWS_DEFAULT_REGION}"

                        fi


                        aws s3api put-bucket-versioning \
                            --bucket "${TF_STATE_BUCKET}" \
                            --versioning-configuration Status=Enabled \
                            --region "${AWS_DEFAULT_REGION}"


                        aws s3api put-bucket-encryption \
                            --bucket "${TF_STATE_BUCKET}" \
                            --server-side-encryption-configuration '{
                                "Rules": [
                                    {
                                        "ApplyServerSideEncryptionByDefault": {
                                            "SSEAlgorithm": "AES256"
                                        }
                                    }
                                ]
                            }' \
                            --region "${AWS_DEFAULT_REGION}"


                        aws s3api put-public-access-block \
                            --bucket "${TF_STATE_BUCKET}" \
                            --public-access-block-configuration \
                            BlockPublicAcls=true,IgnorePublicAcls=true,BlockPublicPolicy=true,RestrictPublicBuckets=true \
                            --region "${AWS_DEFAULT_REGION}"


                        if aws dynamodb describe-table \
                            --table-name "${TF_LOCK_TABLE}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            > /dev/null 2>&1
                        then

                            echo "DynamoDB lock table already exists."

                        else

                            aws dynamodb create-table \
                                --table-name "${TF_LOCK_TABLE}" \
                                --attribute-definitions \
                                AttributeName=LockID,AttributeType=S \
                                --key-schema \
                                AttributeName=LockID,KeyType=HASH \
                                --billing-mode PAY_PER_REQUEST \
                                --region "${AWS_DEFAULT_REGION}"

                            aws dynamodb wait table-exists \
                                --table-name "${TF_LOCK_TABLE}" \
                                --region "${AWS_DEFAULT_REGION}"

                        fi


                        echo "Terraform backend ready."
                    '''
                }
            }
        }


        stage('32 - Verify Terraform') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    sh '''
                        set -e

                        command -v terraform

                        terraform version

                        find . \
                            -maxdepth 1 \
                            -type f \
                            -name "*.tf" \
                            -print
                    '''
                }
            }
        }


        stage('33 - Verify Terraform AWS Credentials') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh '''
                            set -e

                            aws sts get-caller-identity \
                                --region "${AWS_DEFAULT_REGION}"
                        '''
                    }
                }
            }
        }


        stage('34 - Verify Terraform Environment') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    sh '''
                        set -e

                        echo "Selected Environment : ${ENVIRONMENT}"

                        if [ ! -d "environments/${ENVIRONMENT}" ]; then

                            echo "ERROR: Environment directory does not exist."

                            exit 1

                        fi


                        if [ ! -f "environments/${ENVIRONMENT}/terraform.tfvars" ]; then

                            echo "ERROR: terraform.tfvars not found."

                            exit 1

                        fi


                        TF_FILE_COUNT=$(find . \
                            -maxdepth 1 \
                            -type f \
                            -name "*.tf" \
                            | wc -l)


                        if [ "${TF_FILE_COUNT}" -eq 0 ]; then

                            echo "ERROR: No Terraform files found."

                            exit 1

                        fi


                        echo "Terraform environment verified."
                    '''
                }
            }
        }


        stage('35 - Terraform Init') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh '''
                            set -e

                            echo "================================================"
                            echo "TERRAFORM INIT"
                            echo "================================================"

                            echo ""
                            echo "Verifying AWS credentials available to Terraform..."

                            aws sts get-caller-identity \
                                --region "${AWS_DEFAULT_REGION}"


                            echo ""
                            echo "Filesystem before Terraform init:"

                            df -h


                            echo ""
                            echo "Cleaning old Terraform temporary files..."

                            rm -rf .terraform 2>/dev/null || true

                            rm -rf /tmp/terraform-* 2>/dev/null || true


                            echo ""
                            echo "Initializing Terraform..."

                            terraform init \
                                -input=false \
                                -upgrade=false


                            echo ""
                            echo "Terraform init completed successfully."

                            echo ""
                            echo "Filesystem after Terraform init:"

                            df -h
                        '''
                    }
                }
            }
        }


        stage('36 - Terraform Validate') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    sh '''
                        set -e

                        terraform validate
                    '''
                }
            }
        }


        stage('37 - Terraform Plan') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh '''
                            set -e

                            terraform plan \
                                -input=false \
                                -var-file="environments/${ENVIRONMENT}/terraform.tfvars" \
                                -out="tfplan"
                        '''
                    }
                }
            }
        }


        stage('38 - Terraform Apply') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh '''
                            set -e

                            if [ ! -f "tfplan" ]; then

                                echo "ERROR: tfplan not found."

                                exit 1

                            fi


                            terraform apply \
                                -input=false \
                                -auto-approve \
                                "tfplan"
                        '''
                    }
                }
            }
        }


        stage('39 - Verify Terraform Deployment') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh '''
                            set -e

                            terraform state list || true

                            terraform output || true


                            aws sts get-caller-identity \
                                --region "${AWS_DEFAULT_REGION}"


                            aws s3api head-bucket \
                                --bucket "${TF_STATE_BUCKET}" \
                                --region "${AWS_DEFAULT_REGION}"


                            aws dynamodb describe-table \
                                --table-name "${TF_LOCK_TABLE}" \
                                --region "${AWS_DEFAULT_REGION}" \
                                --query 'Table.TableStatus' \
                                --output text


                            echo "Terraform deployment verification PASSED."
                        '''
                    }
                }
            }
        }


        stage('40 - Part 5 Success') {

            steps {

                echo '================================================'
                echo 'PART 5 TERRAFORM SUCCESS'
                echo '================================================'

                echo "Environment : ${params.ENVIRONMENT}"

                echo 'Terraform Apply : PASSED'

                echo 'STARTING PART 6 - APPLICATION DEPLOYMENT'
            }
        }


        // ============================================================
        // PART 6 - APPLICATION DEPLOYMENT
        // ============================================================

        stage('41 - Locate Deployment EC2') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        echo '================================================'
                        echo 'LOCATING DEPLOYMENT EC2'
                        echo '================================================'


                        def instanceId = sh(
                            script: '''
                                aws ec2 describe-instances \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --filters \
                                        "Name=instance-state-name,Values=running" \
                                        "Name=tag:Role,Values=${DEPLOY_INSTANCE_ROLE}" \
                                        "Name=tag:Environment,Values=${ENVIRONMENT}" \
                                    --query 'Reservations[].Instances[].InstanceId' \
                                    --output text
                            ''',
                            returnStdout: true
                        ).trim()


                        if (!instanceId || instanceId == 'None') {

                            sh '''
                                echo ""
                                echo "Running EC2 instances:"
                                echo ""

                                aws ec2 describe-instances \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --filters \
                                        "Name=instance-state-name,Values=running" \
                                    --query 'Reservations[].Instances[].{
                                        InstanceId:InstanceId,
                                        PrivateIP:PrivateIpAddress,
                                        PublicIP:PublicIpAddress,
                                        Role:Tags[?Key==`Role`]|[0].Value,
                                        Environment:Tags[?Key==`Environment`]|[0].Value
                                    }' \
                                    --output table
                            '''


                            error(
                                "No running EC2 instance found with " +
                                "Role=${DEPLOY_INSTANCE_ROLE} " +
                                "and Environment=${params.ENVIRONMENT}"
                            )
                        }


                        def instanceList =
                            instanceId.split("\\s+")


                        if (instanceList.size() != 1) {

                            error(
                                "Expected exactly one deployment EC2. " +
                                "Found ${instanceList.size()}: ${instanceId}"
                            )
                        }


                        env.DEPLOY_INSTANCE_ID =
                            instanceList[0]


                        def publicIp = sh(
                            script: """
                                aws ec2 describe-instances \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --instance-ids "${env.DEPLOY_INSTANCE_ID}" \
                                    --query 'Reservations[0].Instances[0].PublicIpAddress' \
                                    --output text
                            """,
                            returnStdout: true
                        ).trim()


                        if (!publicIp || publicIp == 'None') {

                            error(
                                "Deployment EC2 does not have a public IP."
                            )
                        }


                        env.DEPLOY_HOST = publicIp


                        echo "Deployment Instance : ${env.DEPLOY_INSTANCE_ID}"
                        echo "Deployment Host     : ${env.DEPLOY_HOST}"
                        echo "Environment         : ${params.ENVIRONMENT}"
                    }
                }
            }
        }


        stage('42 - Verify Deployment EC2 SSH') {

            steps {

                sshagent(
                    credentials: ["${DEPLOY_SSH_CREDENTIALS}"]
                ) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "VERIFYING EC2 SSH CONNECTION"
                        echo "================================================"

                        mkdir -p ~/.ssh

                        chmod 700 ~/.ssh


                        ssh-keyscan \
                            -H \
                            "${DEPLOY_HOST}" \
                            >> ~/.ssh/known_hosts 2>/dev/null || true


                        ssh \
                            -o StrictHostKeyChecking=yes \
                            -o ConnectTimeout=20 \
                            "${DEPLOY_USER}@${DEPLOY_HOST}" \
                            "echo 'SSH connection successful'"


                        echo "SSH verification PASSED."
                    '''
                }
            }
        }


        stage('43 - Prepare Deployment EC2') {

            steps {

                sshagent(
                    credentials: ["${DEPLOY_SSH_CREDENTIALS}"]
                ) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "PREPARING DEPLOYMENT EC2"
                        echo "================================================"


                        ssh \
                            -o StrictHostKeyChecking=yes \
                            "${DEPLOY_USER}@${DEPLOY_HOST}" \
                            'bash -s' <<'REMOTE_SCRIPT'

set -e

echo "================================================"
echo "REMOTE EC2 PREPARATION"
echo "================================================"


echo ""
echo "Operating system:"
cat /etc/os-release | head -5


echo ""
echo "Disk usage:"
df -h


echo ""
echo "Checking Docker..."


if ! command -v docker >/dev/null 2>&1; then

    echo "ERROR: Docker is not installed."

    exit 1

fi


docker --version


echo ""
echo "Checking Docker daemon..."


if ! sudo docker info >/dev/null 2>&1; then

    echo "ERROR: Docker daemon is not accessible."

    sudo systemctl status docker \
        --no-pager \
        || true

    exit 1

fi


echo "Docker daemon is ready."


echo ""
echo "Checking curl..."


if ! command -v curl >/dev/null 2>&1; then

    echo "Installing curl..."

    sudo apt-get update -y

    sudo apt-get install -y curl

fi


curl --version | head -1


echo ""
echo "Remote Docker disk usage:"

sudo docker system df || true


echo ""
echo "Deployment EC2 preparation PASSED."

REMOTE_SCRIPT
                    '''
                }
            }
        }


        stage('44 - Deploy ECR Image to EC2') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sshagent(
                        credentials: ["${DEPLOY_SSH_CREDENTIALS}"]
                    ) {

                        sh '''
                            set -e

                            echo "================================================"
                            echo "DEPLOYING ECR IMAGE TO EC2"
                            echo "================================================"


                            echo ""
                            echo "ECR Image:"
                            echo "${ECR_IMAGE}"


                            echo ""
                            echo "Target:"
                            echo "${DEPLOY_USER}@${DEPLOY_HOST}"


                            echo ""
                            echo "Obtaining ECR login password from AWS..."


                            ECR_PASSWORD=$(aws ecr get-login-password \
                                --region "${AWS_DEFAULT_REGION}")


                            if [ -z "${ECR_PASSWORD}" ]; then

                                echo "ERROR: ECR password was empty."

                                exit 1

                            fi


                            echo ""
                            echo "Authenticating deployment EC2 with ECR..."


                            printf '%s\\n' "${ECR_PASSWORD}" \
                            | ssh \
                                -o StrictHostKeyChecking=yes \
                                "${DEPLOY_USER}@${DEPLOY_HOST}" \
                                "sudo docker login \
                                    --username AWS \
                                    --password-stdin \
                                    '${ECR_REGISTRY}'"


                            echo ""
                            echo "Docker login to ECR PASSED."


                            echo ""
                            echo "Pulling ECR image..."


                            ssh \
                                -o StrictHostKeyChecking=yes \
                                "${DEPLOY_USER}@${DEPLOY_HOST}" \
                                "sudo docker pull '${ECR_IMAGE}'"


                            echo ""
                            echo "ECR image pull PASSED."


                            echo ""
                            echo "Verifying image..."


                            ssh \
                                -o StrictHostKeyChecking=yes \
                                "${DEPLOY_USER}@${DEPLOY_HOST}" \
                                "sudo docker image inspect '${ECR_IMAGE}' > /dev/null"


                            echo ""
                            echo "Stopping previous container if present..."


                            ssh \
                                -o StrictHostKeyChecking=yes \
                                "${DEPLOY_USER}@${DEPLOY_HOST}" \
                                "sudo docker stop '${CONTAINER_NAME}' || true"


                            ssh \
                                -o StrictHostKeyChecking=yes \
                                "${DEPLOY_USER}@${DEPLOY_HOST}" \
                                "sudo docker rm '${CONTAINER_NAME}' || true"


                            echo ""
                            echo "Starting new application container..."


                            ssh \
                                -o StrictHostKeyChecking=yes \
                                "${DEPLOY_USER}@${DEPLOY_HOST}" \
                                "sudo docker run \
                                    -d \
                                    --restart unless-stopped \
                                    --name '${CONTAINER_NAME}' \
                                    -p '${HOST_PORT}:${CONTAINER_PORT}' \
                                    '${ECR_IMAGE}'"


                            echo ""
                            echo "Waiting for container startup..."

                            sleep 10


                            echo ""
                            echo "Container status:"


                            ssh \
                                -o StrictHostKeyChecking=yes \
                                "${DEPLOY_USER}@${DEPLOY_HOST}" \
                                "sudo docker ps \
                                    --filter 'name=${CONTAINER_NAME}'"


                            echo ""
                            echo "Removing unused Docker images..."


                            ssh \
                                -o StrictHostKeyChecking=yes \
                                "${DEPLOY_USER}@${DEPLOY_HOST}" \
                                "sudo docker image prune -f"


                            echo ""
                            echo "================================================"
                            echo "REMOTE DEPLOYMENT COMPLETED"
                            echo "================================================"
                        '''
                    }
                }
            }
        }


        stage('45 - Verify Running Container') {

            steps {

                sshagent(
                    credentials: ["${DEPLOY_SSH_CREDENTIALS}"]
                ) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "VERIFYING RUNNING CONTAINER"
                        echo "================================================"


                        ssh \
                            -o StrictHostKeyChecking=yes \
                            "${DEPLOY_USER}@${DEPLOY_HOST}" \
                            "sudo docker ps"


                        CONTAINER_RUNNING=$(ssh \
                            -o StrictHostKeyChecking=yes \
                            "${DEPLOY_USER}@${DEPLOY_HOST}" \
                            "sudo docker ps \
                                --format '{{.Names}}' \
                                | grep -Fx '${CONTAINER_NAME}'" \
                            || true)


                        if [ "${CONTAINER_RUNNING}" != "${CONTAINER_NAME}" ]; then

                            echo ""
                            echo "ERROR: Application container is not running."


                            echo ""
                            echo "Container logs:"


                            ssh \
                                -o StrictHostKeyChecking=yes \
                                "${DEPLOY_USER}@${DEPLOY_HOST}" \
                                "sudo docker logs \
                                    '${CONTAINER_NAME}'" \
                                || true


                            exit 1

                        fi


                        echo ""
                        echo "Application container is RUNNING."


                        ssh \
                            -o StrictHostKeyChecking=yes \
                            "${DEPLOY_USER}@${DEPLOY_HOST}" \
                            "sudo docker inspect \
                                '${CONTAINER_NAME}' \
                                --format='Image={{.Config.Image}} Status={{.State.Status}}'"


                        echo ""
                        echo "Recent application logs:"


                        ssh \
                            -o StrictHostKeyChecking=yes \
                            "${DEPLOY_USER}@${DEPLOY_HOST}" \
                            "sudo docker logs \
                                --tail 30 \
                                '${CONTAINER_NAME}'" \
                            || true


                        echo ""
                        echo "================================================"
                        echo "CONTAINER VERIFICATION PASSED"
                        echo "================================================"
                    '''
                }
            }
        }


        // ============================================================
        // PART 7 - FINAL EC2 HEALTH CHECK
        // ============================================================

        stage('46 - Part 7 EC2 Health Check') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "PART 7 - EC2 HEALTH CHECK"
                        echo "================================================"


                        INSTANCE_STATE=$(aws ec2 describe-instances \
                            --region "${AWS_DEFAULT_REGION}" \
                            --instance-ids "${DEPLOY_INSTANCE_ID}" \
                            --query 'Reservations[0].Instances[0].State.Name' \
                            --output text)


                        echo "EC2 Instance State : ${INSTANCE_STATE}"


                        if [ "${INSTANCE_STATE}" != "running" ]; then

                            echo "ERROR: Deployment EC2 is not running."

                            exit 1

                        fi


                        SYSTEM_STATUS=$(aws ec2 describe-instance-status \
                            --region "${AWS_DEFAULT_REGION}" \
                            --instance-ids "${DEPLOY_INSTANCE_ID}" \
                            --include-all-instances \
                            --query 'InstanceStatuses[0].SystemStatus.Status' \
                            --output text)


                        INSTANCE_STATUS=$(aws ec2 describe-instance-status \
                            --region "${AWS_DEFAULT_REGION}" \
                            --instance-ids "${DEPLOY_INSTANCE_ID}" \
                            --include-all-instances \
                            --query 'InstanceStatuses[0].InstanceStatus.Status' \
                            --output text)


                        echo "System Status       : ${SYSTEM_STATUS}"
                        echo "Instance Status     : ${INSTANCE_STATUS}"


                        if [ "${SYSTEM_STATUS}" != "ok" ]; then

                            echo "ERROR: EC2 system status is not OK."

                            exit 1

                        fi


                        if [ "${INSTANCE_STATUS}" != "ok" ]; then

                            echo "ERROR: EC2 instance status is not OK."

                            exit 1

                        fi


                        echo ""
                        echo "EC2 health check PASSED."
                    '''
                }
            }
        }


        stage('47 - Part 7 Verify EC2 Tags') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "PART 7 - VERIFYING EC2 TAGS"
                        echo "================================================"


                        ROLE=$(aws ec2 describe-instances \
                            --region "${AWS_DEFAULT_REGION}" \
                            --instance-ids "${DEPLOY_INSTANCE_ID}" \
                            --query 'Reservations[0].Instances[0].Tags[?Key==`Role`]|[0].Value' \
                            --output text)


                        ENV_TAG=$(aws ec2 describe-instances \
                            --region "${AWS_DEFAULT_REGION}" \
                            --instance-ids "${DEPLOY_INSTANCE_ID}" \
                            --query 'Reservations[0].Instances[0].Tags[?Key==`Environment`]|[0].Value' \
                            --output text)


                        echo "Role        : ${ROLE}"
                        echo "Environment : ${ENV_TAG}"


                        if [ "${ROLE}" != "${DEPLOY_INSTANCE_ROLE}" ]; then

                            echo "ERROR: EC2 Role tag mismatch."

                            exit 1

                        fi


                        if [ "${ENV_TAG}" != "${ENVIRONMENT}" ]; then

                            echo "ERROR: EC2 Environment tag mismatch."

                            exit 1

                        fi


                        echo ""
                        echo "EC2 tag verification PASSED."
                    '''
                }
            }
        }


        stage('48 - Part 7 Docker Health Check') {

            steps {

                sshagent(
                    credentials: ["${DEPLOY_SSH_CREDENTIALS}"]
                ) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "PART 7 - DOCKER HEALTH CHECK"
                        echo "================================================"


                        DOCKER_RUNNING=$(ssh \
                            -o StrictHostKeyChecking=yes \
                            "${DEPLOY_USER}@${DEPLOY_HOST}" \
                            "sudo docker inspect \
                                '${CONTAINER_NAME}' \
                                --format='{{.State.Running}}'")


                        DOCKER_STATUS=$(ssh \
                            -o StrictHostKeyChecking=yes \
                            "${DEPLOY_USER}@${DEPLOY_HOST}" \
                            "sudo docker inspect \
                                '${CONTAINER_NAME}' \
                                --format='{{.State.Status}}'")


                        echo "Container Running : ${DOCKER_RUNNING}"
                        echo "Container Status  : ${DOCKER_STATUS}"


                        if [ "${DOCKER_RUNNING}" != "true" ]; then

                            echo "ERROR: Docker container is not running."

                            exit 1

                        fi


                        if [ "${DOCKER_STATUS}" != "running" ]; then

                            echo "ERROR: Docker container status is not running."

                            exit 1

                        fi


                        echo ""
                        echo "Docker health check PASSED."
                    '''
                }
            }
        }


        stage('49 - Part 7 Port Check') {

            steps {

                sshagent(
                    credentials: ["${DEPLOY_SSH_CREDENTIALS}"]
                ) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "PART 7 - PORT CHECK"
                        echo "================================================"


                        echo "Checking host port ${HOST_PORT}..."


                        PORT_RESULT=$(ssh \
                            -o StrictHostKeyChecking=yes \
                            "${DEPLOY_USER}@${DEPLOY_HOST}" \
                            "sudo docker port '${CONTAINER_NAME}' || true")


                        echo "Docker port mapping:"
                        echo "${PORT_RESULT}"


                        if ! echo "${PORT_RESULT}" | grep -q "${HOST_PORT}"; then

                            echo "ERROR: Expected port ${HOST_PORT} is not mapped."

                            exit 1

                        fi


                        echo ""
                        echo "Port check PASSED."
                    '''
                }
            }
        }


        stage('50 - Part 7 HTTP Health Check') {

            steps {

                sh '''
                    set -e

                    echo "================================================"
                    echo "PART 7 - HTTP HEALTH CHECK"
                    echo "================================================"


                    echo "Target:"
                    echo "http://${DEPLOY_HOST}:${HOST_PORT}/"


                    SUCCESS=0


                    for i in $(seq 1 18)
                    do

                        echo ""
                        echo "HTTP health check attempt ${i}/18..."


                        HTTP_CODE=$(curl \
                            --connect-timeout 5 \
                            --max-time 10 \
                            --silent \
                            --output /dev/null \
                            --write-out "%{http_code}" \
                            "http://${DEPLOY_HOST}:${HOST_PORT}/" \
                            || true)


                        echo "HTTP status : ${HTTP_CODE}"


                        if [ "${HTTP_CODE}" != "000" ]; then

                            if [ "${HTTP_CODE}" -ge 200 ] && \
                               [ "${HTTP_CODE}" -lt 500 ]; then

                                SUCCESS=1

                                echo ""
                                echo "Application HTTP endpoint is responding."

                                break

                            fi

                        fi


                        sleep 5

                    done


                    if [ "${SUCCESS}" -ne 1 ]; then

                        echo ""
                        echo "ERROR: Application HTTP health check FAILED."


                        echo ""
                        echo "Deployment EC2 container status:"


                        ssh \
                            -o StrictHostKeyChecking=yes \
                            "${DEPLOY_USER}@${DEPLOY_HOST}" \
                            "sudo docker ps -a"


                        echo ""
                        echo "Application logs:"


                        ssh \
                            -o StrictHostKeyChecking=yes \
                            "${DEPLOY_USER}@${DEPLOY_HOST}" \
                            "sudo docker logs \
                                --tail 100 \
                                '${CONTAINER_NAME}'" \
                            || true


                        exit 1

                    fi


                    echo ""
                    echo "HTTP health check PASSED."
                '''
            }
        }


        stage('51 - Part 7 Final Deployment Verification') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sshagent(
                        credentials: ["${DEPLOY_SSH_CREDENTIALS}"]
                    ) {

                        sh '''
                            set -e

                            echo "================================================"
                            echo "PART 7 - FINAL DEPLOYMENT VERIFICATION"
                            echo "================================================"


                            echo ""
                            echo "EC2:"
                            echo "${DEPLOY_INSTANCE_ID}"


                            echo ""
                            echo "Public IP:"
                            echo "${DEPLOY_HOST}"


                            echo ""
                            echo "ECR image:"
                            echo "${ECR_IMAGE}"


                            echo ""
                            echo "Container:"
                            echo "${CONTAINER_NAME}"


                            echo ""
                            echo "Port:"
                            echo "${HOST_PORT}"


                            echo ""
                            echo "Remote Docker containers:"


                            ssh \
                                -o StrictHostKeyChecking=yes \
                                "${DEPLOY_USER}@${DEPLOY_HOST}" \
                                "sudo docker ps \
                                    --filter 'name=${CONTAINER_NAME}'"


                            echo ""
                            echo "Remote disk usage:"


                            ssh \
                                -o StrictHostKeyChecking=yes \
                                "${DEPLOY_USER}@${DEPLOY_HOST}" \
                                "df -h"


                            echo ""
                            echo "Remote Docker disk usage:"


                            ssh \
                                -o StrictHostKeyChecking=yes \
                                "${DEPLOY_USER}@${DEPLOY_HOST}" \
                                "sudo docker system df"


                            echo ""
                            echo "================================================"
                            echo "FINAL DEPLOYMENT VERIFICATION PASSED"
                            echo "================================================"
                        '''
                    }
                }
            }
        }


        stage('52 - Part 7 Success') {

            steps {

                echo ''
                echo '================================================'
                echo '             PART 7 SUCCESS'
                echo '================================================'

                echo ''
                echo "Environment       : ${params.ENVIRONMENT}"
                echo "EC2 Instance      : ${env.DEPLOY_INSTANCE_ID}"
                echo "EC2 Host          : ${env.DEPLOY_HOST}"
                echo "ECR Image         : ${env.ECR_IMAGE}"
                echo "Container         : ${env.CONTAINER_NAME}"
                echo "Application Port  : ${env.HOST_PORT}"

                echo ''
                echo 'EC2 Health        : PASSED'
                echo 'EC2 Tags          : PASSED'
                echo 'Docker Health     : PASSED'
                echo 'Port Check        : PASSED'
                echo 'HTTP Health       : PASSED'
                echo 'Final Verification: PASSED'

                echo ''
                echo '================================================'
                echo '        PART 1 TO PART 7 SUCCESS'
                echo '================================================'
            }
        }
    }


    // ================================================================
    // POST ACTIONS
    // ================================================================

    post {

        success {

            echo ''
            echo '================================================'
            echo ' PART 1 + PART 2 + PART 3 + PART 4 + PART 5'
            echo '             + PART 6 + PART 7'
            echo '                  SUCCESS'
            echo '================================================'


            echo ''
            echo 'Part 1 - Code Quality       : PASSED'
            echo 'Part 2 - Automated Testing  : PASSED'
            echo 'Part 3 - Docker             : PASSED'
            echo 'Part 4 - AWS ECR            : PASSED'
            echo 'Part 5 - Terraform          : PASSED'
            echo 'Part 6 - Deployment         : PASSED'
            echo 'Part 7 - Final Health Check : PASSED'


            echo ''
            echo "Environment : ${params.ENVIRONMENT}"


            echo ''
            echo 'Terraform infrastructure successfully deployed.'

            echo 'Application successfully deployed to EC2.'

            echo 'Final EC2 health verification successfully completed.'


            echo '================================================'
        }


        failure {

            echo ''
            echo '================================================'
            echo ' PART 1 + PART 2 + PART 3 + PART 4 + PART 5'
            echo '             + PART 6 + PART 7'
            echo '                  FAILED'
            echo '================================================'


            echo ''
            echo 'The pipeline stopped at the failed stage.'


            echo ''
            echo 'Check the Jenkins console output above'
            echo 'for the exact failing command.'


            echo '================================================'
        }


        always {

            echo ''
            echo '================================================'
            echo 'CLEANING JENKINS WORKSPACE'
            echo '================================================'


            cleanWs(
                deleteDirs: true,
                disableDeferredWipeout: true
            )
        }
    }
}
