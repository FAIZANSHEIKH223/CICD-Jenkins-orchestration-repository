pipeline {

    agent any

    // ================================================================
    // PIPELINE OPTIONS
    // ================================================================

    options {

        timestamps()

        ansiColor('xterm')

        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                daysToKeepStr: '30',
                numToKeepStr: '50'
            )
        )

        timeout(
            time: 90,
            unit: 'MINUTES'
        )
    }


    // ================================================================
    // PARAMETERS
    // ================================================================

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: [
                'dev',
                'qa',
                'stage',
                'prod'
            ],
            description: 'Terraform environment to deploy'
        )
    }


    // ================================================================
    // ENVIRONMENT
    // ================================================================

    environment {

        // ------------------------------------------------------------
        // APPLICATION REPOSITORY
        // ------------------------------------------------------------

        APP_REPO =
            'https://github.com/FAIZANSHEIKH223/practice1.git'

        APP_BRANCH = 'main'


        // ------------------------------------------------------------
        // QUALITY REPOSITORY
        // ------------------------------------------------------------

        QUALITY_REPO =
            'https://github.com/FAIZANSHEIKH223/pylint_flake8_int_jenkins.git'

        QUALITY_BRANCH = 'main'


        // ------------------------------------------------------------
        // TERRAFORM REPOSITORY
        // ------------------------------------------------------------

        TERRAFORM_REPO =
            'https://github.com/FAIZANSHEIKH223/terraform-aws-infra.git'

        TERRAFORM_BRANCH = 'main'


        // ------------------------------------------------------------
        // GITHUB CREDENTIAL
        // ------------------------------------------------------------

        GITHUB_CREDENTIALS = 'github-creds'


        // ------------------------------------------------------------
        // PYTHON
        // ------------------------------------------------------------

        PYTHON = 'python3.12'


        // ------------------------------------------------------------
        // WORKSPACE DIRECTORIES
        // ------------------------------------------------------------

        APP_DIR = 'practice1'

        QUALITY_DIR = 'quality-tools'

        TERRAFORM_DIR = 'terraform-infra'

        VENV_DIR = 'venv'

        REPORT_DIR = 'reports'


        // ------------------------------------------------------------
        // DOCKER
        // ------------------------------------------------------------

        DOCKER_IMAGE_NAME = 'practice1'

        DOCKER_IMAGE_TAG = "${BUILD_NUMBER}"

        DOCKER_IMAGE =
            "${DOCKER_IMAGE_NAME}:${DOCKER_IMAGE_TAG}"


        // ------------------------------------------------------------
        // AWS
        // ------------------------------------------------------------

        AWS_DEFAULT_REGION = 'us-east-1'

        AWS_REGION = 'us-east-1'

        AWS_CREDENTIALS = 'aws-creds'


        // ------------------------------------------------------------
        // ECR
        // ------------------------------------------------------------

        ECR_REPOSITORY = 'practice1'

        ECR_IMAGE_TAG = "${BUILD_NUMBER}"


        // ------------------------------------------------------------
        // TERRAFORM BACKEND
        // ------------------------------------------------------------

        TF_STATE_BUCKET =
            'terraform-state-faizan-001'

        TF_LOCK_TABLE =
            'terraform-locks'


        // ------------------------------------------------------------
        // TERRAFORM
        // ------------------------------------------------------------

        TF_IN_AUTOMATION = 'true'

        TF_INPUT = 'false'


        // ------------------------------------------------------------
        // DEPLOYMENT
        // ------------------------------------------------------------

        DEPLOY_SSH_CREDENTIALS = 'deploy-ssh-key'

        DEPLOY_USER = 'ubuntu'

        CONTAINER_NAME = 'practice1'

        CONTAINER_PORT = '8501'

        HOST_PORT = '8501'


        // ------------------------------------------------------------
        // DEPLOYMENT EC2 TAGS
        // ------------------------------------------------------------

        DEPLOY_INSTANCE_ROLE = 'application'
    }


    // ================================================================
    // STAGES
    // ================================================================

    stages {


        // ============================================================
        // PART 1 - CODE QUALITY
        // ============================================================

        stage('1 - Checkout Application') {

            steps {

                echo ''
                echo '================================================'
                echo 'CHECKOUT APPLICATION'
                echo '================================================'

                dir("${APP_DIR}") {

                    git(
                        branch: "${APP_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${APP_REPO}"
                    )
                }
            }
        }


        stage('2 - Checkout Quality Repository') {

            steps {

                echo ''
                echo '================================================'
                echo 'CHECKOUT QUALITY REPOSITORY'
                echo '================================================'

                dir("${QUALITY_DIR}") {

                    git(
                        branch: "${QUALITY_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${QUALITY_REPO}"
                    )
                }
            }
        }


        stage('3 - Verify Python') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "VERIFYING PYTHON"
                        echo "================================================"

                        command -v "${PYTHON}"

                        "${PYTHON}" --version

                        "${PYTHON}" -m pip --version
                    '''
                }
            }
        }


        stage('4 - Create Python Virtual Environment') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "CREATING VIRTUAL ENVIRONMENT"
                        echo "================================================"

                        rm -rf "${VENV_DIR}"

                        "${PYTHON}" -m venv "${VENV_DIR}"

                        "${VENV_DIR}/bin/python" --version
                    '''
                }
            }
        }


        stage('5 - Install Application Dependencies') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "INSTALLING APPLICATION DEPENDENCIES"
                        echo "================================================"

                        "${VENV_DIR}/bin/python" \
                            -m pip install --upgrade pip

                        if [ -f requirements.txt ]; then

                            "${VENV_DIR}/bin/pip" \
                                install \
                                -r requirements.txt

                        else

                            echo "No requirements.txt found."

                        fi
                    '''
                }
            }
        }


        stage('6 - Install Quality Tools') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "INSTALLING QUALITY TOOLS"
                        echo "================================================"

                        "${VENV_DIR}/bin/pip" install \
                            flake8 \
                            pylint

                        "${VENV_DIR}/bin/flake8" --version

                        "${VENV_DIR}/bin/pylint" --version
                    '''
                }
            }
        }


        stage('7 - Flake8 Code Quality') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "RUNNING FLAKE8"
                        echo "================================================"

                        mkdir -p "${REPORT_DIR}"

                        "${VENV_DIR}/bin/flake8" \
                            . \
                            --exclude="${VENV_DIR},.git,${REPORT_DIR},__pycache__" \
                            --count \
                            --statistics \
                            --tee \
                            --output-file="${REPORT_DIR}/flake8-report.txt"
                    '''
                }
            }
        }


        stage('8 - Pylint Code Quality') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "RUNNING PYLINT"
                        echo "================================================"

                        mkdir -p "${REPORT_DIR}"

                        PYTHON_FILES=$(find . \
                            -type f \
                            -name "*.py" \
                            ! -path "./${VENV_DIR}/*" \
                            ! -path "./.git/*" \
                            ! -path "./${REPORT_DIR}/*" \
                            ! -path "*/__pycache__/*")

                        if [ -z "${PYTHON_FILES}" ]; then

                            echo "ERROR: No Python files found."

                            exit 1

                        fi

                        "${VENV_DIR}/bin/pylint" \
                            ${PYTHON_FILES} \
                            --output-format=text \
                            > "${REPORT_DIR}/pylint-report.txt"
                    '''
                }
            }
        }


        stage('9 - Part 1 Success') {

            steps {

                echo ''
                echo '================================================'
                echo '           PART 1 CI SUCCESS'
                echo '================================================'

                echo 'Flake8 : PASSED'
                echo 'Pylint : PASSED'

                echo ''
                echo 'STARTING PART 2 - TESTING'
                echo '================================================'
            }
        }


        // ============================================================
        // PART 2 - TESTING
        // ============================================================

        stage('10 - Install Pytest') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "INSTALLING PYTEST"
                        echo "================================================"

                        "${VENV_DIR}/bin/pip" install pytest

                        "${VENV_DIR}/bin/pytest" --version
                    '''
                }
            }
        }


        stage('11 - Verify Tests') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "VERIFYING TESTS"
                        echo "================================================"

                        if [ ! -d "tests" ]; then

                            echo "ERROR: tests/ directory does not exist."

                            exit 1

                        fi

                        TEST_FILES=$(find tests \
                            -type f \
                            \\( \
                                -name "test_*.py" \
                                -o \
                                -name "*_test.py" \
                            \\))

                        if [ -z "${TEST_FILES}" ]; then

                            echo "ERROR: No pytest test files found."

                            exit 1

                        fi

                        echo "Test files:"
                        echo "${TEST_FILES}"
                    '''
                }
            }
        }


        stage('12 - Run Automated Tests') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "RUNNING AUTOMATED TESTS"
                        echo "================================================"

                        mkdir -p "${REPORT_DIR}"

                        "${VENV_DIR}/bin/pytest" \
                            tests/ \
                            -v \
                            --junitxml="${REPORT_DIR}/pytest-results.xml"
                    '''
                }
            }
        }


        stage('13 - Publish Test Results') {

            steps {

                junit(
                    testResults:
                        "${APP_DIR}/${REPORT_DIR}/pytest-results.xml",
                    allowEmptyResults: false
                )

                archiveArtifacts(
                    artifacts:
                        "${APP_DIR}/${REPORT_DIR}/pytest-results.xml," +
                        "${APP_DIR}/${REPORT_DIR}/flake8-report.txt," +
                        "${APP_DIR}/${REPORT_DIR}/pylint-report.txt",

                    allowEmptyArchive: false,

                    fingerprint: true
                )
            }
        }


        stage('14 - Part 2 Success') {

            steps {

                echo ''
                echo '================================================'
                echo '           PART 2 CI SUCCESS'
                echo '================================================'

                echo 'Pytest : PASSED'
                echo 'Tests  : PASSED'

                echo ''
                echo 'STARTING PART 3 - DOCKER'
                echo '================================================'
            }
        }


        // ============================================================
        // PART 3 - DOCKER
        // ============================================================

        stage('15 - Verify Docker') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "VERIFYING DOCKER"
                        echo "================================================"

                        command -v docker

                        docker --version

                        if ! docker info > /dev/null 2>&1; then

                            echo "ERROR: Jenkins cannot access Docker daemon."

                            echo "Checking Docker service..."

                            sudo systemctl status docker \
                                --no-pager \
                                || true

                            exit 1

                        fi

                        echo "Docker daemon is accessible."
                    '''
                }
            }
        }


        stage('16 - Verify Dockerfile') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "VERIFYING DOCKERFILE"
                        echo "================================================"

                        if [ ! -f "Dockerfile" ]; then

                            echo "ERROR: Dockerfile was not found."

                            pwd

                            find . \
                                -maxdepth 2 \
                                -type f \
                                ! -path "./venv/*" \
                                ! -path "./.git/*" \
                                -print

                            exit 1

                        fi

                        echo "Dockerfile found."

                        cat Dockerfile
                    '''
                }
            }
        }


        stage('17 - Build Docker Image') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "BUILDING DOCKER IMAGE"
                        echo "================================================"

                        echo "Image : ${DOCKER_IMAGE}"

                        docker build \
                            --tag "${DOCKER_IMAGE}" \
                            .

                        docker image inspect \
                            "${DOCKER_IMAGE}" \
                            > /dev/null

                        echo "Docker image created successfully."
                    '''
                }
            }
        }


        stage('18 - Part 3 Success') {

            steps {

                echo ''
                echo '================================================'
                echo '           PART 3 DOCKER SUCCESS'
                echo '================================================'

                echo "Docker Image : ${DOCKER_IMAGE}"

                echo ''
                echo 'STARTING PART 4 - AWS ECR'
                echo '================================================'
            }
        }


        // ============================================================
        // PART 4 - AWS ECR
        // ============================================================

        stage('19 - Verify AWS CLI') {

            steps {

                sh '''
                    set -e

                    echo "================================================"
                    echo "VERIFYING AWS CLI"
                    echo "================================================"

                    command -v aws

                    aws --version
                '''
            }
        }


        stage('20 - Verify AWS Credentials') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "VERIFYING AWS CREDENTIALS"
                        echo "================================================"

                        aws sts get-caller-identity \
                            --region "${AWS_DEFAULT_REGION}"
                    '''
                }
            }
        }


        stage('21 - Create ECR Repository If Required') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "VERIFYING ECR REPOSITORY"
                        echo "================================================"

                        if aws ecr describe-repositories \
                            --repository-names "${ECR_REPOSITORY}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            > /dev/null 2>&1
                        then

                            echo "ECR repository already exists."

                        else

                            echo "Creating ECR repository..."

                            aws ecr create-repository \
                                --repository-name "${ECR_REPOSITORY}" \
                                --region "${AWS_DEFAULT_REGION}"

                        fi
                    '''
                }
            }
        }


        stage('22 - Get ECR Registry') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        def accountId = sh(
                            script: '''
                                aws sts get-caller-identity \
                                    --query Account \
                                    --output text \
                                    --region "${AWS_DEFAULT_REGION}"
                            ''',
                            returnStdout: true
                        ).trim()

                        env.AWS_ACCOUNT_ID = accountId

                        env.ECR_REGISTRY =
                            "${accountId}.dkr.ecr.${AWS_DEFAULT_REGION}.amazonaws.com"

                        env.ECR_IMAGE =
                            "${env.ECR_REGISTRY}/${env.ECR_REPOSITORY}:${env.ECR_IMAGE_TAG}"

                        echo "AWS Account ID : ${env.AWS_ACCOUNT_ID}"
                        echo "ECR Registry   : ${env.ECR_REGISTRY}"
                        echo "ECR Image      : ${env.ECR_IMAGE}"
                    }
                }
            }
        }


        stage('23 - Login Docker to ECR') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "AUTHENTICATING DOCKER WITH ECR"
                        echo "================================================"

                        aws ecr get-login-password \
                            --region "${AWS_DEFAULT_REGION}" \
                        | docker login \
                            --username AWS \
                            --password-stdin "${ECR_REGISTRY}"
                    '''
                }
            }
        }


        stage('24 - Tag Docker Image for ECR') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "TAGGING DOCKER IMAGE"
                        echo "================================================"

                        docker tag \
                            "${DOCKER_IMAGE}" \
                            "${ECR_IMAGE}"

                        docker image inspect \
                            "${ECR_IMAGE}" \
                            > /dev/null
                    '''
                }
            }
        }


        stage('25 - Push Docker Image to ECR') {

            steps {

                dir("${APP_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "PUSHING IMAGE TO ECR"
                        echo "================================================"

                        docker push "${ECR_IMAGE}"
                    '''
                }
            }
        }


        stage('26 - Verify Image in ECR') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "VERIFYING ECR IMAGE"
                        echo "================================================"

                        aws ecr describe-images \
                            --repository-name "${ECR_REPOSITORY}" \
                            --image-ids imageTag="${ECR_IMAGE_TAG}" \
                            --region "${AWS_DEFAULT_REGION}"
                    '''
                }
            }
        }


        stage('27 - Part 4 Success') {

            steps {

                echo ''
                echo '================================================'
                echo '        PART 4 AWS ECR SUCCESS'
                echo '================================================'

                echo "ECR Image : ${ECR_IMAGE}"

                echo ''
                echo 'STARTING PART 5 - TERRAFORM'
                echo '================================================'
            }
        }


        // ============================================================
        // PART 5 - TERRAFORM
        // ============================================================

        stage('28 - Checkout Terraform Repository') {

            steps {

                echo ''
                echo '================================================'
                echo 'CHECKOUT TERRAFORM INFRASTRUCTURE'
                echo '================================================'

                echo "Repository : ${TERRAFORM_REPO}"
                echo "Branch     : ${TERRAFORM_BRANCH}"
                echo "Environment: ${params.ENVIRONMENT}"

                dir("${TERRAFORM_DIR}") {

                    git(
                        branch: "${TERRAFORM_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${TERRAFORM_REPO}"
                    )
                }
            }
        }


        stage('29 - Bootstrap Terraform Backend') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -e

                        echo ""
                        echo "================================================"
                        echo "BOOTSTRAPPING TERRAFORM BACKEND"
                        echo "================================================"

                        echo "AWS Region      : ${AWS_DEFAULT_REGION}"
                        echo "State S3 Bucket : ${TF_STATE_BUCKET}"
                        echo "Lock Table      : ${TF_LOCK_TABLE}"

                        aws sts get-caller-identity \
                            --region "${AWS_DEFAULT_REGION}"


                        echo ""
                        echo "------------------------------------------------"
                        echo "CHECKING TERRAFORM STATE S3 BUCKET"
                        echo "------------------------------------------------"

                        if aws s3api head-bucket \
                            --bucket "${TF_STATE_BUCKET}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            > /dev/null 2>&1
                        then

                            echo "S3 state bucket already exists."

                        else

                            echo "Creating S3 state bucket..."

                            aws s3api create-bucket \
                                --bucket "${TF_STATE_BUCKET}" \
                                --region "${AWS_DEFAULT_REGION}"

                        fi


                        echo "Enabling S3 versioning..."

                        aws s3api put-bucket-versioning \
                            --bucket "${TF_STATE_BUCKET}" \
                            --versioning-configuration Status=Enabled \
                            --region "${AWS_DEFAULT_REGION}"


                        echo "Enabling S3 encryption..."

                        aws s3api put-bucket-encryption \
                            --bucket "${TF_STATE_BUCKET}" \
                            --server-side-encryption-configuration '{
                                "Rules": [
                                    {
                                        "ApplyServerSideEncryptionByDefault": {
                                            "SSEAlgorithm": "AES256"
                                        }
                                    }
                                ]
                            }' \
                            --region "${AWS_DEFAULT_REGION}"


                        echo "Blocking public access..."

                        aws s3api put-public-access-block \
                            --bucket "${TF_STATE_BUCKET}" \
                            --public-access-block-configuration \
                            BlockPublicAcls=true,IgnorePublicAcls=true,BlockPublicPolicy=true,RestrictPublicBuckets=true \
                            --region "${AWS_DEFAULT_REGION}"


                        echo ""
                        echo "------------------------------------------------"
                        echo "CHECKING TERRAFORM LOCK TABLE"
                        echo "------------------------------------------------"

                        if aws dynamodb describe-table \
                            --table-name "${TF_LOCK_TABLE}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            > /dev/null 2>&1
                        then

                            echo "DynamoDB lock table already exists."

                        else

                            echo "Creating DynamoDB lock table..."

                            aws dynamodb create-table \
                                --table-name "${TF_LOCK_TABLE}" \
                                --attribute-definitions \
                                AttributeName=LockID,AttributeType=S \
                                --key-schema \
                                AttributeName=LockID,KeyType=HASH \
                                --billing-mode PAY_PER_REQUEST \
                                --region "${AWS_DEFAULT_REGION}"

                            aws dynamodb wait table-exists \
                                --table-name "${TF_LOCK_TABLE}" \
                                --region "${AWS_DEFAULT_REGION}"

                        fi


                        echo ""
                        echo "================================================"
                        echo "TERRAFORM BACKEND BOOTSTRAP SUCCESS"
                        echo "================================================"
                    '''
                }
            }
        }


        stage('30 - Verify Terraform') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "VERIFYING TERRAFORM"
                        echo "================================================"

                        command -v terraform

                        terraform version

                        find . \
                            -maxdepth 1 \
                            -type f \
                            -name "*.tf" \
                            -print
                    '''
                }
            }
        }


        stage('31 - Verify Terraform AWS Credentials') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh '''
                            set -e

                            aws sts get-caller-identity \
                                --region "${AWS_DEFAULT_REGION}"

                            echo "Terraform AWS credentials are valid."
                        '''
                    }
                }
            }
        }


        stage('32 - Verify Terraform Environment') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    sh '''
                        set -e

                        echo "Selected Environment : ${ENVIRONMENT}"

                        TF_FILE_COUNT=$(find . \
                            -maxdepth 1 \
                            -type f \
                            -name "*.tf" \
                            | wc -l)

                        if [ "${TF_FILE_COUNT}" -eq 0 ]; then

                            echo "ERROR: No Terraform files found."

                            exit 1

                        fi


                        if [ ! -d "environments/${ENVIRONMENT}" ]; then

                            echo "ERROR: Terraform environment directory does not exist."

                            exit 1

                        fi


                        if [ ! -f "environments/${ENVIRONMENT}/terraform.tfvars" ]; then

                            echo "ERROR: terraform.tfvars not found."

                            exit 1

                        fi


                        echo "Terraform environment verified."
                    '''
                }
            }
        }


        stage('33 - Terraform Init') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh '''
                            set -e

                            echo "================================================"
                            echo "TERRAFORM INIT"
                            echo "================================================"

                            terraform init \
                                -input=false

                            echo "Terraform init PASSED."
                        '''
                    }
                }
            }
        }


        stage('34 - Terraform Validate') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "TERRAFORM VALIDATE"
                        echo "================================================"

                        terraform validate

                        echo "Terraform validate PASSED."
                    '''
                }
            }
        }


        stage('35 - Terraform Plan') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh '''
                            set -e

                            echo "================================================"
                            echo "TERRAFORM PLAN"
                            echo "================================================"

                            terraform plan \
                                -input=false \
                                -var-file="environments/${ENVIRONMENT}/terraform.tfvars" \
                                -out="tfplan"

                            echo "Terraform plan PASSED."
                        '''
                    }
                }
            }
        }


        stage('36 - Terraform Apply') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh '''
                            set -e

                            echo "================================================"
                            echo "TERRAFORM APPLY"
                            echo "================================================"

                            if [ ! -f "tfplan" ]; then

                                echo "ERROR: tfplan not found."

                                exit 1

                            fi

                            terraform apply \
                                -input=false \
                                -auto-approve \
                                "tfplan"

                            echo "Terraform apply PASSED."
                        '''
                    }
                }
            }
        }


        stage('37 - Verify Terraform Deployment') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh '''
                            set -e

                            echo "================================================"
                            echo "VERIFYING TERRAFORM DEPLOYMENT"
                            echo "================================================"

                            terraform state list || true

                            terraform output || true

                            aws sts get-caller-identity \
                                --region "${AWS_DEFAULT_REGION}"

                            aws s3api head-bucket \
                                --bucket "${TF_STATE_BUCKET}" \
                                --region "${AWS_DEFAULT_REGION}"

                            aws dynamodb describe-table \
                                --table-name "${TF_LOCK_TABLE}" \
                                --region "${AWS_DEFAULT_REGION}" \
                                --query 'Table.TableStatus' \
                                --output text

                            echo "Terraform deployment verification PASSED."
                        '''
                    }
                }
            }
        }


        stage('38 - Part 5 Success') {

            steps {

                echo ''
                echo '================================================'
                echo '          PART 5 TERRAFORM SUCCESS'
                echo '================================================'

                echo "Terraform Repository : terraform-aws-infra"
                echo "Environment          : ${params.ENVIRONMENT}"

                echo ''
                echo 'Backend S3           : READY'
                echo 'DynamoDB Lock Table  : READY'
                echo 'Terraform Init       : PASSED'
                echo 'Terraform Validate   : PASSED'
                echo 'Terraform Plan       : PASSED'
                echo 'Terraform Apply      : PASSED'
                echo 'Deployment Verify    : PASSED'

                echo ''
                echo 'STARTING PART 6 - APPLICATION DEPLOYMENT'
                echo '================================================'
            }
        }


        // ============================================================
        // PART 6 - APPLICATION DEPLOYMENT
        // ============================================================

        stage('39 - Locate Deployment EC2') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        echo ''
                        echo '================================================'
                        echo 'LOCATING DEPLOYMENT EC2'
                        echo '================================================'

                        echo "Region      : ${env.AWS_DEFAULT_REGION}"
                        echo "Role        : ${env.DEPLOY_INSTANCE_ROLE}"
                        echo "Environment : ${params.ENVIRONMENT}"


                        echo ''
                        echo 'Running EC2 instances:'

                        sh '''
                            aws ec2 describe-instances \
                                --region "${AWS_DEFAULT_REGION}" \
                                --filters \
                                    "Name=instance-state-name,Values=running" \
                                --query 'Reservations[].Instances[].{
                                    InstanceId:InstanceId,
                                    PublicIP:PublicIpAddress,
                                    PrivateIP:PrivateIpAddress,
                                    Role:Tags[?Key==`Role`]|[0].Value,
                                    Environment:Tags[?Key==`Environment`]|[0].Value
                                }' \
                                --output table
                        '''


                        def instanceId = sh(
                            script: '''
                                aws ec2 describe-instances \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --filters \
                                        "Name=instance-state-name,Values=running" \
                                        "Name=tag:Role,Values=${DEPLOY_INSTANCE_ROLE}" \
                                        "Name=tag:Environment,Values=${ENVIRONMENT}" \
                                    --query 'Reservations[].Instances[].InstanceId' \
                                    --output text
                            ''',
                            returnStdout: true
                        ).trim()


                        if (!instanceId ||
                            instanceId == 'None' ||
                            instanceId == 'null') {

                            echo ''
                            echo 'ERROR: No deployment EC2 found.'
                            echo ''
                            echo 'Required tags:'
                            echo "Role=application"
                            echo "Environment=${params.ENVIRONMENT}"
                            echo ''

                            error(
                                "No running EC2 instance found with " +
                                "Role=${env.DEPLOY_INSTANCE_ROLE} " +
                                "and Environment=${params.ENVIRONMENT}"
                            )
                        }


                        def instanceList =
                            instanceId.split("\\s+")


                        if (instanceList.size() != 1) {

                            error(
                                "Expected exactly one deployment EC2 instance. " +
                                "Found: ${instanceList.size()} " +
                                "Instances: ${instanceId}"
                            )
                        }


                        env.DEPLOY_INSTANCE_ID =
                            instanceList[0]


                        def publicIp = sh(
                            script: """
                                aws ec2 describe-instances \
                                    --region "${env.AWS_DEFAULT_REGION}" \
                                    --instance-ids "${env.DEPLOY_INSTANCE_ID}" \
                                    --query 'Reservations[0].Instances[0].PublicIpAddress' \
                                    --output text
                            """,
                            returnStdout: true
                        ).trim()


                        if (!publicIp ||
                            publicIp == 'None' ||
                            publicIp == 'null') {

                            error(
                                "Deployment EC2 does not have a public IP address."
                            )
                        }


                        env.DEPLOY_HOST = publicIp


                        echo ''
                        echo "Deployment Instance : ${env.DEPLOY_INSTANCE_ID}"
                        echo "Deployment Host     : ${env.DEPLOY_HOST}"
                        echo "Environment         : ${params.ENVIRONMENT}"
                        echo ''
                    }
                }
            }
        }


        stage('40 - Verify Deployment EC2 SSH') {

            steps {

                sshagent(
                    credentials: ["${DEPLOY_SSH_CREDENTIALS}"]
                ) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "VERIFYING EC2 SSH CONNECTION"
                        echo "================================================"

                        mkdir -p ~/.ssh

                        chmod 700 ~/.ssh

                        ssh-keyscan \
                            -H \
                            "${DEPLOY_HOST}" \
                            >> ~/.ssh/known_hosts 2>/dev/null || true

                        ssh \
                            -o StrictHostKeyChecking=yes \
                            -o ConnectTimeout=20 \
                            "${DEPLOY_USER}@${DEPLOY_HOST}" \
                            "echo 'SSH connection successful'"

                        echo "EC2 SSH verification PASSED."
                    '''
                }
            }
        }


        // ============================================================
        // IMPORTANT FIX:
        // AWS CLI v2 is installed using the official AWS installer.
        // We do NOT use "apt install awscli".
        // ============================================================

        stage('41 - Prepare Deployment EC2') {

            steps {

                sshagent(
                    credentials: ["${DEPLOY_SSH_CREDENTIALS}"]
                ) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "PREPARING DEPLOYMENT EC2"
                        echo "================================================"

                        ssh \
                            -o StrictHostKeyChecking=yes \
                            "${DEPLOY_USER}@${DEPLOY_HOST}" \
                            'bash -s' <<'REMOTE_SCRIPT'

set -e

echo "================================================"
echo "REMOTE EC2 PREPARATION"
echo "================================================"


echo ""
echo "Checking operating system..."

cat /etc/os-release | head -5


echo ""
echo "Checking Docker..."

if ! command -v docker >/dev/null 2>&1; then

    echo "ERROR: Docker is not installed."

    exit 1

fi

docker --version


echo ""
echo "Checking Docker daemon..."

if ! sudo docker info >/dev/null 2>&1; then

    echo "ERROR: Docker daemon is not accessible."

    sudo systemctl status docker \
        --no-pager \
        || true

    exit 1

fi

echo "Docker daemon is ready."


echo ""
echo "Checking AWS CLI..."


if command -v aws >/dev/null 2>&1; then

    echo "AWS CLI already installed."

else

    echo "AWS CLI not found."

    echo "Installing AWS CLI v2 using official AWS installer..."

    sudo apt-get update -y

    sudo apt-get install -y \
        curl \
        unzip

    TMP_DIR=$(mktemp -d)

    cd "${TMP_DIR}"

    curl \
        -fsSL \
        "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" \
        -o "awscliv2.zip"

    unzip \
        -q \
        awscliv2.zip

    sudo ./aws/install

    cd /

    rm -rf "${TMP_DIR}"

fi


echo ""
echo "AWS CLI version:"

aws --version


if ! command -v aws >/dev/null 2>&1; then

    echo "ERROR: AWS CLI installation failed."

    exit 1

fi


echo ""
echo "Checking EC2 IAM role..."

if ! aws sts get-caller-identity \
    --region "${AWS_DEFAULT_REGION}" \
    >/dev/null 2>&1
then

    echo ""
    echo "ERROR: Deployment EC2 has no usable AWS credentials."
    echo ""
    echo "The deployment EC2 must have an IAM instance profile."
    echo ""
    echo "The IAM role must allow ECR pull operations."
    echo ""

    exit 1

fi


echo ""
echo "Deployment EC2 IAM identity:"

aws sts get-caller-identity \
    --region "${AWS_DEFAULT_REGION}"


echo ""
echo "Testing ECR authentication permission..."

if ! aws ecr get-login-password \
    --region "${AWS_DEFAULT_REGION}" \
    >/dev/null
then

    echo ""
    echo "ERROR: EC2 IAM role cannot authenticate with ECR."
    echo ""
    echo "Required permission:"
    echo "ecr:GetAuthorizationToken"
    echo ""

    exit 1

fi


echo ""
echo "ECR authentication permission PASSED."


echo ""
echo "Checking Docker group..."

if id -nG "${USER}" | grep -qw docker; then

    echo "User ${USER} belongs to docker group."

else

    echo "User ${USER} is not in docker group."

    echo "Docker commands will use sudo."

fi


echo ""
echo "================================================"
echo "REMOTE EC2 PREPARATION PASSED"
echo "================================================"

REMOTE_SCRIPT
                    '''
                }
            }
        }


        stage('42 - Deploy ECR Image to EC2') {

            steps {

                sshagent(
                    credentials: ["${DEPLOY_SSH_CREDENTIALS}"]
                ) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "DEPLOYING ECR IMAGE TO EC2"
                        echo "================================================"

                        echo ""
                        echo "ECR Image:"
                        echo "${ECR_IMAGE}"

                        echo ""
                        echo "Target:"
                        echo "${DEPLOY_USER}@${DEPLOY_HOST}"


                        ssh \
                            -o StrictHostKeyChecking=yes \
                            "${DEPLOY_USER}@${DEPLOY_HOST}" \
                            "AWS_DEFAULT_REGION='${AWS_DEFAULT_REGION}' ECR_REGISTRY='${ECR_REGISTRY}' ECR_IMAGE='${ECR_IMAGE}' CONTAINER_NAME='${CONTAINER_NAME}' HOST_PORT='${HOST_PORT}' CONTAINER_PORT='${CONTAINER_PORT}' bash -s" <<'REMOTE_SCRIPT'

set -e

echo ""
echo "================================================"
echo "REMOTE APPLICATION DEPLOYMENT"
echo "================================================"


echo ""
echo "AWS Identity:"

aws sts get-caller-identity \
    --region "${AWS_DEFAULT_REGION}"


echo ""
echo "Logging Docker into ECR..."

aws ecr get-login-password \
    --region "${AWS_DEFAULT_REGION}" \
| sudo docker login \
    --username AWS \
    --password-stdin "${ECR_REGISTRY}"


echo ""
echo "Pulling ECR image..."

sudo docker pull \
    "${ECR_IMAGE}"


echo ""
echo "Verifying downloaded image..."

sudo docker image inspect \
    "${ECR_IMAGE}" \
    > /dev/null


echo ""
echo "Stopping previous container..."

if sudo docker ps \
    -a \
    --format '{{.Names}}' \
    | grep -Fxq "${CONTAINER_NAME}"
then

    sudo docker stop \
        "${CONTAINER_NAME}" \
        || true

    sudo docker rm \
        "${CONTAINER_NAME}" \
        || true

fi


echo ""
echo "Starting new container..."

sudo docker run \
    -d \
    --restart unless-stopped \
    --name "${CONTAINER_NAME}" \
    -p "${HOST_PORT}:${CONTAINER_PORT}" \
    "${ECR_IMAGE}"


echo ""
echo "Waiting for container startup..."

sleep 10


echo ""
echo "Container status:"

sudo docker ps \
    --filter "name=${CONTAINER_NAME}"


echo ""
echo "Removing unused Docker images..."

sudo docker image prune \
    -f


echo ""
echo "================================================"
echo "REMOTE DEPLOYMENT COMPLETED"
echo "================================================"

REMOTE_SCRIPT
                    '''
                }
            }
        }


        stage('43 - Verify Running Container') {

            steps {

                sshagent(
                    credentials: ["${DEPLOY_SSH_CREDENTIALS}"]
                ) {

                    sh '''
                        set -e

                        echo "================================================"
                        echo "VERIFYING RUNNING CONTAINER"
                        echo "================================================"


                        ssh \
                            -o StrictHostKeyChecking=yes \
                            "${DEPLOY_USER}@${DEPLOY_HOST}" \
                            "CONTAINER_NAME='${CONTAINER_NAME}' bash -s" <<'REMOTE_SCRIPT'

set -e


echo ""
echo "Docker containers:"

sudo docker ps


echo ""
echo "Checking application container..."


if ! sudo docker ps \
    --format '{{.Names}}' \
    | grep -Fxq "${CONTAINER_NAME}"
then

    echo "ERROR: Application container is not running."

    echo ""
    echo "Container logs:"

    sudo docker logs \
        "${CONTAINER_NAME}" \
        || true

    exit 1

fi


echo ""
echo "Application container is RUNNING."


echo ""
echo "Container details:"

sudo docker inspect \
    "${CONTAINER_NAME}" \
    --format='Image={{.Config.Image}} Status={{.State.Status}}'


echo ""
echo "Recent application logs:"

sudo docker logs \
    --tail 30 \
    "${CONTAINER_NAME}" \
    || true


echo ""
echo "================================================"
echo "CONTAINER VERIFICATION PASSED"
echo "================================================"

REMOTE_SCRIPT


                        echo ""
                        echo "================================================"
                        echo "CHECKING APPLICATION PORT"
                        echo "================================================"


                        for i in $(seq 1 12)
                        do

                            echo "HTTP health check attempt ${i}/12..."

                            if curl \
                                --fail \
                                --silent \
                                --show-error \
                                --max-time 5 \
                                "http://${DEPLOY_HOST}:${HOST_PORT}/" \
                                > /dev/null
                            then

                                echo ""
                                echo "Application HTTP check PASSED."

                                exit 0

                            fi

                            sleep 5

                        done


                        echo ""
                        echo "ERROR: Application did not respond on port ${HOST_PORT}."

                        exit 1
                    '''
                }
            }
        }


        stage('44 - Part 6 Success') {

            steps {

                echo ''
                echo '================================================'
                echo '        PART 6 DEPLOYMENT SUCCESS'
                echo '================================================'

                echo "Environment      : ${params.ENVIRONMENT}"
                echo "EC2 Instance     : ${env.DEPLOY_INSTANCE_ID}"
                echo "EC2 Host         : ${env.DEPLOY_HOST}"
                echo "ECR Image        : ${env.ECR_IMAGE}"
                echo "Container        : ${env.CONTAINER_NAME}"
                echo "Container Port   : ${env.CONTAINER_PORT}"
                echo "Host Port        : ${env.HOST_PORT}"

                echo ''
                echo 'ECR Pull         : PASSED'
                echo 'Docker Deployment: PASSED'
                echo 'Container Check  : PASSED'
                echo 'HTTP Check       : PASSED'

                echo ''
                echo '================================================'
                echo '          PART 6 SUCCESS'
                echo '================================================'
            }
        }
    }


    // ================================================================
    // POST ACTIONS
    // ================================================================

    post {

        success {

            echo ''
            echo '================================================'
            echo ' PART 1 + PART 2 + PART 3 + PART 4 + PART 5 '
            echo '                 + PART 6'
            echo '                 SUCCESS'
            echo '================================================'

            echo ''
            echo 'Part 1 - Code Quality       : PASSED'
            echo 'Part 2 - Automated Testing  : PASSED'
            echo 'Part 3 - Docker             : PASSED'
            echo 'Part 4 - AWS ECR            : PASSED'
            echo 'Part 5 - Terraform          : PASSED'
            echo 'Part 6 - Deployment         : PASSED'

            echo ''
            echo "Environment : ${params.ENVIRONMENT}"

            echo ''
            echo 'Terraform infrastructure successfully deployed.'
            echo 'Application successfully deployed to EC2.'

            echo '================================================'
        }


        failure {

            echo ''
            echo '================================================'
            echo ' PART 1 + PART 2 + PART 3 + PART 4 + PART 5 '
            echo '                 + PART 6'
            echo '                 FAILED'
            echo '================================================'

            echo ''
            echo 'The pipeline stopped at the failed stage.'

            echo ''
            echo 'Check the Jenkins console output above'
            echo 'for the exact failing command.'

            echo '================================================'
        }


        always {

            echo ''
            echo '================================================'
            echo 'CLEANING JENKINS WORKSPACE'
            echo '================================================'

            cleanWs(
                deleteDirs: true,
                disableDeferredWipeout: true
            )
        }
    }
}
