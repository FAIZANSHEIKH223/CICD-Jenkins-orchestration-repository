pipeline {

    agent any

    options {

        timestamps()

        ansiColor('xterm')

        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                daysToKeepStr: '30',
                numToKeepStr: '50'
            )
        )

        timeout(
            time: 90,
            unit: 'MINUTES'
        )
    }

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: [
                'dev',
                'qa',
                'stage',
                'prod'
            ],
            description: 'Environment to completely destroy'
        )

        booleanParam(
            name: 'DELETE_TERRAFORM_BACKEND',
            defaultValue: true,
            description: 'Delete Terraform S3 state bucket and DynamoDB lock table'
        )
    }

    environment {

        // ============================================================
        // GITHUB
        // ============================================================

        GITHUB_CREDENTIALS = 'github-creds'

        TERRAFORM_REPO = 'https://github.com/FAIZANSHEIKH223/terraform-aws-infra.git'
        TERRAFORM_BRANCH = 'main'

        TERRAFORM_DIR = 'terraform-infra'

        // ============================================================
        // AWS
        // ============================================================

        AWS_DEFAULT_REGION = 'us-east-1'
        AWS_CREDENTIALS = 'aws-creds'

        // ============================================================
        // APPLICATION
        // ============================================================

        APP_NAME = 'practice1'

        // ============================================================
        // ECR
        // ============================================================

        ECR_REPOSITORY = 'practice1'

        // ============================================================
        // ECS
        // ============================================================

        ECS_CLUSTER = "practice1-${ENVIRONMENT}-cluster"
        ECS_SERVICE = "practice1-${ENVIRONMENT}-service"
        ECS_TASK_FAMILY = "practice1-${ENVIRONMENT}-task"

        // ============================================================
        // LOAD BALANCER
        // ============================================================

        ALB_NAME = "practice1-${ENVIRONMENT}-alb"
        TARGET_GROUP_NAME = "practice1-${ENVIRONMENT}-tg"

        // ============================================================
        // SECURITY GROUPS
        // ============================================================

        ALB_SG_NAME = "practice1-${ENVIRONMENT}-alb-sg"
        ECS_SG_NAME = "practice1-${ENVIRONMENT}-ecs-sg"

        // ============================================================
        // IAM
        // ============================================================

        EXECUTION_ROLE_NAME = 'practice1-ecsTaskExecutionRole'

        // ============================================================
        // CLOUDWATCH
        // ============================================================

        LOG_GROUP = "/ecs/practice1-${ENVIRONMENT}-task"

        // ============================================================
        // TERRAFORM BACKEND
        // ============================================================

        TF_STATE_BUCKET = 'terraform-state-faizan-001'
        TF_LOCK_TABLE = 'terraform-locks'

        TF_IN_AUTOMATION = 'true'
        TF_INPUT = 'false'
    }

    stages {

        // ============================================================
        // 1
        // AWS VERIFICATION
        // ============================================================

        stage('1 - AWS Verification') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set -eu

                        echo "================================================"
                        echo "AWS ACCOUNT VERIFICATION"
                        echo "================================================"

                        command -v aws
                        aws --version

                        aws sts get-caller-identity \
                            --region "${AWS_DEFAULT_REGION}"

                        echo ""
                        echo "Region:"
                        echo "${AWS_DEFAULT_REGION}"
                    '''
                }
            }
        }

        // ============================================================
        // 2
        // DISCOVER RESOURCES
        // ============================================================

        stage('2 - Discover Resources') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    script {

                        echo '================================================'
                        echo 'DISCOVERING RESOURCES'
                        echo '================================================'

                        env.ALB_ARN = sh(
                            script: '''
                                aws elbv2 describe-load-balancers \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --names "${ALB_NAME}" \
                                    --query 'LoadBalancers[0].LoadBalancerArn' \
                                    --output text \
                                    2>/dev/null || true
                            ''',
                            returnStdout: true
                        ).trim()

                        env.TARGET_GROUP_ARN = sh(
                            script: '''
                                aws elbv2 describe-target-groups \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --names "${TARGET_GROUP_NAME}" \
                                    --query 'TargetGroups[0].TargetGroupArn' \
                                    --output text \
                                    2>/dev/null || true
                            ''',
                            returnStdout: true
                        ).trim()

                        env.ALB_SG_ID = sh(
                            script: '''
                                VPC_ID=""

                                if [ -n "${ALB_ARN}" ] &&
                                   [ "${ALB_ARN}" != "None" ]; then

                                    VPC_ID=$(aws elbv2 describe-load-balancers \
                                        --region "${AWS_DEFAULT_REGION}" \
                                        --load-balancer-arns "${ALB_ARN}" \
                                        --query 'LoadBalancers[0].VpcId' \
                                        --output text \
                                        2>/dev/null || true)
                                fi

                                if [ -n "${VPC_ID}" ] &&
                                   [ "${VPC_ID}" != "None" ]; then

                                    aws ec2 describe-security-groups \
                                        --region "${AWS_DEFAULT_REGION}" \
                                        --filters \
                                            "Name=vpc-id,Values=${VPC_ID}" \
                                            "Name=group-name,Values=${ALB_SG_NAME}" \
                                        --query 'SecurityGroups[0].GroupId' \
                                        --output text \
                                        2>/dev/null || true
                                fi
                            ''',
                            returnStdout: true
                        ).trim()

                        env.ECS_SG_ID = sh(
                            script: '''
                                VPC_ID=""

                                if [ -n "${ALB_ARN}" ] &&
                                   [ "${ALB_ARN}" != "None" ]; then

                                    VPC_ID=$(aws elbv2 describe-load-balancers \
                                        --region "${AWS_DEFAULT_REGION}" \
                                        --load-balancer-arns "${ALB_ARN}" \
                                        --query 'LoadBalancers[0].VpcId' \
                                        --output text \
                                        2>/dev/null || true)
                                fi

                                if [ -n "${VPC_ID}" ] &&
                                   [ "${VPC_ID}" != "None" ]; then

                                    aws ec2 describe-security-groups \
                                        --region "${AWS_DEFAULT_REGION}" \
                                        --filters \
                                            "Name=vpc-id,Values=${VPC_ID}" \
                                            "Name=group-name,Values=${ECS_SG_NAME}" \
                                        --query 'SecurityGroups[0].GroupId' \
                                        --output text \
                                        2>/dev/null || true
                                fi
                            ''',
                            returnStdout: true
                        ).trim()

                        echo ''
                        echo '================================================'
                        echo 'DISCOVERED RESOURCES'
                        echo '================================================'

                        echo "ALB ARN       : ${env.ALB_ARN}"
                        echo "Target Group  : ${env.TARGET_GROUP_ARN}"
                        echo "ALB SG        : ${env.ALB_SG_ID}"
                        echo "ECS SG        : ${env.ECS_SG_ID}"
                        echo "ECS Cluster   : ${env.ECS_CLUSTER}"
                        echo "ECS Service   : ${env.ECS_SERVICE}"
                        echo "ECR Repository: ${env.ECR_REPOSITORY}"
                        echo ''
                    }
                }
            }
        }

        // ============================================================
        // 3
        // STOP ECS SERVICE
        // ============================================================

        stage('3 - Force Stop ECS Service') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "FORCE STOPPING ECS SERVICE"
                        echo "================================================"

                        CLUSTER_EXISTS=$(aws ecs describe-clusters \
                            --region "${AWS_DEFAULT_REGION}" \
                            --clusters "${ECS_CLUSTER}" \
                            --query 'clusters[0].status' \
                            --output text \
                            2>/dev/null)

                        echo "Cluster status: ${CLUSTER_EXISTS}"

                        if [ "${CLUSTER_EXISTS}" = "ACTIVE" ]; then

                            SERVICE_STATUS=$(aws ecs describe-services \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --services "${ECS_SERVICE}" \
                                --query 'services[0].status' \
                                --output text \
                                2>/dev/null)

                            echo "Service status: ${SERVICE_STATUS}"

                            if [ "${SERVICE_STATUS}" = "ACTIVE" ]; then

                                echo "Scaling service to zero..."

                                aws ecs update-service \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --cluster "${ECS_CLUSTER}" \
                                    --service "${ECS_SERVICE}" \
                                    --desired-count 0 \
                                    --force-new-deployment

                            fi
                        fi

                        echo "ECS service scale-down command completed."
                    '''
                }
            }
        }

        // ============================================================
        // 4
        // FORCE STOP ALL RUNNING TASKS
        // ============================================================

        stage('4 - Force Stop ECS Tasks') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "FORCE STOPPING ECS TASKS"
                        echo "================================================"

                        for ROUND in $(seq 1 12)
                        do

                            echo ""
                            echo "Task cleanup round ${ROUND}/12"

                            TASKS=$(aws ecs list-tasks \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --service-name "${ECS_SERVICE}" \
                                --desired-status RUNNING \
                                --query 'taskArns[]' \
                                --output text \
                                2>/dev/null)

                            if [ -z "${TASKS}" ] ||
                               [ "${TASKS}" = "None" ]; then

                                echo "No running service tasks found."
                                break
                            fi

                            for TASK in ${TASKS}
                            do

                                echo "Stopping task:"
                                echo "${TASK}"

                                aws ecs stop-task \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --cluster "${ECS_CLUSTER}" \
                                    --task "${TASK}" \
                                    --reason "Jenkins forced destruction"

                            done

                            sleep 5

                        done

                        echo "ECS task cleanup completed."
                    '''
                }
            }
        }

        // ============================================================
        // 5
        // DELETE ECS SERVICE
        // ============================================================

        stage('5 - Delete ECS Service') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "DELETING ECS SERVICE"
                        echo "================================================"

                        SERVICE_STATUS=$(aws ecs describe-services \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}" \
                            --query 'services[0].status' \
                            --output text \
                            2>/dev/null)

                        echo "Service status: ${SERVICE_STATUS}"

                        if [ "${SERVICE_STATUS}" = "ACTIVE" ]; then

                            aws ecs update-service \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --service "${ECS_SERVICE}" \
                                --desired-count 0 \
                                >/dev/null 2>&1

                            aws ecs delete-service \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}" \
                                --service "${ECS_SERVICE}" \
                                --force

                        else

                            echo "ECS service already deleted."

                        fi

                        sleep 10

                        echo "ECS service deletion completed."
                    '''
                }
            }
        }

        // ============================================================
        // 6
        // TERRAFORM DESTROY
        // ============================================================

        stage('6 - Terraform Destroy') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    deleteDir()

                    git(
                        branch: "${TERRAFORM_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${TERRAFORM_REPO}"
                    )
                }

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    dir("${TERRAFORM_DIR}") {

                        sh '''
                            set +e

                            echo "================================================"
                            echo "TERRAFORM DESTROY"
                            echo "================================================"

                            if ! command -v terraform >/dev/null 2>&1
                            then
                                echo "Terraform not installed."
                                echo "Skipping Terraform destroy."
                                exit 0
                            fi

                            terraform version

                            if [ ! -d "environments/${ENVIRONMENT}" ]; then

                                echo "Terraform environment does not exist."
                                echo "Skipping Terraform destroy."

                                exit 0
                            fi

                            terraform init \
                                -input=false

                            terraform validate

                            echo ""
                            echo "Running Terraform destroy..."
                            echo ""

                            terraform destroy \
                                -input=false \
                                -auto-approve \
                                -var-file="environments/${ENVIRONMENT}/terraform.tfvars"

                            TF_EXIT=$?

                            if [ "${TF_EXIT}" -ne 0 ]; then

                                echo ""
                                echo "WARNING: Terraform destroy returned ${TF_EXIT}."
                                echo "Continuing with AWS forced cleanup."

                            else

                                echo ""
                                echo "Terraform destroy completed."

                            fi
                        '''
                    }
                }
            }
        }

        // ============================================================
        // 7
        // DELETE ECS CLUSTER
        // ============================================================

        stage('7 - Delete ECS Cluster') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "DELETING ECS CLUSTER"
                        echo "================================================"

                        STATUS=$(aws ecs describe-clusters \
                            --region "${AWS_DEFAULT_REGION}" \
                            --clusters "${ECS_CLUSTER}" \
                            --query 'clusters[0].status' \
                            --output text \
                            2>/dev/null)

                        echo "Cluster status: ${STATUS}"

                        if [ "${STATUS}" = "ACTIVE" ]; then

                            aws ecs delete-cluster \
                                --region "${AWS_DEFAULT_REGION}" \
                                --cluster "${ECS_CLUSTER}"

                        else

                            echo "Cluster does not exist."

                        fi
                    '''
                }
            }
        }

        // ============================================================
        // 8
        // DELETE ALB LISTENERS
        // ============================================================

        stage('8 - Delete ALB Listeners') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "DELETING ALB LISTENERS"
                        echo "================================================"

                        if [ -n "${ALB_ARN}" ] &&
                           [ "${ALB_ARN}" != "None" ]; then

                            LISTENERS=$(aws elbv2 describe-listeners \
                                --region "${AWS_DEFAULT_REGION}" \
                                --load-balancer-arn "${ALB_ARN}" \
                                --query 'Listeners[].ListenerArn' \
                                --output text \
                                2>/dev/null)

                            for LISTENER in ${LISTENERS}
                            do

                                echo "Deleting listener:"
                                echo "${LISTENER}"

                                aws elbv2 delete-listener \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --listener-arn "${LISTENER}"

                            done

                        else

                            echo "ALB not found."

                        fi
                    '''
                }
            }
        }

        // ============================================================
        // 9
        // DELETE ALB
        // ============================================================

        stage('9 - Delete Application Load Balancer') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "DELETING APPLICATION LOAD BALANCER"
                        echo "================================================"

                        if [ -n "${ALB_ARN}" ] &&
                           [ "${ALB_ARN}" != "None" ]; then

                            aws elbv2 delete-load-balancer \
                                --region "${AWS_DEFAULT_REGION}" \
                                --load-balancer-arn "${ALB_ARN}"

                            echo "Waiting for ALB deletion..."

                            for i in $(seq 1 30)
                            do

                                CHECK=$(aws elbv2 describe-load-balancers \
                                    --region "${AWS_DEFAULT_REGION}" \
                                    --load-balancer-arns "${ALB_ARN}" \
                                    --query 'LoadBalancers[0].State.Code' \
                                    --output text \
                                    2>/dev/null)

                                if [ -z "${CHECK}" ] ||
                                   [ "${CHECK}" = "None" ]; then

                                    echo "ALB deleted."
                                    break

                                fi

                                echo "ALB still exists: ${CHECK}"
                                sleep 5

                            done

                        else

                            echo "ALB already absent."

                        fi
                    '''
                }
            }
        }

        // ============================================================
        // 10
        // DELETE TARGET GROUP
        // ============================================================

        stage('10 - Delete Target Group') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "DELETING TARGET GROUP"
                        echo "================================================"

                        TG_ARN="${TARGET_GROUP_ARN}"

                        if [ -z "${TG_ARN}" ] ||
                           [ "${TG_ARN}" = "None" ]; then

                            TG_ARN=$(aws elbv2 describe-target-groups \
                                --region "${AWS_DEFAULT_REGION}" \
                                --names "${TARGET_GROUP_NAME}" \
                                --query 'TargetGroups[0].TargetGroupArn' \
                                --output text \
                                2>/dev/null)

                        fi

                        if [ -n "${TG_ARN}" ] &&
                           [ "${TG_ARN}" != "None" ]; then

                            aws elbv2 delete-target-group \
                                --region "${AWS_DEFAULT_REGION}" \
                                --target-group-arn "${TG_ARN}"

                            echo "Target group deleted."

                        else

                            echo "Target group already absent."

                        fi
                    '''
                }
            }
        }

        // ============================================================
        // 11
        // DELETE ECR
        // ============================================================

        stage('11 - Delete ECR Repository and Images') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "DELETING ECR REPOSITORY"
                        echo "================================================"

                        EXISTS=$(aws ecr describe-repositories \
                            --region "${AWS_DEFAULT_REGION}" \
                            --repository-names "${ECR_REPOSITORY}" \
                            --query 'repositories[0].repositoryName' \
                            --output text \
                            2>/dev/null)

                        if [ "${EXISTS}" = "${ECR_REPOSITORY}" ]; then

                            echo "Force deleting ECR repository..."

                            aws ecr delete-repository \
                                --region "${AWS_DEFAULT_REGION}" \
                                --repository-name "${ECR_REPOSITORY}" \
                                --force

                            echo "ECR repository deleted."

                        else

                            echo "ECR repository does not exist."

                        fi
                    '''
                }
            }
        }

        // ============================================================
        // 12
        // DELETE CLOUDWATCH LOG GROUP
        // ============================================================

        stage('12 - Delete CloudWatch Logs') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "DELETING CLOUDWATCH LOG GROUP"
                        echo "================================================"

                        aws logs delete-log-group \
                            --region "${AWS_DEFAULT_REGION}" \
                            --log-group-name "${LOG_GROUP}"

                        echo "CloudWatch log group cleanup completed."
                    '''
                }
            }
        }

        // ============================================================
        // 13
        // DELETE SECURITY GROUPS
        // ============================================================

        stage('13 - Delete Security Groups') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "DELETING SECURITY GROUPS"
                        echo "================================================"

                        for SG in "${ALB_SG_ID}" "${ECS_SG_ID}"
                        do

                            if [ -n "${SG}" ] &&
                               [ "${SG}" != "None" ] &&
                               [[ "${SG}" == sg-* ]]
                            then

                                echo ""
                                echo "Deleting security group:"
                                echo "${SG}"

                                for ATTEMPT in $(seq 1 12)
                                do

                                    aws ec2 delete-security-group \
                                        --region "${AWS_DEFAULT_REGION}" \
                                        --group-id "${SG}"

                                    if [ $? -eq 0 ]; then

                                        echo "Security group deleted."
                                        break

                                    fi

                                    echo "Security group still in use."
                                    echo "Attempt ${ATTEMPT}/12"
                                    sleep 5

                                done

                            else

                                echo "Invalid or missing SG: ${SG}"

                            fi

                        done
                    '''
                }
            }
        }

        // ============================================================
        // 14
        // DELETE IAM ROLE
        // ============================================================

        stage('14 - Delete ECS IAM Role') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "DELETING IAM EXECUTION ROLE"
                        echo "================================================"

                        ROLE_EXISTS=$(aws iam get-role \
                            --role-name "${EXECUTION_ROLE_NAME}" \
                            --query 'Role.RoleName' \
                            --output text \
                            2>/dev/null)

                        if [ "${ROLE_EXISTS}" = "${EXECUTION_ROLE_NAME}" ]; then

                            echo "Detaching managed policies..."

                            POLICIES=$(aws iam list-attached-role-policies \
                                --role-name "${EXECUTION_ROLE_NAME}" \
                                --query 'AttachedPolicies[].PolicyArn' \
                                --output text \
                                2>/dev/null)

                            for POLICY in ${POLICIES}
                            do

                                echo "Detaching:"
                                echo "${POLICY}"

                                aws iam detach-role-policy \
                                    --role-name "${EXECUTION_ROLE_NAME}" \
                                    --policy-arn "${POLICY}"

                            done

                            echo "Deleting role..."

                            aws iam delete-role \
                                --role-name "${EXECUTION_ROLE_NAME}"

                            echo "IAM role deleted."

                        else

                            echo "IAM role already absent."

                        fi
                    '''
                }
            }
        }

        // ============================================================
        // 15
        // FORCE DELETE ECR AGAIN
        // ============================================================

        stage('15 - Final ECR Cleanup') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "FINAL ECR CLEANUP"
                        echo "================================================"

                        aws ecr delete-repository \
                            --region "${AWS_DEFAULT_REGION}" \
                            --repository-name "${ECR_REPOSITORY}" \
                            --force \
                            2>/dev/null || true

                        echo "Final ECR cleanup completed."
                    '''
                }
            }
        }

        // ============================================================
        // 16
        // DELETE TERRAFORM BACKEND
        // ============================================================

        stage('16 - Delete Terraform Backend') {

            when {

                expression {

                    return params.DELETE_TERRAFORM_BACKEND

                }
            }

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "DELETE TERRAFORM BACKEND"
                        echo "================================================"

                        echo ""
                        echo "Terraform state bucket:"
                        echo "${TF_STATE_BUCKET}"

                        echo ""
                        echo "Terraform lock table:"
                        echo "${TF_LOCK_TABLE}"

                        // ====================================================
                        // S3 NORMAL OBJECTS
                        // ====================================================

                        echo ""
                        echo "Removing S3 objects..."

                        aws s3 rm \
                            "s3://${TF_STATE_BUCKET}" \
                            --recursive \
                            --region "${AWS_DEFAULT_REGION}"

                        // ====================================================
                        // S3 VERSIONED OBJECTS
                        // ====================================================

                        echo ""
                        echo "Removing S3 object versions and delete markers..."

                        VERSION_DATA=$(aws s3api list-object-versions \
                            --bucket "${TF_STATE_BUCKET}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            --output json \
                            2>/dev/null)

                        if [ -n "${VERSION_DATA}" ]; then

                            echo "${VERSION_DATA}" |
                            python3 -c '
import json
import sys
import subprocess

data=json.load(sys.stdin)

objects=[]

for item in data.get("Versions", []):
    objects.append({
        "Key": item["Key"],
        "VersionId": item["VersionId"]
    })

for item in data.get("DeleteMarkers", []):
    objects.append({
        "Key": item["Key"],
        "VersionId": item["VersionId"]
    })

if objects:

    payload=json.dumps({
        "Objects": objects,
        "Quiet": True
    })

    subprocess.run([
        "aws",
        "s3api",
        "delete-objects",
        "--bucket",
        "'"${TF_STATE_BUCKET}"'",
        "--delete",
        payload,
        "--region",
        "'"${AWS_DEFAULT_REGION}"'"
    ], check=False)

print("Processed", len(objects), "versioned objects/delete markers.")
'

                        fi

                        // ====================================================
                        // DELETE BUCKET
                        // ====================================================

                        echo ""
                        echo "Deleting Terraform state bucket..."

                        aws s3api delete-bucket \
                            --bucket "${TF_STATE_BUCKET}" \
                            --region "${AWS_DEFAULT_REGION}"

                        echo "S3 state bucket deletion requested."

                        // ====================================================
                        // DELETE DYNAMODB LOCK TABLE
                        // ====================================================

                        echo ""
                        echo "Deleting DynamoDB lock table..."

                        aws dynamodb delete-table \
                            --table-name "${TF_LOCK_TABLE}" \
                            --region "${AWS_DEFAULT_REGION}"

                        echo "DynamoDB lock table deletion requested."

                        // ====================================================
                        // WAIT FOR TABLE
                        // ====================================================

                        for i in $(seq 1 30)
                        do

                            STATUS=$(aws dynamodb describe-table \
                                --table-name "${TF_LOCK_TABLE}" \
                                --region "${AWS_DEFAULT_REGION}" \
                                --query 'Table.TableStatus' \
                                --output text \
                                2>/dev/null)

                            if [ -z "${STATUS}" ] ||
                               [ "${STATUS}" = "None" ]; then

                                echo "DynamoDB lock table deleted."
                                break

                            fi

                            echo "DynamoDB status: ${STATUS}"
                            sleep 3

                        done
                    '''
                }
            }
        }

        // ============================================================
        // 17
        // FINAL ECS CHECK
        // ============================================================

        stage('17 - Final ECS Verification') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "FINAL ECS VERIFICATION"
                        echo "================================================"

                        echo ""
                        echo "Running tasks:"

                        aws ecs list-tasks \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --desired-status RUNNING \
                            --output table

                        echo ""
                        echo "Service:"

                        aws ecs describe-services \
                            --region "${AWS_DEFAULT_REGION}" \
                            --cluster "${ECS_CLUSTER}" \
                            --services "${ECS_SERVICE}" \
                            --output table

                        echo ""
                        echo "ECS final verification completed."
                    '''
                }
            }
        }

        // ============================================================
        // 18
        // FINAL ALB CHECK
        // ============================================================

        stage('18 - Final ALB Verification') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "FINAL ALB VERIFICATION"
                        echo "================================================"

                        ALB_CHECK=$(aws elbv2 describe-load-balancers \
                            --region "${AWS_DEFAULT_REGION}" \
                            --names "${ALB_NAME}" \
                            --query 'LoadBalancers[0].LoadBalancerName' \
                            --output text \
                            2>/dev/null)

                        if [ -z "${ALB_CHECK}" ] ||
                           [ "${ALB_CHECK}" = "None" ]; then

                            echo "ALB: DELETED"

                        else

                            echo "WARNING: ALB still exists:"
                            echo "${ALB_CHECK}"

                        fi

                        TG_CHECK=$(aws elbv2 describe-target-groups \
                            --region "${AWS_DEFAULT_REGION}" \
                            --names "${TARGET_GROUP_NAME}" \
                            --query 'TargetGroups[0].TargetGroupName' \
                            --output text \
                            2>/dev/null)

                        if [ -z "${TG_CHECK}" ] ||
                           [ "${TG_CHECK}" = "None" ]; then

                            echo "TARGET GROUP: DELETED"

                        else

                            echo "WARNING: Target group still exists:"
                            echo "${TG_CHECK}"

                        fi
                    '''
                }
            }
        }

        // ============================================================
        // 19
        // FINAL ECR CHECK
        // ============================================================

        stage('19 - Final ECR Verification') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        set +e

                        echo "================================================"
                        echo "FINAL ECR VERIFICATION"
                        echo "================================================"

                        ECR_CHECK=$(aws ecr describe-repositories \
                            --region "${AWS_DEFAULT_REGION}" \
                            --repository-names "${ECR_REPOSITORY}" \
                            --query 'repositories[0].repositoryName' \
                            --output text \
                            2>/dev/null)

                        if [ -z "${ECR_CHECK}" ] ||
                           [ "${ECR_CHECK}" = "None" ]; then

                            echo "ECR REPOSITORY: DELETED"

                        else

                            echo "WARNING: ECR repository still exists:"
                            echo "${ECR_CHECK}"

                        fi
                    '''
                }
            }
        }

        // ============================================================
        // 20
        // FINAL SUMMARY
        // ============================================================

        stage('20 - Destruction Summary') {

            steps {

                echo ''
                echo '============================================================'
                echo '             DESTRUCTION PROCESS COMPLETED'
                echo '============================================================'
                echo ''
                echo 'Requested cleanup:'
                echo ''
                echo 'ECS SERVICE             : STOPPED / DELETED'
                echo 'ECS TASKS               : FORCE STOPPED'
                echo 'ECS CLUSTER             : DELETED'
                echo 'ALB                     : DELETED'
                echo 'ALB LISTENERS           : DELETED'
                echo 'TARGET GROUP            : DELETED'
                echo 'ECR REPOSITORY          : FORCE DELETED'
                echo 'CLOUDWATCH LOG GROUP    : DELETED'
                echo 'SECURITY GROUPS         : DELETED'
                echo 'IAM EXECUTION ROLE      : DELETED'
                echo 'TERRAFORM INFRASTRUCTURE: DESTROYED'
                echo 'TERRAFORM STATE BUCKET  : DELETED'
                echo 'DYNAMODB LOCK TABLE     : DELETED'
                echo ''
                echo '============================================================'
                echo '                  CLEANUP FINISHED'
                echo '============================================================'
            }
        }
    }

    post {

        success {

            echo ''
            echo '============================================================'
            echo '             FULL DESTRUCTION SUCCESSFUL'
            echo '============================================================'
            echo ''
            echo 'The Jenkins cleanup pipeline completed.'
            echo ''
            echo 'All explicitly managed deployment resources were targeted'
            echo 'for deletion.'
            echo ''
            echo '============================================================'
        }

        failure {

            echo ''
            echo '============================================================'
            echo '       DESTRUCTION PIPELINE ENCOUNTERED AN ERROR'
            echo '============================================================'
            echo ''
            echo 'Check the Jenkins console log.'
            echo ''
            echo 'The pipeline uses best-effort cleanup for AWS resources,'
            echo 'so later cleanup stages may still have executed.'
            echo ''
            echo '============================================================'
        }

        always {

            echo ''
            echo '============================================================'
            echo 'CLEANING JENKINS WORKSPACE'
            echo '============================================================'

            cleanWs(
                deleteDirs: true,
                disableDeferredWipeout: true
            )
        }
    }
}
